                                                                    <https://w3id.org/tvbo/Parameter> ;
                                                           <http://purl.org/dc/terms/description> "Coefficient of the cubic term in the first state-variable x1" ;
                                                           <http://schema.org/defaultValue> "1.0"^^xsd:double ;
