                                                                <https://w3id.org/tvbo/Parameter> ;
                                                       <http://purl.org/dc/terms/description> "Excitation threshold of excitatory population (Sanz-Leon et al" ;
                                                       <http://schema.org/defaultValue> "0.0"^^xsd:double ;
