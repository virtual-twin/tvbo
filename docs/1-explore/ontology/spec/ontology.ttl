                                                       <https://w3id.org/tvbo/lhs> "Vcond" ;
                                                       <https://w3id.org/tvbo/rhs> "Piecewise((R_minus*c_pop0*(-V + E)/pi - R_minus*x**2 + V_temp + eta, V <= Vstar), (R_minus*c_pop0*(-V + E)/pi - R_plus*x**2 + V_temp + eta, True))" .


