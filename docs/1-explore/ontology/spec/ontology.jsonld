}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWang",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Reduced WongWang (RWW) is a biologically-inspired one-dimensional (i.e., only one state-variable 'S') neural mass model that approximates the realistic temporal dynamics of a detailed spiking and conductance-based synaptic large-scale network (Deco et al., 2013).\n\nRWW is the dynamical mean-field (DMF) reduction of the Reduced WongWang Exc-Inh model, that consists in disentangling the contribution of the two neuronal populations (excitatory and inhibitory) in order to study the time evolution of just one pool of neurons for each network node (Wong & Wang, 2006). It results that the dynamics of each network node described the temporal evolution of the opening probability of the NMDA channels."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Deco2013"
  }, {
    "@id" : "https://w3id.org/tvbo/studies/Wong2006"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ReducedWongWang"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Reduced Wong-Wang"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Bistable"
  }, {
    "@id" : "https://w3id.org/tvbo/Multistable"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/FixedPoint"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/derived_variables/H"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/derived_variables/x"
  } ],
  "https://w3id.org/tvbo/hasModelFeature" : [ {
    "@id" : "https://w3id.org/tvbo/ExcitatoryInhibitorySubpopulations"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/I_o"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/J_N"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/a"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/b"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/d"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/gamma"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/tau_s"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/w"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/state_variables/S"
  } ],
  "https://w3id.org/tvbo/hasStochasticityCharacter" : [ {
    "@id" : "https://w3id.org/tvbo/Deterministic"
  } ],
  "https://w3id.org/tvbo/hasTimescaleSeparation" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "false"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "mean_field"
  } ],
  "https://w3id.org/tvbo/modelsCellType" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CL_0000099"
  }, {
    "@id" : "http://purl.obolibrary.org/obo/CL_0000598"
  } ],
  "https://w3id.org/tvbo/modelsNeurotransmitterSystem" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0007214"
  }, {
    "@id" : "http://purl.obolibrary.org/obo/GO_0035249"
  } ],
  "https://w3id.org/tvbo/phaseSpaceDimension" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWang/derived_variables/H",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Sigmoid input-output function of the synaptic input current, x_RWW, that computes the averaged firing rate of the neurons population (Deco et al., 2013)."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0099605"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "H (ReducedWongWang derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "H"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "H"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(a*x - b)/(1 - exp(-d*(a*x - b)))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWang/derived_variables/x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "(NMDAR)-mediated synaptic input current to the neurons population (Deco et al., 2013)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x (ReducedWongWang derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "I_o + J_N*S*local_coupling + J_N*S*w + J_N*c_pop0"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/I_o",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "External input current to the neurons population (Deco et al"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.33"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "I_o (ReducedWongWang parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "External input current to the neurons population (Deco et al., 2013).\n\nNote:\n------\nIn TVB, the default value is set to 0.33 (instead of 0.30 as in Deco et al. (2013)) for setting the system is bistability (see Hansen et al., 2015)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "I_o"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "nA"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/J_N",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Excitatory recurrence"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.2609"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0098815"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "J_N (ReducedWongWang parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Excitatory recurrence"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "J_N"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "nA"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/a",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Slope (or gain) parameter of the sigmoid input-output function H_RWW (Deco et al"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.27"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "a (ReducedWongWang parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Slope (or gain) parameter of the sigmoid input-output function H_RWW (Deco et al., 2013).\n\nNote:\n-----\nIn the original publication, the parameter 'a' is set in (nC)^-1 (i.e., equivalent to  (nA.s)^-1).  In TVB, the parameter has been converted in (pC)^-1 for setting the system in millisecond."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "a"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "per_pC"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/b",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Shift parameter of the sigmoid input-output function H_RWW (Deco et al"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.108"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "b (ReducedWongWang parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Shift parameter of the sigmoid input-output function H_RWW (Deco et al., 2013). \n\nNote:\n------\nIn the original publication, the parameter 'b' is set in Hz. In TVB, the parameter has been converted in kHz for setting the system in millisecond."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "b"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "kHz"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/d",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Scaling parameter of the sigmoid input-output function H_RWW (Deco et al"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "154.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "d (ReducedWongWang parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Scaling parameter of the sigmoid input-output function H_RWW (Deco et al., 2013). \n\nNote:\n------\nIn the original publication, the parameter 'd' is set in second. In TVB, the parameter has been converted in millisecond for setting the system in millisecond."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "d"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
