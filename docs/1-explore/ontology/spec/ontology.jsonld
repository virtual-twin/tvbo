    "@value" : "3.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tau (StefanescuJirsa2D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Timescale separation between fast (xi, alpha) and slow (eta, beta) variables."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/alpha",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Inhibitory fast variable (per mode)."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0060080"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "alpha (StefanescuJirsa2D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "alpha"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(alpha, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tau*(alpha - f_i*alpha**3/3 - beta) + K21*(Cik*xi - alpha) + tau*(II_i + c_pop0 + local_coupling*xi)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/beta",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Inhibitory slow recovery variable (per mode)."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0060080"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "beta (StefanescuJirsa2D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "beta"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(beta, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(alpha - b*beta + n_i)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/eta",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Excitatory slow recovery variable (per mode)."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0060079"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "eta (StefanescuJirsa2D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "eta"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(eta, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(xi - b*eta + m_i)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/xi",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Excitatory fast variable (per mode)."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0060079"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "xi (StefanescuJirsa2D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "xi"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(xi, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tau*(xi - e_i*xi**3/3 - eta) + K11*(Aik*xi - xi) - K12*(Bik*alpha - xi) + tau*(IE_i + c_pop0 + local_coupling*xi)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Reduced set of Hindmarsh-Rose oscillators (Stefanescu & Jirsa 2008). A low-dimensional description of globally coupled heterogeneous excitatory and inhibitory Hindmarsh-Rose populations. The reduction projects an infinite population onto `number_of_modes` modes and yields per-mode scalar state variables (xi, eta, tau) for the excitatory and (alpha, beta, gamma) for the inhibitory subnetwork. The mode-coupling matrices A_ik, B_ik, C_ik and the per-mode coefficients a_i, b_i, c_i, d_i, e_i, f_i, h_i, p_i, IE_i, II_i, m_i, n_i are derived offline by Gaussian quadrature over the heterogeneity distribution N(mu, sigma^2); see TVB reference implementation `tvb.simulator.models.stefanescu_jirsa.ReducedSetHindmarshRose`."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "StefanescuJirsa3D"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Stefanescu-Jirsa 3D"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Bursting"
  }, {
    "@id" : "https://w3id.org/tvbo/Chaotic"
  }, {
    "@id" : "https://w3id.org/tvbo/Oscillatory"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/LimitCycle"
  }, {
    "@id" : "https://w3id.org/tvbo/StrangeAttractor"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/A_ik"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/B_ik"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/C_ik"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/IE_i"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/II_i"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/a_i"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/b_i"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/c_i"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/d_i"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/e_i"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/f_i"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/h_i"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/m_i"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/n_i"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/p_i"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/parameters/K_11"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/parameters/K_12"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/parameters/K_21"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/parameters/a"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/parameters/b"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/parameters/c"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/parameters/d"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/parameters/mu"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/parameters/r"
  }, {
    "@id" : "https://w3id.org/tvbo/StefanescuJirsa3D/parameters/s"
  }, {
