  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "sigma_v23"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((0, rho_1*(rho_2 - (v2 - v3)) > 709), (2*e0/(exp(rho_1*(rho_2 - (v2 - v3))) + 1), True))"
  } ]
}, {
