    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "2"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/derived_variables/h",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "h (Epileptor2D derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((x0 + 3.0/(exp((-x1 - 1*0.5)/0.1) + 1.0), modification > 0), (zcond + 4*(-x0 + x1), True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/derived_variables/x1cond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x1cond (Epileptor2D derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((a*x1**2 + x1*(-b + d), x1 < 0), (d*x1 - slope - 0.6*(z - 4.0)**2, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/derived_variables/zcond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "zcond (Epileptor2D derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "zcond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "zcond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((-0.1*z**7, z < 0), (0, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/Iext",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
