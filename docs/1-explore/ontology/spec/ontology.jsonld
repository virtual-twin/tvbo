    "@value" : "0.2609"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "J_N (ReducedWongWangTvboptim parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "NMDA synaptic coupling strength. Scales both local recurrence and long-range network coupling inputs."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "J_N"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "nA"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/a",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
