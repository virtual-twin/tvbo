  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "alpha_G2D is the coefficient of the linear feedback coupling term of the state-variable W_G2D to the first state-equation Vdot_G2D. Constant parameter to scale the rate of feedback from the slow variable to the fast variable."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
