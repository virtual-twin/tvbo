    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "I_o (ReducedWongWangTvboptim parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Effective external input current to each cortical population. Default 0.34 nA sets the system in bistability (Hansen et al., 2015). Together with w, this is a key parameter for fitting functional connectivity."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
