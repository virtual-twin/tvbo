  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/z",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Slow permittivity / excitability variable."
