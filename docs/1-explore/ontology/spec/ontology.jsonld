  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(V, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(I + J*r*tau + V**2 + c_pop0*cr*tau + c_pop1*cv + eta - pi**2*r**2*tau**2)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/MontbrioPazoRoxin/state_variables/r",
