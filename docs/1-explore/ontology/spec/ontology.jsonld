  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "exhibits regime"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/EI_Tuning_FIC_EIB_Optimization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Fitting functional connectivity using the two-population Reduced Wong-Wang model with explicit excitatory and inhibitory populations. Combines Feedback Inhibition Control (FIC) to maintain local E-I balance with EIB tuning to globally optimize network connectivity. Supports both iterative (FIC+EIB) and gradient-based optimization approaches.\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "EI Tuning: Functional Connectivity Fitting"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/JR_MEG_FrequencyGradient_Optimization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Reproducing MEG Resting-State Frequency Gradients with Network Dynamics. This experiment fits region-specific Jansen-Rit parameters to reproduce the empirical frequency gradient from visual cortex (11 Hz) to association areas (7 Hz).\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "JR Peak Frequency Optimization"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/RWW_BOLD_FC_Optimization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Fitting functional connectivity using the Reduced Wong-Wang model. Two-stage optimization: global parameters first, then regional heterogeneity. Based on tvboptim RWW.qmd tutorial.\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "RWW Functional Connectivity Fitting"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/RateML_ReducedWongWang",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "RateML rwongwang ground truth"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/Schirner2023_MultiscaleBNM_DM",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Multiscale brain network model coupling large-scale structural connectivity with a small-scale frontoparietal circuit for decision-making (DM) and working memory (WM). The large-scale model uses the Reduced Wong-Wang model (Deco et al., 2014, JNeurosci) with explicit excitatory and inhibitory populations. The functional circuit implements winner-take-all DM and persistent-activity WM based on Murray, Jaramillo & Wang (2017, JNeurosci).\nKey innovation: The ratio of long-range excitation (LRE) to feedforward inhibition (FFI) controls functional connectivity between brain regions. This E/I balance tuning enables fitting personalized brain network models to empirical functional connectivity and explains individual differences in cognitive performance (speed-accuracy trade-off in intelligence tests).\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Multiscale BNM: Decision-Making with E/I Balance Tuning"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/explorations",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
