    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((x0 + 3/(exp((-x1 - 1*0.5)/0.1) + 1), modification > 0), (zcond + 4*(-x0 + x1), True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor5D/derived_variables/x1cond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x1cond (Epileptor5D derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise(((-a)*x1**2 + b*x1, x1 < 0), (slope - x2 + 0.6*(z - 4.0)**2, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor5D/derived_variables/y2cond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y2cond (Epileptor5D derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y2cond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "y2cond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((0.0, x2 < -0.25), (aa*(x2 + 0.25), True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor5D/derived_variables/zcond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
