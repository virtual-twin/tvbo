  "@id" : "https://w3id.org/tvbo/LarterBreakspear/derived_variables/Q_V",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Average firing rate of the population of PCs, V."
