}, {
  "@id" : "https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/x1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Fast excitable variable (placeholder Epileptor-like dynamics)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x1 (Epileptor3DStefanescuMcDonald state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x1"
  } ],
