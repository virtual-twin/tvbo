}, {
  "@id" : "https://w3id.org/tvbo/observation_models/FC",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Functional Connectivity (FC) observation model that computes pairwise Pearson correlation coefficients between regional time series. Commonly used to characterize the statistical dependencies between brain regions from fMRI or simulated neural activity."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "FunctionalConnectivity"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/observation_models/FC/parameters/TR"
  }, {
    "@id" : "https://w3id.org/tvbo/observation_models/FC/parameters/fisher_z"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/FC/parameters/TR",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Repetition time"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "720.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TR (FC parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "TR"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "ms"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/FC/parameters/fisher_z",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Apply Fisher z-transformation to correlations"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "fisher_z (FC parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "fisher_z"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/afferent_coupling",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Records the afferent (incoming) coupling term at each network node at every integration step. Records the coupling input that drives the dynamics rather than the model state itself."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "AfferentCoupling"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/afferent_coupling_temporal_average",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Temporally averaged afferent coupling input at each node. Combines coupling input recording with temporal averaging."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "AfferentCouplingTemporalAverage"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_double_exponential",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "BOLD fMRI observation model using a Double Exponential hemodynamic response function."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "BOLD_DoubleExponential"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/observation_models/bold_double_exponential/parameters/TR"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_double_exponential/parameters/TR",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "2000.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TR (bold_double_exponential parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "TR"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "ms"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_gamma",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "BOLD fMRI observation model using a Gamma-shaped hemodynamic response function. Provides a simpler, unimodal HRF shape."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "BOLD_Gamma"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/observation_models/bold_gamma/parameters/TR"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_gamma/parameters/TR",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "2000.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TR (bold_gamma parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "TR"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "ms"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_mixture_of_gammas",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "BOLD fMRI observation model using the canonical double-gamma hemodynamic response function (Glover 1999). Standard HRF used in most fMRI analysis packages (SPM, FSL, AFNI)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "BOLD_MixtureOfGammas"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/observation_models/bold_mixture_of_gammas/parameters/TR"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_mixture_of_gammas/parameters/TR",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "2000.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TR (bold_mixture_of_gammas parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "TR"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "ms"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_region_roi",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "BOLD fMRI observation model that computes the hemodynamic response at each source location and spatially averages within brain regions using a parcellation mapping. Produces per-region BOLD signals suitable for comparison with parcellated empirical data."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "BOLD_RegionROI"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/observation_models/bold_region_roi/parameters/hrf_length"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_region_roi/parameters/hrf_length",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "20000.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "hrf_length (bold_region_roi parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "hrf_length"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "ms"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_tvb",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "BOLD fMRI observation model using the Balloon-Windkessel hemodynamic model. Transforms neural activity into simulated BOLD signal via convolution with a hemodynamic response function (First Order Volterra kernel), followed by a nonlinear Volterra transformation."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "BOLD_TVB"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/observation_models/bold_tvb/parameters/TR"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_tvb/parameters/TR",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Repetition time (sampling period)"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "720.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TR (bold_tvb parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "TR"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "ms"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/eeg",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Forward solution for scalp electroencephalography. Projects source neural activity through a lead field (gain) matrix to electrode locations on the scalp. If no precomputed gain is available, uses a single-sphere analytic approximation (Sarvas 1987, Eq. 12). Supports re-referencing: common average, single-electrode, or ideal reference-free recording."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "EEG"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/observation_models/eeg/parameters/conductivity"
  }, {
    "@id" : "https://w3id.org/tvbo/observation_models/eeg/parameters/reference_electrode"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/eeg/parameters/conductivity",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Volume conductor conductivity for the single-sphere analytic approximation. Only used when no precomputed gain is available."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "conductivity (eeg parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "conductivity"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "S_per_m"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/eeg/parameters/reference_electrode",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Re-referencing scheme. Options: - Electrode label (e.g. \"Cz\"): subtract that electrode signal - \"average\": subtract mean across all channels - null: ideal reference-free recording"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "reference_electrode (eeg parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "reference_electrode"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/global_average",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Spatial mean across all network nodes at each sampling period. Reduces spatial dimension to a single global signal per state variable."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "GlobalAverage"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/ieeg",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Forward solution for intracranial/stereoelectroencephalography (SEEG). Projects source activity through a lead field matrix to implanted depth electrode contacts. Uses the same single-sphere analytic formula as scalp EEG (Sarvas 1987, Eq. 12), but with electrode positions inside the brain volume."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "iEEG"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/observation_models/ieeg/parameters/conductivity"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/ieeg/parameters/conductivity",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Tissue conductivity for the analytic point-dipole approximation. Only used when no precomputed gain is available."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "conductivity (ieeg parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "conductivity"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "S_per_m"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/meg",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Forward solution for magnetoencephalography. Projects source neural activity through a lead field matrix to MEG sensor locations using oriented gradiometers. If no precomputed gain is available, uses the single-sphere analytic formula (Sarvas 1987, Eq. 25) for the magnetic field produced by current dipoles in a conducting sphere."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "MEG"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/observation_models/meg/parameters/permeability"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/meg/parameters/permeability",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Magnetic constant (permeability of free space)"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.256637E-6"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "permeability (meg parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "permeability"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "H_per_m"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/raw",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Records all state variables at every integration step without any transformation. Identity passthrough of the full simulation state."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
