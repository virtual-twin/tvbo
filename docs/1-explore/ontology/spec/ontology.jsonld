    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Reduced Wong-Wang (RWW) model is a biophysically-based neural mass model that describes the dynamics of NMDA-mediated synaptic gating (Deco et al., 2013). It captures the slow dynamics relevant for resting-state fMRI and has been widely used for modeling whole-brain functional connectivity.\nRWW is the dynamical mean-field (DMF) reduction of the Wong & Wang (2006) spiking model. Each network node is described by a single state variable S representing the average NMDA synaptic gating (fraction of open channels).\nThe total synaptic input x combines local excitatory recurrence (w), external input (I_o), and long-range network coupling (instant and delayed) scaled by the synaptic coupling strength J_N. The sigmoid transfer function H(x) maps the total input current to the average population firing rate. In a network setting, the global coupling strength G (a coupling parameter) scales the structural connectivity weights that modulate inter-regional communication."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Deco2013"
  }, {
    "@id" : "https://w3id.org/tvbo/studies/Wong2006"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ReducedWongWangTvboptim"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Reduced Wong-Wang (tvboptim)"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Bistable"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/FixedPoint"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/H_x"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/x"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/I_o"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/J_N"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/a"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/b"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/d"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/gamma"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/tau_s"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/w"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/state_variables/S"
  } ],
  "https://w3id.org/tvbo/hasStochasticityCharacter" : [ {
    "@id" : "https://w3id.org/tvbo/Deterministic"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "mean_field"
  } ],
  "https://w3id.org/tvbo/modelsAnatomicalRegion" : [ {
    "@id" : "http://purl.obolibrary.org/obo/UBERON_0000956"
  } ],
  "https://w3id.org/tvbo/phaseSpaceDimension" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/H_x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Average population firing rate H evaluated at the total synaptic input x."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "H_x (ReducedWongWangTvboptim derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "H_x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "H_x"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "H(x)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Total synaptic input current combining local recurrence, external input, and network coupling (instant and delayed) scaled by J_N."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x (ReducedWongWangTvboptim derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "w*J_N*S + I_o + J_N*instant + J_N*delayed"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/I_o",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "External input current"
  } ],
