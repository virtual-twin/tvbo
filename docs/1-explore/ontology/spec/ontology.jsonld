    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise(((-a)*x1**2 + b*x1, x1 < 0), (slope - x2 + 0.6*(z - 4.0)**2, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/derived_variables/y2cond",
