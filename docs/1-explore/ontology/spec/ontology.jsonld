    "@value" : "w (ReducedWongWangTvboptim parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Local excitatory recurrence strength. Controls the positive feedback within each cortical population. Higher values increase local excitation and push the system toward higher firing rates."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "w"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "dimensionless"
  } ]
