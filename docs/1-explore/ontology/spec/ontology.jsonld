  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Coefficient of the squared term in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al.,2014)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "b"
