    "@value" : "I"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "c_pop0 + lc_0"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Kuramoto/derived_variables/lc_0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
