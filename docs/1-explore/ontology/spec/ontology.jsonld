    "@value" : "sigma_v1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "sigma_v1"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((0, rho_1*(rho_2 - v1) > 709), (2*e0/(exp(rho_1*(rho_2 - v1)) + 1), True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v23",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
