    "@value" : "tt"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor5D/parameters/x0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Epileptogenicity Parameter"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "-1.6"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0060079"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x0 (Epileptor5D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Epileptogenicity Parameter. Degree of excitability or epileptogenicity in Epileptor5D (Jirsa et al.,2014).\n\nIf x0 is greater than a critical value, x0,critic = −2.05, the system can trigger seizures autonomously; otherwise it is in its equilibrium state.\n\nNote:\n- If modification_E5D:\nif x0 is smaller than a critical value, x0,critic = 2.91, can trigger seizures autonomously; otherwise it is in its equilibrium state (Proix et al., 2014)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x0"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor5D/state_variables/g",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "g_E5D is a low-pass filtered excitatory coupling function from sub-population (x1_E5D, y1_E5D) to (x2_E5D, y2_E5D) in Epileptor5D (Jirsa et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "g (Epileptor5D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "g"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(g, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(-0.01*g + 0.001*x1)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor5D/state_variables/x1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "First state-variable of the first Epileptor5D population (Jirsa et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x1 (Epileptor5D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x1, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(Iext + Kvf*c_pop0 + local_coupling*x1 + x1*x1cond + y1 - z)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor5D/state_variables/x2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "First state-variable of the second Epileptor5D sub-population (Jirsa et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x2 (Epileptor5D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x2, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(Iext2 + Kf*c_pop1 + bb*g - x2**3 + x2 - y2 - 0.3*z + 1.05)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor5D/state_variables/y1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second state-variable of the first Epileptor5D sub-population (Jirsa et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y1 (Epileptor5D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y1, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(c - d*x1**2 - y1)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor5D/state_variables/y2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second state-variable of the second Epileptor5D population (Jirsa et al"
  } ],
