  } ],
  "https://w3id.org/tvbo/phaseSpaceDimension" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/GenericLinear/parameters/gamma",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Slope parameter of the state-variable 'x_GL', representing the inverse of the relaxation time"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "-10.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "gamma (GenericLinear parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Slope parameter of the state-variable 'x_GL', representing the inverse of the relaxation time.\n\nNote: The ‘minus’ sign for the self-connections, scaled by 'gamma_GL', guarantees that the nodes have a stable equilibrium point (ref)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "gamma"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/GenericLinear/state_variables/x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "State-variable of the Generic Linear model"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x (GenericLinear state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "c_pop0 + gamma*x + local_coupling*x"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/GradientBasedOptimization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
