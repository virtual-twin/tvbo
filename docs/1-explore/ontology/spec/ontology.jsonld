}, {
  "@id" : "https://w3id.org/tvbo/StefanescuJirsa2D",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Reduced set of FitzHugh-Nagumo oscillators (Stefanescu & Jirsa 2008). A low-dimensional description of globally coupled heterogeneous excitatory and inhibitory FitzHugh-Nagumo populations. The reduction projects an infinite population onto `number_of_modes` modes and yields per-mode scalar state variables (xi, eta) for the excitatory and (alpha, beta) for the inhibitory subnetwork. The mode-coupling matrices Aik, Bik, Cik and the per-mode inputs IE_i, II_i, m_i, n_i, e_i, f_i are derived offline by Gaussian quadrature over the heterogeneity distribution N(mu, sigma^2); see TVB reference implementation `tvb.simulator.models.stefanescu_jirsa.ReducedSetFitzHughNagumo`."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "StefanescuJirsa2D"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Stefanescu-Jirsa 2D"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Bistable"
  }, {
    "@id" : "https://w3id.org/tvbo/Bursting"
  }, {
    "@id" : "https://w3id.org/tvbo/Oscillatory"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/FixedPoint"
  }, {
    "@id" : "https://w3id.org/tvbo/LimitCycle"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
