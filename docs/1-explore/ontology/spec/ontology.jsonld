  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Kuramoto model is a model of synchronization phenomena derived by Yoshiki Kuramoto in 1975 which has since been applied to diverse domains including the study of neuronal oscillations and synchronization."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Cabral2011"
  }, {
