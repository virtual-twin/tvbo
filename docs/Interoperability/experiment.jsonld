{
  "@context": {
    "@vocab": "https://openminds.ebrains.eu/vocab/",
    "tvbo": "https://w3id.org/tvbo/",
    "sands": "https://openminds.ebrains.eu/sands/",
    "core": "https://openminds.ebrains.eu/core/",
    "computation": "https://openminds.ebrains.eu/computation/"
  },
  "@type": "tvbo:SimulationExperiment",
  "id": 1,
  "model": "TEST_Oscillator",
  "references": [],
  "description": "A simple 3-node network simulation using a damped harmonic oscillator model. Demonstrates round-trip conversion to/from OpenMINDS JSON-LD.\n",
  "additional_equations": [],
  "label": "Three-Node Oscillator Network",
  "dynamics": {
    "name": "TEST_Oscillator",
    "label": "Damped Harmonic Oscillator",
    "parameters": {
      "omega": {
        "@type": "tvbo:Parameter",
        "name": "omega",
        "label": "Angular frequency",
        "value": 1.0,
        "unit": "rad_per_s",
        "grounding": [],
        "source_arguments": [],
        "explored_values": [],
        "element_domains": []
      },
      "gamma": {
        "@type": "tvbo:Parameter",
        "name": "gamma",
        "label": "Damping coefficient",
        "value": 0.1,
        "grounding": [],
        "source_arguments": [],
        "explored_values": [],
        "element_domains": []
      },
      "k": {
        "@type": "tvbo:Parameter",
        "name": "k",
        "label": "Coupling strength",
        "value": 0.05,
        "grounding": [],
        "source_arguments": [],
        "explored_values": [],
        "element_domains": []
      }
    },
    "description": "Simple 2D oscillator for testing",
    "references": [],
    "coupling_inputs": {
      "c_in": {
        "@type": "tvbo:CouplingInput",
        "name": "c_in",
        "dimension": 1,
        "keys": [],
        "local": false
      }
    },
    "state_variables": {
      "x": {
        "@type": "tvbo:StateVariable",
        "name": "x",
        "label": "Position",
        "domain": {
          "lo": -10.0,
          "hi": 10.0,
          "log_scale": false,
          "explored_values": []
        },
        "equation": {
          "lhs": "d(x)/dt",
          "rhs": "y",
          "conditionals": [],
          "latex": false
        },
        "record": true,
        "grounding": [],
        "variable_of_interest": true,
        "coupling_variable": false,
        "equation_type": "differential",
        "equation_order": 1,
        "initial_value": 1.0
      },
      "y": {
        "@type": "tvbo:StateVariable",
        "name": "y",
        "label": "Velocity",
        "equation": {
          "lhs": "d(y)/dt",
          "rhs": "-omega**2 * x - gamma * y + k * c_in",
          "conditionals": [],
          "latex": false
        },
        "record": true,
        "grounding": [],
        "variable_of_interest": true,
        "coupling_variable": true,
        "equation_type": "differential",
        "equation_order": 1,
        "initial_value": 0.0
      }
    },
    "output": [],
    "number_of_modes": 1,
    "system_type": "continuous",
    "autonomous": true,
    "cse": false,
    "compile": false
  },
  "integration": {
    "method": "heun",
    "abs_tol": 1e-10,
    "rel_tol": 1e-10,
    "step_size": 0.1,
    "duration": 100.0,
    "state_wise_sigma": [],
    "transient_time": 0.0,
    "block_size": 1000,
    "scipy_ode_base": false,
    "number_of_stages": 2,
    "intermediate_expressions": {
      "X1": {
        "@type": "tvbo:DerivedVariable",
        "name": "X1",
        "equation": {
          "lhs": "X1",
          "rhs": "X + dX0 * dt + noise + stimulus * dt",
          "conditionals": [],
          "latex": false
        },
        "record": false,
        "grounding": []
      }
    },
    "update_expression": {
      "name": "dX",
      "equation": {
        "lhs": "X_{t+1}",
        "rhs": "(dX0 + dX1) * (dt / 2)",
        "conditionals": [],
        "latex": false
      },
      "record": false,
      "grounding": []
    },
    "delayed": true
  },
  "network": {
    "parameters": {
      "conduction_speed": {
        "@type": "tvbo:Parameter",
        "name": "conduction_speed",
        "label": "v",
        "value": 3.0,
        "unit": "mm_per_ms",
        "grounding": [],
        "source_arguments": [],
        "explored_values": [],
        "element_domains": []
      }
    },
    "nodes": [
      {
        "id": 0,
        "label": "Region_A",
        "alternateName": [],
        "record": true,
        "size": 1
      },
      {
        "id": 1,
        "label": "Region_B",
        "alternateName": [],
        "record": true,
        "size": 1
      },
      {
        "id": 2,
        "label": "Region_C",
        "alternateName": [],
        "record": true,
        "size": 1
      }
    ],
    "edges": [
      {
        "parameters": {
          "weight": {
            "@type": "tvbo:Parameter",
            "name": "weight",
            "value": 0.5,
            "grounding": [],
            "source_arguments": [],
            "explored_values": [],
            "element_domains": []
          }
        },
        "source": 0,
        "target": 1,
        "weighted": true,
        "valid_diagonal": false,
        "non_negative": true,
        "directed": false,
        "allow_self_connections": true,
        "dimension_labels": []
      },
      {
        "parameters": {
          "weight": {
            "@type": "tvbo:Parameter",
            "name": "weight",
            "value": 0.5,
            "grounding": [],
            "source_arguments": [],
            "explored_values": [],
            "element_domains": []
          }
        },
        "source": 1,
        "target": 0,
        "weighted": true,
        "valid_diagonal": false,
        "non_negative": true,
        "directed": false,
        "allow_self_connections": true,
        "dimension_labels": []
      },
      {
        "parameters": {
          "weight": {
            "@type": "tvbo:Parameter",
            "name": "weight",
            "value": 0.3,
            "grounding": [],
            "source_arguments": [],
            "explored_values": [],
            "element_domains": []
          }
        },
        "source": 1,
        "target": 2,
        "weighted": true,
        "valid_diagonal": false,
        "non_negative": true,
        "directed": false,
        "allow_self_connections": true,
        "dimension_labels": []
      },
      {
        "parameters": {
          "weight": {
            "@type": "tvbo:Parameter",
            "name": "weight",
            "value": 0.3,
            "grounding": [],
            "source_arguments": [],
            "explored_values": [],
            "element_domains": []
          }
        },
        "source": 2,
        "target": 1,
        "weighted": true,
        "valid_diagonal": false,
        "non_negative": true,
        "directed": false,
        "allow_self_connections": true,
        "dimension_labels": []
      },
      {
        "parameters": {
          "weight": {
            "@type": "tvbo:Parameter",
            "name": "weight",
            "value": 0.2,
            "grounding": [],
            "source_arguments": [],
            "explored_values": [],
            "element_domains": []
          }
        },
        "source": 0,
        "target": 2,
        "weighted": true,
        "valid_diagonal": false,
        "non_negative": true,
        "directed": false,
        "allow_self_connections": true,
        "dimension_labels": []
      },
      {
        "parameters": {
          "weight": {
            "@type": "tvbo:Parameter",
            "name": "weight",
            "value": 0.2,
            "grounding": [],
            "source_arguments": [],
            "explored_values": [],
            "element_domains": []
          }
        },
        "source": 2,
        "target": 0,
        "weighted": true,
        "valid_diagonal": false,
        "non_negative": true,
        "directed": false,
        "allow_self_connections": true,
        "dimension_labels": []
      }
    ],
    "coupling": {
      "Linear": {
        "@type": "tvbo:Coupling",
        "name": "Linear",
        "label": "Linear Diffusive Coupling",
        "parameters": {
          "b": {
            "@type": "tvbo:Parameter",
            "name": "b",
            "value": 0.0,
            "description": "Shifts the base of the connection strength while maintaining the absolute difference between different values.",
            "grounding": [],
            "source_arguments": [],
            "explored_values": [],
            "element_domains": []
          },
          "a": {
            "@type": "tvbo:Parameter",
            "name": "a",
            "value": 0.00390625,
            "description": "Linear scaling factor of the coupled (delayed) input.",
            "grounding": [],
            "source_arguments": [],
            "explored_values": [],
            "element_domains": []
          }
        },
        "sparse": false,
        "pre_expression": {
          "rhs": "x_j",
          "conditionals": [],
          "latex": false
        },
        "post_expression": {
          "rhs": "a*gx + b",
          "conditionals": [],
          "latex": false
        },
        "incoming_states": [],
        "local_states": [],
        "delayed": true,
        "interpolate_delays": false,
        "vectorized": false,
        "symmetry": "directed",
        "outsym": []
      }
    },
    "number_of_nodes": 3,
    "transforms": [],
    "structural_measures": [],
    "observational_measures": [],
    "edge_matrix_files": []
  },
  "@id": "https://example.org/simulations/experiments/1"
}
