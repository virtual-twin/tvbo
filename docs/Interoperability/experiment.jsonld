    "scipy_ode_base": false,
    "number_of_stages": 2,
    "intermediate_expressions": {
      "X1": {
        "@type": "tvbo:DerivedVariable",
        "name": "X1",
        "equation": {
          "lhs": "X1",
          "rhs": "X + dX0 * dt + noise + stimulus * dt",
          "conditionals": [],
          "latex": false
        },
        "conditional": false,
        "cases": []
      }
    },
    "update_expression": {
      "name": "dX",
      "equation": {
        "lhs": "X_{t+1}",
        "rhs": "(dX0 + dX1) * (dt / 2)",
        "conditionals": [],
        "latex": false
      },
      "conditional": false,
      "cases": []
    },
    "delayed": true
  },
