<!-- The INTERNAL and PUBLIC builds are one file. Showing the paper's own published figures is copyright-restricted, so this report renders two ways depending on the entry file Quarto is building, which it exposes to the kernel as QUARTO_DOCUMENT_FILE: report.qmd is the PUBLIC build and carries only our reproduction, report_internal.qmd is the INTERNAL one and puts the paper's figure beside each reproduction for A/B checking, is git-ignored, and can never write report.pdf.

     Everything a replication report does the same way lives in tvbo rather than here: number formatting, container reading, recipe lookups, the A/B figure composition and the scorecard. This file should end up holding only what is specific to this study, which is its metrics. -->

```{python}
#| label: setup
#| echo: false
import sys, numpy as np, xarray as xr, yaml, matplotlib.pyplot as plt
from pathlib import Path
from tvbo.utils.study_layout import study_path, study_root

ROOT = study_root(Path.cwd())   # every path comes from the layout record, so moving a directory there moves it here
sys.path.insert(0, str(study_path("code", root=ROOT)))
SOURCEDATA = study_path("sourcedata", root=ROOT)
RESULTS = study_path("results", root=ROOT)
FIGS = study_path("figures", root=ROOT)

from tvbo.cli.figures import reference_image_for
from tvbo.utils.report import (
    Scorecard, analysis_scalar, crossref_div, embed_path, figure_caption, figure_title,
    figures_in_paper_order, fmt, is_internal, md_table, open_result, recipe_param,
    report_figure, result_sidecar, sci, sidecar_value,
)
from tvbo.classes.study import SimulationStudy

INTERNAL = is_internal()
CLEARED = False   # True ONLY with documented copyright clearance from the publisher AND the authors


def original(fig):
    """The published figure and its attribution, resolved only where we may show them.

    Two grounds permit it: the INTERNAL build, which is local and git-ignored, or documented clearance. Resolving both here means the public build never opens the file nor builds the credit line — a `CREDIT` constant at the top of the report is one careless argument away from the shareable PDF. `report_figure` raises rather than embedding an original without one of the grounds.
    """
    if not (CLEARED or INTERNAL):
        return None, ""
    return reference_image_for(fig, ROOT), "<Author> et al. <Year> (c)"


STUDY = SimulationStudy.from_file("../<Study>.yaml")
EXP = STUDY.get_experiment(<base_exp_id>)      # e.g. the uncontrolled/base variant
# CTRL = STUDY.get_experiment(<ctrl_exp_id>)   # e.g. a controlled variant, if any
SC = Scorecard(study_path("analysis", root=ROOT) / "targets.md")


def param(exp_id, name):
    """A model parameter read from the recipe metadata, so no number below is hand-typed."""
    return recipe_param(STUDY.get_experiment(exp_id), name)


def peak_rate(exp_id):
    """The quantity the paper reports, straight out of the run that produced it."""
    ds = open_result(RESULTS, str(exp_id))
    return None if ds is None else float(ds["r_E"].max())


def grid_counts():
    """Topology counts from the processed connectome, so the exact-match claims compute."""
    p = SOURCEDATA / "<study>_grid.npz"
    if not p.exists():
        return {}
    d = np.load(str(p), allow_pickle=True)
    return dict(n_nodes=int(np.asarray(d["A"]).shape[0]))   # plus n_lines, n_gen and whatever else the claims need


M = dict(
    K=param(<base_exp_id>, "K"),
    **grid_counts(),
    # n_sol=solitary_count("exp<id>"), tc=decay_time("exp<id>"), ...
)
```

