# Seeded as docs/_quarto.yml: one project, two entries — report.qmd builds the public report.pdf and report_internal.qmd the git-ignored A/B build, which is why neither carries front matter (see the header of report.qmd).
project:
  type: default
  render:
    - report.qmd
    - report_internal.qmd
title: "TVBO replication of <Author> et al. (<Year>)"
subtitle: "*<Paper title>* (<venue>), replicated with a single declarative tvbo recipe"
format:
  pdf:
    output-file: report.pdf
    pdf-engine: xelatex
    documentclass: scrartcl
    toc: true
    toc-depth: 2
    number-sections: true
    colorlinks: true
    fig-width: 7
    fig-pos: "H"
    geometry:
      - margin=2cm
    include-in-header:
      text: |
        \usepackage{etoolbox}
        \usepackage{ragged2e}
        \AtBeginEnvironment{longtable}{\small\RaggedRight}
callout-icon: false
bibliography: references.bib
jupyter: python3
execute:
  echo: false
  warning: false
