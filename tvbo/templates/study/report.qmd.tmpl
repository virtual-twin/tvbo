```{python}
#| label: setup
#| echo: false
import sys, numpy as np, xarray as xr, yaml, matplotlib.pyplot as plt
from pathlib import Path
from tvbo.utils.study_layout import study_path, study_root

ROOT = study_root(Path.cwd())   # every path comes from the layout record, so moving a directory there moves it here
sys.path.insert(0, str(study_path("code", root=ROOT)))
SOURCEDATA = study_path("sourcedata", root=ROOT)
RESULTS = study_path("results", root=ROOT)
FIGS = study_path("figures", root=ROOT)

from tvbo.utils.report import (
    analysis_scalar, crossref_div, embed_path, figure_caption, figure_title,
    figures_ordered, fmt, md_table, open_result, recipe_param, report_figure,
    result_sidecar, sci, sidecar_value,
)
from tvbo.classes.study import SimulationStudy

STUDY = SimulationStudy.from_file("../{study}.yaml")
EXP = STUDY.get_experiment(<exp_id>)


def param(exp_id, name):
    """A model parameter read from the recipe metadata, so no number below is hand-typed."""
    return recipe_param(STUDY.get_experiment(exp_id), name)


def peak_rate(exp_id):
    """One study-specific metric, as an example: open the container a run produced, return a number."""
    ds = open_result(RESULTS, str(exp_id))
    return None if ds is None else float(ds["r_E"].max())


M = dict(
    K=param(<exp_id>, "K"),
    # peak=peak_rate("<exp_id>"), tau=analysis_scalar(RESULTS, "<analysis>", "<variable>"), ...
)
```

