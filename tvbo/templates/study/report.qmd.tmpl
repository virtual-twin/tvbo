#| echo: false
import sys, numpy as np, xarray as xr, yaml, matplotlib.pyplot as plt
from pathlib import Path
sys.path.insert(0, str(Path("../code").resolve()))   # builder + analysis callables
ROOT = Path("..").resolve()
OUT = ROOT / "output"; INPUT = ROOT / "input"
FIGS = ROOT / "figures"                               # our reproduction figures (git-ignored)
STAGE = Path("_figures")                              # staged for the render (git-ignored)

# --- INTERNAL vs PUBLIC build (copyright-safe, chosen by WHICH entry file is rendering) --------
# Showing the paper's own published figures is copyright-restricted, so ONE report.qmd renders
# two ways depending on the entry file Quarto is building (it exposes the input filename as
# QUARTO_DOCUMENT_FILE):
#   report.qmd          -> PUBLIC   -> report.pdf          : ONLY our reproduction (no © originals).
#   report_internal.qmd -> INTERNAL -> report_internal.pdf : paper figure beside each reproduction
#                                                            for A/B validation. Local-only, git-ignored.
# `quarto render` (no file arg) builds BOTH from the project `render:` list — one command, no
# --profile, no post-render hook. The internal (© author) build can never write report.pdf.
# The shared report toolkit. Everything a replication report does the same way lives in tvbo:
# number formatting, container reading, recipe lookups, the A/B figure composition and the
# scorecard. This file should end up holding ONLY what is specific to this study -- its metrics.
from tvbo.cli.figures import reference_image_for
from tvbo.utils.report import (
    Scorecard, analysis_scalar, crossref_div, figure_caption, figure_title,
    figures_in_paper_order, fmt, is_internal, md_table, open_result, recipe_param,
    report_figure, result_sidecar, sci, sidecar_value,
)
INTERNAL = is_internal()

CLEARED = False   # True ONLY with documented copyright clearance from publisher AND authors

def original(fig):
    """The published figure and its attribution, resolved only where we may show them.

    Two grounds permit it: the INTERNAL build (local, git-ignored) or documented clearance.
    Resolving BOTH here means the public build never opens the file nor builds the credit line
    -- a `CREDIT` constant at the top of the report is one careless argument from the shareable
    PDF. `report_figure` raises rather than embedding an original without one of the grounds.
    """
    if not (CLEARED or INTERNAL):
        return None, ""
    return reference_image_for(fig, ROOT), "<Author> et al. <Year> (c)"

# ---- Every reported number is computed here from the result container or metadata. ----
# No value below this line may be typed into prose/captions. Reference M[...] via inline
# `{python} ...`. Papers are not ground truth; your own asserted numbers are not either.
from tvbo.classes.study import SimulationStudy
STUDY = SimulationStudy.from_file("../<Study>.yaml")
EXP  = STUDY.get_experiment(<base_exp_id>)     # e.g. the uncontrolled/base variant

# CTRL = STUDY.get_experiment(<ctrl_exp_id>)   # e.g. a controlled variant, if any

def param(exp_id, name):
    """A model parameter straight from the recipe metadata (never hand-typed)."""
    return recipe_param(STUDY.get_experiment(exp_id), name)

# --- Study-specific metric functions: read a container, return a number. Examples: ---
def grid_counts():
    """Topology counts from the processed connectome, so the exact-match claims compute."""
    p = INPUT / "<study>_grid.npz"
    if not p.exists():
        return {}
    d = np.load(str(p), allow_pickle=True)
    return dict(n_nodes=int(np.asarray(d["A"]).shape[0]))   # + n_lines, n_gen, ... as needed

# One dict, computed once. The prose/captions reference these via inline code.
M = dict(
    K=param(<base_exp_id>, "K"),
    **grid_counts(),
    # n_sol=solitary_count("exp<id>"), tc=decay_time("exp<id>"), ...
)
