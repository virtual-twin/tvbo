<%doc>
    Nextflow configuration generated by `tvbo workflow nextflow`; `nextflow run main.nf` reads it from beside the pipeline.

    Inputs: plan (tvbo.run.workflow.WorkflowPlan), block (dict), now (str).
</%doc>\
// Generated by tvbo workflow nextflow — ${now}
% if plan.container:
process.container = '${plan.container}'
## process.container takes effect only while a container runtime is enabled.
singularity.enabled = true
## Binds the work directories Nextflow stages each task through.
singularity.autoMounts = true
## The kit itself, where a task reads the results tree, then the host paths the recipe declares beyond the runtime's defaults (container_binds/args).
singularity.runOptions = "--bind ${'${projectDir}'}${(" " + plan.container_exec_flags.replace("\\", "\\\\").replace("$", "\\$").replace('"', '\\"')) if plan.container_exec_flags else ""}"
% endif
% if block.get("executor"):
process.executor = '${block["executor"]}'
% endif
% if block.get("queue"):
process.queue = '${block["queue"]}'
% endif
## Passthrough: each option is a Nextflow process directive (e.g. clusterOptions, memory, beforeScript).
% for _opt in (block.get("options") or []):
process.${_opt["name"]} = '${_opt["value"]}'
% endfor
