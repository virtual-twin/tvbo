<%doc>
    Nextflow DSL2 pipeline generated by `tvbo workflow nextflow`; nextflow.config beside it carries the container, the executor and the process directives.

    Inputs: plan (tvbo.run.workflow.WorkflowPlan), block (dict), now (str), spec_relpath (str|None), bundled_code (bool), result_stem (str).
</%doc>\
<%
import shlex

from tvbo.run.workflow import cell_out_relpath, cell_run_flag

axes = plan.workflow_axes
run_target = context.get("spec_relpath") or plan.run_spec
CONTINUE = "\\\\"

def _nf(name):
    """The Groovy interpolation of *name*, spelled here because Mako reads a bare one as its own."""
    return "${" + name + "}"

def _sh(text):
    """Shell text as the script's Groovy string has to hold it: a backslash and a dollar sign are that string's own, so each is escaped."""
    return str(text).replace("\\", "\\\\").replace("$", "\\$")

_ep = {"axes": [{"name": ax.name, "parameter": ax.parameter} for ax in axes], "result_stem": context.get("result_stem") or "result"}
cell_dir = os.path.dirname(cell_out_relpath(_ep, wildcard=_nf))
publish_root = ("" if os.path.isabs(plan.out_dir) else _nf("projectDir") + "/") + plan.out_dir + "/" + str(plan.experiment_key)
reference_root = ("" if os.path.isabs(plan.reference_root) else '"' + _nf("projectDir") + '"/') + _sh(shlex.quote(plan.reference_root))
# The kit's read-only directories, staged into each task so its working directory mirrors the kit root and a container mounts them.
staged = ["spec", "data", "code"]
if getattr(plan, "needs_container_layer", False):
    staged.append(plan.container_extras_venv.split("/")[0])
staged = list(dict.fromkeys(staged))
%>\
// ------------------------------------------------------------------
// Generated by tvbo workflow nextflow — ${now}
//   study      : ${plan.study_key}
//   experiment : ${plan.experiment_key}
//   backend    : ${plan.backend.name}
//   workflow wildcards : ${plan.wildcards}
//   vectorized inside backend: ${[ax.name for ax in plan.vectorize_axes]}
// ------------------------------------------------------------------

nextflow.enable.dsl = 2

process tvbo_run {
    tag "${plan.experiment_key}${''.join(' %s=%s' % (ax.name, _nf(ax.name)) for ax in axes)}"
## A task writes under out/ in its own work directory; publishing drops that prefix, so the kit's results tree holds the paths the other launchers write.
    publishDir "${publish_root}", mode: 'copy', saveAs: { name -> name.substring(4) }
    input:
% if len(axes) == 1:
        val ${axes[0].name}
% elif axes:
        tuple ${', '.join('val(%s)' % ax.name for ax in axes)}
% endif
        path kit, stageAs: 'kit/*'
    output:
        path 'out/**'

    script:
    """
    cd kit
## env is exported ahead of the task command (values shell-quoted in the plan).
% for _e in (block.get("env") or []):
    export ${_e['name']}=${_sh(_e['value'])}
% endfor
% if getattr(plan, "needs_container_layer", False):
## Exposes the venv setup.sh provisioned; the glob resolves its interpreter version.
    export PYTHONPATH=${_sh('$(echo "$PWD/' + plan.container_extras_venv + '"/lib/python*/site-packages):${PYTHONPATH:-}')}
% endif
% if context.get("bundled_code"):
    export PYTHONPATH=${_sh('code:${PYTHONPATH:-}')}
% endif
    tvbo run ${_sh(shlex.quote(str(run_target)))} ${CONTINUE}
        --backend=${plan.backend.name} ${CONTINUE}
% if getattr(plan, "experiment_selector", None) and not context.get("spec_relpath"):
        --experiment=${_sh(shlex.quote(str(plan.experiment_selector)))} ${CONTINUE}
% endif
## What a run reads and does not write (a source run's results, staged analysis containers) is under the plan's reference root. A task runs in a work directory of its own, so a kit-relative root is spelled from the pipeline's directory; it is not staged, because its content changes as results are published and would end every cached task.
        --results-root ${reference_root} ${CONTINUE}
% for ax in axes:
        ${cell_run_flag(ax.parameter, _nf(ax.name))} ${CONTINUE}
% endfor
        -o ../out${"/" + cell_dir if cell_dir else ""}
    """
}

workflow {
    kit = channel.value(${staged}.collect { name -> file("${_nf('projectDir')}/${_nf('name')}") }.findAll { dir -> dir.exists() })
% if axes:
    cells = ${".combine(".join("channel.of(%s)" % ", ".join(repr(str(v)) for v in ax.values) + (")" if i else "") for i, ax in enumerate(axes))}
    tvbo_run(cells, kit)
% else:
    tvbo_run(kit)
% endif
}
