## Figure render rules generated by tvbo.adapters.figure_workflow.emit_figure_rules.
##
## Structure only — all resolution (used->inputs, workflow_overrides->resources,
## mem/time unit conversion) happens in figure_workflow.py; this template just
## emits the rule skeleton from a clean context (the house codegen rule).
##
## Context:
##   figures      list[dict] — one per Figure, see keys below.
##   now          str        — emit timestamp.
##   include_all  bool       — prepend an aggregate `all_figures` target rule.
##
## Each figure dict: {name, rule_name, inputs (list[str], absolute container paths),
##   output (str), figures_dir (str), script (str), threads (int),
##   resources (dict[str, python-literal-str]), container (str|None),
##   setup (list[str]), env (list[{name, value}])}.
<%
def _q(p):
    """A path/string emitted as a Snakemake (python) string literal."""
    return repr(str(p))
%>\
# ------------------------------------------------------------------
# Figure render rules — generated by tvbo workflow (figures) ${now}
#   figures : ${", ".join(f["name"] for f in figures)}
# A figure's PROV `used` containers ARE its workflow inputs: each render
# rule declares the experiment result containers its layers bind to, so the
# engine schedules it after those experiments' rules (used-edge == dep-edge).
# ------------------------------------------------------------------
% if include_all:

rule all_figures:
    input:
% for f in figures:
        ${_q(f["output"])}${"," if not loop.last else ""}
% endfor
% endif

% for f in figures:
rule ${f["rule_name"]}:
% if f["inputs"]:
    # PROV used -> workflow input: the containers this figure's layers read.
    input:
% for _in in f["inputs"]:
        ${_q(_in)}${"," if not loop.last else ""}
% endfor
% endif
    output:
        ${_q(f["output"])}
% if f.get("container"):
    container:
        ${_q(f["container"])}
% endif
    threads: ${f["threads"]}
% if f.get("resources"):
    # Merged from figure.workflow_overrides over the study-level workflow; the
    # SLURM executor turns these into --cpus-per-task / --mem / --time / etc.
    resources:
% for _k, _v in f["resources"].items():
        ${_k}=${_v}${"" if loop.last else ","}
% endfor
% endif
    shell:
% for _line in (f.get("setup") or []):
        ${repr(_line + " && ")}
% endfor
% for _e in (f.get("env") or []):
        "export ${_e['name']}=${_e['value']} && "
% endfor
        "mkdir -p ${f['figures_dir']} && "
        "python ${f['script']}"

% endfor
