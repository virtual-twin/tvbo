## Snakefile generated by `tvbo workflow snakemake`.
## Inputs: plan (tvbo.cli._workflow.WorkflowPlan), block (dict), now (str).
<%
def _wildcard_glob(name):
    return "{" + name + "}"

def _values_for(ax):
    return ", ".join(repr(v) for v in ax.values)

axes = plan.workflow_axes
%>\
# ------------------------------------------------------------------
# Snakefile generated by tvbo workflow snakemake — ${now}
#   study      : ${plan.study_key}
#   experiment : ${plan.experiment_key}
#   backend    : ${plan.backend.name}
#   workflow wildcards : ${plan.wildcards}
#   vectorized inside backend: ${[ax.name for ax in plan.vectorize_axes]}
% if plan.overrides:
#   CLI overrides applied:
%   for ov in plan.overrides:
#     - ${ov}
%   endfor
% endif
# ------------------------------------------------------------------

% if plan.container:
container: "${plan.container}"
% endif

# Sweep grids (workflow-fanned axes) ---------------------------------------
% for ax in axes:
${ax.name.upper()}_VALUES = [${_values_for(ax)}]
% endfor

OUT_DIR = "${plan.out_dir}".format(study="${plan.study_key}", experiment="${plan.experiment_key}")

rule all:
    input:
% if axes:
        expand(
            f"{OUT_DIR}/${'/'.join('%s=%s' % (ax.name, _wildcard_glob(ax.name)) for ax in axes)}/result.h5",
%   for ax in axes:
            ${ax.name}=${ax.name.upper()}_VALUES${"," if not loop.last else ""}
%   endfor
        )
% else:
        f"{OUT_DIR}/result.h5"
% endif

rule ${plan.experiment_key.replace("-", "_")}:
    output:
% if axes:
        f"{OUT_DIR}/${'/'.join('%s=%s' % (ax.name, _wildcard_glob(ax.name)) for ax in axes)}/result.h5"
% else:
        f"{OUT_DIR}/result.h5"
% endif
    threads: ${block.get("cores") or 1}
    retries: ${plan.retries}
    shell:
% if script_relpath:
        "python ${script_relpath} "
% for ax in axes:
        "--override=${ax.parameter}=${'{wildcards.' + ax.name + '}'} "
% endfor
% for ax in plan.vectorize_axes:
        "--sweep=${ax.parameter}=${','.join(repr(v) for v in ax.values)} "
% endfor
        "-o $(dirname {output})"
% else:
        "tvbo run experiment:${plan.experiment_key} "
        "--backend=${plan.backend.name} "
% for ax in axes:
        "--override=${ax.parameter}=${'{wildcards.' + ax.name + '}'} "
% endfor
% for ax in plan.vectorize_axes:
        "--sweep=${ax.parameter}=${','.join(repr(v) for v in ax.values)} "
% endfor
        "-o $(dirname {output})"
% endif
