## Snakefile generated by `tvbo workflow snakemake`.
## Inputs: exp_plans (list of dicts, one per experiment), block (dict), now (str).
##   Each exp_plan: {key, rule_name, spec_relpath, backend, out_dir, result_stem,
##                   axes (list of {name, parameter, values}), container}.
<%
def _wildcard(name):
    return "{" + name + "}"

def _values(vals):
    return ", ".join(repr(v) for v in vals)

def _cell_out(ep):
    """Per-cell output basename = exactly the file `tvbo run` writes for this cell."""
    axes = ep["axes"]
    is_subject_only = len(axes) == 1 and axes[0]["parameter"] == "dataset.active_subject"
    if is_subject_only:
        return "sub-" + _wildcard("subject") + "_" + ep["result_stem"] + ".h5"
    if axes:
        return "/".join("%s=%s" % (a["name"], _wildcard(a["name"])) for a in axes) + "/" + ep["result_stem"] + ".h5"
    return ep["result_stem"] + ".h5"

def _run_flags(ep):
    """Per-cell `tvbo run` flags: --subject for the dataset fan-out, --set for others.
    Shell directives reference wildcards as ``{wildcards.<name>}``."""
    out = []
    for a in ep["axes"]:
        wc = "{wildcards.%s}" % a["name"]
        if a["parameter"] == "dataset.active_subject":
            out.append("--subject=" + wc)
        else:
            out.append("--set=%s=%s" % (a["parameter"], wc))
    return out

# key -> plan, so a from_experiment dependency can reference the source's output.
_ep_by_key = {ep["key"]: ep for ep in exp_plans}

def _expand_kwargs(ep):
    return ", ".join("%s=%s" % (a["name"], ep["rule_name"].upper() + "_" + a["name"].upper())
                     for a in ep["axes"])

def _mem_mb(mem):
    """'8G'/'8GB'/'512M'/'2000' -> integer megabytes (Snakemake mem_mb)."""
    if not mem:
        return None
    s = str(mem).strip().upper().rstrip("B")
    try:
        if s.endswith("G"): return int(float(s[:-1]) * 1000)
        if s.endswith("M"): return int(float(s[:-1]))
        if s.endswith("K"): return max(1, int(float(s[:-1]) / 1000))
        return int(float(s))
    except ValueError:
        return None

def _runtime_min(t):
    """'08:00:00' (HH:MM:SS) or '480' -> integer minutes (Snakemake runtime)."""
    if not t:
        return None
    s = str(t).strip()
    try:
        if ":" in s:
            p = [int(x) for x in s.split(":")]
            if len(p) == 3: return p[0] * 60 + p[1] + (1 if p[2] else 0)
            if len(p) == 2: return p[0] + (1 if p[1] else 0)
        return int(float(s))
    except ValueError:
        return None

def _rule_resources(block):
    """Intrinsic per-rule resources for the Snakemake job → dict of {key: python-literal}.
    The SLURM executor reads cpus_per_task/mem_mb/runtime; partition/account live in the
    shipped profile. options[] passes through any extra resources verbatim."""
    r = {}
    if block.get("cpus_per_task"):
        r["cpus_per_task"] = int(block["cpus_per_task"])
    mb = _mem_mb(block.get("mem"))
    if mb:
        r["mem_mb"] = mb
    rt = _runtime_min(block.get("time"))
    if rt:
        r["runtime"] = rt
    for opt in (block.get("options") or []):
        v = str(opt["value"])
        # numeric -> bare int; plain string -> "quoted"; anything with a quote -> repr (safely escaped)
        r[opt["name"]] = int(v) if v.lstrip("-").isdigit() else ('"%s"' % v if '"' not in v else repr(v))
    return r
%>\
# ------------------------------------------------------------------
# Snakefile generated by tvbo workflow snakemake — ${now}
#   experiments : ${", ".join(ep["key"] for ep in exp_plans)}
# Each experiment is one rule; experiments with a dataset fan out per subject,
# explorations fan/vectorize per sweep cell, group runs are a single job.
# ------------------------------------------------------------------

% if exp_plans and exp_plans[0].get("container"):
container: "${exp_plans[0]['container']}"
% endif

# Per-experiment fan-out value lists ---------------------------------------
% for ep in exp_plans:
% for ax in ep["axes"]:
${ep["rule_name"].upper()}_${ax["name"].upper()} = [${_values(ax["values"])}]
% endfor
% endfor

OUT_DIR = "${exp_plans[0]['out_dir'] if exp_plans else 'results'}"

rule all:
    input:
% for ep in exp_plans:
<% axes = ep["axes"] %>\
% if axes:
        expand(
            f"{OUT_DIR}/${ep['key']}/${_cell_out(ep)}",
% for ax in axes:
            ${ax["name"]}=${ep["rule_name"].upper()}_${ax["name"].upper()}${"," if not loop.last else ""}
% endfor
        ),
% else:
        f"{OUT_DIR}/${ep['key']}/${_cell_out(ep)}",
% endif
% endfor

% for ep in exp_plans:
rule ${ep["rule_name"]}:
% if ep.get("depends_on"):
    # initial_state.from_experiment: the source experiment's result must exist first,
    # so Snakemake orders it before this rule (its operating point seeds this run).
    input:
% for _dep in ep["depends_on"]:
<% _dep_ep = _ep_by_key.get(_dep) %>\
% if _dep_ep and _dep_ep["axes"]:
        expand(f"{OUT_DIR}/${_dep}/${_cell_out(_dep_ep)}", ${_expand_kwargs(_dep_ep)}),
% elif _dep_ep:
        f"{OUT_DIR}/${_dep}/${_cell_out(_dep_ep)}",
% endif
% endfor
% endif
    output:
        f"{OUT_DIR}/${ep['key']}/${_cell_out(ep)}"
    threads: ${block.get("cpus_per_task") or block.get("cores") or 1}
<% _res = _rule_resources(block) %>\
% if _res:
    # Intrinsic resources; the SLURM executor (via the shipped profile) turns these
    # into --cpus-per-task / --mem / --time on each submitted job.
    resources:
% for _k, _v in _res.items():
        ${_k}=${_v}${"" if loop.last else ","}
% endfor
% endif
    shell:
% for _line in (block.get("setup") or []):
        ${repr(_line + " && ")}
% endfor
% if context.get("bundled_code"):
        "export PYTHONPATH=code:${'$'}{PYTHONPATH:-} && "
% endif
% for _e in (block.get("env") or []):
        "export ${_e['name']}=${_e['value']} && "
% endfor
        "tvbo run ${ep['spec_relpath']} "
        "--backend=${ep['backend']} "
% if ep.get("select"):
        "--experiment=${ep['select']} "
% endif
% for _flag in _run_flags(ep):
        "${_flag} "
% endfor
        "-o $(dirname {output})"

% endfor
