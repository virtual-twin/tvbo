<%!
from tvbo.adapters.brian2 import _brian2_const, _dict_literal, _monitor_literal, _ns_literal, assemble_eqs, reset_code


def _init_v(pop):
    v0 = pop["cell_params"].get("v0") or pop["cell_params"].get("EL") or (-70.0, "mV")
    return _brian2_const(*v0)


def _refract(pop):
    return _brian2_const(*pop["cell_params"].get("refract", (0.0, "ms")))


def _connect_args(spec):
    """Render a sparse connect() spec dict as connect(...) keyword arguments."""
    return ", ".join(f"{k}={v!r}" if isinstance(v, str) else f"{k}={v}" for k, v in spec.items())
%>\
"""Brian2 spiking network — generated by TVB-O from ${repr(label or 'experiment')}.

All-to-all conductance synapses are lowered to O(N) population sums: a
pre-synaptic gate + a size-1 "hub" NeuronGroup that accumulates the population
sum once, read by every post-synaptic neuron via linked_var. This is the native,
fast equivalent of the enumerated LEMS network.
"""
import numpy as np
from brian2 import *

prefs.codegen.target = "numpy"
start_scope()
% if seed is not None:
seed(${seed})
% endif
defaultclock.dt = ${dt_ms} * ms

_objects = []

# ── Cell populations ─────────────────────────────────────────────────
% for name, pop in populations.items():
${name}_eqs = """
${assemble_eqs(pop)}
"""
${name} = NeuronGroup(
    ${pop["size"]}, ${name}_eqs,
    threshold="v > thresh", reset="${reset_code(pop)}",
    refractory=${_refract(pop)}, method="euler",
    namespace=${_ns_literal({**pop["cell_params"], **pop["namespace"]})}, name="${name}",
)
${name}.v = ${_init_v(pop)}
% for mvar, frac in pop["masks"].items():
${name}.${mvar} = "rand() < ${frac}"
% endfor
_objects.append(${name})

% endfor
# ── Summed-gate hubs (all-to-all population sums) ────────────────────
% for hub_name, hub in hubs.items():
${hub_name} = NeuronGroup(1, "${hub["summed_var"]} : 1", name="${hub_name}")
sum_${hub_name} = Synapses(${hub["source_pop"]}, ${hub_name},
    model="${hub["summed_var"]}_post = ${hub["gate"]}_pre : 1 (summed)", name="sum_${hub_name}")
sum_${hub_name}.connect()
_objects += [${hub_name}, sum_${hub_name}]

% endfor
# ── Link summed gates into the post-synaptic populations ─────────────
% for name, pop in populations.items():
% for svar, (hub_name, field) in pop["linked"].items():
${name}.${svar} = linked_var(${hub_name}, "${field}")
% endfor
% endfor

# ── Sparse projections (real Synapses: random / one_to_one) ──────────
% for sd in synapses:
${sd["name"]} = Synapses(${sd["source"]}, ${sd["target"]},
% if sd["model"]:
    model="""${sd["model"]}""",
% endif
    on_pre="""${sd["on_pre"]}""",
    namespace=${_ns_literal(sd["namespace"])}, method="euler", name="${sd["name"]}")
${sd["name"]}.connect(${_connect_args(sd["connect"])})
% for var, val in sd["init"].items():
${sd["name"]}.${var} = ${val}
% endfor
_objects.append(${sd["name"]})

% endfor

# ── Observation probes (clock-driven, zero-delivery: measure synapse u/x) ──
% if probes:
_probe_sink = NeuronGroup(1, "x_sink : 1", name="probe_sink")
_objects.append(_probe_sink)
% for pr in probes:
${pr["name"]} = Synapses(${pr["source"]}, _probe_sink,
    model="""${pr["model"]}""",
    on_pre="""${pr["on_pre"]}""",
    namespace=${_ns_literal(pr["namespace"])}, method="euler", name="${pr["name"]}")
${pr["name"]}.connect(i=${pr["sample_i"]}, j=0)
% for var, val in pr["init"].items():
${pr["name"]}.${var} = ${val}
% endfor
mon_${pr["name"]} = StateMonitor(${pr["name"]}, ${repr(pr["vars"])}, record=True, dt=${pr["record_dt_ms"]} * ms)
_objects += [${pr["name"]}, mon_${pr["name"]}]

% endfor
% endif
# ── Poisson backgrounds (one independent train per neuron) ───────────
% for name, pop in populations.items():
% for pin in pop["poisson"]:
_objects.append(PoissonInput(${name}, "${pin['gate']}", 1, ${_brian2_const(*pin['rate'])}, weight=${pin['weight']}))
% endfor
% endfor

# ── Spike monitors ───────────────────────────────────────────────────
% for name, pop in populations.items():
mon_${name} = SpikeMonitor(${name})
_objects.append(mon_${name})
% endfor

net = Network(_objects)
% if ramp:

# Quasi-static ramp of ${ramp["parameter"]} with state continued between points: each declared value is written into the namespace constant carrying that projection's weight, the declared settle lets the network relax, and the measured window that follows gives the step's rate.
_VALUES, _HANDLES = ${repr(ramp["values"])}, ${repr(ramp["handles"])}
_settle, _step = ${transient_ms}, ${measured_ms}
_N, _mons = ${_dict_literal(sizes.items())}, ${_monitor_literal(ramp["populations"])}
_groups = {_o.name: _o for _o in net.objects if hasattr(_o, "namespace")}
RAMP = {"parameter": ${repr(ramp["parameter"])}, "values": np.asarray(_VALUES),
        "rates": {_p: [] for _p in _mons}}
for _value in _VALUES:
    for _pop, _key in _HANDLES:
        _groups[_pop].namespace[_key] = float(_value)
    if _settle:
        net.run(_settle * ms)
    _counted = {_p: int(_m.num_spikes) for _p, _m in _mons.items()}
    net.run(_step * ms)
    for _p, _m in _mons.items():
        # An empty population has no rate rather than a division; the window itself is guarded at render.
        RAMP["rates"][_p].append((int(_m.num_spikes) - _counted[_p]) / (_step / 1000.0 * _N[_p]) if _N[_p] else 0.0)
    print(f"{RAMP['parameter']}={_value:g}  " + "  ".join(f"{_p}={RAMP['rates'][_p][-1]:.2f} Hz" for _p in _mons))
RAMP["rates"] = {_p: np.asarray(_v) for _p, _v in RAMP["rates"].items()}
% else:
net.run(${total_ms} * ms)

# ── Population firing rates over the measured window ──────────────────
_settle, _T, _N = ${transient_ms}, ${measured_ms}, ${_dict_literal(sizes.items())}
RATES = {}
for _pop, _mon in ${_monitor_literal(populations)}.items():
    _t = np.asarray(_mon.t / ms)
    _count = int((_t >= _settle).sum())
    RATES[_pop] = _count / (_T / 1000.0 * _N[_pop])
    print(f"{_pop}: {RATES[_pop]:.3f} Hz")
% endif
% if probes:

# ── Recorded synapse-internal state (population-mean u/x + time axis) ──
SYNAPSE_STATE = {}
% for pr in probes:
SYNAPSE_STATE[${repr(pr["key"])}] = {
    # On the measurement clock, like the in-process run reports it: the settle carries negative timestamps and t = 0 opens the measured window.
    "t_ms": np.asarray(mon_${pr["name"]}.t / ms) - ${transient_ms},
    "vars": {_v: np.asarray(getattr(mon_${pr["name"]}, _v)).mean(axis=0) for _v in ${repr(pr["vars"])}},
}
% endfor
% endif
