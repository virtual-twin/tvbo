<%!
from tvbo.adapters.brian2 import _brian2_const, assemble_eqs, reset_code


def _ns_literal(pop):
    """Render the NeuronGroup namespace (cell params + synapse constants)."""
    items = {**pop["cell_params"], **pop["namespace"]}
    return "{" + ", ".join(f"'{k}': {_brian2_const(v, u)}" for k, (v, u) in items.items()) + "}"


def _init_v(pop):
    v0 = pop["cell_params"].get("v0") or pop["cell_params"].get("EL") or (-70.0, "mV")
    return _brian2_const(*v0)


def _refract(pop):
    return _brian2_const(*pop["cell_params"].get("refract", (0.0, "ms")))


def _connect_args(spec):
    """Render a sparse connect() spec dict as connect(...) keyword arguments."""
    return ", ".join(f"{k}={v!r}" if isinstance(v, str) else f"{k}={v}" for k, v in spec.items())


def _syn_ns(ns):
    """Render a Synapses namespace dict (STP constants) as a literal."""
    return "{" + ", ".join(f"'{k}': {_brian2_const(v, u)}" for k, (v, u) in ns.items()) + "}"
%>\
<% settle = min(1000.0, 0.2 * duration_ms) %>\
"""Brian2 spiking network — generated by TVB-O from ${repr(label or 'experiment')}.

All-to-all conductance synapses are lowered to O(N) population sums: a
pre-synaptic gate + a size-1 "hub" NeuronGroup that accumulates the population
sum once, read by every post-synaptic neuron via linked_var. This is the native,
fast equivalent of the enumerated LEMS network.
"""
import numpy as np
from brian2 import *

prefs.codegen.target = "numpy"
start_scope()
% if seed is not None:
seed(${seed})
% endif
defaultclock.dt = ${dt_ms} * ms

_objects = []

# ── Cell populations ─────────────────────────────────────────────────
% for name, pop in populations.items():
${name}_eqs = """
${assemble_eqs(pop)}
"""
${name} = NeuronGroup(
    ${pop["size"]}, ${name}_eqs,
    threshold="v > thresh", reset="${reset_code(pop)}",
    refractory=${_refract(pop)}, method="euler",
    namespace=${_ns_literal(pop)}, name="${name}",
)
${name}.v = ${_init_v(pop)}
% for mvar, frac in pop["masks"].items():
${name}.${mvar} = "rand() < ${frac}"
% endfor
_objects.append(${name})

% endfor
# ── Summed-gate hubs (all-to-all population sums) ────────────────────
% for hub_name, hub in hubs.items():
${hub_name} = NeuronGroup(1, "${hub["summed_var"]} : 1", name="${hub_name}")
sum_${hub_name} = Synapses(${hub["source_pop"]}, ${hub_name},
    model="${hub["summed_var"]}_post = ${hub["gate"]}_pre : 1 (summed)", name="sum_${hub_name}")
sum_${hub_name}.connect()
_objects += [${hub_name}, sum_${hub_name}]

% endfor
# ── Link summed gates into the post-synaptic populations ─────────────
% for name, pop in populations.items():
% for svar, (hub_name, field) in pop["linked"].items():
${name}.${svar} = linked_var(${hub_name}, "${field}")
% endfor
% endfor

# ── Sparse projections (real Synapses: random / one_to_one) ──────────
% for sd in synapses:
${sd["name"]} = Synapses(${sd["source"]}, ${sd["target"]},
% if sd["model"]:
    model="""${sd["model"]}""",
% endif
    on_pre="""${sd["on_pre"]}""",
    namespace=${_syn_ns(sd["namespace"])}, method="euler", name="${sd["name"]}")
${sd["name"]}.connect(${_connect_args(sd["connect"])})
% for var, val in sd["init"].items():
${sd["name"]}.${var} = ${val}
% endfor
_objects.append(${sd["name"]})

% endfor

# ── Observation probes (clock-driven, zero-delivery: measure synapse u/x) ──
% if probes:
_probe_sink = NeuronGroup(1, "x_sink : 1", name="probe_sink")
_objects.append(_probe_sink)
% for pr in probes:
${pr["name"]} = Synapses(${pr["source"]}, _probe_sink,
    model="""${pr["model"]}""",
    on_pre="""${pr["on_pre"]}""",
    namespace=${_syn_ns(pr["namespace"])}, method="euler", name="${pr["name"]}")
${pr["name"]}.connect(i=${pr["sample_i"]}, j=0)
% for var, val in pr["init"].items():
${pr["name"]}.${var} = ${val}
% endfor
mon_${pr["name"]} = StateMonitor(${pr["name"]}, ${repr(pr["vars"])}, record=True, dt=${pr["record_dt_ms"]} * ms)
_objects += [${pr["name"]}, mon_${pr["name"]}]

% endfor
% endif
# ── Poisson backgrounds (one independent train per neuron) ───────────
% for name, pop in populations.items():
% for pin in pop["poisson"]:
_objects.append(PoissonInput(${name}, "${pin['gate']}", 1, ${_brian2_const(*pin['rate'])}, weight=${pin['weight']}))
% endfor
% endfor

# ── Spike monitors ───────────────────────────────────────────────────
% for name, pop in populations.items():
mon_${name} = SpikeMonitor(${name})
_objects.append(mon_${name})
% endfor

net = Network(_objects)
net.run(${duration_ms} * ms)

# ── Population firing rates over the stationary window ────────────────
_settle, _T, _N = ${settle}, ${duration_ms}, {${", ".join(f"'{n}': {p['size']}" for n, p in populations.items())}}
RATES = {}
for _pop, _mon in {${", ".join(f"'{n}': mon_{n}" for n in populations)}}.items():
    _t = np.asarray(_mon.t / ms)
    _count = int((_t >= _settle).sum())
    RATES[_pop] = _count / ((_T - _settle) / 1000.0 * _N[_pop])
    print(f"{_pop}: {RATES[_pop]:.3f} Hz")
% if probes:

# ── Recorded synapse-internal state (population-mean u/x + time axis) ──
SYNAPSE_STATE = {}
% for pr in probes:
SYNAPSE_STATE[${repr(pr["key"])}] = {
    "t_ms": np.asarray(mon_${pr["name"]}.t / ms),
    "vars": {_v: np.asarray(getattr(mon_${pr["name"]}, _v)).mean(axis=0) for _v in ${repr(pr["vars"])}},
}
% endfor
% endif
