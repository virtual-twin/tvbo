## -*- coding: utf-8 -*-
<%doc>
Shared fragment: LEMS Dimensions & Units
=========================================
All standard NeuroML dimensions and units are provided by NeuroMLCoreDimensions.xml,
which is chain-included via Simulation.xml.  We only need to declare
dimensions/units that are NOT in the NeuroML standard.
</%doc>
  <!-- Only "none" is not in NeuroMLCoreDimensions.xml —
       all other dims/units come from Include file="Simulation.xml" -->
  <Dimension name="none"/>
