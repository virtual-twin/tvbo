    <!-- https://w3id.org/tvbo/DevelopmentStatus -->

    <owl:Class rdf:about="https://w3id.org/tvbo/DevelopmentStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/DevelopmentStatus#active"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/DevelopmentStatus#concept"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/DevelopmentStatus#inactive"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/DevelopmentStatus#moved"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/DevelopmentStatus#suspended"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/DevelopmentStatus#unsupported"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/DevelopmentStatus#wip"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>DevelopmentStatus</rdfs:label>
        <skos:definition>Development status of the software. Based on repostatus.org categories.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/DevelopmentStatus#active"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/DevelopmentStatus#concept"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/DevelopmentStatus#inactive"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/DevelopmentStatus#moved"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/DevelopmentStatus#suspended"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/DevelopmentStatus#unsupported"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/DevelopmentStatus#wip"/>
    </owl:Class>
    


