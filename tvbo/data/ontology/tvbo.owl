        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>s_EI (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the I-&gt;E channel.</skos:definition>
        <skos:notation>s_EI</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/s_IE -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/s_IE">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>s_IE (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the E-&gt;I channel.</skos:definition>
        <skos:notation>s_IE</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/s_II -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/s_II">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>s_II (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the I-&gt;I channel.</skos:definition>
        <skos:notation>s_II</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/tau_A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/tau_A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">200.0</schema:defaultValue>
        <rdfs:label>tau_A (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Time constant of the adaptation current.</skos:definition>
        <skos:notation>tau_A</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/tau_se -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/tau_se">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>tau_se (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Synaptic time constant of excitatory PSCs (E-&gt;E and E-&gt;I).</skos:definition>
        <skos:notation>tau_se</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/tau_si -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/tau_si">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>tau_si (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Synaptic time constant of inhibitory PSCs (I-&gt;E and I-&gt;I).</skos:definition>
        <skos:notation>tau_si</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/state_variables/I_A_var -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/state_variables/I_A_var">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(I_A_var, t)</tvbo:lhs>
        <tvbo:rhs>(I_A*(mu_se - E_A) - I_A_var)/tau_A</tvbo:rhs>
        <terms:description>Adaptation current.</terms:description>
        <rdfs:label>I_A_var (CakanObermayer state variable)</rdfs:label>
        <skos:notation>I_A_var</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/state_variables/mu_se -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/state_variables/mu_se">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(mu_se, t)</tvbo:lhs>
        <tvbo:rhs>(J_EE*r_E + J_EI*r_I + mu_E + c_glob - I_A_var/C - mu_se)/tau_se</tvbo:rhs>
        <terms:description>Filtered mean synaptic input current to the excitatory population.</terms:description>
        <rdfs:label>mu_se (CakanObermayer state variable)</rdfs:label>
        <skos:notation>mu_se</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/state_variables/mu_si -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/state_variables/mu_si">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(mu_si, t)</tvbo:lhs>
        <tvbo:rhs>(J_IE*r_E + J_II*r_I + mu_I - mu_si)/tau_si</tvbo:rhs>
        <terms:description>Filtered mean synaptic input current to the inhibitory population.</terms:description>
        <rdfs:label>mu_si (CakanObermayer state variable)</rdfs:label>
        <skos:notation>mu_si</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Half-width of heterogeneous noise distribution</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema:defaultValue>
        <rdfs:label>Delta (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Parameter of the alpha-function</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.95</schema:defaultValue>
        <rdfs:label>alpha (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Parameter of the alpha-function</skos:definition>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <terms:description>Constant parameter to scale the rate of feedback from the             firing rate variable to itself</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">20.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>eta (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the
            firing rate variable to itself</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/k -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/k">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Local coupling strength</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>k (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Local coupling strength</skos:definition>
        <skos:notation>k</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/v_syn -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/v_syn">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <terms:description>QIF membrane reversal potential</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>v_syn (CoombesByrne parameter)</rdfs:label>
        <skos:definition>QIF membrane reversal potential</skos:definition>
        <skos:notation>v_syn</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>V**2 + c_glob + eta + g*(-V + v_syn) - pi**2*r**2</tvbo:rhs>
        <rdfs:label>V (CoombesByrne state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(g, t)</tvbo:lhs>
        <tvbo:rhs>alpha*q</tvbo:rhs>
        <rdfs:label>g (CoombesByrne state variable)</rdfs:label>
        <skos:notation>g</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/q -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/q">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(q, t)</tvbo:lhs>
        <tvbo:rhs>alpha*(-g + pi*k*r - 2*q)</tvbo:rhs>
        <rdfs:label>q (CoombesByrne state variable)</rdfs:label>
        <skos:notation>q</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>Delta/pi + 2*V*r - g*r</tvbo:rhs>
        <rdfs:label>r (CoombesByrne state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Half-width of heterogeneous noise distribution</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>Delta (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <terms:description>Constant parameter to scale the rate of feedback from the             firing rate variable to itself</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>eta (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the
            firing rate variable to itself</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/k -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/k">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Local coupling strength</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>k (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>Local coupling strength</skos:definition>
        <skos:notation>k</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/v_syn -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/v_syn">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <terms:description>QIF membrane reversal potential</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-4.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>v_syn (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>QIF membrane reversal potential</skos:definition>
        <skos:notation>v_syn</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>V**2 + c_glob + eta + pi*k*r*(-V + v_syn) - pi**2*r**2</tvbo:rhs>
        <rdfs:label>V (CoombesByrne2D state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>Delta/pi + 2*V*r - pi*k*r**2</tvbo:rhs>
        <rdfs:label>r (CoombesByrne2D state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/H_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/H_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <tvbo:lhs>H_e</tvbo:lhs>
        <tvbo:rhs>x_e/(1 - exp(-d_e*x_e))</tvbo:rhs>
        <terms:description>Sigmoid function that computes the averaged firing rate of the excitatory neuron population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>H_e (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>H_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/H_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/H_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <tvbo:lhs>H_i</tvbo:lhs>
        <tvbo:rhs>x_i/(1 - exp(-d_i*x_i))</tvbo:rhs>
        <terms:description>Sigmoid function that computes the averaged firing rate of the inhibitory neuron population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>H_i (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>H_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/I_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/I_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <tvbo:lhs>I_e</tvbo:lhs>
        <tvbo:rhs>I_ext + I_o*W_e + J_N_S_e*w_p - J_i*S_i + coupling</tvbo:rhs>
        <terms:description>Input current to the excitatory population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>I_e (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>I_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/I_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/I_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:lhs>I_i</tvbo:lhs>
        <tvbo:rhs>I_o*W_i + J_N_S_e - S_i + coupling*lamda</tvbo:rhs>
        <terms:description>Input current to the inhibitory population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>I_i (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>I_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/J_N_S_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/J_N_S_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>J_N_S_e</tvbo:lhs>
        <tvbo:rhs>J_N*S_e</tvbo:rhs>
        <rdfs:label>J_N_S_e (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>J_N_S_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/coupling -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/coupling">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>coupling</tvbo:lhs>
        <tvbo:rhs>G*J_N*(S_e*local_coupling + c_glob)</tvbo:rhs>
        <rdfs:label>coupling (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>coupling</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/x_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/x_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <tvbo:lhs>x_e</tvbo:lhs>
        <tvbo:rhs>M_i*(a_e*I_e - b_e)</tvbo:rhs>
        <terms:description>Gain-scaled input current to the excitatory population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>x_e (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>x_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/x_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/x_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:lhs>x_i</tvbo:lhs>
        <tvbo:rhs>M_i*(a_i*I_i - b_i)</tvbo:rhs>
        <terms:description>Gain-scaled input current to the inhibitory population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>x_i (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>x_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/G -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/G">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Global coupling scaling</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>G (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Global coupling scaling</skos:definition>
        <skos:notation>G</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/I_ext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/I_ext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <terms:description>External stimulation parameter for evoked potential simulated activity applied to the excitatory population firing rate IE (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>I_ext (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>External stimulation parameter for evoked potential simulated activity applied to the excitatory population firing rate IE (Deco et al., 2014).</skos:definition>
        <skos:notation>I_ext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/I_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/I_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <terms:description>Effective external input parameter to the excitatory E and inhibitory I population (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.382</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>I_o (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Effective external input parameter to the excitatory E and inhibitory I population (Deco et al., 2014).</skos:definition>
        <skos:notation>I_o</skos:notation>
        <tvbo:unit>nA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/J_N -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/J_N">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <terms:description>Excitatory synaptic coupling parameter (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.15</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>J_N (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Excitatory synaptic coupling parameter (Deco et al., 2014).</skos:definition>
        <skos:notation>J_N</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/J_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/J_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <terms:description>Local feedback inhibitory synaptic coupling to the excitatory population firing rate IE (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
