        <rdfs:label>I_ext (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>External stimulation parameter for evoked potential simulated activity applied to the excitatory population firing rate IE (Deco et al., 2014).</skos:definition>
        <skos:notation>I_ext</skos:notation>
    </owl:NamedIndividual>
    


