        <rdfs:label>Study</rdfs:label>
        <skos:definition>Bibliographic anchor for a source publication, identified by its citation key (``citekey``).  The full bibliographic record lives in the project BibTeX library (references.bib) and is resolved by citekey; this node carries only identity, display fields and the knowledge-graph hooks (the concepts that cite it).  Specialised by SimulationStudy, which adds the experiments derived from the source.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/Study"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


