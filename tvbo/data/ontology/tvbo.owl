        <skos:notation>dstar</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
