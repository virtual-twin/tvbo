        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>clamp (DomainEnforcement)</rdfs:label>
        <skos:definition>Hard-clip every integration step to [lo, hi].</skos:definition>
        <skos:notation>clamp</skos:notation>
    </owl:Class>
    


