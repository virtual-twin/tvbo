        <skos:definition>Total number of vertices</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_vertices</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/n_workers -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n_workers">
        <rdfs:label>n_workers (slot)</rdfs:label>
        <skos:definition>Number of parallel workers (maps to pmap devices in JAX, processes in multiprocessing)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_workers</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/name -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/name"/>
    


