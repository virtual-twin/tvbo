    <!-- https://w3id.org/tvbo/tvboptim -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/tvboptim">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Backend"/>
        <tvbo:providesCapability rdf:resource="https://w3id.org/tvbo/Autodiff"/>
        <tvbo:providesCapability rdf:resource="https://w3id.org/tvbo/CodeGeneration"/>
        <tvbo:providesCapability rdf:resource="https://w3id.org/tvbo/DelayHistoryBuffer"/>
        <tvbo:providesCapability rdf:resource="https://w3id.org/tvbo/InterpolatedDelays"/>
        <tvbo:providesCapability rdf:resource="https://w3id.org/tvbo/JITCompilation"/>
        <tvbo:providesCapability rdf:resource="https://w3id.org/tvbo/StaticDelayBuffer"/>
        <tvbo:providesCapability rdf:resource="https://w3id.org/tvbo/StochasticSolver"/>
        <tvbo:supportsTask rdf:resource="https://w3id.org/tvbo/ConductionSpeedInference"/>
        <tvbo:supportsTask rdf:resource="https://w3id.org/tvbo/DDEIntegration"/>
        <tvbo:supportsTask rdf:resource="https://w3id.org/tvbo/GradientBasedOptimization"/>
        <tvbo:supportsTask rdf:resource="https://w3id.org/tvbo/ODEIntegration"/>
        <tvbo:supportsTask rdf:resource="https://w3id.org/tvbo/ParameterExploration"/>
        <tvbo:supportsTask rdf:resource="https://w3id.org/tvbo/SDDEIntegration"/>
        <tvbo:supportsTask rdf:resource="https://w3id.org/tvbo/SDEIntegration"/>
        <rdfs:label xml:lang="en">tvboptim</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/derived_variables/r_E -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/derived_variables/r_E">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>r_E</tvbo:lhs>
        <tvbo:rhs>r_max/(1 + exp(-k_phi*(mu_se - mu_th)))</tvbo:rhs>
        <terms:description>Excitatory population firing rate. In full aLN this is ``Phi(mu_E_eff, s_EE)`` with ``Phi`` precomputed; here a sigmoid stand-in is used.</terms:description>
        <rdfs:label>r_E (CakanObermayer derived variable)</rdfs:label>
        <skos:notation>r_E</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/derived_variables/r_I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/derived_variables/r_I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>r_I</tvbo:lhs>
        <tvbo:rhs>r_max/(1 + exp(-k_phi*(mu_si - mu_th)))</tvbo:rhs>
        <terms:description>Inhibitory population firing rate (sigmoid stand-in for aLN Phi).</terms:description>
        <rdfs:label>r_I (CakanObermayer derived variable)</rdfs:label>
        <skos:notation>r_I</skos:notation>
    </owl:NamedIndividual>
    


