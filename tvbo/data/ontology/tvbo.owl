        <terms:description>Speed of the ultra-slow transition of the final point.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.2E-4</schema:defaultValue>
        <rdfs:label>cB (EpileptorCodim3SlowMod parameter)</rdfs:label>
