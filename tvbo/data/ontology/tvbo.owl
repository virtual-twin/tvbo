        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>wrap (DomainEnforcement)</rdfs:label>
        <skos:definition>Periodic wrap into [lo, hi) — e.g. a phase variable on [0, 2π). The recorded timeseries stays within the range while remaining continuous mod (hi - lo).&quot;</skos:definition>
        <skos:notation>wrap</skos:notation>
    </owl:Class>
    


