        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>FunctionCall</rdfs:label>
        <skos:definition>Invocation of a function in a pipeline. Can reference a defined Function by name, OR inline a callable directly for external library functions, OR inline an equation, OR use class_call for class instantiation. Mirrors Function attributes so pipeline steps can be self-contained. The `name` is an optional step label (used in pipelines for keyed access to step outputs); it is NOT a global identifier (singleton uses like `loss`, `observable` may omit it).</skos:definition>
        <skos:exactMatch rdf:resource="http://www.w3.org/ns/prov#Plan"/>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/FunctionCall"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/GeneralizedHopf -->

    <owl:Class rdf:about="https://w3id.org/tvbo/GeneralizedHopf">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Bifurcation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasCodimension"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Codimension2"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Codim-2 point where a Hopf bifurcation switches between sub- and supercritical (first Lyapunov coefficient vanishes); a fold-of-limit-cycles curve emanates.</rdfs:comment>
        <rdfs:label xml:lang="en">Generalized Hopf (Bautin)</rdfs:label>
        <skos:altLabel>GH</skos:altLabel>
        <skos:altLabel>bautin</skos:altLabel>
        <skos:altLabel>generalised hopf</skos:altLabel>
        <skos:altLabel>generalized hopf</skos:altLabel>
        <skos:altLabel>gh</skos:altLabel>
        <tvbo:canonicalCode>GH</tvbo:canonicalCode>
    </owl:Class>
    


