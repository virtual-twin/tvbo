    <!-- https://w3id.org/tvbo/CouplingStageEvaluation -->

    <owl:Class rdf:about="https://w3id.org/tvbo/CouplingStageEvaluation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/CouplingStageEvaluation#per_stage"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/CouplingStageEvaluation#per_step"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>CouplingStageEvaluation</rdfs:label>
        <skos:definition>How the network coupling term is evaluated within one step of a multi-stage integrator (Heun, RK4, ...). A backend-neutral numerical contract: whether the coupling is part of the vector field, re-evaluated at each solver stage, or computed once per step and held constant across the stages. Matters because the two choices integrate a different effective system — for stiff / chaotic / multistable dynamics they can converge to different trajectories or attractors.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/CouplingStageEvaluation#per_stage"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/CouplingStageEvaluation#per_step"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Cusp -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Cusp">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Bifurcation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasCodimension"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Codimension2"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Codim-2 organising centre where two fold curves meet tangentially.</rdfs:comment>
        <rdfs:label xml:lang="en">Cusp</rdfs:label>
        <skos:altLabel>CP</skos:altLabel>
        <skos:altLabel>cp</skos:altLabel>
        <skos:altLabel>cusp</skos:altLabel>
        <tvbo:canonicalCode>CP</tvbo:canonicalCode>
    </owl:Class>
    


