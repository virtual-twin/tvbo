        <terms:description>Speed of the slow variable.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.002</schema:defaultValue>
        <rdfs:label>c (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


