    <!-- https://w3id.org/tvbo/freeze_parameters -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/freeze_parameters">
        <rdfs:label>freeze_parameters (slot)</rdfs:label>
        <skos:definition>Parameters from previous stages to freeze (keep at optimized value but not update)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>freeze_parameters</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/function -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/function"/>
    


    <!-- https://w3id.org/tvbo/functions -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/functions"/>
    


    <!-- https://w3id.org/tvbo/graph_generator -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/graph_generator">
        <rdfs:label>graph_generator (slot)</rdfs:label>
        <skos:definition>Graph generator specification.  When set, overrides explicit edges/nodes for graph construction.  The type field is a free string; StandardGraphType lists well-known types that get automatic code generation across backends.
</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>graph_generator</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/graph_representation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/graph_representation">
        <rdfs:label>graph_representation (slot)</rdfs:label>
        <skos:definition>Representation used to evaluate coupling over this network&apos;s connectivity (``auto`` | ``dense`` | ``sparse``). ``auto`` lets the backend choose by connection density. This names whether to exploit edge sparsity, not a concrete data structure, so it is backend-independent; the delayed-vs-instantaneous graph kind is decided separately from the couplings&apos; conduction delays.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>graph_representation</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/hasAttractor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/hasAttractor">
        <rdfs:label xml:lang="en">has attractor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/hasBranchGeometry -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/hasBranchGeometry">
        <rdfs:range rdf:resource="https://w3id.org/tvbo/BranchGeometry"/>
        <rdfs:label xml:lang="en">has branch geometry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/hasCodimension -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/hasCodimension">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="https://w3id.org/tvbo/Codimension"/>
        <rdfs:label xml:lang="en">has codimension</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/hasEigenvalueSignature -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/hasEigenvalueSignature">
        <rdfs:range rdf:resource="https://w3id.org/tvbo/EigenvalueSignature"/>
        <rdfs:label xml:lang="en">has eigenvalue signature</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/hasModelFeature -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/hasModelFeature">
        <rdfs:range rdf:resource="https://w3id.org/tvbo/ModelFeature"/>
        <rdfs:label xml:lang="en">has model feature</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/hasStochasticityCharacter -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/hasStochasticityCharacter">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment xml:lang="en">Intrinsic stochasticity of the model definition itself. A model whose equations are deterministic but is integrated with additive noise via the Integrator is still tvbo:Deterministic here.</rdfs:comment>
        <rdfs:label xml:lang="en">has stochasticity character</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/hi -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/hi">
        <rdfs:label>hi (slot)</rdfs:label>
        <skos:definition>Upper bound or stopping value. Can be a number or argument name.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>hi</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/histogram -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/histogram">
        <rdfs:label>histogram (slot)</rdfs:label>
        <skos:definition>Bin spec (`lo`, `hi`, `n`) for a streaming order-statistic aggregation (`aggregation: median`). Should span the expected value range of the reduced per-step quantity; the quantile is linearly interpolated within the crossing bin. Only used by the streaming-median reduction path.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>histogram</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/history -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/history">
        <rdfs:label>history (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>history</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/hyperparameters -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/hyperparameters"/>
    


    <!-- https://w3id.org/tvbo/imaging_modality -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/imaging_modality">
        <rdfs:label>imaging_modality (slot)</rdfs:label>
        <skos:definition>Type of imaging modality (BOLD, EEG, MEG, etc.)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>imaging_modality</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/includes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/includes">
        <rdfs:label>includes (slot)</rdfs:label>
        <skos:definition>Include update rules from other algorithms with optional argument overrides. Unlike depends_on (sequential), includes means combined execution. Example: includes: [{algorithm: fic, arguments: [{name: eta, value: 0.1}]}]</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>includes</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/incoming_states -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/incoming_states">
        <rdfs:label>incoming_states (slot)</rdfs:label>
        <skos:definition>References to state variables from connected (source) nodes. Auto-populated from state_variables with coupling_variable=true when omitted. Used by name in pre_expression.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>incoming_states</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/inferences -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/inferences">
        <rdfs:label>inferences (slot)</rdfs:label>
        <skos:altLabel>inference</skos:altLabel>
        <skos:definition>Bayesian inference configurations (posterior over parameters given an observation, via MCMC). Keyed by name, like optimizations.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>inferences</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/initial_expression -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/initial_expression">
        <rdfs:label>initial_expression (slot)</rdfs:label>
        <skos:definition>Analytic initial condition for the field.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>initial_expression</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/initial_state -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/initial_state"/>
    


