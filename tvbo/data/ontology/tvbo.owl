    <!-- https://w3id.org/tvbo/FixedPoint -->

    <owl:Class rdf:about="https://w3id.org/tvbo/FixedPoint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Attractor"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Fold -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Fold">
        <owl:equivalentClass rdf:resource="https://w3id.org/tvbo/SaddleNode"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/Bifurcation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasBranchGeometry"/>
                        <owl:hasValue rdf:resource="https://w3id.org/tvbo/LimitPointGeometry"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasCodimension"/>
                        <owl:hasValue rdf:resource="https://w3id.org/tvbo/Codimension1"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasEigenvalueSignature"/>
                        <owl:hasValue rdf:resource="https://w3id.org/tvbo/RealEigenvalueZero"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Bifurcation"/>
        <rdfs:comment xml:lang="en">Saddle-node (limit / turning point): a pair of equilibria collide and annihilate as one real eigenvalue crosses zero and the branch folds back on the parameter.</rdfs:comment>
        <rdfs:label xml:lang="en">Fold</rdfs:label>
        <skos:altLabel>LP</skos:altLabel>
        <skos:altLabel>fold</skos:altLabel>
        <skos:altLabel>limit point</skos:altLabel>
        <skos:altLabel>limitpoint</skos:altLabel>
        <skos:altLabel>lp</skos:altLabel>
        <skos:altLabel>saddle-node</skos:altLabel>
        <skos:altLabel>saddlenode</skos:altLabel>
        <skos:altLabel>sn</skos:altLabel>
        <skos:prefLabel xml:lang="en">Fold</skos:prefLabel>
        <tvbo:canonicalCode>LP</tvbo:canonicalCode>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/FoldOfLimitCycles -->

    <owl:Class rdf:about="https://w3id.org/tvbo/FoldOfLimitCycles">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Bifurcation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasCodimension"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Codimension1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Saddle-node of periodic orbits: two limit cycles collide and annihilate as a Floquet multiplier crosses +1.</rdfs:comment>
        <rdfs:label xml:lang="en">Fold of limit cycles</rdfs:label>
        <skos:altLabel>LPC</skos:altLabel>
        <skos:altLabel>cpc</skos:altLabel>
        <skos:altLabel>fold of limit cycles</skos:altLabel>
        <skos:altLabel>fold-of-limit-cycles</skos:altLabel>
        <skos:altLabel>lpc</skos:altLabel>
        <skos:altLabel>snpo</skos:altLabel>
        <tvbo:canonicalCode>LPC</tvbo:canonicalCode>
    </owl:Class>
    


