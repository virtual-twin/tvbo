        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>StandardGraphType</rdfs:label>
        <skos:definition>Well-known graph generator families with automatic backend mapping. The type field on GraphGenerator is a free string; this enum lists common types that get automatic code generation for Julia (Graphs.jl) and Python (NetworkX).
</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/StandardGraphType#BarabasiAlbert"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/StandardGraphType#Complete"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/StandardGraphType#Cycle"/>
