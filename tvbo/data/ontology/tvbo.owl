    <!-- https://w3id.org/tvbo/ProcedureStepType#distribution_pdf -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ProcedureStepType#distribution_pdf">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ProcedureStepType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>distribution_pdf (ProcedureStepType)</rdfs:label>
        <skos:definition>Evaluate `distribution`&apos;s density at the positions named by `of` — a spatial field (e.g. a Gaussian sink/source whose difference forms an in-strength gradient).</skos:definition>
        <skos:notation>distribution_pdf</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ProcedureStepType#equation -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ProcedureStepType#equation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ProcedureStepType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>equation (ProcedureStepType)</rdfs:label>
        <skos:definition>Evaluate `equation.rhs` over previously-named intermediates and the generator&apos;s parameters. The default.</skos:definition>
        <skos:notation>equation</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ProcedureStepType#minmax_rescale -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ProcedureStepType#minmax_rescale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ProcedureStepType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>minmax_rescale (ProcedureStepType)</rdfs:label>
        <skos:definition>Affinely rescale the intermediate named by `of` from its own min/max onto `target_range`.</skos:definition>
        <skos:notation>minmax_rescale</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ProcedureStepType#normalize -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ProcedureStepType#normalize">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ProcedureStepType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>normalize (ProcedureStepType)</rdfs:label>
        <skos:definition>Divide the intermediate named by `of` by its sum along `axis` (axis 0 gives uniform in-strength).</skos:definition>
        <skos:notation>normalize</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ProcedureStepType#pairwise_distance -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ProcedureStepType#pairwise_distance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ProcedureStepType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>pairwise_distance (ProcedureStepType)</rdfs:label>
        <skos:definition>Distance matrix between the rows of the positions named by `of` (euclidean). `diagonal` optionally overwrites the self-distance, e.g. to infinity so a decaying distance kernel evaluates to zero there and no node connects to itself.</skos:definition>
        <skos:notation>pairwise_distance</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ProcedureStepType#sample -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ProcedureStepType#sample">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ProcedureStepType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>sample (ProcedureStepType)</rdfs:label>
        <skos:definition>A random matrix drawn from `distribution` — the draw itself, e.g. the substrate of a random reservoir. Distinct from `stochastic_mask`, which compares a draw and yields a boolean.</skos:definition>
        <skos:notation>sample</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ProcedureStepType#stochastic_mask -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ProcedureStepType#stochastic_mask">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ProcedureStepType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>stochastic_mask (ProcedureStepType)</rdfs:label>
        <skos:definition>Boolean connection mask: compare the quantity named by `of` against a draw from `distribution` using `comparison`. The declarative form of a distance-dependent connection probability.</skos:definition>
        <skos:notation>stochastic_mask</skos:notation>
    </owl:Class>
    


