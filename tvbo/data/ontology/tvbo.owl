    </owl:Class>
    


    <!-- https://w3id.org/tvbo/InitialStateMethod#from_branch -->

    <owl:Class rdf:about="https://w3id.org/tvbo/InitialStateMethod#from_branch">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/InitialStateMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>from_branch (InitialStateMethod)</rdfs:label>
        <skos:definition>Start from a point on a previously computed branch.</skos:definition>
        <skos:notation>from_branch</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/InitialStateMethod#from_experiment -->

    <owl:Class rdf:about="https://w3id.org/tvbo/InitialStateMethod#from_experiment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/InitialStateMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>from_experiment (InitialStateMethod)</rdfs:label>
        <skos:definition>Seed from the settled endpoint state of another already-run experiment in the study (referenced by InitialState.source_experiment). Reuses a working point that experiment already reached instead of recomputing it — the cross-experiment counterpart of from_working_point (which recomputes the ramp inline). source_point selects which settled point of the source run (default &apos;endpoint&apos;).</skos:definition>
        <skos:notation>from_experiment</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/InitialStateMethod#from_working_point -->

    <owl:Class rdf:about="https://w3id.org/tvbo/InitialStateMethod#from_working_point">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/InitialStateMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>from_working_point (InitialStateMethod)</rdfs:label>
        <skos:definition>Ramp a parameter quasi-statically (warm-start / from_previous) to a target value (see InitialState.ramp) and start from the endpoint state — reach a working point on the solution branch before the run.</skos:definition>
        <skos:notation>from_working_point</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/InitialStateMethod#given -->

    <owl:Class rdf:about="https://w3id.org/tvbo/InitialStateMethod#given">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/InitialStateMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>given (InitialStateMethod)</rdfs:label>
        <skos:definition>Use the model&apos;s default initial values directly.</skos:definition>
        <skos:notation>given</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/InitialStateMethod#newton -->

    <owl:Class rdf:about="https://w3id.org/tvbo/InitialStateMethod#newton">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/InitialStateMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>newton (InitialStateMethod)</rdfs:label>
        <skos:definition>Use Newton&apos;s method to find the nearest fixed point.</skos:definition>
        <skos:notation>newton</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/InitialStateMethod#time_integration -->

    <owl:Class rdf:about="https://w3id.org/tvbo/InitialStateMethod#time_integration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/InitialStateMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>time_integration (InitialStateMethod)</rdfs:label>
        <skos:definition>Integrate the ODE forward until convergence (robust, default).</skos:definition>
        <skos:notation>time_integration</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/MarkType#band -->

    <owl:Class rdf:about="https://w3id.org/tvbo/MarkType#band">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/MarkType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>band (MarkType)</rdfs:label>
        <skos:definition>Filled band between two series (error/CI).</skos:definition>
        <skos:notation>band</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/MarkType#line -->

    <owl:Class rdf:about="https://w3id.org/tvbo/MarkType#line">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/MarkType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>line (MarkType)</rdfs:label>
        <skos:definition>Connected line (timeseries, bifurcation branch, trajectory).</skos:definition>
        <skos:notation>line</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/MarkType#rule -->

    <owl:Class rdf:about="https://w3id.org/tvbo/MarkType#rule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/MarkType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>rule (MarkType)</rdfs:label>
        <skos:definition>Reference line / span (threshold, stimulus window, vline).</skos:definition>
        <skos:notation>rule</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/MarkType#scatter -->

    <owl:Class rdf:about="https://w3id.org/tvbo/MarkType#scatter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/MarkType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>scatter (MarkType)</rdfs:label>
        <skos:definition>Points (fixed points, special points, per-node profiles).</skos:definition>
        <skos:notation>scatter</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ModelParadigm#dynamic_mean_field -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ModelParadigm#dynamic_mean_field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ModelParadigm"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>dynamic_mean_field (ModelParadigm)</rdfs:label>
        <skos:definition>Dynamic mean-field approximation (e.g., Deco et al.).</skos:definition>
        <skos:notation>dynamic_mean_field</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ModelParadigm#generic -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ModelParadigm#generic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ModelParadigm"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>generic (ModelParadigm)</rdfs:label>
        <skos:definition>General-purpose, not specific to neuroscience.</skos:definition>
        <skos:notation>generic</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ModelParadigm#model_description -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ModelParadigm#model_description">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ModelParadigm"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>model_description (ModelParadigm)</rdfs:label>
        <skos:definition>Declarative model specification language.</skos:definition>
        <skos:notation>model_description</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ModelType#field -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ModelType#field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ModelType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>field (ModelType)</rdfs:label>
        <skos:definition>Spatially distributed neural-field models described by integro- differential or PDE formulations.</skos:definition>
        <skos:notation>field</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ModelType#generic -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ModelType#generic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ModelType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>generic (ModelType)</rdfs:label>
        <skos:definition>Generic / normal-form dynamical systems not specific to neural modelling (e.g. Generic2dOscillator, GenericLinear).</skos:definition>
        <skos:notation>generic</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ModelType#mean_field -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ModelType#mean_field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ModelType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>mean_field (ModelType)</rdfs:label>
        <skos:definition>Mathematically derived mean-field models obtained by exact reduction of spiking networks (Ott-Antonsen ansatz, Lorentzian heterogeneity, etc.). Examples: MontbrioPazoRoxin, CoombesByrne, ReducedWongWang, ZerlautAdaptationFirstOrder.</skos:definition>
        <skos:notation>mean_field</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ModelType#neural_mass -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ModelType#neural_mass">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ModelType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>neural_mass (ModelType)</rdfs:label>
        <skos:definition>Phenomenological population-rate / neural-mass models that describe synaptic and firing-rate dynamics without an explicit derivation from single-neuron statistics. Examples: JansenRit, WilsonCowan, LarterBreakspear, TsodyksMarkram.</skos:definition>
        <skos:notation>neural_mass</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ModelType#phase_oscillator -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ModelType#phase_oscillator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ModelType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>phase_oscillator (ModelType)</rdfs:label>
        <skos:definition>Phase-reduced or Kuramoto-type oscillator models. Examples: Kuramoto, SupHopf.</skos:definition>
        <skos:notation>phase_oscillator</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ModelType#phenomenological -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ModelType#phenomenological">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ModelType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>phenomenological (ModelType)</rdfs:label>
        <skos:definition>Empirical / phenomenological models that capture macroscopic dynamics without direct biophysical derivation. Examples: Epileptor2D, Epileptor5D.</skos:definition>
        <skos:notation>phenomenological</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ModelType#spiking -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ModelType#spiking">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ModelType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>spiking (ModelType)</rdfs:label>
        <skos:definition>Single-neuron or conductance-based spiking models (HH, AdEx, LIF, Izhikevich, etc.). These can be used as nodes in a network alongside mean-field models.</skos:definition>
        <skos:notation>spiking</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/NodeReconciliation#by_label -->

    <owl:Class rdf:about="https://w3id.org/tvbo/NodeReconciliation#by_label">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NodeReconciliation"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>by_label (NodeReconciliation)</rdfs:label>
        <skos:definition>Restrict to the shared node labels by name (keyed ``.sel``), preserving the consuming network&apos;s order, on every node axis (a vector on its node axis, a matrix on both). Never positional.</skos:definition>
        <skos:notation>by_label</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/NodeReconciliation#none -->

    <owl:Class rdf:about="https://w3id.org/tvbo/NodeReconciliation#none">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NodeReconciliation"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>none (NodeReconciliation)</rdfs:label>
        <skos:definition>No reconciliation; the node sets are assumed identical.</skos:definition>
        <skos:notation>none</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/NoiseType#brown -->

    <owl:Class rdf:about="https://w3id.org/tvbo/NoiseType#brown">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NoiseType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>brown (NoiseType)</rdfs:label>
        <skos:notation>brown</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/NoiseType#gaussian -->

    <owl:Class rdf:about="https://w3id.org/tvbo/NoiseType#gaussian">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NoiseType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>gaussian (NoiseType)</rdfs:label>
        <skos:notation>gaussian</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/NoiseType#pink -->

    <owl:Class rdf:about="https://w3id.org/tvbo/NoiseType#pink">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NoiseType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>pink (NoiseType)</rdfs:label>
        <skos:notation>pink</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/NoiseType#white -->

    <owl:Class rdf:about="https://w3id.org/tvbo/NoiseType#white">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NoiseType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>white (NoiseType)</rdfs:label>
        <skos:notation>white</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/NumericalDiscretizationMethod#collocation -->

    <owl:Class rdf:about="https://w3id.org/tvbo/NumericalDiscretizationMethod#collocation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NumericalDiscretizationMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>collocation (NumericalDiscretizationMethod)</rdfs:label>
        <skos:definition>Orthogonal collocation at Gauss points.</skos:definition>
        <skos:notation>collocation</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/NumericalDiscretizationMethod#poincare -->

    <owl:Class rdf:about="https://w3id.org/tvbo/NumericalDiscretizationMethod#poincare">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NumericalDiscretizationMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>poincare (NumericalDiscretizationMethod)</rdfs:label>
        <skos:definition>Poincaré shooting.</skos:definition>
        <skos:notation>poincare</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/NumericalDiscretizationMethod#shooting -->

    <owl:Class rdf:about="https://w3id.org/tvbo/NumericalDiscretizationMethod#shooting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NumericalDiscretizationMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>shooting (NumericalDiscretizationMethod)</rdfs:label>
        <skos:definition>Standard multiple shooting.</skos:definition>
        <skos:notation>shooting</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/NumericalDiscretizationMethod#trapezoid -->

    <owl:Class rdf:about="https://w3id.org/tvbo/NumericalDiscretizationMethod#trapezoid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NumericalDiscretizationMethod"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>trapezoid (NumericalDiscretizationMethod)</rdfs:label>
        <skos:definition>Trapezoidal rule discretization.</skos:definition>
        <skos:notation>trapezoid</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ObservationReductionMode#streaming -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ObservationReductionMode#streaming">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ObservationReductionMode"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>streaming (ObservationReductionMode)</rdfs:label>
        <skos:definition>Fold this observation into the integrator carry as an (init, update, finalize) reducer; never materialise the trajectory. Supported for the HRF-Volterra BOLD pipeline (hemodynamic convolution), whose kernel / downsample stride / TR stride / Volterra scaling the resolver lifts from the declared pipeline.</skos:definition>
        <skos:notation>streaming</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/OperatorType#curl -->

    <owl:Class rdf:about="https://w3id.org/tvbo/OperatorType#curl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/OperatorType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>curl (OperatorType)</rdfs:label>
        <skos:notation>curl</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/OperatorType#divergence -->

    <owl:Class rdf:about="https://w3id.org/tvbo/OperatorType#divergence">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/OperatorType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>divergence (OperatorType)</rdfs:label>
        <skos:notation>divergence</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/OperatorType#gradient -->

    <owl:Class rdf:about="https://w3id.org/tvbo/OperatorType#gradient">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/OperatorType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>gradient (OperatorType)</rdfs:label>
        <skos:notation>gradient</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/OperatorType#laplacian -->

    <owl:Class rdf:about="https://w3id.org/tvbo/OperatorType#laplacian">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/OperatorType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>laplacian (OperatorType)</rdfs:label>
        <skos:notation>laplacian</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PanelKind#cartesian -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PanelKind#cartesian">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/PanelKind"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>cartesian (PanelKind)</rdfs:label>
        <skos:definition>Line/scatter/rule/band marks in a 2-D cartesian frame.</skos:definition>
        <skos:notation>cartesian</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PanelKind#custom -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PanelKind#custom">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/PanelKind"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>custom (PanelKind)</rdfs:label>
        <skos:definition>A registered callable fn(container, ax, **opts).</skos:definition>
        <skos:notation>custom</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PanelKind#heatmap -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PanelKind#heatmap">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/PanelKind"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>heatmap (PanelKind)</rdfs:label>
        <skos:definition>A 2-D array field drawn as pcolormesh/imshow.</skos:definition>
        <skos:notation>heatmap</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PanelKind#image -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PanelKind#image">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/PanelKind"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>image (PanelKind)</rdfs:label>
        <skos:definition>An external raster/vector file placed in the grid cell.</skos:definition>
        <skos:notation>image</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PanelKind#line3d -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PanelKind#line3d">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/PanelKind"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>line3d (PanelKind)</rdfs:label>
        <skos:definition>Line/scatter marks in a 3-D frame (x/y/z channels) — a phase-space orbit or trajectory. Camera via opts (elev, azim); axis via zlabel/zlim.</skos:definition>
        <skos:notation>line3d</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ParallelMode#auto -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ParallelMode#auto">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ParallelMode"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>auto (ParallelMode)</rdfs:label>
        <skos:definition>Pick vmap when memory permits, lax_map otherwise.</skos:definition>
        <skos:notation>auto</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ParallelMode#lax_map -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ParallelMode#lax_map">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ParallelMode"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>lax_map (ParallelMode)</rdfs:label>
        <skos:definition>Sequential execution via jax.lax.map. Slower; bounded memory.</skos:definition>
        <skos:notation>lax_map</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ParallelMode#pmap -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ParallelMode#pmap">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ParallelMode"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>pmap (ParallelMode)</rdfs:label>
        <skos:definition>Parallel execution across the local devices of a single node (jax.pmap over the several GPUs/TPUs visible to that task). Intra-task only — it never spans nodes; inter-node parallelism is scheduler fan-out (DistributionConfig.chunk), not pmap. On a one-GPU (or CPU) task this degenerates to vmap.</skos:definition>
        <skos:notation>pmap</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ParallelMode#vmap -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ParallelMode#vmap">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ParallelMode"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>vmap (ParallelMode)</rdfs:label>
        <skos:definition>Parallel batched execution (jax.vmap). Fast; high peak memory.</skos:definition>
        <skos:notation>vmap</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PhysicalDimension#capacitance -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PhysicalDimension#capacitance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/PhysicalDimension"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>capacitance (PhysicalDimension)</rdfs:label>
        <skos:definition>Capacitance [M⁻¹ L⁻² T⁴ I²]</skos:definition>
        <skos:notation>capacitance</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PhysicalDimension#charge -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PhysicalDimension#charge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/PhysicalDimension"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>charge (PhysicalDimension)</rdfs:label>
        <skos:definition>Electric charge [T I]</skos:definition>
        <skos:notation>charge</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PhysicalDimension#concentration -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PhysicalDimension#concentration">
