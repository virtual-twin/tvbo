    <!-- https://w3id.org/tvbo/LyapunovAnalysis -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LyapunovAnalysis">
        <rdf:type rdf:resource="https://w3id.org/tvbo/AnalysisObservable"/>
        <rdfs:comment xml:lang="en">Benettin QR estimate of the tangent-dynamics Lyapunov spectrum: the leading exponents lambda_i (rate of trajectory divergence, chaos when lambda_1 &gt; 0) and, for the leading direction, the per-node Lyapunov vector xi_i (which nodes drive the instability). Parameters: n_exponents, n_steps (rescaling segments), segment_time, mode (tangent-space jvp / two-trajectory sim). Independent per operating point, so it fans out across a parameter axis.</rdfs:comment>
        <rdfs:label xml:lang="en">Lyapunov analysis</rdfs:label>
        <tvbo:realisedByBackend>tvboptim</tvbo:realisedByBackend>
    </owl:NamedIndividual>
    


