    <!-- https://w3id.org/tvbo/SparseCoupling -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/SparseCoupling">
        <rdf:type rdf:resource="https://w3id.org/tvbo/BackendCapability"/>
        <rdfs:comment xml:lang="en">Evaluate network coupling by summing over the existing edges only (cost scales with the number of edges) rather than over the full dense adjacency (cost scales with nodes-squared). Numerically identical to the dense evaluation; a pure performance optimisation for sparsely-connected networks.</rdfs:comment>
        <rdfs:label xml:lang="en">Sparse (edge-list) coupling evaluation</rdfs:label>
        <tvbo:boundConstraint>edges &lt;&lt; nodes^2  (connection density below the backend&apos;s sparse/dense crossover)</tvbo:boundConstraint>
        <tvbo:enabledByGraphParameter>graph_representation</tvbo:enabledByGraphParameter>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/SpikingSimulation -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/SpikingSimulation">
        <rdf:type rdf:resource="https://w3id.org/tvbo/BackendCapability"/>
        <rdfs:comment xml:lang="en">Integration of point-neuron populations with threshold-reset spiking and event-delivered synapses.</rdfs:comment>
        <rdfs:label xml:lang="en">Spiking (point-neuron) simulation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StaticDelayBuffer -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StaticDelayBuffer">
        <rdf:type rdf:resource="https://w3id.org/tvbo/BackendCapability"/>
        <rdfs:comment xml:lang="en">Fixed-length delay-history buffer (ceil(max_delay/dt) steps) whose size is set by an explicit max_delay bound and decoupled from the (possibly varying / traced) per-edge delays — the prerequisite for varying or differentiating delays under JIT. Delays exceeding max_delay are truncated (saturated at max_delay), so the bound must cover the slowest conduction speed explored.</rdfs:comment>
        <rdfs:label xml:lang="en">Static delay history buffer</rdfs:label>
        <tvbo:boundConstraint>max_delay &gt;= max(tract_length) / min(conduction_speed)</tvbo:boundConstraint>
        <tvbo:enabledByGraphParameter>max_delay</tvbo:enabledByGraphParameter>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Dynamics"/>
        <tvbo:exhibitsRegime rdf:resource="https://w3id.org/tvbo/Bistable"/>
        <tvbo:exhibitsRegime rdf:resource="https://w3id.org/tvbo/Bursting"/>
        <tvbo:exhibitsRegime rdf:resource="https://w3id.org/tvbo/Oscillatory"/>
        <tvbo:hasAttractor rdf:resource="https://w3id.org/tvbo/FixedPoint"/>
        <tvbo:hasAttractor rdf:resource="https://w3id.org/tvbo/LimitCycle"/>
        <tvbo:hasStochasticityCharacter rdf:resource="https://w3id.org/tvbo/Deterministic"/>
        <tvbo:modelsAnatomicalRegion rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000956"/>
        <tvbo:hasTimescaleSeparation rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</tvbo:hasTimescaleSeparation>
        <tvbo:phaseSpaceDimension rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</tvbo:phaseSpaceDimension>
        <terms:description>Reduced set of FitzHugh-Nagumo oscillators (Stefanescu &amp; Jirsa 2008). A low-dimensional description of globally coupled heterogeneous excitatory and inhibitory FitzHugh-Nagumo populations. The reduction projects an infinite population onto `number_of_modes` modes and yields per-mode scalar state variables (xi, eta) for the excitatory and (alpha, beta) for the inhibitory subnetwork. The mode-coupling matrices Aik, Bik, Cik and the per-mode inputs IE_i, II_i, m_i, n_i, e_i, f_i are derived offline by Gaussian quadrature over the heterogeneity distribution N(mu, sigma^2); see TVB reference implementation `tvb.simulator.models.stefanescu_jirsa.ReducedSetFitzHughNagumo`.</terms:description>
        <rdfs:label>StefanescuJirsa2D</rdfs:label>
        <skos:prefLabel xml:lang="en">Stefanescu-Jirsa 2D</skos:prefLabel>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Aik"/>
