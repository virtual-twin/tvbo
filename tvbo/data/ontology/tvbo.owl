    <!-- https://w3id.org/tvbo/Reference -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Reference">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
