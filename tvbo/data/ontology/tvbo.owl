    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iU4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iU4">
