    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/observable">
        <rdfs:label>observable (slot)</rdfs:label>
        <skos:definition>Observable to compute at each point. Use function: obs_name for simple observation, or function: func_name + arguments for FunctionCall.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>observable</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/observations -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/observations"/>
    


    <!-- https://w3id.org/tvbo/observed -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/observed"/>
    


    <!-- https://w3id.org/tvbo/ode_solver -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/ode_solver">
        <rdfs:label>ode_solver (slot)</rdfs:label>
        <skos:definition>ODE solver for flow-based methods (shooting, poincaré). Specifies algorithm (e.g. Vern9, Rodas5) and tolerances. Not needed for collocation or trapezoid.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>ode_solver</skos:notation>
