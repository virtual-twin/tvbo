        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>workflow_framework (ToolRole)</rdfs:label>
        <skos:definition>Orchestration, model-building, or pipeline tool.</skos:definition>
        <skos:notation>workflow_framework</skos:notation>
    </owl:Class>
    


