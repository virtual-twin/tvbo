        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/values"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/values"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>BrainRegionSeries</rdfs:label>
        <skos:definition>A series whose values represent latitude</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/BrainRegionSeries"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/BranchGeometry -->

    <owl:Class rdf:about="https://w3id.org/tvbo/BranchGeometry">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Local geometry of the solution branch at the special point in the (state, parameter) space.</rdfs:comment>
        <rdfs:label xml:lang="en">Branch geometry</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/BranchPoint -->

    <owl:Class rdf:about="https://w3id.org/tvbo/BranchPoint">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/Bifurcation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasBranchGeometry"/>
                        <owl:hasValue rdf:resource="https://w3id.org/tvbo/BranchCrossingGeometry"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasCodimension"/>
                        <owl:hasValue rdf:resource="https://w3id.org/tvbo/Codimension1"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasEigenvalueSignature"/>
                        <owl:hasValue rdf:resource="https://w3id.org/tvbo/RealEigenvalueZero"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Bifurcation"/>
        <rdfs:comment xml:lang="en">Branch point: two solution branches intersect transversally as a real eigenvalue crosses zero (e.g. transcritical, pitchfork). Distinct from a Fold, which turns back on the parameter.</rdfs:comment>
        <rdfs:label xml:lang="en">Branch point</rdfs:label>
        <skos:altLabel>BP</skos:altLabel>
        <skos:altLabel>bp</skos:altLabel>
        <skos:altLabel>branch point</skos:altLabel>
        <skos:altLabel>branch-point</skos:altLabel>
        <skos:altLabel>branchpoint</skos:altLabel>
        <skos:prefLabel xml:lang="en">Branch point</skos:prefLabel>
        <tvbo:canonicalCode>BP</tvbo:canonicalCode>
    </owl:Class>
    


