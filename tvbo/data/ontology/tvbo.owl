    <!-- https://w3id.org/tvbo/software/CxSystem2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/CxSystem2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>A simulation framework for cortical microcircuit models with support for data-driven customization and modular circuit specification. Uses Brian2 as its simulation backend.</terms:description>
