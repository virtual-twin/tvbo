        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <rdfs:label>J_ei (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic weight i--&gt;e</skos:definition>
        <skos:notation>J_ei</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/J_ie -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/J_ie">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <terms:description>Synaptic weight e--&gt;i</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J_ie (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic weight e--&gt;i</skos:definition>
        <skos:notation>J_ie</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/J_ii -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/J_ii">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060077"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <terms:description>Synaptic weight i--&gt;i</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">15.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060077"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <rdfs:label>J_ii (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic weight i--&gt;i</skos:definition>
        <skos:notation>J_ii</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/eta_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/eta_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <terms:description>Mean heterogeneous current on excitatory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-5.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>eta_e (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Mean heterogeneous current on excitatory population</skos:definition>
        <skos:notation>eta_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/eta_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/eta_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <terms:description>Mean heterogeneous current on inhibitory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-5.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>eta_i (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Mean heterogeneous current on inhibitory population</skos:definition>
        <skos:notation>eta_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/tau_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/tau_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0043179"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <terms:description>Characteristic time of excitatory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0043179"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>tau_e (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Characteristic time of excitatory population</skos:definition>
        <skos:notation>tau_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/tau_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/tau_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0043180"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <terms:description>Characteristic time of inhibitory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0043180"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>tau_i (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Characteristic time of inhibitory population</skos:definition>
        <skos:notation>tau_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/tau_s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/tau_s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <terms:description>Synaptic time constant</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>tau_s (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic time constant</skos:definition>
        <skos:notation>tau_s</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/V_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/V_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V_e, t)</tvbo:lhs>
        <tvbo:rhs>(I_e + V_e**2 + eta_e - pi**2*r_e**2*tau_e**2 + s_ee*tau_e - s_ei*tau_e)/tau_e</tvbo:rhs>
        <rdfs:label>V_e (DumontGutkin state variable)</rdfs:label>
        <skos:notation>V_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/V_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/V_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V_i, t)</tvbo:lhs>
        <tvbo:rhs>(I_i + V_i**2 + eta_i - pi**2*r_i**2*tau_i**2 + s_ie*tau_i - s_ii*tau_i)/tau_i</tvbo:rhs>
        <rdfs:label>V_i (DumontGutkin state variable)</rdfs:label>
        <skos:notation>V_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/r_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/r_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(r_e, t)</tvbo:lhs>
        <tvbo:rhs>(Delta_e/(pi*tau_e) + 2*V_e*r_e)/tau_e</tvbo:rhs>
        <rdfs:label>r_e (DumontGutkin state variable)</rdfs:label>
        <skos:notation>r_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/r_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/r_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(r_i, t)</tvbo:lhs>
        <tvbo:rhs>(Delta_i/(pi*tau_i) + 2*V_i*r_i)/tau_i</tvbo:rhs>
        <rdfs:label>r_i (DumontGutkin state variable)</rdfs:label>
        <skos:notation>r_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ee -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ee">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(s_ee, t)</tvbo:lhs>
        <tvbo:rhs>(J_ee*r_e + c_glob - s_ee)/tau_s</tvbo:rhs>
        <rdfs:label>s_ee (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ee</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ei -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ei">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(s_ei, t)</tvbo:lhs>
        <tvbo:rhs>(J_ei*r_i - s_ei)/tau_s</tvbo:rhs>
        <rdfs:label>s_ei (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ei</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ie -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ie">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(s_ie, t)</tvbo:lhs>
        <tvbo:rhs>(Gamma*c_glob + J_ie*r_e - s_ie)/tau_s</tvbo:rhs>
        <rdfs:label>s_ie (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ie</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ii -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ii">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(s_ii, t)</tvbo:lhs>
        <tvbo:rhs>(J_ii*r_i - s_ii)/tau_s</tvbo:rhs>
        <rdfs:label>s_ii (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ii</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/derived_variables/Iext_total -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/derived_variables/Iext_total">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Iext_total</tvbo:lhs>
        <tvbo:rhs>Iext + local_coupling*x1</tvbo:rhs>
        <terms:description>External input to the first population including local coupling input on x1.</terms:description>
        <rdfs:label>Iext_total (Epileptor derived variable)</rdfs:label>
        <skos:notation>Iext_total</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/derived_variables/f1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/derived_variables/f1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>f1</tvbo:lhs>
        <tvbo:rhs>Piecewise((-a*x1**2 + b*x1, x1 &lt; 0), (slope - x2 + 0.6*(z - 4.0)**2, True))</tvbo:rhs>
        <terms:description>Nonlinear function in the first state variable x1, piecewise on the sign of x1.</terms:description>
        <rdfs:label>f1 (Epileptor derived variable)</rdfs:label>
        <skos:notation>f1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/derived_variables/f2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/derived_variables/f2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>f2</tvbo:lhs>
        <tvbo:rhs>Piecewise((0, x2 &lt; -0.25), (aa*(x2 + 0.25), True))</tvbo:rhs>
        <terms:description>Nonlinear function in the fifth state variable y2, piecewise on the value of x2.</terms:description>
        <rdfs:label>f2 (Epileptor derived variable)</rdfs:label>
        <skos:notation>f2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/derived_variables/h -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/derived_variables/h">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>h</tvbo:lhs>
        <tvbo:rhs>Piecewise((x0 + 3/(1 + exp(-(x1 + 0.5)/0.1)), modification &gt; 0), (4*(x1 - x0) + Piecewise((-0.1*z**7, z &lt; 0), (0, True)), True))</tvbo:rhs>
        <terms:description>Permittivity drive for z: sigmoidal when modification&gt;0, else linear (Piecewise on modification).</terms:description>
        <rdfs:label>h (Epileptor derived variable)</rdfs:label>
        <skos:notation>h</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/derived_variables/lfp -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/derived_variables/lfp">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>lfp</tvbo:lhs>
        <tvbo:rhs>x2 - x1</tvbo:rhs>
        <terms:description>Local field potential proxy: TVB Epileptor observable x2 - x1.</terms:description>
        <rdfs:label>lfp (Epileptor derived variable)</rdfs:label>
        <skos:notation>lfp</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/Iext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/Iext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the first population.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.1</schema:defaultValue>
        <rdfs:label>Iext (Epileptor parameter)</rdfs:label>
        <skos:definition>External input current to the first population.</skos:definition>
        <skos:notation>Iext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/Iext2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/Iext2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the second population.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.45</schema:defaultValue>
        <rdfs:label>Iext2 (Epileptor parameter)</rdfs:label>
        <skos:definition>External input current to the second population.</skos:definition>
        <skos:notation>Iext2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/Kf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/Kf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling scaling on a fast time scale.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kf (Epileptor parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a fast time scale.</skos:definition>
        <skos:notation>Kf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Permittivity coupling, that is from the fast time scale toward the slow time scale.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Ks (Epileptor parameter)</rdfs:label>
        <skos:definition>Permittivity coupling, from the fast time scale toward the slow time scale.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/Kvf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/Kvf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling scaling on a very fast time scale.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kvf (Epileptor parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a very fast time scale.</skos:definition>
        <skos:notation>Kvf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the cubic term in the first state variable x1.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>a (Epileptor parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the first state variable.</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/aa -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/aa">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the fifth state variable y2.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.0</schema:defaultValue>
        <rdfs:label>aa (Epileptor parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the fifth state variable.</skos:definition>
        <skos:notation>aa</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the first state variable x1.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>b (Epileptor parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state variable.</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/bb -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/bb">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient of lowpass excitatory coupling in the fourth state variable x2.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>bb (Epileptor parameter)</rdfs:label>
        <skos:definition>Linear coefficient of lowpass excitatory coupling in the fourth state variable.</skos:definition>
        <skos:notation>bb</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Additive coefficient for the second state variable y1, called y0 in the Jirsa et al. (2014) paper.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>c (Epileptor parameter)</rdfs:label>
        <skos:definition>Additive coefficient for the second state variable.</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the second state variable y1.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>d (Epileptor parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the second state variable.</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Switch between linear (0/False) and sigmoidal (&gt;0/True) z-drive h.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>modification (Epileptor parameter)</rdfs:label>
        <skos:definition>Selects the permittivity-drive form: &gt;0 (True) uses the sigmoidal influence on z, default 0 (False) the linear influence.</skos:definition>
        <skos:notation>modification</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling in the third state variable z, called 1/tau0 in the Jirsa et al. (2014) paper.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.5E-4</schema:defaultValue>
        <rdfs:label>r (Epileptor parameter)</rdfs:label>
        <skos:definition>Temporal scaling in the third state variable.</skos:definition>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the third state variable z.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.0</schema:defaultValue>
        <rdfs:label>s (Epileptor parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the third state variable.</skos:definition>
        <skos:notation>s</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/slope -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/slope">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the first state variable x1.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>slope (Epileptor parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the first state variable.</skos:definition>
        <skos:notation>slope</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling coefficient in the fifth state variable y2.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <rdfs:label>tau (Epileptor parameter)</rdfs:label>
        <skos:definition>Temporal scaling coefficient in the fifth state variable.</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/tt -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/tt">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Time scaling of the whole system.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tt (Epileptor parameter)</rdfs:label>
        <skos:definition>Time scaling of the whole system.</skos:definition>
        <skos:notation>tt</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/x0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/x0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Epileptogenicity parameter.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema:defaultValue>
        <rdfs:label>x0 (Epileptor parameter)</rdfs:label>
        <skos:definition>Epileptogenicity parameter.</skos:definition>
        <skos:notation>x0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(g, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-0.01*(g - 0.1*x1))</tvbo:rhs>
        <terms:description>Lowpass-filtered excitatory coupling variable.</terms:description>
        <rdfs:label>g (Epileptor state variable)</rdfs:label>
        <skos:notation>g</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(y1 - z + Iext_total + Kvf*c_glob0 + f1*x1)</tvbo:rhs>
        <terms:description>First state variable of the first (fast) population.</terms:description>
        <rdfs:label>x1 (Epileptor state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/x2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/x2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-y2 + x2 - x2**3 + Iext2 + bb*g - 0.3*(z - 3.5) + Kf*c_glob1)</tvbo:rhs>
        <terms:description>First state variable of the second (slow) population.</terms:description>
        <rdfs:label>x2 (Epileptor state variable)</rdfs:label>
        <skos:notation>x2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(c - d*x1**2 - y1)</tvbo:rhs>
        <terms:description>Second state variable of the first (fast) population.</terms:description>
        <rdfs:label>y1 (Epileptor state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-y2 + f2)/tau</tvbo:rhs>
        <terms:description>Second state variable of the second (slow) population.</terms:description>
        <rdfs:label>y2 (Epileptor state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>tt*r*(h - z + Ks*c_glob0)</tvbo:rhs>
        <terms:description>Slow permittivity (energy) state variable.</terms:description>
        <rdfs:label>z (Epileptor state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/derived_variables/h -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/derived_variables/h">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>h</tvbo:lhs>
        <tvbo:rhs>Piecewise((x0 + 3.0/(exp((-x1 - 1*0.5)/0.1) + 1.0), modification &gt; 0), (zcond + 4*(-x0 + x1), True))</tvbo:rhs>
        <rdfs:label>h (Epileptor2D derived variable)</rdfs:label>
        <skos:notation>h</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/derived_variables/x1cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/derived_variables/x1cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>x1cond</tvbo:lhs>
        <tvbo:rhs>Piecewise((a*x1**2 + x1*(-b + d), x1 &lt; 0), (d*x1 - slope - 0.6*(z - 4.0)**2, True))</tvbo:rhs>
        <rdfs:label>x1cond (Epileptor2D derived variable)</rdfs:label>
        <skos:notation>x1cond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/derived_variables/zcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/derived_variables/zcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>zcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((-0.1*z**7, z &lt; 0), (0, True))</tvbo:rhs>
        <rdfs:label>zcond (Epileptor2D derived variable)</rdfs:label>
        <skos:notation>zcond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/Iext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/Iext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.1</schema:defaultValue>
        <rdfs:label>Iext (Epileptor2D parameter)</rdfs:label>
        <skos:definition>External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>Iext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Ks (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al., 2014).

The coupling quantifies the influence of neuronal fast discharges x_E2D on the local slow permittivity variable z_E2D.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/Kvf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/Kvf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling scaling on a very fast time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kvf (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a very fast time scale.</skos:definition>
        <skos:notation>Kvf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the cubic term in the first state-variable x_E2D via the function f(x)_E2D, in Epileptor2D Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>a (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the first state-variable x_E2D via the function f(x)_E2D, in Epileptor2D Proix et al.,2014).</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>b (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Additive coefficient for the second state-variable x_{2},         called :math:`y_{0}` in Jirsa paper</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>c (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Additive coefficient for the second state-variable x_{2},         called :math:`y_{0}` in Jirsa paper.</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the first state-variable x_E2D via the function f in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>d (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state-variable x_E2D via the function f in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>When modification is True, the function h_E2D uses a nonlinear influence on z_E2D</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>modification (Epileptor2D parameter)</rdfs:label>
        <skos:definition>When modification is True, the function h_E2D uses a nonlinear influence on z_E2D. The default value is False, i.e., linear influence on z_E2D.</skos:definition>
        <skos:notation>modification</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling in the slow state-variable, \         called :math:`1\tau_{0}` in Jirsa paper (see class Epileptor)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.5E-4</schema:defaultValue>
        <rdfs:label>r (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Temporal scaling in the slow state-variable, \
        called :math:`1\tau_{0}` in Jirsa paper (see class Epileptor).</skos:definition>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/slope -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/slope">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>slope (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>slope</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/tt -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/tt">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Characteristic time scale of the whole-system Epileptor2D</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tt (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Characteristic time scale of the whole-system Epileptor2D.</skos:definition>
        <skos:notation>tt</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/x0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/x0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0043179"/>
        <terms:description>Degree of excitability or epileptogenicity in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0043179"/>
        <rdfs:label>x0 (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Degree of excitability or epileptogenicity in Epileptor2D (Proix et al.,2014).

If x0 is greater than a critical value, x0,critic = −2.05 (i.e., in the supercritical regime), the system can trigger seizures autonomously; otherwise it is in its equilibrium state (i.e., in the subcritical regime).

Note:
- If modification_E2D:
if x0 is smaller than a critical value, x0,critic = 2.91, can trigger seizures autonomously; otherwise it is in its equilibrium state (Proix et al., 2014).</skos:definition>
        <skos:notation>x0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext + Kvf*c_glob + c + local_coupling*x1 - x1*x1cond - z)</tvbo:rhs>
        <terms:description>First state-variable in the Epileptor2D (Proix et al</terms:description>
        <rdfs:label>x1 (Epileptor2D state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>r*tt*(Ks*c_glob + h - z)</tvbo:rhs>
        <terms:description>Slow permittivity state-variable of the Epileptor2D (Proix et al</terms:description>
        <rdfs:label>z (Epileptor2D state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/N -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/N">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>N (Epileptor3DStefanescuMcDonald parameter)</rdfs:label>
        <skos:definition>Effective population size / scaling of the resting-state regulation term.</skos:definition>
        <skos:notation>N</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/tau_z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/tau_z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2857.0</schema:defaultValue>
        <rdfs:label>tau_z (Epileptor3DStefanescuMcDonald parameter)</rdfs:label>
        <skos:definition>Slow timescale for the z permittivity variable.</skos:definition>
        <skos:notation>tau_z</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/x_0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/x_0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema:defaultValue>
        <rdfs:label>x_0 (Epileptor3DStefanescuMcDonald parameter)</rdfs:label>
        <skos:definition>Excitability parameter (Epileptor convention).</skos:definition>
        <skos:notation>x_0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>N*(x1 - x1**3/3 - z + c_glob)</tvbo:rhs>
        <terms:description>Fast excitable variable (placeholder Epileptor-like dynamics).</terms:description>
        <rdfs:label>x1 (Epileptor3DStefanescuMcDonald state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>(4*(x1 - x_0) - z)/tau_z</tvbo:rhs>
        <terms:description>Slow permittivity / excitability variable.</terms:description>
        <rdfs:label>z (Epileptor3DStefanescuMcDonald state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/h -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/h">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>h</tvbo:lhs>
        <tvbo:rhs>Piecewise((x0 + 3/(exp((-x1 - 1*0.5)/0.1) + 1), modification &gt; 0), (zcond + 4*(-x0 + x1), True))</tvbo:rhs>
        <rdfs:label>h (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>h</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/x1cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/x1cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>x1cond</tvbo:lhs>
        <tvbo:rhs>Piecewise(((-a)*x1**2 + b*x1, x1 &lt; 0), (slope - x2 + 0.6*(z - 4.0)**2, True))</tvbo:rhs>
        <rdfs:label>x1cond (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>x1cond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/y2cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/y2cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>y2cond</tvbo:lhs>
        <tvbo:rhs>Piecewise((0.0, x2 &lt; -0.25), (aa*(x2 + 0.25), True))</tvbo:rhs>
        <rdfs:label>y2cond (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>y2cond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/zcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/zcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>zcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((-0.1*z**7, z &lt; 0), (0.0, True))</tvbo:rhs>
        <rdfs:label>zcond (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>zcond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Iext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Iext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the first sub-population (x1_E5D, y1_E5D) via the state-variable x1_E5D, in Epileptor5D (Jirsa et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.1</schema:defaultValue>
        <rdfs:label>Iext (Epileptor5D parameter)</rdfs:label>
        <skos:definition>External input current to the first sub-population (x1_E5D, y1_E5D) via the state-variable x1_E5D, in Epileptor5D (Jirsa et al.,2014).</skos:definition>
        <skos:notation>Iext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Iext2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Iext2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the second population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.45</schema:defaultValue>
        <rdfs:label>Iext2 (Epileptor5D parameter)</rdfs:label>
        <skos:definition>External input current to the second population</skos:definition>
        <skos:notation>Iext2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Kf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Kf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Correspond to the coupling scaling on a fast time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kf (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Correspond to the coupling scaling on a fast time scale.</skos:definition>
        <skos:notation>Kf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Permittivity coupling on the slow permittivity state-variable z_E5D in Epileptor5D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Ks (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Permittivity coupling on the slow permittivity state-variable z_E5D in Epileptor5D (Proix et al., 2014).

The coupling quantifies the influence of neuronal fast discharges x1_E5D on the local slow permittivity variable z_E5D.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Kvf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Kvf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling scaling on a very fast time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kvf (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a very fast time scale.</skos:definition>
        <skos:notation>Kvf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the cubic term in the first state variable</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>a (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the first state variable</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/aa -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/aa">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in fifth state variable</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.0</schema:defaultValue>
        <rdfs:label>aa (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in fifth state variable</skos:definition>
        <skos:notation>aa</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the first state variabel</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>b (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state variabel</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/bb -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/bb">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient of lowpass excitatory coupling in fourth state variable</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>bb (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient of lowpass excitatory coupling in fourth state variable</skos:definition>
        <skos:notation>bb</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Additive coefficient for the second state variable,         called :math:`y_{0}` in Jirsa paper</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>c (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Additive coefficient for the second state variable,         called :math:`y_{0}` in Jirsa paper</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the derivative of the second state-variable y1_E5D in Epileptor5D (Jirsa et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>d (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the derivative of the second state-variable y1_E5D in Epileptor5D (Jirsa et al.,2014).</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>When modification is True, the function h_E5D uses a nonlinear influence on z_E5D</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>modification (Epileptor5D parameter)</rdfs:label>
        <skos:definition>When modification is True, the function h_E5D uses a nonlinear influence on z_E5D. The default value is False, i.e., linear influence on z_E5D.</skos:definition>
        <skos:notation>modification</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling in the third state variable,         called :math:`1/\tau_{0}` in Jirsa paper</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.5E-4</schema:defaultValue>
        <rdfs:label>r (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Temporal scaling in the third state variable,         called :math:`1/\tau_{0}` in Jirsa paper</skos:definition>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the slow permittivity state-variable z_E5D in Epileptor5D (Jirsa et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.0</schema:defaultValue>
        <rdfs:label>s (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the slow permittivity state-variable z_E5D in Epileptor5D (Jirsa et al.,2014).</skos:definition>
        <skos:notation>s</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/slope -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/slope">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the first state variable</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>slope (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the first state variable</skos:definition>
        <skos:notation>slope</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling coefficient in fifth state variable</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <rdfs:label>tau (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Temporal scaling coefficient in fifth state variable</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/tt -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/tt">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Characteristic time scale of the whole-system Epileptor5D</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tt (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Characteristic time scale of the whole-system Epileptor5D.</skos:definition>
        <skos:notation>tt</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/x0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/x0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <terms:description>Epileptogenicity Parameter</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>x0 (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Epileptogenicity Parameter. Degree of excitability or epileptogenicity in Epileptor5D (Jirsa et al.,2014).

If x0 is greater than a critical value, x0,critic = −2.05, the system can trigger seizures autonomously; otherwise it is in its equilibrium state.

Note:
- If modification_E5D:
if x0 is smaller than a critical value, x0,critic = 2.91, can trigger seizures autonomously; otherwise it is in its equilibrium state (Proix et al., 2014).</skos:definition>
        <skos:notation>x0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(g, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-0.01*g + 0.001*x1)</tvbo:rhs>
        <terms:description>g_E5D is a low-pass filtered excitatory coupling function from sub-population (x1_E5D, y1_E5D) to (x2_E5D, y2_E5D) in Epileptor5D (Jirsa et al</terms:description>
        <rdfs:label>g (Epileptor5D state variable)</rdfs:label>
        <skos:notation>g</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext + Kvf*c_glob0 + local_coupling*x1 + x1*x1cond + y1 - z)</tvbo:rhs>
        <terms:description>First state-variable of the first Epileptor5D population (Jirsa et al</terms:description>
        <rdfs:label>x1 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/x2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/x2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext2 + Kf*c_glob1 + bb*g - x2**3 + x2 - y2 - 0.3*z + 1.05)</tvbo:rhs>
        <terms:description>First state-variable of the second Epileptor5D sub-population (Jirsa et al</terms:description>
        <rdfs:label>x2 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>x2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(c - d*x1**2 - y1)</tvbo:rhs>
        <terms:description>Second state-variable of the first Epileptor5D sub-population (Jirsa et al</terms:description>
        <rdfs:label>y1 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-y2 + y2cond)/tau</tvbo:rhs>
        <terms:description>Second state-variable of the second Epileptor5D population (Jirsa et al</terms:description>
        <rdfs:label>y2 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>r*tt*(Ks*c_glob0 + h - z)</tvbo:rhs>
        <terms:description>Slow permittivity state-variable of the Epileptor5D (Jirsa et al</terms:description>
        <rdfs:label>z (Epileptor5D state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E0</tvbo:lhs>
        <tvbo:rhs>mu2_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)</tvbo:rhs>
        <terms:description>First component of the unit vector E parametrising the great arc (A/||A|| with A = [mu2_start, -mu1_start, nu_start]).</terms:description>
        <rdfs:label>E0 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>E0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E1</tvbo:lhs>
        <tvbo:rhs>-mu1_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)</tvbo:rhs>
        <terms:description>Second component of the unit vector E parametrising the great arc.</terms:description>
        <rdfs:label>E1 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>E1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E2</tvbo:lhs>
        <tvbo:rhs>nu_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)</tvbo:rhs>
        <terms:description>Third component of the unit vector E parametrising the great arc.</terms:description>
        <rdfs:label>E2 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>E2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F0</tvbo:lhs>
        <tvbo:rhs>(mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)</tvbo:rhs>
        <terms:description>First component of the unit vector F parametrising the great arc (normalised ((A x B) x A) with B = [mu2_stop, -mu1_stop, nu_stop]).</terms:description>
        <rdfs:label>F0 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>F0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F1</tvbo:lhs>
        <tvbo:rhs>(mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)</tvbo:rhs>
        <terms:description>Second component of the unit vector F parametrising the great arc.</terms:description>
        <rdfs:label>F1 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>F1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F2</tvbo:lhs>
        <tvbo:rhs>(-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)</tvbo:rhs>
        <terms:description>Third component of the unit vector F parametrising the great arc.</terms:description>
        <rdfs:label>F2 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>F2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>cardano_a</tvbo:lhs>
        <tvbo:rhs>mu1/2</tvbo:rhs>
        <terms:description>Half of mu1 (the Cardano coefficient mu1/2 for the depressed cubic xs**3 - mu2*xs - mu1 = 0).</terms:description>
        <rdfs:label>cardano_a (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>cardano_a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>cardano_d</tvbo:lhs>
        <tvbo:rhs>mu1**2/4 - mu2**3/27</tvbo:rhs>
        <terms:description>Cardano discriminant mu1**2/4 - mu2**3/27 for the cubic xs**3 - mu2*xs - mu1 = 0.</terms:description>
        <rdfs:label>cardano_d (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>cardano_d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu1</tvbo:lhs>
        <tvbo:rhs>-R*(E1*cos(z) + F1*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter mu1 along the great arc as a function of the slow variable z.</terms:description>
        <rdfs:label>mu1 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>mu1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu2</tvbo:lhs>
        <tvbo:rhs>R*(E0*cos(z) + F0*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter mu2 along the great arc as a function of the slow variable z.</terms:description>
        <rdfs:label>mu2 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>mu2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/nu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/nu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>nu</tvbo:lhs>
        <tvbo:rhs>R*(E2*cos(z) + F2*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter nu along the great arc as a function of the slow variable z.</terms:description>
        <rdfs:label>nu (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>nu</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/xs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/xs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>xs</tvbo:lhs>
        <tvbo:rhs>Piecewise((2*(cardano_a**2 - cardano_d)**(1/6)*cos(atan2(sqrt(-cardano_d), cardano_a)/3), cardano_d &lt; 0), (Piecewise(((cardano_a + sqrt(cardano_d))**(1/3), (cardano_a + sqrt(cardano_d)) &gt;= 0), (Abs(cardano_a + sqrt(cardano_d))**(1/3)/2, True)) + Piecewise(((cardano_a - sqrt(cardano_d))**(1/3), (cardano_a - sqrt(cardano_d)) &gt;= 0), (Abs(cardano_a - sqrt(cardano_d))**(1/3)/2, True)), True))</tvbo:rhs>
        <terms:description>The x-coordinate of the resting state (branch N=1), the real part of the Cardano root of xs**3 - mu2*xs - mu1 = 0, reproducing TVB&apos;s principal-branch complex cube root. For negative discriminant (three real roots) the trigonometric form is used; for non-negative discriminant the principal-branch real cube root sum is used (a real cube root for non-negative argument, half the real cube root of the magnitude for negative argument).</terms:description>
        <rdfs:label>xs (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>xs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Slow permittivity coupling strength, the default of zero is no coupling.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Ks (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>Slow permittivity coupling strength.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/R -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/R">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Radius in the unfolding sphere on which the great arc connecting onset and offset points lies.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.4</schema:defaultValue>
        <rdfs:label>R (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>Radius in unfolding.</skos:definition>
        <skos:notation>R</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Unfolding type of the degenerate Takens-Bogdanov bifurcation, default is a focus type.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>b (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>Unfolding type of the degenerate Takens-Bogdanov bifurcation.</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Speed of the slow variable z.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.001</schema:defaultValue>
        <rdfs:label>c (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>Speed of the slow variable.</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/dstar -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/dstar">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Threshold for the inversion of the slow variable z.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3</schema:defaultValue>
        <rdfs:label>dstar (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>Threshold for the inversion of the slow variable.</skos:definition>
        <skos:notation>dstar</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Toggle the +0.1*(z-0.5)^7 stabilising term in z_dot: &gt;0 (True, default) includes it, 0 (False) omits it.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>modification (EpileptorCodim3 parameter)</rdfs:label>
        <skos:notation>modification</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/mu1_start -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/mu1_start">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu1 at the offset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-0.02285</schema:defaultValue>
        <rdfs:label>mu1_start (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter mu1 at the offset point for the given class.</skos:definition>
        <skos:notation>mu1_start</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/mu1_stop -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/mu1_stop">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu1 at the onset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-0.07465</schema:defaultValue>
        <rdfs:label>mu1_stop (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter mu1 at the onset point for the given class.</skos:definition>
        <skos:notation>mu1_stop</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/mu2_start -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/mu2_start">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu2 at the offset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3448</schema:defaultValue>
        <rdfs:label>mu2_start (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter mu2 at the offset point for the given class.</skos:definition>
        <skos:notation>mu2_start</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/mu2_stop -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/mu2_stop">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu2 at the onset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3351</schema:defaultValue>
        <rdfs:label>mu2_stop (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter mu2 at the onset point for the given class.</skos:definition>
        <skos:notation>mu2_stop</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/nu_start -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/nu_start">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter nu at the offset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2014</schema:defaultValue>
        <rdfs:label>nu_start (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter nu at the offset point for the given class.</skos:definition>
        <skos:notation>nu_start</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/nu_stop -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/nu_stop">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter nu at the onset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2053</schema:defaultValue>
        <rdfs:label>nu_stop (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter nu at the onset point for the given class.</skos:definition>
        <skos:notation>nu_stop</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/state_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/state_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x, t)</tvbo:lhs>
        <tvbo:rhs>-y</tvbo:rhs>
        <terms:description>Fast subsystem variable x.</terms:description>
        <rdfs:label>x (EpileptorCodim3 state variable)</rdfs:label>
        <skos:notation>x</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/state_variables/y -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/state_variables/y">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y, t)</tvbo:lhs>
        <tvbo:rhs>x**3 - mu2*x - mu1 - y*(nu + b*x + x**2)</tvbo:rhs>
        <terms:description>Fast subsystem variable y.</terms:description>
        <rdfs:label>y (EpileptorCodim3 state variable)</rdfs:label>
        <skos:notation>y</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>-c*(sqrt((x - xs)**2 + y**2) - dstar + Piecewise(((z - 1/2)**7/10, modification &gt; 0), (0, True)) + Ks*c_glob)</tvbo:rhs>
        <terms:description>Slow subsystem variable z steering the fast subsystem along the great arc.</terms:description>
        <rdfs:label>z (EpileptorCodim3 state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>A0</tvbo:lhs>
        <tvbo:rhs>R*(G0*cos(uA) + H0*sin(uA))</tvbo:rhs>
        <rdfs:label>A0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>A0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>A1</tvbo:lhs>
        <tvbo:rhs>R*(G1*cos(uA) + H1*sin(uA))</tvbo:rhs>
        <rdfs:label>A1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>A1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>A2</tvbo:lhs>
        <tvbo:rhs>R*(G2*cos(uA) + H2*sin(uA))</tvbo:rhs>
        <rdfs:label>A2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>A2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>B0</tvbo:lhs>
        <tvbo:rhs>R*(L0*cos(uB) + M0*sin(uB))</tvbo:rhs>
        <rdfs:label>B0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>B0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>B1</tvbo:lhs>
        <tvbo:rhs>R*(L1*cos(uB) + M1*sin(uB))</tvbo:rhs>
        <rdfs:label>B1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>B1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>B2</tvbo:lhs>
        <tvbo:rhs>R*(L2*cos(uB) + M2*sin(uB))</tvbo:rhs>
        <rdfs:label>B2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>B2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>C0</tvbo:lhs>
        <tvbo:rhs>A1*B2 - A2*B1</tvbo:rhs>
        <rdfs:label>C0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>C0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>C1</tvbo:lhs>
        <tvbo:rhs>A2*B0 - A0*B2</tvbo:rhs>
        <rdfs:label>C1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>C1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>C2</tvbo:lhs>
        <tvbo:rhs>A0*B1 - A1*B0</tvbo:rhs>
        <rdfs:label>C2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>C2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E0</tvbo:lhs>
        <tvbo:rhs>A0/normA</tvbo:rhs>
        <rdfs:label>E0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>E0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E1</tvbo:lhs>
        <tvbo:rhs>A1/normA</tvbo:rhs>
        <rdfs:label>E1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>E1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E2</tvbo:lhs>
        <tvbo:rhs>A2/normA</tvbo:rhs>
        <rdfs:label>E2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>E2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F0</tvbo:lhs>
        <tvbo:rhs>Fx0/normF</tvbo:rhs>
        <rdfs:label>F0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>F0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F1</tvbo:lhs>
        <tvbo:rhs>Fx1/normF</tvbo:rhs>
        <rdfs:label>F1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>F1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F2</tvbo:lhs>
        <tvbo:rhs>Fx2/normF</tvbo:rhs>
        <rdfs:label>F2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>F2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Fx0</tvbo:lhs>
        <tvbo:rhs>C1*A2 - C2*A1</tvbo:rhs>
        <rdfs:label>Fx0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>Fx0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Fx1</tvbo:lhs>
        <tvbo:rhs>C2*A0 - C0*A2</tvbo:rhs>
        <rdfs:label>Fx1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>Fx1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Fx2</tvbo:lhs>
        <tvbo:rhs>C0*A1 - C1*A0</tvbo:rhs>
        <rdfs:label>Fx2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>Fx2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/disc -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/disc">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>disc</tvbo:lhs>
        <tvbo:rhs>mu1**2/4 - mu2**3/27</tvbo:rhs>
        <terms:description>Discriminant mu1^2/4 - mu2^3/27 of the depressed cubic for the resting-state x-coordinate.</terms:description>
        <rdfs:label>disc (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>disc</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/mu1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/mu1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu1</tvbo:lhs>
        <tvbo:rhs>-R*(E1*cos(z) + F1*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter mu1 along the great arc (E, F, R) at slow variable z.</terms:description>
        <rdfs:label>mu1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>mu1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/mu2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/mu2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu2</tvbo:lhs>
        <tvbo:rhs>R*(E0*cos(z) + F0*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter mu2 along the great arc (E, F, R) at slow variable z.</terms:description>
        <rdfs:label>mu2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>mu2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normA -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normA">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>normA</tvbo:lhs>
        <tvbo:rhs>sqrt(A0**2 + A1**2 + A2**2)</tvbo:rhs>
        <rdfs:label>normA (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>normA</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normF -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normF">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>normF</tvbo:lhs>
        <tvbo:rhs>sqrt(Fx0**2 + Fx1**2 + Fx2**2)</tvbo:rhs>
        <rdfs:label>normF (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>normF</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/nu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/nu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>nu</tvbo:lhs>
        <tvbo:rhs>R*(E2*cos(z) + F2*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter nu along the great arc (E, F, R) at slow variable z.</terms:description>
        <rdfs:label>nu (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>nu</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/sqdisc -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/sqdisc">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sqdisc</tvbo:lhs>
        <tvbo:rhs>sqrt(Abs(disc))</tvbo:rhs>
        <terms:description>Square root of the absolute discriminant.</terms:description>
        <rdfs:label>sqdisc (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>sqdisc</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/xs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/xs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>xs</tvbo:lhs>
        <tvbo:rhs>Piecewise((Abs(mu1/2 + sqdisc)**(1/3)*cos(atan2(0, mu1/2 + sqdisc)/3) + Abs(mu1/2 - sqdisc)**(1/3)*cos(atan2(0, mu1/2 - sqdisc)/3), disc &gt;= 0), (sqrt((mu1/2)**2 + sqdisc**2)**(1/3)*cos(atan2(sqdisc, mu1/2)/3) + sqrt((mu1/2)**2 + sqdisc**2)**(1/3)*cos(atan2(-sqdisc, mu1/2)/3), True))</tvbo:rhs>
        <terms:description>Real x-coordinate of the resting state, the branch (N = 1) real solution of x_s^3 - mu2 x_s - mu1 = 0 via Cardano&apos;s formula, taking the real part of the principal complex cube roots in both the one-real-root (disc &gt;= 0) and three-real-roots (disc &lt; 0) regimes.</terms:description>
        <rdfs:label>xs (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>xs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Slow permittivity coupling strength, the default is no coupling.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Ks (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/R -->

