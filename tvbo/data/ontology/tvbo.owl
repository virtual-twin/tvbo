    <rdf:Description rdf:about="https://w3id.org/tvbo/CouplingInput">
        <rdfs:comment xml:lang="en">Aggregate input arriving at a node from connected nodes; modelled as the postsynaptic potential induced by long-range projections.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>CouplingInput</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/tvbo/PostsynapticPotential"/>
        <skos:definition>Specification of a coupling input channel for multi-coupling dynamics</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/CouplingInput"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:prefLabel xml:lang="en">CouplingInput</skos:prefLabel>
        <skos:relatedMatch rdf:resource="http://www.neuroml.org/lems/0.7.6#Requirement"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/Deterministic">
        <rdfs:label xml:lang="en">Deterministic</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/Excitable">
