    <!-- https://w3id.org/tvbo/StandardGraphType#Grid -->

    <owl:Class rdf:about="https://w3id.org/tvbo/StandardGraphType#Grid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/StandardGraphType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>Grid (StandardGraphType)</rdfs:label>
        <skos:definition>Grid/lattice graph (params: dims)</skos:definition>
        <skos:notation>Grid</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/StandardGraphType#RandomRegular -->

    <owl:Class rdf:about="https://w3id.org/tvbo/StandardGraphType#RandomRegular">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/StandardGraphType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>RandomRegular (StandardGraphType)</rdfs:label>
        <skos:definition>Random regular graph (params: k)</skos:definition>
        <skos:notation>RandomRegular</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/StandardGraphType#RandomReservoir -->

    <owl:Class rdf:about="https://w3id.org/tvbo/StandardGraphType#RandomReservoir">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/StandardGraphType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>RandomReservoir (StandardGraphType)</rdfs:label>
        <skos:definition>Sparse random recurrent adjacency with post-hoc spectral- radius rescaling. Parameters: sparsity, spectral_radius, weight_distribution, seed (the size comes from Network.number_of_nodes). Canonical Echo State Network substrate (Jaeger 2001) for reservoir computing.</skos:definition>
        <skos:notation>RandomReservoir</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/StandardGraphType#Star -->

    <owl:Class rdf:about="https://w3id.org/tvbo/StandardGraphType#Star">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/StandardGraphType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>Star (StandardGraphType)</rdfs:label>
        <skos:definition>Star graph</skos:definition>
        <skos:notation>Star</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/StandardGraphType#WattsStrogatz -->

    <owl:Class rdf:about="https://w3id.org/tvbo/StandardGraphType#WattsStrogatz">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/StandardGraphType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>WattsStrogatz (StandardGraphType)</rdfs:label>
        <skos:definition>Watts-Strogatz small-world (params: k, p)</skos:definition>
        <skos:notation>WattsStrogatz</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/StandardGraphType#WeightShuffle -->

    <owl:Class rdf:about="https://w3id.org/tvbo/StandardGraphType#WeightShuffle">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/StandardGraphType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>WeightShuffle (StandardGraphType)</rdfs:label>
        <skos:definition>Derived generator: permute the non-zero entries of a source matrix. Parameters: source (IRI to another Network), preserve (binary_mask), seed. Used for null-model controls (e.g. shuffled SC).</skos:definition>
        <skos:notation>WeightShuffle</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/SweepDirection#bidirectional -->

    <owl:Class rdf:about="https://w3id.org/tvbo/SweepDirection#bidirectional">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SweepDirection"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>bidirectional (SweepDirection)</rdfs:label>
        <skos:definition>Increase then decrease over the same values, recording both branches. Where the two branches differ, the sweep traces a hysteresis loop that exposes coexisting stable states (bistability / multistability). The multivalued generalisation of Continuation.bothside.</skos:definition>
        <skos:notation>bidirectional</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/SweepDirection#down -->

    <owl:Class rdf:about="https://w3id.org/tvbo/SweepDirection#down">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SweepDirection"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>down (SweepDirection)</rdfs:label>
        <skos:definition>Decrease the parameter monotonically (high to low), once.</skos:definition>
        <skos:notation>down</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/SweepDirection#up -->

    <owl:Class rdf:about="https://w3id.org/tvbo/SweepDirection#up">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SweepDirection"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>up (SweepDirection)</rdfs:label>
        <skos:definition>Increase the parameter monotonically (low to high), once.</skos:definition>
        <skos:notation>up</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/SweepSeeding#from_previous -->

    <owl:Class rdf:about="https://w3id.org/tvbo/SweepSeeding#from_previous">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SweepSeeding"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>from_previous (SweepSeeding)</rdfs:label>
        <skos:definition>Each point is seeded from the final state of the preceding point, so the trajectory follows the solution branch as the swept parameter changes quasi-statically. Forces sequential, order-dependent execution (emitted as a scan, not a vmap). Used to reach a working point by slowly ramping a parameter (e.g. global coupling) and, with sweep_direction, to expose hysteresis / multistability. Sweep-granularity analogue of InitialStateMethod.from_branch.</skos:definition>
        <skos:notation>from_previous</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/SweepSeeding#independent -->

    <owl:Class rdf:about="https://w3id.org/tvbo/SweepSeeding#independent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SweepSeeding"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>independent (SweepSeeding)</rdfs:label>
        <skos:definition>Each point is initialised independently from the model&apos;s initial values (a cold start), so points are order-independent and may be evaluated in parallel (see parallel_mode). Default; today&apos;s behaviour.</skos:definition>
        <skos:notation>independent</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/SystemType#continuous -->

    <owl:Class rdf:about="https://w3id.org/tvbo/SystemType#continuous">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SystemType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>continuous (SystemType)</rdfs:label>
        <skos:definition>Continuous-time dynamics (e.g., ODE/SDE).</skos:definition>
        <skos:notation>continuous</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/SystemType#discrete -->

    <owl:Class rdf:about="https://w3id.org/tvbo/SystemType#discrete">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SystemType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>discrete (SystemType)</rdfs:label>
        <skos:definition>Discrete-time dynamics (e.g., maps, iterated updates).</skos:definition>
        <skos:notation>discrete</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ToolRole#backend_runtime -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ToolRole#backend_runtime">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ToolRole"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>backend_runtime (ToolRole)</rdfs:label>
        <skos:definition>Optimized execution backend for another simulator.</skos:definition>
        <skos:notation>backend_runtime</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ToolRole#workflow_framework -->

