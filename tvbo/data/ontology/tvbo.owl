    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/nodes"/>
    


    <!-- https://w3id.org/tvbo/noise -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/noise"/>
    


