        <skos:definition>Array mapping each vertex index to its parent region index. Can use dataLocation instead for large arrays.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>vertex_to_region</skos:notation>
    </owl:DatatypeProperty>
    


