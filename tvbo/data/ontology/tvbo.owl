    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Hopf -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Hopf">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/Bifurcation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasCodimension"/>
                        <owl:hasValue rdf:resource="https://w3id.org/tvbo/Codimension1"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasEigenvalueSignature"/>
                        <owl:hasValue rdf:resource="https://w3id.org/tvbo/ConjugatePairImaginary"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Bifurcation"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/HopfHopf -->

    <owl:Class rdf:about="https://w3id.org/tvbo/HopfHopf">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Bifurcation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasCodimension"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Codimension2"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasEigenvalueSignature"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/TwoImaginaryPairs"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Codim-2 point where two Hopf curves cross (two imaginary pairs simultaneously).</rdfs:comment>
        <rdfs:label xml:lang="en">Hopf-Hopf (double Hopf)</rdfs:label>
        <skos:altLabel>HH</skos:altLabel>
        <skos:altLabel>double hopf</skos:altLabel>
        <skos:altLabel>hh</skos:altLabel>
        <skos:altLabel>hopf-hopf</skos:altLabel>
        <tvbo:canonicalCode>HH</tvbo:canonicalCode>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ImagingModality -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ImagingModality">
        <owl:equivalentClass>
