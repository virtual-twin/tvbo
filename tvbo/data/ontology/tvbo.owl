    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n">
        <rdfs:label>n (slot)</rdfs:label>
        <skos:definition>Number of points (alternative to step for grid exploration).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
