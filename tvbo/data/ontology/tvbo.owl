        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasEigenvalueSignature"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/DoubleZeroEigenvalue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Codim-2 point with a double-zero (nilpotent) eigenvalue, where fold, Hopf and homoclinic curves meet.</rdfs:comment>
        <rdfs:label xml:lang="en">Bogdanov-Takens</rdfs:label>
        <skos:altLabel>BT</skos:altLabel>
        <skos:altLabel>bogdanov takens</skos:altLabel>
        <skos:altLabel>bogdanov-takens</skos:altLabel>
        <skos:altLabel>bt</skos:altLabel>
        <tvbo:canonicalCode>BT</tvbo:canonicalCode>
    </owl:Class>
    


