        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/LarterBreakspear/parameters/V_Na"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/LarterBreakspear/parameters/V_T"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/LarterBreakspear/parameters/Z_T"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/LarterBreakspear/parameters/a_ee"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/LarterBreakspear/parameters/a_ei"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/LarterBreakspear/parameters/a_ie"/>
