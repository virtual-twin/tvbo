    <!-- https://w3id.org/tvbo/AlgorithmCompositionMode -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AlgorithmCompositionMode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/AlgorithmCompositionMode#combined"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/AlgorithmCompositionMode#nested"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>AlgorithmCompositionMode</rdfs:label>
        <skos:definition>How an included algorithm is composed with the outer algorithm. Determines whether the inner algorithm&apos;s update rules are merged into the same loop (combined) or run as a converging inner loop on each outer iteration (nested).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/AlgorithmCompositionMode#combined"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/AlgorithmCompositionMode#nested"/>
    </owl:Class>
    


