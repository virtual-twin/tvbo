    <!-- https://w3id.org/tvbo/WorkflowDistributeBy#auto -->

    <owl:Class rdf:about="https://w3id.org/tvbo/WorkflowDistributeBy#auto">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/WorkflowDistributeBy"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>auto (WorkflowDistributeBy)</rdfs:label>
        <skos:definition>Vectorize every axis the backend can batch; fan out the rest.</skos:definition>
        <skos:notation>auto</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/WorkflowDistributeBy#vectorize -->

    <owl:Class rdf:about="https://w3id.org/tvbo/WorkflowDistributeBy#vectorize">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/WorkflowDistributeBy"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>vectorize (WorkflowDistributeBy)</rdfs:label>
        <skos:definition>Place all otherwise-unassigned axes on the vectorized tier.</skos:definition>
        <skos:notation>vectorize</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/WorkflowDistributeBy#workflow -->

    <owl:Class rdf:about="https://w3id.org/tvbo/WorkflowDistributeBy#workflow">
