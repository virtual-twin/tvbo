        <rdfs:domain rdf:resource="https://w3id.org/tvbo/HemodynamicObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Temporal support of the HRF convolution kernel, in milliseconds; the lower bound the simulated transient must satisfy.</rdfs:comment>
