        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/w_p"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/state_variables/S_e"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/state_variables/S_i"/>
        <tvbo:model_type>mean_field</tvbo:model_type>
    </owl:NamedIndividual>
    


