        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Bifurcation"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Sample -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Sample">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/groups"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/size"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/groups"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/size"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/size"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>Sample</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/Sample"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/SamplingAxis -->

    <owl:Class rdf:about="https://w3id.org/tvbo/SamplingAxis">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/SamplingAxis#space"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/SamplingAxis#time"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>SamplingAxis</rdfs:label>
        <skos:definition>Dimension along which a distribution is sampled.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/SamplingAxis#space"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/SamplingAxis#time"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ScalarValue -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ScalarValue">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>ScalarValue</rdfs:label>
        <skos:definition>A scalar value: float, integer, string, or boolean. Used for slots that accept literals of any primitive type, such as argument values which may be numbers, strings, references, or booleans.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/linkml/Any"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/SchedulerDirective -->

    <owl:Class rdf:about="https://w3id.org/tvbo/SchedulerDirective">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/name"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/value"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/name"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/value"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/name"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/value"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>SchedulerDirective</rdfs:label>
        <skos:definition>One engine-native scheduler directive passed through verbatim by the engine&apos;s emitter (e.g. a Slurm ``#SBATCH --&lt;name&gt;=&lt;value&gt;`` line). The open extension point of WorkflowEngineConfig: it carries any directive the typed fields do not name, so a new scheduler flag needs no schema change.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/SchedulerDirective"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/SexEnum -->

