        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F2"/>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_a"/>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_d"/>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu1"/>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu2"/>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/nu"/>
