        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/NoiseType#brown"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/NoiseType#gaussian"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/NoiseType#pink"/>
