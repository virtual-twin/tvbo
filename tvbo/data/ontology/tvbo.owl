    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/local_states">
        <rdfs:label>local_states (slot)</rdfs:label>
        <skos:definition>References to state variables from the local (target) node. Used by name in pre_expression.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>local_states</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/loss -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/loss">
        <rdfs:label>loss (slot)</rdfs:label>
        <skos:definition>Loss function call. Uses FunctionCall to either: 1. Reference existing function: function: rmse 2. Inline callable: callable: {module: ..., name: ...} Arguments specify inputs (simulated_fc, empirical_fc, etc.)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>loss</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/mark -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/mark">
        <rdfs:label>mark (slot)</rdfs:label>
