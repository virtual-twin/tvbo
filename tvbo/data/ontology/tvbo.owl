    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/number_loc">
        <rdfs:label>number_loc (slot)</rdfs:label>
        <skos:definition>Per-panel override of the figure&apos;s panel_number_loc — e.g. wide top panels upper-right, grid panels upper-left.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>number_loc</skos:notation>
    </owl:ObjectProperty>
    


