        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Cik"/>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/IE_i"/>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/II_i"/>
