        <terms:description>STochastic Engine for Pathway Simulation — a stochastic reaction-diffusion simulator for modeling biochemical signaling pathways in realistic 3D cellular morphologies.</terms:description>
        <terms:license>GPL-3.0-only</terms:license>
        <schema:codeRepository>https://github.com/CNS-OIST/STEPS</schema:codeRepository>
        <schema:identifier>10.3389/fninf.2014.00068</schema:identifier>
        <schema:url>https://steps.sourceforge.net</schema:url>
        <rdfs:label>STEPS</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/Snudda -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/Snudda">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>A Python tool for creating detailed neuronal network models with realistic 3D neuron placement, morphology, and connectivity using touch detection. Exports to NEURON via SONATA format.</terms:description>
        <terms:license>GPL-3.0-only</terms:license>
        <schema:codeRepository>https://github.com/Hjorthmedansen/Snudda</schema:codeRepository>
        <schema:url>https://snudda.readthedocs.io</schema:url>
        <rdfs:label>Snudda</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/SpikeInterface -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/SpikeInterface">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>A unified framework for spike sorting, providing a common interface to many spike sorting algorithms, preprocessing tools, and quality metrics.</terms:description>
        <terms:license>MIT</terms:license>
        <schema:codeRepository>https://github.com/SpikeInterface/spikeinterface</schema:codeRepository>
        <schema:identifier>10.7554/eLife.61834</schema:identifier>
        <schema:url>https://spikeinterface.readthedocs.io</schema:url>
        <rdfs:label>SpikeInterface</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/SpineCreator -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/SpineCreator">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>A graphical tool for building neural network models using SpineML component-based descriptions, with export to multiple simulation engines.</terms:description>
        <terms:license>GPL-3.0-only</terms:license>
        <schema:codeRepository>https://github.com/SpineML/SpineCreator</schema:codeRepository>
        <schema:url>https://spineml.github.io/spinecreator/</schema:url>
        <rdfs:label>SpineCreator</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/SpineML -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/SpineML">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>A declarative XML-based language for describing spiking neural network models using a component-based approach. Designed for simulator independence.</terms:description>
        <terms:license>BSD-3-Clause</terms:license>
        <schema:codeRepository>https://github.com/SpineML</schema:codeRepository>
        <schema:url>https://spineml.github.io</schema:url>
        <rdfs:label>SpineML</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/TVB -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/TVB">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>The Virtual Brain — a neuroinformatics platform for full-brain network simulation using neural mass and mean-field models on individual connectome data.</terms:description>
        <terms:license>GPL-3.0-or-later</terms:license>
        <schema:codeRepository>https://github.com/the-virtual-brain/tvb-root</schema:codeRepository>
        <schema:identifier>10.3389/fninf.2013.00010</schema:identifier>
        <schema:url>https://www.thevirtualbrain.org</schema:url>
        <rdfs:label>TVB</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/TVB-O -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/TVB-O">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>The Virtual Brain Ontology — a Python library for knowledge representation, code generation, and simulation of large-scale brain network models. Integrates a LinkML-based ontology with JAX-accelerated numerical backends and interoperates with TVB, PyRates, NEURON, NEST, NeuroML, and NetworkDynamics.jl.</terms:description>
        <terms:license>EUPL-1.2</terms:license>
        <schema:codeRepository>https://github.com/virtual-twin/tvbo</schema:codeRepository>
        <schema:identifier>10.1101/2025.11.19.689211</schema:identifier>
        <schema:url>https://tvbo.charite.de</schema:url>
        <rdfs:label>TVB-O</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/TVB-Optim -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/TVB-Optim">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>Differentiable whole-brain simulation and optimization framework using JAX. Supports gradient-based fitting of neural mass models to empirical neuroimaging data.</terms:description>
        <terms:license>EUPL-1.2</terms:license>
        <schema:codeRepository>https://github.com/virtual-twin/tvboptim</schema:codeRepository>
        <schema:url>https://virtual-twin.github.io/tvboptim/</schema:url>
        <rdfs:label>TVB-Optim</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/jNeuroML -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/jNeuroML">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>Java-based toolchain for NeuroML/LEMS model validation, simulation, and export to multiple simulator backends including NEURON, NEST, and Brian2.</terms:description>
        <terms:license>LGPL-3.0-only</terms:license>
        <schema:codeRepository>https://github.com/NeuroML/jNeuroML</schema:codeRepository>
        <schema:url>https://docs.neuroml.org/Userdocs/Software/jNeuroML.html</schema:url>
        <rdfs:label>jNeuroML</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/jaxley -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/jaxley">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>A differentiable simulator for biophysical neuron models built on JAX. Supports multi-compartment Hodgkin-Huxley models with automatic differentiation for gradient-based parameter inference.</terms:description>
        <terms:license>Apache-2.0</terms:license>
        <schema:codeRepository>https://github.com/jaxleyverse/jaxley</schema:codeRepository>
        <schema:identifier>10.7554/eLife.99205</schema:identifier>
        <schema:url>https://jaxley.readthedocs.io</schema:url>
        <rdfs:label>jaxley</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/neuroConstruct -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/neuroConstruct">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>A graphical tool for constructing and simulating biologically realistic 3D neuronal networks with morphologically detailed cells. Exports to NEURON, GENESIS, and NeuroML.</terms:description>
        <terms:license>GPL-2.0-only</terms:license>
        <schema:codeRepository>https://github.com/NeuralEnsemble/neuroConstruct</schema:codeRepository>
        <schema:url>http://www.neuroconstruct.org</schema:url>
        <rdfs:label>neuroConstruct</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/neurolib -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/neurolib">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>A simulation framework for whole-brain neural mass models with built-in exploration, optimization, and fMRI/EEG forward-model support on empirical connectomes.</terms:description>
        <terms:license>MIT</terms:license>
        <schema:codeRepository>https://github.com/neurolib-dev/neurolib</schema:codeRepository>
        <schema:identifier>10.1007/s12559-021-09931-9</schema:identifier>
        <schema:url>https://neurolib-dev.github.io/</schema:url>
        <rdfs:label>neurolib</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/pyNeuroML -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/pyNeuroML">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>Python API and command-line tools for NeuroML/LEMS model creation, validation, visualization, and simulation via jNeuroML and direct simulator backends.</terms:description>
        <terms:license>LGPL-3.0-only</terms:license>
        <schema:codeRepository>https://github.com/NeuroML/pyNeuroML</schema:codeRepository>
        <schema:url>https://docs.neuroml.org/Userdocs/Software/pyNeuroML.html</schema:url>
        <rdfs:label>pyNeuroML</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/pynn_genn -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/pynn_genn">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>PyNN interface for the GeNN GPU simulator, enabling PyNN models to run on NVIDIA GPUs via the GeNN backend.</terms:description>
        <terms:license>GPL-2.0-only</terms:license>
        <schema:codeRepository>https://github.com/genn-team/pynn_genn</schema:codeRepository>
        <rdfs:label>pynn_genn</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/sPyNNaker -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/sPyNNaker">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>Software stack enabling PyNN models to execute on the SpiNNaker neuromorphic computing platform. Translates PyNN network descriptions into configurations for SpiNNaker&apos;s many-core ARM processors.</terms:description>
        <terms:license>GPL-3.0-only</terms:license>
        <schema:codeRepository>https://github.com/SpiNNakerManchester/sPyNNaker</schema:codeRepository>
        <schema:url>https://spinnakermanchester.github.io</schema:url>
        <rdfs:label>sPyNNaker</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/vbi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/vbi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>Virtual Brain Inference. Probabilistic inference toolkit for whole-brain models — multi-backend simulators (Numba, C++, CuPy, JAX, PyTorch, TVB kernels), a 40+ time-series feature library (statistical, spectral, FC/FCD, complexity, event-detection), and two parallel inference paths (SBI via sbi-toolkit SNPE/SNLE/SNRE with MAF/NSF, and a built-in autograd-based CDE with MDN/MAF estimators). Targets the inverse problem of mapping observed neuroimaging (EEG/MEG/fMRI) onto brain-model parameters.</terms:description>
        <terms:license>MIT</terms:license>
        <schema:codeRepository>https://github.com/ins-amu/vbi</schema:codeRepository>
        <schema:identifier>10.5281/zenodo.14795543</schema:identifier>
        <schema:url>https://vbi.readthedocs.io</schema:url>
        <rdfs:label>vbi</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/vbjax -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/vbjax">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <terms:description>JAX-based virtual brain library. Provides stochastic Heun integrators for ODE/SDE/DDE/SDDE, canonical neural-mass models (Jansen-Rit, Montbrio-Pazo-Roxin, BVEP, bilinear DCM, Dopa), BOLD/EEG monitors, delay-coupling helpers, a spherical-harmonic neural-field operator, and JAX-native parameter sweeps with gradient-based fitting and MCMC.</terms:description>
        <terms:license>Apache-2.0</terms:license>
        <schema:codeRepository>https://github.com/ins-amu/vbjax</schema:codeRepository>
        <schema:identifier>10.5281/zenodo.14204250</schema:identifier>
        <schema:url>https://github.com/ins-amu/vbjax</schema:url>
        <rdfs:label>vbjax</rdfs:label>
    </owl:NamedIndividual>
    


