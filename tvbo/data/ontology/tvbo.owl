                    <rdf:Description rdf:about="https://w3id.org/tvbo/ReductionType#none"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ReductionType#sum"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>ReductionType</rdfs:label>
        <skos:definition>Operations for reducing/aggregating values across dimensions</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ReductionType#max"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ReductionType#mean"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ReductionType#min"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ReductionType#none"/>
