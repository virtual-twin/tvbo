        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/f_i"/>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/m_i"/>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/n_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K11"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K12"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K21"/>
