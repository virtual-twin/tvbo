        <rdfs:label xml:lang="en">Multistable</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/Oscillatory">
        <rdfs:label xml:lang="en">Oscillatory</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/Quiescent">
        <rdfs:label xml:lang="en">Quiescent</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/SaddleNode">
        <skos:altLabel>saddle-node</skos:altLabel>
        <skos:altLabel>sn</skos:altLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/StrangeAttractor">
        <rdfs:label xml:lang="en">Strange attractor</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/SupercriticalHopf">
        <rdfs:label xml:lang="en">Supercritical Hopf</rdfs:label>
        <skos:altLabel>supercritical hopf</skos:altLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/Torus">
        <rdfs:label xml:lang="en">Torus</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/accelerator">
        <rdfs:label>accelerator (slot)</rdfs:label>
        <skos:definition>Hardware accelerator: &apos;cpu&apos;, &apos;gpu&apos;, &apos;tpu&apos;</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>accelerator</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/account">
        <rdfs:label>account (slot)</rdfs:label>
        <skos:definition>Accounting allocation to charge the tasks against (Slurm).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>account</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/acronym">
        <rdfs:label>acronym (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>acronym</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/affect_parameters">
        <rdfs:label>affect_parameters (slot)</rdfs:label>
        <skos:definition>Parameter symbols modifiable in the affect function.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>affect_parameters</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/affect_states">
        <rdfs:label>affect_states (slot)</rdfs:label>
        <skos:definition>State variable symbols modifiable in the affect function.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>affect_states</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/args">
        <rdfs:label>args (slot)</rdfs:label>
        <skos:definition>Ordered parameter names passed to the callable.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>args</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/authors">
        <rdfs:label>authors (slot)</rdfs:label>
        <skos:definition>Author display strings (full detail in references.bib).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>authors</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/average">
        <rdfs:label>average (slot)</rdfs:label>
        <skos:definition>Averaging mode across trials. &apos;trials&apos; = average over n_trials independent runs (evoked potential paradigm). None = return all trials.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>average</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/backend">
        <rdfs:label>backend (slot)</rdfs:label>
        <skos:definition>Execution backend this experiment runs on when no backend is passed explicitly (e.g. &apos;tvboptim&apos;, &apos;tvb&apos;, &apos;jax&apos;, &apos;julia&apos;, &apos;brian2&apos;). Declares the engine the experiment requires — a spiking point-neuron network sets &apos;brian2&apos;, a mean-field model leaves it unset. run(format=...) and ``tvbo run --backend`` override it; when unset the default backend (tvboptim) is used.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>backend</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/bids_dir">
        <rdfs:label>bids_dir (slot)</rdfs:label>
        <skos:definition>Path to BEP017-compliant BIDS directory for loading connectivity matrices</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>bids_dir</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/category">
        <rdfs:label>category (slot)</rdfs:label>
        <skos:definition>Coarse classification of the phenotype bundle, used for filtering in larger study libraries. Canonical values: ``cognitive`` (intelligence / memory / attention scores), ``clinical`` (UPDRS, MMSE, …), ``behavioral`` (raw task outputs), ``demographic``, ``physiological``, ``derived`` (composite scores like g-factor or brain-age). Free string — extend as needed.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>category</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/citekey">
        <rdfs:label>citekey (slot)</rdfs:label>
        <skos:definition>BibTeX citation key; the join key into references.bib for full bibliographic detail. A study is identified by its key/citekey and described by its title — no ``name`` needed.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>citekey</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/code_modules">
        <rdfs:label>code_modules (slot)</rdfs:label>
        <skos:definition>Importable module names whose import registers this figure&apos;s custom panels / transforms (via bsplot.register_panel / register_transform). The emitted plot.py imports them, so a study ships its bespoke figure code in its code_source instead of in core tvbo. The modules must be importable when the figure renders (loading the study puts its code/ dir on the path).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>code_modules</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/colormap">
        <rdfs:label>colormap (slot)</rdfs:label>
        <skos:definition>Named colormap (routed through the cmap resolver).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>colormap</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/comment">
        <rdfs:label>comment (slot)</rdfs:label>
        <skos:definition>Free-text provenance tag on each submitted job (Slurm ``--comment``), visible in ``squeue -o %k``. Unset means an auto-generated ``tvbo:&lt;study&gt;/exp_&lt;experiment&gt;`` tag so a queued job maps back to its experiment; set it to override with a custom string.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>comment</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/concept_iri">
        <rdfs:label>concept_iri (slot)</rdfs:label>
        <skos:definition>Cognitive Atlas IRI of the cognitive construct measured (e.g. ``cogat:trm_521ef89ce5e84`` for fluid intelligence).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>concept_iri</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/condition_parameters">
        <rdfs:label>condition_parameters (slot)</rdfs:label>
        <skos:definition>Parameter symbols accessible in the condition function.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>condition_parameters</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/condition_states">
        <rdfs:label>condition_states (slot)</rdfs:label>
        <skos:definition>State variable symbols accessible in the condition function. For edges, can include source/destination vertex outputs.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>condition_states</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/connectivity_ref">
        <rdfs:label>connectivity_ref (slot)</rdfs:label>
        <skos:definition>Reference to connectivity data (_conndata-network_connectivity.tsv).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>connectivity_ref</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/container">
        <rdfs:label>container (slot)</rdfs:label>
        <skos:definition>Container image wrapping each task; tasks run as ``&lt;runtime&gt; exec &lt;image&gt; …``. A concrete image passes through as given — either a registry reference the engine resolves and materialises itself (``docker://…:tag``) or a path to an image file already built on the target, which pins the exact image and needs no pull. A reference that leaves the version open is resolved to the tvbo image matching the running CLI: the symbolic value ``tvbo``, or a tvbo registry reference with no ``:tag``. Left unset while ``requirements`` are declared, the base still defaults to that tvbo image (the deps layer onto it); unset with no requirements, tasks run bare.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>container</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/container_args">
        <rdfs:label>container_args (slot)</rdfs:label>
        <skos:definition>Additional arguments passed verbatim to the container runtime when it executes a task. The extension point for runtime flags the typed fields do not cover, mirroring ``WorkflowEngineConfig.options`` for scheduler directives.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>container_args</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/container_binds">
        <rdfs:label>container_binds (slot)</rdfs:label>
        <skos:definition>Host paths that must be visible inside the container beyond the ones its runtime binds by default (typically ``$HOME`` and the working directory). Required whenever a task reads or writes a site filesystem outside those defaults — a shared cache, a data tree, or a scratch area a symlink resolves into. Rendered into each runtime&apos;s own flag (``--bind`` for Apptainer/Singularity).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>container_binds</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/curvature">
        <rdfs:label>curvature (slot)</rdfs:label>
        <skos:definition>Optional path to per-vertex curvature (N,) float. Default convention: ``mesh/curvature``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>curvature</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dataset_id">
        <rdfs:label>dataset_id (slot)</rdfs:label>
        <skos:definition>Unique identifier for this phenotype bundle.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>dataset_id</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/datatype">
        <rdfs:label>datatype (slot)</rdfs:label>
        <skos:definition>Declared value type of this parameter, given as a schema range name — a primitive (``integer``, ``float``, ``string``, ``uriorcurie``) or a class (e.g. ``Distribution``). Documents the expected type when the parameter is a *declaration* carrying no concrete ``value`` (e.g. a GraphGenerator&apos;s typed argument interface). Distinct from ``domain`` (numeric bounds) and ``unit``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>datatype</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/date_created">
        <rdfs:label>date_created (slot)</rdfs:label>
        <skos:definition>ISO 8601 (prov:generatedAtTime)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>date_created</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/default">
        <rdfs:label>default (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>default</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/definition">
        <rdfs:label>definition (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>definition</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/derived_from">
        <rdfs:label>derived_from (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>derived_from</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/desc">
        <rdfs:label>desc (slot)</rdfs:label>
        <skos:definition>BIDS desc- entity (e.g., FCavg, SC), for disambiguating derived data variants</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>desc</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/description">
        <rdfs:label>description (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>description</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/descriptor">
        <rdfs:label>descriptor (slot)</rdfs:label>
        <skos:definition>Short alphanumeric identifier for the BIDS desc- filename entity (e.g., SC, FC, EC, SCFC). Classifies the connectivity modality of the network&apos;s edge measures.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>descriptor</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/detail">
        <rdfs:label>detail (slot)</rdfs:label>
        <skos:definition>Non-visual grouping dim (e.g. the hue/iterate dim).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>detail</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dimension_labels">
        <rdfs:label>dimension_labels (slot)</rdfs:label>
        <skos:definition>Ordered labels for the matrix columns (dim-1) when the matrix is non-square.  Row labels (dim-0) are the parent Network&apos;s node labels.  Stored as HDF5 dimension scales in the companion file.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>dimension_labels</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/direction">
        <rdfs:label>direction (slot)</rdfs:label>
        <skos:definition>Exceedance direction: ``greater_equal`` (fraction of permutations whose statistic ≥ the observed) or ``less_equal`` (one-sided negative test).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>direction</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/doi">
        <rdfs:label>doi (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>doi</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/elements">
        <rdfs:label>elements (slot)</rdfs:label>
        <skos:definition>Topology indices: either a file reference, or (when inlined on a Network) a dotted path inside the parent Network&apos;s h5 companion to the (M, 3) int triangle face array. Default convention: ``mesh/faces``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>elements</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/equation_type">
        <rdfs:label>equation_type (slot)</rdfs:label>
        <skos:definition>How to interpret ``equation.rhs`` when advancing this state: &apos;differential&apos; (default) integrates it as ``dx/dt = rhs``; &apos;algebraic&apos; is a constraint ``0 = rhs`` / ``x ~ rhs`` (DAE); &apos;recurrence&apos; is a discrete per-step update ``x_next = rhs`` (no integrator applied), used by an observation&apos;s auxiliary ``dynamics`` for online reductions/accumulators (e.g. a running sum ``x_next = x + f``) — the symbolic, backend-independent sibling of the continuous &apos;differential&apos; form. Algebraic equations are used by ModelingToolkit.jl backend.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>equation_type</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/executor">
        <rdfs:label>executor (slot)</rdfs:label>
        <skos:definition>Executor to run the pipeline through (Nextflow process.executor).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>executor</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/experiment">
        <rdfs:label>experiment (slot)</rdfs:label>
        <skos:definition>WHERE (short form): an in-study experiment id whose saved result holds the array, resolved within the enclosing study like ``initial_state.source_experiment``. Mutually exclusive with ``iri`` (the full cross-study / curated / external form). When both are absent the reference is local — ``output`` names this experiment&apos;s own output — otherwise falling back to ``initial_state.source_experiment`` when present.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/common"/>
        <skos:notation>experiment</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/experiment_yaml_hash">
        <rdfs:label>experiment_yaml_hash (slot)</rdfs:label>
        <skos:definition>SHA-256 hex digest of the normalised experiment YAML that produced this artifact. Used by the cross-experiment cache (see :class:`SimulationStudy.from_file`) to detect when a cached upstream result has gone stale because the experiment&apos;s spec was edited. Computed as ``hashlib.sha256(yaml.safe_dump(normalized_yaml).encode()).hexdigest()`` over the fully resolved (post-``!include``) experiment block.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>experiment_yaml_hash</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/extension">
        <rdfs:label>extension (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>extension</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/generated_by">
        <rdfs:label>generated_by (slot)</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
        <skos:definition>Software/agent identifier: the prov:Agent this artifact is attributed to.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>generated_by</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/geometry">
        <rdfs:label>geometry (slot)</rdfs:label>
        <skos:definition>Optional file for geometry/ROI mask (e.g., NIfTI, GIfTI).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>geometry</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/git">
        <rdfs:label>git (slot)</rdfs:label>
        <skos:definition>Git repository URL to fetch the code from (shallow-cloned and cached under ``~/.cache/tvbo/code_sources``). Mutually exclusive with ``path``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>git</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/gres">
        <rdfs:label>gres (slot)</rdfs:label>
        <skos:definition>Generic scheduler resources, e.g. &apos;gpu:1&apos; (Slurm --gres).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>gres</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/groups">
        <rdfs:label>groups (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>groups</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/has_reference">
        <rdfs:label>has_reference (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>has_reference</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/hash">
        <rdfs:label>hash (slot)</rdfs:label>
        <skos:definition>SHA-256 hex digest of the file at fingerprinting (recomputed lazily when mtime/size differ).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>hash</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/hemi">
        <rdfs:label>hemi (slot)</rdfs:label>
        <skos:definition>BIDS hemi- entity (L or R) for hemisphere-specific surface/volume data</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>hemi</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/interpolation">
        <rdfs:label>interpolation (slot)</rdfs:label>
        <skos:definition>Interpolation for a data-driven stimulus: &apos;linear&apos; or &apos;cubic&apos;.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>interpolation</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/keys">
        <rdfs:label>keys (slot)</rdfs:label>
        <skos:definition>Named keys for multi-dimensional coupling. When dimension &gt; 1, provides symbolic names for each index (e.g., keys: [lre, ffi] for dimension: 2). Used in equations as variable names.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>keys</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/label">
        <rdfs:label>label (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>label</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/labels_dimensions">
        <rdfs:label>labels_dimensions (slot)</rdfs:label>
        <skos:definition>Mapping of dimension names to their labels (JSON-encoded dict).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>labels_dimensions</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/labels_ordering">
        <rdfs:label>labels_ordering (slot)</rdfs:label>
        <skos:definition>Ordering of dimensions: Time, State Variable, Space, Mode.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>labels_ordering</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/layout">
        <rdfs:label>layout (slot)</rdfs:label>
        <skos:definition>bsplot mosaic string; letters = panel keys, slash (or newline) = new row, repeated letters span cells, dot = empty. e.g. aab/ccb.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>layout</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/learning_rate_schedule">
        <rdfs:label>learning_rate_schedule (slot)</rdfs:label>
        <skos:definition>Learning rate schedule: &apos;constant&apos;, &apos;linear&apos;, &apos;exponential&apos;</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>learning_rate_schedule</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/lhs">
        <rdfs:label>lhs (slot)</rdfs:label>
        <skos:altLabel>lefthandside</skos:altLabel>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>lhs</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/library">
        <rdfs:label>library (slot)</rdfs:label>
        <skos:definition>Native library/module providing the callable.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>library</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/license">
        <rdfs:label>license (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>license</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/loc">
        <rdfs:label>loc (slot)</rdfs:label>
        <skos:definition>Named corner (&apos;upper right&apos;, &apos;upper left&apos;, &apos;center&apos;, ...) as an alternative to x/y.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>loc</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/mail_type">
        <rdfs:label>mail_type (slot)</rdfs:label>
        <skos:definition>Scheduler notification trigger (e.g. &apos;END,FAIL&apos;).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>mail_type</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/mail_user">
        <rdfs:label>mail_user (slot)</rdfs:label>
        <skos:definition>Notification email address.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>mail_user</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/measure">
        <rdfs:label>measure (slot)</rdfs:label>
        <skos:definition>WHICH array to select out of `source`. The address space is the source&apos;s own: a per-node measure name for a Network (aligning with Network.structural_measures / observational_measures), a dataset key for an HDF5/Zarr store, a recorded measure for an experiment result. Omit when the source resolves to a single array.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>measure</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/measure_type">
        <rdfs:label>measure_type (slot)</rdfs:label>
        <skos:definition>Sub-type within the phenotype (e.g. &apos;raw&apos;, &apos;unadjusted&apos;, &apos;age-corrected&apos;, &apos;derived&apos;, &apos;RT&apos;, &apos;accuracy&apos;).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>measure_type</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/measures">
        <rdfs:label>measures (slot)</rdfs:label>
        <skos:definition>Names of the measures present in the h5 companion (one ``measures/&lt;name&gt;`` dataset per name). Example: ``[g_factor, PMAT24_A_CR, PMAT24_A_RTCR, CardSort_Unadj, ProcSpeed_Unadj]``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>measures</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/mem">
        <rdfs:label>mem (slot)</rdfs:label>
        <skos:definition>Memory per task in scheduler syntax (e.g. &apos;16G&apos;).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>mem</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/mesh_file">
        <rdfs:label>mesh_file (slot)</rdfs:label>
        <skos:definition>Path to external mesh file (GIFTI, VTK, MSH, FreeSurfer, etc.).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>mesh_file</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/mesh_format">
        <rdfs:label>mesh_format (slot)</rdfs:label>
        <skos:definition>Explicit format override (gifti, freesurfer, meshio, vtk, gmsh). Auto-detected from extension if null.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>mesh_format</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/model_equation_ref">
        <rdfs:label>model_equation_ref (slot)</rdfs:label>
        <skos:definition>BIDS ModelEq reference: path to _eq.xml LEMS file.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>model_equation_ref</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/model_param_ref">
        <rdfs:label>model_param_ref (slot)</rdfs:label>
        <skos:definition>BIDS ModelParam reference: path to _param.xml LEMS file.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>model_param_ref</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/module">
        <rdfs:label>module (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>module</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/modules">
        <rdfs:label>modules (slot)</rdfs:label>
        <skos:definition>Environment modules to load before running (module load …).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>modules</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/name">
        <rdfs:label>name (slot)</rdfs:label>
        <skos:definition>Globally unique identifier for the entity.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/common"/>
        <skos:notation>name</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/node_mapping">
        <rdfs:label>node_mapping (slot)</rdfs:label>
        <skos:definition>HDF5 dataset path for node-to-parent mapping. Int32 array of shape (N,) where entry i is the parent node ID. Required when parent_network is set.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>node_mapping</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/noise_type">
        <rdfs:label>noise_type (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>noise_type</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/normals">
        <rdfs:label>normals (slot)</rdfs:label>
        <skos:definition>Optional path inside the parent Network&apos;s h5 (or an external file) to per-vertex normals (N, 3) float. Default convention: ``mesh/normals``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>normals</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/objectives">
        <rdfs:label>objectives (slot)</rdfs:label>
        <skos:definition>Names of observations minimised by an adaptive `strategy` (e.g. &apos;nsga2&apos;). Each entry references an existing observation already framed lower-is-better (e.g. `one_minus_fc`, `psd_mae`). Count sets the semantics: 0 → pure sweep (use `record`), 1 → single-objective, ≥2 → multi-objective / Pareto. Ignored when strategy is &apos;grid&apos;. Forward-compatible with `Search.objectives`.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>objectives</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/observational_measures">
        <rdfs:label>observational_measures (slot)</rdfs:label>
        <skos:definition>BEP017 measure names for observational targets (e.g., BoldCorrelation)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>observational_measures</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/of">
        <rdfs:label>of (slot)</rdfs:label>
        <skos:definition>Name of the input this step consumes — the positions for `pairwise_distance` / `distribution_pdf`, the matrix for `normalize`, the compared quantity for `stochastic_mask`, and for `sample` (which consumes no array) the Distribution-valued generator parameter to draw from. It names either a previously defined step or a generator parameter; steps are ordered, so a referenced step must already be defined.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>of</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/on_region">
        <rdfs:label>on_region (slot)</rdfs:label>
        <skos:definition>Mesh/atlas subset where BC applies.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>on_region</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/out_dir">
        <rdfs:label>out_dir (slot)</rdfs:label>
        <skos:definition>Output directory template. ``{study}`` and ``{experiment}`` are substituted with the study and experiment keys at emit time. Unset means ``out/{study}/{experiment}``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>out_dir</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/outsym">
        <rdfs:label>outsym (slot)</rdfs:label>
        <skos:definition>Output symbol names for the edge model. E.g. [&apos;P&apos;] for a scalar power flow, [&apos;Fx&apos;, &apos;Fy&apos;] for 2D forces. Maps directly to outsym in ND.jl EdgeModel. If not specified, derived from coupling variables of the connected vertex dynamics.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>outsym</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/panel_key">
        <rdfs:label>panel_key (slot)</rdfs:label>
        <skos:definition>Mosaic label this panel binds to (matches a letter in Figure.layout).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>panel_key</skos:notation>
        <tvbo:collection_key rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</tvbo:collection_key>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/panel_number_format">
        <rdfs:label>panel_number_format (slot)</rdfs:label>
        <skos:definition>Python format string applied to each panel letter: &apos;{}&apos; -&gt; &apos;a&apos;, &apos;({})&apos; -&gt; &apos;(a)&apos;, &apos;{}.&apos; -&gt; &apos;a.&apos;. Defaults to &apos;{}&apos;. Match the target journal&apos;s convention.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>panel_number_format</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/parcel_map_field">
        <rdfs:label>parcel_map_field (slot)</rdfs:label>
        <skos:definition>When the mesh is inlined on a Network with a parcellation, the dotted path inside the parent&apos;s h5 to the per-vertex parcel id array. Default: ``nodes/parent_index``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>parcel_map_field</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/parent_network">
        <rdfs:label>parent_network (slot)</rdfs:label>
        <skos:definition>Path/URI to parent (coarser) Network. When set, this network is a refinement where each node maps to exactly one parent node via node_mapping.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>parent_network</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/partition">
        <rdfs:label>partition (slot)</rdfs:label>
        <skos:definition>Scheduler partition to submit to (Slurm).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>partition</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/permutations">
        <rdfs:label>permutations (slot)</rdfs:label>
        <skos:definition>Name of the observer parameter holding the fixed ``(n_perm, n)`` permutation- index array (a produced/sourced constant, reused across the window and grid).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>permutations</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/permute">
        <rdfs:label>permute (slot)</rdfs:label>
        <skos:definition>The symbol whose entries are permuted (the observation source, or a parameter such as an in-strength vector).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>permute</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/placeholder">
        <rdfs:label>placeholder (slot)</rdfs:label>
        <skos:definition>Honest-placeholder text drawn when this panel&apos;s data is missing or degenerate (never a source-replot). Setting it wraps the draw so a missing container falls back to this label instead of erroring.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>placeholder</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/precision">
        <rdfs:label>precision (slot)</rdfs:label>
        <skos:definition>Floating point precision: &apos;float32&apos; or &apos;float64&apos;</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>precision</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/preconditioner">
        <rdfs:label>preconditioner (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>preconditioner</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/primary_weight">
        <rdfs:label>primary_weight (slot)</rdfs:label>
        <skos:definition>Name of the edge group that should serve as the canonical weights matrix when ``weights_matrix`` is queried. Lets a single Network sidecar bundle several connectivity variants (e.g. band-specific NMF reweightings, distance-modulated SC, shuffled controls) under different edge names while still presenting one of them as the active weight to consumers (simulators, observation pipelines). Defaults to ``weight`` / ``weights`` / ``sc`` lookup when not set.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>primary_weight</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/processing_pipeline">
        <rdfs:label>processing_pipeline (slot)</rdfs:label>
        <skos:definition>Processing pipeline used to generate the tractography</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>processing_pipeline</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/quantity_kind">
        <rdfs:label>quantity_kind (slot)</rdfs:label>
        <skos:definition>Scalar, vector, or tensor.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>quantity_kind</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/queue">
        <rdfs:label>queue (slot)</rdfs:label>
        <skos:definition>Scheduler queue for the executor (Nextflow process.queue).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>queue</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/reconstruction">
        <rdfs:label>reconstruction (slot)</rdfs:label>
        <skos:definition>BIDS rec- entity (e.g., dTOR)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>reconstruction</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/record">
        <rdfs:label>record (slot)</rdfs:label>
        <skos:definition>Names of observations to compute and record at EACH grid point, stacked over the sweep into one array per name. Entries may be derived observations (e.g. `loss`) or `analysis` diagnostics (e.g. `ad_gradient`, `fd_gradient`, `lyapunov`) — this is how a sweep of the diagnostics themselves is declared, replacing any per-point Python driver. Complementary to `observable` (a single scalar reduction); when both are absent the full observation Bunch is recorded.</skos:definition>
        <skos:definition>Whether to include this element in simulation output files. Applicable to state variables (default true), derived variables (default false), and network nodes (default true). On an observation it forces (true) or suppresses (false) persistence in the result; left unset, a terminal observation (one not consumed by another observation or a loss) is recorded and an intermediate one is not. Set false to suppress recording.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>record</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/ref">
        <rdfs:label>ref (slot)</rdfs:label>
        <skos:definition>Git branch, tag, or commit to check out (``git`` sources only). Defaults to the repository&apos;s default branch.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>ref</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/reference">
        <rdfs:label>reference (slot)</rdfs:label>
        <skos:definition>Publication or DOI reference for this tractography dataset</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>reference</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/references">
        <rdfs:label>references (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>references</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/render">
        <rdfs:label>render (slot)</rdfs:label>
        <skos:definition>Name of a registered custom-panel callable fn(container, ax, **opts) (custom kind).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>render</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/rhs">
        <rdfs:label>rhs (slot)</rdfs:label>
        <skos:altLabel>righthandside</skos:altLabel>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>rhs</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/rng">
        <rdfs:label>rng (slot)</rdfs:label>
        <skos:definition>Random-seed policy across shards. ``deterministic`` (the default when unset) derives each task&apos;s seed from its shard index so the fan-out is reproducible.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>rng</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/sampler">
        <rdfs:label>sampler (slot)</rdfs:label>
        <skos:definition>MCMC sampler (&apos;nuts&apos;). Each backend maps its own way.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>sampler</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/sampling_period_unit">
        <rdfs:label>sampling_period_unit (slot)</rdfs:label>
        <skos:definition>Unit of the sampling period (e.g., &apos;ms&apos;, &apos;s&apos;).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>sampling_period_unit</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/scale">
        <rdfs:label>scale (slot)</rdfs:label>
        <skos:definition>BIDS scale- entity (BEP017, e.g., 1000)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>scale</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/segmentation">
        <rdfs:label>segmentation (slot)</rdfs:label>
        <skos:definition>BIDS seg- entity (e.g., ordered, ranked, 17Networks)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>segmentation</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/session_id">
        <rdfs:label>session_id (slot)</rdfs:label>
        <skos:definition>BIDS session identifier.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>session_id</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/setup">
        <rdfs:label>setup (slot)</rdfs:label>
        <skos:definition>Shell lines run verbatim before the task command, after ``set -euo pipefail`` and any module/venv activation. The general hook for environment setup the typed fields do not cover, e.g. activating a conda env (``conda activate &lt;name&gt;``), sourcing a profile, or exporting a computed path. Ordered; each line is emitted as-is.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>setup</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/source">
        <rdfs:label>source (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>source</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/source_branch">
        <rdfs:label>source_branch (slot)</rdfs:label>
        <skos:definition>Name of a previously computed branch (for from_branch method).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>source_branch</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/source_network">
        <rdfs:label>source_network (slot)</rdfs:label>
        <skos:definition>Path or name of the Network whose nodes define the source endpoints of this Edge. Symmetric counterpart to `target_network`. Together they let an Edge bridge any two Networks: both unset (within-Network edge), one set (this Network ↔ the named one), or both set (peer-to-peer projection between two other Networks). Accepts either an absolute IRI (peer Network) or the relative-path sentinel `parent` / `parent/parent` (cross-scale up/down via the Node.subnetwork hierarchy).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>source_network</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/source_var">
        <rdfs:label>source_var (slot)</rdfs:label>
        <skos:altLabel>source_variable</skos:altLabel>
        <skos:definition>Output variable from source node to use (e.g., &apos;x_out&apos;). If not specified, uses first output variable from source dynamics. The alias `source_variable` is accepted (harmonized with the `*_variable` spelling used elsewhere, e.g. the stimulus event&apos;s `target_variable`).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>source_var</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/spines">
        <rdfs:label>spines (slot)</rdfs:label>
        <skos:definition>Axes spine style: &apos;box&apos; (all 4 spines, closed boxes — e.g. Taher) or &apos;open&apos; (left+bottom only). Unset defers to the active style. Pair &apos;box&apos; with auto_format: false — bsplot&apos;s format_fig otherwise detaches and trims spines (the open &apos;nature&apos; look).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>spines</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/strategy">
        <rdfs:label>strategy (slot)</rdfs:label>
        <skos:definition>Search strategy over the decision space (the `space` axes). &apos;grid&apos; (default) exhaustively evaluates the Cartesian/zip grid of axis points — today&apos;s behaviour. &apos;nsga2&apos; runs an adaptive multi-objective genetic search (pymoo NSGA-II) that returns the non-dominated Pareto front over `objectives`; axes then supply only decision-variable bounds (domain lo/hi), and per-strategy hyper-parameters (population_size, num_generations, seed, reference_point) live in `parameters`. Extensible later to &apos;random&apos; / &apos;sobol&apos; / &apos;cmaes&apos;. Forward-compatible with the planned unified `Search.strategy` (see dev/unified_search.md).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>strategy</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/structural_measures">
        <rdfs:label>structural_measures (slot)</rdfs:label>
        <skos:definition>BEP017 measure names for structural connectivity (e.g., streamlineCount, tractLength)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>structural_measures</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/subdir">
        <rdfs:label>subdir (slot)</rdfs:label>
        <skos:definition>Subdirectory within the source to place on the import path (defaults to the source root).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>subdir</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/subject_id">
        <rdfs:label>subject_id (slot)</rdfs:label>
        <skos:definition>BIDS subject identifier.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>subject_id</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/subjects">
        <rdfs:label>subjects (slot)</rdfs:label>
        <skos:definition>Ordered list of subject IDs (e.g. HCP-YA 6-digit IDs). Each ``measures/&lt;name&gt;`` array in the h5 companion is indexed by this order.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>subjects</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/suffix">
        <rdfs:label>suffix (slot)</rdfs:label>
        <skos:definition>BIDS suffix (e.g., relmat), the trailing name component before the extension</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>suffix</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/symbol">
        <rdfs:label>symbol (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>symbol</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/symmetry">
        <rdfs:label>symmetry (slot)</rdfs:label>
        <skos:definition>Edge symmetry type for NetworkDynamics.jl EdgeModel: &apos;directed&apos; (default), &apos;antisymmetric&apos;, or &apos;symmetric&apos;. AntiSymmetric edges flip sign for the reverse direction.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>symmetry</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/target_component">
        <rdfs:label>target_component (slot)</rdfs:label>
        <skos:definition>Component to attach this event to. Can be a node label, edge label, or &apos;all_edges&apos;/&apos;all_vertices&apos; for broadcast. If not specified, event is experiment-level.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>target_component</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/target_network">
        <rdfs:label>target_network (slot)</rdfs:label>
        <skos:definition>Path or name of the Network whose nodes define the target endpoints (e.g. the columns of a non-square projection matrix such as a gain matrix region → EEG sensors). Also accepts the relative-path sentinel `parent` / `parent/parent` for cross-scale signal flow up the Node.subnetwork hierarchy. One mechanism handles both projection matrices (absolute IRI) and multi-scale boundaries (sentinel).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>target_network</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/target_regions">
        <rdfs:label>target_regions (slot)</rdfs:label>
        <skos:definition>Regions a stimulus-type event targets: &apos;all&apos; (broadcast to every node) or explicit region labels / indices. More expressive than the integer-only `regions` slot; when both are absent the event applies to all regions.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>target_regions</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/target_var">
        <rdfs:label>target_var (slot)</rdfs:label>
        <skos:altLabel>target_variable</skos:altLabel>
        <skos:definition>Input variable on target node to connect to (e.g., &apos;c_in&apos;). If not specified, uses first coupling input from target dynamics. The alias `target_variable` is accepted.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>target_var</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/task_iri">
        <rdfs:label>task_iri (slot)</rdfs:label>
        <skos:definition>Cognitive Atlas (``cogat:``) IRI of the assessment instrument / task that produced this measure (e.g. ``cogat:trm_4a3fd79d09cba`` for PMAT24).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>task_iri</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/task_name">
        <rdfs:label>task_name (slot)</rdfs:label>
        <skos:definition>BIDS task name for the simulation (e.g., &apos;rest&apos;, &apos;simulation&apos;).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>task_name</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/template">
        <rdfs:label>template (slot)</rdfs:label>
        <skos:definition>BIDS tpl- entity (e.g., FSLMNI152, MNI152NLin2009cAsym)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>template</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/text">
        <rdfs:label>text (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>text</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/title">
        <rdfs:label>title (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>title</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/unit">
        <rdfs:label>unit (slot)</rdfs:label>
        <skos:definition>Physical unit of measurement. Values are drawn from the QUDT ontology (http://qudt.org/vocab/unit/) with UO cross-references where available.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>unit</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/value">
        <rdfs:label>value (slot)</rdfs:label>
        <skos:definition>Numeric, string, or boolean value, OR an array (nested list) for array-valued constants such as mode-coupling coefficient matrices. ScalarValue accepts any literal primitive type, allowing parameters to carry control flags (e.g., booleans) or symbolic placeholders alongside numeric defaults.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>value</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/vectorize">
        <rdfs:label>vectorize (slot)</rdfs:label>
        <skos:definition>Axis names or parameters to pack into a single vectorized backend call. It is an error to name an axis the backend cannot batch.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>vectorize</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/venv">
        <rdfs:label>venv (slot)</rdfs:label>
        <skos:definition>Path to a virtual environment to activate before running.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>venv</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/vertices_field">
        <rdfs:label>vertices_field (slot)</rdfs:label>
        <skos:definition>When the mesh is inlined on a Network, the dotted path inside the parent&apos;s h5 to vertex coordinates. Default: ``nodes/coordinates``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>vertices_field</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/wrt">
        <rdfs:label>wrt (slot)</rdfs:label>
        <skos:definition>Quantity/quantities the analysis is taken with respect to, e.g. a parameter &apos;c_sigmJR.G&apos; for a gradient/sensitivity. Omitted for analyses that need no explicit differentiation target.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>wrt</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/z">
        <rdfs:label>z (slot)</rdfs:label>
        <skos:definition>Depth channel for a line3d panel (the third phase-space axis); ignored by 2-D kinds.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <skos:notation>z</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/acronym">
