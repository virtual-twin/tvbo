                    <rdf:Description rdf:about="https://w3id.org/tvbo/StandardGraphType#Star"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/StandardGraphType#WattsStrogatz"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/StandardGraphType#WeightShuffle"/>
