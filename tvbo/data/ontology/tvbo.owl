    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/model">
        <rdfs:range rdf:resource="https://w3id.org/tvbo/Dynamics"/>
        <rdfs:label>model (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>model</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/modelsAnatomicalRegion -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/modelsAnatomicalRegion">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
