        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>modality</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/mode -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/mode"/>
    


