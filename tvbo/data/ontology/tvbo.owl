    <!-- https://w3id.org/tvbo/evict_equation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/evict_equation">
        <rdfs:label>evict_equation (slot)</rdfs:label>
        <skos:definition>Optional reverse recurrence for a **sliding-window** reduction: the per-step downdate that removes the sample leaving the window, the inverse of ``equation`` (which folds an arriving sample in). Only meaningful when ``equation_type: recurrence`` on an observation&apos;s auxiliary ``dynamics``. When present, the observer is a windowed reduction — its state is maintained by ``equation`` (add) and ``evict_equation`` (evict) and rebuilt exactly from the window on resync — rather than a cumulative accumulator over the whole trajectory (``equation`` alone). Absent for ordinary state variables and cumulative reductions.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>evict_equation</skos:notation>
    </owl:ObjectProperty>
    


