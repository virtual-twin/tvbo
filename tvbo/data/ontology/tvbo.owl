        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <terms:description>Position of the maximum slope of a sigmoid function [in         threshold units]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>b_i (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Position of the maximum slope of a sigmoid function [in
        threshold units]</skos:definition>
        <skos:notation>b_i</skos:notation>
    </owl:NamedIndividual>
    


