    <!-- https://w3id.org/tvbo/graph_generators/WeightShuffle/parameters/preserve -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/graph_generators/WeightShuffle/parameters/preserve">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Which structural property to hold fixed under permutation. Only `binary_mask` is implemented: keep the {0, nonzero} pattern and permute the weight values among their existing positions, so density and topology stay fixed while the weight-to-edge assignment is randomised. Any other value is rejected — a null model that silently controlled a different property than the one asked for would invalidate the comparison it exists to support.</terms:description>
        <rdfs:label>preserve (WeightShuffle parameter)</rdfs:label>
        <skos:notation>preserve</skos:notation>
    </owl:NamedIndividual>
    


