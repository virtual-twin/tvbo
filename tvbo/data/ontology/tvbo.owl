        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>c_e (WilsonCowan parameter)</rdfs:label>
        <skos:definition>The amplitude parameter for the excitatory response function</skos:definition>
        <skos:notation>c_e</skos:notation>
    </owl:NamedIndividual>
    


