            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>Likelihood</rdfs:label>
        <skos:definition>Observation model for Bayesian inference: p(data | sim(theta)). Points at the observation holding the data and specifies the noise family + scale. `name` is the noise family (default Normal); `source` uses the same referencing as `Observation.source`, so the observed data can come from this experiment&apos;s integration, an empirical network measure, or a runtime-bound array — one flexible hook, no data-loading path of its own.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/Likelihood"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


