        <rdfs:label xml:lang="en">models anatomical region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/modelsCellType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/modelsCellType">
