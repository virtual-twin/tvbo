            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>BranchSwitch</rdfs:label>
        <skos:definition>Specification for switching from a detected bifurcation point to a new branch (periodic orbits from Hopf, fold continuation, etc.). Each BranchSwitch says: &quot;from which special point on the parent branch, continue what kind of object, with what settings.&quot; Override parent solver settings via the inline continuation field — only explicitly set attributes take effect; everything else is inherited from the parent Continuation.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/BranchSwitch"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


