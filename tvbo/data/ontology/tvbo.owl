    <owl:Class rdf:about="https://w3id.org/tvbo/EnvironmentType#venv">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EnvironmentType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>venv (EnvironmentType)</rdfs:label>
        <skos:definition>Python virtual environment.</skos:definition>
        <skos:notation>venv</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/EventType#continuous -->

    <owl:Class rdf:about="https://w3id.org/tvbo/EventType#continuous">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>continuous (EventType)</rdfs:label>
        <skos:definition>Triggered when condition function crosses zero (root-finding). Maps to ContinuousCallback / ContinuousComponentCallback.</skos:definition>
        <skos:notation>continuous</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/EventType#discrete -->

    <owl:Class rdf:about="https://w3id.org/tvbo/EventType#discrete">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>discrete (EventType)</rdfs:label>
        <skos:definition>Triggered when condition function returns true (checked at each step). Maps to DiscreteCallback / DiscreteComponentCallback.</skos:definition>
        <skos:notation>discrete</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/EventType#preset_time -->

    <owl:Class rdf:about="https://w3id.org/tvbo/EventType#preset_time">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>preset_time (EventType)</rdfs:label>
        <skos:definition>Triggered at predetermined time points. Maps to PresetTimeCallback / PresetTimeComponentCallback.</skos:definition>
        <skos:notation>preset_time</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/EventType#stimulation -->

    <owl:Class rdf:about="https://w3id.org/tvbo/EventType#stimulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>stimulation (EventType)</rdfs:label>
        <skos:definition>Synonym of &apos;stimulus&apos; — a continuous time-dependent input signal injected into a target state variable across target regions. The codegen treats &apos;stimulation&apos; and &apos;stimulus&apos; identically.</skos:definition>
        <skos:notation>stimulation</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/EventType#stimulus -->

    <owl:Class rdf:about="https://w3id.org/tvbo/EventType#stimulus">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>stimulus (EventType)</rdfs:label>
        <skos:definition>Continuous time-dependent input signal (e.g., external current). Legacy Stimulus behavior.</skos:definition>
        <skos:notation>stimulus</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/GraphRepresentation#auto -->

    <owl:Class rdf:about="https://w3id.org/tvbo/GraphRepresentation#auto">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/GraphRepresentation"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>auto (GraphRepresentation)</rdfs:label>
        <skos:definition>Select by connection density: use the sparse representation when the adjacency is sparse enough that edge-wise evaluation is cheaper than the dense product, dense otherwise. Default. Lets the backend apply its own crossover without the recipe hard-coding a data structure.</skos:definition>
        <skos:notation>auto</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/GraphRepresentation#dense -->

    <owl:Class rdf:about="https://w3id.org/tvbo/GraphRepresentation#dense">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/GraphRepresentation"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>dense (GraphRepresentation)</rdfs:label>
        <skos:definition>Force the dense-adjacency representation. Preferred for densely connected or small networks, where dense linear algebra&apos;s constant-factor efficiency outweighs its nodes-squared scaling.</skos:definition>
        <skos:notation>dense</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/GraphRepresentation#sparse -->

    <owl:Class rdf:about="https://w3id.org/tvbo/GraphRepresentation#sparse">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/GraphRepresentation"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>sparse (GraphRepresentation)</rdfs:label>
        <skos:definition>Force the edge-list (sparse) representation. Preferred for large, sparsely connected networks (structural connectomes, power grids) where coupling cost then scales with the number of edges rather than nodes-squared.</skos:definition>
        <skos:notation>sparse</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Hemisphere#both -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Hemisphere#both">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Hemisphere"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>both (Hemisphere)</rdfs:label>
        <skos:altLabel>B</skos:altLabel>
        <skos:altLabel>LR</skos:altLabel>
        <skos:altLabel>bilateral</skos:altLabel>
        <skos:notation>both</skos:notation>
    </owl:Class>
    


