        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/JansenRit1995/parameters/v0"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/JansenRit1995/state_variables/y0"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/JansenRit1995/state_variables/y1"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/JansenRit1995/state_variables/y2"/>
