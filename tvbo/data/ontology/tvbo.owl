        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ImagingModality#MEG"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ImagingModality#SEEG"/>
    </owl:Class>
    


