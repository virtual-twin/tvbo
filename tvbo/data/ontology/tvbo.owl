        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/StandardGraphType#Grid"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/StandardGraphType#RandomRegular"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/StandardGraphType#RandomReservoir"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/StandardGraphType#Star"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/StandardGraphType#WattsStrogatz"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/StandardGraphType#WeightShuffle"/>
    </owl:Class>
    


