        <rdfs:label>NamedArray</rdfs:label>
        <skos:definition>A named numeric array. Used as a sidecar slot value where a schema-typed object (e.g. ``ExperimentResult.parameters``) holds multiple arrays addressable by name (``w_LRE``, ``w_FFI``, ``J_i``, ...). The actual numeric data lives in the companion ``.h5`` at ``parameters/&lt;name&gt;``; the YAML carries only the descriptor.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/NamedArray"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/NeimarkSacker -->

    <owl:Class rdf:about="https://w3id.org/tvbo/NeimarkSacker">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Bifurcation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasCodimension"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Codimension1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Torus (Neimark-Sacker) bifurcation of a limit cycle: a complex pair of Floquet multipliers crosses the unit circle, birthing an invariant torus.</rdfs:comment>
        <rdfs:label xml:lang="en">Neimark-Sacker</rdfs:label>
        <skos:altLabel>TR</skos:altLabel>
        <skos:altLabel>neimark sacker</skos:altLabel>
        <skos:altLabel>neimark-sacker</skos:altLabel>
        <skos:altLabel>ns</skos:altLabel>
        <skos:altLabel>torus</skos:altLabel>
        <skos:altLabel>tr</skos:altLabel>
        <tvbo:canonicalCode>TR</tvbo:canonicalCode>
    </owl:Class>
    


