        <rdfs:label>first (AggregationType)</rdfs:label>
        <skos:definition>First value in window</skos:definition>
        <skos:notation>first</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AggregationType#first_passage -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AggregationType#first_passage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AggregationType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>first_passage (AggregationType)</rdfs:label>
        <skos:definition>First-passage time index (per node): the first sample at which the source crosses the observation&apos;s `threshold` parameter (&gt;=), or the sample count if it never crosses. Backend-independent (argmax of the threshold-crossing). Multiply by the sampling step for a time.</skos:definition>
        <skos:notation>first_passage</skos:notation>
    </owl:Class>
    


