        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Kinetic parameter  that represents the decay times for NMDA synapses (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">100.0</schema:defaultValue>
        <rdfs:label>tau_e (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Kinetic parameter  that represents the decay times for NMDA synapses (Deco et al., 2014). Excitatory population NMDA decay time constant.</skos:definition>
        <skos:notation>tau_e</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/tau_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/tau_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0016917"/>
        <terms:description>Kinetic parameter that represents the decay times for inhibitory GABA synapses (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0016917"/>
        <rdfs:label>tau_i (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Kinetic parameter that represents the decay times for inhibitory GABA synapses (Deco et al., 2014).</skos:definition>
        <skos:notation>tau_i</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/w_p -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/w_p">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <terms:description>Excitatory population recurrence weight</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.4</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>w_p (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Excitatory population recurrence weight</skos:definition>
        <skos:notation>w_p</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/state_variables/S_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/state_variables/S_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <tvbo:lhs>Derivative(S_e, t)</tvbo:lhs>
        <tvbo:rhs>H_e*gamma_e*(1 - S_e) - S_e/tau_e</tvbo:rhs>
        <terms:description>State-variable of the Reduced WongWang_EI model (Deco et al</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>S_e (ReducedWongWangExcInh state variable)</rdfs:label>
        <skos:notation>S_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/state_variables/S_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/state_variables/S_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <tvbo:lhs>Derivative(S_i, t)</tvbo:lhs>
        <tvbo:rhs>H_i*gamma_i - S_i/tau_i</tvbo:rhs>
        <terms:description>State-variable of the Reduced WongWang_EI model (Deco et al</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>S_i (ReducedWongWangExcInh state variable)</rdfs:label>
        <skos:notation>S_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/H_x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/H_x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>H_x</tvbo:lhs>
        <tvbo:rhs>H(x)</tvbo:rhs>
        <terms:description>Average population firing rate H evaluated at the total synaptic input x.</terms:description>
        <rdfs:label>H_x (ReducedWongWangTvboptim derived variable)</rdfs:label>
        <skos:notation>H_x</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>x</tvbo:lhs>
        <tvbo:rhs>w*J_N*S + I_o + J_N*instant + J_N*delayed</tvbo:rhs>
        <terms:description>Total synaptic input current combining local recurrence, external input, and network coupling (instant and delayed) scaled by J_N.</terms:description>
        <rdfs:label>x (ReducedWongWangTvboptim derived variable)</rdfs:label>
        <skos:notation>x</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/I_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/I_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.34</schema:defaultValue>
        <rdfs:label>I_o (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Effective external input current to each cortical population. Default 0.34 nA sets the system in bistability (Hansen et al., 2015). Together with w, this is a key parameter for fitting functional connectivity.</skos:definition>
        <skos:notation>I_o</skos:notation>
        <tvbo:unit>nA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/J_N -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/J_N">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>NMDA synaptic coupling strength</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2609</schema:defaultValue>
        <rdfs:label>J_N (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>NMDA synaptic coupling strength. Scales both local recurrence and long-range network coupling inputs.</skos:definition>
        <skos:notation>J_N</skos:notation>
        <tvbo:unit>nA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Input gain parameter</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.27</schema:defaultValue>
        <rdfs:label>a (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Input gain parameter of the sigmoid transfer function H(x).</skos:definition>
        <skos:notation>a</skos:notation>
        <tvbo:unit>per_pC</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Input shift parameter</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.108</schema:defaultValue>
        <rdfs:label>b (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Input shift parameter of the sigmoid transfer function H(x).</skos:definition>
        <skos:notation>b</skos:notation>
        <tvbo:unit>kHz</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Scaling parameter</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">154.0</schema:defaultValue>
        <rdfs:label>d (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Scaling parameter of the sigmoid transfer function H(x).</skos:definition>
        <skos:notation>d</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Kinetic parameter</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.641</schema:defaultValue>
        <rdfs:label>gamma (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Kinetic parameter governing the rate of NMDA channel dynamics.</skos:definition>
        <skos:notation>gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/tau_s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/tau_s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>NMDA decay time constant</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">100.0</schema:defaultValue>
        <rdfs:label>tau_s (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>NMDA decay time constant for the synaptic gating variable S.</skos:definition>
        <skos:notation>tau_s</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/w -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/w">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Excitatory recurrence strength (local feedback)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema:defaultValue>
        <rdfs:label>w (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Local excitatory recurrence strength. Controls the positive feedback within each cortical population. Higher values increase local excitation and push the system toward higher firing rates.</skos:definition>
        <skos:notation>w</skos:notation>
        <tvbo:unit>dimensionless</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/state_variables/S -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/state_variables/S">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(S, t)</tvbo:lhs>
        <tvbo:rhs>-S/tau_s + (1 - S)*H(x)*gamma</tvbo:rhs>
        <terms:description>Average NMDA synaptic gating variable, representing the fraction of open NMDA channels at each network node.</terms:description>
        <rdfs:label>S (ReducedWongWangTvboptim state variable)</rdfs:label>
        <skos:notation>S</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Aik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Aik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:lhs>Aik</tvbo:lhs>
        <tvbo:rhs>0.5</tvbo:rhs>
        <terms:description>Excitatory-to-excitatory mode-coupling matrix derived from Gaussian quadrature over N(mu, sigma); computed offline at `update_derived_parameters`.</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>Aik (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>Aik</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Bik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Bik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:lhs>Bik</tvbo:lhs>
        <tvbo:rhs>0.5</tvbo:rhs>
        <terms:description>Inhibitory-to-excitatory mode-coupling matrix.</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>Bik (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>Bik</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Cik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Cik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:lhs>Cik</tvbo:lhs>
        <tvbo:rhs>0.5</tvbo:rhs>
        <terms:description>Excitatory-to-inhibitory mode-coupling matrix.</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>Cik (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>Cik</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/IE_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/IE_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <tvbo:lhs>IE_i</tvbo:lhs>
        <tvbo:rhs>0.0</tvbo:rhs>
        <terms:description>Per-mode constant excitatory input from the heterogeneity distribution.</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>IE_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>IE_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/II_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/II_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <tvbo:lhs>II_i</tvbo:lhs>
        <tvbo:rhs>0.0</tvbo:rhs>
        <terms:description>Per-mode constant inhibitory input from the heterogeneity distribution.</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>II_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>II_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/e_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/e_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>e_i</tvbo:lhs>
        <tvbo:rhs>1.0</tvbo:rhs>
        <terms:description>Per-mode cubic-coefficient projection for the excitatory subnetwork.</terms:description>
        <rdfs:label>e_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>e_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/f_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/f_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>f_i</tvbo:lhs>
        <tvbo:rhs>1.0</tvbo:rhs>
        <terms:description>Per-mode cubic-coefficient projection for the inhibitory subnetwork.</terms:description>
        <rdfs:label>f_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>f_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/m_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/m_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>m_i</tvbo:lhs>
        <tvbo:rhs>a</tvbo:rhs>
        <terms:description>Per-mode offset entering the eta dynamics.</terms:description>
        <rdfs:label>m_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>m_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/n_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/n_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>n_i</tvbo:lhs>
        <tvbo:rhs>a</tvbo:rhs>
        <terms:description>Per-mode offset entering the beta dynamics.</terms:description>
        <rdfs:label>n_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>n_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K11 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K11">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>K11 (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Internal coupling, excitatory to excitatory.</skos:definition>
        <skos:notation>K11</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K12 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K12">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.15</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>K12 (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Internal coupling, inhibitory to excitatory.</skos:definition>
        <skos:notation>K12</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K21 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K21">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.15</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>K21 (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Internal coupling, excitatory to inhibitory.</skos:definition>
        <skos:notation>K21</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.45</schema:defaultValue>
        <rdfs:label>a (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Heterogeneity scale parameter entering the m_i, n_i offsets.</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.9</schema:defaultValue>
        <rdfs:label>b (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>FitzHugh-Nagumo recovery decay rate.</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/mu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/mu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>mu (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Mean of the Gaussian heterogeneity distribution.</skos:definition>
        <skos:notation>mu</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/sigma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/sigma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.35</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>sigma (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Standard deviation of the Gaussian heterogeneity distribution.</skos:definition>
        <skos:notation>sigma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Timescale separation</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>tau (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Timescale separation between fast (xi, alpha) and slow (eta, beta) variables.</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:lhs>Derivative(alpha, t)</tvbo:lhs>
        <tvbo:rhs>tau*(alpha - f_i*alpha**3/3 - beta) + K21*(Cik*xi - alpha) + tau*(II_i + c_glob + local_coupling*xi)</tvbo:rhs>
        <terms:description>Inhibitory fast variable (per mode).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>alpha (StefanescuJirsa2D state variable)</rdfs:label>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/beta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/beta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:lhs>Derivative(beta, t)</tvbo:lhs>
        <tvbo:rhs>(alpha - b*beta + n_i)/tau</tvbo:rhs>
        <terms:description>Inhibitory slow recovery variable (per mode).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>beta (StefanescuJirsa2D state variable)</rdfs:label>
        <skos:notation>beta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:lhs>Derivative(eta, t)</tvbo:lhs>
        <tvbo:rhs>(xi - b*eta + m_i)/tau</tvbo:rhs>
        <terms:description>Excitatory slow recovery variable (per mode).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>eta (StefanescuJirsa2D state variable)</rdfs:label>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/xi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/xi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:lhs>Derivative(xi, t)</tvbo:lhs>
        <tvbo:rhs>tau*(xi - e_i*xi**3/3 - eta) + K11*(Aik*xi - xi) - K12*(Bik*alpha - xi) + tau*(IE_i + c_glob + local_coupling*xi)</tvbo:rhs>
        <terms:description>Excitatory fast variable (per mode).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>xi (StefanescuJirsa2D state variable)</rdfs:label>
        <skos:notation>xi</skos:notation>
    </owl:NamedIndividual>
    


