    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/state_variables/S_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/state_variables/S_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <tvbo:lhs>Derivative(S_e, t)</tvbo:lhs>
        <tvbo:rhs>H_e*gamma_e*(1 - S_e) - S_e/tau_e</tvbo:rhs>
        <terms:description>Excitatory population synaptic gating state-variable of the Deco Balanced Exc-Inh model (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>S_e (DecoBalancedExcInh state variable)</rdfs:label>
        <skos:notation>S_e</skos:notation>
    </owl:NamedIndividual>
    


