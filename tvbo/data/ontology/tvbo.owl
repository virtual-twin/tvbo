        <skos:notation>iV0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iV4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iV4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iV4).</terms:description>
        <schema:defaultValue>[0.35990947874643836, 1.1616503426964113, 0.3599094787464342]</schema:defaultValue>
        <rdfs:label>iV4 (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>iV4</skos:notation>
    </owl:NamedIndividual>
    


