        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Number of parameters that must be tuned for the bifurcation to occur generically.</rdfs:comment>
        <rdfs:label xml:lang="en">Codimension</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ColoredNoise -->

