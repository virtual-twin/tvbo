        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>left (Hemisphere)</rdfs:label>
        <skos:altLabel>L</skos:altLabel>
        <skos:altLabel>lh</skos:altLabel>
        <skos:notation>left</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Hemisphere#right -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Hemisphere#right">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Hemisphere"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>right (Hemisphere)</rdfs:label>
        <skos:altLabel>R</skos:altLabel>
        <skos:altLabel>rh</skos:altLabel>
        <skos:notation>right</skos:notation>
    </owl:Class>
    


