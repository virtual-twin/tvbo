                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ImagingModality#BOLD"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ImagingModality#EEG"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ImagingModality#IEEG"/>
