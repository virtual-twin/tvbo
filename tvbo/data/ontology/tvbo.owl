    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/FixedPoint">
        <rdfs:label xml:lang="en">Fixed point</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/HomoclinicBifurcation">
        <rdfs:comment xml:lang="en">Global bifurcation where a limit cycle collides with a saddle equilibrium, forming a homoclinic orbit of infinite period.</rdfs:comment>
        <rdfs:label xml:lang="en">Homoclinic</rdfs:label>
        <skos:altLabel>hom</skos:altLabel>
        <skos:altLabel>homoclinic</skos:altLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/Hopf">
        <rdfs:comment xml:lang="en">Andronov-Hopf: an equilibrium loses stability as a complex-conjugate eigenvalue pair crosses the imaginary axis, giving birth to a limit cycle.</rdfs:comment>
        <rdfs:label xml:lang="en">Hopf</rdfs:label>
        <skos:altLabel>HB</skos:altLabel>
        <skos:altLabel>andronov hopf</skos:altLabel>
        <skos:altLabel>andronov-hopf</skos:altLabel>
        <skos:altLabel>hb</skos:altLabel>
        <skos:altLabel>hopf</skos:altLabel>
        <skos:prefLabel xml:lang="en">Hopf</skos:prefLabel>
        <tvbo:canonicalCode>HB</tvbo:canonicalCode>
    </rdf:Description>
