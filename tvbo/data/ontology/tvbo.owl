    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iZU">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iZU).</terms:description>
        <schema:defaultValue>[-3.033148827134955, 1.3877787807814457e-17, 3.033148827134998]</schema:defaultValue>
        <rdfs:label>iZU (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>iZU</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iZV -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iZV">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iZV).</terms:description>
        <schema:defaultValue>[-3.033148827134955, 1.3877787807814457e-17, 3.033148827134998]</schema:defaultValue>
        <rdfs:label>iZV (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>iZV</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/mu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/mu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>mu (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>mu</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/sigma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/sigma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.35</schema:defaultValue>
        <rdfs:label>sigma (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>sigma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>tau (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(alpha, t)</tvbo:lhs>
        <tvbo:rhs>tau*(alpha - f_i*alpha**3/3 - beta) + K21*(mode_dot(xi, Cik) - alpha) + tau*(II_i + mode_sum(c_glob0) + local_coupling*xi)</tvbo:rhs>
        <rdfs:label>alpha (ReducedSetFitzHughNagumo state variable)</rdfs:label>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/beta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/beta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(beta, t)</tvbo:lhs>
        <tvbo:rhs>(alpha - b*beta + n_i)/tau</tvbo:rhs>
        <rdfs:label>beta (ReducedSetFitzHughNagumo state variable)</rdfs:label>
        <skos:notation>beta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(eta, t)</tvbo:lhs>
        <tvbo:rhs>(xi - b*eta + m_i)/tau</tvbo:rhs>
        <rdfs:label>eta (ReducedSetFitzHughNagumo state variable)</rdfs:label>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/xi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/xi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(xi, t)</tvbo:lhs>
        <tvbo:rhs>tau*(xi - e_i*xi**3/3 - eta) + K11*(mode_dot(xi, Aik) - xi) - K12*(mode_dot(alpha, Bik) - xi) + tau*(IE_i + mode_sum(c_glob0) + local_coupling*xi)</tvbo:rhs>
        <rdfs:label>xi (ReducedSetFitzHughNagumo state variable)</rdfs:label>
        <skos:notation>xi</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/A_ik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/A_ik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (A_ik).</terms:description>
        <schema:defaultValue>[[0.3328165811190223, 0.18525241779532714, 0.3328165811190241], [0.5984537933538554, 0.3331114447027479, 0.5984537933538587], [0.33281658111902046, 0.18525241779532614, 0.33281658111902235]]</schema:defaultValue>
        <rdfs:label>A_ik (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>A_ik</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/B_ik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/B_ik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (B_ik).</terms:description>
        <schema:defaultValue>[[0.3328165811190223, 0.5984537933538554, 0.33281658111902046], [0.18525241779532714, 0.3331114447027479, 0.18525241779532614], [0.3328165811190241, 0.5984537933538587, 0.33281658111902235]]</schema:defaultValue>
        <rdfs:label>B_ik (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>B_ik</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/C_ik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/C_ik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (C_ik).</terms:description>
        <schema:defaultValue>[[0.3328165811190223, 0.18525241779532714, 0.3328165811190241], [0.5984537933538554, 0.3331114447027479, 0.5984537933538587], [0.33281658111902046, 0.18525241779532614, 0.33281658111902235]]</schema:defaultValue>
        <rdfs:label>C_ik (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>C_ik</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/K11 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/K11">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema:defaultValue>
        <rdfs:label>K11 (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>K11</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/K12 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/K12">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.1</schema:defaultValue>
        <rdfs:label>K12 (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>K12</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/K21 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/K21">
