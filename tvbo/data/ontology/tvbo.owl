        <rdfs:label>figures (slot)</rdfs:label>
        <skos:definition>Declarative Figure specs rendered from this study&apos;s experiment results — closes the replication loop (a study is its experiments plus the figures that read them).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>figures</skos:notation>
    </owl:ObjectProperty>
    


