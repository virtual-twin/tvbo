        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>WorkflowEngineConfig</rdfs:label>
        <skos:definition>Execution directives for a workflow engine. Every field is optional and each engine&apos;s emitter consumes the subset it supports, so one block may carry directives for more than one target. The generic resource fields (cpus_per_task, mem, time) map across engines; the remaining fields are named for the engine that reads them (Slurm: partition/account/gres/ mail_*/array_chunk; Snakemake: cores; Nextflow: executor/queue). Any directive not named here is passed through ``options`` verbatim, so the block stays extensible without a schema change.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/WorkflowEngineConfig"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ZeroHopf -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ZeroHopf">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Bifurcation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasCodimension"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Codimension2"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasEigenvalueSignature"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/RealZeroAndImaginaryPair"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Codim-2 point with a real zero eigenvalue and an imaginary pair simultaneously; a fold curve meets a Hopf curve.</rdfs:comment>
        <rdfs:label xml:lang="en">Zero-Hopf (fold-Hopf)</rdfs:label>
        <skos:altLabel>ZH</skos:altLabel>
        <skos:altLabel>fold-hopf</skos:altLabel>
        <skos:altLabel>gavrilov-guckenheimer</skos:altLabel>
        <skos:altLabel>zero-hopf</skos:altLabel>
        <skos:altLabel>zh</skos:altLabel>
        <tvbo:canonicalCode>ZH</tvbo:canonicalCode>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AggregationType#first -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AggregationType#first">
