    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AggregationType#median -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AggregationType#median">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AggregationType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>median (AggregationType)</rdfs:label>
        <skos:definition>Median over time (per node). Robust to phase-slip / outlier samples that bias the mean. For an Observation.dynamics observer this is computed streaming: a per-node histogram (bins from the observation&apos;s `histogram` slot) is folded into the integrator carry and the 0.5 quantile is read at finalize, so no trajectory is held.</skos:definition>
        <skos:notation>median</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AggregationType#none -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AggregationType#none">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AggregationType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>none (AggregationType)</rdfs:label>
        <skos:definition>No aggregation</skos:definition>
        <skos:notation>none</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AggregationType#std -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AggregationType#std">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AggregationType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>std (AggregationType)</rdfs:label>
        <skos:definition>Standard deviation over time (per node)</skos:definition>
        <skos:notation>std</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AggregationType#variance -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AggregationType#variance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AggregationType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>variance (AggregationType)</rdfs:label>
        <skos:definition>Variance over time (per node)</skos:definition>
        <skos:notation>variance</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AggregationType#window -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AggregationType#window">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AggregationType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>window (AggregationType)</rdfs:label>
        <skos:definition>Sliding window aggregation</skos:definition>
        <skos:notation>window</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AlgorithmCompositionMode#combined -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AlgorithmCompositionMode#combined">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AlgorithmCompositionMode"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>combined (AlgorithmCompositionMode)</rdfs:label>
        <skos:definition>The included algorithm&apos;s update rules are merged into the outer loop and applied ONCE per outer iteration (1:1). Use when both algorithms update at the same cadence on the same observations. This is the default.</skos:definition>
        <skos:notation>combined</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AlgorithmCompositionMode#nested -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AlgorithmCompositionMode#nested">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AlgorithmCompositionMode"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>nested (AlgorithmCompositionMode)</rdfs:label>
        <skos:definition>The included algorithm runs as a full inner loop on EACH outer iteration, re-converging before the outer update rules are applied. Use when the inner algorithm maintains an invariant the outer one would otherwise perturb — e.g. FIC holding the E-I working point (mean S_e = 0.25) while EIB retunes per-edge coupling. The outer update&apos;s validity depends on that invariant, so the inner loop must re-settle it between every outer step.</skos:definition>
        <skos:notation>nested</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AxisReductionStatistic#mean -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AxisReductionStatistic#mean">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AxisReductionStatistic"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>mean (AxisReductionStatistic)</rdfs:label>
        <skos:definition>Arithmetic mean across the axis.</skos:definition>
        <skos:notation>mean</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AxisReductionStatistic#median -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AxisReductionStatistic#median">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AxisReductionStatistic"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>median (AxisReductionStatistic)</rdfs:label>
        <skos:definition>Median across the axis.</skos:definition>
        <skos:notation>median</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AxisReductionStatistic#sem -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AxisReductionStatistic#sem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AxisReductionStatistic"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>sem (AxisReductionStatistic)</rdfs:label>
        <skos:definition>Standard error of the mean: std across the axis divided by sqrt(n).</skos:definition>
        <skos:notation>sem</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AxisReductionStatistic#std -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AxisReductionStatistic#std">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/AxisReductionStatistic"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>std (AxisReductionStatistic)</rdfs:label>
        <skos:definition>Standard deviation across the axis.</skos:definition>
        <skos:notation>std</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AxisReductionStatistic#sum -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AxisReductionStatistic#sum">
