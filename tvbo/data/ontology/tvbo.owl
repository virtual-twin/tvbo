        <skos:notation>r_max</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/s_EE -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/s_EE">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>s_EE (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the E-&gt;E channel (sigmae_ext component).</skos:definition>
        <skos:notation>s_EE</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


