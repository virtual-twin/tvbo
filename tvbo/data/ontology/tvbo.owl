        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/sampling_rate"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>Event</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.neuroml.org/lems/0.7.6#EventPort"/>
        <skos:definition>A discrete or continuous event that modifies the system during simulation. Generalizes Stimulus: can represent external inputs (stimulus type), threshold-triggered state changes (continuous/discrete type), or time-scheduled interventions (preset_time type). Attaches to components (nodes/edges) or to the experiment level.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/Event"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/EventType -->

    <owl:Class rdf:about="https://w3id.org/tvbo/EventType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/EventType#continuous"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/EventType#discrete"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/EventType#preset_time"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/EventType#stimulation"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/EventType#stimulus"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>EventType</rdfs:label>
        <skos:definition>Type of event triggering mechanism.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/EventType#continuous"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/EventType#discrete"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/EventType#preset_time"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/EventType#stimulation"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/EventType#stimulus"/>
    </owl:Class>
    


