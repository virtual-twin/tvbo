    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>c (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>d (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iU0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iU0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iU0).</terms:description>
        <schema:defaultValue>[1.6668762461300366, 0.9278169186250886, 1.666876246130046]</schema:defaultValue>
        <rdfs:label>iU0 (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>iU0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iU3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iU3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iU3).</terms:description>
        <schema:defaultValue>[0.5999245608794813, 1.0777988414803623, 0.5999245608794778]</schema:defaultValue>
        <rdfs:label>iU3 (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>iU3</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iU4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iU4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iU4).</terms:description>
        <schema:defaultValue>[0.35990947874643836, 1.1616503426964113, 0.3599094787464342]</schema:defaultValue>
        <rdfs:label>iU4 (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>iU4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iV0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iV0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iV0).</terms:description>
        <schema:defaultValue>[1.6668762461300366, 0.9278169186250886, 1.666876246130046]</schema:defaultValue>
        <rdfs:label>iV0 (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>iV0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iV3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iV3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iV3).</terms:description>
        <schema:defaultValue>[0.5999245608794813, 1.0777988414803623, 0.5999245608794778]</schema:defaultValue>
        <rdfs:label>iV3 (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>iV3</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iV4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iV4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iV4).</terms:description>
        <schema:defaultValue>[0.35990947874643836, 1.1616503426964113, 0.3599094787464342]</schema:defaultValue>
        <rdfs:label>iV4 (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>iV4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iZU -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iZU">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iZU).</terms:description>
        <schema:defaultValue>[-3.033148827134955, 1.3877787807814457e-17, 3.033148827134998]</schema:defaultValue>
        <rdfs:label>iZU (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>iZU</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iZV -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/iZV">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iZV).</terms:description>
        <schema:defaultValue>[-3.033148827134955, 1.3877787807814457e-17, 3.033148827134998]</schema:defaultValue>
        <rdfs:label>iZV (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>iZV</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/mu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/mu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.3</schema:defaultValue>
        <rdfs:label>mu (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>mu</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.006</schema:defaultValue>
        <rdfs:label>r (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.0</schema:defaultValue>
        <rdfs:label>s (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>s</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/sigma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/sigma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3</schema:defaultValue>
        <rdfs:label>sigma (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>sigma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/xo -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/xo">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema:defaultValue>
        <rdfs:label>xo (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>xo</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(alpha, t)</tvbo:lhs>
        <tvbo:rhs>beta - e_i*alpha**3 + f_i*alpha**2 - gamma + K21*(mode_dot(xi, C_ik) - alpha) + II_i + mode_sum(c_glob0) + local_coupling*xi</tvbo:rhs>
        <rdfs:label>alpha (ReducedSetHindmarshRose state variable)</rdfs:label>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/beta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/beta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(beta, t)</tvbo:lhs>
        <tvbo:rhs>h_i - p_i*alpha**2 - beta</tvbo:rhs>
        <rdfs:label>beta (ReducedSetHindmarshRose state variable)</rdfs:label>
        <skos:notation>beta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(eta, t)</tvbo:lhs>
        <tvbo:rhs>c_i - d_i*xi**2 - eta</tvbo:rhs>
        <rdfs:label>eta (ReducedSetHindmarshRose state variable)</rdfs:label>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(gamma, t)</tvbo:lhs>
        <tvbo:rhs>r*s*alpha - r*gamma - n_i</tvbo:rhs>
        <rdfs:label>gamma (ReducedSetHindmarshRose state variable)</rdfs:label>
        <skos:notation>gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(tau, t)</tvbo:lhs>
        <tvbo:rhs>r*s*xi - r*tau - m_i</tvbo:rhs>
        <rdfs:label>tau (ReducedSetHindmarshRose state variable)</rdfs:label>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/xi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/xi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(xi, t)</tvbo:lhs>
        <tvbo:rhs>eta - a_i*xi**3 + b_i*xi**2 - tau + K11*(mode_dot(xi, A_ik) - xi) - K12*(mode_dot(alpha, B_ik) - xi) + IE_i + mode_sum(c_glob0) + local_coupling*xi</tvbo:rhs>
        <rdfs:label>xi (ReducedSetHindmarshRose state variable)</rdfs:label>
        <skos:notation>xi</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/derived_variables/H -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/derived_variables/H">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <tvbo:lhs>H</tvbo:lhs>
        <tvbo:rhs>(a*x - b)/(1 - exp(-d*(a*x - b)))</tvbo:rhs>
        <terms:description>Sigmoid input-output function of the synaptic input current, x_RWW, that computes the averaged firing rate of the neurons population (Deco et al., 2013).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>H (ReducedWongWang derived variable)</rdfs:label>
        <skos:notation>H</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/derived_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/derived_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>x</tvbo:lhs>
        <tvbo:rhs>I_o + J_N*S*local_coupling + J_N*S*w + J_N*c_glob</tvbo:rhs>
        <terms:description>(NMDAR)-mediated synaptic input current to the neurons population (Deco et al., 2013).</terms:description>
        <rdfs:label>x (ReducedWongWang derived variable)</rdfs:label>
        <skos:notation>x</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/I_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/I_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the neurons population (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.33</schema:defaultValue>
        <rdfs:label>I_o (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>External input current to the neurons population (Deco et al., 2013).

Note:
------
In TVB, the default value is set to 0.33 (instead of 0.30 as in Deco et al. (2013)) for setting the system is bistability (see Hansen et al., 2015).</skos:definition>
        <skos:notation>I_o</skos:notation>
        <tvbo:unit>nA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/J_N -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/J_N">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <terms:description>Excitatory recurrence</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2609</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>J_N (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Excitatory recurrence</skos:definition>
        <skos:notation>J_N</skos:notation>
        <tvbo:unit>nA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Slope (or gain) parameter of the sigmoid input-output function H_RWW (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.27</schema:defaultValue>
        <rdfs:label>a (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Slope (or gain) parameter of the sigmoid input-output function H_RWW (Deco et al., 2013).

Note:
-----
In the original publication, the parameter &apos;a&apos; is set in (nC)^-1 (i.e., equivalent to  (nA.s)^-1).  In TVB, the parameter has been converted in (pC)^-1 for setting the system in millisecond.</skos:definition>
        <skos:notation>a</skos:notation>
        <tvbo:unit>per_pC</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Shift parameter of the sigmoid input-output function H_RWW (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.108</schema:defaultValue>
        <rdfs:label>b (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Shift parameter of the sigmoid input-output function H_RWW (Deco et al., 2013). 

Note:
------
In the original publication, the parameter &apos;b&apos; is set in Hz. In TVB, the parameter has been converted in kHz for setting the system in millisecond.</skos:definition>
        <skos:notation>b</skos:notation>
        <tvbo:unit>kHz</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Scaling parameter of the sigmoid input-output function H_RWW (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">154.0</schema:defaultValue>
        <rdfs:label>d (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Scaling parameter of the sigmoid input-output function H_RWW (Deco et al., 2013). 

Note:
------
In the original publication, the parameter &apos;d&apos; is set in second. In TVB, the parameter has been converted in millisecond for setting the system in millisecond.</skos:definition>
        <skos:notation>d</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Kinetic parameter</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.641</schema:defaultValue>
        <rdfs:label>gamma (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Kinetic parameter</skos:definition>
        <skos:notation>gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/tau_s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/tau_s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Kinetic parameter</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">100.0</schema:defaultValue>
        <rdfs:label>tau_s (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Kinetic parameter. Decay time constant for the NMDA synapses of the neurons population (Deco et al., 2013).</skos:definition>
        <skos:notation>tau_s</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/w -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/w">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Excitatory recurrence</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.6</schema:defaultValue>
        <rdfs:label>w (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Excitatory recurrence</skos:definition>
        <skos:notation>w</skos:notation>
        <tvbo:unit>dimensionless</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/state_variables/S -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/state_variables/S">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(S, t)</tvbo:lhs>
        <tvbo:rhs>H*gamma*(1 - S) - S/tau_s</tvbo:rhs>
        <terms:description>State-variable of the Reduced WongWang model, denoting the average, (NMDAR)-mediated synaptic gating, i</terms:description>
        <rdfs:label>S (ReducedWongWang state variable)</rdfs:label>
        <skos:notation>S</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/H_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/H_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <tvbo:lhs>H_e</tvbo:lhs>
        <tvbo:rhs>x_e/(1 - exp(-d_e*x_e))</tvbo:rhs>
        <terms:description>Sigmoid function that computes the averaged firing rate of the excitatory neuron population IE_RWW_EI (Deco et al., 2014; Abbott &amp; Chance, 2005).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>H_e (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>H_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/H_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/H_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <tvbo:lhs>H_i</tvbo:lhs>
        <tvbo:rhs>x_i/(1 - exp(-d_i*x_i))</tvbo:rhs>
        <terms:description>Sigmoid function that computes the averaged firing rate of the inhibitory neuron population II_RWW (Deco et al., 2014; Abbott &amp; Chance, 2005).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>H_i (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>H_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/J_N_S_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/J_N_S_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>J_N_S_e</tvbo:lhs>
        <tvbo:rhs>J_N*S_e</tvbo:rhs>
        <rdfs:label>J_N_S_e (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>J_N_S_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/coupling -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/coupling">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>coupling</tvbo:lhs>
        <tvbo:rhs>G*J_N*(S_e*local_coupling + c_glob)</tvbo:rhs>
        <rdfs:label>coupling (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>coupling</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/x_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/x_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <tvbo:lhs>x_e</tvbo:lhs>
        <tvbo:rhs>a_e*(I_ext + I_o*W_e + J_N_S_e*w_p - J_i*S_i + coupling) - b_e</tvbo:rhs>
        <terms:description>Input current to the excitatory population (Deco et al., 2014).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>x_e (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>x_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/x_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/x_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:lhs>x_i</tvbo:lhs>
        <tvbo:rhs>a_i*(I_o*W_i + J_N_S_e - S_i + coupling*lamda) - b_i</tvbo:rhs>
        <terms:description>Input current to the inhibitory population (Deco et al., 2014).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>x_i (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>x_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/G -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/G">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Global coupling scaling</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>G (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Global coupling scaling</skos:definition>
        <skos:notation>G</skos:notation>
    </owl:NamedIndividual>
    


