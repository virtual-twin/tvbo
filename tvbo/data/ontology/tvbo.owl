            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/hasCodimension"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Codimension1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Flip bifurcation of a limit cycle: a Floquet multiplier crosses -1 and a period-doubled cycle branches off.</rdfs:comment>
        <rdfs:label xml:lang="en">Period doubling</rdfs:label>
        <skos:altLabel>PD</skos:altLabel>
        <skos:altLabel>flip</skos:altLabel>
        <skos:altLabel>pd</skos:altLabel>
        <skos:altLabel>period doubling</skos:altLabel>
        <skos:altLabel>period-doubling</skos:altLabel>
        <tvbo:canonicalCode>PD</tvbo:canonicalCode>
    </owl:Class>
    


