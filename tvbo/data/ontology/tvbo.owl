    <!-- https://w3id.org/tvbo/EpileptorRestingState -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Dynamics"/>
        <tvbo:exhibitsBifurcation rdf:nodeID="genid3430"/>
        <tvbo:exhibitsRegime rdf:resource="https://w3id.org/tvbo/Bistable"/>
        <tvbo:exhibitsRegime rdf:resource="https://w3id.org/tvbo/Bursting"/>
        <tvbo:exhibitsRegime rdf:resource="https://w3id.org/tvbo/Oscillatory"/>
        <tvbo:hasAttractor rdf:resource="https://w3id.org/tvbo/FixedPoint"/>
        <tvbo:hasAttractor rdf:resource="https://w3id.org/tvbo/LimitCycle"/>
        <tvbo:hasModelFeature rdf:resource="https://w3id.org/tvbo/FastSlowDecomposition"/>
        <tvbo:hasStochasticityCharacter rdf:resource="https://w3id.org/tvbo/Deterministic"/>
        <tvbo:modelsAnatomicalRegion rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000956"/>
        <tvbo:modelsAnatomicalRegion rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002728"/>
        <tvbo:hasTimescaleSeparation rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</tvbo:hasTimescaleSeparation>
        <tvbo:phaseSpaceDimension rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</tvbo:phaseSpaceDimension>
        <terms:description>Epileptor Resting-State (ERS) is an extension of the phenomenological neural mass model of Epileptor5D, tuned to express regionally specific physiological oscillations in addition to the epileptiform discharges (Courtiol et al., 2020). This extension was made using the Generic 2-dimensional Oscillator model (parametrized close to a supercritical Hopf Bifurcation) (Sanz-Leon et al., 2013, 2015) to reproduce the spontaneous local field potential-like signal.
        
This model, its motivation and derivation can be found in the published article (Courtiol et al., 2020).</terms:description>
        <terms:references rdf:resource="https://w3id.org/tvbo/studies/Courtiol2020"/>
        <terms:references rdf:resource="https://w3id.org/tvbo/studies/Jirsa2014"/>
        <terms:subject rdf:resource="http://purl.bioontology.org/ontology/MESH/D004827"/>
        <rdfs:label>EpileptorRestingState</rdfs:label>
        <skos:prefLabel xml:lang="en">Epileptor (resting-state)</skos:prefLabel>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/lc_1"/>
