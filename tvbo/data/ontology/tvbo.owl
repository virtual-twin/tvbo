        <terms:description>Inhibitory to inhibitory coupling coefficient (Sanz-Leon et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">11.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>c_ii (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Inhibitory to inhibitory coupling coefficient (Sanz-Leon et al., 2015)</skos:definition>
        <skos:notation>c_ii</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/k_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/k_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <terms:description>Maximum value of the excitatory response function</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>k_e (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Maximum value of the excitatory response function</skos:definition>
        <skos:notation>k_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/k_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/k_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <terms:description>Maximum value of the inhibitory response function</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>k_i (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Maximum value of the inhibitory response function</skos:definition>
        <skos:notation>k_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/r_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/r_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <terms:description>Excitatory refractory period</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>r_e (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Excitatory refractory period</skos:definition>
        <skos:notation>r_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/r_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/r_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <terms:description>Inhibitory refractory period</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>r_i (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Inhibitory refractory period</skos:definition>
        <skos:notation>r_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/shift_sigmoid -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/shift_sigmoid">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>In order to have resting state (E=0 and I=0) in absence of external input,         the logistic curve are translated downward S(0)=0</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>shift_sigmoid (WilsonCowan parameter)</rdfs:label>
        <skos:definition>In order to have resting state (E=0 and I=0) in absence of external input,
        the logistic curve are translated downward S(0)=0</skos:definition>
        <skos:notation>shift_sigmoid</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/tau_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/tau_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0043179"/>
        <terms:description>Excitatory population, membrane time-constant (Wilson and Cowan, 1972)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0043179"/>
        <rdfs:label>tau_e (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Excitatory population, membrane time-constant (Wilson and Cowan, 1972).</skos:definition>
        <skos:notation>tau_e</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/tau_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/tau_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0043180"/>
        <terms:description>Inhibitory population, membrane time-constant (Wilson and Cowan, 1972)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0043180"/>
        <rdfs:label>tau_i (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Inhibitory population, membrane time-constant (Wilson and Cowan, 1972).</skos:definition>
        <skos:notation>tau_i</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/theta_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/theta_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Excitation threshold of excitatory population (Sanz-Leon et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>theta_e (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Excitation threshold of excitatory population (Sanz-Leon et al., 2015).</skos:definition>
        <skos:notation>theta_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/theta_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/theta_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="https://w3id.org/tvbo/InhibitoryThresholdVariance"/>
        <terms:description>Excitation threshold of inhibitory population (Sanz-Leon et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="https://w3id.org/tvbo/InhibitoryThresholdVariance"/>
        <rdfs:label>theta_i (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Excitation threshold of inhibitory population (Sanz-Leon et al., 2015).</skos:definition>
        <skos:notation>theta_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/state_variables/E -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/state_variables/E">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <tvbo:lhs>Derivative(E, t)</tvbo:lhs>
        <tvbo:rhs>(-E + s_e*(-E*r_e + k_e))/tau_e</tvbo:rhs>
        <terms:description>State-variable of the Wilson and Cowan model (Wilson and Cowan, 1973), denoting the mean firing rate of all excitatory neurons of the population</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>E (WilsonCowan state variable)</rdfs:label>
        <skos:notation>E</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/state_variables/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/state_variables/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:lhs>Derivative(I, t)</tvbo:lhs>
        <tvbo:rhs>(-I + s_i*(-I*r_i + k_i))/tau_i</tvbo:rhs>
        <terms:description>State-variable of the Wilson and Cowan model (Wilson and Cowan, 1973), denoting the mean firing rate of all inhibitory neurons of the population</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>I (WilsonCowan state variable)</rdfs:label>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/Fe_ext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/Fe_ext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Fe_ext</tvbo:lhs>
        <tvbo:rhs>Piecewise((0, K_ext_e*(c_glob + lc_E + ou_drift*weight_noise) &lt; 0), (c_glob + lc_E + ou_drift*weight_noise, True))</tvbo:rhs>
        <rdfs:label>Fe_ext (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>Fe_ext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/Fi_ext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/Fi_ext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Fi_ext</tvbo:lhs>
        <tvbo:rhs>lc_I</tvbo:rhs>
        <rdfs:label>Fi_ext (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>Fi_ext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/S_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/S_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>S_e</tvbo:lhs>
        <tvbo:rhs>(-sV0 + sigma_V_e)/DsV0</tvbo:rhs>
        <rdfs:label>S_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>S_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/S_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/S_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>S_i</tvbo:lhs>
        <tvbo:rhs>(-sV0 + sigma_V_i)/DsV0</tvbo:rhs>
        <terms:description>Scaling of the remote input for the inhibitory population with
        respect to the excitatory population.</terms:description>
        <rdfs:label>S_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>S_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_V_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_V_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>T_V_e</tvbo:lhs>
        <tvbo:rhs>(U_e_e**2*fe_e*tau_e**2 + U_i_e**2*fi_e*tau_i**2)/(U_e_e**2*fe_e*tau_e**2/(T_m_e + tau_e) + U_i_e**2*fi_e*tau_i**2/(T_m_e + tau_i))</tvbo:rhs>
        <rdfs:label>T_V_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>T_V_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_V_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_V_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>T_V_i</tvbo:lhs>
        <tvbo:rhs>(U_e_i**2*fe_i*tau_e**2 + U_i_i**2*fi_i*tau_i**2)/(U_e_i**2*fe_i*tau_e**2/(T_m_i + tau_e) + U_i_i**2*fi_i*tau_i**2/(T_m_i + tau_i))</tvbo:rhs>
        <rdfs:label>T_V_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>T_V_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>T_e</tvbo:lhs>
        <tvbo:rhs>(-TvN0 + T_V_e*g_L/C_m)/DTvN0</tvbo:rhs>
        <rdfs:label>T_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>T_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>T_i</tvbo:lhs>
        <tvbo:rhs>(-TvN0 + T_V_i*g_L/C_m)/DTvN0</tvbo:rhs>
        <rdfs:label>T_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>T_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_m_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_m_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>T_m_e</tvbo:lhs>
        <tvbo:rhs>C_m/mu_G_e</tvbo:rhs>
        <rdfs:label>T_m_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>T_m_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_m_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_m_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>T_m_i</tvbo:lhs>
        <tvbo:rhs>C_m/mu_G_i</tvbo:rhs>
        <rdfs:label>T_m_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>T_m_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_e_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_e_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>U_e_e</tvbo:lhs>
        <tvbo:rhs>Q_e*(E_e - mu_V_e)/mu_G_e</tvbo:rhs>
        <rdfs:label>U_e_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>U_e_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_e_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_e_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>U_e_i</tvbo:lhs>
        <tvbo:rhs>Q_e*(E_e - mu_V_i)/mu_G_i</tvbo:rhs>
        <rdfs:label>U_e_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>U_e_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_i_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_i_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>U_i_e</tvbo:lhs>
        <tvbo:rhs>Q_i*(E_i - mu_V_e)/mu_G_e</tvbo:rhs>
        <rdfs:label>U_i_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>U_i_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_i_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_i_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>U_i_i</tvbo:lhs>
        <tvbo:rhs>Q_i*(E_i - mu_V_i)/mu_G_i</tvbo:rhs>
        <rdfs:label>U_i_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>U_i_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>V_e</tvbo:lhs>
        <tvbo:rhs>(-muV0 + mu_V_e)/DmuV0</tvbo:rhs>
        <rdfs:label>V_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>V_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>V_i</tvbo:lhs>
        <tvbo:rhs>(-muV0 + mu_V_i)/DmuV0</tvbo:rhs>
        <rdfs:label>V_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>V_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_thre_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_thre_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>V_thre_e</tvbo:lhs>
        <tvbo:rhs>1000.0*P0_e + 1000.0*P1_e*V_e + 1000.0*P2_e*S_e + 1000.0*P3_e*T_e + 1000.0*P4_e*V_e**2 + 1000.0*P5_e*S_e**2 + 1000.0*P6_e*T_e**2 + 1000.0*P7_e*S_e*V_e + 1000.0*P8_e*T_e*V_e + 1000.0*P9_e*S_e*T_e</tvbo:rhs>
        <rdfs:label>V_thre_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>V_thre_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_thre_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_thre_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>V_thre_i</tvbo:lhs>
        <tvbo:rhs>1000.0*P0_i + 1000.0*P1_i*V_i + 1000.0*P2_i*S_i + 1000.0*P3_i*T_i + 1000.0*P4_i*V_i**2 + 1000.0*P5_i*S_i**2 + 1000.0*P6_i*T_i**2 + 1000.0*P7_i*S_i*V_i + 1000.0*P8_i*T_i*V_i + 1000.0*P9_i*S_i*T_i</tvbo:rhs>
        <rdfs:label>V_thre_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>V_thre_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/f_out_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/f_out_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>f_out_e</tvbo:lhs>
        <tvbo:rhs>erfc(sqrt(2)*(V_thre_e - mu_V_e)/(2*sigma_V_e))/(2*T_V_e)</tvbo:rhs>
        <rdfs:label>f_out_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>f_out_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/f_out_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/f_out_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>f_out_i</tvbo:lhs>
        <tvbo:rhs>erfc(sqrt(2)*(V_thre_i - mu_V_i)/(2*sigma_V_i))/(2*T_V_i)</tvbo:rhs>
        <rdfs:label>f_out_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>f_out_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fe_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fe_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>fe_e</tvbo:lhs>
        <tvbo:rhs>K_ext_e*(Fe_ext + external_input_ex_ex) + N_tot*p_connect_e*(1.0 - g)*(E + 1/1000000)</tvbo:rhs>
        <rdfs:label>fe_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>fe_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fe_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fe_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>fe_i</tvbo:lhs>
        <tvbo:rhs>K_ext_e*(Fe_ext + external_input_in_ex) + N_tot*p_connect_e*(1.0 - g)*(E + 1/1000000)</tvbo:rhs>
        <rdfs:label>fe_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>fe_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fi_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fi_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>fi_e</tvbo:lhs>
        <tvbo:rhs>K_ext_i*(Fi_ext + external_input_ex_in) + N_tot*g*p_connect_i*(I + 1/1000000)</tvbo:rhs>
        <rdfs:label>fi_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>fi_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fi_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fi_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>fi_i</tvbo:lhs>
        <tvbo:rhs>K_ext_i*(Fi_ext + external_input_in_in) + N_tot*g*p_connect_i*(I + 1/1000000)</tvbo:rhs>
        <rdfs:label>fi_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>fi_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/lc_E -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/lc_E">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>lc_E</tvbo:lhs>
        <tvbo:rhs>local_coupling*E</tvbo:rhs>
        <rdfs:label>lc_E (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>lc_E</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/lc_I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/lc_I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>lc_I</tvbo:lhs>
        <tvbo:rhs>I*local_coupling</tvbo:rhs>
        <rdfs:label>lc_I (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>lc_I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_G_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_G_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu_G_e</tvbo:lhs>
        <tvbo:rhs>g_L + mu_Ge_e + mu_Gi_e</tvbo:rhs>
        <rdfs:label>mu_G_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>mu_G_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_G_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_G_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu_G_i</tvbo:lhs>
        <tvbo:rhs>g_L + mu_Ge_i + mu_Gi_i</tvbo:rhs>
        <rdfs:label>mu_G_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>mu_G_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Ge_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Ge_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu_Ge_e</tvbo:lhs>
        <tvbo:rhs>Q_e*fe_e*tau_e</tvbo:rhs>
        <rdfs:label>mu_Ge_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>mu_Ge_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Ge_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Ge_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu_Ge_i</tvbo:lhs>
        <tvbo:rhs>Q_e*fe_i*tau_e</tvbo:rhs>
        <rdfs:label>mu_Ge_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>mu_Ge_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Gi_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Gi_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu_Gi_e</tvbo:lhs>
        <tvbo:rhs>Q_i*fi_e*tau_i</tvbo:rhs>
        <rdfs:label>mu_Gi_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>mu_Gi_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Gi_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Gi_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu_Gi_i</tvbo:lhs>
        <tvbo:rhs>Q_i*fi_i*tau_i</tvbo:rhs>
        <rdfs:label>mu_Gi_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>mu_Gi_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_V_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_V_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu_V_e</tvbo:lhs>
        <tvbo:rhs>(E_L_e*g_L + E_e*mu_Ge_e + E_i*mu_Gi_e - W_e)/mu_G_e</tvbo:rhs>
        <rdfs:label>mu_V_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>mu_V_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_V_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_V_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu_V_i</tvbo:lhs>
        <tvbo:rhs>(E_L_i*g_L + E_e*mu_Ge_i + E_i*mu_Gi_i - W_i)/mu_G_i</tvbo:rhs>
        <rdfs:label>mu_V_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>mu_V_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/sigma_V_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/sigma_V_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sigma_V_e</tvbo:lhs>
        <tvbo:rhs>sqrt(U_e_e**2*fe_e*tau_e**2/(2.0*T_m_e + 2.0*tau_e) + U_i_e**2*fi_e*tau_i**2/(2.0*T_m_e + 2.0*tau_i))</tvbo:rhs>
        <rdfs:label>sigma_V_e (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>sigma_V_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/sigma_V_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/sigma_V_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sigma_V_i</tvbo:lhs>
        <tvbo:rhs>sqrt(U_e_i**2*fe_i*tau_e**2/(2.0*T_m_i + 2.0*tau_e) + U_i_i**2*fi_i*tau_i**2/(2.0*T_m_i + 2.0*tau_i))</tvbo:rhs>
        <rdfs:label>sigma_V_i (ZerlautAdaptationFirstOrder derived variable)</rdfs:label>
        <skos:notation>sigma_V_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/C_m -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/C_m">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <terms:description>membrane capacitance [pF]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">200.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>C_m (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>membrane capacitance [pF]</skos:definition>
        <skos:notation>C_m</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/DTvN0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/DTvN0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Normalization factors page 48 after the equation 4 from [ZD_2018]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>DTvN0 (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>Normalization factors page 48 after the equation 4 from [ZD_2018]</skos:definition>
        <skos:notation>DTvN0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/DmuV0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/DmuV0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Normalization factors page 48 after the equation 4 from [ZD_2018]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <rdfs:label>DmuV0 (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>Normalization factors page 48 after the equation 4 from [ZD_2018]</skos:definition>
        <skos:notation>DmuV0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/DsV0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/DsV0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Normalization factors page 48 after the equation 4 from [ZD_2018]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.0</schema:defaultValue>
        <rdfs:label>DsV0 (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>Normalization factors page 48 after the equation 4 from [ZD_2018]</skos:definition>
        <skos:notation>DsV0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/E_L_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/E_L_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0022840"/>
        <terms:description>leak reversal potential for excitatory [mV]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-65.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0022840"/>
        <rdfs:label>E_L_e (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>leak reversal potential for excitatory [mV]</skos:definition>
        <skos:notation>E_L_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/E_L_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/E_L_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0022840"/>
        <terms:description>leak reversal potential for inhibitory [mV]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-65.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0022840"/>
        <rdfs:label>E_L_i (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>leak reversal potential for inhibitory [mV]</skos:definition>
        <skos:notation>E_L_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/E_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/E_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
