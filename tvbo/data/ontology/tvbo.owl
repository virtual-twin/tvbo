    <!-- https://w3id.org/tvbo/inner_coupling -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/inner_coupling">
        <rdfs:label>inner_coupling (slot)</rdfs:label>
        <skos:definition>For hierarchical coupling: inner coupling applied at regional level</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>inner_coupling</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/input -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/input"/>
    


    <!-- https://w3id.org/tvbo/inputs -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/inputs">
        <rdfs:label>inputs (slot)</rdfs:label>
        <skos:definition>Per-input fingerprints for cache invalidation. Each entry records the IRI + dotted-field path of an ``aux_data`` reference plus the (mtime, size, sha256) of the underlying file at the time the artifact was produced. A downstream cache hit requires every fingerprint to match the current file state.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>inputs</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/integration -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/integration"/>
    


    <!-- https://w3id.org/tvbo/intensity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/intensity">
        <rdfs:label>intensity (slot)</rdfs:label>
        <skos:definition>Noise amplitude as a standard deviation (sigma), scalar or per state variable. Give a dispersion (TVB&apos;s nsig, D = sigma^2/2) as the `nsig` entry of `parameters` instead; `sigma` there is equivalent to this slot. Stating one meaning matters: reading the same number as sigma or as D differs by sqrt(2 D)/D.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>intensity</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/intermediate_expressions -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/intermediate_expressions">
        <rdfs:label>intermediate_expressions (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>intermediate_expressions</skos:notation>
    </owl:ObjectProperty>
    


