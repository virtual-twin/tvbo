        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <terms:description>Excitatory to inhibitory coupling coefficient (Sanz-Leon et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">13.0</schema:defaultValue>
