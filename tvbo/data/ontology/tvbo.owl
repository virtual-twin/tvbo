        <rdfs:label xml:lang="en">Coloured noise</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ComparisonOperator -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ComparisonOperator">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ComparisonOperator#ge"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ComparisonOperator#gt"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ComparisonOperator#le"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ComparisonOperator#lt"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>ComparisonOperator</rdfs:label>
        <skos:definition>Comparison used by a `stochastic_mask` step. Named rather than written as an operator so the step stays metadata: `!=` in particular cannot survive expression parsing (it evaluates to a plain boolean).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ComparisonOperator#ge"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ComparisonOperator#gt"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ComparisonOperator#le"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ComparisonOperator#lt"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ConditionalBlock -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ConditionalBlock">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/condition"/>
