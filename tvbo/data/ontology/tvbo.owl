    <owl:Class rdf:about="https://w3id.org/tvbo/ImagingModality#MEG">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ImagingModality"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
