        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>inhibitory decay [ms]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>tau_i (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Inhibitory synaptic decay time constant.</skos:definition>
        <skos:notation>tau_i</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_w_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_w_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Adaptation time constant of excitatory neurons [ms]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">500.0</schema:defaultValue>
        <rdfs:label>tau_w_e (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Adaptation time constant of excitatory neurons.</skos:definition>
        <skos:notation>tau_w_e</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_w_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_w_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Adaptation time constant of inhibitory neurons [ms]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tau_w_i (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Adaptation time constant of inhibitory neurons.</skos:definition>
        <skos:notation>tau_w_i</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/weight_noise -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/weight_noise">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>weight noise</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.5</schema:defaultValue>
        <rdfs:label>weight_noise (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Weight of the Ornstein-Uhlenbeck noise drift onto the external excitatory input.</skos:definition>
        <skos:notation>weight_noise</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ee -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ee">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(C_ee, t)</tvbo:lhs>
        <tvbo:rhs>(TFe*(1.0/T - TFe)/(N_tot*(1.0 - g)) + (TFe - E)**2 + 2.0*C_ee*dfe_TFe + 2.0*C_ei*dfi_TFe - 2.0*C_ee)/T</tvbo:rhs>
        <terms:description>Variance of the excitatory population activity.</terms:description>
        <rdfs:label>C_ee (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>C_ee</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ei -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ei">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(C_ei, t)</tvbo:lhs>
        <tvbo:rhs>((TFe - E)*(TFi - I) + C_ee*dfe_TFe + C_ei*dfe_TFi + C_ei*dfi_TFe + C_ii*dfi_TFi - 2.0*C_ei)/T</tvbo:rhs>
        <terms:description>Covariance between the excitatory and inhibitory population activities.</terms:description>
        <rdfs:label>C_ei (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>C_ei</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ii -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ii">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(C_ii, t)</tvbo:lhs>
        <tvbo:rhs>(TFi*(1.0/T - TFi)/(N_tot*g) + (TFi - I)**2 + 2.0*C_ii*dfi_TFi + 2.0*C_ei*dfe_TFi - 2.0*C_ii)/T</tvbo:rhs>
        <terms:description>Variance of the inhibitory population activity.</terms:description>
        <rdfs:label>C_ii (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>C_ii</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/E -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/E">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(E, t)</tvbo:lhs>
        <tvbo:rhs>(TFe - E + 0.5*C_ee*d2_fefe_e + 0.5*C_ei*d2_fefi_e + 0.5*C_ei*d2_fife_e + 0.5*C_ii*d2_fifi_e)/T</tvbo:rhs>
        <terms:description>Firing rate of the excitatory population [kHz].</terms:description>
        <rdfs:label>E (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>E</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(I, t)</tvbo:lhs>
        <tvbo:rhs>(TFi - I + 0.5*C_ee*d2_fefe_i + 0.5*C_ei*d2_fefi_i + 0.5*C_ei*d2_fife_i + 0.5*C_ii*d2_fifi_i)/T</tvbo:rhs>
        <terms:description>Firing rate of the inhibitory population [kHz].</terms:description>
        <rdfs:label>I (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(W_e, t)</tvbo:lhs>
        <tvbo:rhs>-W_e/tau_w_e + b_e*E + a_e*(muV_e - E_L_e)/tau_w_e</tvbo:rhs>
        <terms:description>Adaptation current of the excitatory population [pA].</terms:description>
        <rdfs:label>W_e (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>W_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(W_i, t)</tvbo:lhs>
        <tvbo:rhs>-W_i/tau_w_i + b_i*I + a_i*(muV_i - E_L_i)/tau_w_i</tvbo:rhs>
        <terms:description>Adaptation current of the inhibitory population [pA].</terms:description>
        <rdfs:label>W_i (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>W_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/ou_drift -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/ou_drift">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(ou_drift, t)</tvbo:lhs>
        <tvbo:rhs>-ou_drift/tau_OU</tvbo:rhs>
        <terms:description>Ornstein-Uhlenbeck noise drift.</terms:description>
        <rdfs:label>ou_drift (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>ou_drift</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/derived_variables/coupled_input -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/derived_variables/coupled_input">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>coupled_input</tvbo:lhs>
        <tvbo:rhs>2*e0/(exp(rho_1*(-c_glob - local_coupling*v6 + rho_2)) + 1)</tvbo:rhs>
        <rdfs:label>coupled_input (ZetterbergJansen derived variable)</rdfs:label>
        <skos:notation>coupled_input</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sigma_v1</tvbo:lhs>
        <tvbo:rhs>Piecewise((0, rho_1*(rho_2 - v1) &gt; 709), (2*e0/(exp(rho_1*(rho_2 - v1)) + 1), True))</tvbo:rhs>
        <rdfs:label>sigma_v1 (ZetterbergJansen derived variable)</rdfs:label>
        <skos:notation>sigma_v1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v23 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v23">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sigma_v23</tvbo:lhs>
        <tvbo:rhs>Piecewise((0, rho_1*(rho_2 - (v2 - v3)) &gt; 709), (2*e0/(exp(rho_1*(rho_2 - (v2 - v3))) + 1), True))</tvbo:rhs>
        <rdfs:label>sigma_v23 (ZetterbergJansen derived variable)</rdfs:label>
        <skos:notation>sigma_v23</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v45 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v45">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sigma_v45</tvbo:lhs>
        <tvbo:rhs>Piecewise((0, rho_1*(rho_2 - (v4 - v5)) &gt; 709), (2*e0/(exp(rho_1*(rho_2 - (v4 - v5))) + 1), True))</tvbo:rhs>
        <rdfs:label>sigma_v45 (ZetterbergJansen derived variable)</rdfs:label>
        <skos:notation>sigma_v45</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/He -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/He">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <terms:description>Maximum amplitude of EPSP [mV]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.25</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>He (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Maximum amplitude of EPSP [mV]. Also called average synaptic gain.</skos:definition>
        <skos:notation>He</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/Hi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/Hi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <terms:description>Maximum amplitude of IPSP [mV]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">22.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>Hi (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Maximum amplitude of IPSP [mV]. Also called average synaptic gain.</skos:definition>
        <skos:notation>Hi</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/P -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/P">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/CL_0000598"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <terms:description>Maximum firing rate to the pyramidal population [ms^-1]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.12</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000598"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>P (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Maximum firing rate to the pyramidal population [ms^-1].
        (External stimulus. Constant intensity.Entry point for coupling.)</skos:definition>
        <skos:notation>P</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/Q -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/Q">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <tvbo:surrogate_of rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <terms:description>Maximum firing rate to the interneurons population [ms^-1]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.12</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>Q (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Maximum firing rate to the interneurons population [ms^-1].
        (External stimulus. Constant intensity.Entry point for coupling.)</skos:definition>
        <skos:notation>Q</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/U -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/U">
