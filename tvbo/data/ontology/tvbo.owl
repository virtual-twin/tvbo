    <!-- https://w3id.org/tvbo/BoundaryConditionType -->

    <owl:Class rdf:about="https://w3id.org/tvbo/BoundaryConditionType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/BoundaryConditionType#Dirichlet"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/BoundaryConditionType#Neumann"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/BoundaryConditionType#Periodic"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/BoundaryConditionType#Robin"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>BoundaryConditionType</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/BoundaryConditionType#Dirichlet"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/BoundaryConditionType#Neumann"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/BoundaryConditionType#Periodic"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/BoundaryConditionType#Robin"/>
    </owl:Class>
    


