        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>Continuation</rdfs:label>
        <skos:definition>Complete specification of a numerical continuation / bifurcation analysis. All universal solver settings live directly here. Toolkit-specific string options go in the options slot. When used inside a BranchSwitch, only explicitly set attributes override the parent&apos;s values.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/Continuation"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ContinuationAlgorithm -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ContinuationAlgorithm">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ContinuationAlgorithm#MoorePenrose"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ContinuationAlgorithm#Natural"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ContinuationAlgorithm#PALC"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>ContinuationAlgorithm</rdfs:label>
        <skos:definition>Predictor-corrector algorithm for numerical continuation.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ContinuationAlgorithm#MoorePenrose"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ContinuationAlgorithm#Natural"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ContinuationAlgorithm#PALC"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Corner -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Corner">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/Corner#lower%20left"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/Corner#lower%20right"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/Corner#upper%20left"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/Corner#upper%20right"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>Corner</rdfs:label>
        <skos:definition>A named corner for placing a panel number inside its axes — the four corners bsplot&apos;s add_panel_number anchors to. An enum so a typo is a validation error, not a silent fallback to the default corner.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/figure"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/Corner#lower%20left"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/Corner#lower%20right"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/Corner#upper%20left"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/Corner#upper%20right"/>
    </owl:Class>
    


