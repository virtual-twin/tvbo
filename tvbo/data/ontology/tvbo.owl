    <!-- https://w3id.org/tvbo/backendParameter -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/backendParameter">
        <rdfs:comment xml:lang="en">Concrete backend parameter that realises a backend-neutral tvbo term (e.g. the tvboptim solver keyword an evaluation scheme lowers to). Documentary: states how a value is enacted per backend without binding tvbo to any one of them.</rdfs:comment>
        <rdfs:label xml:lang="en">backend parameter</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/boundConstraint -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/boundConstraint">
        <rdfs:comment xml:lang="en">Numerical pre-condition the realised parameter must satisfy for the capability to stay correct.</rdfs:comment>
        <rdfs:label xml:lang="en">bound constraint</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/canonicalCode -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/canonicalCode">
        <rdfs:comment xml:lang="en">Backend-independent short code for a special-point type (e.g. &quot;LP&quot;, &quot;HB&quot;, &quot;BP&quot;). The Python special-point label map derives (altLabel → canonicalCode) from these annotations.</rdfs:comment>
        <rdfs:label xml:lang="en">canonical code</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/collection_key -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/collection_key"/>
    


    <!-- https://w3id.org/tvbo/enabledByCouplingSlot -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/enabledByCouplingSlot">
        <rdfs:comment xml:lang="en">Name of the concrete Coupling metadata slot a SimulationExperiment must set to True to realise this capability; read at configure() time to materialise the slot.</rdfs:comment>
        <rdfs:label xml:lang="en">enabled by coupling slot</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/enabledByGraphParameter -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/enabledByGraphParameter">
        <rdfs:comment xml:lang="en">Name of the concrete graph parameter a SimulationExperiment must set to realise this capability; read at configure() time to materialise the value.</rdfs:comment>
        <rdfs:label xml:lang="en">enabled by graph parameter</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/enabledByIntegrationSlot -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/enabledByIntegrationSlot">
        <rdfs:comment xml:lang="en">Name (optionally followed by &apos;:&apos; and the required value) of the Integration/Integrator metadata slot a SimulationExperiment must set to realise this capability; read at configure() time to materialise the slot.</rdfs:comment>
        <rdfs:label xml:lang="en">enabled by integration slot</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/hasDerivedVariable -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/hasDerivedVariable"/>
    


    <!-- https://w3id.org/tvbo/hasParameter -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/hasParameter"/>
    


    <!-- https://w3id.org/tvbo/hasStateVariable -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/hasStateVariable"/>
    


    <!-- https://w3id.org/tvbo/model_type -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/model_type">
        <rdfs:label>model_type (slot)</rdfs:label>
        <skos:definition>Coarse classification of this model (mean_field, neural_mass, phase_oscillator, phenomenological, spiking, generic, field). Used for filtering in Dynamics.list_db(model_type=...).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>model_type</skos:notation>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/realisedByBackend -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/realisedByBackend">
        <rdfs:comment xml:lang="en">Backend(s) whose codegen currently lowers this analysis observable to a concrete implementation.</rdfs:comment>
        <rdfs:label xml:lang="en">realised by backend</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/unit -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/unit">
        <rdfs:range rdf:resource="https://w3id.org/tvbo/UnitEnum"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/clinical/icd11Code -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/clinical/icd11Code">
        <rdfs:label>ICD-11 code</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/neuroml/eventPort -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/neuroml/eventPort">
        <rdfs:comment xml:lang="en">An event port declared by this NeuroML ComponentType.</rdfs:comment>
        <rdfs:label xml:lang="en">event port</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/neuroml/exposes -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/neuroml/exposes">
        <rdfs:comment xml:lang="en">A quantity this NeuroML ComponentType exposes.</rdfs:comment>
        <rdfs:label xml:lang="en">exposes</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/neuroml/hasParameter -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/neuroml/hasParameter">
        <rdfs:comment xml:lang="en">A parameter declared by this NeuroML ComponentType.</rdfs:comment>
        <rdfs:label xml:lang="en">has parameter</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/neuroml/requires -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/neuroml/requires">
        <rdfs:comment xml:lang="en">A quantity this NeuroML ComponentType requires from its context.</rdfs:comment>
        <rdfs:label xml:lang="en">requires</rdfs:label>
    </owl:AnnotationProperty>
    


