        <skos:notation>c_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/c_ie -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/c_ie">
