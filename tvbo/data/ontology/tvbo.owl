    <!-- https://w3id.org/tvbo/DenseDelayGraph -->

    <owl:Class rdf:about="https://w3id.org/tvbo/DenseDelayGraph">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Dense adjacency with a delay-history buffer, used when any coupling carries a conduction delay and graph_representation resolves to dense. Required for interpolated (differentiable) delays (§4.1b).</rdfs:comment>
        <rdfs:label xml:lang="en">DenseDelayGraph</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/DenseGraph -->

    <owl:Class rdf:about="https://w3id.org/tvbo/DenseGraph">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Dense adjacency, instantaneous coupling. Used when graph_representation resolves to dense and no coupling carries a conduction delay.</rdfs:comment>
        <rdfs:label xml:lang="en">DenseGraph</rdfs:label>
    </owl:Class>
    


