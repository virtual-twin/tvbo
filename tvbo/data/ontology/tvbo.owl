    <!-- https://w3id.org/tvbo/seed_offset -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/seed_offset">
        <rdfs:label>seed_offset (slot)</rdfs:label>
        <skos:definition>Sub-stream this step draws from, offset from the generator&apos;s seed. Two seeded steps must use different offsets to be independent. Stated here rather than inferred from step order so it is a property of the generator that every backend derives identically (numpy re-seeds, jax folds the offset into the key) — and so inserting or reordering steps cannot silently change an existing generator&apos;s output.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>seed_offset</skos:notation>
    </owl:DatatypeProperty>
    


