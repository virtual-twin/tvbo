        <rdfs:label>State-SpaceReductionMonitors</rdfs:label>
        <skos:definition>State-Space Reduction Monitors selects a subset of model&apos;s state-variables to record.</skos:definition>
        <identifier>000808</identifier>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/StateVariable -->

    <owl:Class rdf:about="https://w3id.org/tvbo/StateVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/MathematicalEntity"/>
        <dc:description>A State-Variable is a scalar time-dependent variable denoting the current &apos;state&apos; of a dynamical system.</dc:description>
        <rdfs:label>StateVariable</rdfs:label>
        <skos:definition>State variables are the dynamically changing quantities required to describe a system of interest. For a neural mass model, state variables correspond to mean firing rates, synaptic currents, and membrane potentials of each neural type of interest.</skos:definition>
        <skos:note>Sometimes, the state-variable is only conceptual, mathematical, and not physically realizable.</skos:note>
        <identifier>000809</identifier>
    </owl:Class>
    


