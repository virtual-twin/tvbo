        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_cvar"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x_CD3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
