        <acronym>E3DSM</acronym>
        <equation>\begin{align}
\dot{x} &amp;= -y \\\
                \dot{y} &amp;= x^3 - \mu_2 x - \mu_1 - y(\nu + b x + x^2) \\\
                \dot{z} &amp;= -c(\sqrt{x-x_{s}^2+y^2} - d^*)\\\
                (\dot{u}A) &amp;= cA\\\
                (\dot{u}B) &amp;= cB\\
\end{align}</equation>
        <identifier>000261</identifier>
        <sourcecode rdf:resource="https://github.com/the-virtual-brain/tvb-root/blob/master/tvb_library/tvb/simulator/models/epileptorcodim3.py"/>
