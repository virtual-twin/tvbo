            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/uB_E3DSM"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>B_E3DSM</rdfs:label>
