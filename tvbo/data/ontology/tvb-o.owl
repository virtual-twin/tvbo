            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/H_i_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/gamma_i_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tau_i_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/S_i_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_derivative_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/S_i_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>S_idot_RWW_EI</rdfs:label>
        <skos:definition>Derivative of the state-variable SI_RWW with respect to time (Deco et al., 2014).</skos:definition>
        <category>Time Derivative</category>
        <category>TimeDerivative</category>
        <identifier>000779</identifier>
        <references>(Deco et al., 2014) Deco G, Ponce-Alvarez A, Hagmann P, Romani GL, Mantini D, Corbetta M. How local excitation–inhibition ratio impacts the whole-brain dynamics. J Neurosci, 2014 34(23): 7886-7898.</references>
        <references>Equation of SIdot_RWW.

::math
\dot{S_{I,i}} = -\dfrac{S_{I,i}}{\tau_{I}} + H_{I}(I_{I,i}) + noise</references>
        <symbol>\dot{S}_I</symbol>
        <value>- (S_i / tau_i) + H_i * gamma_i</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Scaling -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Scaling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Coupling"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SparseCoupling"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/a_cS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Scaling</rdfs:label>
        <skos:definition>Scaling Coupling Function rescales the coupled delayed input.</skos:definition>
        <acronym>cS</acronym>
        <equation>Equation of the scaling coupling function.

SCF(x_i, x_j, w_ij) = a * sum w_ij * x_j(t - tau_ij)</equation>
        <identifier>000780</identifier>
        <value>a*x_j</value>
    </owl:Class>
    


