    <!-- https://w3id.org/tvbo/S_edot_RWW_EI -->

    <owl:Class rdf:about="https://w3id.org/tvbo/S_edot_RWW_EI">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/S_e_RWW_EI"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeDerivative"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/H_e_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/H_e_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/gamma_e_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tau_e_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/S_e_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_derivative_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/S_e_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>S_edot_RWW_EI</rdfs:label>
        <skos:definition>Derivative of the state-variable SE_RWW with respect to time (Deco et al., 2014).</skos:definition>
        <category>Time Derivative</category>
        <category>TimeDerivative</category>
        <equation>\dot{S_{E,i}} = -\dfrac{S_{E,i}}{\tau_{E}} + (1 - S_{E,i}) \gamma H_{E}(I_{E,i}) + noise</equation>
        <identifier>000776</identifier>
        <references>(Deco et al., 2014) Deco G, Ponce-Alvarez A, Hagmann P, Romani GL, Mantini D, Corbetta M. How local excitation–inhibition ratio impacts the whole-brain dynamics. J Neurosci, 2014 34(23): 7886-7898.</references>
        <symbol>\dot{S}_E</symbol>
        <value>- (S_e / tau_e) + (1 - S_e) * H_e * gamma_e</value>
    </owl:Class>
    


