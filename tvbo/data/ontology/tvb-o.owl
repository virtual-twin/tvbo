    <!-- https://w3id.org/tvbo/sigma_V_e_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/sigma_V_e_ZAFO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/sigma_V_ZAFO"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>sigma_V_e_ZAFO</rdfs:label>
        <category>Function</category>
        <identifier>001399</identifier>
        <value>numpy.sqrt(fe_e * (U_e_e * tau_e) ** 2 / (2.0 * (tau_e + T_m_e)) + fi_e * (U_i_e * tau_i) ** 2 / (2.0 * (tau_i + T_m_e)))</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/sigma_V_i_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/sigma_V_i_ZAFO">
