        <rdfs:label>y2dot_E5D</rdfs:label>
        <skos:definition>Derivative of the state-variable y2_E5D of the Epileptor5D with respect to time.</skos:definition>
        <category>Time Derivative</category>
        <category>TimeDerivative</category>
        <equation>Equation of y2dot_E5D.

::math
 \dot{y_{2}} &amp;=&amp; tt (1 / \tau_{2} (-y_{2} + f_{2}(x_{2})))</equation>
        <identifier>001573</identifier>
        <symbol>y2dot</symbol>
        <value>tt * ((-y2 + y2cond) / tau)</value>
    </owl:Class>
    


