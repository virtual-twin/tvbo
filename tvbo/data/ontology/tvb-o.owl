    <!-- https://w3id.org/tvbo/post_cSIG -->

    <owl:Class rdf:about="https://w3id.org/tvbo/post_cSIG">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Fpost"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Sigmoidal"/>
        <rdfs:label>post_cSIG</rdfs:label>
        <identifier>001311</identifier>
        <value>cmin + ((cmax - cmin) / (1.0 + exp(-a *((gx - midpoint) / sigma))))</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/post_cSIGJR -->

    <owl:Class rdf:about="https://w3id.org/tvbo/post_cSIGJR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Fpost"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SigmoidalJansenRit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_argument"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/WeightedAfferents"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/a_cSIGJR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>post_cSIGJR</rdfs:label>
        <identifier>001312</identifier>
        <value>a * gx</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/pre_cD -->

    <owl:Class rdf:about="https://w3id.org/tvbo/pre_cD">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Difference"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Fpre"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:label>pre_cD</rdfs:label>
        <identifier>001313</identifier>
        <value>x_j - x_i</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/pre_cHT -->

    <owl:Class rdf:about="https://w3id.org/tvbo/pre_cHT">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Fpre"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/HyperbolicTangent"/>
        <rdfs:label>pre_cHT</rdfs:label>
        <identifier>001314</identifier>
        <value>a * (1 + tanh((b * x_j - midpoint) / sigma))</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/pre_cKUR -->

    <owl:Class rdf:about="https://w3id.org/tvbo/pre_cKUR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Fpre"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/KuramotoCoupling"/>
        <rdfs:label>pre_cKUR</rdfs:label>
        <identifier>001315</identifier>
        <value>sin(x_j - x_i)</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/pre_cPreSIG -->

    <owl:Class rdf:about="https://w3id.org/tvbo/pre_cPreSIG">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Fpre"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/PreSigmoidal"/>
        <rdfs:label>pre_cPreSIG</rdfs:label>
        <identifier>001316</identifier>
        <value>H*(Q + tanh(G*(P*x_j - theta)))</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/pre_cSIGJR -->

    <owl:Class rdf:about="https://w3id.org/tvbo/pre_cSIGJR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Fpre"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SigmoidalJansenRit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/cmax_cSIGJR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/cmin_cSIGJR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/midpoint_cSIGJR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/r_cSIGJR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>pre_cSIGJR</rdfs:label>
        <identifier>001317</identifier>
        <value>cmin + ( cmax -  cmin) / (1.0 + exp( r * ( midpoint - (x_j[:, 0] - x_j[:, 1]))))</value>
    </owl:Class>
    


