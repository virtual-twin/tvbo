                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/ExcitabilityThresholdVariance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
