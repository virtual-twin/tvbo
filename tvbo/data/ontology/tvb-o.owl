                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Wdot_G2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>tau_G2D</rdfs:label>
        <skos:definition>A time-scale hierarchy can be introduced for the state
        variables :math:`V` and :math:`W`. Default parameter is 1, which means
        no time-scale hierarchy.</skos:definition>
        <skos:definition>tau_G2D is a positive scaling parameter of both state-equations that introduce a time scale separation between the (fast) state-variable V_G2D and (slow) state-variable W_G2D.

Note:
------
In TVB, by default tau_G2D is set to 1., which means no time scale separation between processes.</skos:definition>
        <category>Parameter</category>
        <defaultValue>1.0</defaultValue>
        <identifier>001435</identifier>
        <range>lo=1.0, hi=5.0, step=0.01</range>
        <symbol>\tau</symbol>
    </owl:Class>
    


