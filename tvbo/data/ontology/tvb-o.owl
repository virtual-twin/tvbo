    <!-- https://w3id.org/tvbo/Ks_E2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Ks_E2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Epileptor2D"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/zdot_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Ks_E2D</rdfs:label>
        <skos:definition>Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al., 2014).

The coupling quantifies the influence of neuronal fast discharges x_E2D on the local slow permittivity variable z_E2D.</skos:definition>
        <skos:definition>Permittivity coupling, that is from the fast time scale toward the slow time scale.</skos:definition>
        <category>Parameter</category>
        <defaultValue>0.0</defaultValue>
        <identifier>000641</identifier>
        <range>lo=-4.0, hi=4.0, step=0.1</range>
        <references>(Proix et al., 2014) Proix T, Bartolomei F, Chauvel P, Bernard C, Jirsa VK. Permittivity coupling across brain regions determines seizure recruitment in partial epilepsy. J Neurosci 2014, 34:15009-21.</references>
        <symbol>K_{s}</symbol>
    </owl:Class>
    


