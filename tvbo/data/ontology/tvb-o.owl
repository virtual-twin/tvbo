        </rdfs:subClassOf>
        <rdfs:label>V_temp_KIE</rdfs:label>
        <identifier>000899</identifier>
        <symbol>V_temp</symbol>
        <value>(-1.0/Cm)*(I_Na+I_K+I_Cl+I_pump)</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/V_thre_e_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/V_thre_e_ZAFO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_unit"/>
