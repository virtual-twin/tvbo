            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/d_rs_ERS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tau_rs_ERS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x_rs_ERS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/y_rs_ERS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>y_rsdot_ERS</rdfs:label>
        <category>TimeDerivative</category>
        <identifier>001594</identifier>
        <symbol>y_rsdot</symbol>
        <value>d_rs * (a_rs + b_rs * x_rs - beta_rs * y_rs) / tau_rs</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ydot_E3DSM -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ydot_E3DSM">
