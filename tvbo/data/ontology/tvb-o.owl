                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>U_ZJ</rdfs:label>
        <skos:definition>Maximum firing rate to the stellate population [ms^-1].
        (External stimulus. Constant intensity.Entry point for coupling.)</skos:definition>
        <skos:definition>Maximum firing rate to the stellate population [ms^-1]. (External stimulus. Constant intensity.Entry point for coupling.)</skos:definition>
        <category>Parameter</category>
        <defaultValue>0.12</defaultValue>
        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.12</defaultValue>
        <identifier>000860</identifier>
        <range>lo=0.0, hi=0.35, step=0.01</range>
        <range>lo=0.0, hi=0.350, step=0.01</range>
        <symbol>U</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/U_e_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/U_e_ZAFO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder"/>
        <rdfs:label>U_e_ZAFO</rdfs:label>
