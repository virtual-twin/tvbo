                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/s_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tau_0_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tt_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x0_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x1_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/z_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_derivative_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/z_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>zdot_E5D</rdfs:label>
        <skos:definition>Derivative of the state-variable z_E5D of the Epileptor5D with respect to time.</skos:definition>
        <category>Time Derivative</category>
        <category>TimeDerivative</category>
        <equation>Equation of zdot_E5D.

::math
\dot{z} &amp;=&amp;
            \begin{cases}
                        1 / \tau_{0}(s (x_{1} - x_{0}) - z -0.1 z^{7}) &amp; \text{if} z&lt;0 \\
                        1 / \tau_{0}(s (x_{1} - x_{0}) - z) &amp; \text{if } &amp; \text{if} z \geq 0
            \end{cases} \\

if modification:
            \dot{z} &amp;=&amp;  tt (1 / \tau_{0} (x_{0} + 3. / (1. + exp(- (x_{1} + 0.5) / 0.1)) - z))</equation>
        <identifier>001608</identifier>
        <symbol>zdot</symbol>
        <value>tt * (r * (h - z + Ks * c_pop0))</value>
    </owl:Class>
    


