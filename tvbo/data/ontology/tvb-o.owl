        <defaultValue>1.4</defaultValue>
        <identifier>001506</identifier>
        <range>lo=0.0, hi=2.0, step=0.01</range>
        <references>(Deco et al., 2014) Deco G, Ponce-Alvarez A, Hagmann P, Romani GL, Mantini D, Corbetta M. How local excitation–inhibition ratio impacts the whole-brain dynamics. J Neurosci, 2014 34(23): 7886-7898.</references>
        <shortName>E-E coupling</shortName>
        <symbol>w_p</symbol>
        <synonym>w+</synonym>
        <synonym>w_+</synonym>
        <synonym>w_EE</synonym>
        <synonym>w_plus</synonym>
        <tvbSourceVariable>w_p</tvbSourceVariable>
