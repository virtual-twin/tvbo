        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/theta_HOP"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/c_pop1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tauT_HOP"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/theta_HOP"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_derivative_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/theta_HOP"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>thetadot_HOP</rdfs:label>
        <skos:definition>Derivative of theta_i_HOP by time.</skos:definition>
        <equation>::math

 \dot{\\theta_{i}} &amp;= 1 / \tau_{\theta} (-\theta_{i} + c_1(i))</equation>
        <identifier>001475</identifier>
        <symbol>\dot{\theta}</symbol>
        <synonym>d(theta_i_HOP)</synonym>
        <value>(- theta + c_pop1) / tauT</value>
    </owl:Class>
    


