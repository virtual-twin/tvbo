    <!-- https://w3id.org/tvbo/T_V_e_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/T_V_e_ZAFO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/T_V_ZAFO"/>
        <rdfs:label>T_V_e_ZAFO</rdfs:label>
        <category>Function</category>
        <identifier>000830</identifier>
        <value>(fe_e * (U_e_e * tau_e) ** 2 + fi_e * (U_i_e * tau_i) ** 2) / (fe_e * (U_e_e * tau_e) ** 2 / (tau_e + T_m_e) + fi_e * (U_i_e * tau_i) ** 2 / (tau_i + T_m_e))</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/T_V_i_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/T_V_i_ZAFO">
