        </rdfs:subClassOf>
        <rdfs:label>a_1_JR</rdfs:label>
        <skos:altLabel>alpha1</skos:altLabel>
        <skos:definition>Average probability constant of the number of synapses made by the pyramidal cells to the dendrites of the excitatory interneurons  (feedback excitatory loop). It characterizes the connectivity between the PCs and EINs.</skos:definition>
        <category>Parameter</category>
        <defaultValue>1.0</defaultValue>
        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</defaultValue>
        <identifier>000953</identifier>
        <range>lo=0.5, hi=1.5, step=0.1</range>
        <shortName>P-E coupling</shortName>
        <symbol>\alpha_1</symbol>
        <synonym>(C1_JR)/(J_JR)</synonym>
        <synonym>a1</synonym>
        <tvbSourceVariable>a_1</tvbSourceVariable>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/a_2_JR -->

    <owl:Class rdf:about="https://w3id.org/tvbo/a_2_JR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/InternalCoupling"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/JansenRit"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/sigm_y0_1_JR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/y4dot_JR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>a_2_JR</rdfs:label>
        <skos:altLabel>alpha2</skos:altLabel>
        <skos:definition>Average probability constant of the number of synapses made by the EINs to the dendrites of the PCs. It characterizes the excitatory connectivity between the EINs and PCs.</skos:definition>
        <skos:definition>Average probability of synaptic contacts in the slow feedback excitatory loop.</skos:definition>
        <category>Parameter</category>
        <defaultValue>0.8</defaultValue>
        <identifier>000954</identifier>
        <range>lo=0.4, hi=1.2, step=0.1</range>
        <references>Jansen BH, Zouridakis G, and Brandt M. A neurophysiologically-based mathematical model of flash visual evoked potentials. Biol. Cybern. 68, 275:283, 1993. https://doi.org/10.1007/BF00224863

(Jansen &amp; Rit, 1995) Jansen BH and Rit VG. Electroencephalogram and visual evoked potential generation in a mathematical model of coupled cortical columns. Biol. Cybern. 73, 357:366, 1995.</references>
        <shortName>E-P coupling</shortName>
        <symbol>\alpha_2</symbol>
        <synonym>(C2_JR)/(J_JR)</synonym>
        <synonym>(c31_JR)/(J_JR)</synonym>
        <synonym>a2</synonym>
        <tvbSourceVariable>a_2</tvbSourceVariable>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/a_3_JR -->

