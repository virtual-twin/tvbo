    <!-- https://w3id.org/tvbo/Unorm_SJ2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Unorm_SJ2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ReducedSetFitzHughNagumo"/>
        <rdfs:label>Unorm_SJ2D</rdfs:label>
        <skos:definition>Normalized Mode</skos:definition>
