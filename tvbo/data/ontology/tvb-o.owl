                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/gdot_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/gdot_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
