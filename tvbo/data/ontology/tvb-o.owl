        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-4.0</defaultValue>
        <identifier>001500</identifier>
        <range>lo=-20.0, hi=0.0, step=0.01</range>
        <symbol>v_syn</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/w_EE_RWW_EI -->

    <owl:Class rdf:about="https://w3id.org/tvbo/w_EE_RWW_EI">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh"/>
        <dc:description>Excitatory-to-inhibitory connection strength.</dc:description>
        <rdfs:label>w_EE_RWW_EI</rdfs:label>
        <skos:definition>Governs the intra-regional positive feedback from the excitatory population (second input) to the current of the inhibitory population.</skos:definition>
        <identifier>001501</identifier>
        <symbol>w_{EE}</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/w_II_RWW_EI -->

    <owl:Class rdf:about="https://w3id.org/tvbo/w_II_RWW_EI">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh"/>
        <dc:description>inhibitory-to-inhibitory recurrent connection strength</dc:description>
        <rdfs:label>w_II_RWW_EI</rdfs:label>
        <skos:definition>scales the intra-regional inhibitory-to-inhibitory current, which is the third input to the inhibitory population&apos;s input current $I_I$.</skos:definition>
        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</defaultValue>
        <identifier>001502</identifier>
        <symbol>w_{II}</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/w_RWW -->

    <owl:Class rdf:about="https://w3id.org/tvbo/w_RWW">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ReducedWongWang"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ScalingCoefficient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/H_RWW"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
