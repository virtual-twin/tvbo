    <!-- https://w3id.org/tvbo/Orbit -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Orbit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Flow"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/converge_to"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Attractor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Orbit</rdfs:label>
        <skos:definition>Curve in phase space that follow the system&apos;s flow. It is hence a geometric representation of the solution of the system. Orbits converge onto the attractors, the long-term solution of the system.</skos:definition>
        <identifier>000700</identifier>
    </owl:Class>
    


