                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/s_ie_DG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/s_ii_DG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_reference"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Dumont2019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:type>NMM</dc:type>
        <rdfs:label>DumontGutkin</rdfs:label>
        <acronym>DG</acronym>
        <equation>\begin{align}
\dot{r} &amp;= 1/\tau (\Delta/(\pi \tau) + 2 V r)\\\
                    \dot{V} &amp;= 1/\tau (V^2 + \eta + \gamma I - \tau^2 \pi^2 r^2 + \tau g - \tau s)\\\
                    \dot{g} &amp;= 1/\tau_s (-g + J_ r)\\\
                    \dot{s} &amp;= 1/\tau_s (-s) \\
\end{align}</equation>
        <identifier>000170</identifier>
        <symbol>Dumont Gutkin</symbol>
    </owl:Class>
    


