    <!-- https://w3id.org/tvbo/Raw -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Raw">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Monitor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/requires"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/MonitorPeriod"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Raw</rdfs:label>
        <skos:definition>Raw Monitor corresponds to the simplest possible monitors. It does nothing to the simulated data, that is, it just returns all the simulated data, i.e., all state-variables, nodes,  and modes, sampled at the integration time-step.

This provides no data-reduction at all and so, should only be used for short (temporally) simulations. It is primarily of use for verification of models and simulations, as well as for the numerical component of detailed mathematical exploration of the underlying dynamical system.</skos:definition>
        <documentation rdf:resource="http://docs.thevirtualbrain.org/api/tvb.simulator.monitors.html#module-tvb.simulator.monitors.Raw"/>
        <identifier>000762</identifier>
    </owl:Class>
    


