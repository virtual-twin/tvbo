                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/pico"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Picoampere</rdfs:label>
        <base10>e-12</base10>
        <identifier>000733</identifier>
        <symbol>p</symbol>
    </owl:Class>
    


