            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NMDAGlutamateReceptorActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_reference"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/DPA_2013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>S_RWW</rdfs:label>
        <skos:definition>State-variable of the Reduced WongWang model, denoting the average, (NMDAR)-mediated synaptic gating, i.e., the fraction of open synaptic NMDA channels of neurons in the population (Deco et al., 2013).</skos:definition>
        <category>State Variable</category>
        <category>StateVariable</category>
        <identifier>000773</identifier>
        <references>Deco G, Ponce-Alvarez A, Mantini D, Romani GL, Hagmann P, Corbetta M (2013) Resting-State Functional Connectivity Emerges from Structurally and Dynamically Shaped Slow Linear Fluctuations. J Neurosci 33 (27) 11239-52. https://doi.org/10.1523/JNEUROSCI.1091-13.2013</references>
        <stateVariableBoundaries>0.0, 1.0</stateVariableBoundaries>
        <stateVariableRange>0.0, 1.0</stateVariableRange>
        <subcategory>Synaptic Gating</subcategory>
        <symbol>S</symbol>
    </owl:Class>
    


