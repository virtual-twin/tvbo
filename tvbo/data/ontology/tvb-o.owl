    <!-- https://w3id.org/tvbo/g_G2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/g_G2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/DynamicalParameter"/>
