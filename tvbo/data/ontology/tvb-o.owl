        <skos:definition>Inhibitory population external input scaling weight</skos:definition>
        <skos:definition>Inhibitory scaling parameter of the effective external input (Deco et al., 2014).</skos:definition>
        <category>Parameter</category>
        <defaultValue>0.7</defaultValue>
        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</defaultValue>
        <identifier>000924</identifier>
        <range>lo=0.0, hi=1.0, step=0.01</range>
        <references>(Deco et al., 2014) Deco G, Ponce-Alvarez A, Hagmann P, Romani GL, Mantini D, Corbetta M. How local excitation–inhibition ratio impacts the whole-brain dynamics. J Neurosci, 2014 34(23): 7886-7898.</references>
        <symbol>W_I</symbol>
        <tvbSourceVariable>W_i</tvbSourceVariable>
    </owl:Class>
    


