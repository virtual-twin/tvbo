        <rdfs:label>sigma_EEG</rdfs:label>
        <skos:definition>&apos;When a projection matrix is not used, this provides the value of conductivity in the formula for the single sphere approximation of the head (Sarvas 1987).&apos;</skos:definition>
        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</defaultValue>
        <identifier>001390</identifier>
        <symbol>\sigma</symbol>
        <synonym>Conductivity</synonym>
        <synonym>w/o projection</synonym>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/sigma_SJ2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/sigma_SJ2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ExcitabilityVariance"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ReducedSetFitzHughNagumo"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>sigma_SJ2D</rdfs:label>
        <skos:definition>Standard deviation of Gaussian distribution</skos:definition>
        <skos:definition>Standard deviation of Gaussian distribution of membrane excitability for both masses.</skos:definition>
