                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/regulationOfActionPotentialFiringThreshold"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>v0_JR</rdfs:label>
        <skos:definition>Average firing threshold (PSP) for which half of the firing rate is achieved.

Note:
- The usual value for this parameter is 6.0 (Jansen et al., 1993; Jansen &amp; Rit, 1995).</skos:definition>
        <skos:definition>Firing threshold (PSP) for which a 50% firing rate is achieved. In other words, it is the value of the average membrane potential corresponding to the inflection point of the sigmoid [mV]. The usual value for this parameter is 6.0.</skos:definition>
        <category>Parameter</category>
        <defaultValue>5.52</defaultValue>
        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.52</defaultValue>
        <identifier>001484</identifier>
        <range>lo=3.12, hi=6.0, step=0.02</range>
        <references>Jansen BH, Zouridakis G, and Brandt M. A neurophysiologically-based mathematical model of flash visual evoked potentials. Biol. Cybern. 68, 275:283, 1993. https://doi.org/10.1007/BF00224863

(Jansen &amp; Rit, 1995) Jansen BH and Rit VG. Electroencephalogram and visual evoked potential generation in a mathematical model of coupled cortical columns. Biol. Cybern. 73, 357:366, 1995.</references>
        <symbol>v_0</symbol>
        <synonym>lamda0_JR</synonym>
        <synonym>nu0</synonym>
        <tvbSourceVariable>v0</tvbSourceVariable>
        <unit>mV</unit>
    </owl:Class>
    


