    <owl:Class rdf:about="https://w3id.org/tvbo/F_E3DSM">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EpileptorCodim3SlowMod"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
