            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Wdot_LB"/>
            </owl:Restriction>
