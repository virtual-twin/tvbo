                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/eta_GSKSF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tau_A_GSKSF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tau_GSKSF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/A_GSKSF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/B_GSKSF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_GSKSF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/r_GSKSF"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_reference"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Gast2020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:type>NMM</dc:type>
        <rdfs:label>GastSchmidtKnosche_SF</rdfs:label>
        <acronym>GSKSF</acronym>
        <equation>\begin{align}
\dot{r} &amp;= 1/\tau (\Delta/(\pi \tau) + 2 V r)\\\
                    \dot{V} &amp;= 1/\tau (V^2 - \tau^2 \pi^2 r^2 + \eta + J \tau r - A + I)\\\
                    \dot{A} &amp;= 1/\tau_A (B)\\\
                    \dot{B} &amp;= 1/\tau_A (-2 B - A + \alpha r) \\
\end{align}</equation>
        <identifier>000522</identifier>
        <symbol>Gast Schmidt Knosche SF</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Gaussiankernel -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Gaussiankernel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/LocalConnectivityKernel"/>
        <rdfs:label>Gaussian kernel</rdfs:label>
        <rdfs:label>Gaussiankernel</rdfs:label>
        <skos:definition>Gaussian kernel</skos:definition>
        <equation>(amp * exp(-((var-midpoint)**2 / (2.0 * sigma**2))))+offset</equation>
        <identifier>000523</identifier>
    </owl:Class>
    


