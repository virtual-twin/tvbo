                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x1_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>gdot_E5D</rdfs:label>
        <skos:definition>Derivative of the sixth state-variable g_E5D of the Epileptor5D with respect to time.</skos:definition>
        <category>Time Derivative</category>
        <category>TimeDerivative</category>
        <equation>Equation of gdot_E5D.

math::
\dot{g} &amp;=&amp; tt (-gamma (g - 0.1 x_{1}))</equation>
        <identifier>001190</identifier>
        <symbol>gdot</symbol>
        <value>tt * (-0.01 * (g - 0.1 * x1))</value>
    </owl:Class>
    


