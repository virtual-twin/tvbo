        <skos:definition>Excitatory population external input scaling weight</skos:definition>
        <skos:definition>Excitatoty scaling parameter of the effective external input (Deco et al., 2014).</skos:definition>
        <category>Parameter</category>
        <defaultValue>1.0</defaultValue>
