    <!-- https://w3id.org/tvbo/TimeDelays -->

    <owl:Class rdf:about="https://w3id.org/tvbo/TimeDelays">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/GlobalConnectivity"/>
        <rdfs:subClassOf>
