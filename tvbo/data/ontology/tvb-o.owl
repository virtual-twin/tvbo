            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>J_i_RWW_EI</rdfs:label>
        <skos:definition>Local feedback inhibitory synaptic coupling to the excitatory population firing rate IE (Deco et al., 2014).</skos:definition>
        <skos:definition>[nA] Local inhibitory current</skos:definition>
        <category>Parameter</category>
        <defaultValue>1.0</defaultValue>
        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</defaultValue>
        <dynamicsExploration>J is 1 for each brain area i in the no-FIC case, and for the FIC case it is adjusted independently, by the algorithm described in DPA_2014.</dynamicsExploration>
        <identifier>000605</identifier>
        <range>lo=0.001, hi=2.0, step=0.001</range>
        <references>(Deco et al., 2014) Deco G, Ponce-Alvarez A, Hagmann P, Romani GL, Mantini D, Corbetta M. How local excitation–inhibition ratio impacts the whole-brain dynamics. J Neurosci, 2014 34(23): 7886-7898.</references>
        <symbol>J</symbol>
        <synonym>w_IE</synonym>
        <tvbSourceVariable>J_i</tvbSourceVariable>
    </owl:Class>
    


