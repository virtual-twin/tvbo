    <!-- https://w3id.org/tvbo/CorticalSurface -->

    <owl:Class rdf:about="https://w3id.org/tvbo/CorticalSurface">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/LocalConnectivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/CorticalSurfaceReconstruction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:description>Cortical Surface is a realistic folded human cortical surface represented by a two-dimensional surface embedded in three-dimensional space and discretely described by an ordered set of vertices, spanning triangles connected into a mesh.</dc:description>
        <rdfs:label>CorticalSurface</rdfs:label>
        <identifier>000129</identifier>
