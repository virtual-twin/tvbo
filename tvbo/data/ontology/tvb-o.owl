                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/nu_stop_CD3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x_CD3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/y_CD3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/z_CD3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_reference"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Saggio2017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:type>NMM</dc:type>
        <rdfs:label>EpileptorCodim3</rdfs:label>
        <skos:definition>The Epileptor Codim 3 (CD3) model is a phenomenological neural mass model


It contains two subsystems acting on different timescales:
- for the fast subsystem, we use the unfolding of a degenerate Takens-Bogdanov bifucation of codimension 3.
- he slow subsystem steers the fast one back and forth along paths leading to bursting behavior.

The model is able to produce almost all the classes of bursting predicted for systems with a planar fast subsystem.



Note:
- Equations and default parameters are taken from (Saggio et al., 2017),
- The default model parameters correspond to class c2s.</skos:definition>
        <acronym>CD3</acronym>
        <equation>Equations of the Epileptor Codim 3.</equation>
        <equation>\begin{align}
\dot{x} &amp;= -y \\\
                \dot{y} &amp;= x^3 - \mu_{2} x - \mu_{1} - y(\nu + b x + x^2) \\\
                \dot{z} &amp;= -c(\sqrt{x-x_{s}^2+y^2} - d^*)
\end{align}</equation>
        <identifier>000260</identifier>
        <references>(Saggio et al., 2017) Saggio ML, Spiegler A, Bernard C, Jirsa VK. Fast–Slow Bursters in the Unfolding of a High Codimension Singularity and the Ultra-slow Transitions of Classes. J of Math Neurosci. 2017;7:7. doi:10.1186/s13408-017-0050-8.</references>
        <sourcecode rdf:resource="https://github.com/the-virtual-brain/tvb-root/blob/master/tvb_library/tvb/simulator/models/epileptorcodim3.py"/>
        <symbol>EpileptorCodim3</symbol>
        <tutorial rdf:resource="https://github.com/the-virtual-brain/tvb-root/blob/master/tvb_documentation/demos/exploring_the_epileptor_codim_3_model.ipynb"/>
        <wiki rdf:resource="https://gitlab.com/BrainSimulation/tvb-ontology/-/wikis/Wiki/Neural-Mass-Models/Epileptor/Epileptor-Codim-3"/>
    </owl:Class>
    


