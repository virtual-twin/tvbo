                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/H_RWW"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_function_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/H_RWW"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/H_RWW"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NMDAGlutamateReceptorActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_reference"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/DPA_2013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>x_RWW</rdfs:label>
        <skos:definition>(NMDAR)-mediated synaptic input current to the neurons population (Deco et al., 2013).</skos:definition>
        <category>Derived Variable</category>
        <category>Function</category>
        <equation>x_k       &amp;=   w\,J_N \, S_k + I_o + J_N \mathbf\Gamma(S_k, S_j, u_{kj})</equation>
        <identifier>001530</identifier>
        <references>Deco G, Ponce-Alvarez A, Mantini D, Romani GL, Hagmann P, Corbetta M (2013) Resting-State Functional Connectivity Emerges from Structurally and Dynamically Shaped Slow Linear Fluctuations. J Neurosci 33 (27) 11239-52. https://doi.org/10.1523/JNEUROSCI.1091-13.2013</references>
        <subcategory>Input Current</subcategory>
        <symbol>x</symbol>
        <synonym>x_k</synonym>
        <unit>nA</unit>
        <value>w*J_N*S+I_o+J_N*c_pop0+J_N*local_coupling*S</value>
    </owl:Class>
    


