    <!-- https://w3id.org/tvbo/zdot_E2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/zdot_E2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeDerivative"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/z_E2D"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/h_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Ks_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/c_pop0"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/h_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/r_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tau0_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tt_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x1_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/z_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_derivative_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/z_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>zdot_E2D</rdfs:label>
        <skos:definition>Derivative of the second state-variable z_E2D of the Epileptor2D with respect to time.</skos:definition>
        <category>Time Derivative</category>
        <category>TimeDerivative</category>
        <equation>Equations of z_E2D.

math::
\dot{z} &amp;=&amp; tt*
            \begin{cases}
                        1 / \tau_{0} (h(x) - z -0.1 z^{7}) &amp; \text{if} z&lt;0
                        1 / \tau_{0} (h(x) - z) &amp; \text{if } &amp; \text{else}
            \end{cases}

with
math::
            h(x) = x_{0} + 3 / (exp((x + 0.5)/0.1)) &amp; \text{if modification }
            h(x) = s (x - x_{0}) &amp; \text{else}</equation>
        <identifier>001606</identifier>
        <references>(Proix et al., 2014) Proix, T.; Bartolomei, F; Chauvel, P; Bernard, C; Jirsa, V.K. Permittivity coupling across brain regions determines seizure recruitment in partial epilepsy. J Neurosci 2014, 34:15009-21.</references>
        <symbol>zdot</symbol>
        <synonym>d(z_E2D)</synonym>
        <value>tt * (r * (h - z + Ks * c_pop0))</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/zdot_E3DSM -->

    <owl:Class rdf:about="https://w3id.org/tvbo/zdot_E3DSM">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/z_E3DSM"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/c_E3DSM"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>zdot_E3DSM</rdfs:label>
        <category>Function</category>
        <identifier>001607</identifier>
        <symbol>zdot</symbol>
        <value>-c * (numpy.sqrt((x - xs) ** 2 + y ** 2) - dstar + modification * 0.1 * (z - 0.5) ** 7 + Ks * coupling[0])</value>
    </owl:Class>
    


