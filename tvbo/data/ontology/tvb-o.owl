                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_G2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/W_G2D"/>
            </owl:Restriction>
