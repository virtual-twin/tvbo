            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x1_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/f_1_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x1cond_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>slope_E5D</rdfs:label>
        <skos:definition>Linear coefficient in the first state variable</skos:definition>
        <skos:definition>Linear coefficient in the first state-variable x1_E5D via the coupling function f1(x1, x2)_E5D, in Epileptor5D (Jirsa et al.,2014).</skos:definition>
        <category>Constant</category>
        <category>Parameter</category>
        <defaultValue>0.0</defaultValue>
        <identifier>001416</identifier>
        <range>lo=-16.0, hi=6.0, step=0.1</range>
        <references>(Jirsa et al.,2014) Jirsa, VK, Stacey W C, Quilichini P P, Ivanov AI, Bernard C. On the nature of seizure dynamics. Brain, 2014, (137) 8, p: 2210–2230.</references>
        <shortName>Slope parameter</shortName>
        <symbol>slope</symbol>
        <synonym>m</synonym>
    </owl:Class>
    


