    <!-- https://w3id.org/tvbo/HemodynamicResponseFunction -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/HemodynamicResponseFunction">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdf:type rdf:resource="https://w3id.org/tvbo/ObservationModel"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_function_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Time"/>
            </owl:Restriction>
        </rdf:type>
        <has_argument rdf:resource="https://w3id.org/tvbo/t_HRF"/>
        <has_parameter rdf:resource="https://w3id.org/tvbo/alpha1_HRF"/>
        <has_parameter rdf:resource="https://w3id.org/tvbo/alpha2_HRF"/>
        <has_parameter rdf:resource="https://w3id.org/tvbo/beta1_HRF"/>
        <has_parameter rdf:resource="https://w3id.org/tvbo/beta2_HRF"/>
        <has_parameter rdf:resource="https://w3id.org/tvbo/c_HRF"/>
        <rdfs:label>HemodynamicResponseFunction</rdfs:label>
        <acronym>HRF</acronym>
        <argument>t</argument>
        <equation>-beta2**(-alpha2)*c*t**(alpha2 - 1)*exp(-t/beta2)/gamma(alpha2) + beta1**(-alpha1)*t**(alpha1 - 1)*exp(-t/beta1)/gamma(alpha1)</equation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/HemodynamicResponseFunctionTVB -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/HemodynamicResponseFunctionTVB">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdf:type rdf:resource="https://w3id.org/tvbo/ObservationModel"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_function_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Time"/>
            </owl:Restriction>
        </rdf:type>
        <has_argument rdf:resource="https://w3id.org/tvbo/var_HRF"/>
        <has_parameter rdf:resource="https://w3id.org/tvbo/tau_f_HRF"/>
        <has_parameter rdf:resource="https://w3id.org/tvbo/tau_s_HRF"/>
        <rdfs:label>HemodynamicResponseFunctionTVB</rdfs:label>
        <acronym>HRF</acronym>
        <argument>var</argument>
        <equation>1/3. * exp(-0.5*(var / tau_s)) * (sin(sqrt(1./tau_f - 1./(4.*tau_s**2)) * var)) / (sqrt(1./tau_f - 1./(4.*tau_s**2)))</equation>
    </owl:NamedIndividual>
    


