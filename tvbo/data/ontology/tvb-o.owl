            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Delta_e_DG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
