    <!-- https://w3id.org/tvbo/Mexicanhatkernel -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Mexicanhatkernel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/LocalConnectivityKernel"/>
        <rdfs:label>Mexican-hat kernel</rdfs:label>
        <rdfs:label>Mexican-hatkernel</rdfs:label>
        <skos:definition>A Mexican-hat function approximated by the difference of Gaussians functions</skos:definition>
        <equation>(amp_1 * exp(-((var-midpoint_1)**2 / (2.0 * sigma_1**2)))) - (amp_2 * exp(-((var-midpoint_2)**2 / (2.0 * sigma_2**2))))</equation>
        <identifier>000664</identifier>
        <synonym>double Gaussian distribution</synonym>
    </owl:Class>
    


