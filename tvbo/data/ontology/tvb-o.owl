                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/H_i_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>x_i_RWW_EI</rdfs:label>
        <skos:definition>Input current to the inhibitory population (Deco et al., 2014).</skos:definition>
        <category>Derived Variable</category>
        <category>Function</category>
        <equation>Expression of II_RWW_EI.

::math
I_{I,i} = W_{I}I_{0} + J_{NMDA}S_{E,i} - S_{I,i} + \lambda J_{NMDA}[G\sum_{j}C_{ij}S_{E,i}]</equation>
        <identifier>001535</identifier>
        <references>(Deco et al., 2014) Deco G, Ponce-Alvarez A, Hagmann P, Romani GL, Mantini D, Corbetta M. How local excitation–inhibition ratio impacts the whole-brain dynamics. J Neurosci, 2014 34(23): 7886-7898.</references>
        <symbol>I_I</symbol>
        <synonym>x_I</synonym>
        <tvbSourceVariable>x_i</tvbSourceVariable>
        <unit>nA</unit>
        <value>a_i*(J_N_S_e-S_i+W_i*I_o+lamda*coupling)-b_i</value>
    </owl:Class>
    


