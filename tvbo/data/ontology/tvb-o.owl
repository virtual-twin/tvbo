        </rdfs:subClassOf>
        <rdfs:label>Q_Z_LB</rdfs:label>
        <skos:altLabel>QZ_LB</skos:altLabel>
        <skos:definition>Average firing rate of the population of IINs, Z.</skos:definition>
        <category>Function</category>
        <functionType>Sigmoid function</functionType>
        <identifier>000745</identifier>
        <identifier>000751</identifier>
        <shortName>Potential-to-rate operator.</shortName>
        <symbol>QZ</symbol>
        <symbol>Q_Z</symbol>
        <synonym>Q_Z_LB</synonym>
        <value>0.5 * Q_Zmax * (1+tanh((Z-Z_T)/delta_Z))</value>
    </owl:Class>
    


