    <!-- https://w3id.org/tvbo/Identity -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Identity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/IntegrationMethod"/>
        <rdfs:label>Identity</rdfs:label>
        <skos:definition>The Identity integrator does not apply any scheme to the provided dfun, only returning its results. This allows the model to determine its stepping scheme directly, and may be used for difference equations and cellular automata.</skos:definition>
        <dX>dX0</dX>
        <identifier>000569</identifier>
        <n_dx rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</n_dx>
    </owl:Class>
    


