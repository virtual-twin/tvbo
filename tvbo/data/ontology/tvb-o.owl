        <equation>(eta_i - a_i * xi_i ** 3 + b_i * xi_i ** 2 - tau_i + K11 * (numpy.dot(xi_k, A_ik) - xi_i) - K12 * (numpy.dot(alpha_k, B_ik) - xi_i) + IE_i + lrc + src)</equation>
