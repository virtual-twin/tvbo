                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tau_G2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_G2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/W_G2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_reference"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Fitzhugh1961"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_reference"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Nagumo1962"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:type>NMM</dc:type>
        <rdfs:label>Generic2dOscillator</rdfs:label>
        <skos:definition>The Generic 2-Dimensional Oscillator (G2D) is a phenomenological, coupled, nonlinear two-dimensional (i.e., two state-variables (&apos;V&apos;, &apos;W&apos;)) oscillatory, neural mass model. The G2D is a generalization of the well-known FitzHugh-Nagumo model (FitzHugh, 1961; Nagumo et. al, 1962), adapted here for reproducing a wilder class of dynamical configurations of physiological phenomena as observed in neuronal population using phase-portrait method.</skos:definition>
        <skos:note>In TVB, the default parameter values are set to an excitable regime with an intrinsic oscillatory frequency of approximately 10 Hz, i.e., in the alpha-range.</skos:note>
        <acronym>G2D</acronym>
        <documentation rdf:resource="http://docs.thevirtualbrain.org/_modules/tvb/simulator/models/oscillator.html"/>
        <fullName>Generic 2-Dimensional Oscillator</fullName>
        <identifier>000524</identifier>
        <references>FitzHugh, R. *Impulses and physiological states in theoretical models of nerve membrane*, Biophysical Journal 1: 445, 1961.

Nagumo, J. et. al, *An Active Pulse Transmission Line Simulating Nerve Axon*, Proceedings of the IRE 50: 2061, 1962.</references>
        <sourcecode rdf:resource="https://github.com/the-virtual-brain/tvb-root/blob/master/tvb_library/tvb/simulator/models/oscillator.py"/>
        <wiki rdf:resource="https://gitlab.com/BrainSimulation/tvb-ontology/-/wikis/Wiki/Neural-Mass-Models/Generic-2-Dimensional-Oscillator"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/GenericLinear -->

    <owl:Class rdf:about="https://w3id.org/tvbo/GenericLinear">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NeuralMassModel"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/PhenomenologicalModel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_cvar"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x_GL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_default_voi"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x_GL"/>
