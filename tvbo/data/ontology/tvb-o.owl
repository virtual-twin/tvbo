    <!-- https://w3id.org/tvbo/Idot_WC -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Idot_WC">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/I_WC"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeDerivative"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Si_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/k_i_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/r_i_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/s_i_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tau_i_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/I_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_derivative_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/I_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Idot_WC</rdfs:label>
        <skos:definition>Derivative of the state-variable I_WC with respect to time (Wilson and Cowan, 1973).</skos:definition>
        <category>TimeDerivative</category>
        <identifier>000571</identifier>
        <symbol>Idot</symbol>
        <value>(-I + (k_i - r_i * I) * s_i) / tau_i</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Idot_ZAFO -->

