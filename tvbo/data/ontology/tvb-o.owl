        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/MathematicalEntity"/>
        <rdfs:label>Parameter</rdfs:label>
        <skos:definition>When modeling dynamically changing state variables, a system&apos;s parameter is a constant quantity. Examples can include a planet&apos;s mass, the Nernst potential of an ion species, or the density of synaptic connections between different neurons.</skos:definition>
        <identifier>000726</identifier>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Patterns -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Patterns">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/DataTypes"/>
        <rdfs:label>Patterns</rdfs:label>
        <identifier>000728</identifier>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PhaseSpace -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PhaseSpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/DifferentialEquation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/consists_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Flow"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>PhaseSpace</rdfs:label>
        <skos:definition>A phase space is the geometric space spanned by all of the system&apos;s equations. If the system has N state variables, its phase space will be dimension N. The system&apos;s state then corresponds to a single point in this space. The differential equation of a system for a single state gives a vector in phase space.</skos:definition>
        <identifier>000729</identifier>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PhenomenologicalModel -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PhenomenologicalModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ModelType"/>
        <rdfs:label>PhenomenologicalModel</rdfs:label>
        <skos:definition>Phenomenological Model defines a simplified, analytical mathematical model that can qualitatively reproduce the dynamics of certain physiological variables, but the connections between physiological measurements and the model&apos;s parameters cannot be made directly.</skos:definition>
        <identifier>000730</identifier>
        <synonym>Abstract Model; Canonical Model; Formal Mathematical Model; Generic Model</synonym>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Phi_LB -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Phi_LB">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/LarterBreakspear"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ScalingCoefficient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/W_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/m_K_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Wdot_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_reference"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Breaksetal_2003_b"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Phi_LB</rdfs:label>
        <skos:definition>Temperature scaling factor.</skos:definition>
        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</defaultValue>
        <identifier>000731</identifier>
        <range>lo=0.3, hi=10.0, step=0.1</range>
        <shortName>Temperature constant</shortName>
        <symbol>\phi</symbol>
        <tvbSourceVariable>phi</tvbSourceVariable>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PhysicalEntity -->

