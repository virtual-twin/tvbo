    <!-- https://w3id.org/tvbo/State -->

    <owl:Class rdf:about="https://w3id.org/tvbo/State">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/PhysicalEntity"/>
        <dc:description>In a network dynamical system, the &quot;state&quot; of a node denotes its condition or value at a particular moment in time. It constitutes a variable that elucidates the node&apos;s internal status and its interactions with other nodes within the network. One may conceptualize it as a snapshot of the node&apos;s properties at a specific point in time.</dc:description>
        <rdfs:label>State</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/StateSpaceReductionMonitors -->

    <owl:Class rdf:about="https://w3id.org/tvbo/StateSpaceReductionMonitors">
