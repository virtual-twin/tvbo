        <identifier>000921</identifier>
        <stateVariableRange>0.0, 200.0</stateVariableRange>
        <symbol>W_e</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/W_edot_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/W_edot_ZAFO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeDerivative"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/W_e_ZAFO"/>
        <rdfs:label>W_edot_ZAFO</rdfs:label>
        <category>TimeDerivative</category>
        <identifier>000922</identifier>
        <symbol>W_edot</symbol>
        <value>(-W_e / tau_w_e + b_e * E + a_e * (mu_V_e - E_L_e) / tau_w_e)</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/W_edot_ZASO -->

