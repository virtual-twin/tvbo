            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/K11_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/K12_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/c_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/e_i_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/eta_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/xi_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_derivative_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/xi_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>xidot_SJ2D</rdfs:label>
        <skos:altLabel>xidot_i_SJ2D</skos:altLabel>
        <skos:definition>derivative of xi_i_SJ2D by time.</skos:definition>
        <category>TimeDerivative</category>
        <equation>c * (xi_i - e_i * xi_i ** 3 / 3.0 - eta_i) + K_11 * (sum(product(setOf(A_ik),setOf(xi_k)) - xi_i) - K_12 * (sum(product(setOf(B_ik),setOf(alpha_k)) - xi_i) + c * (IE_i + lrc + src))</equation>
        <identifier>001551</identifier>
        <symbol>xidot</symbol>
        <value>(tau * (xi - e_i * xi ** 3 / 3.0 - eta) + K11 * (numpy.dot(xi, Aik) - xi) - K12 * (numpy.dot(alpha, Bik) - xi) + tau * (IE_i + c_pop0 + local_coupling * xi))</value>
    </owl:Class>
    


