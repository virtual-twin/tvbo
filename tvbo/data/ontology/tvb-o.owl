                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/alphadot_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/alphadot_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/betadot_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_state_variable_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/alphadot_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_state_variable_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/betadot_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>alpha_SJ2D</rdfs:label>
        <skos:altLabel>alpha_i_SJ2D</skos:altLabel>
        <skos:definition>Membrane potential of inhibitory population at mode i. Fast state variable.</skos:definition>
        <category>StateVariable</category>
        <identifier>000996</identifier>
        <shortName>Inh. membrane potential SV</shortName>
        <stateVariableBoundaries>-4.0, 4.0</stateVariableBoundaries>
        <stateVariableRange>-4.0, 4.0</stateVariableRange>
        <symbol>alpha</symbol>
        <value>(tau * (alpha - f_i * alpha ** 3 / 3.0 - beta) + K21 * (numpy.dot(xi, Cik) - alpha) + tau * (II_i + c_pop0 + local_coupling * xi))</value>
    </owl:Class>
    


