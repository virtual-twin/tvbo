            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_derivative"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/y2dot_E5D"/>
            </owl:Restriction>
