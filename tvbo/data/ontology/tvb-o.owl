                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x1cond_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_state_variable_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x1dot_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_state_variable_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/zcond_E2D"/>
            </owl:Restriction>
