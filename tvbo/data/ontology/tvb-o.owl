    <!-- https://w3id.org/tvbo/stateVariableBoundaries -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/stateVariableBoundaries">
        <rdfs:label>stateVariableBoundaries</rdfs:label>
        <skos:definition>The values for each state-variable should be set to encompass the boundaries of the dynamic range of that state-variable. Set None for one-sided boundaries</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/stateVariableRange -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/stateVariableRange">
        <rdfs:label>stateVariableRange</rdfs:label>
        <skos:definition>The values for each state-variable should be set to encompass the expected dynamic range of that state-variable for the current parameters, it is used as a mechanism for bounding random initial conditions when the simulation isn&apos;t started from an explicit history, it is also provides the default range of phase-plane plots.</skos:definition>
    </owl:AnnotationProperty>
    


