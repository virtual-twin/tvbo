    <!-- https://w3id.org/tvbo/mu1_CD3 -->

    <owl:Class rdf:about="https://w3id.org/tvbo/mu1_CD3">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EpileptorCodim3"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/R_CD3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/z_CD3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>mu1_CD3</rdfs:label>
        <category>Function</category>
        <identifier>001241</identifier>
        <symbol>mu1</symbol>
        <value>R * (E0 * numpy.cos(z) + F0 * numpy.sin(z))</value>
    </owl:Class>
    


