    <!-- https://w3id.org/tvbo/a_G2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/a_G2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/DynamicalParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Excitability"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Generic2dOscillator"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Wdot_G2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>a_G2D</rdfs:label>
        <skos:definition>Vertical shift of the configurable nullcline</skos:definition>
        <skos:definition>a_G2D is a constant parameter in the second state-equation Wdot_G2D.

This constant shifts the configurable W_G2D nullclines in the phase-plane with respect to the x-axis, allowing to scale the damping of the oscillations.</skos:definition>
        <category>Parameter</category>
        <defaultValue>-2.0</defaultValue>
        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-2</defaultValue>
        <identifier>000961</identifier>
        <range>lo=-5.0, hi=5.0, step=0.01</range>
        <symbol>a</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/a_JR -->

    <owl:Class rdf:about="https://w3id.org/tvbo/a_JR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/JansenRit"/>
