    <!-- https://w3id.org/tvbo/nu_max_JR -->

    <owl:Class rdf:about="https://w3id.org/tvbo/nu_max_JR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ExcitationBound"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/JansenRit"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TransferSigmoidFunctionProperties"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/sigm_y0_3_JR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/sigm_y0_1_JR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/sigm_y0_3_JR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/sigm_y1_y2_JR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>nu_max_JR</rdfs:label>
        <skos:definition>Asymptotic of the sigmoid function Sigm_JR corresponds to the maximum firing rate of the neural populations.</skos:definition>
        <skos:definition>Determines the maximum firing rate of the neural population.</skos:definition>
        <category>Parameter</category>
        <defaultValue>0.0025</defaultValue>
        <identifier>001287</identifier>
        <range>lo=0.00125, hi=0.00375, step=0.00001</range>
        <range>lo=0.00125, hi=0.00375, step=1e-05</range>
        <references>Jansen BH, Zouridakis G, and Brandt M. A neurophysiologically-based mathematical model of flash visual evoked potentials. Biol. Cybern. 68, 275:283, 1993. https://doi.org/10.1007/BF00224863

(Jansen &amp; Rit, 1995) Jansen BH and Rit VG. Electroencephalogram and visual evoked potential generation in a mathematical model of coupled cortical columns. Biol. Cybern. 73, 357:366, 1995.</references>
        <symbol>\nu_{max}</symbol>
