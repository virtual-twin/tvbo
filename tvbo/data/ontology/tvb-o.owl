    <!-- https://w3id.org/tvbo/alphadot_SJ2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/alphadot_SJ2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeDerivative"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/alpha_SJ2D"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/depends_on"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/GlobalConnectivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/depends_on"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/LocalConnectivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/II_i_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/K21_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/c_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/f_i_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/alpha_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/beta_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_derivative_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/alpha_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>alphadot_SJ2D</rdfs:label>
        <skos:altLabel>alphadot_i_SJ2D</skos:altLabel>
        <skos:definition>Derivative of alpha_i_SJ2D by time</skos:definition>
        <category>TimeDerivative</category>
        <equation>(c * (alpha_i - f_i * alpha_i ** 3 / 3.0 - beta_i) + K_21 * (sum(product(setOf(C_ik),setOf(xi_k) - alpha_i) + c * (II_i + lrc + src))</equation>
        <identifier>001002</identifier>
        <symbol>alphadot</symbol>
        <value>(tau * (alpha - f_i * alpha ** 3 / 3.0 - beta) +</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/alphadot_SJ3D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/alphadot_SJ3D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeDerivative"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/alpha_SJ3D"/>
        <rdfs:label>alphadot_SJ3D</rdfs:label>
        <category>TimeDerivative</category>
        <identifier>001003</identifier>
        <symbol>alphadot</symbol>
        <value>(beta - e_i * alpha ** 3 + f_i * alpha ** 2 - gamma +</value>
    </owl:Class>
    


