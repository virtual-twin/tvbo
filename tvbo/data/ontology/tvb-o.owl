        <category>TimeDerivative</category>
        <identifier>001039</identifier>
        <symbol>\dot{beta}</symbol>
        <value>(alpha - b * beta + n_i) / tau</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/betadot_SJ3D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/betadot_SJ3D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeDerivative"/>
