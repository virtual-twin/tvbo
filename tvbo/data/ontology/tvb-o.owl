                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_CB2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_default_voi"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/r_CB2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Delta_CB2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/eta_CB2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/k_CB2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/v_syn_CB2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_CB2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/r_CB2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_reference"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Byrne2020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:type>NMM</dc:type>
        <rdfs:label>CoombesByrne2D</rdfs:label>
        <acronym>CB2D</acronym>
        <equation>\begin{align}
\dot{r} &amp;= \Delta/\pi + 2 V r - g r^2\\\
                   \dot{V} &amp;= V^2 - \pi^2 r^2 + \eta + (v_{syn} - V) g \\\
                   g &amp;= \kappa \pi r
\end{align}</equation>
        <identifier>000127</identifier>
        <symbol>Coombes Byrne 2D</symbol>
