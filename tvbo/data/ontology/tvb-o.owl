    </owl:Class>
    


    <!-- https://w3id.org/tvbo/fe_e_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/fe_e_ZAFO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/E_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/N_tot_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/g_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/p_connect_e_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>fe_e_ZAFO</rdfs:label>
        <category>Function</category>
        <identifier>001145</identifier>
        <value>(E + 10**-6) * (1.0 - g) * p_connect_e * N_tot + (Fe_ext + external_input_ex_ex) * K_ext_e</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/fe_i_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/fe_i_ZAFO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
