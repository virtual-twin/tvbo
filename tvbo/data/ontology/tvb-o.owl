            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>b_LB</rdfs:label>
        <skos:definition>Time constant scaling factor.</skos:definition>
        <category>Parameter</category>
        <defaultValue>0.1</defaultValue>
        <identifier>001017</identifier>
        <range>lo=0.0001, hi=1.0, step=0.0001</range>
        <symbol>b</symbol>
        <tvbSourceVariable>b</tvbSourceVariable>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/b_RWW -->

    <owl:Class rdf:about="https://w3id.org/tvbo/b_RWW">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ReducedWongWang"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SpikingRateThreshold"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TransferSigmoidFunctionProperties"/>
