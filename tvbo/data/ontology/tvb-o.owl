                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/z_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_function_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x1dot_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>f_1_E5D</rdfs:label>
        <skos:definition>Linear inhibitory coupling function from the sub-population (x2_E5D, y2_E5D) to (x1_E5D, y1_E5D) in Epileptor5D (Jirsa et al.,2014).

This coupling function has been introduced in the uncoupled model (i.e., zero coupling between the two sub-populations) in order for the very fast discharges to occur only during the wave of the spike-and-wave events.</skos:definition>
        <category>Derived Variable</category>
        <equation>Expression of the coupling f1_E5D.

::math
 f_{1}(x_{1}, x_{2}) =
            \begin{cases}
                        a1 x_{1}^{3} - b1 x_{1}^2 &amp; \text{if} x_{1} &lt;0 \\
                        -(slope - x_{2} + 0.6 (z - 4)^2) x_{1} &amp; \text{if} x_{1} \geq 0
            \end{cases}</equation>
        <identifier>001136</identifier>
        <references>(Jirsa et al.,2014) Jirsa, VK, Stacey W C, Quilichini P P, Ivanov AI, Bernard C. On the nature of seizure dynamics. Brain, 2014, (137) 8, p: 2210–2230.</references>
        <symbol>f_1</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/f_2_E5D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/f_2_E5D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Epileptor5D"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_argument"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x2_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/aa_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x2_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_function_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/y2dot_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>f_2_E5D</rdfs:label>
        <skos:definition>Discontinuous function to the sub-population (x2_E5D, y2_E5D) in Epileptor5D (Jirsa et al.,2014).</skos:definition>
        <category>Derived Variable</category>
        <equation>Expression of f2_E5D.

::math
f_{2}(x_{2}) =
            \begin{cases}
                        0 &amp; \text{if} x_{2} &lt;-0.25 \\
                        a_{2}(x_{2} + 0.25) &amp; \text{if} x_{2} \geq -0.25
            \end{cases}</equation>
        <identifier>001137</identifier>
        <references>(Jirsa et al.,2014) Jirsa, VK, Stacey W C, Quilichini P P, Ivanov AI, Bernard C. On the nature of seizure dynamics. Brain, 2014, (137) 8, p: 2210–2230.</references>
        <symbol>f_2</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/f_E2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/f_E2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Epileptor2D"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_argument"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x1_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/a_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/b_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/d_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/slope_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x1_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/z_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_function_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x1dot_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>f_E2D</rdfs:label>
        <category>State Variable</category>
        <equation>math::
            f(x) =
                 \begin{cases}
                        ax^{3} + (d- b) x^{2} &amp; \text{if} x &lt;0 \\
                        -(slope + 0.6 (z - 4)^2) x + dx^{2} &amp; \text{else}
                 \end{cases}</equation>
        <identifier>001138</identifier>
        <references>(Proix et al., 2014) Proix, T.; Bartolomei, F; Chauvel, P; Bernard, C; Jirsa, V.K. Permittivity coupling across brain regions determines seizure recruitment in partial epilepsy. J Neurosci 2014, 34:15009-21.</references>
        <symbol>f</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/f_G2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/f_G2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/DynamicalParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Generic2dOscillator"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_G2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Vdot_G2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>f_G2D</rdfs:label>
        <skos:definition>Coefficient of the cubic term of the cubic nullcline.</skos:definition>
        <skos:definition>f_G2D is the coefficient of the cubic V_G2D term in the first state-equation Vdot_G2D.

This coefficient affects the steepness of the N-shaped cubic V_G2D-nullcline in the phase-plane. When f_G2D is small, the cubic is steeper, and when f_G2D is large, it is flatter. While, when &apos;f_G2D &lt; 0&apos;, the cubic is inverted.</skos:definition>
        <category>Parameter</category>
        <defaultValue>1.0</defaultValue>
        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</defaultValue>
        <identifier>001139</identifier>
        <range>lo=-5.0, hi=5.0, step=0.0001</range>
        <symbol>f</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/f_i_SJ2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/f_i_SJ2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ReducedSetFitzHughNagumo"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/alphadot_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>f_i_SJ2D</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the inhibitory cubic nullcline at mode i. Is derived from the Gaussian parameter distribution.</skos:definition>
        <category>Derived parameter</category>
        <identifier>001140</identifier>
        <symbol>f_i</symbol>
        <value>trapz(cU * U ** 3, Zu, axis=1)[numpy.newaxis, :]</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/f_i_SJ3D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/f_i_SJ3D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NullclineProperties"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ReducedSetHindmarshRose"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/sq(alpha_i_SJ3D)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/alphadot_SJ3D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/alphadot_i_SJ3D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>f_i_SJ3D</rdfs:label>
        <category>Derived Parameter</category>
        <identifier>001141</identifier>
        <shortName>Ion channel factor</shortName>
        <symbol>f_i</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/f_out_e_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/f_out_e_ZAFO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_thre_e_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/mu_V_e_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/sigma_V_e_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Edot_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_dependency"/>
                <owl:hasValue>scipy.special.erfc</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>f_out_e_ZAFO</rdfs:label>
        <category>Function</category>
        <identifier>001142</identifier>
        <value>erfc((V_thre_e - mu_V_e) / (numpy.sqrt(2) * sigma_V_e)) / (2 * T_V_e)</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/f_out_i_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/f_out_i_ZAFO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_thre_i_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/mu_V_i_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/sigma_V_i_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/W_edot_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_dependency"/>
                <owl:hasValue>scipy.special.erfc</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>f_out_i_ZAFO</rdfs:label>
        <category>Function</category>
        <identifier>001143</identifier>
        <value>erfc((V_thre_i-mu_V_i)/(numpy.sqrt(2)*sigma_V_i))/(2 * T_V_i)</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/f_rs_ERS -->

    <owl:Class rdf:about="https://w3id.org/tvbo/f_rs_ERS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EpileptorRestingState"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Generic_2D_ERS"/>
