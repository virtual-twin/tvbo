        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder"/>
        <rdfs:label>TvN0_ZAFO</rdfs:label>
        <skos:definition>Normalization factors page 48 after the equation 4 from [ZD_2018]</skos:definition>
        <category>Parameter</category>
        <defaultValue>0.5</defaultValue>
        <identifier>000858</identifier>
        <range>None</range>
        <symbol>TvN0_ZAFO</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/U_SJ2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/U_SJ2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ReducedSetFitzHughNagumo"/>
        <rdfs:label>U_SJ2D</rdfs:label>
        <skos:definition>Second Mode</skos:definition>
        <identifier>000859</identifier>
        <symbol>U</symbol>
        <value>numpy.vstack([numpy.roll(numpy.eye(nu // number_of_modes), i, axis=0) for i in range(number_of_modes)])</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/U_ZJ -->

