    <!-- https://w3id.org/tvbo/a_SUPH -->

    <owl:Class rdf:about="https://w3id.org/tvbo/a_SUPH">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/DynamicalParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Excitability"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/SupHopf"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/x_SUPH"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/y_SUPH"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/SupHopf"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/xdot_SUPH"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/ydot_SUPH"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>a_SUPH</rdfs:label>
        <skos:definition>Local bifurcation parameter.</skos:definition>
        <skos:definition>a_SUPH is a constant parameter in the first and second state-equations that allow to scale the damping of the oscillations or the shape of the cubic x_SUPH and y_SUPH nullclines in the phase-plane.

Note:
------
a_SUPH is also a local bifurcation parameter, i.e., where the system&apos;s phase-portrait changes qualitatively.
When &apos;a=0&apos;, the SUPH has a supercritical bifurcation. So for &apos;a &lt; 0&apos;, the local dynamics has a stable fixed point and the system corresponds to a damped oscillatory state, whereas for &apos;a &gt; 0&apos;, the local dynamics enters in a stable limit cycle and the system switches to an oscillatory state.</skos:definition>
        <category>Parameter</category>
        <defaultValue>-0.5</defaultValue>
        <dynamicsExploration rdf:resource="https://www.nature.com/articles/s41598-017-03073-5/figures/5"/>
        <identifier>000966</identifier>
        <range>lo=-10.0, hi=10.0, step=0.01</range>
        <symbol>a</symbol>
    </owl:Class>
    


