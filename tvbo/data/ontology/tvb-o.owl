    <!-- https://w3id.org/tvbo/Edot_WC -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Edot_WC">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/E_WC"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeDerivative"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Se_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/k_e_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/r_e_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/s_e_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/tau_e_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/E_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_derivative_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/E_WC"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Edot_WC</rdfs:label>
        <skos:definition>Derivative of the state-variable E_WC with respect to time (Wilson and Cowan, 1973).</skos:definition>
        <category>TimeDerivative</category>
        <identifier>000186</identifier>
        <symbol>Edot</symbol>
        <value>(-E + (k_e - r_e * E) * s_e) / tau_e</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Edot_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Edot_ZAFO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/E_ZAFO"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeDerivative"/>
        <rdfs:label>Edot_ZAFO</rdfs:label>
        <category>TimeDerivative</category>
        <identifier>000187</identifier>
        <symbol>Edot</symbol>
        <value>(f_out_e - E) / T</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Edot_ZASO -->

