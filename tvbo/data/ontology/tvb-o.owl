    <!-- https://w3id.org/tvbo/Monitor -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Monitor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Simulation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/requires"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/IntegrationStepSize"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/requires"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/MonitorPeriod"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:description>Monitors are the measurement processes implemented in The Virtual Brain that convert the simulated neural activity.
Monitors record significant values from the simulation. In their simplest form they return all the simulated data, Raw(), directly subsampled data, SubSample() spatially averaged temporally subsampled, GlobalAverage(), or temporally averaged subsamples, TemporalAverage(). The more elaborate monitors instantiate a physically realistic measurement process on the simulation, such as EEG, MEG, and fMRI (BOLD).</dc:description>
        <rdfs:label>Monitor</rdfs:label>
        <documentation rdf:resource="http://docs.thevirtualbrain.org/api/tvb.simulator.monitors.html#module-tvb.simulator.monitors"/>
        <identifier>000675</identifier>
        <synonym>Forward model</synonym>
        <synonym>Observation Models</synonym>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/MonitorPeriod -->

    <owl:Class rdf:about="https://w3id.org/tvbo/MonitorPeriod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Monitor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_unit"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Millisecond"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>MonitorPeriod</rdfs:label>
        <skos:definition>Sampling period in milliseconds, must be an integral multiple of integration-step size. As a guide: 2048 Hz =&gt; 0.48828125 ms ; 1024 Hz =&gt; 0.9765625 ms ; 512 Hz =&gt; 1.953125 ms.</skos:definition>
        <defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.9765625</defaultValue>
        <identifier>000676</identifier>
        <synonym>Monitors Sampling Period</synonym>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin -->

    <owl:Class rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/BiologicalModel"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/InfiniteTheta"/>
