    <!-- https://w3id.org/tvbo/Arslan -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Arslan">
        <rdfs:label>Arslan</rdfs:label>
        <skos:definition>A two-level approach that combines k-means with hierarchical clustering. Initially, each hemisphere is parcellated into a set of
1000 supervertices using a method inspired by the SLIC superpixels3. At the second level, a hierarchical tree is constructed
using Ward’s linkage rule4 with Euclidean distance and parcellations for varying number of clusters are obtained by cutting this
tree at different levels.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Ashburner2000 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Ashburner2000">
        <rdf:type rdf:resource="https://w3id.org/tvbo/JournalArticle"/>
        <dc:title>Gene ontology: tool for the unification of biology</dc:title>
        <rdfs:label>Ashburner2000</rdfs:label>
        <author>Ashburner, Michael and Ball, Catherine A and Blake, Judith A and Botstein, David and Butler, Heather and Cherry, J Michael and Davis, Allan P and Dolinski, Kara and Dwight, Selina S and Eppig, Janan T and others</author>
        <identifier>000241</identifier>
        <journal>Nature genetics</journal>
        <pages>25--29</pages>
        <publisher>Nature Publishing Group</publisher>
        <volume>25</volume>
        <year>2000</year>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Bandyopadhyay2021 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Bandyopadhyay2021">
        <rdf:type rdf:resource="https://w3id.org/tvbo/JournalArticle"/>
        <dc:title>Biophysically inspired mean-field model of neuronal populations driven by ion exchange mechanisms</dc:title>
        <rdfs:label>Rabuffo2024</rdfs:label>
        <author>Abhirup Bandyopadhyay and Giovanni Rabuffo and Carmela Calabrese and Kashyap Gudibanda and Damien Depannemaecker and Anton Ivanov and Christophe Bernard and Viktor K. Jirsa and Spase Petkoski</author>
        <doi>10.1101/2021.10.29.466427</doi>
        <identifier>000202</identifier>
        <journal>bioRxiv</journal>
        <publisher>Cold Spring Harbor Laboratory</publisher>
        <year>2022</year>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/BernersLee2001 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/BernersLee2001">
        <rdf:type rdf:resource="https://w3id.org/tvbo/JournalArticle"/>
        <dc:title>The semantic web</dc:title>
        <rdfs:label>BernersLee2001</rdfs:label>
        <author>Berners-Lee, Tim and Hendler, James and Lassila, Ora</author>
        <identifier>000229</identifier>
        <journal>Scientific american</journal>
        <pages>34--43</pages>
        <publisher>JSTOR</publisher>
        <volume>284</volume>
        <year>2001</year>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Blumensath -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Blumensath">
        <rdfs:label>Blumensath</rdfs:label>
        <skos:definition>A two-level method that combines region growing and hierarchical clustering. Each seed vertex is grown into a region (initial
cluster) by an iterative process in which vertices are attached to a region based on their similarity with the neighbouring regions.
After all vertices have been assigned to a cluster, final parcels are obtained by merging adjacent clusters using hierarchical
clustering with Ward’s linkage rule4 and the Euclidean distance, same as in Arslan. However, this approach differs from Arslan
in two ways. (1) Instead of relying on a fixed number of seed vertices to start the parcellation process, it automatically locates
highly homogeneous cortical regions that can be used to compute seed vertices. (2) Instead of using the average timeseries
within a cluster for representation, the average signal is computed from the immediate neighbourhood of a ROI centred at each
cluster’s seed vertex.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Breaksetal_2003_a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Breaksetal_2003_a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/JournalArticle"/>
        <dc:title>Modulation of excitatory synaptic coupling facilitates synchronization and complex dynamics in an nonlinear model of neuronal dynamics</dc:title>
        <rdfs:label>Breaksetal_2003_a</rdfs:label>
        <author>M. Breakspear</author>
        <citationKey>Breaksetal_2003_a</citationKey>
