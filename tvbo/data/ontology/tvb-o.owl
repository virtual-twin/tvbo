        <skos:definition>Coupling Recording Monitor is a raw monitor that records the model&apos;s coupling variables of interest for all the integration time steps.</skos:definition>
        <identifier>000133</identifier>
        <synonym>AfferentCoupling</synonym>
    </owl:Class>
    


