            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Wdot_G2D</rdfs:label>
        <skos:definition>Wdot_G2D is the Time Derivative of the second state-variable, W_G2D, of the Generic 2-Dimensional Oscillator model with respect to time.</skos:definition>
        <category>Time Derivative</category>
        <category>TimeDerivative</category>
        <equation>\dot{W} = \frac{d}{\tau} (c \cdot V^{2} + b \cdot V - \beta \cdot W + a)</equation>
        <identifier>000930</identifier>
        <symbol>\dot{W}</symbol>
        <value>d * (a + b * V + c * V**2 - beta * W) / tau</value>
    </owl:Class>
    


