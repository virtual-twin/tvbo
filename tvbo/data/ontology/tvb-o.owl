    <!-- https://w3id.org/tvbo/W_e_ZASO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/W_e_ZASO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/StateVariable"/>
