    <!-- https://w3id.org/tvbo/e_G2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/e_G2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/DynamicalParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Excitability"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Generic2dOscillator"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_G2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Vdot_G2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/regulation%20of%20resting%20membrane%20potential"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>e_G2D</rdfs:label>
        <skos:definition>Coefficient of the quadratic term of the cubic nullcline.</skos:definition>
        <skos:definition>e_G2D is the coefficient of the quadratic V_G2D term in the first state-equation Vdot_G2D.

This coefficient shifts the N-shaped cubic V_G2D-nullcline in the phase-plane with respect to the x-axis, allowing to scale the damping of the oscillations. e_G2D is thus an excitable parameter that can represent the neural membrane excitability.</skos:definition>
        <category>Parameter</category>
        <defaultValue>3.0</defaultValue>
        <identifier>001113</identifier>
        <range>lo=-5.0, hi=5.0, step=0.0001</range>
        <symbol>e</symbol>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/e_i_SJ2D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/e_i_SJ2D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ReducedSetFitzHughNagumo"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/xidot_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>e_i_SJ2D</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the excitatory cubic nullcline at mode i. Is derived from the Gaussian parameter distribution.</skos:definition>
        <category>Derived parameter</category>
        <identifier>001114</identifier>
        <symbol>e_i</symbol>
        <value>trapz(cV * V ** 3, Zv, axis=1)[numpy.newaxis, :]</value>
    </owl:Class>
    


