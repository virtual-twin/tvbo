                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>S_i_ZAFO</rdfs:label>
        <skos:definition>Scaling of the remote input for the inhibitory population with
        respect to the excitatory population.</skos:definition>
        <skos:definition>Scaling of the remote input for the inhibitory population with respect to the excitatory population.</skos:definition>
        <category>Function</category>
        <category>Parameter</category>
        <defaultValue>1.0</defaultValue>
        <identifier>000778</identifier>
        <range>lo=0., hi=2., step=0.01</range>
        <range>lo=0.0, hi=2.0, step=0.01</range>
        <symbol>S_i</symbol>
        <symbol>S_i_ZAFO</symbol>
        <value>(sigma_V_i-sV0)/DsV0</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/S_idot_RWW_EI -->

    <owl:Class rdf:about="https://w3id.org/tvbo/S_idot_RWW_EI">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/S_i_RWW_EI"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeDerivative"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_function"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/H_i_RWW_EI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
