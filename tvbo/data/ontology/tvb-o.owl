    <!-- https://w3id.org/tvbo/C_LB -->

    <owl:Class rdf:about="https://w3id.org/tvbo/C_LB">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/LarterBreakspear"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf>
