                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/z_E2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_reference"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Proix2014"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_reference"/>
                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Proix2017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:type>NMM</dc:type>
        <rdfs:label>Epileptor2D</rdfs:label>
        <skos:definition>Epileptor2D (E2D) is a phenomenological neural mass model consisting in the two-dimensional reduction (&apos;x&apos;, &apos;z&apos;) of the original Epileptor model (see Epileptor5D; Proix et al., 2014, 2017).

Note:
------
- Equations and default parameters are taken from (Proix et al.,2014),
- The slow permittivity state-variable (z_E2D) can be modified to account for the time difference between the interictal (between seizures) and ictal (during seizure) states (see Proix et al., 2014).</skos:definition>
        <acronym>E2D</acronym>
        <equation>Equations of the Epileptor2D.

math::
\dot{x} &amp;=&amp; tt * (c - f(x) - z + I_{ext}) \\
\dot{z} &amp;=&amp; tt*
            \begin{cases}
                        1 / \tau_{0} (h(x_{1}) - z -0.1 z^{7} - K_{s}*lrc) &amp; \text{if} z&lt;0
                        1 / \tau_{0} (h(x_{1}) - z - K_{s}*lrc) &amp; \text{if} &amp; \text{else}
            \end{cases}

with
math::
            f &amp;=&amp;
             \begin{cases}
                        ax^{3} + (d-b)x^{2} &amp; \text{if} x&lt;0
                        -(slope + 0.6(z - 4)^{2})x + dx^{2} &amp; \text{else}
            \end{cases}

and
math::
            h &amp;=&amp;
             \begin{cases}
                        x_{0} + 3 / (exp((x + 0.5)/0.1)) &amp; \text{if modification }
                        s (x - x_{0}) &amp; \text{else}
            \end{cases}</equation>
        <equation>\begin{align}
\dot{x_{1,i}} &amp;=&amp; - x_{1,i}^{3} - 2x_{1,i}^{2}  + 1 - z_{i} + I_{ext1,i} \\\
            \dot{z_{i}} &amp;=&amp; r(h - z_{i})
\end{align}</equation>
        <identifier>000258</identifier>
        <references>Proix, T.; Bartolomei, F; Chauvel, P; Bernard, C; Jirsa, V.K. Permittivity coupling across brain regions determines seizure recruitment in partial epilepsy. J Neurosci 2014, 34:15009-21.

Proix, T.; Bartolomei, F; Guye, M.; Jirsa, V.K. Individual brain structure and modelling predict seizure propagation. Brain 2017, 140; 641–654.</references>
        <sourcecode rdf:resource="https://github.com/the-virtual-brain/tvb-root/blob/master/tvb_library/tvb/simulator/models/epileptor.py"/>
        <symbol>Epileptor2D</symbol>
        <tutorial rdf:resource="https://github.com/the-virtual-brain/tvb-root/blob/master/tvb_documentation/demos/exploring_epileptor_2d.ipynb"/>
        <wiki rdf:resource="https://gitlab.com/BrainSimulation/tvb-ontology/-/wikis/Wiki/Neural-Mass-Models/Epileptor/Epileptor-2D"/>
    </owl:Class>
    


