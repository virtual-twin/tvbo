                <owl:hasValue rdf:resource="https://w3id.org/tvbo/Galan2008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>GenericLinear</rdfs:label>
        <skos:definition>The Generic Linear (GL) is a phenomenological, linear one-dimensional  (i.e., one state-variable (&apos;x&apos;)) neural mass model (Galán, 2008).</skos:definition>
        <acronym>GL</acronym>
        <documentation rdf:resource="https://docs.thevirtualbrain.org/api/tvb.simulator.models.html#module-tvb.simulator.models.linear"/>
        <equation>Equation of the Generic Linear model.

For all node i,

 (d/dt) x_i = - gamma x_i + lrc + noise</equation>
        <identifier>000525</identifier>
        <sourcecode rdf:resource="https://github.com/the-virtual-brain/tvb-root/blob/master/tvb_library/tvb/simulator/models/linear.py"/>
        <synonym>Linear</synonym>
        <wiki rdf:resource="https://gitlab.com/BrainSimulation/tvb-ontology/-/wikis/Wiki/Neural-Mass-Models/Generic-Linear"/>
    </owl:Class>
    


