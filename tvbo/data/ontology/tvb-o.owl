    </owl:Class>
    


    <!-- https://w3id.org/tvbo/fi_e_ZAFO -->

    <owl:Class rdf:about="https://w3id.org/tvbo/fi_e_ZAFO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/I_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/N_tot_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/g_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/p_connect_i_ZAFO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>fi_e_ZAFO</rdfs:label>
