        <rdfs:label>ydot_E3DSM</rdfs:label>
        <identifier>001595</identifier>
        <symbol>ydot</symbol>
        <value>x ** 3 - mu2 * x - mu1 - y * (nu + b * x + x ** 2)</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ydot_SUPH -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ydot_SUPH">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeDerivative"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/y_SUPH"/>
        <rdfs:subClassOf>
