            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>s_iidot_DG</rdfs:label>
        <category>TimeDerivative</category>
        <identifier>001380</identifier>
        <symbol>s_iidot</symbol>
        <value>1 / tau_s * (- s_ii + J_ii * r_i)</value>
    </owl:Class>
    


