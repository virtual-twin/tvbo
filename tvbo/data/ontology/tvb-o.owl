            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>ReducedSetHindmarshRose</rdfs:label>
        <rdfs:label>Stefanescu Jirsa 3D</rdfs:label>
        <skos:definition>A reduced description of Hindmarsh-Rose neural population dynamics.
The population of neurons in this model are electrically coupled via gap-junctions.</skos:definition>
        <skos:definition>An enumeration.</skos:definition>
        <acronym>SJ3D</acronym>
        <documentation rdf:resource="https://docs.thevirtualbrain.org/api/tvb.simulator.models.html#module-tvb.simulator.models.stefanescu_jirsa"/>
        <equation>
\begin{align}
    \dot{\xi}_i     &amp;= \eta_i - a_i \xi_i^3 + b_i \xi_i^2 - \tau_i + K_{11} \left[\sum_{k=1}^{o} A_{ik} \xi_k - \xi_i \right] - K_{12} \left[\sum_{k=1}^{o} B_{ik} \alpha_k - \xi_i\right] + IE_i \\
                     &amp;\quad + \left[\sum_{k=1}^{o} \mathbf{\Gamma}(\xi_{kq}, \xi_{kr}, u_{qr})\right] + \left[\sum_{k=1}^{o} W_{\zeta} \cdot \xi_{kr} \right] \\
    \dot{\eta}_i    &amp;= c_i - d_i \xi_i^2 - \tau_i \\
    \dot{\tau}_i    &amp;= rs \xi_i - r \tau_i - m_i \\
    \dot{\alpha}_i  &amp;= \beta_i - e_i \alpha_i^3 + f_i \alpha_i^2 - \gamma_i + K_{21} \left[\sum_{k=1}^{o} C_{ik} \xi_k - \alpha_i \right] + II_i + \left[\sum_{k=1}^{o} \mathbf{\Gamma}(\xi_{kq}, \xi_{kr}, u_{qr})\right] \\
                     &amp;\quad + \left[\sum_{k=1}^{o} W_{\zeta} \cdot \xi_{kr}\right] \\
    \dot{\beta}_i   &amp;= h_i - p_i \alpha_i^2 - \beta_i \\
    \dot{\gamma}_i  &amp;= rs \alpha_i - r \gamma_i - n_i
\end{align}
</equation>
        <equation>\dot{\xi}_i     &amp;=  \eta_i-a_i\xi_i^3 + b_i\xi_i^2- \tau_i
                                 + K_{11} \left[\sum_{k=1}^{o} A_{ik} \xi_k - \xi_i \right]
                                 - K_{12} \left[\sum_{k=1}^{o} B_{ik} \alpha_k - \xi_i\right] + IE_i                \\
                                &amp;\, + \left[\sum_{k=1}^{o} \mathbf{\Gamma}(\xi_{kq}, \xi_{kr}, u_{qr})\right]
                                 + \left[\sum_{k=1}^{o} W_{\zeta}\cdot\xi_{kr} \right],                     \\
                &amp;                                                                         \\
                \dot{\eta}_i    &amp;=  c_i-d_i\xi_i^2 -\tau_i,                                                         \\
                &amp;                                                                         \\
                \dot{\tau}_i    &amp;=  rs\xi_i - r\tau_i -m_i,                                                         \\
                &amp;                                                                         \\
                \dot{\alpha}_i  &amp;=  \beta_i - e_i \alpha_i^3 + f_i \alpha_i^2 - \gamma_i
                                 + K_{21} \left[\sum_{k=1}^{o} C_{ik} \xi_k - \alpha_i \right] + II_i               \\
                                &amp;\, +\left[\sum_{k=1}^{o}\mathbf{\Gamma}(\xi_{kq}, \xi_{kr}, u_{qr})\right]
                                 + \left[\sum_{k=1}^{o}W_{\zeta}\cdot\xi_{kr}\right],                    \\
                &amp;                                                                         \\
                \dot{\beta}_i   &amp;= h_i - p_i \alpha_i^2 - \beta_i,                                                   \\
                \dot{\gamma}_i  &amp;= rs \alpha_i - r \gamma_i - n_i,</equation>
        <identifier>000764</identifier>
        <references>Stefanescu RA, Jirsa VK. A low dimensional description of globally coupled heterogeneous neural networks of excitatory and inhibitory neurons. PLoS Comput Biol. 2008;4(11):e1000219.</references>
        <sourcecode rdf:resource="https://github.com/the-virtual-brain/tvb-root/blob/master/tvb_library/tvb/simulator/models/stefanescu_jirsa.py"/>
        <synonym>ReducedSetHindmarshRose</synonym>
        <wiki rdf:resource="https://gitlab.com/BrainSimulation/tvb-ontology/-/wikis/Wiki/Neural-Mass-Models/Stefanescu-Jirsa-3D"/>
    </owl:Class>
    


