    <!-- https://w3id.org/tvbo/Heun -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Heun">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/IntegrationMethod"/>
        <rdfs:label>Heun</rdfs:label>
        <skos:definition>It is a simple example of a predictor-corrector method. It is also known as modified trapezoidal method, which uses the Euler method as its predictor. And it is also a implicit integration scheme.</skos:definition>
        <dX>(dX0 + dX1) * (dt / 2)</dX>
        <identifier>000538</identifier>
        <intermediate_steps>X + dX0 * dt + noise + stimulus * dt</intermediate_steps>
        <n_dx rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</n_dx>
    </owl:Class>
    


