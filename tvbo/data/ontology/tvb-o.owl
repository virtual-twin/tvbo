        <synonym>sigm_nu_2_JR</synonym>
        <tvbSourceVariable>sigm_y0_3</tvbSourceVariable>
        <unit>ms^-1</unit>
        <value>2.0*nu_max/(1.0+exp(r*(v0-(a_3*J*y0))))</value>
    </owl:Class>
    


