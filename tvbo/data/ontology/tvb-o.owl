                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/f_1_E5D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_argument_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/f_2_E5D"/>
            </owl:Restriction>
