    <!-- https://w3id.org/tvbo/y2_E5D -->

    <owl:Class rdf:about="https://w3id.org/tvbo/y2_E5D">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Epileptor5D"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/StateVariable"/>
