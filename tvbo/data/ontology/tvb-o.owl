        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/GenericLinear"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TimeConstant"/>
        <rdfs:subClassOf>
