        <rdfs:label>rho_2_ZJ</rdfs:label>
        <skos:definition>Firing threshold (PSP) for which a 50% firing rate is achieved.
        In other words, it is the value of the average membrane potential
        corresponding to the inflection point of the sigmoid [mV]. Population mean firing threshold.</skos:definition>
        <skos:definition>Firing threshold (PSP) for which a 50% firing rate is achieved. In other words, it is the value of the average membrane potential corresponding to the inflection point of the sigmoid [mV]. Population mean firing threshold.</skos:definition>
        <category>Parameter</category>
        <defaultValue>6.0</defaultValue>
        <identifier>001356</identifier>
        <range>lo=3.12, hi=10.0, step=0.02</range>
        <symbol>\rho_2</symbol>
    </owl:Class>
    


