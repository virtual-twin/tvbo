    <owl:Class rdf:about="https://w3id.org/tvbo/PostsynapticPotential">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/BiophysicalEntity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/NeuronalActivity"/>
        <dc:description>Change in neuronal membrane potential.</dc:description>
        <rdfs:label>PostsynapticPotential</rdfs:label>
        <acronym>PSP</acronym>
        <identifier>000734</identifier>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PreSigmoidal -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PreSigmoidal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Coupling"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/G_cPreSIG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/H_cPreSIG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/P_cPreSIG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Q_cPreSIG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/theta_cPreSIG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>PreSigmoidal</rdfs:label>
        <skos:definition>Provides a pre-summation sigmoidal coupling function with a static or dynamic and local or global threshold.

.. math::
H * (Q + \tanh(G * (P*x - \theta)))

The dynamic threshold as state variable given by the second state variable. With the coupling term, returns the direct node output for the dynamic threshold.</skos:definition>
        <acronym>cPreSIG</acronym>
        <identifier>000735</identifier>
        <value>H*(Q + tanh(G*(P*x_j - theta)))</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Projection -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Projection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Monitor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_attribute"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/AdditiveNoise"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_attribute"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/RegionMapping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Projection</rdfs:label>
        <skos:definition>Base class monitor providing lead field support.</skos:definition>
        <identifier>000736</identifier>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ProjectionSurfaceSEEG -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ProjectionSurfaceSEEG">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/iEEG/SEEG"/>
        <rdfs:label>ProjectionSurfaceSEEG</rdfs:label>
        <skos:definition>SEEG lead field matrix, i.e., wraps matrices defining a linear operator to map the spatial sources into the leadfield domain.</skos:definition>
        <identifier>000737</identifier>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ProjectionSurface_EEG -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ProjectionSurface_EEG">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EEG"/>
        <rdfs:label>ProjectionSurface_EEG</rdfs:label>
        <skos:definition>EEG lead field matrix wraps matrices defining a linear operator to map the spatial sources into the leadfield domain.

A lead field matrix (gain matrix) represents the linear relation between source signals and measurement of physical electromagnetic signals. If a precomputed lead field is not available, a single sphere analytic formula due to Sarvas 1987 is used.</skos:definition>
        <identifier>000738</identifier>
        <synonym>Lead Field Matrix</synonym>
        <tvbSourceVariable>ProjectionSurfaceEEG</tvbSourceVariable>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ProjectionSurface_MEG -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ProjectionSurface_MEG">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/MEG"/>
        <rdfs:label>ProjectionSurface_MEG</rdfs:label>
        <skos:definition>MEG lead field matrix, i.e., wraps matrices defining a linear operator to map the spatial sources into the leadfield domain.</skos:definition>
        <identifier>000739</identifier>
        <synonym>Lead Field Matrix</synonym>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Projections -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Projections">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/DataTypes"/>
        <rdfs:label>Projections</rdfs:label>
        <identifier>000740</identifier>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PulseTrain -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PulseTrain">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TemporalApplicableEquation"/>
        <rdfs:label>PulseTrain</rdfs:label>
        <acronym>PT</acronym>
        <identifier>000741</identifier>
        <value>where((t&gt;onset)&amp;(((t-onset) % T) &lt; tau), amp, 0)</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/PulseTrainStop -->

    <owl:Class rdf:about="https://w3id.org/tvbo/PulseTrainStop">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/TemporalApplicableEquation"/>
        <rdfs:label>PulseTrainStop</rdfs:label>
        <acronym>PTs</acronym>
        <identifier>000742</identifier>
        <value>where((t &gt; onset) &amp; (t &lt; stop) &amp; (((t - onset) % T) &lt; tau),amp,0)</value>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/Q_V_LB -->

    <owl:Class rdf:about="https://w3id.org/tvbo/Q_V_LB">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Function"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/LarterBreakspear"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_argument"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Q_Vmax_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_T_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/delta_V_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/V_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_coefficient_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/lc_0_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_function_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Vdot_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_function_of"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Zdot_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Vdot_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/Zdot_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/is_parameter_in"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/lc_0_LB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/surrogate_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Q_V_LB</rdfs:label>
        <skos:altLabel>QV_LB</skos:altLabel>
        <skos:definition>Average firing rate of the population of PCs, V.</skos:definition>
        <category>Function</category>
        <equation>Q_{V}   &amp;= Q_{V_{max}} \, (1 + \tanh\left(\dfrac{V_{k} - VT}{\delta_{V}}\right))</equation>
        <functionType>Sigmoid function</functionType>
        <identifier>000747</identifier>
        <shortName>Potential-to-rate operator.</shortName>
        <symbol>QV</symbol>
        <symbol>Q_V</symbol>
        <synonym>Q_V_LB</synonym>
        <value>0.5*Q_Vmax*(1 + tanh((V-V_T)/delta_V))</value>
    </owl:Class>
    


