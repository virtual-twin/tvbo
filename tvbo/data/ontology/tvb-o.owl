            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>x1dot_E5D</rdfs:label>
        <skos:definition>Derivative of the state-variable x1_E5D of the Epileptor5D with respect to time.</skos:definition>
        <category>Time Derivative</category>
        <category>TimeDerivative</category>
        <equation>Equation of x1dot_E5D.

::math
\dot{x_{1}} &amp;=&amp; tt (y_{1} - f_{1}(x_{1}, x_{2}) - z + I_{ext1})</equation>
        <identifier>001517</identifier>
        <symbol>x1dot</symbol>
        <value>tt * (y1 - z + Iext+local_coupling*x1 + Kvf * c_pop0 + x1cond * x1)</value>
    </owl:Class>
    


