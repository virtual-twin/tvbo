            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>V_thre_e_ZAFO</rdfs:label>
        <category>Function</category>
        <identifier>000900</identifier>
        <unit>mV</unit>
        <value>(P0_e + P1_e * V_e + P2_e * S_e + P3_e * T_e + P4_e * V_e**2 + P5_e * S_e**2 + P6_e * T_e**2 + P7_e * V_e * S_e + P8_e * V_e * T_e + P9_e * S_e * T_e) * 1e3</value>
    </owl:Class>
    


