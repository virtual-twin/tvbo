                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_state_variable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/s_ii_DG"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>V_idot_DG</rdfs:label>
        <category>TimeDerivative</category>
        <identifier>000896</identifier>
        <symbol>V_idot</symbol>
        <value>1 / tau_i * ( V_i ** 2 + eta_i - tau_i ** 2 * numpy.pi ** 2 * r_i ** 2 + tau_i * s_ie - tau_i * s_ii + I_i)</value>
    </owl:Class>
    


