                <owl:onProperty rdf:resource="https://w3id.org/tvbo/has_parameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/tvbo/IE_i_SJ2D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
