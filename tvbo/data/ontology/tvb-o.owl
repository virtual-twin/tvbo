        <rdfs:label>T_V_i_ZAFO</rdfs:label>
        <category>Function</category>
        <identifier>000831</identifier>
        <value>(fe_i * (U_e_i * tau_e) ** 2 + fi_i * (U_i_i * tau_i) ** 2) / (fe_i * (U_e_i * tau_e) ** 2 / (tau_e + T_m_i) + fi_i * (U_i_i * tau_i) ** 2 / (tau_i + T_m_i))</value>
    </owl:Class>
    


