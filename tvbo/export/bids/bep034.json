{
    "name": "bep034",
    "description": "BIDS BEP034 Computational Modeling Extension v1.0.0",
    "entities": [
        {
            "name": "subject",
            "pattern": "[/\\\\]+sub-([a-zA-Z0-9]+)",
            "directory": "{subject}"
        },
        {
            "name": "session",
            "pattern": "[_/\\\\]+ses-([a-zA-Z0-9]+)",
            "mandatory": false,
            "directory": "{subject}{session}"
        },
        {
            "name": "desc",
            "pattern": "[_/\\\\]+desc-([a-zA-Z0-9]+)"
        },
        {
            "name": "run",
            "pattern": "[_/\\\\]+run-(\\d+)",
            "dtype": "int"
        },
        {
            "name": "net",
            "pattern": "[_/\\\\]+net-([a-zA-Z0-9]+)",
            "description": "Network entity: weights, distances, etc."
        },
        {
            "name": "ts",
            "pattern": "[_/\\\\]+ts-([a-zA-Z0-9]+)",
            "description": "Time series label: sim, bold, eeg, etc."
        },
        {
            "name": "eq",
            "pattern": "[_/\\\\]*eq-([a-zA-Z0-9]+)",
            "description": "Equation/model label"
        },
        {
            "name": "coord",
            "pattern": "[_/\\\\]+coord-([a-zA-Z0-9]+)",
            "description": "Coordinate type: centres, vertices, etc."
        },
        {
            "name": "map",
            "pattern": "[_/\\\\]+map-([a-zA-Z0-9]+)",
            "description": "Mapping type: region, vertex, etc."
        },
        {
            "name": "param",
            "pattern": "[_/\\\\]+param-([a-zA-Z0-9]+)",
            "description": "Parameter set label"
        },
        {
            "name": "id",
            "pattern": "[_/\\\\]+id-([a-fA-F0-9]+)",
            "description": "Unique identifier hash of JSON sidecar"
        },
        {
            "name": "model",
            "pattern": "[_/\\\\]+model-([a-zA-Z0-9]+)",
            "description": "Model name identifier"
        },
        {
            "name": "space",
            "pattern": "[_/\\\\]+space-([a-zA-Z0-9]+)",
            "description": "Coordinate space"
        },
        {
            "name": "atlas",
            "pattern": "[_/\\\\]+atlas-([a-zA-Z0-9]+)",
            "description": "Atlas name"
        },
        {
            "name": "datatype",
            "pattern": "[/\\\\]+(net|ts|eq|coord|map|code)[/\\\\]+",
            "description": "BEP034 data types"
        },
        {
            "name": "suffix",
            "pattern": "(?:^|[_/\\\\])([a-zA-Z0-9]+)\\.[^/\\\\]+$"
        },
        {
            "name": "extension",
            "pattern": "[^./\\\\](\\.[^/\\\\]+)$"
        }
    ],
    "default_path_patterns": [
        "sub-{subject}[/ses-{session}]/{datatype<net>|net}/sub-{subject}[_ses-{session}][_desc-{desc}][_run-{run}]_net-{net<weights|distances>}_id-{id}{extension<.tsv|.json>|.tsv}",
        "sub-{subject}[/ses-{session}]/{datatype<ts>|ts}/sub-{subject}[_ses-{session}][_desc-{desc}][_run-{run}]_ts-{ts}_id-{id}{extension<.tsv|.json>|.tsv}",
        "sub-{subject}[/ses-{session}]/{datatype<eq>|eq}/eq-{eq}[_desc-{desc}]_id-{id}{extension<.json|.yaml|.xml>|.json}",
        "sub-{subject}[/ses-{session}]/{datatype<coord>|coord}/sub-{subject}[_ses-{session}][_desc-{desc}][_space-{space}]_coord-{coord<centres|vertices>}_id-{id}{extension<.tsv|.json>|.tsv}",
        "sub-{subject}[/ses-{session}]/{datatype<map>|map}/sub-{subject}[_ses-{session}][_desc-{desc}][_atlas-{atlas}]_map-{map<region|vertex>}_id-{id}{extension<.tsv|.json>|.tsv}",
        "sub-{subject}[/ses-{session}]/{datatype<code>|code}/{suffix}{extension<.py|.m|.jl|.r>|.py}",
        "[desc-{desc}_][run-{run}_]net-{net<weights|distances>}_id-{id}{extension<.json>|.json}",
        "[desc-{desc}_][run-{run}_]ts-{ts}_id-{id}{extension<.json>|.json}",
        "eq-{eq}[_desc-{desc}]_id-{id}{extension<.json>|.json}",
        "[desc-{desc}_][space-{space}_]coord-{coord<centres|vertices>}_id-{id}{extension<.json>|.json}",
        "[desc-{desc}_][atlas-{atlas}_]map-{map<region|vertex>}_id-{id}{extension<.json>|.json}"
    ]
}
