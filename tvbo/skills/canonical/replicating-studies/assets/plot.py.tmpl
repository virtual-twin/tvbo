HERE = Path(__file__).resolve().parent
ROOT = HERE.parent.parent
INPUT, OUT = ROOT / "input", ROOT / "output"
FIGS = OUT / "figures"          # all generated figures live under the gitignored output/
FIGS.mkdir(parents=True, exist_ok=True)


def _open(exp):
    """Open a run's native result container (skip the *_network.h5 sidecar)."""
    import xarray as xr
    d = OUT / "nc" / exp
    fs = [f for f in d.glob("*.h5") if "network" not in f.name] if d.exists() else []
    return xr.open_dataset(fs[0], engine="h5netcdf") if fs else None


