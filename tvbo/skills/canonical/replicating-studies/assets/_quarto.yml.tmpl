# Copy to report/_quarto.yml. One Quarto project that renders BOTH reports from ONE `quarto render`
# (no file arg, no --profile, no post-render hook):
#   report.qmd          -> report.pdf          PUBLIC   (our reproduction only — the shareable artifact)
#   report_internal.qmd -> report_internal.pdf INTERNAL (paper © figures beside ours — git-ignored, A/B)
#
# How it stays copyright-safe with only three files (report.qmd, report_internal.qmd, this file):
#  - report.qmd holds the WHOLE report and carries NO front matter, so report_internal.qmd can
#    `{{< include report.qmd >}}` it without the included front matter overriding the wrapper's
#    output name (an included front matter WOULD win — that is the one trap this layout avoids).
#  - All shared settings (title, format, bibliography, execute) live HERE and apply to both entries;
#    each entry overrides only what differs (report_internal.qmd: its output-file + a "do not
#    distribute" title).
#  - The build branches on QUARTO_DOCUMENT_FILE — the input filename Quarto exposes to the kernel —
#    so report_internal.qmd -> INTERNAL (draws © originals), report.qmd -> PUBLIC. The internal
#    build can never write report.pdf.
#
# Rendered via LaTeX (xelatex). A replication report is mostly wide computed tables, and
# `longtable` is the only engine that breaks one across a page with its header repeated. Run with
# the tvbo venv:
#     QUARTO_PYTHON=/path/to/tvbo/.venv/bin/python quarto render      # in report/  -> BOTH PDFs
project:
  type: default
  render:
    - report.qmd
    - report_internal.qmd
title: "TVBO replication of <Author> et al. (<Year>)"
subtitle: "*<Paper title>* (<venue>), replicated with a single declarative tvbo recipe"
format:
  pdf:
    output-file: report.pdf
    pdf-engine: xelatex
    documentclass: scrartcl
    toc: true
    toc-depth: 2
    number-sections: true
    colorlinks: true
    fig-width: 7
    fig-pos: "H"
    geometry:
      - margin=2cm
    include-in-header:
      text: |
        \usepackage{etoolbox}
        \usepackage{ragged2e}
        \AtBeginEnvironment{longtable}{\small\RaggedRight}
callout-icon: false
bibliography: references.bib
jupyter: python3
execute:
  echo: false
  warning: false
