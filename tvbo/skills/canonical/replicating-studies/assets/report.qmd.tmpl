```{python}
#| label: setup
#| echo: false
import os, sys, numpy as np, xarray as xr, yaml, matplotlib.pyplot as plt
import matplotlib.image as mpimg
from pathlib import Path
sys.path.insert(0, str(Path("../code").resolve()))   # builder + analysis callables
OUT = Path("../output"); INPUT = Path("../input")
ORIG = Path("../original_study/img")                  # paper's figures (git-ignored, © author)
FIGS = OUT / "figures"                                # our reproduction figures (git-ignored)

# --- INTERNAL vs PUBLIC build (copyright-safe single source) ------------------------
# Showing the paper's own published figures is copyright-restricted, so ONE report.qmd
# renders two ways, selected by a Quarto profile:
#   PUBLIC   (default):  quarto render report.qmd --to pdf
#                        -> report.pdf, ONLY our reproduction (no copyrighted originals).
#   INTERNAL (opt-in):   quarto render report.qmd --to pdf --profile internal
#                        -> report_internal.pdf, adds the paper figure beside each
#                           reproduction for A/B validation. Local-only, git-ignored.
# `--profile internal` sets QUARTO_PROFILE (read here) and the profile file renames the
# output, so the internal (© author) build can never overwrite the public report.pdf.
# Needs report/_quarto.yml + report/_quarto-internal.yml (copy the .tmpl assets).
INTERNAL = "internal" in os.environ.get("QUARTO_PROFILE", "").split(",")

def ab(orig, repl, h=4.0, lab="<substrate>"):
    """Show our reproduction figure; in the INTERNAL build draw the paper original beside it.

    ``orig`` is the paper figure under original_study/img/ (read ONLY when INTERNAL, so no
    copyrighted image is ever embedded in the public build); ``repl`` is our reproduction
    under output/figures/.
    """
    r = FIGS / repl
    if INTERNAL:
        fig, ax = plt.subplots(1, 2, figsize=(11, h))
        axl, axr = ax
        axl.axis("off"); axl.set_title("Original — <Author> <Year>", fontsize=9)
        o = ORIG / orig
        if o.exists():
            axl.imshow(mpimg.imread(str(o)))
    else:
        fig, axr = plt.subplots(1, 1, figsize=(6.4, h))
    axr.axis("off"); axr.set_title(f"TVBO replication ({lab})", fontsize=9)
    if r.exists():
        axr.imshow(mpimg.imread(str(r)))
    else:
        axr.text(0.5, 0.5, f"{repl}\n(run: python code/figures/plot.py)", ha="center", va="center")
    plt.tight_layout(); plt.show()

# ---- Every reported number is computed here from the result container or metadata. ----
# No value below this line may be typed into prose/captions. Reference M[...] via inline
# `{python} ...`. Papers are not ground truth; your own asserted numbers are not either.
from tvbo.classes.study import SimulationStudy
STUDY = SimulationStudy.from_file("../<Study>.yaml")
EXP  = STUDY.get_experiment(<base_exp_id>)     # e.g. the uncontrolled/base variant
# CTRL = STUDY.get_experiment(<ctrl_exp_id>)   # e.g. a controlled variant, if any

def _open(exp):
    d = OUT / "nc" / exp
    fs = [f for f in d.glob("*.h5") if "network" not in f.name] if d.exists() else []
    return xr.open_dataset(fs[0], engine="h5netcdf") if fs else None

def _sidecar(exp):
    d = OUT / "nc" / exp
    ys = [f for f in d.glob("*.yaml") if "network" not in f.name] if d.exists() else []
    return yaml.safe_load(open(ys[0])) if ys else {}

def _mval(meta, *path):
    o = meta
    for k in path:
        if not isinstance(o, dict) or k not in o:
            return None
        o = o[k]
    return o.get("value") if isinstance(o, dict) else o

def param(exp_id, name):
    """A model parameter straight from the recipe metadata (never hand-typed)."""
    p = STUDY.get_experiment(exp_id).dynamics.parameters
    items = p.items() if hasattr(p, "items") else [(getattr(x, "name", None), x) for x in p]
    return next((getattr(o, "value", None) for n, o in items if n == name), None)

def fmt(x, d=1):
    """Format a computed metric, or '—' if its container is absent."""
    return "—" if x is None else (f"{x:.{d}f}" if d else f"{int(round(x))}")

# --- Study-specific metric functions: read a container, return a number. Examples: ---
def grid_counts():
    """Topology counts from the processed connectome, so the exact-match claims compute."""
    p = INPUT / "<study>_grid.npz"
    if not p.exists():
        return {}
    d = np.load(str(p), allow_pickle=True)
    return dict(n_nodes=int(np.asarray(d["A"]).shape[0]))   # + n_lines, n_gen, ... as needed

# One dict, computed once. The prose/captions reference these via inline code.
M = dict(
    K=param(<base_exp_id>, "K"),
    **grid_counts(),
    # n_sol=solitary_count("exp<id>"), tc=decay_time("exp<id>"), ...
)
