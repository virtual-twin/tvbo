integration:
  time_scale: ms
  duration: 1000.0
  method: Heun
  step_size: 0.01220703125
  transient_time: 0.0
  scipy_ode_base: false
  number_of_stages: 2
  intermediate_expressions:
    X1:
      name: X1
      equation:
        lhs: X1
        rhs: X + dX0 * dt + noise + stimulus * dt
        latex: false
      conditional: false
  update_expression:
    name: dX
    equation:
      lhs: X_{t+1}
      rhs: (dX0 + dX1) * (dt / 2)
      latex: false
    conditional: false
  delayed: true
network:
  number_of_regions: 1
  number_of_nodes: 1
  conduction_speed:
    name: conduction_speed
    label: v
    value: 3.0
    unit: mm/ms
  distance_unit: mm
  time_unit: ms
coupling:
  name: Linear
  parameters:
    a:
      name: a
      value: 0.00390625
      description: Linear scaling factor of the coupled (delayed) input.
    b:
      name: b
      value: 0.0
      description: Shifts the base of the connection strength while maintaining the
        absolute difference between different values.
  sparse: false
  pre_expression:
    rhs: x_j
    latex: false
  post_expression:
    rhs: a*gx + b
    latex: false
  delayed: true
monitors:
  Raw:
    name: Raw
    time_scale: ms
