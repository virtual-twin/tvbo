                                                          owl:hasValue <https://w3id.org/tvbo/Codimension2>
                                                        ] ;
                                        rdfs:comment "Codim-2 point where a Hopf bifurcation switches between sub- and supercritical (first Lyapunov coefficient vanishes); a fold-of-limit-cycles curve emanates."@en ;
                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                        rdfs:label "Generalized Hopf (Bautin)"@en ;
                                        <http://www.w3.org/2004/02/skos/core#altLabel> "GH" ,
                                                                                       "bautin" ,
                                                                                       "generalised hopf" ,
                                                                                       "generalized hopf" ,
                                                                                       "gh" ;
                                        <https://w3id.org/tvbo/canonicalCode> "GH" .


