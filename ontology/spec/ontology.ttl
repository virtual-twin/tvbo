                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "scipy_ode_base" .


<https://w3id.org/tvbo/seed> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "seed (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#notation> "seed" .


<https://w3id.org/tvbo/seed_offset> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "seed_offset (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Sub-stream this step draws from, offset from the generator's seed. Two seeded steps must use different offsets to be independent. Stated here rather than inferred from step order so it is a property of the generator that every backend derives identically (numpy re-seeds, jax folds the offset into the key) — and so inserting or reordering steps cannot silently change an existing generator's output." ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "seed_offset" .


<https://w3id.org/tvbo/segmentation> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "segmentation (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "BIDS seg- entity (e.g., 7Networks, 17Networks)" ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "segmentation" .


<https://w3id.org/tvbo/session_id> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "session_id (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "BIDS session identifier." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "session_id" .


<https://w3id.org/tvbo/settle_seed> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "settle_seed (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Seed for the noise the settle integrates, when the settle runs as its own scan. Absent -- the default -- leaves the settle on whatever stream its solver hands it, which is what an unmodified upstream warm start does; the backend is not silently given a different draw than the reference implementation it is checked against. Present means the settle uses exactly this seed. Both interesting cases are then sayable: equal to `seed` puts the two scans on one stream, and different from it decorrelates them. Equal is not neutral -- where the two scans take the same number of steps a shorter draw is a prefix of a longer one, so the measured noise repeats the settle's sample for sample, and corr(settle, measured) on demeaned fluctuations is +0.49 against -0.01 decorrelated. Its effect on the reported statistics was null everywhere it was measured (FC bias below 0.03 sigma, no trend), so this slot exists to make the choice visible and reproducible rather than because either answer is known to be wrong." ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "settle_seed" .


<https://w3id.org/tvbo/setup> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "setup (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Shell lines run verbatim before the task command, after ``set -euo pipefail`` and any module/venv activation. The general hook for environment setup the typed fields do not cover, e.g. activating a conda env (``conda activate <name>``), sourcing a profile, or exporting a computed path. Ordered; each line is emitted as-is." ;
                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                              <http://www.w3.org/2004/02/skos/core#notation> "setup" .


<https://w3id.org/tvbo/shape> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "shape (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#notation> "shape" .


<https://w3id.org/tvbo/share_x> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "share_x (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Panel groups that share one x scale, each entry a comma-separated list of mosaic keys ('c,g,h'). Every panel in a group ends on the union of the group's limits. Declare it whenever a panel's tick labels are hidden as another panel's: hiding them alone asserts a shared scale the axes do not actually have, and a reader then compares two panels drawn at different ranges." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "share_x" .


<https://w3id.org/tvbo/share_y> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "share_y (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Panel groups that share one y scale, each entry a comma-separated list of mosaic keys ('c,g,h'). Same rule as share_x." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "share_y" .


<https://w3id.org/tvbo/show> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "show (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#notation> "show" .


<https://w3id.org/tvbo/size> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "size (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Number of identical cells this node represents as a population. The default (1) is a single unit; size>1 makes the node a population of N cells sharing this node's dynamics, addressed by index 0..N-1 when a connectivity rule on an incident Edge is expanded. Maps to a NeuroML <population size=\"N\">. Backend-independent: it states the population's cardinality, not a storage layout." ;
                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                             <http://www.w3.org/2004/02/skos/core#notation> "size" .


<https://w3id.org/tvbo/source> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "source (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                               <http://www.w3.org/2004/02/skos/core#notation> "source" .


<https://w3id.org/tvbo/source_branch> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "source_branch (slot)" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Name of a previously computed branch, for the from_branch method, which no continuation backend implements (InitialStateMethod.from_branch)." ;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "source_branch" .


<https://w3id.org/tvbo/source_code> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "source_code (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "source_code" .


<https://w3id.org/tvbo/source_network> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                       rdfs:label "source_network (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Path or name of the Network whose nodes define the source endpoints of this Edge. Symmetric counterpart to `target_network`. Together they let an Edge bridge any two Networks: both unset (within-Network edge), one set (this Network ↔ the named one), or both set (peer-to-peer projection between two other Networks). Accepts either an absolute IRI (peer Network) or the relative-path sentinel `parent` / `parent/parent` (cross-scale up/down via the Node.subnetwork hierarchy)." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "source_network" .


<https://w3id.org/tvbo/source_point> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "source_point (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "source_point" .


<https://w3id.org/tvbo/source_var> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "source_var (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#altLabel> "source_variable" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Output variable from source node to use (e.g., 'x_out'). If not specified, uses first output variable from source dynamics. The alias `source_variable` is accepted (harmonized with the `*_variable` spelling used elsewhere, e.g. the stimulus event's `target_variable`)." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "source_var" .


<https://w3id.org/tvbo/sparse> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "sparse (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#definition> "Whether the coupling uses sparse representations" ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                               <http://www.w3.org/2004/02/skos/core#notation> "sparse" .


<https://w3id.org/tvbo/spine_trim> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "spine_trim (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "End each of the left and bottom spines on its outermost ticks instead of running it the full length of the axis. Ignored on a boxed frame." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "spine_trim" .


<https://w3id.org/tvbo/started_at> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "started_at (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "ISO 8601 start time." ;
                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.w3.org/ns/prov#startedAtTime> ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "started_at" .


<https://w3id.org/tvbo/state> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "state (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Per-node initial state variable values, keyed by state variable name." ,
                                                                               "The names carried across steps — the reducer's own carry." ;
                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                              <http://www.w3.org/2004/02/skos/core#notation> "state" .


<https://w3id.org/tvbo/statistic> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "statistic (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "statistic" .


<https://w3id.org/tvbo/steps> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "steps (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#notation> "steps" .


<https://w3id.org/tvbo/still> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "still (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Which frame is also saved as a still image beside the movie, for the contexts a movie cannot reach — a printed page, a PDF report, a thumbnail. Unset saves no still." ;
                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                              <http://www.w3.org/2004/02/skos/core#notation> "still" .


<https://w3id.org/tvbo/stimulation_variable> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                             rdfs:label "stimulation_variable (slot)" ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                             <http://www.w3.org/2004/02/skos/core#notation> "stimulation_variable" .


<https://w3id.org/tvbo/strategy> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "strategy (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Search strategy over the decision space (the `space` axes). 'grid' (default) exhaustively evaluates the Cartesian/zip grid of axis points — today's behaviour. 'nsga2' runs an adaptive multi-objective genetic search (pymoo NSGA-II) that returns the non-dominated Pareto front over `objectives`; axes then supply only decision-variable bounds (domain lo/hi), and per-strategy hyper-parameters (population_size, num_generations, seed, reference_point) live in `parameters`. Extensible later to 'random' / 'sobol' / 'cmaes'. Forward-compatible with the planned unified `Search.strategy`." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "strategy" .


<https://w3id.org/tvbo/structural_measures> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                            rdfs:label "structural_measures (slot)" ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "BEP017 measure names for structural connectivity (e.g., streamlineCount, tractLength)" ;
                                            <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                            <http://www.w3.org/2004/02/skos/core#notation> "structural_measures" .


<https://w3id.org/tvbo/style> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "style (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#notation> "style" .


<https://w3id.org/tvbo/subdir> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "subdir (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#definition> "Subdirectory within the source to place on the import path (defaults to the source root)." ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                               <http://www.w3.org/2004/02/skos/core#notation> "subdir" .


<https://w3id.org/tvbo/subject_id> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "subject_id (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "BIDS subject identifier." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "subject_id" .


<https://w3id.org/tvbo/subjects> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "subjects (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Ordered list of subject IDs (e.g. HCP-YA 6-digit IDs). Each ``measures/<name>`` array in the h5 companion is indexed by this order." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "subjects" .


<https://w3id.org/tvbo/suffix> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "suffix (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#definition> "BIDS suffix (e.g., relmat), the trailing name component before the extension" ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                               <http://www.w3.org/2004/02/skos/core#notation> "suffix" .


<https://w3id.org/tvbo/surface_atlas> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "surface_atlas (slot)" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "The atlas to read vertex labels from, where it differs from the one the values are keyed by." ;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "surface_atlas" .


<https://w3id.org/tvbo/symbol> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "symbol (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                               <http://www.w3.org/2004/02/skos/core#notation> "symbol" .


<https://w3id.org/tvbo/symmetric> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "symmetric (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Centre the limits on zero, so zero is the map's midpoint. What a field of signed deviations needs — read on an off-centre scale it is misleading in a way no axis label catches." ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "symmetric" .


<https://w3id.org/tvbo/symmetry> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "symmetry (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Declared symmetry of the edge function: 'directed' (default), 'antisymmetric', or 'symmetric', shown in reports. Every backend evaluates each direction of a connection as its own directed edge, so it changes no simulation." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "symmetry" .


<https://w3id.org/tvbo/tail_samples> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "tail_samples (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Number of samples from the end to use. Takes the last N samples before aggregation. E.g., tail_samples: 500 means use data[-500:]. Prefer `tail_duration` when the window means a duration — a sample count silently rescales when the step size changes. On an algorithm's observation it must fit within one `simulation_period`; a window across iterations is a `tail_duration`." ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "tail_samples" .


<https://w3id.org/tvbo/target> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "target (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#notation> "target" .


<https://w3id.org/tvbo/target_component> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                         rdfs:label "target_component (slot)" ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "Component to attach this event to. Can be a node label, edge label, or 'all_edges'/'all_vertices' for broadcast. If not specified, event is experiment-level." ;
                                         <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                         <http://www.w3.org/2004/02/skos/core#notation> "target_component" .


<https://w3id.org/tvbo/target_network> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                       rdfs:label "target_network (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Path or name of the Network whose nodes define the target endpoints (e.g. the columns of a non-square projection matrix such as a gain matrix region → EEG sensors). Also accepts the relative-path sentinel `parent` / `parent/parent` for cross-scale signal flow up the Node.subnetwork hierarchy. One mechanism handles both projection matrices (absolute IRI) and multi-scale boundaries (sentinel)." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "target_network" .


<https://w3id.org/tvbo/target_regions> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                       rdfs:label "target_regions (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Regions a stimulus-type event targets: 'all' (broadcast to every node) or explicit region labels / indices. More expressive than the integer-only `regions` slot; when both are absent the event applies to all regions." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "target_regions" .


<https://w3id.org/tvbo/target_var> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "target_var (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#altLabel> "target_variable" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Input variable on target node to connect to (e.g., 'c_in'). If not specified, uses first coupling input from target dynamics. The alias `target_variable` is accepted." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "target_var" .


<https://w3id.org/tvbo/target_variable> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                        rdfs:label "target_variable (slot)" ;
                                        <http://www.w3.org/2004/02/skos/core#notation> "target_variable" .


<https://w3id.org/tvbo/task_iri> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "task_iri (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Cognitive Atlas (``cogat:``) IRI of the assessment instrument / task that produced this measure (e.g. ``cogat:trm_4a3fd79d09cba`` for PMAT24)." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "task_iri" .


<https://w3id.org/tvbo/task_name> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "task_name (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "BIDS task name for the simulation (e.g., 'rest', 'simulation')." ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "task_name" .


<https://w3id.org/tvbo/template> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "template (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "template" .


<https://w3id.org/tvbo/text> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "text (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "The label. With `used:` it is a Python format string applied to the referenced value, e.g. 'r = {:.2f}'." ;
                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                             <http://www.w3.org/2004/02/skos/core#notation> "text" .


<https://w3id.org/tvbo/ticklabels> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "ticklabels (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Text for the marked values of a STANDALONE `kind: colorbar` panel, where the numbers themselves are not what the figure wants to print. A bar attached to a panel writes its own numbers, which the shared format pass rounds to `decimals`." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "ticklabels" .


<https://w3id.org/tvbo/ticks> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "ticks (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#notation> "ticks" .


<https://w3id.org/tvbo/time> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "time (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#notation> "time" .


<https://w3id.org/tvbo/time_dependent> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                       rdfs:label "time_dependent (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "time_dependent" .


<https://w3id.org/tvbo/title> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "title (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#notation> "title" .


<https://w3id.org/tvbo/traceable> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "traceable (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Whether this callable can be traced by an array-programming backend (jit/vmap under JAX), asserted by the recipe rather than inferred from the module name. A backend that batches a parameter grid must know whether an observation's callable survives tracing; without this it can only guess from the import root, which makes every study-local callable untraceable however it is written. Set it true only for a callable written against the backend's array API -- a host NumPy/SciPy callable declared traceable fails inside the trace, with the tracer error naming this claim as its cause. Unset means \"infer\", preserving the import-root default." ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "traceable" .


<https://w3id.org/tvbo/trailing> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "trailing (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Text written after the last cell, closing such an equation." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "trailing" .


<https://w3id.org/tvbo/transform> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "transform (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "transform" .


<https://w3id.org/tvbo/transparent> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "transparent (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Save figures with a transparent page instead of the `background` colour." ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "transparent" .


<https://w3id.org/tvbo/triangle_gap> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "triangle_gap (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "triangle_gap" .


<https://w3id.org/tvbo/trim_margins> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "trim_margins (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "trim_margins" .


<https://w3id.org/tvbo/type> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "type (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#notation> "type" .


<https://w3id.org/tvbo/unicode_minus> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "unicode_minus (slot)" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Write a negative number with a true minus sign rather than a hyphen." ;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "unicode_minus" .


<https://w3id.org/tvbo/unit> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "unit (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Physical unit of measurement. `UnitEnum` is the curated vocabulary — each of its values is vendored from QUDT (`ontology/tvb-o-units.ttl`) and can be reasoned about dimensionally. The range is deliberately open beyond it: a unit nobody has curated yet is recorded as written and reported `uncurated`, because a closed range forces the author to either misdeclare the quantity or leave it undeclared, and both lose more than an unrecognised string does. An uncurated unit carries no dimensional claim, so a check involving it reports `underdetermined` rather than guessing. Promote one with `tvbo units add <unit>`, which pulls its QUDT record into the vendored module — so every unit TVBO *reasons* about stays authoritative, and only what it *records* is open." ;
                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                             <http://www.w3.org/2004/02/skos/core#notation> "unit" .


<https://w3id.org/tvbo/used> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "used (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "A labelled array sourced from another experiment's result, a dataset, or a curated entity — the cross-container form of a value (WHERE + WHICH + SLICE, PROV ``prov:used``). Mutually exclusive with ``value``; an in-study ``experiment`` reference also registers the workflow dependency so the source runs first. Resolved lazily, never inlined into generated code." ,
                                                                              "Bind the annotation to a scalar in a result container (same reference form a Layer uses, and the same PROV edge). The referenced value is formatted through `text` at render time, so a statistic printed on a panel is computed, never transcribed." ,
                                                                              "Bind the key to a computed scalar in a result container (same reference form a figure Layer uses, and the same PROV edge). Mutually exclusive with ``value`` and ``count``." ,
                                                                              "IRIs of the inputs, outputs and environment the activity consumed (BEP028 ``Used``)." ,
                                                                              "The p-value, a scalar in a result container (same reference form a Layer uses, and the same PROV edge)." ,
                                                                              "WHERE + WHICH + SLICE for a template edge whose whole matrix is read rather than stored or computed: another network's layer, an analysis result, or a cohort member's own connectome (``used: {cohort: <id>, query: {...}, output: weight, reconcile: by_label}``). Inside a per-subject run a cohort reference resolves to that run's subject, which is what binds a model network to each subject's own connectivity. ``reconcile: by_label`` aligns the read matrix to this network's node order through its atlas aliases. Resolved lazily and never inlined, and it wins over a same-named layer in the companion file. Mutually exclusive with ``producer:``." ,
                                                                              "WHERE + WHICH + SLICE in one edge — this parameter's array sourced from another experiment's result (an operating point, a tuned ``estimate__<name>`` a fit persisted), a dataset, or a curated entity, PROV ``prov:used``. The full cross-container form of which `source:`+`measure:` is the no-``sel``/no-``experiment`` shorthand; adds label ``reconcile`` and a swept-point ``sel``. Like `source:` the array is resolved lazily and never inlined. An in-study ``experiment`` reference also registers the workflow dependency. Mutually exclusive with `value:`/`source:`/`producer:`." ;
                             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.w3.org/ns/prov#used> ;
                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ,
                                                                            <https://w3id.org/tvbo/figure> ;
                             <http://www.w3.org/2004/02/skos/core#notation> "used" .


<https://w3id.org/tvbo/va> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                           rdfs:label "va (slot)" ;
                           <http://www.w3.org/2004/02/skos/core#definition> "Vertical alignment against (x, y) — bottom, center, top, baseline. Defaults to center." ;
                           <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                           <http://www.w3.org/2004/02/skos/core#notation> "va" .


<https://w3id.org/tvbo/valid_diagonal> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                       rdfs:label "valid_diagonal (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Self-connections are meaningful" ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "valid_diagonal" .


<https://w3id.org/tvbo/value> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "value (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Numeric, string, or boolean value, OR an array (nested list) for array-valued constants such as mode-coupling coefficient matrices. ScalarValue accepts any literal primitive type, allowing parameters to carry control flags (e.g., booleans) or symbolic placeholders alongside numeric defaults." ;
                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                              <http://www.w3.org/2004/02/skos/core#notation> "value" .


<https://w3id.org/tvbo/values> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "values (slot)" ;
