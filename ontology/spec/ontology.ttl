                                                                                         <https://w3id.org/tvbo/models/CakanObermayer/derived_variables/r_I> ;
                                              <https://w3id.org/tvbo/hasParameter> <https://w3id.org/tvbo/models/CakanObermayer/parameters/C> ,
                                                                                   <https://w3id.org/tvbo/models/CakanObermayer/parameters/E_A> ,
                                                                                   <https://w3id.org/tvbo/models/CakanObermayer/parameters/E_L> ,
                                                                                   <https://w3id.org/tvbo/models/CakanObermayer/parameters/I_A> ,
