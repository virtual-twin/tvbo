###  https://w3id.org/tvbo/models/PinskyRinzelCA3/derived_variables/alpha_cd
<https://w3id.org/tvbo/models/PinskyRinzelCA3/derived_variables/alpha_cd> rdf:type owl:NamedIndividual ,
                                                                                   <https://w3id.org/tvbo/DerivedVariable> ;
                                                                          <https://w3id.org/tvbo/rhs> "Piecewise((exp((Vd + 50.0)/11.0 - (Vd + 53.5)/27.0) / 18.975, Vd < -10.0), (2.0*exp((-53.5 - Vd)/27.0), True))" ;
                                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                          rdfs:label "alpha_cd (PinskyRinzelCA3 derived variable)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "alpha_cd" .


