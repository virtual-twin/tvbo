###  https://w3id.org/tvbo/MarkType#area
<https://w3id.org/tvbo/MarkType#area> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/tvbo/MarkType> ;
                                      rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "area (MarkType)" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Series filled down to the baseline (a density/pdf, a cumulative share). Distinct from `band`, which spans two series, and from `bar`, which asserts the x values are discrete categories." ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "area" .


###  https://w3id.org/tvbo/MarkType#band
<https://w3id.org/tvbo/MarkType#band> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/tvbo/MarkType> ;
                                      rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "band (MarkType)" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Filled band between two series (an error band, a CI). Its layer's output carries a length-2 axis beside the swept one, holding the two edges in ONE array — binding a lower edge and an upper edge as separate layers lets them come from different runs." ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "band" .


###  https://w3id.org/tvbo/MarkType#bar
<https://w3id.org/tvbo/MarkType#bar> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/tvbo/MarkType> ;
                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "bar (MarkType)" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Vertical bars, one per x (spectrum, per-category magnitude). Distinct from `line` because a spectrum read as a line implies interpolation between mode numbers that do not exist." ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "bar" .


###  https://w3id.org/tvbo/MarkType#errorbar
<https://w3id.org/tvbo/MarkType#errorbar> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/tvbo/MarkType> ;
                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                          rdfs:label "errorbar (MarkType)" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "One vertical bar per x between two edges (a group's mean ± SD at each discrete group). The data contract of `band`, drawn as separate segments, because a band filled between discrete groups implies values between them that were never measured." ;
                                          <http://www.w3.org/2004/02/skos/core#notation> "errorbar" .


###  https://w3id.org/tvbo/MarkType#line
<https://w3id.org/tvbo/MarkType#line> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/tvbo/MarkType> ;
                                      rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "line (MarkType)" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Connected line (timeseries, bifurcation branch, trajectory)." ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "line" .


###  https://w3id.org/tvbo/MarkType#rule
<https://w3id.org/tvbo/MarkType#rule> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/tvbo/MarkType> ;
                                      rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "rule (MarkType)" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Reference line at a value the layer's output HOLDS (a threshold, a published number, an ensemble mean) — one line per value. The encoded channel picks the orientation: `x:` draws vertical, `y:` horizontal. Distinct from the `axvline`/`axhline` opts, which take a literal typed into the spec and are drawn as subdued gridlines." ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "rule" .


