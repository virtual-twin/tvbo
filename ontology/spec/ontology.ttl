                                                                      )
                                                        ] ;
                                    rdfs:subClassOf owl:Thing ;
                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "SurfaceView" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Where the camera sits for a cortical surface. Distinct from `VolumeView`: a mesh is viewed from a side of the brain, a volume is sliced along an anatomical axis, and the two vocabularies do not overlap." ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                    <https://w3id.org/linkml/permissible_values> <https://w3id.org/tvbo/SurfaceView#anterior> ,
