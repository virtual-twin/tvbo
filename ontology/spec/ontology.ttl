###  https://w3id.org/tvbo/BranchPoint
<https://w3id.org/tvbo/BranchPoint> rdf:type owl:Class ;
                                    owl:equivalentClass [ owl:intersectionOf ( <https://w3id.org/tvbo/Bifurcation>
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://w3id.org/tvbo/hasBranchGeometry> ;
                                                                                 owl:hasValue <https://w3id.org/tvbo/BranchCrossingGeometry>
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://w3id.org/tvbo/hasCodimension> ;
                                                                                 owl:hasValue <https://w3id.org/tvbo/Codimension1>
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://w3id.org/tvbo/hasEigenvalueSignature> ;
                                                                                 owl:hasValue <https://w3id.org/tvbo/RealEigenvalueZero>
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] ;
                                    rdfs:subClassOf <https://w3id.org/tvbo/Bifurcation> ;
                                    rdfs:comment "Branch point: two solution branches intersect transversally as a real eigenvalue crosses zero (e.g. transcritical, pitchfork). Distinct from a Fold, which turns back on the parameter."@en ;
                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "Branch point"@en ;
                                    <http://www.w3.org/2004/02/skos/core#altLabel> "BP" ,
                                                                                   "bp" ,
                                                                                   "branch point" ,
                                                                                   "branch-point" ,
                                                                                   "branchpoint" ;
                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Branch point"@en ;
                                    <https://w3id.org/tvbo/canonicalCode> "BP" .


