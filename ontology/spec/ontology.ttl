                                                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/state> ;
                                                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/subnetwork> ;
                                                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/description> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/dynamics> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/hemisphere> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/homologue> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/record> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/size> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/subnetwork> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ;
                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "NodeTemplate" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "The node slots a network's `node_template` sets on every node it does not set them on itself: what a node is and how it runs, and nothing that says which node it is. It shares these slots with `Node` and lacks the per-node slots `id`, `label`, `position` and `region`, which the network's data gives each node; a template that sets one is refused, naming it." ;
                                     <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/tvbo/NodeTemplate> ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> .


