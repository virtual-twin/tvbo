                                       rdfs:label "from_iteration (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "First iteration eligible for selection, counted from the first tuning iteration after the observation window has filled; it continues across stages under `scope: run` and restarts with every stage under `scope: stage`. Use it to skip the iterations a still-settling window makes look good." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "from_iteration" .


