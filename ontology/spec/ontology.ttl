                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                        rdfs:label "subTree"@en ;
                                        <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#subTree> .


###  https://w3id.org/tvbo/neuroml/synapticConnection
