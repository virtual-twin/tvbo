                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                             rdfs:label "WorkflowDistributeBy" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Default tier a sweep axis is placed on when it is not named explicitly in a DistributionConfig. Vectorized axes are packed into one batched backend call; workflow axes are fanned out into independent scheduler tasks." ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                             <https://w3id.org/linkml/permissible_values> <https://w3id.org/tvbo/WorkflowDistributeBy#auto> ,
                                                                                          <https://w3id.org/tvbo/WorkflowDistributeBy#vectorize> ,
                                                                                          <https://w3id.org/tvbo/WorkflowDistributeBy#workflow> .


