                                                      rdfs:label "biophysicalProperties"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#biophysicalProperties> ;
                                                      <https://w3id.org/tvbo/neuroml/exposes> "totSpecCap" .


###  https://w3id.org/tvbo/neuroml/biophysicalProperties2CaPools
<https://w3id.org/tvbo/neuroml/biophysicalProperties2CaPools> rdf:type owl:Class ;
                                                              rdfs:subClassOf owl:Thing ;
                                                              <http://purl.org/dc/terms/description> "The biophysical properties of the _cell_, including the _membraneProperties2CaPools_ and the _intracellularProperties2CaPools_ for a cell with two Ca pools"@en ;
