                                                                       <https://w3id.org/tvbo/lhs> "Derivative(alpha, t)" ;
                                                                       <https://w3id.org/tvbo/rhs> "tau*(alpha - f_i*alpha**3/3 - beta) + K21*(mode_dot(xi, Cik) - alpha) + tau*(II_i + mode_sum(c_glob0) + local_coupling*xi)" ;
                                                                       rdfs:label "alpha (ReducedSetFitzHughNagumo state variable)" ;
                                                                       <http://www.w3.org/2004/02/skos/core#notation> "alpha" .


###  https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/beta
