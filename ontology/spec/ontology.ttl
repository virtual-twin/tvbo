                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "to"@en ;
                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#to> .


###  https://w3id.org/tvbo/neuroml/transientPoissonFiringSynapse
<https://w3id.org/tvbo/neuroml/transientPoissonFiringSynapse> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseVoltageDepPointCurrentSpiking> ;
                                                              <http://purl.org/dc/terms/description> "Poisson spike generator firing at _averageRate after a _delay and for a _duration, connected to single _synapse that is triggered every time a spike is generated, providing an input current.                       Similar to ComponentType _poissonFiringSynapse_."@en ;
                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                              rdfs:label "transientPoissonFiringSynapse"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#transientPoissonFiringSynapse> ;
                                                              <https://w3id.org/tvbo/neuroml/eventPort> "in" ,
                                                                                                        "spike" ;
                                                              <https://w3id.org/tvbo/neuroml/exposes> "isi" ,
                                                                                                      "tnextIdeal" ,
                                                                                                      "tnextUsed" ,
                                                                                                      "tsince" ;
                                                              <https://w3id.org/tvbo/neuroml/hasParameter> "averageRate" ,
                                                                                                           "delay" ,
                                                                                                           "duration" .


###  https://w3id.org/tvbo/neuroml/tsodyksMarkramDepFacMechanism
<https://w3id.org/tvbo/neuroml/tsodyksMarkramDepFacMechanism> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://w3id.org/tvbo/neuroml/basePlasticityMechanism> ;
                                                              <http://purl.org/dc/terms/description> "Full Tsodyks-Markram STP model with both depression and facilitation, as in Tsodyks, Pawelzik and Markram 1998."@en ;
                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                              rdfs:label "tsodyksMarkramDepFacMechanism"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#tsodyksMarkramDepFacMechanism> ;
                                                              <https://w3id.org/tvbo/neuroml/hasParameter> "initReleaseProb" ,
                                                                                                           "tauFac" ,
                                                                                                           "tauRec" .


###  https://w3id.org/tvbo/neuroml/tsodyksMarkramDepMechanism
<https://w3id.org/tvbo/neuroml/tsodyksMarkramDepMechanism> rdf:type owl:Class ;
                                                           rdfs:subClassOf <https://w3id.org/tvbo/neuroml/basePlasticityMechanism> ;
                                                           <http://purl.org/dc/terms/description> "Depression-only Tsodyks-Markram model, as in Tsodyks and Markram 1997."@en ;
                                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                           rdfs:label "tsodyksMarkramDepMechanism"@en ;
                                                           <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#tsodyksMarkramDepMechanism> ;
                                                           <https://w3id.org/tvbo/neuroml/hasParameter> "initReleaseProb" ,
                                                                                                        "tauRec" .


###  https://w3id.org/tvbo/neuroml/vHalfTransition
<https://w3id.org/tvbo/neuroml/vHalfTransition> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://w3id.org/tvbo/neuroml/KSTransition> ;
                                                <http://purl.org/dc/terms/description> "Transition which specifies both the forward and reverse rates of transition"@en ;
                                                rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                rdfs:label "vHalfTransition"@en ;
                                                <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#vHalfTransition> ;
                                                <https://w3id.org/tvbo/neuroml/hasParameter> "gamma" ,
                                                                                             "tau" ,
                                                                                             "tauMin" ,
                                                                                             "vHalf" ,
                                                                                             "z" ;
                                                <https://w3id.org/tvbo/neuroml/requires> "v" .


###  https://w3id.org/tvbo/neuroml/variableParameter
<https://w3id.org/tvbo/neuroml/variableParameter> rdf:type owl:Class ;
                                                  rdfs:subClassOf owl:Thing ;
                                                  <http://purl.org/dc/terms/description> "Specifies a _parameter (e.g. condDensity) which can vary its value across a _segmentGroup. The value is calculated from _value attribute of the _inhomogeneousValue_ subelement. This element is normally a child of _channelDensityNonUniform_, _channelDensityNonUniformNernst_ or _channelDensityNonUniformGHK_ and is used to calculate the value of the conductance, etc. which will vary on different parts of the cell. The _segmentGroup specified here needs to define an _inhomogeneousParameter_ (referenced from _inhomogeneousParameter in the _inhomogeneousValue_), which calculates a _variable (e.g. p) varying across the cell (e.g. based on the path length from soma), which is then used in the _value attribute of the _inhomogeneousValue_ (so for example condDensity = f(p))"@en ;
                                                  rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                  rdfs:label "variableParameter"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#variableParameter> .


###  https://w3id.org/tvbo/neuroml/voltageClamp
<https://w3id.org/tvbo/neuroml/voltageClamp> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseVoltageDepPointCurrent> ;
                                             <http://purl.org/dc/terms/description> "Voltage clamp. Applies a variable current _i to try to keep parent at _targetVoltage. Not yet fully tested!!! Consider using voltageClampTriple!!"@en ;
                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                             rdfs:label "voltageClamp"@en ;
                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#voltageClamp> ;
                                             <https://w3id.org/tvbo/neuroml/eventPort> "in" ;
                                             <https://w3id.org/tvbo/neuroml/hasParameter> "delay" ,
                                                                                          "duration" ,
                                                                                          "simpleSeriesResistance" ,
                                                                                          "targetVoltage" .


###  https://w3id.org/tvbo/neuroml/voltageClampTriple
<https://w3id.org/tvbo/neuroml/voltageClampTriple> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseVoltageDepPointCurrent> ;
                                                   <http://purl.org/dc/terms/description> "Voltage clamp with 3 clamp levels. Applies a variable current _i (through _simpleSeriesResistance) to try to keep parent cell at _conditioningVoltage until time _delay, _testingVoltage until _delay + _duration, and _returnVoltage afterwards. Only enabled if _active = 1. "@en ;
                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                   rdfs:label "voltageClampTriple"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#voltageClampTriple> ;
                                                   <https://w3id.org/tvbo/neuroml/eventPort> "in" ;
                                                   <https://w3id.org/tvbo/neuroml/hasParameter> "active" ,
                                                                                                "conditioningVoltage" ,
                                                                                                "delay" ,
                                                                                                "duration" ,
                                                                                                "returnVoltage" ,
                                                                                                "simpleSeriesResistance" ,
                                                                                                "testingVoltage" .


###  https://w3id.org/tvbo/neuroml/voltageConcDepBlockMechanism
<https://w3id.org/tvbo/neuroml/voltageConcDepBlockMechanism> rdf:type owl:Class ;
                                                             rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseBlockMechanism> ;
                                                             <http://purl.org/dc/terms/description> "Synaptic blocking mechanism which varys with membrane potential across the synapse, e.g. in NMDA receptor mediated synapses"@en ;
                                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                             rdfs:label "voltageConcDepBlockMechanism"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#voltageConcDepBlockMechanism> ;
                                                             <https://w3id.org/tvbo/neuroml/hasParameter> "blockConcentration" ,
                                                                                                          "scalingConc" ,
                                                                                                          "scalingVolt" ;
                                                             <https://w3id.org/tvbo/neuroml/requires> "v" .


###  https://w3id.org/tvbo/study/Cohort
<https://w3id.org/tvbo/study/Cohort> rdf:type owl:Class ;
                                     rdfs:subClassOf owl:Thing ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/cohort_id> ;
                                                       owl:allValuesFrom xsd:string
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/description> ;
                                                       owl:allValuesFrom xsd:string
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/label> ;
                                                       owl:allValuesFrom xsd:string
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/members> ;
                                                       owl:allValuesFrom xsd:string
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/members_file> ;
                                                       owl:allValuesFrom xsd:string
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/rule> ;
                                                       owl:allValuesFrom <https://w3id.org/tvbo/study/CohortRule>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/description> ;
                                                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/label> ;
                                                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/rule> ;
                                                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/description> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/label> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/rule> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/cohort_id> ;
                                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/members> ;
                                                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/members_file> ;
                                                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/cohort_id> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/study/members_file> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ;
                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "Cohort (study)" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "A named subset of a dataset's subjects: the unit a group-level quantity is defined over, such as a mean connectome, a per-edge presence count or a normalisation constant. A dataset may hold several, and they may overlap: the sites of a multi-centre study, a patient and a control group, the subjects a processing pipeline has finished so far. Naming the subset is what pins an aggregate. A quantity computed over ``hcpy93`` states which subjects went into it, and moving to a larger cohort is a change to one identifier rather than to every consumer." ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/study> ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "Cohort" .


###  https://w3id.org/tvbo/study/CohortRule
<https://w3id.org/tvbo/study/CohortRule> rdf:type owl:Class ;
                                         rdfs:subClassOf owl:Thing ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/grouping> ;
                                                           owl:allValuesFrom <https://w3id.org/tvbo/CohortGrouping>
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/measure> ;
                                                           owl:allValuesFrom xsd:string
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/missing> ;
                                                           owl:allValuesFrom <https://w3id.org/tvbo/MissingValuePolicy>
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/of> ;
                                                           owl:allValuesFrom xsd:string
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/phenotype_file> ;
                                                           owl:allValuesFrom xsd:string
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/group> ;
                                                           owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/grouping> ;
                                                           owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/measure> ;
                                                           owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/missing> ;
                                                           owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/of> ;
                                                           owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/phenotype_file> ;
                                                           owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/group> ;
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/grouping> ;
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/measure> ;
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/missing> ;
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/of> ;
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/phenotype_file> ;
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/group> ;
                                                           owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                                               owl:intersectionOf ( xsd:integer
                                                                                                    [ rdf:type rdfs:Datatype ;
                                                                                                      owl:onDatatype xsd:integer ;
                                                                                                      owl:withRestrictions ( [ xsd:minInclusive 1
                                                                                                                             ]
                                                                                                                           )
                                                                                                    ]
                                                                                                  )
                                                                             ]
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/n_groups> ;
                                                           owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                                               owl:intersectionOf ( xsd:integer
                                                                                                    [ rdf:type rdfs:Datatype ;
                                                                                                      owl:onDatatype xsd:integer ;
                                                                                                      owl:withRestrictions ( [ xsd:minInclusive 1
                                                                                                                             ]
                                                                                                                           )
                                                                                                    ]
                                                                                                  )
                                                                             ]
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/n_groups> ;
                                                           owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/tvbo/study/n_groups> ;
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ;
                                         rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                         rdfs:label "CohortRule (study)" ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "Admits a cohort's members by a measure of a phenotype table: the candidates are cut into ``n_groups`` groups along ``measure`` and the cohort holds the group ``group``. The candidates are the members of the cohort ``of`` names, else the subjects the dataset lists, else every subject of the table. Each candidate needs one row in the table. A candidate without a row, or whose value is missing or not finite, is treated as ``missing`` says, before any group is formed. The members come in the candidates' order, not in the order of the measure. A group no candidate falls in is an error, as a cohort without members is." ;
                                         <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/study> ;
                                         <http://www.w3.org/2004/02/skos/core#notation> "CohortRule" .


