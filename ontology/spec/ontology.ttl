                                <http://www.w3.org/2004/02/skos/core#notation> "modules" .


<https://w3id.org/tvbo/muted> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "muted (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Hairlines and de-emphasised strokes: present, and not competing." ;
                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                              <http://www.w3.org/2004/02/skos/core#notation> "muted" .


<https://w3id.org/tvbo/n> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                          rdfs:label "n (slot)" ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Number of points (alternative to step for grid exploration)." ;
                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                          <http://www.w3.org/2004/02/skos/core#notation> "n" .


<https://w3id.org/tvbo/n_inversion> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "n_inversion (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Number of eigenvalue sign inversions to flag a bifurcation. Must be even. Higher = fewer false positives." ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "n_inversion" .


<https://w3id.org/tvbo/n_iterations> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "n_iterations (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "n_iterations" .


<https://w3id.org/tvbo/n_parallel> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "n_parallel (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Grid batch size for parameter exploration — how many sweep cells the backend evaluates as one vectorised chunk. ``auto`` (the default) vectorises the grid, bounded by a cell-count cap (``min(grid_size, 64)``, env ``TVBO_NVMAP_AUTO_CAP``) and a working-memory budget (env ``TVBO_NVMAP_MEM_BUDGET_GB``, default 2 GB) estimated from the per-cell output and live state: fast on every backend, and the memory budget keeps a large-per-cell grid (e.g. a whole-brain delay network) from inflating peak memory. Vectorising still holds ``n_vmap`` cells at once, so auto uses more working memory than a sequential run — the budget bounds it. An integer fixes the chunk size and bypasses both bounds (``1`` = fully sequential, minimal memory; a larger value trades memory for fewer, wider batches). Backends translate this into their own execution primitive (e.g. tvboptim's vmap chunk width) without exposing any backend-specific names in the schema." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "n_parallel" .


<https://w3id.org/tvbo/n_sections> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "n_sections (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Number of shooting sections for shooting or Poincaré methods." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "n_sections" .


<https://w3id.org/tvbo/n_threads> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "n_threads (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Number of CPU threads per worker (-1 = auto-detect)" ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "n_threads" .


<https://w3id.org/tvbo/n_trials> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "n_trials (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Number of independent trials per grid point. Each trial uses a different noise seed, redraws the initial condition of every state variable that declares a distribution, and redraws the start of every parameter whose distribution declares `axis: trial`. Used for averaging stochastic simulations (e.g., VEP = average of 20 trials)." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "n_trials" .


<https://w3id.org/tvbo/n_workers> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "n_workers (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Number of parallel workers (maps to pmap devices in JAX, processes in multiprocessing)" ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "n_workers" .


<https://w3id.org/tvbo/name> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "name (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Globally unique identifier for the entity." ;
                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/common> ;
                             <http://www.w3.org/2004/02/skos/core#notation> "name" .


<https://w3id.org/tvbo/nbins> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "nbins (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#notation> "nbins" .


<https://w3id.org/tvbo/ncols> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "ncols (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Cells per row. Unset puts every cell in one row." ;
                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                              <http://www.w3.org/2004/02/skos/core#notation> "ncols" .


<https://w3id.org/tvbo/nev> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                            rdfs:label "nev (slot)" ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Number of eigenvalues to compute. Must be >= number of state variables for reliable Hopf detection." ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                            <http://www.w3.org/2004/02/skos/core#notation> "nev" .


<https://w3id.org/tvbo/newton_max_iterations> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                              rdfs:label "newton_max_iterations (slot)" ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "Maximum Newton corrector iterations per step: NewtonPar max_iterations on BifurcationKit.jl, and both ITNW and ITMX on the AUTO-07p backends. Unset, each backend keeps its own default, BifurcationKit.jl 25 and AUTO-07p ITNW 5 and ITMX 9. A branch's nested continuation that leaves it unset takes its parent's." ;
                                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                              <http://www.w3.org/2004/02/skos/core#notation> "newton_max_iterations" .


<https://w3id.org/tvbo/node_edge_color> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                        rdfs:label "node_edge_color (slot)" ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "Outline colour of the region markers." ;
                                        <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                        <http://www.w3.org/2004/02/skos/core#notation> "node_edge_color" .


<https://w3id.org/tvbo/node_mapping> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "node_mapping (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "HDF5 dataset path for node-to-parent mapping. Int32 array of shape (N,) where entry i is the parent node ID. Required when parent_network is set." ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "node_mapping" .


<https://w3id.org/tvbo/nodes> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "nodes (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#notation> "nodes" .


<https://w3id.org/tvbo/noise_type> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "noise_type (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Temporal character of the process: `gaussian`/`white` (delta-correlated in time) or `ou`/`ornstein-uhlenbeck` (exponentially correlated in time). Governs the TIME axis only, and composes freely with `covariance`, which governs a spatial axis." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "noise_type" .


<https://w3id.org/tvbo/non_negative> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "non_negative (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "All values >= 0" ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "non_negative" .


<https://w3id.org/tvbo/normals> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "normals (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Optional path inside the parent Network's h5 (or an external file) to per-vertex normals (N, 3) float. Default convention: ``mesh/normals``. A network saved with CSV companions names the CSV holding them here." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "normals" .


<https://w3id.org/tvbo/nrows> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "nrows (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Rows to fill. Unset holds every cell, so declaring only `ncols` wraps rather than drops; an explicit value still crops the extras, deliberately." ;
                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                              <http://www.w3.org/2004/02/skos/core#notation> "nrows" .


<https://w3id.org/tvbo/num_chains> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "num_chains (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Independent MCMC chains." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "num_chains" .


<https://w3id.org/tvbo/num_samples> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "num_samples (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Posterior samples to draw." ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "num_samples" .


<https://w3id.org/tvbo/num_warmup> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "num_warmup (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Warmup/adaptation steps before sampling." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "num_warmup" .


<https://w3id.org/tvbo/number> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "number (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#definition> "The panel letter to draw, overriding the mosaic key, or the string 'false' to draw none. Needed whenever the paper's panels do not map one-to-one onto mosaic cells: a row of five mode surfaces under a single (a), or a schematic cell that carries no letter of its own. Without it a grouped figure numbers every cell and its letters stop matching the paper's." ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                               <http://www.w3.org/2004/02/skos/core#notation> "number" .


<https://w3id.org/tvbo/number_of_elements> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                           rdfs:label "number_of_elements (slot)" ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "Number of elements (triangles, quads, tetrahedra, etc.)." ;
                                           <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                           <http://www.w3.org/2004/02/skos/core#notation> "number_of_elements" .


<https://w3id.org/tvbo/number_of_modes> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                        rdfs:label "number_of_modes (slot)" ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "Length of the mode axis every state variable carries (TVB's ``number_of_modes``): the same equations evaluated once per mode, the modes differing only through per-mode parameter vectors and mixing through mode-coupling matrices (``mode_dot``), as in the Stefanescu–Jirsa reduced sets. Distinct from ``components``, which nests different dynamics." ;
                                        <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                        <http://www.w3.org/2004/02/skos/core#notation> "number_of_modes" .


<https://w3id.org/tvbo/number_of_nodes> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                        rdfs:label "number_of_nodes (slot)" ;
                                        <http://www.w3.org/2004/02/skos/core#altLabel> "number_of_nodes" ,
                                                                                       "number_of_regions" ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "Number of nodes in the network, derived from `nodes` when it lists them. Beside a source (an `iri`, a `data_file`, a `bids_dir` or the curated network of a `parcellation`) it is the number of the source's nodes the network keeps: all of them at the source's own count, and below it a random subset drawn once at build from `execution.random_seed`, which `node_selection` then names. A count above the source's is refused." ;
                                        <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                        <http://www.w3.org/2004/02/skos/core#notation> "number_of_nodes" .


<https://w3id.org/tvbo/number_of_stages> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                         rdfs:label "number_of_stages (slot)" ;
                                         <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                         <http://www.w3.org/2004/02/skos/core#notation> "number_of_stages" .


<https://w3id.org/tvbo/number_of_subjects> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                           rdfs:label "number_of_subjects (slot)" ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "Number of subjects in the tractography dataset" ;
                                           <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                           <http://www.w3.org/2004/02/skos/core#notation> "number_of_subjects" .


<https://w3id.org/tvbo/number_of_vertices> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                           rdfs:label "number_of_vertices (slot)" ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "Number of vertices in the mesh." ;
                                           <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                           <http://www.w3.org/2004/02/skos/core#notation> "number_of_vertices" .


<https://w3id.org/tvbo/objectives> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "objectives (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Names of observations minimised by an adaptive `strategy` (e.g. 'nsga2'). Each entry references an existing observation already framed lower-is-better (e.g. `one_minus_fc`, `psd_mae`). Count sets the semantics: 0 → pure sweep (use `record`), 1 → single-objective, ≥2 → multi-objective / Pareto. Ignored when strategy is 'grid'. Forward-compatible with `Search.objectives`." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "objectives" .


<https://w3id.org/tvbo/observational_measures> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                               rdfs:label "observational_measures (slot)" ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "BEP017 measure names for observational targets (e.g., BoldCorrelation)" ;
                                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                               <http://www.w3.org/2004/02/skos/core#notation> "observational_measures" .


<https://w3id.org/tvbo/of> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                           rdfs:label "of (slot)" ;
                           <http://www.w3.org/2004/02/skos/core#definition> "Name of the input this step consumes — the positions for `pairwise_distance` / `distribution_pdf`, the matrix for `normalize`, the compared quantity for `stochastic_mask`, and for `sample` (which consumes no array) the Distribution-valued generator parameter to draw from. It names either a previously defined step or a generator parameter; steps are ordered, so a referenced step must already be defined." ;
                           <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                           <http://www.w3.org/2004/02/skos/core#notation> "of" .


<https://w3id.org/tvbo/on_region> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "on_region (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Mesh/atlas subset where BC applies." ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "on_region" .


<https://w3id.org/tvbo/out_dir> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "out_dir (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Output directory template. ``{study}`` and ``{experiment}`` are substituted with the study and experiment keys at emit time. Unset means the kit's own ``derivatives/tvbo``." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "out_dir" .


<https://w3id.org/tvbo/output> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "output (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#notation> "output" .


<https://w3id.org/tvbo/outputs> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "outputs (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#notation> "outputs" .


<https://w3id.org/tvbo/outsym> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "outsym (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#definition> "Output symbol names for the edge model. E.g. ['P'] for a scalar power flow, ['Fx', 'Fy'] for 2D forces. Maps directly to outsym in ND.jl EdgeModel. If not specified, derived from coupling variables of the connected vertex dynamics." ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                               <http://www.w3.org/2004/02/skos/core#notation> "outsym" .


<https://w3id.org/tvbo/over> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "over (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#notation> "over" .


<https://w3id.org/tvbo/palette> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "palette (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "The categorical hues, reached into only where a panel separates conditions. Ordered, and named by index from zero (`palette.0` is the first), so inserting a hue recolours every figure that names one after it." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "palette" .


<https://w3id.org/tvbo/panel_key> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "panel_key (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Mosaic label this panel binds to (matches a letter in Figure.layout)." ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "panel_key" .


<https://w3id.org/tvbo/panel_number_format> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                            rdfs:label "panel_number_format (slot)" ;
                                            <http://www.w3.org/2004/02/skos/core#notation> "panel_number_format" .


<https://w3id.org/tvbo/panel_numbers> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "panel_numbers (slot)" ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "panel_numbers" .


<https://w3id.org/tvbo/parallel_batch_size> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                            rdfs:label "parallel_batch_size (slot)" ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Chunk size for ``lax_map`` and chunked-``vmap`` modes. ``1`` = strictly sequential (minimum memory). Larger values amortise compile overhead across trials at the cost of memory. Ignored when parallel_mode is ``vmap`` (which always uses the full n_trials axis)." ;
                                            <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                            <http://www.w3.org/2004/02/skos/core#notation> "parallel_batch_size" .


<https://w3id.org/tvbo/parameter> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "parameter (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "parameter" .


<https://w3id.org/tvbo/parcel_map_field> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                         rdfs:label "parcel_map_field (slot)" ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "When the mesh is inlined on a Network with a parcellation, the dotted path inside the parent's h5 to the per-vertex parcel id array. Default: ``nodes/parent_index``." ;
                                         <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                         <http://www.w3.org/2004/02/skos/core#notation> "parcel_map_field" .


<https://w3id.org/tvbo/parent> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "parent (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#definition> "The network parameter giving each entry of this vocabulary its parent, an entry of a coarser vocabulary: it holds one code per entry of this one, each a code into the vocabulary its own ``levels`` names, or ``-1`` for an entry with no parent. Declares a hierarchy of vocabularies, such as the regions of an atlas within its lobes. A name no network parameter carries, one without ``levels``, a count of codes other than this vocabulary's entry count, and a code outside the parent vocabulary are refused when the network is resolved." ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                               <http://www.w3.org/2004/02/skos/core#notation> "parent" .


<https://w3id.org/tvbo/parent_network> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                       rdfs:label "parent_network (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Path/URI to parent (coarser) Network. When set, this network is a refinement where each node maps to exactly one parent node via node_mapping." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "parent_network" .


<https://w3id.org/tvbo/partition> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "partition (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "partition" .


<https://w3id.org/tvbo/path> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "path (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#notation> "path" .


<https://w3id.org/tvbo/permutations> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "permutations (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Name of the observer parameter holding the fixed ``(n_perm, n)`` permutation- index array (a produced/sourced constant, reused across the window and grid)." ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "permutations" .


<https://w3id.org/tvbo/permute> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "permute (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "The symbol whose entries are permuted (the observation source, or a parameter such as an in-strength vector)." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "permute" .


<https://w3id.org/tvbo/persist> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "persist (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Whether the result is kept as a container under the study. ``false`` declares a TRANSIENT analysis: it still runs in dependency order and its outputs feed every analysis that reads it in the same run, but they are written to a temporary directory outside the study for the length of the process, and no container, sidecar or provenance record of them is left behind. It is the form for an intermediate table whose rows are individual-level data (one row per subject of a cohort) that a study must not keep on disk, where only the reductions downstream are results. A transient analysis is re-run whenever a run needs it, counts as neither missing nor stale, and is read only by the analyses and experiments of the same run: a figure, a report or a kit, which read containers, are refused it by name." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "persist" .


<https://w3id.org/tvbo/placeholder> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "placeholder (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Honest-placeholder text drawn when this panel's data is missing or degenerate (never a source-replot). Setting it wraps the draw so a missing container falls back to this label instead of erroring." ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "placeholder" .


<https://w3id.org/tvbo/precision> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "precision (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Floating point precision: 'float32' or 'float64'" ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "precision" .


<https://w3id.org/tvbo/preconditioner> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                       rdfs:label "preconditioner (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "preconditioner" .


<https://w3id.org/tvbo/predicted> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "predicted (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Observation(s) the model PREDICTS, recomputed for every proposed theta. Defaults to `source`, which is right whenever the data enters from outside — a runtime-bound array or an empirical measure — because then the same observable serves both sides. Name it separately when the recording is itself declared in the forward pipeline: measurement noise applied to both sides is the same deterministic draw twice, so it cancels in the residual and the inference silently fits noiseless data." ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "predicted" .


<https://w3id.org/tvbo/primary_weight> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                       rdfs:label "primary_weight (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Name of the edge whose matrix is the network's weights: ``matrix(\"weight\")`` reads it, and a save writes the weights under it. Lets a single Network sidecar bundle several connectivity variants (e.g. band-specific NMF reweightings, distance-modulated SC, shuffled controls) under different edge names while presenting one of them as the weights to consumers (simulators, observation pipelines). Without it the weights are the ``weight`` edge; a network that holds its weights under another name (``sc``, ``weights``) declares that name here, and is refused naming the edge until it does." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "primary_weight" .


