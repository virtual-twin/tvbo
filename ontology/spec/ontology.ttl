###  https://w3id.org/tvbo/models/ZaslavskiiMap/state_variables/x
<https://w3id.org/tvbo/models/ZaslavskiiMap/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                        <https://w3id.org/tvbo/StateVariable> ;
                                                               <https://w3id.org/tvbo/lhs> "x_next" ;
                                                               <https://w3id.org/tvbo/rhs> "(x + nu*(1 + mu*y) + eps*nu*mu*cos(2*pi*x)) % 1" ;
