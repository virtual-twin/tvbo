                                                                    <https://w3id.org/tvbo/lhs> "SS1" ;
                                                                    <https://w3id.org/tvbo/rhs> "alpha*log(1 + exp(SS0/alpha))" ;
                                                                    <http://purl.org/dc/terms/description> "Softplus transfer function output" ;
