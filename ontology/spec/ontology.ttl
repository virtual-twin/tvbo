                                                                              <https://w3id.org/tvbo/ProcedureStepType#sample>
                                                                              <https://w3id.org/tvbo/ProcedureStepType#stochastic_mask>
                                                                            )
                                                              ] ;
                                          rdfs:subClassOf owl:Thing ;
                                          rdfs:isDefinedBy <https://w3id.org/tvbo/struct> ;
                                          rdfs:label "ProcedureStepType" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "The operation a ProcedureStep performs. `equation` is the general case (author-written algebra over previously-named intermediates); the others are named graph-construction operations whose options are fields rather than call syntax, so each lowers to a backend-native primitive without an expression string having to survive a parser." ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                          <https://w3id.org/linkml/permissible_values> <https://w3id.org/tvbo/ProcedureStepType#distribution_pdf> ,
                                                                                       <https://w3id.org/tvbo/ProcedureStepType#equation> ,
