                                                    rdfs:label "normalize (ProcedureStepType)" ;
                                                    <http://www.w3.org/2004/02/skos/core#definition> "Divide the intermediate named by `of` by its sum along `axis` (axis 0 gives uniform in-strength)." ;
                                                    <http://www.w3.org/2004/02/skos/core#notation> "normalize" .


###  https://w3id.org/tvbo/ProcedureStepType#pairwise_distance
<https://w3id.org/tvbo/ProcedureStepType#pairwise_distance> rdf:type owl:Class ;
                                                            rdfs:subClassOf <https://w3id.org/tvbo/ProcedureStepType> ;
                                                            rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                            rdfs:label "pairwise_distance (ProcedureStepType)" ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "Distance matrix between the rows of the positions named by `of` (euclidean). `diagonal` optionally overwrites the self-distance, e.g. to infinity so a decaying distance kernel evaluates to zero there and no node connects to itself." ;
                                                            <http://www.w3.org/2004/02/skos/core#notation> "pairwise_distance" .


###  https://w3id.org/tvbo/ProcedureStepType#sample
<https://w3id.org/tvbo/ProcedureStepType#sample> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/tvbo/ProcedureStepType> ;
                                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                 rdfs:label "sample (ProcedureStepType)" ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "A random matrix drawn from `distribution` — the draw itself, e.g. the substrate of a random reservoir. Distinct from `stochastic_mask`, which compares a draw and yields a boolean." ;
                                                 <http://www.w3.org/2004/02/skos/core#notation> "sample" .


###  https://w3id.org/tvbo/ProcedureStepType#stochastic_mask
<https://w3id.org/tvbo/ProcedureStepType#stochastic_mask> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://w3id.org/tvbo/ProcedureStepType> ;
