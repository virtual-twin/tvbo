###  https://w3id.org/tvbo/neuroml/network
<https://w3id.org/tvbo/neuroml/network> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseStandalone> ;
                                        <http://purl.org/dc/terms/description> "Network containing: _population_s (potentially of type _populationList_, and so specifying a list of cell _location_s); _projection_s (with lists of _connection_s) and/or _explicitConnection_s; and _inputList_s (with lists of _input_s) and/or _explicitInput_s. Note: often in NeuroML this will be of type _networkWithTemperature_ if there are temperature dependent elements (e.g. ion channels)."@en ;
                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                        rdfs:label "network"@en ;
                                        <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#network> .


