                                                             <https://w3id.org/tvbo/rhs> "( -N + G ) / tau" ;
                                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                             rdfs:label "N (MorrisLecar state variable)" ;
                                                             <http://www.w3.org/2004/02/skos/core#notation> "N" .


###  https://w3id.org/tvbo/models/MorrisLecar/state_variables/V
<https://w3id.org/tvbo/models/MorrisLecar/state_variables/V> rdf:type owl:NamedIndividual ,
                                                                      <https://w3id.org/tvbo/StateVariable> ;
                                                             <https://w3id.org/tvbo/lhs> "Derivative(V, t)" ;
                                                             <https://w3id.org/tvbo/rhs> "-gCa*M*(V - VCa) - gK*N*(V - VK) - gL*(V - VL) + I" ;
                                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                             rdfs:label "V (MorrisLecar state variable)" ;
                                                             <http://www.w3.org/2004/02/skos/core#notation> "V" .


###  https://w3id.org/tvbo/models/NLDCoupledLogisticMaps4/parameters/k
