                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                               rdfs:label "lfp (Epileptor derived variable)" ;
                                                               <http://www.w3.org/2004/02/skos/core#notation> "lfp" .


