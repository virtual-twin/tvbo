###  https://w3id.org/tvbo/MissingValuePolicy#refuse
<https://w3id.org/tvbo/MissingValuePolicy#refuse> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://w3id.org/tvbo/MissingValuePolicy> ;
                                                  rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                  rdfs:label "refuse (MissingValuePolicy)" ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "An error that states how many candidates have none." ;
                                                  <http://www.w3.org/2004/02/skos/core#notation> "refuse" .


