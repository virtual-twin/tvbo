<https://w3id.org/tvbo/HomoclinicBifurcation> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/tvbo/Bifurcation> .


###  https://w3id.org/tvbo/Hopf
<https://w3id.org/tvbo/Hopf> rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( <https://w3id.org/tvbo/Bifurcation>
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <https://w3id.org/tvbo/hasCodimension> ;
                                                                          owl:hasValue <https://w3id.org/tvbo/Codimension1>
                                                                        ]
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <https://w3id.org/tvbo/hasEigenvalueSignature> ;
                                                                          owl:hasValue <https://w3id.org/tvbo/ConjugatePairImaginary>
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:subClassOf <https://w3id.org/tvbo/Bifurcation> .


###  https://w3id.org/tvbo/HopfHopf
<https://w3id.org/tvbo/HopfHopf> rdf:type owl:Class ;
