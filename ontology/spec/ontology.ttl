                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/tvbo/hasEigenvalueSignature> ;
                                                         owl:hasValue <https://w3id.org/tvbo/DoubleZeroEigenvalue>
                                                       ] ;
                                       rdfs:comment "Codim-2 point with a double-zero (nilpotent) eigenvalue, where fold, Hopf and homoclinic curves meet."@en ;
                                       rdfs:label "Bogdanov-Takens"@en ;
                                       <http://www.w3.org/2004/02/skos/core#altLabel> "BT" ,
                                                                                      "bogdanov takens" ,
