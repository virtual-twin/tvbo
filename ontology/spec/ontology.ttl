                                                                                                                                                    <http://schema.org/defaultValue> "3.0"^^xsd:double ;
                                                                                                                                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                                                                                                    rdfs:label "conduction_speed (tpl-fsaverage_cohort-HCPYA_rec-avgMatrix_hemi-L_atlas-Lobar8_den-164k_desc-surf_relmat parameter)" ;
                                                                                                                                                    <http://www.w3.org/2004/02/skos/core#notation> "conduction_speed" ;
                                                                                                                                                    <https://w3id.org/tvbo/unit> "mm_per_ms" .


###  https://w3id.org/tvbo/networks/tpl-fsaverage_cohort-HCPYA_rec-avgMatrix_hemi-R_atlas-Lobar8_den-164k_desc-surf_relmat/parameters/conduction_speed
<https://w3id.org/tvbo/networks/tpl-fsaverage_cohort-HCPYA_rec-avgMatrix_hemi-R_atlas-Lobar8_den-164k_desc-surf_relmat/parameters/conduction_speed> rdf:type owl:NamedIndividual ,
                                                                                                                                                             <https://w3id.org/tvbo/Parameter> ;
