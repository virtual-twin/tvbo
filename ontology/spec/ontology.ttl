                                             rdfs:label "intensity_projection (slot)" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "How voxels collapse along the view axis (`absmax` by default)." ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
