                                            rdfs:label "round (TickPlacement)" ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Re-placed on the multiples of a round step (one of `tick_steps` times a power of ten), at most `max_ticks` of them, so every label states its tick exactly." ;
                                            <http://www.w3.org/2004/02/skos/core#notation> "round" .


