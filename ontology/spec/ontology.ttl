###  https://w3id.org/tvbo/models/KIonEx/derived_variables/r
<https://w3id.org/tvbo/models/KIonEx/derived_variables/r> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/DerivedVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "r" ;
