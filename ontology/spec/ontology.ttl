                                                   owl:hasValue <https://w3id.org/tvbo/TwoImaginaryPairs>
                                                 ] ;
                                 rdfs:comment "Codim-2 point where two Hopf curves cross (two imaginary pairs simultaneously)."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
