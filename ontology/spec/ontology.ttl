                                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                          rdfs:label "x1 (NLDCoupledLogisticMaps4 state variable)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "x1" .


###  https://w3id.org/tvbo/models/NLDCoupledLogisticMaps4/state_variables/x2
