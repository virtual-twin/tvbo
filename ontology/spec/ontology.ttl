                                             rdfs:label "native (TickPlacement)" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "The plotting backend's own locator: nothing is re-placed, so the ticks are the ones the drawing produced. What an axis gets when no theme says otherwise." ;
                                             <http://www.w3.org/2004/02/skos/core#notation> "native" .


###  https://w3id.org/tvbo/TickPlacement#round
<https://w3id.org/tvbo/TickPlacement#round> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/tvbo/TickPlacement> ;
