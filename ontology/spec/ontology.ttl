                                                                   <https://w3id.org/tvbo/rhs> "alpha_h*(1 - h) - beta_h*h" ;
                                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                   rdfs:label "h (HodgkinHuxley_Q10 state variable)" ;
                                                                   <http://www.w3.org/2004/02/skos/core#notation> "h" .


###  https://w3id.org/tvbo/models/HodgkinHuxley_Q10/state_variables/m
<https://w3id.org/tvbo/models/HodgkinHuxley_Q10/state_variables/m> rdf:type owl:NamedIndividual ,
                                                                            <https://w3id.org/tvbo/StateVariable> ;
                                                                   <https://w3id.org/tvbo/rhs> "alpha_m*(1 - m) - beta_m*m" ;
                                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                   rdfs:label "m (HodgkinHuxley_Q10 state variable)" ;
                                                                   <http://www.w3.org/2004/02/skos/core#notation> "m" .


###  https://w3id.org/tvbo/models/HodgkinHuxley_Q10/state_variables/n
<https://w3id.org/tvbo/models/HodgkinHuxley_Q10/state_variables/n> rdf:type owl:NamedIndividual ,
                                                                            <https://w3id.org/tvbo/StateVariable> ;
                                                                   <https://w3id.org/tvbo/rhs> "alpha_n*(1 - n) - beta_n*n" ;
                                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                   rdfs:label "n (HodgkinHuxley_Q10 state variable)" ;
                                                                   <http://www.w3.org/2004/02/skos/core#notation> "n" .


###  https://w3id.org/tvbo/models/HodgkinHuxley_Q10/state_variables/v
<https://w3id.org/tvbo/models/HodgkinHuxley_Q10/state_variables/v> rdf:type owl:NamedIndividual ,
                                                                            <https://w3id.org/tvbo/StateVariable> ;
                                                                   <https://w3id.org/tvbo/rhs> "(-g_Na*m**3*h*(v - E_Na) - g_K*n**4*(v - E_K) - g_L*(v - E_L) + I_ext*1000) / C" ;
                                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                   rdfs:label "v (HodgkinHuxley_Q10 state variable)" ;
                                                                   <http://www.w3.org/2004/02/skos/core#notation> "v" .


###  https://w3id.org/tvbo/models/Hopfield/parameters/dynamic
<https://w3id.org/tvbo/models/Hopfield/parameters/dynamic> rdf:type owl:NamedIndividual ,
                                                                    <https://w3id.org/tvbo/Parameter> ;
                                                           <http://purl.org/dc/terms/description> "Threshold dynamics: 0 (default) -> theta tracks x (TVB display hack); >0 -> theta relaxes to its own coupling input." ;
                                                           <http://schema.org/defaultValue> "0.0"^^xsd:double ;
                                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                           rdfs:label "dynamic (Hopfield parameter)" ;
                                                           <http://www.w3.org/2004/02/skos/core#notation> "dynamic" .


###  https://w3id.org/tvbo/models/Hopfield/parameters/tauT
<https://w3id.org/tvbo/models/Hopfield/parameters/tauT> rdf:type owl:NamedIndividual ,
                                                                 <https://w3id.org/tvbo/Parameter> ;
                                                        <http://purl.org/dc/terms/description> "The slow time-scale for threshold calculus :math:`\\theta`, state-variable of the model" ;
                                                        <http://schema.org/defaultValue> "5.0"^^xsd:double ;
                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                        rdfs:label "tauT (Hopfield parameter)" ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "The slow time-scale for threshold calculus :math:`\\theta`, state-variable of the model." ;
                                                        <http://www.w3.org/2004/02/skos/core#notation> "tauT" .


###  https://w3id.org/tvbo/models/Hopfield/parameters/taux
<https://w3id.org/tvbo/models/Hopfield/parameters/taux> rdf:type owl:NamedIndividual ,
                                                                 <https://w3id.org/tvbo/Parameter> ;
                                                        <http://purl.org/dc/terms/description> "The fast time-scale for potential calculus :math:`x`, state-variable of the model" ;
                                                        <http://schema.org/defaultValue> "1.0"^^xsd:double ;
                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                        rdfs:label "taux (Hopfield parameter)" ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "The fast time-scale for potential calculus :math:`x`, state-variable of the model." ;
                                                        <http://www.w3.org/2004/02/skos/core#notation> "taux" .


###  https://w3id.org/tvbo/models/Hopfield/state_variables/theta
<https://w3id.org/tvbo/models/Hopfield/state_variables/theta> rdf:type owl:NamedIndividual ,
                                                                       <https://w3id.org/tvbo/StateVariable> ;
                                                              <https://w3id.org/tvbo/lhs> "Derivative(theta, t)" ;
                                                              <https://w3id.org/tvbo/rhs> "Piecewise(((c_glob1 - theta)/tauT, dynamic > 0), ((c_glob0 - x)/taux, True))" ;
                                                              <http://purl.org/dc/terms/description> "Slow state variable at node i" ;
                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                              rdfs:label "theta (Hopfield state variable)" ;
                                                              <http://www.w3.org/2004/02/skos/core#notation> "theta" .


###  https://w3id.org/tvbo/models/Hopfield/state_variables/x
<https://w3id.org/tvbo/models/Hopfield/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(x, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "(c_glob0 - x)/taux" ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "x (Hopfield state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "x" .


