                                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                          rdfs:label "x2 (NLDCoupledLogisticMaps4 state variable)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "x2" .


###  https://w3id.org/tvbo/models/NLDCoupledLogisticMaps4/state_variables/x3
