                                          rdfs:label "vmap (ParallelMode)" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "Parallel batched execution (jax.vmap). Fast; high peak memory." ;
                                          <http://www.w3.org/2004/02/skos/core#notation> "vmap" .


###  https://w3id.org/tvbo/ProcedureStepType#distribution_pdf
