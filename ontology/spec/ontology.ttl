###  https://w3id.org/tvbo/neuroml/subGate
<https://w3id.org/tvbo/neuroml/subGate> rdf:type owl:Class ;
                                        rdfs:subClassOf owl:Thing ;
                                        <http://purl.org/dc/terms/description> "Gate composed of subgates contributing with fractional conductance"@en ;
                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                        rdfs:label "subGate"@en ;
                                        <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#subGate> ;
                                        <https://w3id.org/tvbo/neuroml/exposes> "inf" ,
                                                                                "q" ,
                                                                                "qfrac" ,
                                                                                "tau" ;
                                        <https://w3id.org/tvbo/neuroml/hasParameter> "fractionalConductance" ;
                                        <https://w3id.org/tvbo/neuroml/requires> "rateScale" .


###  https://w3id.org/tvbo/neuroml/subTree
