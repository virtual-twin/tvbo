<https://w3id.org/tvbo/models/Sakarya/parameters/b> rdf:type owl:NamedIndividual ,
                                                             <https://w3id.org/tvbo/Parameter> ;
                                                    <http://purl.org/dc/terms/description> "Constant drive term b." ;
