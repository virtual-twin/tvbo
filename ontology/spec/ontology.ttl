                                       <http://purl.org/dc/terms/description> "JAX-based virtual brain library. Provides stochastic Heun integrators for ODE/SDE/DDE/SDDE, canonical neural-mass models (Jansen-Rit, Montbrio-Pazo-Roxin, BVEP, bilinear DCM, Dopa), BOLD/EEG monitors, delay-coupling helpers, a spherical-harmonic neural-field operator, and JAX-native parameter sweeps with gradient-based fitting and MCMC." ;
                                       <http://purl.org/dc/terms/license> "Apache-2.0" ;
                                       <http://schema.org/codeRepository> "https://github.com/ins-amu/vbjax" ;
                                       <http://schema.org/identifier> "10.5281/zenodo.14204250" ;
                                       <http://schema.org/url> "https://github.com/ins-amu/vbjax" ;
                                       rdfs:label "vbjax" .


