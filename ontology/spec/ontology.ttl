                                                                      <http://schema.org/defaultValue> "1.2"^^xsd:double ;
                                                                      rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                      rdfs:label "lam (NLDCoupledLogisticMaps4 parameter)" ;
                                                                      <http://www.w3.org/2004/02/skos/core#notation> "lam" .


###  https://w3id.org/tvbo/models/NLDCoupledLogisticMaps4/state_variables/x0
<https://w3id.org/tvbo/models/NLDCoupledLogisticMaps4/state_variables/x0> rdf:type owl:NamedIndividual ,
                                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                                          <https://w3id.org/tvbo/lhs> "x0_next" ;
                                                                          <https://w3id.org/tvbo/rhs> "lam - x0**2 + k*((x1**2 - x0**2) + (x2**2 - x0**2) + (x3**2 - x0**2))" ;
                                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                          rdfs:label "x0 (NLDCoupledLogisticMaps4 state variable)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "x0" .


