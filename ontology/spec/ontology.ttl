@prefix : <https://w3id.org/tvbo/tvbo.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/tvbo/tvbo.owl#> .

<https://w3id.org/tvbo/tvbo.owl> rdf:type owl:Ontology ;
                                  owl:versionIRI <https://w3id.org/tvbo/0.9.0/tvbo.owl> ;
                                  <http://purl.org/dc/terms/bibliographicCitation> "https://doi.org/10.1101/2025.11.19.689211" ;
                                  <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0001-5266-7235> ,
                                                                     <https://orcid.org/0000-0002-2599-0165> ,
                                                                     <https://orcid.org/0000-0002-4643-4782> ,
                                                                     <https://orcid.org/0000-0003-0197-2576> ;
                                  <http://purl.org/dc/terms/description> "TVB-O, The Virtual Brain Ontology, describes large-scale brain network models and their simulation: neural mass and neural field models with their parameters, state variables and equations, coupling functions, connectomes and brain atlases, integrators and noise, observation models, and the simulation experiments and studies that combine them. Every model, network and experiment curated in the TVB-O database is an individual of the ontology at https://w3id.org/tvbo/<collection>/<name>."@en ;
                                  <http://purl.org/dc/terms/issued> "2025-11-20"^^xsd:date ;
                                  <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                  <http://purl.org/dc/terms/modified> "2026-11-13"^^xsd:date ;
                                  <http://purl.org/dc/terms/title> "The Virtual Brain Ontology"@en ;
                                  <http://purl.org/pav/version> "0.9.0" ;
                                  <http://purl.org/vocab/vann/preferredNamespacePrefix> "tvbo" ;
                                  <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/tvbo/" ;
                                  rdfs:label "TVB-O" ;
                                  rdfs:seeAlso <https://w3id.org/tvbo/tvb-o-axioms.ttl> ,
                                               <https://w3id.org/tvbo/tvb-o.shacl.ttl> ;
                                  owl:versionInfo "0.9.0" .

