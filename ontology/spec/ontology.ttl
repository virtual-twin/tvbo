                                                   rdfs:label "pointCellCondBased"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#pointCellCondBased> ;
                                                   <https://w3id.org/tvbo/neuroml/hasParameter> "thresh" ,
                                                                                                "v0" .


