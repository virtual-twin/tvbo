###  https://w3id.org/tvbo/backendParameter
<https://w3id.org/tvbo/backendParameter> rdf:type owl:AnnotationProperty ;
                                         rdfs:comment "Concrete backend parameter that realises a backend-neutral tvbo term (e.g. the tvboptim solver keyword an evaluation scheme lowers to). Documentary: states how a value is enacted per backend without binding tvbo to any one of them."@en ;
                                         rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                         rdfs:label "backend parameter"@en .


###  https://w3id.org/tvbo/boundConstraint
<https://w3id.org/tvbo/boundConstraint> rdf:type owl:AnnotationProperty ;
                                        rdfs:comment "Numerical pre-condition the realised parameter must satisfy for the capability to stay correct."@en ;
                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                        rdfs:label "bound constraint"@en .


###  https://w3id.org/tvbo/canonicalCode
<https://w3id.org/tvbo/canonicalCode> rdf:type owl:AnnotationProperty ;
                                      rdfs:comment "Backend-independent short code for a special-point type (e.g. \"LP\", \"HB\", \"BP\"). The Python special-point label map derives (altLabel → canonicalCode) from these annotations."@en ;
                                      rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "canonical code"@en .


###  https://w3id.org/tvbo/enabledByCouplingSlot
<https://w3id.org/tvbo/enabledByCouplingSlot> rdf:type owl:AnnotationProperty ;
                                              rdfs:comment "Name of the concrete Coupling metadata slot a SimulationExperiment must set to True to realise this capability; read at configure() time to materialise the slot."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                              rdfs:label "enabled by coupling slot"@en .


###  https://w3id.org/tvbo/enabledByGraphParameter
<https://w3id.org/tvbo/enabledByGraphParameter> rdf:type owl:AnnotationProperty ;
                                                rdfs:comment "Name of the concrete graph parameter a SimulationExperiment must set to realise this capability; read at configure() time to materialise the value."@en ;
                                                rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                rdfs:label "enabled by graph parameter"@en .


###  https://w3id.org/tvbo/enabledByIntegrationSlot
<https://w3id.org/tvbo/enabledByIntegrationSlot> rdf:type owl:AnnotationProperty ;
                                                 rdfs:comment "Name (optionally followed by ':' and the required value) of the Integration/Integrator metadata slot a SimulationExperiment must set to realise this capability; read at configure() time to materialise the slot."@en ;
                                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                 rdfs:label "enabled by integration slot"@en .


###  https://w3id.org/tvbo/hasDerivedVariable
<https://w3id.org/tvbo/hasDerivedVariable> rdf:type owl:AnnotationProperty ;
                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                           rdfs:label "hasDerivedVariable" .


###  https://w3id.org/tvbo/hasParameter
<https://w3id.org/tvbo/hasParameter> rdf:type owl:AnnotationProperty ;
                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "hasParameter" .


###  https://w3id.org/tvbo/hasStateVariable
<https://w3id.org/tvbo/hasStateVariable> rdf:type owl:AnnotationProperty ;
                                         rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                         rdfs:label "hasStateVariable" .


###  https://w3id.org/tvbo/model_type
<https://w3id.org/tvbo/model_type> rdf:type owl:AnnotationProperty ;
                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "model_type (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Coarse classification of this model (mean_field, neural_mass, phase_oscillator, phenomenological, spiking, generic, field). Used for filtering in Dynamics.list_db(model_type=...)." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "model_type" .


###  https://w3id.org/tvbo/realisedByBackend
<https://w3id.org/tvbo/realisedByBackend> rdf:type owl:AnnotationProperty ;
                                          rdfs:comment "Backend(s) whose codegen currently lowers this analysis observable to a concrete implementation."@en ;
                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                          rdfs:label "realised by backend"@en .


###  https://w3id.org/tvbo/unit
<https://w3id.org/tvbo/unit> rdf:type owl:AnnotationProperty .


###  https://w3id.org/tvbo/clinical/icd11Code
<https://w3id.org/tvbo/clinical/icd11Code> rdf:type owl:AnnotationProperty ;
                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                           rdfs:label "ICD-11 code" .


###  https://w3id.org/tvbo/neuroml/eventPort
<https://w3id.org/tvbo/neuroml/eventPort> rdf:type owl:AnnotationProperty ;
                                          rdfs:comment "An event port declared by this NeuroML ComponentType."@en ;
                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                          rdfs:label "event port"@en .


###  https://w3id.org/tvbo/neuroml/exposes
<https://w3id.org/tvbo/neuroml/exposes> rdf:type owl:AnnotationProperty ;
                                        rdfs:comment "A quantity this NeuroML ComponentType exposes."@en ;
                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                        rdfs:label "exposes"@en .


###  https://w3id.org/tvbo/neuroml/hasParameter
<https://w3id.org/tvbo/neuroml/hasParameter> rdf:type owl:AnnotationProperty ;
                                             rdfs:comment "A parameter declared by this NeuroML ComponentType."@en ;
                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                             rdfs:label "has parameter"@en .


###  https://w3id.org/tvbo/neuroml/requires
<https://w3id.org/tvbo/neuroml/requires> rdf:type owl:AnnotationProperty ;
                                         rdfs:comment "A quantity this NeuroML ComponentType requires from its context."@en ;
                                         rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                         rdfs:label "requires"@en .


