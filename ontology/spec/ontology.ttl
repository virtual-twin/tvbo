                                                    owl:onProperty <https://w3id.org/tvbo/direction> ;
                                                    owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/tvbo/permutations> ;
                                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/tvbo/permute> ;
                                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
