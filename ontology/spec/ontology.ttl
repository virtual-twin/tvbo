###  https://w3id.org/tvbo/models/HyperRoessler/state_variables/w
<https://w3id.org/tvbo/models/HyperRoessler/state_variables/w> rdf:type owl:NamedIndividual ,
                                                                        <https://w3id.org/tvbo/StateVariable> ;
                                                               <https://w3id.org/tvbo/lhs> "Derivative(w, t)" ;
                                                               <https://w3id.org/tvbo/rhs> "-d*z + y*w" ;
                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                               rdfs:label "w (HyperRoessler state variable)" ;
                                                               <http://www.w3.org/2004/02/skos/core#notation> "w" .


###  https://w3id.org/tvbo/models/HyperRoessler/state_variables/x
<https://w3id.org/tvbo/models/HyperRoessler/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                        <https://w3id.org/tvbo/StateVariable> ;
                                                               <https://w3id.org/tvbo/lhs> "Derivative(x, t)" ;
                                                               <https://w3id.org/tvbo/rhs> "-(y + z)" ;
                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                               rdfs:label "x (HyperRoessler state variable)" ;
                                                               <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/models/HyperRoessler/state_variables/y
<https://w3id.org/tvbo/models/HyperRoessler/state_variables/y> rdf:type owl:NamedIndividual ,
                                                                        <https://w3id.org/tvbo/StateVariable> ;
                                                               <https://w3id.org/tvbo/lhs> "Derivative(y, t)" ;
                                                               <https://w3id.org/tvbo/rhs> "x + a*y + w" ;
                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                               rdfs:label "y (HyperRoessler state variable)" ;
                                                               <http://www.w3.org/2004/02/skos/core#notation> "y" .


###  https://w3id.org/tvbo/models/HyperRoessler/state_variables/z
<https://w3id.org/tvbo/models/HyperRoessler/state_variables/z> rdf:type owl:NamedIndividual ,
                                                                        <https://w3id.org/tvbo/StateVariable> ;
                                                               <https://w3id.org/tvbo/lhs> "Derivative(z, t)" ;
                                                               <https://w3id.org/tvbo/rhs> "b + z*(x - c)" ;
                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                               rdfs:label "z (HyperRoessler state variable)" ;
                                                               <http://www.w3.org/2004/02/skos/core#notation> "z" .


