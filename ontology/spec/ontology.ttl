                                                                                  <https://w3id.org/tvbo/models/JansenRit/state_variables/y4> ,
                                                                                  <https://w3id.org/tvbo/models/JansenRit/state_variables/y5> ;
                                         <https://w3id.org/tvbo/model_type> "neural_mass" .

