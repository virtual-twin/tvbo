###  https://w3id.org/tvbo/models/ThomasCyclical/state_variables/y
<https://w3id.org/tvbo/models/ThomasCyclical/state_variables/y> rdf:type owl:NamedIndividual ,
                                                                         <https://w3id.org/tvbo/StateVariable> ;
                                                                <https://w3id.org/tvbo/lhs> "Derivative(y, t)" ;
                                                                <https://w3id.org/tvbo/rhs> "sin(z) - b*y" ;
                                                                rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                rdfs:label "y (ThomasCyclical state variable)" ;
                                                                <http://www.w3.org/2004/02/skos/core#notation> "y" .


