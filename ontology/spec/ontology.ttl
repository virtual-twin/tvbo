<https://w3id.org/tvbo/direction> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "direction (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "direction" .


<https://w3id.org/tvbo/doi> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                            rdfs:label "doi (slot)" ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                            <http://www.w3.org/2004/02/skos/core#notation> "doi" .


<https://w3id.org/tvbo/dpi> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                            rdfs:label "dpi (slot)" ;
                            <http://www.w3.org/2004/02/skos/core#notation> "dpi" .


<https://w3id.org/tvbo/drop> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "drop (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Labels of the nodes that are dropped; every other node stays." ;
                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                             <http://www.w3.org/2004/02/skos/core#notation> "drop" .


<https://w3id.org/tvbo/dtype> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "dtype (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#notation> "dtype" .


<https://w3id.org/tvbo/edge_color> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "edge_color (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "edge_color" .


<https://w3id.org/tvbo/editable_text> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "editable_text (slot)" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Keep text as text in vector output (embedded TrueType in PDF and PostScript, live text in SVG), so a typesetter can edit a label instead of receiving outlines." ;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "editable_text" .


<https://w3id.org/tvbo/element> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "element (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Element/node index this range applies to. Used in element_domains to explicitly link a domain to a specific element of a heterogeneous parameter (e.g., element: 0 for node 0). Required when used in element_domains to avoid ambiguous positional indexing." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "element" .


<https://w3id.org/tvbo/elements> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "elements (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Topology indices: either a file reference, or (when inlined on a Network) a dotted path inside the parent Network's h5 companion to the (M, 3) int triangle face array. Default convention: ``mesh/faces``. A network saved with CSV companions names the CSV holding them here." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "elements" .


<https://w3id.org/tvbo/emit> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "emit (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Expression reading the reduced value out of the state." ;
                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                             <http://www.w3.org/2004/02/skos/core#notation> "emit" .


<https://w3id.org/tvbo/ended_at> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "ended_at (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "ISO 8601 end time." ;
                                 <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.w3.org/ns/prov#endedAtTime> ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "ended_at" .


<https://w3id.org/tvbo/equation_order> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                       rdfs:label "equation_order (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Order of the time derivative on the LHS. Default 1 means dx/dt = rhs (first-order ODE). Order 2 means d²x/dt² = rhs (second-order ODE), etc. Higher-order ODEs are automatically lowered to coupled first-order systems by backends like ModelingToolkit.jl via mtkcompile." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "equation_order" .


<https://w3id.org/tvbo/equation_type> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "equation_type (slot)" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "How to interpret ``equation.rhs`` when advancing this state: 'differential' (default) integrates it as ``dx/dt = rhs``; 'algebraic' is a constraint ``0 = rhs`` / ``x ~ rhs`` (DAE); 'recurrence' is a discrete per-step update ``x_next = rhs`` (no integrator applied), used by an observation's auxiliary ``dynamics`` for online reductions/accumulators (e.g. a running sum ``x_next = x + f``) — the symbolic, backend-independent sibling of the continuous 'differential' form. Algebraic equations are used by ModelingToolkit.jl backend." ;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "equation_type" .


<https://w3id.org/tvbo/evaluate> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "evaluate (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Materialise this algorithm's post-tuning evaluation: a simulation of the tuned model over the experiment's full duration, recorded as algorithm__<name>__<observation>. False keeps only the tuned parameters and state, which is all a dependency of another algorithm contributes - the algorithm that follows supersedes its observations - while the evaluation itself costs a complete run of the experiment's duration." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "evaluate" .


<https://w3id.org/tvbo/executor> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "executor (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Executor to run the pipeline through (Nextflow process.executor)." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "executor" .


<https://w3id.org/tvbo/experiment_yaml_hash> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                             rdfs:label "experiment_yaml_hash (slot)" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "SHA-256 hex digest of the normalised experiment YAML that produced this artifact. Used by the cross-experiment cache (see :class:`SimulationStudy.from_file`) to detect when a cached upstream result has gone stale because the experiment's spec was edited. Computed as ``hashlib.sha256(yaml.safe_dump(normalized_yaml).encode()).hexdigest()`` over the fully resolved (post-``!include``) experiment block." ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                             <http://www.w3.org/2004/02/skos/core#notation> "experiment_yaml_hash" .


<https://w3id.org/tvbo/exponent_as_power> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                          rdfs:label "exponent_as_power (slot)" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "Write an axis's shared exponent as a power of ten (x10^-3 typeset) rather than in E notation (1e-3)." ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                          <http://www.w3.org/2004/02/skos/core#notation> "exponent_as_power" .


<https://w3id.org/tvbo/expression> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "expression (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "expression" .


<https://w3id.org/tvbo/extension> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "extension (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "extension" .


<https://w3id.org/tvbo/family_wise> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "family_wise (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Apply a Westfall–Young family-wise (max-T) correction: collapse the permuted statistic to its extremum over the element axes, forming one family-wise null per permutation that every observed element is tested against. The extremum follows ``direction`` (``greater_equal`` → maximum, ``less_equal`` → minimum). Absent → the symmetric per-element test." ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "family_wise" .


<https://w3id.org/tvbo/field> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "field (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#notation> "field" .


<https://w3id.org/tvbo/fill> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "fill (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Fill the rectangle rather than outlining it. A filled region sits under the data." ;
                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                             <http://www.w3.org/2004/02/skos/core#notation> "fill" .


<https://w3id.org/tvbo/fill_cell> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "fill_cell (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "fill_cell" .


<https://w3id.org/tvbo/find_fixpoint> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "find_fixpoint (slot)" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Whether to find a fixed point (steady state) before time integration. Used as initial condition for ODEProblem. Maps to NLsolve.fixpoint! in ND.jl or similar in other backends." ;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "find_fixpoint" .


<https://w3id.org/tvbo/font_family> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "font_family (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "The typefaces to set text in, most-wanted first (`[Helvetica, Arial, DejaVu Sans]`). A generic family (`sans-serif`, `serif`, `monospace`) as the first entry selects that family outright; otherwise the list is taken as the concrete faces to try within `sans-serif`, which is how a person means it." ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "font_family" .


