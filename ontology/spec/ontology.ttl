###  https://w3id.org/tvbo/models/HyperRoessler/parameters/d
<https://w3id.org/tvbo/models/HyperRoessler/parameters/d> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/Parameter> ;
                                                          <http://purl.org/dc/terms/description> "Parameter d for fourth dimension coupling." ;
                                                          <http://schema.org/defaultValue> "0.05"^^xsd:double ;
