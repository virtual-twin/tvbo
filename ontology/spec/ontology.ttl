                                                          rdfs:label "x (EpileptorCodim3 state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/EpileptorCodim3/state_variables/y
<https://w3id.org/tvbo/EpileptorCodim3/state_variables/y> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(y, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "x**3 - mu2*x - mu1 - y*(nu + b*x + x**2)" ;
                                                          <http://purl.org/dc/terms/description> "Fast subsystem variable y." ;
                                                          rdfs:label "y (EpileptorCodim3 state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "y" .


###  https://w3id.org/tvbo/EpileptorCodim3/state_variables/z
