<https://w3id.org/tvbo/models/PinskyRinzelCA3/derived_variables/alpha_hs> rdf:type owl:NamedIndividual ,
                                                                                   <https://w3id.org/tvbo/DerivedVariable> ;
                                                                          <https://w3id.org/tvbo/rhs> "0.128*exp((-43.0 - Vs)/18.0)" ;
                                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                          rdfs:label "alpha_hs (PinskyRinzelCA3 derived variable)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "alpha_hs" .


