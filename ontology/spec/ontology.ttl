                                              rdfs:label "distalDetails"@en ;
                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#distalDetails> .


###  https://w3id.org/tvbo/neuroml/doubleSynapse
<https://w3id.org/tvbo/neuroml/doubleSynapse> rdf:type owl:Class ;
