###  https://w3id.org/tvbo/models/MagneticPendulum/derived_variables/sum_gamma_terms_x
<https://w3id.org/tvbo/models/MagneticPendulum/derived_variables/sum_gamma_terms_x> rdf:type owl:NamedIndividual ,
                                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                                    <https://w3id.org/tvbo/lhs> "sum_gamma_terms_x" ;
                                                                                    <https://w3id.org/tvbo/rhs> "gamma*((x - 1)/((x - 1)**2 + y**2 + d**2)**(3/2) + (x - cos(2*pi/3))/((x - cos(2*pi/3))**2 + (y - sin(2*pi/3))**2 + d**2)**(3/2) + (x - cos(4*pi/3))/((x - cos(4*pi/3))**2 + (y - sin(4*pi/3))**2 + d**2)**(3/2))" ;
                                                                                    <http://purl.org/dc/terms/description> "Sum over magnetic x-forces for N magnets on unit circle (default N=3 expanded)." ;
                                                                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                                    rdfs:label "sum_gamma_terms_x (MagneticPendulum derived variable)" ;
                                                                                    <http://www.w3.org/2004/02/skos/core#notation> "sum_gamma_terms_x" .


###  https://w3id.org/tvbo/models/MagneticPendulum/derived_variables/sum_gamma_terms_y
<https://w3id.org/tvbo/models/MagneticPendulum/derived_variables/sum_gamma_terms_y> rdf:type owl:NamedIndividual ,
                                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                                    <https://w3id.org/tvbo/lhs> "sum_gamma_terms_y" ;
                                                                                    <https://w3id.org/tvbo/rhs> "gamma*(y/((x - 1)**2 + y**2 + d**2)**(3/2) + (y - sin(2*pi/3))/((x - cos(2*pi/3))**2 + (y - sin(2*pi/3))**2 + d**2)**(3/2) + (y - sin(4*pi/3))/((x - cos(4*pi/3))**2 + (y - sin(4*pi/3))**2 + d**2)**(3/2))" ;
                                                                                    <http://purl.org/dc/terms/description> "Sum over magnetic y-forces for N magnets on unit circle (default N=3 expanded)." ;
                                                                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                                    rdfs:label "sum_gamma_terms_y (MagneticPendulum derived variable)" ;
                                                                                    <http://www.w3.org/2004/02/skos/core#notation> "sum_gamma_terms_y" .


