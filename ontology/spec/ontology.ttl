                                                                    rdfs:label "E1 (EpileptorCodim3 derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "E1" .


###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/E2
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/E2> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "E2" ;
                                                                    <https://w3id.org/tvbo/rhs> "nu_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)" ;
                                                                    <http://purl.org/dc/terms/description> "Third component of the unit vector E parametrising the great arc." ;
                                                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                    rdfs:label "E2 (EpileptorCodim3 derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "E2" .


###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/F0
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/F0> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "F0" ;
                                                                    <https://w3id.org/tvbo/rhs> "(mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)" ;
                                                                    <http://purl.org/dc/terms/description> "First component of the unit vector F parametrising the great arc (normalised ((A x B) x A) with B = [mu2_stop, -mu1_stop, nu_stop])." ;
                                                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                    rdfs:label "F0 (EpileptorCodim3 derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "F0" .


###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/F1
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/F1> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "F1" ;
                                                                    <https://w3id.org/tvbo/rhs> "(mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)" ;
                                                                    <http://purl.org/dc/terms/description> "Second component of the unit vector F parametrising the great arc." ;
                                                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                    rdfs:label "F1 (EpileptorCodim3 derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "F1" .


###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/F2
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/F2> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "F2" ;
                                                                    <https://w3id.org/tvbo/rhs> "(-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)" ;
                                                                    <http://purl.org/dc/terms/description> "Third component of the unit vector F parametrising the great arc." ;
                                                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                    rdfs:label "F2 (EpileptorCodim3 derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "F2" .


###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/cardano_a
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/cardano_a> rdf:type owl:NamedIndividual ,
                                                                                    <https://w3id.org/tvbo/DerivedVariable> ;
                                                                           <https://w3id.org/tvbo/lhs> "cardano_a" ;
                                                                           <https://w3id.org/tvbo/rhs> "mu1/2" ;
                                                                           <http://purl.org/dc/terms/description> "Half of mu1 (the Cardano coefficient mu1/2 for the depressed cubic xs**3 - mu2*xs - mu1 = 0)." ;
                                                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                           rdfs:label "cardano_a (EpileptorCodim3 derived variable)" ;
                                                                           <http://www.w3.org/2004/02/skos/core#notation> "cardano_a" .


###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/cardano_d
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/cardano_d> rdf:type owl:NamedIndividual ,
                                                                                    <https://w3id.org/tvbo/DerivedVariable> ;
                                                                           <https://w3id.org/tvbo/lhs> "cardano_d" ;
                                                                           <https://w3id.org/tvbo/rhs> "mu1**2/4 - mu2**3/27" ;
                                                                           <http://purl.org/dc/terms/description> "Cardano discriminant mu1**2/4 - mu2**3/27 for the cubic xs**3 - mu2*xs - mu1 = 0." ;
                                                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                           rdfs:label "cardano_d (EpileptorCodim3 derived variable)" ;
                                                                           <http://www.w3.org/2004/02/skos/core#notation> "cardano_d" .


###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/mu1
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/mu1> rdf:type owl:NamedIndividual ,
                                                                              <https://w3id.org/tvbo/DerivedVariable> ;
                                                                     <https://w3id.org/tvbo/lhs> "mu1" ;
                                                                     <https://w3id.org/tvbo/rhs> "-R*(E1*cos(z) + F1*sin(z))" ;
                                                                     <http://purl.org/dc/terms/description> "Bifurcation parameter mu1 along the great arc as a function of the slow variable z." ;
                                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                     rdfs:label "mu1 (EpileptorCodim3 derived variable)" ;
                                                                     <http://www.w3.org/2004/02/skos/core#notation> "mu1" .


###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/mu2
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/mu2> rdf:type owl:NamedIndividual ,
                                                                              <https://w3id.org/tvbo/DerivedVariable> ;
                                                                     <https://w3id.org/tvbo/lhs> "mu2" ;
                                                                     <https://w3id.org/tvbo/rhs> "R*(E0*cos(z) + F0*sin(z))" ;
                                                                     <http://purl.org/dc/terms/description> "Bifurcation parameter mu2 along the great arc as a function of the slow variable z." ;
                                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                     rdfs:label "mu2 (EpileptorCodim3 derived variable)" ;
                                                                     <http://www.w3.org/2004/02/skos/core#notation> "mu2" .


###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/nu
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/nu> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "nu" ;
                                                                    <https://w3id.org/tvbo/rhs> "R*(E2*cos(z) + F2*sin(z))" ;
                                                                    <http://purl.org/dc/terms/description> "Bifurcation parameter nu along the great arc as a function of the slow variable z." ;
                                                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                    rdfs:label "nu (EpileptorCodim3 derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "nu" .


###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/xs
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/xs> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "xs" ;
                                                                    <https://w3id.org/tvbo/rhs> "Piecewise((2*(cardano_a**2 - cardano_d)**(1/6)*cos(atan2(sqrt(-cardano_d), cardano_a)/3), cardano_d < 0), (Piecewise(((cardano_a + sqrt(cardano_d))**(1/3), (cardano_a + sqrt(cardano_d)) >= 0), (Abs(cardano_a + sqrt(cardano_d))**(1/3)/2, True)) + Piecewise(((cardano_a - sqrt(cardano_d))**(1/3), (cardano_a - sqrt(cardano_d)) >= 0), (Abs(cardano_a - sqrt(cardano_d))**(1/3)/2, True)), True))" ;
                                                                    <http://purl.org/dc/terms/description> "The x-coordinate of the resting state (branch N=1), the real part of the Cardano root of xs**3 - mu2*xs - mu1 = 0, reproducing TVB's principal-branch complex cube root. For negative discriminant (three real roots) the trigonometric form is used; for non-negative discriminant the principal-branch real cube root sum is used (a real cube root for non-negative argument, half the real cube root of the magnitude for negative argument)." ;
                                                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                    rdfs:label "xs (EpileptorCodim3 derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "xs" .


