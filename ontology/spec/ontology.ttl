                                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                             rdfs:label "tau_s (DumontGutkin parameter)" ;
                                                             <http://www.w3.org/2004/02/skos/core#definition> "Synaptic time constant" ;
                                                             <http://www.w3.org/2004/02/skos/core#notation> "tau_s" .


###  https://w3id.org/tvbo/models/DumontGutkin/state_variables/V_e
<https://w3id.org/tvbo/models/DumontGutkin/state_variables/V_e> rdf:type owl:NamedIndividual ,
                                                                         <https://w3id.org/tvbo/StateVariable> ;
                                                                <https://w3id.org/tvbo/lhs> "Derivative(V_e, t)" ;
                                                                <https://w3id.org/tvbo/rhs> "(I_e + V_e**2 + eta_e - pi**2*r_e**2*tau_e**2 + s_ee*tau_e - s_ei*tau_e)/tau_e" ;
                                                                rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                rdfs:label "V_e (DumontGutkin state variable)" ;
                                                                <http://www.w3.org/2004/02/skos/core#notation> "V_e" .


###  https://w3id.org/tvbo/models/DumontGutkin/state_variables/V_i
<https://w3id.org/tvbo/models/DumontGutkin/state_variables/V_i> rdf:type owl:NamedIndividual ,
                                                                         <https://w3id.org/tvbo/StateVariable> ;
                                                                <https://w3id.org/tvbo/lhs> "Derivative(V_i, t)" ;
                                                                <https://w3id.org/tvbo/rhs> "(I_i + V_i**2 + eta_i - pi**2*r_i**2*tau_i**2 + s_ie*tau_i - s_ii*tau_i)/tau_i" ;
                                                                rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                rdfs:label "V_i (DumontGutkin state variable)" ;
                                                                <http://www.w3.org/2004/02/skos/core#notation> "V_i" .


###  https://w3id.org/tvbo/models/DumontGutkin/state_variables/r_e
<https://w3id.org/tvbo/models/DumontGutkin/state_variables/r_e> rdf:type owl:NamedIndividual ,
                                                                         <https://w3id.org/tvbo/StateVariable> ;
                                                                <https://w3id.org/tvbo/lhs> "Derivative(r_e, t)" ;
                                                                <https://w3id.org/tvbo/rhs> "(Delta_e/(pi*tau_e) + 2*V_e*r_e)/tau_e" ;
                                                                rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                rdfs:label "r_e (DumontGutkin state variable)" ;
                                                                <http://www.w3.org/2004/02/skos/core#notation> "r_e" .


###  https://w3id.org/tvbo/models/DumontGutkin/state_variables/r_i
<https://w3id.org/tvbo/models/DumontGutkin/state_variables/r_i> rdf:type owl:NamedIndividual ,
                                                                         <https://w3id.org/tvbo/StateVariable> ;
                                                                <https://w3id.org/tvbo/lhs> "Derivative(r_i, t)" ;
                                                                <https://w3id.org/tvbo/rhs> "(Delta_i/(pi*tau_i) + 2*V_i*r_i)/tau_i" ;
                                                                rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                rdfs:label "r_i (DumontGutkin state variable)" ;
                                                                <http://www.w3.org/2004/02/skos/core#notation> "r_i" .


###  https://w3id.org/tvbo/models/DumontGutkin/state_variables/s_ee
<https://w3id.org/tvbo/models/DumontGutkin/state_variables/s_ee> rdf:type owl:NamedIndividual ,
                                                                          <https://w3id.org/tvbo/StateVariable> ;
                                                                 <https://w3id.org/tvbo/lhs> "Derivative(s_ee, t)" ;
                                                                 <https://w3id.org/tvbo/rhs> "(J_ee*r_e + c_glob - s_ee)/tau_s" ;
                                                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                 rdfs:label "s_ee (DumontGutkin state variable)" ;
                                                                 <http://www.w3.org/2004/02/skos/core#notation> "s_ee" .


###  https://w3id.org/tvbo/models/DumontGutkin/state_variables/s_ei
<https://w3id.org/tvbo/models/DumontGutkin/state_variables/s_ei> rdf:type owl:NamedIndividual ,
                                                                          <https://w3id.org/tvbo/StateVariable> ;
                                                                 <https://w3id.org/tvbo/lhs> "Derivative(s_ei, t)" ;
                                                                 <https://w3id.org/tvbo/rhs> "(J_ei*r_i - s_ei)/tau_s" ;
                                                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                 rdfs:label "s_ei (DumontGutkin state variable)" ;
                                                                 <http://www.w3.org/2004/02/skos/core#notation> "s_ei" .


###  https://w3id.org/tvbo/models/DumontGutkin/state_variables/s_ie
<https://w3id.org/tvbo/models/DumontGutkin/state_variables/s_ie> rdf:type owl:NamedIndividual ,
                                                                          <https://w3id.org/tvbo/StateVariable> ;
                                                                 <https://w3id.org/tvbo/lhs> "Derivative(s_ie, t)" ;
                                                                 <https://w3id.org/tvbo/rhs> "(Gamma*c_glob + J_ie*r_e - s_ie)/tau_s" ;
                                                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                 rdfs:label "s_ie (DumontGutkin state variable)" ;
                                                                 <http://www.w3.org/2004/02/skos/core#notation> "s_ie" .


###  https://w3id.org/tvbo/models/DumontGutkin/state_variables/s_ii
<https://w3id.org/tvbo/models/DumontGutkin/state_variables/s_ii> rdf:type owl:NamedIndividual ,
                                                                          <https://w3id.org/tvbo/StateVariable> ;
                                                                 <https://w3id.org/tvbo/lhs> "Derivative(s_ii, t)" ;
                                                                 <https://w3id.org/tvbo/rhs> "(J_ii*r_i - s_ii)/tau_s" ;
                                                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                 rdfs:label "s_ii (DumontGutkin state variable)" ;
                                                                 <http://www.w3.org/2004/02/skos/core#notation> "s_ii" .


###  https://w3id.org/tvbo/models/Epileptor/derived_variables/Iext_total
<https://w3id.org/tvbo/models/Epileptor/derived_variables/Iext_total> rdf:type owl:NamedIndividual ,
                                                                               <https://w3id.org/tvbo/DerivedVariable> ;
                                                                      <https://w3id.org/tvbo/lhs> "Iext_total" ;
                                                                      <https://w3id.org/tvbo/rhs> "Iext + local_coupling*x1" ;
                                                                      <http://purl.org/dc/terms/description> "External input to the first population including local coupling input on x1." ;
                                                                      rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                      rdfs:label "Iext_total (Epileptor derived variable)" ;
                                                                      <http://www.w3.org/2004/02/skos/core#notation> "Iext_total" .


###  https://w3id.org/tvbo/models/Epileptor/derived_variables/f1
<https://w3id.org/tvbo/models/Epileptor/derived_variables/f1> rdf:type owl:NamedIndividual ,
                                                                       <https://w3id.org/tvbo/DerivedVariable> ;
                                                              <https://w3id.org/tvbo/lhs> "f1" ;
                                                              <https://w3id.org/tvbo/rhs> "Piecewise((-a*x1**2 + b*x1, x1 < 0), (slope - x2 + 0.6*(z - 4.0)**2, True))" ;
                                                              <http://purl.org/dc/terms/description> "Nonlinear function in the first state variable x1, piecewise on the sign of x1." ;
                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                              rdfs:label "f1 (Epileptor derived variable)" ;
                                                              <http://www.w3.org/2004/02/skos/core#notation> "f1" .


###  https://w3id.org/tvbo/models/Epileptor/derived_variables/f2
<https://w3id.org/tvbo/models/Epileptor/derived_variables/f2> rdf:type owl:NamedIndividual ,
                                                                       <https://w3id.org/tvbo/DerivedVariable> ;
                                                              <https://w3id.org/tvbo/lhs> "f2" ;
                                                              <https://w3id.org/tvbo/rhs> "Piecewise((0, x2 < -0.25), (aa*(x2 + 0.25), True))" ;
                                                              <http://purl.org/dc/terms/description> "Nonlinear function in the fifth state variable y2, piecewise on the value of x2." ;
                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                              rdfs:label "f2 (Epileptor derived variable)" ;
                                                              <http://www.w3.org/2004/02/skos/core#notation> "f2" .


###  https://w3id.org/tvbo/models/Epileptor/derived_variables/h
<https://w3id.org/tvbo/models/Epileptor/derived_variables/h> rdf:type owl:NamedIndividual ,
                                                                      <https://w3id.org/tvbo/DerivedVariable> ;
                                                             <https://w3id.org/tvbo/lhs> "h" ;
                                                             <https://w3id.org/tvbo/rhs> "Piecewise((x0 + 3/(1 + exp(-(x1 + 0.5)/0.1)), modification > 0), (4*(x1 - x0) + Piecewise((-0.1*z**7, z < 0), (0, True)), True))" ;
                                                             <http://purl.org/dc/terms/description> "Permittivity drive for z: sigmoidal when modification>0, else linear (Piecewise on modification)." ;
                                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                             rdfs:label "h (Epileptor derived variable)" ;
                                                             <http://www.w3.org/2004/02/skos/core#notation> "h" .


###  https://w3id.org/tvbo/models/Epileptor/derived_variables/lfp
<https://w3id.org/tvbo/models/Epileptor/derived_variables/lfp> rdf:type owl:NamedIndividual ,
