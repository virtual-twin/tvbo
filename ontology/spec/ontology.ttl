                                                              <http://www.w3.org/2004/02/skos/core#notation> "sigma" .


###  https://w3id.org/tvbo/models/LorenzBounded/state_variables/X
<https://w3id.org/tvbo/models/LorenzBounded/state_variables/X> rdf:type owl:NamedIndividual ,
                                                                        <https://w3id.org/tvbo/StateVariable> ;
                                                               <https://w3id.org/tvbo/lhs> "Derivative(X, t)" ;
                                                               <https://w3id.org/tvbo/rhs> "sigma*(Y - X)*f" ;
                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                               rdfs:label "X (LorenzBounded state variable)" ;
                                                               <http://www.w3.org/2004/02/skos/core#notation> "X" .


###  https://w3id.org/tvbo/models/LorenzBounded/state_variables/Y
<https://w3id.org/tvbo/models/LorenzBounded/state_variables/Y> rdf:type owl:NamedIndividual ,
                                                                        <https://w3id.org/tvbo/StateVariable> ;
                                                               <https://w3id.org/tvbo/lhs> "Derivative(Y, t)" ;
                                                               <https://w3id.org/tvbo/rhs> "(X*(rho - Z) - Y)*f" ;
                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                               rdfs:label "Y (LorenzBounded state variable)" ;
                                                               <http://www.w3.org/2004/02/skos/core#notation> "Y" .


###  https://w3id.org/tvbo/models/LorenzBounded/state_variables/Z
