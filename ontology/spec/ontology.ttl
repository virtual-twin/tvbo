###  https://w3id.org/tvbo/neuroml/electricalConnectionInstance
<https://w3id.org/tvbo/neuroml/electricalConnectionInstance> rdf:type owl:Class ;
                                                             rdfs:subClassOf owl:Thing ;
                                                             <http://purl.org/dc/terms/description> "To enable connections between populations through gap junctions. Populations need to be of type _populationList_ and contain _instance_ and _location_ elements."@en ;
                                                             rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                             rdfs:label "electricalConnectionInstance"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#electricalConnectionInstance> .


###  https://w3id.org/tvbo/neuroml/electricalConnectionInstanceW
<https://w3id.org/tvbo/neuroml/electricalConnectionInstanceW> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://w3id.org/tvbo/neuroml/electricalConnectionInstance> ;
                                                              <http://purl.org/dc/terms/description> "To enable connections between populations through gap junctions. Populations need to be of type _populationList_ and contain _instance_ and _location_ elements. Includes setting of _weight for the connection"@en ;
                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                              rdfs:label "electricalConnectionInstanceW"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#electricalConnectionInstanceW> ;
                                                              <https://w3id.org/tvbo/neuroml/hasParameter> "weight" .


###  https://w3id.org/tvbo/neuroml/electricalProjection
<https://w3id.org/tvbo/neuroml/electricalProjection> rdf:type owl:Class ;
                                                     rdfs:subClassOf owl:Thing ;
                                                     <http://purl.org/dc/terms/description> "A projection between _presynapticPopulation to another _postsynapticPopulation through gap junctions."@en ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                     rdfs:label "electricalProjection"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#electricalProjection> .


###  https://w3id.org/tvbo/neuroml/expCondSynapse
<https://w3id.org/tvbo/neuroml/expCondSynapse> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/tvbo/neuroml/basePynnSynapse> ;
                                               <http://purl.org/dc/terms/description> "Conductance based synapse with instantaneous rise and single exponential decay (with time constant tau_syn)"@en ;
                                               rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                               rdfs:label "expCondSynapse"@en ;
                                               <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#expCondSynapse> ;
                                               <https://w3id.org/tvbo/neuroml/exposes> "g" ;
                                               <https://w3id.org/tvbo/neuroml/hasParameter> "e_rev" .


###  https://w3id.org/tvbo/neuroml/expCurrSynapse
<https://w3id.org/tvbo/neuroml/expCurrSynapse> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/tvbo/neuroml/basePynnSynapse> ;
                                               <http://purl.org/dc/terms/description> "Current based synapse with instantaneous rise and single exponential decay (with time constant tau_syn)"@en ;
                                               rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                               rdfs:label "expCurrSynapse"@en ;
                                               <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#expCurrSynapse> .


###  https://w3id.org/tvbo/neuroml/expOneSynapse
<https://w3id.org/tvbo/neuroml/expOneSynapse> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseConductanceBasedSynapse> ;
                                              <http://purl.org/dc/terms/description> "Ohmic synapse model whose conductance rises instantaneously by (_gbase * _weight) on receiving an event, and which decays exponentially to zero with time course _tauDecay"@en ;
                                              rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                              rdfs:label "expOneSynapse"@en ;
                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#expOneSynapse> ;
                                              <https://w3id.org/tvbo/neuroml/hasParameter> "tauDecay" .


###  https://w3id.org/tvbo/neuroml/expThreeSynapse
<https://w3id.org/tvbo/neuroml/expThreeSynapse> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseConductanceBasedSynapseTwo> ;
                                                <http://purl.org/dc/terms/description> "Ohmic synapse similar to expTwoSynapse but consisting of two components that can differ in decay times and max conductances but share the same rise time."@en ;
                                                rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                rdfs:label "expThreeSynapse"@en ;
                                                <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#expThreeSynapse> ;
                                                <https://w3id.org/tvbo/neuroml/hasParameter> "tauDecay1" ,
                                                                                             "tauDecay2" ,
                                                                                             "tauRise" .


###  https://w3id.org/tvbo/neuroml/expTwoSynapse
<https://w3id.org/tvbo/neuroml/expTwoSynapse> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseConductanceBasedSynapse> ;
                                              <http://purl.org/dc/terms/description> "Ohmic synapse model whose conductance waveform on receiving an event has a rise time of _tauRise and a decay time of _tauDecay. Max conductance reached during this time (assuming zero conductance before) is _gbase * _weight."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                              rdfs:label "expTwoSynapse"@en ;
                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#expTwoSynapse> ;
                                              <https://w3id.org/tvbo/neuroml/hasParameter> "tauDecay" ,
                                                                                           "tauRise" .


