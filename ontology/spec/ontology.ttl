                                                                              <https://w3id.org/tvbo/models/JansenRit/parameters/v0> ;
                                         <https://w3id.org/tvbo/hasStateVariable> <https://w3id.org/tvbo/models/JansenRit/state_variables/y0> ,
                                                                                  <https://w3id.org/tvbo/models/JansenRit/state_variables/y1> ,
                                                                                  <https://w3id.org/tvbo/models/JansenRit/state_variables/y2> ,
