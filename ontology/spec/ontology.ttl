                                     rdfs:label "trim_margins (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Trim surrounding whitespace from the saved figure (default true). Trimming re-crops to the drawn content, so the saved aspect can differ from width/height; set false to preserve the declared width×height proportions exactly, e.g. to match an original figure. Renders as bbox_inches='tight' on a matplotlib backend." ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "trim_margins" .


