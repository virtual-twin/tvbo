###  https://w3id.org/tvbo/models/DoublePendulum/state_variables/omega1
<https://w3id.org/tvbo/models/DoublePendulum/state_variables/omega1> rdf:type owl:NamedIndividual ,
                                                                              <https://w3id.org/tvbo/StateVariable> ;
                                                                     <https://w3id.org/tvbo/lhs> "Derivative(omega1, t)" ;
                                                                     <https://w3id.org/tvbo/rhs> "(M2*(cos(phi)*(L1*omega1**2*sin(phi) + G*sin(theta2)) + L2*omega2**2*sin(phi)) - (M1 + M2)*G*sin(theta1))/(L1*Delta)" ;
                                                                     <http://purl.org/dc/terms/description> "Angular velocity of first pendulum (ω₁)." ;
                                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                     rdfs:label "omega1 (DoublePendulum state variable)" ;
                                                                     <http://www.w3.org/2004/02/skos/core#notation> "omega1" .


###  https://w3id.org/tvbo/models/DoublePendulum/state_variables/omega2
<https://w3id.org/tvbo/models/DoublePendulum/state_variables/omega2> rdf:type owl:NamedIndividual ,
                                                                              <https://w3id.org/tvbo/StateVariable> ;
                                                                     <https://w3id.org/tvbo/lhs> "Derivative(omega2, t)" ;
                                                                     <https://w3id.org/tvbo/rhs> "(-(M2*L2*omega2**2*sin(phi)*cos(phi)) + (M1 + M2)*(G*(sin(theta1)*cos(phi) - sin(theta2)) - L1*omega1**2*sin(phi)))/(L2*Delta)" ;
                                                                     <http://purl.org/dc/terms/description> "Angular velocity of second pendulum (ω₂)." ;
                                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                     rdfs:label "omega2 (DoublePendulum state variable)" ;
                                                                     <http://www.w3.org/2004/02/skos/core#notation> "omega2" .


###  https://w3id.org/tvbo/models/DoublePendulum/state_variables/theta1
<https://w3id.org/tvbo/models/DoublePendulum/state_variables/theta1> rdf:type owl:NamedIndividual ,
                                                                              <https://w3id.org/tvbo/StateVariable> ;
                                                                     <https://w3id.org/tvbo/lhs> "Derivative(theta1, t)" ;
                                                                     <https://w3id.org/tvbo/rhs> "omega1" ;
                                                                     <http://purl.org/dc/terms/description> "Angle of first pendulum (θ₁)." ;
