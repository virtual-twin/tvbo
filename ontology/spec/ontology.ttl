                                               rdfs:label "allow_self_connections (slot)" ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "For a self-projection (source and target are the same population) expanded under a connectivity rule, whether to include the diagonal i->i self connections. Ignored when the source and target populations differ." ;
                                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                               <http://www.w3.org/2004/02/skos/core#notation> "allow_self_connections" .


<https://w3id.org/tvbo/analysis> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "analysis (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "analysis" .


<https://w3id.org/tvbo/applied> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "applied (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Whether the nodes listed beside this record are the selected ones. Set by tvbo when it applies the selection, so a resolved network that is saved, frozen into a kit or dumped keeps the selection as the record of how it was derived. Read back beside arrays that are already the selected ones (a save, a kit) it selects nothing again; beside a source that still delivers the dropped nodes (a dumped record naming the unselected companion, a curated network or an atlas) it is applied again by label, and the nodes it keeps have to be the ones the record lists, or the record is refused as written from a source that has changed since. A generated graph is generated at the record's count, which is the kept one, so a dumped selection of one is refused; ``save`` writes its arrays. A recipe leaves it unset; one that sets it beside a node list the selection would still cut is refused." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "applied" .


<https://w3id.org/tvbo/apply_every> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "apply_every (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Apply update every N iterations" ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "apply_every" .


<https://w3id.org/tvbo/apply_on_dimension> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                           rdfs:label "apply_on_dimension (slot)" ;
                                           <http://www.w3.org/2004/02/skos/core#notation> "apply_on_dimension" .


<https://w3id.org/tvbo/args> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "args (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Ordered parameter names passed to the callable." ;
                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                             <http://www.w3.org/2004/02/skos/core#notation> "args" .


<https://w3id.org/tvbo/atlas> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "atlas (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#notation> "atlas" .


<https://w3id.org/tvbo/authors> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "authors (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Author display strings (full detail in references.bib)." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "authors" .


<https://w3id.org/tvbo/auto_format> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "auto_format (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Whether this figure's axes follow a theme's axis rule. `false` leaves every axis exactly as its panels drew it, whatever the study's theme says: no tick re-placed, no limit moved, no spine detached or trimmed, no labels aligned. `true` draws it by the curated `tvbo:themes/bsplot` rule wherever neither its own theme nor its study's states one. Unset follows the theme." ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "auto_format" .


<https://w3id.org/tvbo/autonomous> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "autonomous (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Whether the system is autonomous (equations do not depend explicitly on time t). Non-autonomous systems have explicit time dependence, e.g. f*cos(omega*t)." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "autonomous" .


<https://w3id.org/tvbo/average> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "average (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Averaging mode across trials. 'trials' = average over n_trials independent runs (evoked potential paradigm). None = return all trials." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "average" .


<https://w3id.org/tvbo/axis> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "axis (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#notation> "axis" .


<https://w3id.org/tvbo/backend> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "backend (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Execution backend this experiment runs on when no backend is passed explicitly (e.g. 'tvboptim', 'tvb', 'jax', 'julia', 'brian2'). Declares the engine the experiment requires — a spiking point-neuron network sets 'brian2', a mean-field model leaves it unset. run(format=...) and ``tvbo run --backend`` override it; when unset the default backend (tvboptim) is used." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "backend" .


<https://w3id.org/tvbo/backends> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "backends (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Codegen backends this recipe is registered for; others recompute." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "backends" .


<https://w3id.org/tvbo/background> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "background (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "The page the figure is printed on." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "background" .


<https://w3id.org/tvbo/base> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "base (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Standard lines, bars and markers, wherever the colour carries no meaning. Leads the cycler." ;
                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                             <http://www.w3.org/2004/02/skos/core#notation> "base" .


<https://w3id.org/tvbo/batch_size> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "batch_size (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Batch size for vectorized operations (None = auto)" ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "batch_size" .


<https://w3id.org/tvbo/between> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "between (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Text written in the gap BEFORE each cell, which is what turns a row of maps into a paper's decomposition equation." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "between" .


<https://w3id.org/tvbo/bids_dir> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "bids_dir (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Path to BEP017-compliant BIDS directory for loading connectivity matrices" ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "bids_dir" .


<https://w3id.org/tvbo/block_size> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "block_size (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "block_size" .


<https://w3id.org/tvbo/bothside> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "bothside (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "bothside" .


<https://w3id.org/tvbo/bounds> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "bounds (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#notation> "bounds" .


<https://w3id.org/tvbo/callable> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "callable (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "callable" .


<https://w3id.org/tvbo/category> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "category (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Coarse classification of the phenotype bundle, used for filtering in larger study libraries. Canonical values: ``cognitive`` (intelligence / memory / attention scores), ``clinical`` (UPDRS, MMSE, …), ``behavioral`` (raw task outputs), ``demographic``, ``physiological``, ``derived`` (composite scores like g-factor or brain-age). Free string — extend as needed." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "category" .


<https://w3id.org/tvbo/citekey> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "citekey (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "BibTeX citation key; the join key into references.bib for full bibliographic detail. A study is identified by its key/citekey and described by its title — no ``name`` needed." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "citekey" .


<https://w3id.org/tvbo/code_modules> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "code_modules (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Importable module names whose import registers this figure's custom panels / transforms (via bsplot.register_panel / register_transform). The emitted plot.py imports them, so a study ships its bespoke figure code in its code_source instead of in core tvbo. The modules must be importable when the figure renders (loading the study puts its code/ dir on the path)." ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "code_modules" .


<https://w3id.org/tvbo/cohort> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "cohort (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#notation> "cohort" .


<https://w3id.org/tvbo/col_labels> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "col_labels (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "One heading per column, written just above the cells rather than at the panel's own top, so it keeps reading as belonging to its column." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "col_labels" .


<https://w3id.org/tvbo/color> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "color (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#notation> "color" .


<https://w3id.org/tvbo/colorbar_ends> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "colorbar_ends (slot)" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Put a colour bar's ticks at the two ends of its range and at its centre (at zero where the range crosses it), each written in full, instead of on the round values inside it. A bar whose panel declares `colorbar_ticks` keeps those." ;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                      <http://www.w3.org/2004/02/skos/core#notation> "colorbar_ends" .


<https://w3id.org/tvbo/colorbar_outline> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                         rdfs:label "colorbar_outline (slot)" ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "Draw the frame around a colour bar." ;
                                         <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                         <http://www.w3.org/2004/02/skos/core#notation> "colorbar_outline" .


<https://w3id.org/tvbo/colormap> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "colormap (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "colormap" .


<https://w3id.org/tvbo/colors> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "colors (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#definition> "One colour per entry of a standalone legend, as a palette role, a hue or any colour the backend reads." ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                               <http://www.w3.org/2004/02/skos/core#notation> "colors" .


<https://w3id.org/tvbo/columns> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "columns (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "How many columns the entries are laid out in. A wide panel with six short labels reads better as one row than as a six-deep column over the data." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "columns" .


<https://w3id.org/tvbo/command> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "command (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "The command performed, parameters included. Null for something done by hand, which BEP028 reads as a manual step and asks a ``description`` for." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "command" .


<https://w3id.org/tvbo/comment> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "comment (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Free-text provenance tag on each submitted job (Slurm ``--comment``), visible in ``squeue -o %k``. Unset means an auto-generated ``tvbo:<study>/exp_<experiment>`` tag so a queued job maps back to its experiment; set it to override with a custom string." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "comment" .


<https://w3id.org/tvbo/compile> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "compile (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Code-generation hint (opt-in, backend-independent): request that the generated dynamics be compiled to machine code rather than interpreted, where the target backend supports it. Purely a performance hint with no effect on results; a backend that is inherently compiled (or cannot compile) honours it as a no-op. Off by default. Independent of, and composable with, ``cse``." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "compile" .


<https://w3id.org/tvbo/concept_iri> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "concept_iri (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Cognitive Atlas IRI of the cognitive construct measured (e.g. ``cogat:trm_521ef89ce5e84`` for fluid intelligence)." ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "concept_iri" .


<https://w3id.org/tvbo/condition> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "condition (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "condition" .


<https://w3id.org/tvbo/condition_parameters> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                             rdfs:label "condition_parameters (slot)" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Parameter symbols accessible in the condition function." ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                             <http://www.w3.org/2004/02/skos/core#notation> "condition_parameters" .


<https://w3id.org/tvbo/condition_states> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                         rdfs:label "condition_states (slot)" ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "State variable symbols accessible in the condition function. For edges, can include source/destination vertex outputs." ;
                                         <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                         <http://www.w3.org/2004/02/skos/core#notation> "condition_states" .


<https://w3id.org/tvbo/connectivity_ref> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                         rdfs:label "connectivity_ref (slot)" ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "Reference to connectivity data (_conndata-network_connectivity.tsv)." ;
                                         <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                         <http://www.w3.org/2004/02/skos/core#notation> "connectivity_ref" .


<https://w3id.org/tvbo/connectome> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "connectome (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "connectome" .


<https://w3id.org/tvbo/container> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "container (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "container" .


<https://w3id.org/tvbo/container_args> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                       rdfs:label "container_args (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Additional arguments passed verbatim to the container runtime when it executes a task. The extension point for runtime flags the typed fields do not cover, mirroring ``WorkflowEngineConfig.options`` for scheduler directives." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "container_args" .


<https://w3id.org/tvbo/container_binds> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                        rdfs:label "container_binds (slot)" ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "Host paths that must be visible inside the container beyond the ones its runtime binds by default (typically ``$HOME`` and the working directory). Required whenever a task reads or writes a site filesystem outside those defaults — a shared cache, a data tree, or a scratch area a symlink resolves into. Rendered into each runtime's own flag (``--bind`` for Apptainer/Singularity)." ;
                                        <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                        <http://www.w3.org/2004/02/skos/core#notation> "container_binds" .


<https://w3id.org/tvbo/correlated> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "correlated (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Deprecated. Whether the noise is correlated, without saying across which axis or by how much. Use `covariance` + `correlated_over`." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "correlated" .


<https://w3id.org/tvbo/correlation> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "correlation (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "correlation" .


<https://w3id.org/tvbo/count> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "count (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#definition> "A structural tally computed from the specification, not a run: ``<study>.<collection>`` counts a collection on a nested study named by its citekey or label (e.g. ``Jansen1995.figures``), resolved at any depth, or a bare ``<collection>`` counts one on the study holding the binding (e.g. ``studies``). Mutually exclusive with ``used`` and ``value``." ;
                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                              <http://www.w3.org/2004/02/skos/core#notation> "count" .


<https://w3id.org/tvbo/coupling_variable> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                          rdfs:label "coupling_variable (slot)" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "Whether this state variable is transmitted to connected nodes through the coupling function. In TVB terms, this determines the cvar indices (state variables extracted from history and fed into the coupling function). The coupling function may override this via its incoming_states attribute." ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                          <http://www.w3.org/2004/02/skos/core#notation> "coupling_variable" .


<https://w3id.org/tvbo/criterion> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "criterion (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Name of the in-loop quantity to rank iterations by, one of the algorithm's `observations` or `functions` (e.g. an in-loop `fc_rmse` of the windowed FC against the target); its per-iteration mean is ranked, so a per-node value is averaged over nodes. It is measured on the parameters in effect during that iteration, so the kept snapshot is the one that produced it." ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "criterion" .


<https://w3id.org/tvbo/cse> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                            rdfs:label "cse (slot)" ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Code-generation hint (opt-in, backend-independent): eliminate common subexpressions. When true, the generator evaluates each repeated subexpression — including repeated calls to model-defined functions — once and reuses the result instead of re-emitting it at every occurrence. Purely a performance hint: results are numerically identical. A backend whose compiler already performs this elimination may honour it as a no-op. Off by default (expressions are emitted in flat form)." ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                            <http://www.w3.org/2004/02/skos/core#notation> "cse" .


<https://w3id.org/tvbo/curvature> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "curvature (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Optional path to per-vertex curvature (N,) float. Default convention: ``mesh/curvature``." ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "curvature" .


<https://w3id.org/tvbo/dash> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "dash (slot)" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Dash pattern (`solid`, `dashed`, `dotted`, `dashdot`). A reference line is conventionally dashed, so it is not read as data." ;
                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                             <http://www.w3.org/2004/02/skos/core#notation> "dash" .


<https://w3id.org/tvbo/dataLocation> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "dataLocation (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "dataLocation" .


<https://w3id.org/tvbo/data_file> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "data_file (slot)" ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "data_file" .


<https://w3id.org/tvbo/data_source> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                    rdfs:label "data_source (slot)" ;
                                    <http://www.w3.org/2004/02/skos/core#notation> "data_source" .


<https://w3id.org/tvbo/dataset_id> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "dataset_id (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Unique identifier for this phenotype bundle." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "dataset_id" .


<https://w3id.org/tvbo/datatype> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "datatype (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Declared value type of this parameter, given as a schema range name — a primitive (``integer``, ``float``, ``string``, ``uriorcurie``) or a class (e.g. ``Distribution``). Documents the expected type when the parameter is a *declaration* carrying no concrete ``value`` (e.g. a GraphGenerator's typed argument interface). Distinct from ``domain`` (numeric bounds) and ``unit``." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "datatype" .


<https://w3id.org/tvbo/date_created> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "date_created (slot)" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "ISO 8601 (prov:generatedAtTime)" ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "date_created" .


<https://w3id.org/tvbo/decimals> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                 rdfs:label "decimals (slot)" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "How many decimal places the tick numbers are written to." ;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                                 <http://www.w3.org/2004/02/skos/core#notation> "decimals" .


