###  https://w3id.org/tvbo/SweepDirection#bidirectional
<https://w3id.org/tvbo/SweepDirection#bidirectional> rdf:type owl:Class ;
                                                     rdfs:subClassOf <https://w3id.org/tvbo/SweepDirection> ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                     rdfs:label "bidirectional (SweepDirection)" ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "Increase then decrease over the same values, recording both branches. Where the two branches differ, the sweep traces a hysteresis loop that exposes coexisting stable states (bistability / multistability). The multivalued generalisation of Continuation.bothside." ;
                                                     <http://www.w3.org/2004/02/skos/core#notation> "bidirectional" .


###  https://w3id.org/tvbo/SweepDirection#down
<https://w3id.org/tvbo/SweepDirection#down> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/tvbo/SweepDirection> ;
                                            rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                            rdfs:label "down (SweepDirection)" ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Decrease the parameter monotonically (high to low), once." ;
                                            <http://www.w3.org/2004/02/skos/core#notation> "down" .


###  https://w3id.org/tvbo/SweepDirection#up
<https://w3id.org/tvbo/SweepDirection#up> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/tvbo/SweepDirection> ;
                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                          rdfs:label "up (SweepDirection)" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "Increase the parameter monotonically (low to high), once." ;
                                          <http://www.w3.org/2004/02/skos/core#notation> "up" .


###  https://w3id.org/tvbo/SweepSeeding#from_previous
<https://w3id.org/tvbo/SweepSeeding#from_previous> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://w3id.org/tvbo/SweepSeeding> ;
                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                   rdfs:label "from_previous (SweepSeeding)" ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "Each point is seeded from the final state of the preceding point, so the trajectory follows the solution branch as the swept parameter changes quasi-statically. Forces sequential, order-dependent execution (emitted as a scan, not a vmap). Used to reach a working point by slowly ramping a parameter (e.g. global coupling) and, with sweep_direction, to expose hysteresis / multistability. The sweep-granularity form of InitialStateMethod.from_working_point, which ramps a parameter to one working point." ;
                                                   <http://www.w3.org/2004/02/skos/core#notation> "from_previous" .


###  https://w3id.org/tvbo/SweepSeeding#independent
<https://w3id.org/tvbo/SweepSeeding#independent> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/tvbo/SweepSeeding> ;
                                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                 rdfs:label "independent (SweepSeeding)" ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "Points are order-independent and may be evaluated in parallel (see parallel_mode). Default. Independent of each OTHER, which is not the same as each cold-starting: where the experiment declares a transient, the settle is integrated once and every point opens from the state it reached, so what is shared between points is a settled state rather than a running trajectory. That is sound while the swept parameter does not change the approach, and unsound wherever the sweep crosses a bifurcation, since a point then inherits an attractor it would not have reached on its own. The emitter integrates one settle, not one per point, so the name promises independence between points, not a cold start at each." ;
                                                 <http://www.w3.org/2004/02/skos/core#notation> "independent" .


###  https://w3id.org/tvbo/SystemType#continuous
<https://w3id.org/tvbo/SystemType#continuous> rdf:type owl:Class ;
