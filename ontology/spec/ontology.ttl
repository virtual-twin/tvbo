                                                                        rdfs:label "x2 (EpileptorRestingState state variable)" ;
                                                                        <http://www.w3.org/2004/02/skos/core#notation> "x2" .


###  https://w3id.org/tvbo/models/EpileptorRestingState/state_variables/x_rs
<https://w3id.org/tvbo/models/EpileptorRestingState/state_variables/x_rs> rdf:type owl:NamedIndividual ,
                                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                                          <https://w3id.org/tvbo/lhs> "Derivative(x_rs, t)" ;
                                                                          <https://w3id.org/tvbo/rhs> "d_rs*tau_rs*(I_rs*gamma_rs + K_rs*c_glob2*gamma_rs + alpha_rs*y_rs + e_rs*x_rs**2 - f_rs*x_rs**3 + lc_1)" ;
                                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                          rdfs:label "x_rs (EpileptorRestingState state variable)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "x_rs" .


###  https://w3id.org/tvbo/models/EpileptorRestingState/state_variables/y1
<https://w3id.org/tvbo/models/EpileptorRestingState/state_variables/y1> rdf:type owl:NamedIndividual ,
                                                                                 <https://w3id.org/tvbo/StateVariable> ;
                                                                        <https://w3id.org/tvbo/lhs> "Derivative(y1, t)" ;
                                                                        <https://w3id.org/tvbo/rhs> "tt*(c - d*x1**2 - y1)" ;
                                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                        rdfs:label "y1 (EpileptorRestingState state variable)" ;
                                                                        <http://www.w3.org/2004/02/skos/core#notation> "y1" .


###  https://w3id.org/tvbo/models/EpileptorRestingState/state_variables/y2
<https://w3id.org/tvbo/models/EpileptorRestingState/state_variables/y2> rdf:type owl:NamedIndividual ,
                                                                                 <https://w3id.org/tvbo/StateVariable> ;
                                                                        <https://w3id.org/tvbo/lhs> "Derivative(y2, t)" ;
                                                                        <https://w3id.org/tvbo/rhs> "tt*(-y2 + y2cond)/tau" ;
                                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                        rdfs:label "y2 (EpileptorRestingState state variable)" ;
                                                                        <http://www.w3.org/2004/02/skos/core#notation> "y2" .


###  https://w3id.org/tvbo/models/EpileptorRestingState/state_variables/y_rs
<https://w3id.org/tvbo/models/EpileptorRestingState/state_variables/y_rs> rdf:type owl:NamedIndividual ,
                                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                                          <https://w3id.org/tvbo/lhs> "Derivative(y_rs, t)" ;
                                                                          <https://w3id.org/tvbo/rhs> "d_rs*(a_rs + b_rs*x_rs - beta_rs*y_rs)/tau_rs" ;
                                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                          rdfs:label "y_rs (EpileptorRestingState state variable)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "y_rs" .


###  https://w3id.org/tvbo/models/EpileptorRestingState/state_variables/z
