<https://w3id.org/tvbo/models/StandardMap/parameters/k> rdf:type owl:NamedIndividual ,
                                                                 <https://w3id.org/tvbo/Parameter> ;
                                                        <http://purl.org/dc/terms/description> "Nonlinearity parameter controlling torus breakup." ;
                                                        <http://schema.org/defaultValue> "0.971635"^^xsd:double ;
                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                        rdfs:label "k (StandardMap parameter)" ;
                                                        <http://www.w3.org/2004/02/skos/core#notation> "k" .


###  https://w3id.org/tvbo/models/StandardMap/state_variables/p
<https://w3id.org/tvbo/models/StandardMap/state_variables/p> rdf:type owl:NamedIndividual ,
                                                                      <https://w3id.org/tvbo/StateVariable> ;
                                                             <https://w3id.org/tvbo/lhs> "p_next" ;
