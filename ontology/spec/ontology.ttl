                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(y, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "-mu*y + x*(z - alpha)" ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "y (Rikitake state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "y" .


###  https://w3id.org/tvbo/models/Rikitake/state_variables/z
<https://w3id.org/tvbo/models/Rikitake/state_variables/z> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(z, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "1 - x*y" ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "z (Rikitake state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "z" .


