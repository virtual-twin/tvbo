                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <http://www.w3.org/2004/02/skos/core#notation> "homologue" .


<https://w3id.org/tvbo/how_to_acknowledge> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
