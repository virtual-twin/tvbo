###  https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/C_ee
<https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/C_ee> rdf:type owl:NamedIndividual ,
                                                                                          <https://w3id.org/tvbo/StateVariable> ;
                                                                                 <https://w3id.org/tvbo/lhs> "Derivative(C_ee, t)" ;
                                                                                 <https://w3id.org/tvbo/rhs> "(TFe*(1.0/T - TFe)/(N_tot*(1.0 - g)) + (TFe - E)**2 + 2.0*C_ee*dfe_TFe + 2.0*C_ei*dfi_TFe - 2.0*C_ee)/T" ;
                                                                                 <http://purl.org/dc/terms/description> "Variance of the excitatory population activity." ;
                                                                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                                 rdfs:label "C_ee (ZerlautAdaptationSecondOrder state variable)" ;
                                                                                 <http://www.w3.org/2004/02/skos/core#notation> "C_ee" .


###  https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/C_ei
<https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/C_ei> rdf:type owl:NamedIndividual ,
                                                                                          <https://w3id.org/tvbo/StateVariable> ;
                                                                                 <https://w3id.org/tvbo/lhs> "Derivative(C_ei, t)" ;
                                                                                 <https://w3id.org/tvbo/rhs> "((TFe - E)*(TFi - I) + C_ee*dfe_TFe + C_ei*dfe_TFi + C_ei*dfi_TFe + C_ii*dfi_TFi - 2.0*C_ei)/T" ;
                                                                                 <http://purl.org/dc/terms/description> "Covariance between the excitatory and inhibitory population activities." ;
                                                                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                                 rdfs:label "C_ei (ZerlautAdaptationSecondOrder state variable)" ;
                                                                                 <http://www.w3.org/2004/02/skos/core#notation> "C_ei" .


###  https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/C_ii
<https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/C_ii> rdf:type owl:NamedIndividual ,
                                                                                          <https://w3id.org/tvbo/StateVariable> ;
                                                                                 <https://w3id.org/tvbo/lhs> "Derivative(C_ii, t)" ;
                                                                                 <https://w3id.org/tvbo/rhs> "(TFi*(1.0/T - TFi)/(N_tot*g) + (TFi - I)**2 + 2.0*C_ii*dfi_TFi + 2.0*C_ei*dfe_TFi - 2.0*C_ii)/T" ;
                                                                                 <http://purl.org/dc/terms/description> "Variance of the inhibitory population activity." ;
                                                                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                                 rdfs:label "C_ii (ZerlautAdaptationSecondOrder state variable)" ;
                                                                                 <http://www.w3.org/2004/02/skos/core#notation> "C_ii" .


###  https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/E
<https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/E> rdf:type owl:NamedIndividual ,
                                                                                       <https://w3id.org/tvbo/StateVariable> ;
                                                                              <https://w3id.org/tvbo/lhs> "Derivative(E, t)" ;
                                                                              <https://w3id.org/tvbo/rhs> "(TFe - E + 0.5*C_ee*d2_fefe_e + 0.5*C_ei*d2_fefi_e + 0.5*C_ei*d2_fife_e + 0.5*C_ii*d2_fifi_e)/T" ;
                                                                              <http://purl.org/dc/terms/description> "Firing rate of the excitatory population [kHz]." ;
                                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                              rdfs:label "E (ZerlautAdaptationSecondOrder state variable)" ;
                                                                              <http://www.w3.org/2004/02/skos/core#notation> "E" .


###  https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/I
<https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/I> rdf:type owl:NamedIndividual ,
                                                                                       <https://w3id.org/tvbo/StateVariable> ;
                                                                              <https://w3id.org/tvbo/lhs> "Derivative(I, t)" ;
                                                                              <https://w3id.org/tvbo/rhs> "(TFi - I + 0.5*C_ee*d2_fefe_i + 0.5*C_ei*d2_fefi_i + 0.5*C_ei*d2_fife_i + 0.5*C_ii*d2_fifi_i)/T" ;
                                                                              <http://purl.org/dc/terms/description> "Firing rate of the inhibitory population [kHz]." ;
                                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                              rdfs:label "I (ZerlautAdaptationSecondOrder state variable)" ;
                                                                              <http://www.w3.org/2004/02/skos/core#notation> "I" .


