###  https://w3id.org/tvbo/software/vbi
<https://w3id.org/tvbo/software/vbi> rdf:type owl:NamedIndividual ,
                                              <https://w3id.org/tvbo/sw/SimulationTool> ;
                                     <http://purl.org/dc/terms/description> "Virtual Brain Inference. Probabilistic inference toolkit for whole-brain models — multi-backend simulators (Numba, C++, CuPy, JAX, PyTorch, TVB kernels), a 40+ time-series feature library (statistical, spectral, FC/FCD, complexity, event-detection), and two parallel inference paths (SBI via sbi-toolkit SNPE/SNLE/SNRE with MAF/NSF, and a built-in autograd-based CDE with MDN/MAF estimators). Targets the inverse problem of mapping observed neuroimaging (EEG/MEG/fMRI) onto brain-model parameters." ;
                                     <http://purl.org/dc/terms/license> "MIT" ;
                                     <http://schema.org/codeRepository> "https://github.com/ins-amu/vbi" ;
                                     <http://schema.org/identifier> "10.5281/zenodo.14795543" ;
                                     <http://schema.org/url> "https://vbi.readthedocs.io" ;
                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "vbi" .


###  https://w3id.org/tvbo/software/vbjax
<https://w3id.org/tvbo/software/vbjax> rdf:type owl:NamedIndividual ,
                                                <https://w3id.org/tvbo/sw/SimulationTool> ;
                                       <http://purl.org/dc/terms/description> "JAX-based virtual brain library. Provides stochastic Heun integrators for ODE/SDE/DDE/SDDE, canonical neural-mass models (Jansen-Rit, Montbrio-Pazo-Roxin, BVEP, bilinear DCM, Dopa), BOLD/EEG monitors, delay-coupling helpers, a spherical-harmonic neural-field operator, and JAX-native parameter sweeps with gradient-based fitting and MCMC." ;
                                       <http://purl.org/dc/terms/license> "Apache-2.0" ;
                                       <http://schema.org/codeRepository> "https://github.com/ins-amu/vbjax" ;
                                       <http://schema.org/identifier> "10.5281/zenodo.14204250" ;
