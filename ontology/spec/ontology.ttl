###  https://w3id.org/tvbo/models/KIonEx/derived_variables/Vcond
<https://w3id.org/tvbo/models/KIonEx/derived_variables/Vcond> rdf:type owl:NamedIndividual ,
                                                                       <https://w3id.org/tvbo/DerivedVariable> ;
                                                              <https://w3id.org/tvbo/lhs> "Vcond" ;
                                                              <https://w3id.org/tvbo/rhs> "Piecewise((R_minus*c_glob*(-V + E)/pi - R_minus*x**2 + V_temp + eta, V <= Vstar), (R_minus*c_glob*(-V + E)/pi - R_plus*x**2 + V_temp + eta, True))" ;
                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                              rdfs:label "Vcond (KIonEx derived variable)" ;
                                                              <http://www.w3.org/2004/02/skos/core#notation> "Vcond" .


