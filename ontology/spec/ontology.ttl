<https://w3id.org/tvbo/models/Roessler/parameters/c> rdf:type owl:NamedIndividual ,
                                                              <https://w3id.org/tvbo/Parameter> ;
                                                     <http://purl.org/dc/terms/description> "Z-scaling parameter setting folding scale." ;
                                                     <http://schema.org/defaultValue> "5.7"^^xsd:double ;
