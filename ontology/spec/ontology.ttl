                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                          rdfs:label "truncation_window (slot)" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "Truncated-BPTT window in milliseconds of simulated time: gradients flow back at most this far. Omit for full BPTT." ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                          <http://www.w3.org/2004/02/skos/core#notation> "truncation_window" .


###  https://w3id.org/tvbo/tvbo_class
<https://w3id.org/tvbo/tvbo_class> rdf:type owl:DatatypeProperty ;
                                   rdfs:range [ rdf:type rdfs:Datatype ;
                                                owl:intersectionOf ( xsd:string
                                                                     [ rdf:type rdfs:Datatype ;
                                                                       owl:onDatatype xsd:string ;
                                                                       owl:withRestrictions ( [ xsd:pattern "^tvbo:[A-Z][A-Za-z0-9]*$"
                                                                                              ]
                                                                                            )
                                                                     ]
                                                                   )
                                              ] ;
                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                   rdfs:label "tvbo_class (slot)" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "The class a file holds, as a CURIE (``tvbo:Network``) — the envelope `Document` declares." ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/common> ;
                                   <http://www.w3.org/2004/02/skos/core#notation> "tvbo_class" .


