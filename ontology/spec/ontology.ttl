###  https://w3id.org/tvbo/NeimarkSacker
<https://w3id.org/tvbo/NeimarkSacker> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/tvbo/Bifurcation> ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <https://w3id.org/tvbo/hasCodimension> ;
                                                        owl:hasValue <https://w3id.org/tvbo/Codimension1>
                                                      ] ;
                                      rdfs:comment "Torus (Neimark-Sacker) bifurcation of a limit cycle: a complex pair of Floquet multipliers crosses the unit circle, birthing an invariant torus."@en ;
                                      rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                      rdfs:label "Neimark-Sacker"@en ;
                                      <http://www.w3.org/2004/02/skos/core#altLabel> "TR" ,
                                                                                     "neimark sacker" ,
                                                                                     "neimark-sacker" ,
                                                                                     "ns" ,
                                                                                     "torus" ,
                                                                                     "tr" ;
                                      <https://w3id.org/tvbo/canonicalCode> "TR" .


