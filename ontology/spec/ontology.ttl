                                                               owl:onProperty <https://w3id.org/tvbo/partition> ;
                                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/queue> ;
                                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/setup> ;
                                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/venv> ;
                                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/account> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/array_chunk> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/comment> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/cores> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/cpus_per_task> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/executor> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/gres> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/mail_type> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/mail_user> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/mem> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/partition> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/queue> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/venv> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ;
                                             rdfs:isDefinedBy <https://w3id.org/tvbo/struct> ;
                                             rdfs:label "WorkflowEngineConfig" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Execution directives for a workflow engine. Every field is optional and each engine's emitter consumes the subset it supports, so one block may carry directives for more than one target. The generic resource fields (cpus_per_task, mem, time) map across engines; the remaining fields are named for the engine that reads them (Slurm: partition/account/gres/ mail_*/array_chunk; Snakemake: cores; Nextflow: executor/queue). Any directive not named here is passed through ``options`` verbatim, so the block stays extensible without a schema change." ;
                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/tvbo/WorkflowEngineConfig> ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> .


###  https://w3id.org/tvbo/ZeroHopf
<https://w3id.org/tvbo/ZeroHopf> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/tvbo/Bifurcation> ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://w3id.org/tvbo/hasCodimension> ;
                                                   owl:hasValue <https://w3id.org/tvbo/Codimension2>
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://w3id.org/tvbo/hasEigenvalueSignature> ;
                                                   owl:hasValue <https://w3id.org/tvbo/RealZeroAndImaginaryPair>
                                                 ] ;
                                 rdfs:comment "Codim-2 point with a real zero eigenvalue and an imaginary pair simultaneously; a fold curve meets a Hopf curve."@en ;
                                 rdfs:label "Zero-Hopf (fold-Hopf)"@en ;
                                 <http://www.w3.org/2004/02/skos/core#altLabel> "ZH" ,
                                                                                "fold-hopf" ,
                                                                                "gavrilov-guckenheimer" ,
                                                                                "zero-hopf" ,
                                                                                "zh" ;
                                 <https://w3id.org/tvbo/canonicalCode> "ZH" .


