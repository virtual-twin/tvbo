                                                                    <https://w3id.org/tvbo/StateVariable> ;
                                                           <https://w3id.org/tvbo/lhs> "Derivative(D, t)" ;
                                                           <https://w3id.org/tvbo/rhs> "-nu*D + V*Q" ;
