                                                                       rdfs:label "omega (StuartLandauOscillator parameter)" ;
                                                                       <http://www.w3.org/2004/02/skos/core#notation> "omega" .


###  https://w3id.org/tvbo/models/StuartLandauOscillator/state_variables/x
<https://w3id.org/tvbo/models/StuartLandauOscillator/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                                 <https://w3id.org/tvbo/StateVariable> ;
                                                                        <https://w3id.org/tvbo/lhs> "Derivative(x, t)" ;
                                                                        <https://w3id.org/tvbo/rhs> "x*(mu - x**2 - y**2) - omega*y - b*(x**2 + y**2)*y" ;
