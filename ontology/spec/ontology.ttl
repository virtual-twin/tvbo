###  https://w3id.org/tvbo/models/EpileptorRestingState/parameters/Iext
<https://w3id.org/tvbo/models/EpileptorRestingState/parameters/Iext> rdf:type owl:NamedIndividual ,
                                                                              <https://w3id.org/tvbo/Parameter> ;
                                                                     <http://purl.org/dc/terms/description> "External input current to the first population (x1, y1)" ;
