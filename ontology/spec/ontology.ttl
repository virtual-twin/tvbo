                               rdfs:label "format (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#notation> "format" .


<https://w3id.org/tvbo/fps> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                            rdfs:label "fps (slot)" ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Playback rate of the saved movie in frames per second (default 20). Independent of `frames`: together they set how long the movie runs, and separately from how much of the data it shows." ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> ;
                            <http://www.w3.org/2004/02/skos/core#notation> "fps" .


