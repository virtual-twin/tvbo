                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "r_I" ;
                                                                    <https://w3id.org/tvbo/rhs> "r_max/(1 + exp(-k_phi*(mu_si - mu_th)))" ;
