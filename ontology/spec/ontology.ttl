                                                                                             "iCa" ;
                                                     <https://w3id.org/tvbo/neuroml/hasParameter> "thresh" ,
                                                                                                  "v0" .


###  https://w3id.org/tvbo/neuroml/poissonFiringSynapse
<https://w3id.org/tvbo/neuroml/poissonFiringSynapse> rdf:type owl:Class ;
                                                     rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseVoltageDepPointCurrentSpiking> ;
                                                     <http://purl.org/dc/terms/description> "Poisson spike generator firing at _averageRate, which is connected to single _synapse that is triggered every time a spike is generated, producing an input current. See also _transientPoissonFiringSynapse_."@en ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                     rdfs:label "poissonFiringSynapse"@en ;
