###  https://w3id.org/tvbo/models/Sakarya/parameters/m
<https://w3id.org/tvbo/models/Sakarya/parameters/m> rdf:type owl:NamedIndividual ,
                                                             <https://w3id.org/tvbo/Parameter> ;
                                                    <http://purl.org/dc/terms/description> "Nonlinear coupling coefficient m." ;
                                                    <http://schema.org/defaultValue> "1.0"^^xsd:double ;
