                                                                             <https://w3id.org/tvbo/Parameter> ;
                                                                    <http://purl.org/dc/terms/description> "Constant parameter to reproduce FHN dynamics where                excitatory input currents are negative" ;
                                                                    <http://schema.org/defaultValue> "1.0"^^xsd:double ;
