                                rdfs:label "sampler (slot)" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "MCMC sampler ('nuts'). Each backend maps its own way." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "sampler" .


<https://w3id.org/tvbo/sampling_period_unit> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                             rdfs:label "sampling_period_unit (slot)" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Unit of the sampling period (e.g., 'ms', 's')." ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                             <http://www.w3.org/2004/02/skos/core#notation> "sampling_period_unit" .


<https://w3id.org/tvbo/scale> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                              rdfs:label "scale (slot)" ;
                              <http://www.w3.org/2004/02/skos/core#definition> "BIDS scale- entity (BEP017, e.g., 1000)" ;
                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                              <http://www.w3.org/2004/02/skos/core#notation> "scale" .


<https://w3id.org/tvbo/schema_version> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                       rdfs:label "schema_version (slot)" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "The schema version a file was written against — the envelope `Document` declares." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/common> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "schema_version" .


<https://w3id.org/tvbo/scipy_ode_base> rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
