                                                                  <https://w3id.org/tvbo/Parameter> ;
                                                         <http://purl.org/dc/terms/description> "Bias parameter β." ;
                                                         <http://schema.org/defaultValue> "0.001"^^xsd:double ;
                                                         rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                         rdfs:label "beta (RulkovMap parameter)" ;
                                                         <http://www.w3.org/2004/02/skos/core#notation> "beta" .


###  https://w3id.org/tvbo/models/RulkovMap/parameters/sigma
<https://w3id.org/tvbo/models/RulkovMap/parameters/sigma> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/Parameter> ;
                                                          <http://purl.org/dc/terms/description> "Coupling parameter σ from fast to slow variable." ;
                                                          <http://schema.org/defaultValue> "0.001"^^xsd:double ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "sigma (RulkovMap parameter)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "sigma" .


###  https://w3id.org/tvbo/models/RulkovMap/state_variables/x
<https://w3id.org/tvbo/models/RulkovMap/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                    <https://w3id.org/tvbo/StateVariable> ;
                                                           <https://w3id.org/tvbo/lhs> "x_next" ;
                                                           <https://w3id.org/tvbo/rhs> "alpha/(1 + x**2) + y" ;
                                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                           rdfs:label "x (RulkovMap state variable)" ;
                                                           <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/models/RulkovMap/state_variables/y
<https://w3id.org/tvbo/models/RulkovMap/state_variables/y> rdf:type owl:NamedIndividual ,
                                                                    <https://w3id.org/tvbo/StateVariable> ;
                                                           <https://w3id.org/tvbo/lhs> "y_next" ;
                                                           <https://w3id.org/tvbo/rhs> "y - sigma*x - beta" ;
                                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                           rdfs:label "y (RulkovMap state variable)" ;
                                                           <http://www.w3.org/2004/02/skos/core#notation> "y" .


