                                                                       <https://w3id.org/tvbo/rhs> "(I + J*r*tau*(1 - A) + V**2 + c_glob0*cr + c_glob1*cv + eta - pi**2*r**2*tau**2)/tau" ;
                                                                       rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                       rdfs:label "V (GastSchmidtKnosche_SD state variable)" ;
