                                                      rdfs:label "baseVoltageDepSynapse"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#baseVoltageDepSynapse> ;
                                                      <https://w3id.org/tvbo/neuroml/requires> "v" .


###  https://w3id.org/tvbo/neuroml/baseVoltageDepTime
<https://w3id.org/tvbo/neuroml/baseVoltageDepTime> rdf:type owl:Class ;
                                                   rdfs:subClassOf owl:Thing ;
                                                   <http://purl.org/dc/terms/description> "Base ComponentType for voltage dependent ComponentType producing value _t with dimension time (e.g. for time course of rate variable). Note: time course would not normally be fit to exp/sigmoid etc."@en ;
                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                   rdfs:label "baseVoltageDepTime"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#baseVoltageDepTime> ;
                                                   <https://w3id.org/tvbo/neuroml/exposes> "t" ;
                                                   <https://w3id.org/tvbo/neuroml/requires> "v" .


###  https://w3id.org/tvbo/neuroml/baseVoltageDepVariable
<https://w3id.org/tvbo/neuroml/baseVoltageDepVariable> rdf:type owl:Class ;
                                                       rdfs:subClassOf owl:Thing ;
                                                       <http://purl.org/dc/terms/description> "Base ComponentType for voltage dependent variable  _x, which depends on _v. Can be used for inf/steady state of rate variable."@en ;
                                                       rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                       rdfs:label "baseVoltageDepVariable"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#baseVoltageDepVariable> ;
                                                       <https://w3id.org/tvbo/neuroml/exposes> "x" ;
                                                       <https://w3id.org/tvbo/neuroml/requires> "v" .


###  https://w3id.org/tvbo/neuroml/biophysicalProperties
<https://w3id.org/tvbo/neuroml/biophysicalProperties> rdf:type owl:Class ;
                                                      rdfs:subClassOf owl:Thing ;
                                                      <http://purl.org/dc/terms/description> "The biophysical properties of the _cell_, including the _membraneProperties_ and the _intracellularProperties_"@en ;
