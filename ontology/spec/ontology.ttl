                                                                               <https://w3id.org/tvbo/StateVariable> ;
                                                                      <https://w3id.org/tvbo/lhs> "Derivative(alpha, t)" ;
                                                                      <https://w3id.org/tvbo/rhs> "beta - e_i*alpha**3 + f_i*alpha**2 - gamma + K21*(mode_dot(xi, C_ik) - alpha) + II_i + mode_sum(c_glob0) + local_coupling*xi" ;
                                                                      rdfs:label "alpha (ReducedSetHindmarshRose state variable)" ;
                                                                      <http://www.w3.org/2004/02/skos/core#notation> "alpha" .


###  https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/beta
<https://w3id.org/tvbo/ReducedSetHindmarshRose/state_variables/beta> rdf:type owl:NamedIndividual ,
                                                                              <https://w3id.org/tvbo/StateVariable> ;
                                                                     <https://w3id.org/tvbo/lhs> "Derivative(beta, t)" ;
                                                                     <https://w3id.org/tvbo/rhs> "h_i - p_i*alpha**2 - beta" ;
