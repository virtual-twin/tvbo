                                                                                            "surfaceArea" .


###  https://w3id.org/tvbo/neuroml/connection
<https://w3id.org/tvbo/neuroml/connection> rdf:type owl:Class ;
                                           rdfs:subClassOf owl:Thing ;
                                           <http://purl.org/dc/terms/description> "Event connection directly between named components, which gets processed via a new instance of a _synapse component which is created on the target component. Normally contained inside a _projection_ element."@en ;
                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                           rdfs:label "connection"@en ;
                                           <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#connection> .


###  https://w3id.org/tvbo/neuroml/connectionWD
<https://w3id.org/tvbo/neuroml/connectionWD> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/tvbo/neuroml/connection> ;
                                             <http://purl.org/dc/terms/description> "Event connection between named components, which gets processed via a new instance of a synapse component which is created on the target component, includes setting of _weight and _delay for the synaptic connection"@en ;
                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                             rdfs:label "connectionWD"@en ;
                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#connectionWD> ;
                                             <https://w3id.org/tvbo/neuroml/hasParameter> "delay" ,
                                                                                          "weight" .


###  https://w3id.org/tvbo/neuroml/continuousConnection
<https://w3id.org/tvbo/neuroml/continuousConnection> rdf:type owl:Class ;
                                                     rdfs:subClassOf owl:Thing ;
                                                     <http://purl.org/dc/terms/description> "An instance of a connection in a _continuousProjection_ between _presynapticPopulation to another _postsynapticPopulation through a _preComponent at the start and _postComponent at the end. Can be used for analog synapses."@en ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                     rdfs:label "continuousConnection"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#continuousConnection> .


###  https://w3id.org/tvbo/neuroml/continuousConnectionInstance
<https://w3id.org/tvbo/neuroml/continuousConnectionInstance> rdf:type owl:Class ;
                                                             rdfs:subClassOf owl:Thing ;
                                                             <http://purl.org/dc/terms/description> "An instance of a connection in a _continuousProjection_ between _presynapticPopulation to another _postsynapticPopulation through a _preComponent at the start and _postComponent at the end. Populations need to be of type _populationList_ and contain _instance_ and _location_ elements. Can be used for analog synapses."@en ;
                                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                             rdfs:label "continuousConnectionInstance"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#continuousConnectionInstance> .


###  https://w3id.org/tvbo/neuroml/continuousConnectionInstanceW
<https://w3id.org/tvbo/neuroml/continuousConnectionInstanceW> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://w3id.org/tvbo/neuroml/continuousConnectionInstance> ;
                                                              <http://purl.org/dc/terms/description> "An instance of a connection in a _continuousProjection_ between _presynapticPopulation to another _postsynapticPopulation through a _preComponent at the start and _postComponent at the end. Populations need to be of type _populationList_ and contain _instance_ and _location_ elements. Can be used for analog synapses. Includes setting of _weight for the connection"@en ;
                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                              rdfs:label "continuousConnectionInstanceW"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#continuousConnectionInstanceW> ;
                                                              <https://w3id.org/tvbo/neuroml/hasParameter> "weight" .


###  https://w3id.org/tvbo/neuroml/continuousProjection
