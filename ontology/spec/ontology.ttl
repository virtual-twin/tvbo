                          rdfs:label "n (slot)" ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Number of points (alternative to step for grid exploration)." ;
                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
