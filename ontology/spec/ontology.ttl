                                                                                                                          <http://purl.obolibrary.org/obo/GO_0099605> ;
                                                                 rdfs:label "H_i (DecoBalancedExcInh derived variable)" ;
                                                                 <http://www.w3.org/2004/02/skos/core#notation> "H_i" .


###  https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/I_e
