<https://w3id.org/tvbo/models/ThomasCyclical/state_variables/z> rdf:type owl:NamedIndividual ,
                                                                         <https://w3id.org/tvbo/StateVariable> ;
                                                                <https://w3id.org/tvbo/lhs> "Derivative(z, t)" ;
                                                                <https://w3id.org/tvbo/rhs> "sin(x) - b*z" ;
                                                                rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                rdfs:label "z (ThomasCyclical state variable)" ;
                                                                <http://www.w3.org/2004/02/skos/core#notation> "z" .


###  https://w3id.org/tvbo/models/TowelMap/parameters/b
<https://w3id.org/tvbo/models/TowelMap/parameters/b> rdf:type owl:NamedIndividual ,
                                                              <https://w3id.org/tvbo/Parameter> ;
                                                     <http://purl.org/dc/terms/description> "Coupling coefficient b in z-update." ;
                                                     <http://schema.org/defaultValue> "0.2"^^xsd:double ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                     rdfs:label "b (TowelMap parameter)" ;
                                                     <http://www.w3.org/2004/02/skos/core#notation> "b" .


###  https://w3id.org/tvbo/models/TowelMap/state_variables/x
<https://w3id.org/tvbo/models/TowelMap/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "x_next" ;
                                                          <https://w3id.org/tvbo/rhs> "3.8*x*(1 - x) - 0.05*(y + 0.35)*(1 - 2*z)" ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "x (TowelMap state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/models/TowelMap/state_variables/y
<https://w3id.org/tvbo/models/TowelMap/state_variables/y> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "y_next" ;
                                                          <https://w3id.org/tvbo/rhs> "0.1*((y + 0.35)*(1 - 2*z) - 1)*(1 - 1.9*x)" ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "y (TowelMap state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "y" .


###  https://w3id.org/tvbo/models/TowelMap/state_variables/z
<https://w3id.org/tvbo/models/TowelMap/state_variables/z> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "z_next" ;
                                                          <https://w3id.org/tvbo/rhs> "3.78*z*(1 - z) + b*y" ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "z (TowelMap state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "z" .


###  https://w3id.org/tvbo/models/TsodyksMarkram/derived_variables/SS0
<https://w3id.org/tvbo/models/TsodyksMarkram/derived_variables/SS0> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "SS0" ;
                                                                    <https://w3id.org/tvbo/rhs> "J*u*x*E + E0" ;
                                                                    <http://purl.org/dc/terms/description> "Total synaptic input (recurrent + external)" ;
