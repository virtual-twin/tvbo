                                                                         <https://w3id.org/tvbo/StateVariable> ;
                                                                <https://w3id.org/tvbo/rhs> "A*a*(p + C2*Sigm(C1*y0) + c_intercolumn) - 2*a*y4 - a**2*y1" ;
