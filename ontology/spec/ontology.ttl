                                                                            <https://w3id.org/tvbo/Parameter> ;
                                                                   <http://purl.org/dc/terms/description> "Time scale factor" ;
                                                                   <http://schema.org/defaultValue> "1.0"^^xsd:double ;
                                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                   rdfs:label "t_scale (LarterBreakspear parameter)" ;
                                                                   <http://www.w3.org/2004/02/skos/core#definition> "Time scale factor" ;
                                                                   <http://www.w3.org/2004/02/skos/core#notation> "t_scale" .


###  https://w3id.org/tvbo/models/LarterBreakspear/parameters/tau_K
<https://w3id.org/tvbo/models/LarterBreakspear/parameters/tau_K> rdf:type owl:NamedIndividual ,
                                                                          <https://w3id.org/tvbo/Parameter> ;
                                                                 <https://w3id.org/tvbo/surrogate_of> <http://purl.obolibrary.org/obo/GO_0005267> ;
                                                                 <http://purl.org/dc/terms/description> "Time constant for K relaxation time (ms)" ;
                                                                 <http://schema.org/defaultValue> "1.0"^^xsd:double ;
                                                                 <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0005267> ;
                                                                 rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                 rdfs:label "tau_K (LarterBreakspear parameter)" ;
                                                                 <http://www.w3.org/2004/02/skos/core#definition> "Time constant for K relaxation time (ms)" ;
                                                                 <http://www.w3.org/2004/02/skos/core#notation> "tau_K" .


###  https://w3id.org/tvbo/models/LarterBreakspear/state_variables/V
<https://w3id.org/tvbo/models/LarterBreakspear/state_variables/V> rdf:type owl:NamedIndividual ,
                                                                           <https://w3id.org/tvbo/StateVariable> ;
                                                                  <https://w3id.org/tvbo/surrogate_of> <http://purl.obolibrary.org/obo/GO_0042391> ;
                                                                  <https://w3id.org/tvbo/lhs> "Derivative(V, t)" ;
                                                                  <https://w3id.org/tvbo/rhs> "t_scale*(I_ext*a_ne - Q_Z*Z*a_ie - W*g_K*(V - V_K) - g_L*(V - V_L) + m_Ca*(V - V_Ca)*(-C*a_ee*c_glob*r_NMDA - a_ee*r_NMDA*(1.0 - C)*(Q_V + lc_0) - g_Ca) - (V - V_Na)*(C*a_ee*c_glob + a_ee*(1.0 - C)*(Q_V + lc_0) + g_Na*m_Na))" ;
                                                                  <http://purl.org/dc/terms/description> "First state-variable of the Larter-Breakspear (Breakspear et al" ;
                                                                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0042391> ;
                                                                  rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                  rdfs:label "V (LarterBreakspear state variable)" ;
                                                                  <http://www.w3.org/2004/02/skos/core#notation> "V" .


###  https://w3id.org/tvbo/models/LarterBreakspear/state_variables/W
<https://w3id.org/tvbo/models/LarterBreakspear/state_variables/W> rdf:type owl:NamedIndividual ,
                                                                           <https://w3id.org/tvbo/StateVariable> ;
                                                                  <https://w3id.org/tvbo/surrogate_of> <http://purl.obolibrary.org/obo/GO_0005267> ;
                                                                  <https://w3id.org/tvbo/lhs> "Derivative(W, t)" ;
                                                                  <https://w3id.org/tvbo/rhs> "phi*t_scale*(-W + m_K)/tau_K" ;
                                                                  <http://purl.org/dc/terms/description> "Second state-variable of the Larter-Breakspear (Breakspear et al" ;
                                                                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0005267> ;
                                                                  rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                  rdfs:label "W (LarterBreakspear state variable)" ;
                                                                  <http://www.w3.org/2004/02/skos/core#notation> "W" .


###  https://w3id.org/tvbo/models/LarterBreakspear/state_variables/Z
<https://w3id.org/tvbo/models/LarterBreakspear/state_variables/Z> rdf:type owl:NamedIndividual ,
                                                                           <https://w3id.org/tvbo/StateVariable> ;
                                                                  <https://w3id.org/tvbo/surrogate_of> <http://purl.obolibrary.org/obo/CL_0000099> ,
                                                                                                       <http://purl.obolibrary.org/obo/GO_0060080> ;
                                                                  <https://w3id.org/tvbo/lhs> "Derivative(Z, t)" ;
                                                                  <https://w3id.org/tvbo/rhs> "b*t_scale*(I_ext*a_ni + Q_V*V*a_ei)" ;
                                                                  <http://purl.org/dc/terms/description> "Third state-variable of the Larter-Breakspear (Breakspear et al" ;
                                                                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/CL_0000099> ,
                                                                                                                           <http://purl.obolibrary.org/obo/GO_0060080> ;
                                                                  rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                  rdfs:label "Z (LarterBreakspear state variable)" ;
                                                                  <http://www.w3.org/2004/02/skos/core#notation> "Z" .


###  https://w3id.org/tvbo/models/Linear/parameters/gamma
<https://w3id.org/tvbo/models/Linear/parameters/gamma> rdf:type owl:NamedIndividual ,
                                                                <https://w3id.org/tvbo/Parameter> ;
                                                       <http://purl.org/dc/terms/description> "The damping coefficient specifies how quickly the node's activity relaxes, must be larger than the node's in-degree in order to remain stable." ;
                                                       <http://schema.org/defaultValue> "-10.0"^^xsd:double ;
                                                       rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                       rdfs:label "gamma (Linear parameter)" ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "The damping coefficient" ;
                                                       <http://www.w3.org/2004/02/skos/core#notation> "gamma" .


###  https://w3id.org/tvbo/models/Linear/state_variables/x
<https://w3id.org/tvbo/models/Linear/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                 <https://w3id.org/tvbo/StateVariable> ;
                                                        <https://w3id.org/tvbo/lhs> "Derivative(x, t)" ;
                                                        <https://w3id.org/tvbo/rhs> "gamma*x + c_glob + local_coupling*x" ;
                                                        <http://purl.org/dc/terms/description> "The Linear model has a single state variable." ;
                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                        rdfs:label "x (Linear state variable)" ;
                                                        <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/models/LogisticMap/parameters/r
<https://w3id.org/tvbo/models/LogisticMap/parameters/r> rdf:type owl:NamedIndividual ,
                                                                 <https://w3id.org/tvbo/Parameter> ;
                                                        <http://purl.org/dc/terms/description> "Logistic growth rate r." ;
                                                        <http://schema.org/defaultValue> "4.0"^^xsd:double ;
                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                        rdfs:label "r (LogisticMap parameter)" ;
                                                        <http://www.w3.org/2004/02/skos/core#notation> "r" .


###  https://w3id.org/tvbo/models/LogisticMap/state_variables/x
<https://w3id.org/tvbo/models/LogisticMap/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                      <https://w3id.org/tvbo/StateVariable> ;
                                                             <https://w3id.org/tvbo/lhs> "x_next" ;
                                                             <https://w3id.org/tvbo/rhs> "r*x*(1 - x)" ;
                                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                             rdfs:label "x (LogisticMap state variable)" ;
                                                             <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/models/Lorenz63/parameters/beta
<https://w3id.org/tvbo/models/Lorenz63/parameters/beta> rdf:type owl:NamedIndividual ,
                                                                 <https://w3id.org/tvbo/Parameter> ;
                                                        <http://purl.org/dc/terms/description> "Geometric factor (β = 8/3) related to aspect ratio." ;
                                                        <http://schema.org/defaultValue> "2.666667"^^xsd:double ;
                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                        rdfs:label "beta (Lorenz63 parameter)" ;
                                                        <http://www.w3.org/2004/02/skos/core#notation> "beta" .


###  https://w3id.org/tvbo/models/Lorenz63/parameters/rho
<https://w3id.org/tvbo/models/Lorenz63/parameters/rho> rdf:type owl:NamedIndividual ,
                                                                <https://w3id.org/tvbo/Parameter> ;
                                                       <http://purl.org/dc/terms/description> "Rayleigh number (ρ) scaled parameter driving convection." ;
                                                       <http://schema.org/defaultValue> "28.0"^^xsd:double ;
                                                       rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                       rdfs:label "rho (Lorenz63 parameter)" ;
                                                       <http://www.w3.org/2004/02/skos/core#notation> "rho" .


###  https://w3id.org/tvbo/models/Lorenz63/parameters/sigma
<https://w3id.org/tvbo/models/Lorenz63/parameters/sigma> rdf:type owl:NamedIndividual ,
                                                                  <https://w3id.org/tvbo/Parameter> ;
                                                         <http://purl.org/dc/terms/description> "Prandtl number (σ) controlling rate of convection." ;
                                                         <http://schema.org/defaultValue> "10.0"^^xsd:double ;
                                                         rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                         rdfs:label "sigma (Lorenz63 parameter)" ;
                                                         <http://www.w3.org/2004/02/skos/core#notation> "sigma" .


###  https://w3id.org/tvbo/models/Lorenz63/state_variables/X
<https://w3id.org/tvbo/models/Lorenz63/state_variables/X> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(X, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "sigma*(Y - X)" ;
                                                          <http://purl.org/dc/terms/description> "State variable X (convective intensity component)." ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "X (Lorenz63 state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "X" .


###  https://w3id.org/tvbo/models/Lorenz63/state_variables/Y
<https://w3id.org/tvbo/models/Lorenz63/state_variables/Y> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(Y, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "X*(rho - Z) - Y" ;
                                                          <http://purl.org/dc/terms/description> "State variable Y (temperature difference component 1)." ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "Y (Lorenz63 state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "Y" .


###  https://w3id.org/tvbo/models/Lorenz63/state_variables/Z
<https://w3id.org/tvbo/models/Lorenz63/state_variables/Z> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(Z, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "X*Y - beta*Z" ;
                                                          <http://purl.org/dc/terms/description> "State variable Z (temperature difference component 2)." ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "Z (Lorenz63 state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "Z" .


###  https://w3id.org/tvbo/models/Lorenz84/parameters/F
<https://w3id.org/tvbo/models/Lorenz84/parameters/F> rdf:type owl:NamedIndividual ,
                                                              <https://w3id.org/tvbo/Parameter> ;
                                                     <http://purl.org/dc/terms/description> "Baroclinic forcing F." ;
                                                     <http://schema.org/defaultValue> "6.846"^^xsd:double ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                     rdfs:label "F (Lorenz84 parameter)" ;
                                                     <http://www.w3.org/2004/02/skos/core#notation> "F" .


