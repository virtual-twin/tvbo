                                                  rdfs:label "auto (WorkflowDistributeBy)" ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "Vectorize every axis the backend can batch; fan out the rest." ;
                                                  <http://www.w3.org/2004/02/skos/core#notation> "auto" .


###  https://w3id.org/tvbo/WorkflowDistributeBy#vectorize
