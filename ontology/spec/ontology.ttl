###  https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/uA
<https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/uA> rdf:type owl:NamedIndividual ,
                                                                                  <https://w3id.org/tvbo/StateVariable> ;
                                                                         <https://w3id.org/tvbo/lhs> "Derivative(uA, t)" ;
                                                                         <https://w3id.org/tvbo/rhs> "cA + 0*uA" ;
                                                                         <http://purl.org/dc/terms/description> "Ultra-slow modulation of the offset point A along the offset great arc." ;
                                                                         rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                         rdfs:label "uA (EpileptorCodim3SlowMod state variable)" ;
                                                                         <http://www.w3.org/2004/02/skos/core#notation> "uA" .


###  https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/uB
<https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/uB> rdf:type owl:NamedIndividual ,
                                                                                  <https://w3id.org/tvbo/StateVariable> ;
                                                                         <https://w3id.org/tvbo/lhs> "Derivative(uB, t)" ;
                                                                         <https://w3id.org/tvbo/rhs> "cB + 0*uB" ;
                                                                         <http://purl.org/dc/terms/description> "Ultra-slow modulation of the onset point B along the onset great arc." ;
