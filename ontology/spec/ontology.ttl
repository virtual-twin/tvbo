                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <https://w3id.org/tvbo/frame> ;
                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <https://w3id.org/tvbo/label> ;
                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <https://w3id.org/tvbo/mark> ;
                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <https://w3id.org/tvbo/style> ;
                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
