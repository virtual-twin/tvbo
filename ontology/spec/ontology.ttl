                                                             <http://schema.org/defaultValue> "0.0"^^xsd:double ;
                                                             rdfs:label "Ks (EpileptorCodim3SlowMod parameter)" ;
                                                             <http://www.w3.org/2004/02/skos/core#notation> "Ks" .


