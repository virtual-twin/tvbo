                                       <https://w3id.org/tvbo/hasParameter> <https://w3id.org/tvbo/models/SupHopf/parameters/a> ,
                                                                            <https://w3id.org/tvbo/models/SupHopf/parameters/omega> ;
                                       <https://w3id.org/tvbo/hasStateVariable> <https://w3id.org/tvbo/models/SupHopf/state_variables/x> ,
                                                                                <https://w3id.org/tvbo/models/SupHopf/state_variables/y> ;
                                       <https://w3id.org/tvbo/model_type> "generic" .

