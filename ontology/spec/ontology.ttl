                                               owl:onProperty <https://w3id.org/tvbo/hasCodimension> ;
                                               owl:hasValue <https://w3id.org/tvbo/Codimension2>
                                             ] ;
                             rdfs:comment "Codim-2 organising centre where two fold curves meet tangentially."@en ;
                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "Cusp"@en ;
                             <http://www.w3.org/2004/02/skos/core#altLabel> "CP" ,
                                                                            "cp" ,
                                                                            "cusp" ;
                             <https://w3id.org/tvbo/canonicalCode> "CP" .


