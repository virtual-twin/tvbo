                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/tvbo/va> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/tvbo/x> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/tvbo/y> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/tvbo/arrow> ;
                                                     owl:allValuesFrom xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/tvbo/rotation> ;
                                                     owl:allValuesFrom xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/tvbo/size> ;
                                                     owl:allValuesFrom xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/tvbo/tail_x> ;
                                                     owl:allValuesFrom xsd:float
                                                   ] ,
