                                                                                   <https://w3id.org/tvbo/DerivedVariable> ;
                                                                          <https://w3id.org/tvbo/rhs> "Piecewise((0.32/4.0, Eq(Vs, -46.9)), (0.32*(-46.9 - Vs)/(exp((-46.9 - Vs)/4.0) - 1.0), True))" ;
                                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                          rdfs:label "alpha_ms (PinskyRinzelCA3 derived variable)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "alpha_ms" .


