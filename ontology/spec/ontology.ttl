                                                      rdfs:subClassOf <https://w3id.org/tvbo/AggregationType> ;
                                                      rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                      rdfs:label "first_passage (AggregationType)" ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "First-passage time index (per node): the first sample at which the source crosses the observation's `threshold` parameter (>=), or the sample count if it never crosses. Backend-independent (argmax of the threshold-crossing). Multiply by the sampling step for a time." ;
                                                      <http://www.w3.org/2004/02/skos/core#notation> "first_passage" .


