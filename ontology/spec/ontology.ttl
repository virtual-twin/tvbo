###  https://w3id.org/tvbo/FixedPoint
<https://w3id.org/tvbo/FixedPoint> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/tvbo/Attractor> .


###  https://w3id.org/tvbo/Fold
<https://w3id.org/tvbo/Fold> rdf:type owl:Class ;
                             owl:equivalentClass <https://w3id.org/tvbo/SaddleNode> ,
                                                 [ owl:intersectionOf ( <https://w3id.org/tvbo/Bifurcation>
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <https://w3id.org/tvbo/hasBranchGeometry> ;
                                                                          owl:hasValue <https://w3id.org/tvbo/LimitPointGeometry>
                                                                        ]
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <https://w3id.org/tvbo/hasCodimension> ;
                                                                          owl:hasValue <https://w3id.org/tvbo/Codimension1>
                                                                        ]
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <https://w3id.org/tvbo/hasEigenvalueSignature> ;
                                                                          owl:hasValue <https://w3id.org/tvbo/RealEigenvalueZero>
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:subClassOf <https://w3id.org/tvbo/Bifurcation> ;
                             rdfs:comment "Saddle-node (limit / turning point): a pair of equilibria collide and annihilate as one real eigenvalue crosses zero and the branch folds back on the parameter."@en ;
                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                             rdfs:label "Fold"@en ;
                             <http://www.w3.org/2004/02/skos/core#altLabel> "LP" ,
                                                                            "fold" ,
                                                                            "limit point" ,
                                                                            "limitpoint" ,
                                                                            "lp" ,
                                                                            "saddle-node" ,
                                                                            "saddlenode" ,
                                                                            "sn" ;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Fold"@en ;
                             <https://w3id.org/tvbo/canonicalCode> "LP" .


###  https://w3id.org/tvbo/FoldOfLimitCycles
<https://w3id.org/tvbo/FoldOfLimitCycles> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/tvbo/Bifurcation> ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <https://w3id.org/tvbo/hasCodimension> ;
                                                            owl:hasValue <https://w3id.org/tvbo/Codimension1>
                                                          ] ;
                                          rdfs:comment "Saddle-node of periodic orbits: two limit cycles collide and annihilate as a Floquet multiplier crosses +1."@en ;
                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                          rdfs:label "Fold of limit cycles"@en ;
                                          <http://www.w3.org/2004/02/skos/core#altLabel> "LPC" ,
                                                                                         "cpc" ,
                                                                                         "fold of limit cycles" ,
                                                                                         "fold-of-limit-cycles" ,
                                                                                         "lpc" ,
                                                                                         "snpo" ;
                                          <https://w3id.org/tvbo/canonicalCode> "LPC" .


