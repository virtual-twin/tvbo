                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/reconcile> ;
                                                  owl:allValuesFrom <https://w3id.org/tvbo/NodeReconciliation>
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/sel> ;
                                                  owl:allValuesFrom <https://w3id.org/tvbo/Argument>
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/transform> ;
                                                  owl:allValuesFrom xsd:string
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/analysis> ;
                                                  owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/cohort> ;
                                                  owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/experiment> ;
                                                  owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/output> ;
                                                  owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/query> ;
                                                  owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/reconcile> ;
                                                  owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/sel> ;
                                                  owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/transform> ;
                                                  owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/analysis> ;
                                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/cohort> ;
                                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/experiment> ;
                                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/output> ;
                                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/query> ;
                                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/reconcile> ;
                                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/transform> ;
                                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/iri> ;
                                                  owl:allValuesFrom xsd:anyURI
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/iri> ;
                                                  owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/tvbo/iri> ;
                                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                ] ;
                                rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                rdfs:label "DataRef" ;
                                <http://www.w3.org/2004/02/skos/core#definition> "A pointer to one labelled array in a result container, dataset, or curated entity — the single cross-container reference primitive (a PROV entity a consumer ``prov:used``). WHERE is ``experiment`` (an in-study experiment id, resolved like ``initial_state.source_experiment``), ``analysis`` (an in-study analysis name), ``cohort`` (a named subset of a study dataset, read from each member's own file chosen by ``query``), or the full ``iri`` (a curated / result / external pointer); at most one. An ``iri`` that names a network, by the path of its sidecar file or by a curated network's exact id, reads ``output`` as a layer of that network (an edge layer or a per-node quantity) as the network delivers it, its own sources read and its transforms applied. WHICH is ``output`` (a recorded variable, ``observation__<name>``, ``estimate__<param>``, an external variable, or the measure a cohort member's file holds). SLICE is ``sel`` (label-keyed ``.sel``, never positional). ``reconcile`` optionally aligns the sourced array to the consuming network's node order by label. One model reused by figure layers (``Layer.used``), sourced arguments (``Argument.used``), sourced parameters (``Parameter.used``) and sourced network layers (``Edge.used``), so data binding, cross-experiment sourcing and PROV provenance are the same edge. A sourced array is resolved lazily and never inlined into generated code." ;
                                <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.w3.org/ns/prov#Entity> ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/common> .


