                                                                                 <https://w3id.org/tvbo/StateVariable> ;
                                                                        <https://w3id.org/tvbo/lhs> "Derivative(x2, t)" ;
                                                                        <https://w3id.org/tvbo/rhs> "tt*(Iext2 + Kf*c_glob1 + bb*g - x2**3 + x2 - y2 - 0.3*z + 1.05)" ;
