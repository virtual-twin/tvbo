                                                          rdfs:label "stochastic_mask (ProcedureStepType)" ;
                                                          <http://www.w3.org/2004/02/skos/core#definition> "Boolean connection mask: compare the quantity named by `of` against a draw from `distribution` using `comparison`. The declarative form of a distance-dependent connection probability." ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "stochastic_mask" .


