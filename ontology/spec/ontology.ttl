###  https://w3id.org/tvbo/Significance
<https://w3id.org/tvbo/Significance> rdf:type owl:Class ;
                                     rdfs:subClassOf owl:Thing ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/used> ;
                                                       owl:allValuesFrom <https://w3id.org/tvbo/DataRef>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/levels> ;
                                                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/used> ;
                                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/used> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/tvbo/levels> ;
                                                       owl:allValuesFrom xsd:float
                                                     ] ;
                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                     rdfs:label "Significance" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "How significant a printed statistic is, as the asterisks a paper sets after it. The p-value is read from a result container and compared with every threshold in `levels`; the label gains one asterisk per threshold the p-value is below, and none when it reaches the largest." ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo/figure> .


