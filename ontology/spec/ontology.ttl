                                                     rdfs:label "c (Roessler parameter)" ;
                                                     <http://www.w3.org/2004/02/skos/core#notation> "c" .


###  https://w3id.org/tvbo/models/Roessler/state_variables/x
<https://w3id.org/tvbo/models/Roessler/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(x, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "-y - z" ;
                                                          <http://purl.org/dc/terms/description> "First state variable of the Rössler system." ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "x (Roessler state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/models/Roessler/state_variables/y
<https://w3id.org/tvbo/models/Roessler/state_variables/y> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(y, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "x + a*y" ;
                                                          <http://purl.org/dc/terms/description> "Second state variable." ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "y (Roessler state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "y" .


###  https://w3id.org/tvbo/models/Roessler/state_variables/z
