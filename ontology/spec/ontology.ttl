                                                                    <http://schema.org/defaultValue> "0.08"^^xsd:double ;
                                                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                    rdfs:label "k (NLDCoupledLogisticMaps4 parameter)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "k" .


