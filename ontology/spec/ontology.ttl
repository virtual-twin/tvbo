                                                                    rdfs:label "E0 (EpileptorCodim3 derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "E0" .


###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/E1
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/E1> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "E1" ;
                                                                    <https://w3id.org/tvbo/rhs> "-mu1_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)" ;
                                                                    <http://purl.org/dc/terms/description> "Second component of the unit vector E parametrising the great arc." ;
