###  https://w3id.org/tvbo/NoiseDraw
<https://w3id.org/tvbo/NoiseDraw> rdf:type owl:Class ;
                                  owl:equivalentClass [ rdf:type owl:Class ;
                                                        owl:unionOf ( <https://w3id.org/tvbo/NoiseDraw#blocked>
                                                                      <https://w3id.org/tvbo/NoiseDraw#fused>
                                                                    )
                                                      ] ;
                                  rdfs:subClassOf owl:Thing ;
                                  rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                  rdfs:label "NoiseDraw" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "How a stochastic run's noise realization is generated." ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                  <https://w3id.org/linkml/permissible_values> <https://w3id.org/tvbo/NoiseDraw#blocked> ,
                                                                               <https://w3id.org/tvbo/NoiseDraw#fused> .


###  https://w3id.org/tvbo/NoiseType
<https://w3id.org/tvbo/NoiseType> rdf:type owl:Class ;
                                  owl:equivalentClass [ rdf:type owl:Class ;
                                                        owl:unionOf ( <https://w3id.org/tvbo/NoiseType#brown>
                                                                      <https://w3id.org/tvbo/NoiseType#gaussian>
                                                                      <https://w3id.org/tvbo/NoiseType#pink>
                                                                      <https://w3id.org/tvbo/NoiseType#white>
