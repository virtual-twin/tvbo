                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/iri> ;
                                                               owl:allValuesFrom xsd:anyURI
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/mtime> ;
                                                               owl:allValuesFrom xsd:float
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/iri> ;
                                                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/mtime> ;
                                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/iri> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/tvbo/mtime> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ;
                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                             rdfs:label "ReferenceFingerprint" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Cache-invalidation fingerprint for one ``aux_data`` reference. Captures enough about the upstream artifact that a downstream cache can decide cheaply (via mtime + size) whether to trust the cached result, falling back to a hash recompute on mismatch." ;
                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/tvbo/ReferenceFingerprint> ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> .


