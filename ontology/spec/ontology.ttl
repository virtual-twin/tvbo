###  https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/weight_noise
<https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/weight_noise> rdf:type owl:NamedIndividual ,
                                                                                      <https://w3id.org/tvbo/Parameter> ;
                                                                             <http://purl.org/dc/terms/description> "weight noise" ;
                                                                             <http://schema.org/defaultValue> "10.5"^^xsd:double ;
                                                                             rdfs:label "weight_noise (ZerlautAdaptationSecondOrder parameter)" ;
                                                                             <http://www.w3.org/2004/02/skos/core#definition> "Weight of the Ornstein-Uhlenbeck noise drift onto the external excitatory input." ;
                                                                             <http://www.w3.org/2004/02/skos/core#notation> "weight_noise" .


###  https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ee
<https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ee> rdf:type owl:NamedIndividual ,
                                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                                          <https://w3id.org/tvbo/lhs> "Derivative(C_ee, t)" ;
                                                                          <https://w3id.org/tvbo/rhs> "(TFe*(1.0/T - TFe)/(N_tot*(1.0 - g)) + (TFe - E)**2 + 2.0*C_ee*dfe_TFe + 2.0*C_ei*dfi_TFe - 2.0*C_ee)/T" ;
                                                                          <http://purl.org/dc/terms/description> "Variance of the excitatory population activity." ;
                                                                          rdfs:label "C_ee (ZerlautAdaptationSecondOrder state variable)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "C_ee" .


###  https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ei
<https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ei> rdf:type owl:NamedIndividual ,
                                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                                          <https://w3id.org/tvbo/lhs> "Derivative(C_ei, t)" ;
                                                                          <https://w3id.org/tvbo/rhs> "((TFe - E)*(TFi - I) + C_ee*dfe_TFe + C_ei*dfe_TFi + C_ei*dfi_TFe + C_ii*dfi_TFi - 2.0*C_ei)/T" ;
                                                                          <http://purl.org/dc/terms/description> "Covariance between the excitatory and inhibitory population activities." ;
                                                                          rdfs:label "C_ei (ZerlautAdaptationSecondOrder state variable)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "C_ei" .


###  https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ii
<https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ii> rdf:type owl:NamedIndividual ,
                                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                                          <https://w3id.org/tvbo/lhs> "Derivative(C_ii, t)" ;
                                                                          <https://w3id.org/tvbo/rhs> "(TFi*(1.0/T - TFi)/(N_tot*g) + (TFi - I)**2 + 2.0*C_ii*dfi_TFi + 2.0*C_ei*dfe_TFi - 2.0*C_ii)/T" ;
                                                                          <http://purl.org/dc/terms/description> "Variance of the inhibitory population activity." ;
                                                                          rdfs:label "C_ii (ZerlautAdaptationSecondOrder state variable)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "C_ii" .


###  https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/E
<https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/E> rdf:type owl:NamedIndividual ,
                                                                                <https://w3id.org/tvbo/StateVariable> ;
                                                                       <https://w3id.org/tvbo/lhs> "Derivative(E, t)" ;
                                                                       <https://w3id.org/tvbo/rhs> "(TFe - E + 0.5*C_ee*d2_fefe_e + 0.5*C_ei*d2_fefi_e + 0.5*C_ei*d2_fife_e + 0.5*C_ii*d2_fifi_e)/T" ;
                                                                       <http://purl.org/dc/terms/description> "Firing rate of the excitatory population [kHz]." ;
                                                                       rdfs:label "E (ZerlautAdaptationSecondOrder state variable)" ;
                                                                       <http://www.w3.org/2004/02/skos/core#notation> "E" .


###  https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/I
<https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/I> rdf:type owl:NamedIndividual ,
                                                                                <https://w3id.org/tvbo/StateVariable> ;
                                                                       <https://w3id.org/tvbo/lhs> "Derivative(I, t)" ;
                                                                       <https://w3id.org/tvbo/rhs> "(TFi - I + 0.5*C_ee*d2_fefe_i + 0.5*C_ei*d2_fefi_i + 0.5*C_ei*d2_fife_i + 0.5*C_ii*d2_fifi_i)/T" ;
                                                                       <http://purl.org/dc/terms/description> "Firing rate of the inhibitory population [kHz]." ;
                                                                       rdfs:label "I (ZerlautAdaptationSecondOrder state variable)" ;
                                                                       <http://www.w3.org/2004/02/skos/core#notation> "I" .


###  https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_e
<https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_e> rdf:type owl:NamedIndividual ,
                                                                                  <https://w3id.org/tvbo/StateVariable> ;
                                                                         <https://w3id.org/tvbo/lhs> "Derivative(W_e, t)" ;
                                                                         <https://w3id.org/tvbo/rhs> "-W_e/tau_w_e + b_e*E + a_e*(muV_e - E_L_e)/tau_w_e" ;
                                                                         <http://purl.org/dc/terms/description> "Adaptation current of the excitatory population [pA]." ;
                                                                         rdfs:label "W_e (ZerlautAdaptationSecondOrder state variable)" ;
                                                                         <http://www.w3.org/2004/02/skos/core#notation> "W_e" .


###  https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_i
<https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_i> rdf:type owl:NamedIndividual ,
                                                                                  <https://w3id.org/tvbo/StateVariable> ;
                                                                         <https://w3id.org/tvbo/lhs> "Derivative(W_i, t)" ;
                                                                         <https://w3id.org/tvbo/rhs> "-W_i/tau_w_i + b_i*I + a_i*(muV_i - E_L_i)/tau_w_i" ;
                                                                         <http://purl.org/dc/terms/description> "Adaptation current of the inhibitory population [pA]." ;
                                                                         rdfs:label "W_i (ZerlautAdaptationSecondOrder state variable)" ;
                                                                         <http://www.w3.org/2004/02/skos/core#notation> "W_i" .


###  https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/ou_drift
<https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/ou_drift> rdf:type owl:NamedIndividual ,
                                                                                       <https://w3id.org/tvbo/StateVariable> ;
                                                                              <https://w3id.org/tvbo/lhs> "Derivative(ou_drift, t)" ;
                                                                              <https://w3id.org/tvbo/rhs> "-ou_drift/tau_OU" ;
                                                                              <http://purl.org/dc/terms/description> "Ornstein-Uhlenbeck noise drift." ;
                                                                              rdfs:label "ou_drift (ZerlautAdaptationSecondOrder state variable)" ;
                                                                              <http://www.w3.org/2004/02/skos/core#notation> "ou_drift" .


###  https://w3id.org/tvbo/ZetterbergJansen/derived_variables/coupled_input
<https://w3id.org/tvbo/ZetterbergJansen/derived_variables/coupled_input> rdf:type owl:NamedIndividual ,
                                                                                  <https://w3id.org/tvbo/DerivedVariable> ;
                                                                         <https://w3id.org/tvbo/lhs> "coupled_input" ;
                                                                         <https://w3id.org/tvbo/rhs> "2*e0/(exp(rho_1*(-c_glob - local_coupling*v6 + rho_2)) + 1)" ;
                                                                         rdfs:label "coupled_input (ZetterbergJansen derived variable)" ;
                                                                         <http://www.w3.org/2004/02/skos/core#notation> "coupled_input" .


###  https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v1
<https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v1> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "sigma_v1" ;
                                                                    <https://w3id.org/tvbo/rhs> "Piecewise((0, rho_1*(rho_2 - v1) > 709), (2*e0/(exp(rho_1*(rho_2 - v1)) + 1), True))" ;
                                                                    rdfs:label "sigma_v1 (ZetterbergJansen derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "sigma_v1" .


###  https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v23
<https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v23> rdf:type owl:NamedIndividual ,
                                                                              <https://w3id.org/tvbo/DerivedVariable> ;
                                                                     <https://w3id.org/tvbo/lhs> "sigma_v23" ;
                                                                     <https://w3id.org/tvbo/rhs> "Piecewise((0, rho_1*(rho_2 - (v2 - v3)) > 709), (2*e0/(exp(rho_1*(rho_2 - (v2 - v3))) + 1), True))" ;
                                                                     rdfs:label "sigma_v23 (ZetterbergJansen derived variable)" ;
                                                                     <http://www.w3.org/2004/02/skos/core#notation> "sigma_v23" .


###  https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v45
<https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v45> rdf:type owl:NamedIndividual ,
                                                                              <https://w3id.org/tvbo/DerivedVariable> ;
                                                                     <https://w3id.org/tvbo/lhs> "sigma_v45" ;
                                                                     <https://w3id.org/tvbo/rhs> "Piecewise((0, rho_1*(rho_2 - (v4 - v5)) > 709), (2*e0/(exp(rho_1*(rho_2 - (v4 - v5))) + 1), True))" ;
                                                                     rdfs:label "sigma_v45 (ZetterbergJansen derived variable)" ;
                                                                     <http://www.w3.org/2004/02/skos/core#notation> "sigma_v45" .


