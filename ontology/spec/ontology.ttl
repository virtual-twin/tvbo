                                                    rdfs:label "m (Sakarya parameter)" ;
                                                    <http://www.w3.org/2004/02/skos/core#notation> "m" .


###  https://w3id.org/tvbo/models/Sakarya/state_variables/x
<https://w3id.org/tvbo/models/Sakarya/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                  <https://w3id.org/tvbo/StateVariable> ;
                                                         <https://w3id.org/tvbo/lhs> "Derivative(x, t)" ;
                                                         <https://w3id.org/tvbo/rhs> "a*x + y + y*z" ;
                                                         rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                         rdfs:label "x (Sakarya state variable)" ;
                                                         <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/models/Sakarya/state_variables/y
<https://w3id.org/tvbo/models/Sakarya/state_variables/y> rdf:type owl:NamedIndividual ,
                                                                  <https://w3id.org/tvbo/StateVariable> ;
                                                         <https://w3id.org/tvbo/lhs> "Derivative(y, t)" ;
                                                         <https://w3id.org/tvbo/rhs> "-x*z + y*z" ;
                                                         rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                         rdfs:label "y (Sakarya state variable)" ;
                                                         <http://www.w3.org/2004/02/skos/core#notation> "y" .


###  https://w3id.org/tvbo/models/Sakarya/state_variables/z
<https://w3id.org/tvbo/models/Sakarya/state_variables/z> rdf:type owl:NamedIndividual ,
                                                                  <https://w3id.org/tvbo/StateVariable> ;
                                                         <https://w3id.org/tvbo/lhs> "Derivative(z, t)" ;
                                                         <https://w3id.org/tvbo/rhs> "-z - m*x*y + b" ;
                                                         rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                         rdfs:label "z (Sakarya state variable)" ;
                                                         <http://www.w3.org/2004/02/skos/core#notation> "z" .


###  https://w3id.org/tvbo/models/Shinriki/derived_variables/Vnl
<https://w3id.org/tvbo/models/Shinriki/derived_variables/Vnl> rdf:type owl:NamedIndividual ,
                                                                       <https://w3id.org/tvbo/DerivedVariable> ;
                                                              <https://w3id.org/tvbo/lhs> "Vnl" ;
                                                              <https://w3id.org/tvbo/rhs> "0.00002295*(exp(3.0038*(v1 - v2)) - exp(-3.0038*(v1 - v2)))" ;
                                                              <http://purl.org/dc/terms/description> "Nonlinear diode network voltage characteristic." ;
                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                              rdfs:label "Vnl (Shinriki derived variable)" ;
                                                              <http://www.w3.org/2004/02/skos/core#notation> "Vnl" .


###  https://w3id.org/tvbo/models/Shinriki/parameters/R1
<https://w3id.org/tvbo/models/Shinriki/parameters/R1> rdf:type owl:NamedIndividual ,
                                                               <https://w3id.org/tvbo/Parameter> ;
                                                      <http://purl.org/dc/terms/description> "Variable resistor R1 controlling nonlinearity." ;
                                                      <http://schema.org/defaultValue> "22.0"^^xsd:double ;
                                                      rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                      rdfs:label "R1 (Shinriki parameter)" ;
                                                      <http://www.w3.org/2004/02/skos/core#notation> "R1" .


###  https://w3id.org/tvbo/models/Shinriki/state_variables/v1
<https://w3id.org/tvbo/models/Shinriki/state_variables/v1> rdf:type owl:NamedIndividual ,
                                                                    <https://w3id.org/tvbo/StateVariable> ;
                                                           <https://w3id.org/tvbo/lhs> "Derivative(v1, t)" ;
                                                           <https://w3id.org/tvbo/rhs> "(v1*(1/6.9 - 1/R1) - Vnl - (v1 - v2)/14.5)/0.01" ;
                                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                           rdfs:label "v1 (Shinriki state variable)" ;
                                                           <http://www.w3.org/2004/02/skos/core#notation> "v1" .


###  https://w3id.org/tvbo/models/Shinriki/state_variables/v2
<https://w3id.org/tvbo/models/Shinriki/state_variables/v2> rdf:type owl:NamedIndividual ,
                                                                    <https://w3id.org/tvbo/StateVariable> ;
                                                           <https://w3id.org/tvbo/lhs> "Derivative(v2, t)" ;
                                                           <https://w3id.org/tvbo/rhs> "(Vnl + (v1 - v2)/14.5 - v3)/0.1" ;
                                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                           rdfs:label "v2 (Shinriki state variable)" ;
                                                           <http://www.w3.org/2004/02/skos/core#notation> "v2" .


###  https://w3id.org/tvbo/models/Shinriki/state_variables/v3
<https://w3id.org/tvbo/models/Shinriki/state_variables/v3> rdf:type owl:NamedIndividual ,
                                                                    <https://w3id.org/tvbo/StateVariable> ;
                                                           <https://w3id.org/tvbo/lhs> "Derivative(v3, t)" ;
                                                           <https://w3id.org/tvbo/rhs> "(-0.1*v3 + v2)/0.32" ;
                                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                           rdfs:label "v3 (Shinriki state variable)" ;
                                                           <http://www.w3.org/2004/02/skos/core#notation> "v3" .


