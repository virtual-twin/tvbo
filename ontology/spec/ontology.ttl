###  https://w3id.org/tvbo/models/AdaptiveExponentialIF/state_variables/v
<https://w3id.org/tvbo/models/AdaptiveExponentialIF/state_variables/v> rdf:type owl:NamedIndividual ,
                                                                                <https://w3id.org/tvbo/StateVariable> ;
                                                                       <https://w3id.org/tvbo/rhs> "(-gL*(v - EL) + gL*delT*exp((v - VT)/delT) - w + I_ext) / C" ;
