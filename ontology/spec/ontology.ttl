                                                      rdfs:label "NumericalDiscretizationMethod" ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "Numerical discretization method for boundary value problems (periodic orbits, connecting orbits, quasi-periodic tori)." ;
