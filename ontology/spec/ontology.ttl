                                                 rdfs:label "tauInfTransition"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#tauInfTransition> .


###  https://w3id.org/tvbo/neuroml/timedSynapticInput
<https://w3id.org/tvbo/neuroml/timedSynapticInput> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseVoltageDepPointCurrentSpiking> ;
                                                   <http://purl.org/dc/terms/description> "Spike array connected to a single _synapse, producing a current triggered by each _spike_ in the array."@en ;
                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                   rdfs:label "timedSynapticInput"@en ;
