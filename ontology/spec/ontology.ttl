<https://w3id.org/tvbo/models/Ueda/state_variables/x> rdf:type owl:NamedIndividual ,
                                                               <https://w3id.org/tvbo/StateVariable> ;
                                                      <https://w3id.org/tvbo/lhs> "Derivative(x, t)" ;
                                                      <https://w3id.org/tvbo/rhs> "v" ;
                                                      rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                      rdfs:label "x (Ueda state variable)" ;
                                                      <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/models/UlamRing4/parameters/eps
<https://w3id.org/tvbo/models/UlamRing4/parameters/eps> rdf:type owl:NamedIndividual ,
                                                                 <https://w3id.org/tvbo/Parameter> ;
                                                        <http://purl.org/dc/terms/description> "Unidirectional coupling ε on a 4-node ring." ;
                                                        <http://schema.org/defaultValue> "0.6"^^xsd:double ;
                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                        rdfs:label "eps (UlamRing4 parameter)" ;
                                                        <http://www.w3.org/2004/02/skos/core#notation> "eps" .


###  https://w3id.org/tvbo/models/UlamRing4/state_variables/x0
<https://w3id.org/tvbo/models/UlamRing4/state_variables/x0> rdf:type owl:NamedIndividual ,
                                                                     <https://w3id.org/tvbo/StateVariable> ;
                                                            <https://w3id.org/tvbo/lhs> "x0_next" ;
                                                            <https://w3id.org/tvbo/rhs> "2 - (eps*x3 + (1 - eps)*x0)**2" ;
                                                            rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                            rdfs:label "x0 (UlamRing4 state variable)" ;
                                                            <http://www.w3.org/2004/02/skos/core#notation> "x0" .


###  https://w3id.org/tvbo/models/UlamRing4/state_variables/x1
<https://w3id.org/tvbo/models/UlamRing4/state_variables/x1> rdf:type owl:NamedIndividual ,
                                                                     <https://w3id.org/tvbo/StateVariable> ;
                                                            <https://w3id.org/tvbo/lhs> "x1_next" ;
                                                            <https://w3id.org/tvbo/rhs> "2 - (eps*x0 + (1 - eps)*x1)**2" ;
                                                            rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                            rdfs:label "x1 (UlamRing4 state variable)" ;
                                                            <http://www.w3.org/2004/02/skos/core#notation> "x1" .


###  https://w3id.org/tvbo/models/UlamRing4/state_variables/x2
<https://w3id.org/tvbo/models/UlamRing4/state_variables/x2> rdf:type owl:NamedIndividual ,
                                                                     <https://w3id.org/tvbo/StateVariable> ;
                                                            <https://w3id.org/tvbo/lhs> "x2_next" ;
                                                            <https://w3id.org/tvbo/rhs> "2 - (eps*x1 + (1 - eps)*x2)**2" ;
                                                            rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                            rdfs:label "x2 (UlamRing4 state variable)" ;
                                                            <http://www.w3.org/2004/02/skos/core#notation> "x2" .


###  https://w3id.org/tvbo/models/UlamRing4/state_variables/x3
<https://w3id.org/tvbo/models/UlamRing4/state_variables/x3> rdf:type owl:NamedIndividual ,
                                                                     <https://w3id.org/tvbo/StateVariable> ;
                                                            <https://w3id.org/tvbo/lhs> "x3_next" ;
                                                            <https://w3id.org/tvbo/rhs> "2 - (eps*x2 + (1 - eps)*x3)**2" ;
                                                            rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                            rdfs:label "x3 (UlamRing4 state variable)" ;
                                                            <http://www.w3.org/2004/02/skos/core#notation> "x3" .


