<https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normA> rdf:type owl:NamedIndividual ,
                                                                                <https://w3id.org/tvbo/DerivedVariable> ;
                                                                       <https://w3id.org/tvbo/lhs> "normA" ;
                                                                       <https://w3id.org/tvbo/rhs> "sqrt(A0**2 + A1**2 + A2**2)" ;
                                                                       rdfs:label "normA (EpileptorCodim3SlowMod derived variable)" ;
                                                                       <http://www.w3.org/2004/02/skos/core#notation> "normA" .


###  https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normF
<https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normF> rdf:type owl:NamedIndividual ,
                                                                                <https://w3id.org/tvbo/DerivedVariable> ;
                                                                       <https://w3id.org/tvbo/lhs> "normF" ;
                                                                       <https://w3id.org/tvbo/rhs> "sqrt(Fx0**2 + Fx1**2 + Fx2**2)" ;
                                                                       rdfs:label "normF (EpileptorCodim3SlowMod derived variable)" ;
                                                                       <http://www.w3.org/2004/02/skos/core#notation> "normF" .


###  https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/nu
<https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/nu> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "nu" ;
                                                                    <https://w3id.org/tvbo/rhs> "R*(E2*cos(z) + F2*sin(z))" ;
                                                                    <http://purl.org/dc/terms/description> "Bifurcation parameter nu along the great arc (E, F, R) at slow variable z." ;
                                                                    rdfs:label "nu (EpileptorCodim3SlowMod derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "nu" .


###  https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/sqdisc
<https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/sqdisc> rdf:type owl:NamedIndividual ,
                                                                                 <https://w3id.org/tvbo/DerivedVariable> ;
                                                                        <https://w3id.org/tvbo/lhs> "sqdisc" ;
                                                                        <https://w3id.org/tvbo/rhs> "sqrt(Abs(disc))" ;
                                                                        <http://purl.org/dc/terms/description> "Square root of the absolute discriminant." ;
                                                                        rdfs:label "sqdisc (EpileptorCodim3SlowMod derived variable)" ;
                                                                        <http://www.w3.org/2004/02/skos/core#notation> "sqdisc" .


###  https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/xs
<https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/xs> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "xs" ;
                                                                    <https://w3id.org/tvbo/rhs> "Piecewise((Abs(mu1/2 + sqdisc)**(1/3)*cos(atan2(0, mu1/2 + sqdisc)/3) + Abs(mu1/2 - sqdisc)**(1/3)*cos(atan2(0, mu1/2 - sqdisc)/3), disc >= 0), (sqrt((mu1/2)**2 + sqdisc**2)**(1/3)*cos(atan2(sqdisc, mu1/2)/3) + sqrt((mu1/2)**2 + sqdisc**2)**(1/3)*cos(atan2(-sqdisc, mu1/2)/3), True))" ;
                                                                    <http://purl.org/dc/terms/description> "Real x-coordinate of the resting state, the branch (N = 1) real solution of x_s^3 - mu2 x_s - mu1 = 0 via Cardano's formula, taking the real part of the principal complex cube roots in both the one-real-root (disc >= 0) and three-real-roots (disc < 0) regimes." ;
                                                                    rdfs:label "xs (EpileptorCodim3SlowMod derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "xs" .


###  https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/Ks
