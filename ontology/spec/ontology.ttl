###  https://w3id.org/tvbo/models/Ueda/state_variables/v
<https://w3id.org/tvbo/models/Ueda/state_variables/v> rdf:type owl:NamedIndividual ,
                                                               <https://w3id.org/tvbo/StateVariable> ;
                                                      <https://w3id.org/tvbo/lhs> "Derivative(v, t)" ;
                                                      <https://w3id.org/tvbo/rhs> "B*cos(t) - k*v - x**3" ;
