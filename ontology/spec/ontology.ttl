                                             rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseVoltageDepPointCurrent> ;
                                             <http://purl.org/dc/terms/description> "Voltage clamp. Applies a variable current _i to try to keep parent at _targetVoltage. Not yet fully tested!!! Consider using voltageClampTriple!!"@en ;
                                             rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                             rdfs:label "voltageClamp"@en ;
                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#voltageClamp> ;
                                             <https://w3id.org/tvbo/neuroml/eventPort> "in" ;
                                             <https://w3id.org/tvbo/neuroml/hasParameter> "delay" ,
                                                                                          "duration" ,
                                                                                          "simpleSeriesResistance" ,
                                                                                          "targetVoltage" .


###  https://w3id.org/tvbo/neuroml/voltageClampTriple
<https://w3id.org/tvbo/neuroml/voltageClampTriple> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseVoltageDepPointCurrent> ;
                                                   <http://purl.org/dc/terms/description> "Voltage clamp with 3 clamp levels. Applies a variable current _i (through _simpleSeriesResistance) to try to keep parent cell at _conditioningVoltage until time _delay, _testingVoltage until _delay + _duration, and _returnVoltage afterwards. Only enabled if _active = 1. "@en ;
                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                   rdfs:label "voltageClampTriple"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#voltageClampTriple> ;
                                                   <https://w3id.org/tvbo/neuroml/eventPort> "in" ;
                                                   <https://w3id.org/tvbo/neuroml/hasParameter> "active" ,
                                                                                                "conditioningVoltage" ,
                                                                                                "delay" ,
                                                                                                "duration" ,
                                                                                                "returnVoltage" ,
                                                                                                "simpleSeriesResistance" ,
                                                                                                "testingVoltage" .


###  https://w3id.org/tvbo/neuroml/voltageConcDepBlockMechanism
<https://w3id.org/tvbo/neuroml/voltageConcDepBlockMechanism> rdf:type owl:Class ;
                                                             rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseBlockMechanism> ;
                                                             <http://purl.org/dc/terms/description> "Synaptic blocking mechanism which varys with membrane potential across the synapse, e.g. in NMDA receptor mediated synapses"@en ;
