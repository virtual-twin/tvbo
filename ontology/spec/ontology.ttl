<https://w3id.org/tvbo/neuroml/channelDensityNonUniformGHK> rdf:type owl:Class ;
                                                            rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseChannelDensity> ;
                                                            <http://purl.org/dc/terms/description> "Specifies a time varying conductance density, which is distributed on a region of the _cell, and whose current is calculated from the Goldman-Hodgkin-Katz equation. Hard coded for Ca only!. The conductance density of the channel is not uniform, but is set using the _variableParameter_. Note, there is no dynamical description of this in LEMS yet, as this type only makes sense for multicompartmental cells. A ComponentType for this needs to be present to enable export of NeuroML 2 multicompartmental cells via LEMS/jNeuroML to NEURON"@en ;
                                                            rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                            rdfs:label "channelDensityNonUniformGHK"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#channelDensityNonUniformGHK> .


###  https://w3id.org/tvbo/neuroml/channelDensityNonUniformNernst
<https://w3id.org/tvbo/neuroml/channelDensityNonUniformNernst> rdf:type owl:Class ;
                                                               rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseChannelDensity> ;
                                                               <http://purl.org/dc/terms/description> "Specifies a time varying conductance density, which is distributed on a region of the _cell, and whose reversal potential is calculated from the Nernst equation. Hard coded for Ca only!. The conductance density of the channel is not uniform, but is set using the _variableParameter_. Note, there is no dynamical description of this in LEMS yet, as this type only makes sense for multicompartmental cells. A ComponentType for this needs to be present to enable export of NeuroML 2 multicompartmental cells via LEMS/jNeuroML to NEURON"@en ;
                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                               rdfs:label "channelDensityNonUniformNernst"@en ;
                                                               <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#channelDensityNonUniformNernst> .


###  https://w3id.org/tvbo/neuroml/channelDensityVShift
<https://w3id.org/tvbo/neuroml/channelDensityVShift> rdf:type owl:Class ;
                                                     rdfs:subClassOf <https://w3id.org/tvbo/neuroml/channelDensity> ;
                                                     <http://purl.org/dc/terms/description> "Same as _channelDensity_, but with a _vShift parameter to change voltage activation of gates. The exact usage of _vShift in expressions for rates is determined by the individual gates."@en ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                     rdfs:label "channelDensityVShift"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#channelDensityVShift> ;
                                                     <https://w3id.org/tvbo/neuroml/hasParameter> "vShift" .


###  https://w3id.org/tvbo/neuroml/channelPopulation
<https://w3id.org/tvbo/neuroml/channelPopulation> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseChannelPopulation> ;
                                                  <http://purl.org/dc/terms/description> "Population of a _number of ohmic ion channels. These each produce a conductance _channelg across a reversal potential _erev, giving a total current _i. Note that active membrane currents are more frequently specified as a density over an area of the _cell_ using _channelDensity_"@en ;
                                                  rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                  rdfs:label "channelPopulation"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#channelPopulation> ;
                                                  <https://w3id.org/tvbo/neuroml/hasParameter> "erev" ,
                                                                                               "number" .


###  https://w3id.org/tvbo/neuroml/channelPopulationNernst
<https://w3id.org/tvbo/neuroml/channelPopulationNernst> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://w3id.org/tvbo/neuroml/baseChannelPopulation> ;
                                                        <http://purl.org/dc/terms/description> "Population of a _number of channels with a time varying reversal potential _erev determined by Nernst equation. Note: hard coded for Ca only!"@en ;
                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                        rdfs:label "channelPopulationNernst"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#channelPopulationNernst> ;
                                                        <https://w3id.org/tvbo/neuroml/exposes> "erev" ;
                                                        <https://w3id.org/tvbo/neuroml/hasParameter> "number" ;
                                                        <https://w3id.org/tvbo/neuroml/requires> "caConc" ,
                                                                                                 "caConcExt" ,
                                                                                                 "temperature" .


###  https://w3id.org/tvbo/neuroml/closedState
<https://w3id.org/tvbo/neuroml/closedState> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/tvbo/neuroml/KSState> ;
                                            <http://purl.org/dc/terms/description> "A _KSState_ with _relativeConductance of 0"@en ;
                                            rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                            rdfs:label "closedState"@en ;
                                            <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#closedState> ;
                                            <https://w3id.org/tvbo/neuroml/hasParameter> "relativeConductance" .


###  https://w3id.org/tvbo/neuroml/compoundInput
<https://w3id.org/tvbo/neuroml/compoundInput> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/tvbo/neuroml/basePointCurrent> ;
                                              <http://purl.org/dc/terms/description> "Generates a current which is the sum of all its child _basePointCurrent_ element, e.g. can be a combination of _pulseGenerator_, _sineGenerator_ elements producing a single _i. Scaled by _weight, if set"@en ;
                                              rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                              rdfs:label "compoundInput"@en ;
                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#compoundInput> ;
                                              <https://w3id.org/tvbo/neuroml/eventPort> "in" .


###  https://w3id.org/tvbo/neuroml/compoundInputDL
<https://w3id.org/tvbo/neuroml/compoundInputDL> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://w3id.org/tvbo/neuroml/basePointCurrentDL> ;
                                                <http://purl.org/dc/terms/description> "Generates a current which is the sum of all its child _basePointCurrentDL_ elements, e.g. can be a combination of _pulseGeneratorDL_, _sineGeneratorDL_ elements producing a single _i. Scaled by _weight, if set"@en ;
                                                rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                rdfs:label "compoundInputDL"@en ;
                                                <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#compoundInputDL> ;
                                                <https://w3id.org/tvbo/neuroml/eventPort> "in" .


###  https://w3id.org/tvbo/neuroml/concentrationModel
<https://w3id.org/tvbo/neuroml/concentrationModel> rdf:type owl:Class ;
                                                   rdfs:subClassOf owl:Thing ;
                                                   <http://purl.org/dc/terms/description> "Base for any model of an _ion concentration which changes with time. Internal (_concentration) and external (_extConcentration) values for the concentration of the ion are given."@en ;
                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                   rdfs:label "concentrationModel"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#concentrationModel> ;
                                                   <https://w3id.org/tvbo/neuroml/exposes> "concentration" ,
                                                                                           "extConcentration" ;
                                                   <https://w3id.org/tvbo/neuroml/requires> "initialConcentration" ,
                                                                                            "initialExtConcentration" ,
                                                                                            "surfaceArea" .


###  https://w3id.org/tvbo/neuroml/connection
<https://w3id.org/tvbo/neuroml/connection> rdf:type owl:Class ;
                                           rdfs:subClassOf owl:Thing ;
                                           <http://purl.org/dc/terms/description> "Event connection directly between named components, which gets processed via a new instance of a _synapse component which is created on the target component. Normally contained inside a _projection_ element."@en ;
                                           rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                           rdfs:label "connection"@en ;
                                           <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#connection> .


###  https://w3id.org/tvbo/neuroml/connectionWD
<https://w3id.org/tvbo/neuroml/connectionWD> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/tvbo/neuroml/connection> ;
                                             <http://purl.org/dc/terms/description> "Event connection between named components, which gets processed via a new instance of a synapse component which is created on the target component, includes setting of _weight and _delay for the synaptic connection"@en ;
                                             rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                             rdfs:label "connectionWD"@en ;
                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#connectionWD> ;
                                             <https://w3id.org/tvbo/neuroml/hasParameter> "delay" ,
                                                                                          "weight" .


###  https://w3id.org/tvbo/neuroml/continuousConnection
<https://w3id.org/tvbo/neuroml/continuousConnection> rdf:type owl:Class ;
                                                     rdfs:subClassOf owl:Thing ;
                                                     <http://purl.org/dc/terms/description> "An instance of a connection in a _continuousProjection_ between _presynapticPopulation to another _postsynapticPopulation through a _preComponent at the start and _postComponent at the end. Can be used for analog synapses."@en ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                     rdfs:label "continuousConnection"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#continuousConnection> .


###  https://w3id.org/tvbo/neuroml/continuousConnectionInstance
<https://w3id.org/tvbo/neuroml/continuousConnectionInstance> rdf:type owl:Class ;
                                                             rdfs:subClassOf owl:Thing ;
                                                             <http://purl.org/dc/terms/description> "An instance of a connection in a _continuousProjection_ between _presynapticPopulation to another _postsynapticPopulation through a _preComponent at the start and _postComponent at the end. Populations need to be of type _populationList_ and contain _instance_ and _location_ elements. Can be used for analog synapses."@en ;
                                                             rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                             rdfs:label "continuousConnectionInstance"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#continuousConnectionInstance> .


###  https://w3id.org/tvbo/neuroml/continuousConnectionInstanceW
<https://w3id.org/tvbo/neuroml/continuousConnectionInstanceW> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://w3id.org/tvbo/neuroml/continuousConnectionInstance> ;
                                                              <http://purl.org/dc/terms/description> "An instance of a connection in a _continuousProjection_ between _presynapticPopulation to another _postsynapticPopulation through a _preComponent at the start and _postComponent at the end. Populations need to be of type _populationList_ and contain _instance_ and _location_ elements. Can be used for analog synapses. Includes setting of _weight for the connection"@en ;
                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                              rdfs:label "continuousConnectionInstanceW"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#continuousConnectionInstanceW> ;
                                                              <https://w3id.org/tvbo/neuroml/hasParameter> "weight" .


###  https://w3id.org/tvbo/neuroml/continuousProjection
<https://w3id.org/tvbo/neuroml/continuousProjection> rdf:type owl:Class ;
                                                     rdfs:subClassOf owl:Thing ;
                                                     <http://purl.org/dc/terms/description> "A projection between _presynapticPopulation and _postsynapticPopulation through components _preComponent at the start and _postComponent at the end of a _continuousConnection_ or _continuousConnectionInstance_. Can be used for analog synapses."@en ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                     rdfs:label "continuousProjection"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#continuousProjection> .


###  https://w3id.org/tvbo/neuroml/decayingPoolConcentrationModel
<https://w3id.org/tvbo/neuroml/decayingPoolConcentrationModel> rdf:type owl:Class ;
                                                               rdfs:subClassOf <https://w3id.org/tvbo/neuroml/concentrationModel> ;
                                                               <http://purl.org/dc/terms/description> "Model of an intracellular buffering mechanism for _ion (currently hard Coded to be calcium, due to requirement for _iCa) which has a baseline level _restingConc and tends to this value with time course _decayConstant. The ion is assumed to occupy a shell inside the membrane of thickness _shellThickness."@en ;
                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                                               rdfs:label "decayingPoolConcentrationModel"@en ;
                                                               <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#decayingPoolConcentrationModel> ;
                                                               <https://w3id.org/tvbo/neuroml/hasParameter> "decayConstant" ,
                                                                                                            "restingConc" ,
                                                                                                            "shellThickness" ;
                                                               <https://w3id.org/tvbo/neuroml/requires> "iCa" .


###  https://w3id.org/tvbo/neuroml/distal
<https://w3id.org/tvbo/neuroml/distal> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/tvbo/neuroml/point3DWithDiam> ;
                                       <http://purl.org/dc/terms/description> "Point on a _segment_ furthest from the soma. Should always be present in the description of a _segment_, unlike _proximal_"@en ;
                                       rdfs:isDefinedBy <https://w3id.org/tvbo/neuroml> ;
                                       rdfs:label "distal"@en ;
                                       <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#distal> .


