                                                         owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                       ] ;
                                       rdfs:isDefinedBy <https://w3id.org/tvbo/struct> ;
                                       rdfs:label "WorkflowConfig" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Declarative orchestration for rendering a parameter sweep into a distributed, reproducible workflow (Slurm array, Snakemake, Nextflow). Backend- and engine-independent: it names *what* to distribute, *where* results go, and the per-engine resources, while each engine emitter renders the concrete artefact. Declared on a study as ``workflow`` and refined per experiment via ``workflow_overrides``; unset fields fall back to the emitter's defaults so an override sets only what it names." ;
                                       <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/tvbo/WorkflowConfig> ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> .


###  https://w3id.org/tvbo/WorkflowDistributeBy
<https://w3id.org/tvbo/WorkflowDistributeBy> rdf:type owl:Class ;
                                             owl:equivalentClass [ rdf:type owl:Class ;
                                                                   owl:unionOf ( <https://w3id.org/tvbo/WorkflowDistributeBy#auto>
                                                                                 <https://w3id.org/tvbo/WorkflowDistributeBy#vectorize>
                                                                                 <https://w3id.org/tvbo/WorkflowDistributeBy#workflow>
                                                                               )
                                                                 ] ;
                                             rdfs:subClassOf owl:Thing ;
                                             rdfs:isDefinedBy <https://w3id.org/tvbo/struct> ;
                                             rdfs:label "WorkflowDistributeBy" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Default tier a sweep axis is placed on when it is not named explicitly in a DistributionConfig. Vectorized axes are packed into one batched backend call; workflow axes are fanned out into independent scheduler tasks." ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
                                             <https://w3id.org/linkml/permissible_values> <https://w3id.org/tvbo/WorkflowDistributeBy#auto> ,
                                                                                          <https://w3id.org/tvbo/WorkflowDistributeBy#vectorize> ,
                                                                                          <https://w3id.org/tvbo/WorkflowDistributeBy#workflow> .


