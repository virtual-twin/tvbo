                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                               rdfs:label "priors (slot)" ;
                               <http://www.w3.org/2004/02/skos/core#definition> "Priors over the inferred parameters, keyed by each parameter's dotted name (e.g. \"Generic2dOscillator.eta\" or \"PulseInput.amplitude\"). The KEYS are the inferred parameters — there is no separate free-parameter list." ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/tvbo> ;
