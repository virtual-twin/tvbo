###  https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/E0
<https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/E0> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "E0" ;
                                                                    <https://w3id.org/tvbo/rhs> "mu2_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)" ;
