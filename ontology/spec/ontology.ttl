                                                                          rdfs:label "a (SprottDissipativeConservative parameter)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "a" .


###  https://w3id.org/tvbo/models/SprottDissipativeConservative/parameters/b
<https://w3id.org/tvbo/models/SprottDissipativeConservative/parameters/b> rdf:type owl:NamedIndividual ,
                                                                                   <https://w3id.org/tvbo/Parameter> ;
                                                                          <http://purl.org/dc/terms/description> "yz coupling coefficient b." ;
                                                                          <http://schema.org/defaultValue> "1.0"^^xsd:double ;
                                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                          rdfs:label "b (SprottDissipativeConservative parameter)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "b" .


###  https://w3id.org/tvbo/models/SprottDissipativeConservative/parameters/c
<https://w3id.org/tvbo/models/SprottDissipativeConservative/parameters/c> rdf:type owl:NamedIndividual ,
                                                                                   <https://w3id.org/tvbo/Parameter> ;
                                                                          <http://purl.org/dc/terms/description> "Linear term coefficient c in z equation." ;
                                                                          <http://schema.org/defaultValue> "1.0"^^xsd:double ;
                                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                          rdfs:label "c (SprottDissipativeConservative parameter)" ;
                                                                          <http://www.w3.org/2004/02/skos/core#notation> "c" .


###  https://w3id.org/tvbo/models/SprottDissipativeConservative/state_variables/x
<https://w3id.org/tvbo/models/SprottDissipativeConservative/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                                        <https://w3id.org/tvbo/StateVariable> ;
                                                                               <https://w3id.org/tvbo/lhs> "Derivative(x, t)" ;
                                                                               <https://w3id.org/tvbo/rhs> "y + a*x*y + x*z" ;
                                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                               rdfs:label "x (SprottDissipativeConservative state variable)" ;
                                                                               <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/models/SprottDissipativeConservative/state_variables/y
<https://w3id.org/tvbo/models/SprottDissipativeConservative/state_variables/y> rdf:type owl:NamedIndividual ,
                                                                                        <https://w3id.org/tvbo/StateVariable> ;
                                                                               <https://w3id.org/tvbo/lhs> "Derivative(y, t)" ;
                                                                               <https://w3id.org/tvbo/rhs> "1 - 2*x**2 + b*y*z" ;
                                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                               rdfs:label "y (SprottDissipativeConservative state variable)" ;
                                                                               <http://www.w3.org/2004/02/skos/core#notation> "y" .


###  https://w3id.org/tvbo/models/SprottDissipativeConservative/state_variables/z
<https://w3id.org/tvbo/models/SprottDissipativeConservative/state_variables/z> rdf:type owl:NamedIndividual ,
                                                                                        <https://w3id.org/tvbo/StateVariable> ;
                                                                               <https://w3id.org/tvbo/lhs> "Derivative(z, t)" ;
                                                                               <https://w3id.org/tvbo/rhs> "c*x - x**2 - y**2" ;
                                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                               rdfs:label "z (SprottDissipativeConservative state variable)" ;
                                                                               <http://www.w3.org/2004/02/skos/core#notation> "z" .


