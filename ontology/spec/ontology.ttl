<https://w3id.org/tvbo/models/Lorenz84/parameters/G> rdf:type owl:NamedIndividual ,
                                                              <https://w3id.org/tvbo/Parameter> ;
                                                     <http://purl.org/dc/terms/description> "Annual cycle modulation G." ;
                                                     <http://schema.org/defaultValue> "1.287"^^xsd:double ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                     rdfs:label "G (Lorenz84 parameter)" ;
                                                     <http://www.w3.org/2004/02/skos/core#notation> "G" .


###  https://w3id.org/tvbo/models/Lorenz84/parameters/a
<https://w3id.org/tvbo/models/Lorenz84/parameters/a> rdf:type owl:NamedIndividual ,
                                                              <https://w3id.org/tvbo/Parameter> ;
                                                     <http://purl.org/dc/terms/description> "Linear damping parameter a." ;
                                                     <http://schema.org/defaultValue> "0.25"^^xsd:double ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                     rdfs:label "a (Lorenz84 parameter)" ;
                                                     <http://www.w3.org/2004/02/skos/core#notation> "a" .


###  https://w3id.org/tvbo/models/Lorenz84/parameters/b
<https://w3id.org/tvbo/models/Lorenz84/parameters/b> rdf:type owl:NamedIndividual ,
                                                              <https://w3id.org/tvbo/Parameter> ;
                                                     <http://purl.org/dc/terms/description> "Coupling parameter b." ;
                                                     <http://schema.org/defaultValue> "4.0"^^xsd:double ;
                                                     rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                     rdfs:label "b (Lorenz84 parameter)" ;
                                                     <http://www.w3.org/2004/02/skos/core#notation> "b" .


###  https://w3id.org/tvbo/models/Lorenz84/state_variables/x
<https://w3id.org/tvbo/models/Lorenz84/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(x, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "-y**2 - z**2 - a*x + a*F" ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "x (Lorenz84 state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/models/Lorenz84/state_variables/y
<https://w3id.org/tvbo/models/Lorenz84/state_variables/y> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(y, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "x*y - y - b*x*z + G" ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "y (Lorenz84 state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "y" .


###  https://w3id.org/tvbo/models/Lorenz84/state_variables/z
<https://w3id.org/tvbo/models/Lorenz84/state_variables/z> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/tvbo/StateVariable> ;
                                                          <https://w3id.org/tvbo/lhs> "Derivative(z, t)" ;
                                                          <https://w3id.org/tvbo/rhs> "b*x*y + x*z - z" ;
                                                          rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                          rdfs:label "z (Lorenz84 state variable)" ;
                                                          <http://www.w3.org/2004/02/skos/core#notation> "z" .


###  https://w3id.org/tvbo/models/Lorenz96/parameters/F
<https://w3id.org/tvbo/models/Lorenz96/parameters/F> rdf:type owl:NamedIndividual ,
                                                              <https://w3id.org/tvbo/Parameter> ;
                                                     <http://purl.org/dc/terms/description> "Constant large-scale forcing." ;
