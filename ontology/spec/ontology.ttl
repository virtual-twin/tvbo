###  https://w3id.org/tvbo/models/Epileptor/parameters/x0
<https://w3id.org/tvbo/models/Epileptor/parameters/x0> rdf:type owl:NamedIndividual ,
                                                                <https://w3id.org/tvbo/Parameter> ;
                                                       <http://purl.org/dc/terms/description> "Epileptogenicity parameter." ;
                                                       <http://schema.org/defaultValue> "-1.6"^^xsd:double ;
                                                       rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                       rdfs:label "x0 (Epileptor parameter)" ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "Epileptogenicity parameter." ;
                                                       <http://www.w3.org/2004/02/skos/core#notation> "x0" .


###  https://w3id.org/tvbo/models/Epileptor/state_variables/g
<https://w3id.org/tvbo/models/Epileptor/state_variables/g> rdf:type owl:NamedIndividual ,
                                                                    <https://w3id.org/tvbo/StateVariable> ;
                                                           <https://w3id.org/tvbo/lhs> "Derivative(g, t)" ;
                                                           <https://w3id.org/tvbo/rhs> "tt*(-0.01*(g - 0.1*x1))" ;
                                                           <http://purl.org/dc/terms/description> "Lowpass-filtered excitatory coupling variable." ;
                                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                           rdfs:label "g (Epileptor state variable)" ;
                                                           <http://www.w3.org/2004/02/skos/core#notation> "g" .


###  https://w3id.org/tvbo/models/Epileptor/state_variables/x1
<https://w3id.org/tvbo/models/Epileptor/state_variables/x1> rdf:type owl:NamedIndividual ,
                                                                     <https://w3id.org/tvbo/StateVariable> ;
                                                            <https://w3id.org/tvbo/lhs> "Derivative(x1, t)" ;
                                                            <https://w3id.org/tvbo/rhs> "tt*(y1 - z + Iext_total + Kvf*c_glob0 + f1*x1)" ;
                                                            <http://purl.org/dc/terms/description> "First state variable of the first (fast) population." ;
                                                            rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                            rdfs:label "x1 (Epileptor state variable)" ;
                                                            <http://www.w3.org/2004/02/skos/core#notation> "x1" .


###  https://w3id.org/tvbo/models/Epileptor/state_variables/x2
<https://w3id.org/tvbo/models/Epileptor/state_variables/x2> rdf:type owl:NamedIndividual ,
                                                                     <https://w3id.org/tvbo/StateVariable> ;
                                                            <https://w3id.org/tvbo/lhs> "Derivative(x2, t)" ;
                                                            <https://w3id.org/tvbo/rhs> "tt*(-y2 + x2 - x2**3 + Iext2 + bb*g - 0.3*(z - 3.5) + Kf*c_glob1)" ;
                                                            <http://purl.org/dc/terms/description> "First state variable of the second (slow) population." ;
                                                            rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                            rdfs:label "x2 (Epileptor state variable)" ;
                                                            <http://www.w3.org/2004/02/skos/core#notation> "x2" .


###  https://w3id.org/tvbo/models/Epileptor/state_variables/y1
<https://w3id.org/tvbo/models/Epileptor/state_variables/y1> rdf:type owl:NamedIndividual ,
                                                                     <https://w3id.org/tvbo/StateVariable> ;
                                                            <https://w3id.org/tvbo/lhs> "Derivative(y1, t)" ;
                                                            <https://w3id.org/tvbo/rhs> "tt*(c - d*x1**2 - y1)" ;
                                                            <http://purl.org/dc/terms/description> "Second state variable of the first (fast) population." ;
                                                            rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                            rdfs:label "y1 (Epileptor state variable)" ;
                                                            <http://www.w3.org/2004/02/skos/core#notation> "y1" .


###  https://w3id.org/tvbo/models/Epileptor/state_variables/y2
<https://w3id.org/tvbo/models/Epileptor/state_variables/y2> rdf:type owl:NamedIndividual ,
                                                                     <https://w3id.org/tvbo/StateVariable> ;
                                                            <https://w3id.org/tvbo/lhs> "Derivative(y2, t)" ;
                                                            <https://w3id.org/tvbo/rhs> "tt*(-y2 + f2)/tau" ;
                                                            <http://purl.org/dc/terms/description> "Second state variable of the second (slow) population." ;
                                                            rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                            rdfs:label "y2 (Epileptor state variable)" ;
                                                            <http://www.w3.org/2004/02/skos/core#notation> "y2" .


###  https://w3id.org/tvbo/models/Epileptor/state_variables/z
<https://w3id.org/tvbo/models/Epileptor/state_variables/z> rdf:type owl:NamedIndividual ,
                                                                    <https://w3id.org/tvbo/StateVariable> ;
                                                           <https://w3id.org/tvbo/lhs> "Derivative(z, t)" ;
                                                           <https://w3id.org/tvbo/rhs> "tt*r*(h - z + Ks*c_glob0)" ;
                                                           <http://purl.org/dc/terms/description> "Slow permittivity (energy) state variable." ;
                                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                           rdfs:label "z (Epileptor state variable)" ;
                                                           <http://www.w3.org/2004/02/skos/core#notation> "z" .


###  https://w3id.org/tvbo/models/Epileptor2D/derived_variables/h
<https://w3id.org/tvbo/models/Epileptor2D/derived_variables/h> rdf:type owl:NamedIndividual ,
                                                                        <https://w3id.org/tvbo/DerivedVariable> ;
                                                               <https://w3id.org/tvbo/lhs> "h" ;
                                                               <https://w3id.org/tvbo/rhs> "Piecewise((x0 + 3.0/(exp((-x1 - 1*0.5)/0.1) + 1.0), modification > 0), (zcond + 4*(-x0 + x1), True))" ;
                                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                               rdfs:label "h (Epileptor2D derived variable)" ;
                                                               <http://www.w3.org/2004/02/skos/core#notation> "h" .


###  https://w3id.org/tvbo/models/Epileptor2D/derived_variables/x1cond
<https://w3id.org/tvbo/models/Epileptor2D/derived_variables/x1cond> rdf:type owl:NamedIndividual ,
                                                                             <https://w3id.org/tvbo/DerivedVariable> ;
                                                                    <https://w3id.org/tvbo/lhs> "x1cond" ;
                                                                    <https://w3id.org/tvbo/rhs> "Piecewise((a*x1**2 + x1*(-b + d), x1 < 0), (d*x1 - slope - 0.6*(z - 4.0)**2, True))" ;
                                                                    rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                    rdfs:label "x1cond (Epileptor2D derived variable)" ;
                                                                    <http://www.w3.org/2004/02/skos/core#notation> "x1cond" .


###  https://w3id.org/tvbo/models/Epileptor2D/derived_variables/zcond
<https://w3id.org/tvbo/models/Epileptor2D/derived_variables/zcond> rdf:type owl:NamedIndividual ,
                                                                            <https://w3id.org/tvbo/DerivedVariable> ;
                                                                   <https://w3id.org/tvbo/lhs> "zcond" ;
                                                                   <https://w3id.org/tvbo/rhs> "Piecewise((-0.1*z**7, z < 0), (0, True))" ;
                                                                   rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                   rdfs:label "zcond (Epileptor2D derived variable)" ;
                                                                   <http://www.w3.org/2004/02/skos/core#notation> "zcond" .


