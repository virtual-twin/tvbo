                                              rdfs:label "rampGenerator"@en ;
                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#rampGenerator> ;
                                              <https://w3id.org/tvbo/neuroml/eventPort> "in" ;
                                              <https://w3id.org/tvbo/neuroml/hasParameter> "baselineAmplitude" ,
                                                                                           "delay" ,
                                                                                           "duration" ,
                                                                                           "finishAmplitude" ,
                                                                                           "startAmplitude" .


