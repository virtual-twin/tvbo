                                                                         rdfs:label "uB (EpileptorCodim3SlowMod state variable)" ;
                                                                         <http://www.w3.org/2004/02/skos/core#notation> "uB" .


###  https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/x
<https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                                 <https://w3id.org/tvbo/StateVariable> ;
                                                                        <https://w3id.org/tvbo/lhs> "Derivative(x, t)" ;
                                                                        <https://w3id.org/tvbo/rhs> "-y" ;
                                                                        <http://purl.org/dc/terms/description> "Fast-subsystem state variable x (membrane-potential-like)." ;
                                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                        rdfs:label "x (EpileptorCodim3SlowMod state variable)" ;
                                                                        <http://www.w3.org/2004/02/skos/core#notation> "x" .


###  https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/y
<https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/y> rdf:type owl:NamedIndividual ,
                                                                                 <https://w3id.org/tvbo/StateVariable> ;
                                                                        <https://w3id.org/tvbo/lhs> "Derivative(y, t)" ;
                                                                        <https://w3id.org/tvbo/rhs> "x**3 - mu2*x - mu1 - y*(nu + b*x + x**2)" ;
                                                                        <http://purl.org/dc/terms/description> "Fast-subsystem state variable y." ;
                                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                        rdfs:label "y (EpileptorCodim3SlowMod state variable)" ;
                                                                        <http://www.w3.org/2004/02/skos/core#notation> "y" .


###  https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/z
<https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/z> rdf:type owl:NamedIndividual ,
                                                                                 <https://w3id.org/tvbo/StateVariable> ;
                                                                        <https://w3id.org/tvbo/lhs> "Derivative(z, t)" ;
                                                                        <https://w3id.org/tvbo/rhs> "-c*(sqrt((x - xs)**2 + y**2) - dstar + Piecewise(((z - 1/2)**7/10, modification > 0), (0, True)) + Ks*c_glob)" ;
                                                                        <http://purl.org/dc/terms/description> "Slow-subsystem permittivity variable z." ;
                                                                        rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                        rdfs:label "z (EpileptorCodim3SlowMod state variable)" ;
                                                                        <http://www.w3.org/2004/02/skos/core#notation> "z" .


###  https://w3id.org/tvbo/models/EpileptorRestingState/derived_variables/lc_1
<https://w3id.org/tvbo/models/EpileptorRestingState/derived_variables/lc_1> rdf:type owl:NamedIndividual ,
                                                                                     <https://w3id.org/tvbo/DerivedVariable> ;
                                                                            <https://w3id.org/tvbo/lhs> "lc_1" ;
                                                                            <https://w3id.org/tvbo/rhs> "local_coupling*x_rs" ;
                                                                            rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                            rdfs:label "lc_1 (EpileptorRestingState derived variable)" ;
                                                                            <http://www.w3.org/2004/02/skos/core#notation> "lc_1" .


###  https://w3id.org/tvbo/models/EpileptorRestingState/derived_variables/output
<https://w3id.org/tvbo/models/EpileptorRestingState/derived_variables/output> rdf:type owl:NamedIndividual ,
                                                                                       <https://w3id.org/tvbo/DerivedVariable> ;
                                                                              <https://w3id.org/tvbo/lhs> "output" ;
                                                                              <https://w3id.org/tvbo/rhs> "p*(-x1 + x2) + x_rs*(1 - p)" ;
                                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                              rdfs:label "output (EpileptorRestingState derived variable)" ;
                                                                              <http://www.w3.org/2004/02/skos/core#notation> "output" .


###  https://w3id.org/tvbo/models/EpileptorRestingState/derived_variables/x1cond
<https://w3id.org/tvbo/models/EpileptorRestingState/derived_variables/x1cond> rdf:type owl:NamedIndividual ,
                                                                                       <https://w3id.org/tvbo/DerivedVariable> ;
                                                                              <https://w3id.org/tvbo/lhs> "x1cond" ;
                                                                              <https://w3id.org/tvbo/rhs> "Piecewise(((-a)*x1**2 + b*x1, x1 < 0), (slope - x2 + 0.6*(z - 4.0)**2, True))" ;
                                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                              rdfs:label "x1cond (EpileptorRestingState derived variable)" ;
                                                                              <http://www.w3.org/2004/02/skos/core#notation> "x1cond" .


###  https://w3id.org/tvbo/models/EpileptorRestingState/derived_variables/y2cond
<https://w3id.org/tvbo/models/EpileptorRestingState/derived_variables/y2cond> rdf:type owl:NamedIndividual ,
                                                                                       <https://w3id.org/tvbo/DerivedVariable> ;
                                                                              <https://w3id.org/tvbo/lhs> "y2cond" ;
                                                                              <https://w3id.org/tvbo/rhs> "Piecewise((0.0, x2 < -0.25), (aa*(x2 + 0.25), True))" ;
                                                                              rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                              rdfs:label "y2cond (EpileptorRestingState derived variable)" ;
                                                                              <http://www.w3.org/2004/02/skos/core#notation> "y2cond" .


###  https://w3id.org/tvbo/models/EpileptorRestingState/derived_variables/zcond
<https://w3id.org/tvbo/models/EpileptorRestingState/derived_variables/zcond> rdf:type owl:NamedIndividual ,
                                                                                      <https://w3id.org/tvbo/DerivedVariable> ;
                                                                             <https://w3id.org/tvbo/lhs> "zcond" ;
                                                                             <https://w3id.org/tvbo/rhs> "Piecewise((-0.1*z**7, z < 0), (0.0, True))" ;
                                                                             rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                                                             rdfs:label "zcond (EpileptorRestingState derived variable)" ;
                                                                             <http://www.w3.org/2004/02/skos/core#notation> "zcond" .


