<https://w3id.org/tvbo/models/VanDerPolForced/state_variables/x> rdf:type owl:NamedIndividual ,
                                                                          <https://w3id.org/tvbo/StateVariable> ;
                                                                 <https://w3id.org/tvbo/lhs> "Derivative(x, t)" ;
                                                                 <https://w3id.org/tvbo/rhs> "y" ;
                                                                 <http://purl.org/dc/terms/description> "Position variable." ;
