<https://w3id.org/tvbo/neuroml/populationList> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/tvbo/neuroml/basePopulation> ;
                                               <http://purl.org/dc/terms/description> "An explicit list of _instance_s (with _location_s) of components in the population. "@en ;
                                               rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                               rdfs:label "populationList"@en ;
                                               <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#populationList> .


###  https://w3id.org/tvbo/neuroml/projection
<https://w3id.org/tvbo/neuroml/projection> rdf:type owl:Class ;
                                           rdfs:subClassOf owl:Thing ;
                                           <http://purl.org/dc/terms/description> "Projection from one population, _presynapticPopulation to another, _postsynapticPopulation, through _synapse. Contains lists of _connection_ or _connectionWD_ elements."@en ;
                                           rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                           rdfs:label "projection"@en ;
                                           <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#projection> .


###  https://w3id.org/tvbo/neuroml/proximal
<https://w3id.org/tvbo/neuroml/proximal> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/tvbo/neuroml/point3DWithDiam> ;
                                         <http://purl.org/dc/terms/description> "Point on a _segment_ closest to the soma. Note, the proximal point can be omitted, and in this case is defined as being the point _fractionAlong between the proximal and _distal_ point of the _parent_, i.e. if _fractionAlong = 1 (as it is by default) it will be the _distal on the parent, or if _fractionAlong = 0, it will be the proximal point. If between 0 and 1, it is the linear interpolation between the two points."@en ;
                                         rdfs:isDefinedBy <https://w3id.org/tvbo/tvbo.owl> ;
                                         rdfs:label "proximal"@en ;
                                         <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.neuroml.org/schema/neuroml2#proximal> .


