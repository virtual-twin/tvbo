    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ZaslavskiiMap"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/ZaslavskiiMap/derived_variables/mu"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
