  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Export the full Generic2dOscillator model from the TVBO database as LEMS XML. This model generalises FitzHugh-Nagumo. All 13 parameters, coupling inputs, and 2 state variables (V, W) are exported.\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
