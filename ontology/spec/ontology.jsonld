}, {
  "@id" : "https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/C_ee",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Variance of the excitatory population activity."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "C_ee (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "C_ee"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(C_ee, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(TFe*(1.0/T - TFe)/(N_tot*(1.0 - g)) + (TFe - E)**2 + 2.0*C_ee*dfe_TFe + 2.0*C_ei*dfi_TFe - 2.0*C_ee)/T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/C_ei",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Covariance between the excitatory and inhibitory population activities."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "C_ei (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "C_ei"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(C_ei, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "((TFe - E)*(TFi - I) + C_ee*dfe_TFe + C_ei*dfe_TFi + C_ei*dfi_TFe + C_ii*dfi_TFi - 2.0*C_ei)/T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/C_ii",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Variance of the inhibitory population activity."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "C_ii (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "C_ii"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(C_ii, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(TFi*(1.0/T - TFi)/(N_tot*g) + (TFi - I)**2 + 2.0*C_ii*dfi_TFi + 2.0*C_ei*dfe_TFi - 2.0*C_ii)/T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/E",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Firing rate of the excitatory population [kHz]."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
