  "@id" : "https://w3id.org/tvbo/CohortGrouping",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CohortGrouping"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid616"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "How a cohort rule cuts its candidates into groups along a measure. The values and their meaning are those of ``tvbo.analysis.statistics.group_index``, which a grouped statistic uses too."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/study"
  } ],
  "https://w3id.org/linkml/permissible_values" : [ {
    "@id" : "https://w3id.org/tvbo/CohortGrouping#equal_count"
  }, {
    "@id" : "https://w3id.org/tvbo/CohortGrouping#equal_width"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/CohortGrouping#equal_count",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "equal_count (CohortGrouping)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/CohortGrouping"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Groups of equal size by rank. The candidates are ordered by ascending value, equal values in the candidates' own order, and that order is cut into ``n_groups`` consecutive runs whose sizes differ by at most one, the longer runs first. Equal values can therefore fall into neighbouring groups."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "equal_count"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/CohortGrouping#equal_width",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "equal_width (CohortGrouping)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/CohortGrouping"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Bins of equal width. The range from the smallest to the largest finite value among the candidates is cut into ``n_groups`` intervals of the same width; each is closed below and open above, and the last is closed on both sides, so the largest value belongs to it. Group sizes follow the distribution of the measure and a bin may hold nobody. Refused when all values are equal and more than one group is asked for, since the range then has no width."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "equal_width"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ColorScale",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
