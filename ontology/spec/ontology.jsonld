}, {
  "@id" : "https://w3id.org/tvbo/neuroml/hindmarshRose1984Cell",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "         The Hindmarsh Rose model is a simplified point cell model which         captures complex firing patterns of single neurons, such as         periodic and chaotic bursting. It has a fast spiking subsystem,         which is a generalization of the FitzHugh-Nagumo system, coupled         to a slower subsystem which allows the model to fire bursts. The         dynamical variables x,y,z correspond to the membrane potential, a         recovery variable, and a slower adaptation current, respectively.          See Hindmarsh J. L., and Rose R. M. (1984) A model of neuronal         bursting using three coupled first order differential equations.         Proc. R. Soc. London, Ser. B 221:87–102.         "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hindmarshRose1984Cell"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml/baseCellMembPotCap"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#hindmarshRose1984Cell"
  } ],
  "https://w3id.org/tvbo/neuroml/exposes" : [ {
    "@value" : "chi"
  }, {
    "@value" : "phi"
  }, {
    "@value" : "rho"
  }, {
    "@value" : "spiking"
  }, {
    "@value" : "x"
  }, {
    "@value" : "y"
  }, {
    "@value" : "z"
  } ],
  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "a"
  }, {
    "@value" : "b"
  }, {
    "@value" : "c"
  }, {
    "@value" : "d"
  }, {
    "@value" : "r"
  }, {
    "@value" : "s"
  }, {
    "@value" : "v_scaling"
  }, {
    "@value" : "x0"
  }, {
    "@value" : "x1"
  }, {
    "@value" : "y0"
  }, {
    "@value" : "z0"
  } ]
}, {
