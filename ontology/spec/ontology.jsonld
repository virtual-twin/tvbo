  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/Ks"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/Kvf"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/a"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/b"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/c"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/d"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/modification"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/r"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/slope"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/tt"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/x0"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/state_variables/x1"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Epileptor2D/state_variables/z"
  } ],
  "https://w3id.org/tvbo/hasStochasticityCharacter" : [ {
    "@id" : "https://w3id.org/tvbo/Deterministic"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "phenomenological"
  } ],
  "https://w3id.org/tvbo/modelsAnatomicalRegion" : [ {
    "@id" : "http://purl.obolibrary.org/obo/UBERON_0002728"
  } ],
  "https://w3id.org/tvbo/phaseSpaceDimension" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "2"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor2D/derived_variables/h",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "h (Epileptor2D derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((x0 + 3.0/(exp((-x1 - 1*0.5)/0.1) + 1.0), modification > 0), (zcond + 4*(-x0 + x1), True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor2D/derived_variables/x1cond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x1cond (Epileptor2D derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((a*x1**2 + x1*(-b + d), x1 < 0), (d*x1 - slope - 0.6*(z - 4.0)**2, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor2D/derived_variables/zcond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "zcond (Epileptor2D derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "zcond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "zcond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((-0.1*z**7, z < 0), (0, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/Iext",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "3.1"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Iext (Epileptor2D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al.,2014)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "Iext"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/Ks",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Ks (Epileptor2D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al., 2014).\n\nThe coupling quantifies the influence of neuronal fast discharges x_E2D on the local slow permittivity variable z_E2D."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "Ks"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/Kvf",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Coupling scaling on a very fast time scale"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Kvf (Epileptor2D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Coupling scaling on a very fast time scale."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "Kvf"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor2D/parameters/a",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Coefficient of the cubic term in the first state-variable x_E2D via the function f(x)_E2D, in Epileptor2D Proix et al"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "a (Epileptor2D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Coefficient of the cubic term in the first state-variable x_E2D via the function f(x)_E2D, in Epileptor2D Proix et al.,2014)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "a"
