}, {
  "@id" : "https://w3id.org/tvbo/HemodynamicObservation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An observation model that maps neural activity to a haemodynamic / BOLD signal by causal convolution with a finite-support HRF kernel."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Hemodynamic observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/HemodynamicWarmupRequirement",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Modelling axiom: for any tvbo:HemodynamicObservation, the discarded transient (tvbo:transient_time) MUST be ≥ the observation's HRF kernel duration (tvbo:hrfKernelDuration). Otherwise the causal HRF convolution is under-filled and the BOLD time axis shifts earlier, so the signal spuriously precedes the stimulus rather than lagging it by the hemodynamic delay. Example: the tvboptim BOLD pipeline uses a 20000 ms kernel (5000 samples at dt = 4 ms) via prepend_history + valid-mode convolution, so transient_time ≥ 20000 ms is required."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Hemodynamic warm-up requirement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://w3id.org/tvbo/HemodynamicObservation"
  }, {
    "@id" : "https://w3id.org/tvbo/hrfKernelDuration"
  }, {
    "@id" : "https://w3id.org/tvbo/transient_time"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Hemodynamic warm-up requirement"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Observed empirically (TVB-O acoustic-stimulation use-case, 2026): a 15000 ms transient (< 20000 ms kernel) made auditory BOLD precede the loudness by ~1 s with a mislabelled 1043 ms TR; transient ≥ 20000 ms restored a causal hemodynamic lag (≈ +1.5 s) and the correct 1000 ms TR."
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/HomoclinicBifurcation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Global bifurcation where a limit cycle collides with a saddle equilibrium, forming a homoclinic orbit of infinite period."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Homoclinic"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/Bifurcation"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "hom"
  }, {
    "@value" : "homoclinic"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Hopf",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Andronov-Hopf: an equilibrium loses stability as a complex-conjugate eigenvalue pair crosses the imaginary axis, giving birth to a limit cycle."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Hopf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/Bifurcation"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid1853"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "HB"
  }, {
    "@value" : "andronov hopf"
  }, {
    "@value" : "andronov-hopf"
  }, {
    "@value" : "hb"
  }, {
    "@value" : "hopf"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Hopf"
  } ],
  "https://w3id.org/tvbo/canonicalCode" : [ {
    "@value" : "HB"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/HopfHopf",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Codim-2 point where two Hopf curves cross (two imaginary pairs simultaneously)."
