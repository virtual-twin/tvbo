}, {
  "@id" : "https://w3id.org/tvbo/models/VanDerPolForced",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The forced van der Pol oscillator features nonlinear (amplitude dependent) damping and\nsinusoidal forcing. The unforced system has a unique attracting relaxation cycle; with\nforcing it displays entrainment, quasi-periodicity or chaos depending on parameters."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/vanderpol1926"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
