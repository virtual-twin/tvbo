    "@value" : "target_component (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Component to attach this event to. Can be a node label, edge label, or 'all_edges'/'all_vertices' for broadcast. If not specified, event is experiment-level."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
