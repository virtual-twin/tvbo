  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "y_next"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "b*x"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/HindmarshRose",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Hindmarsh-Rose model reproduces the bursting behavior of a neuron's membrane\npotential, characterized by a fast sequence of spikes followed by a quiescent period.\nThe x variable is the membrane potential; y the fast recovery (ionic current) variable;\nz a slow adaptation current. Parameter sets modulate transitions between quiescence,\ntonic spiking and bursting."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/HindmarshRose1984"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "HindmarshRose"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/HindmarshRose/parameters/I"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HindmarshRose/parameters/a"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HindmarshRose/parameters/b"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HindmarshRose/parameters/c"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HindmarshRose/parameters/d"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HindmarshRose/parameters/r"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HindmarshRose/parameters/s"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HindmarshRose/parameters/xr"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/HindmarshRose/state_variables/x"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HindmarshRose/state_variables/y"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HindmarshRose/state_variables/z"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "spiking"
  } ]
}, {
