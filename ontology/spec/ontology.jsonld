    "@value" : "Scaling parameter of the sigmoid input-output function H_RWW (Deco et al., 2013). \n\nNote:\n------\nIn the original publication, the parameter 'd' is set in second. In TVB, the parameter has been converted in millisecond for setting the system in millisecond."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "d"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "ms"
  } ]
