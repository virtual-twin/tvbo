    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((x0 + 3/(1 + exp(-(x1 + 0.5)/0.1)), modification > 0), (4*(x1 - x0) + Piecewise((-0.1*z**7, z < 0), (0, True)), True))"
  } ]
