}, {
  "@id" : "https://w3id.org/tvbo/SparseCoupling",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/BackendCapability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Evaluate network coupling by summing over the existing edges only (cost scales with the number of edges) rather than over the full dense adjacency (cost scales with nodes-squared). Numerically identical to the dense evaluation; a pure performance optimisation for sparsely-connected networks."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Sparse (edge-list) coupling evaluation"
  } ],
  "https://w3id.org/tvbo/boundConstraint" : [ {
    "@value" : "edges << nodes^2  (connection density below the backend's sparse/dense crossover)"
  } ],
  "https://w3id.org/tvbo/enabledByGraphParameter" : [ {
    "@value" : "graph_representation"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/SparseDelayGraph",
