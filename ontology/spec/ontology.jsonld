}, {
  "@id" : "https://w3id.org/tvbo/neuroml/fitzHughNagumo1969Cell",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "The Fitzhugh Nagumo model is a two-dimensional simplification of the Hodgkin-Huxley model of spike generation in squid giant axons.  This system was suggested by FitzHugh (FitzHugh R. [1961]: Impulses and physiological states in theoretical models of nerve membrane.  Biophysical J.  1:445-466), who called it \" Bonhoeffer-van der Pol model \", and the equivalent circuit by Nagumo et al.  (Nagumo J., Arimoto S., and Yoshizawa S. [1962] An active pulse transmission line simulating nerve axon. Proc IRE. 50:2061-2070.1962). This version corresponds to the one described in FitzHugh R.[1969]: Mathematical models of excitation and propagation in nerve.  Chapter 1 (pp. 1-85 in H.P. Schwan, ed. Biological Engineering, McGraw-Hill Book Co., N.Y.)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "fitzHughNagumo1969Cell"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml/baseCellMembPotDL"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#fitzHughNagumo1969Cell"
  } ],
  "https://w3id.org/tvbo/neuroml/exposes" : [ {
    "@value" : "F"
  }, {
    "@value" : "W"
  } ],
  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "I"
  }, {
    "@value" : "V0"
  }, {
    "@value" : "W0"
  }, {
    "@value" : "a"
  }, {
    "@value" : "b"
  }, {
    "@value" : "phi"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/fitzHughNagumoCell",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Simple dimensionless model of spiking cell from FitzHugh and Nagumo. Superseded by _fitzHughNagumo1969Cell (See https://github.com/NeuroML/NeuroML2/issues/42)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "fitzHughNagumoCell"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml/baseCellMembPotDL"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#fitzHughNagumoCell"
  } ],
  "https://w3id.org/tvbo/neuroml/exposes" : [ {
    "@value" : "W"
  } ],
  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "I"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/fixedFactorConcentrationModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Model of buffering of concentration of an ion (currently hard coded to be calcium, due to requirement for _iCa) which has a baseline level _restingConc and tends to this value with time course _decayConstant. A fixed factor _rho is used to scale the incoming current *independently of the size of the compartment* to produce a concentration change."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "fixedFactorConcentrationModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml/concentrationModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#fixedFactorConcentrationModel"
  } ],
  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "decayConstant"
  }, {
    "@value" : "restingConc"
  }, {
    "@value" : "rho"
  } ],
  "https://w3id.org/tvbo/neuroml/requires" : [ {
    "@value" : "iCa"
  }, {
    "@value" : "surfaceArea"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/fixedFactorConcentrationModelTraub",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Model of buffering of concentration of an ion (currently hard coded to be calcium, due to requirement for _iCa) which has a baseline level _restingConc and tends to this value with time course 1 / _beta. A fixed factor _phi is used to scale the incoming current *independently of the size of the compartment* to produce a concentration change. Not recommended for use in models other than Traub et al. 2005!"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "fixedFactorConcentrationModelTraub"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml/concentrationModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#fixedFactorConcentrationModelTraub"
  } ],
  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "beta"
  }, {
    "@value" : "phi"
  }, {
    "@value" : "restingConc"
  } ],
  "https://w3id.org/tvbo/neuroml/requires" : [ {
    "@value" : "iCa"
  }, {
    "@value" : "surfaceArea"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/fixedTimeCourse",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Time course of a fixed magnitude _tau which can be used for the time course in _gateHHtauInf_, _gateHHratesTau_ or _gateHHratesTauInf_"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
