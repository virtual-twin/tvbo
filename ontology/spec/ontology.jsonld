  "@id" : "https://w3id.org/tvbo/ConnectivityRule",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ConnectivityRule"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid689"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Rule for expanding a population-level Edge into individual cell-to-cell connections. Names a connectivity pattern between the source and target populations so a network of populations declares its projections once, without enumerating every connection; each backend expands the rule into its native connection set (e.g. the NeuroML exporter emits one <projection> with size_src x size_tgt <connection> elements). Backend-independent: it states the connectivity pattern, not how any simulator stores it."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "https://w3id.org/linkml/permissible_values" : [ {
    "@id" : "https://w3id.org/tvbo/ConnectivityRule#all_to_all"
  }, {
    "@id" : "https://w3id.org/tvbo/ConnectivityRule#one_to_one"
  }, {
    "@id" : "https://w3id.org/tvbo/ConnectivityRule#random"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ConnectivityRule#all_to_all",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "all_to_all (ConnectivityRule)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/ConnectivityRule"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Fully connected projection: every source cell connects to every target cell. For a self-projection (same source and target population) the diagonal i->i is governed by the Edge's allow_self_connections flag."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "all_to_all"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ConnectivityRule#one_to_one",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "one_to_one (ConnectivityRule)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/ConnectivityRule"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Index-aligned projection: source cell i connects to target cell i (min of the two population sizes)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "one_to_one"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ConnectivityRule#random",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "random (ConnectivityRule)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/ConnectivityRule"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Sparse random projection (fixed-probability Erdos-Renyi): each of the size_src x size_tgt possible connections is present independently with probability given by the Edge's `connection_probability` parameter (in `Edge.parameters`, alongside `weight`). For a self-projection the diagonal i->i is governed by Edge.allow_self_connections. A backend that only supports dense projections may reject this rule rather than approximate it."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "random"
  } ]
}, {
