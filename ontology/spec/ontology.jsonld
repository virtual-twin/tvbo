    "@value" : "mesh_intervals (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Number of mesh intervals (time slices) for collocation or trapezoid methods. Collocation: N in PeriodicOrbitOCollProblem(N, m). Trapezoid: M in PeriodicOrbitTrapProblem(M=...)."
