  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "E (ZerlautAdaptationFirstOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "E"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(E, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(-E + f_out_e)/T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/ZerlautAdaptationFirstOrder/state_variables/I",
