  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The bifurcation parameter nu at the onset point for the given class."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "nu_stop"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/state_variables/x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Fast subsystem variable x."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x (EpileptorCodim3 state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-y"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/state_variables/y",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Fast subsystem variable y."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y (EpileptorCodim3 state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "x**3 - mu2*x - mu1 - y*(nu + b*x + x**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/state_variables/z",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Slow subsystem variable z steering the fast subsystem along the great arc."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "z (EpileptorCodim3 state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "z"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(z, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-c*(sqrt((x - xs)**2 + y**2) - dstar + Piecewise(((z - 1/2)**7/10, modification > 0), (0, True)) + Ks*c_glob)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3SlowMod",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Epileptor Codim 3 model with ultra-slow modulation of bursting classes (Saggio et al., 2017). It is a neural mass model containing a fast subsystem (x, y) built from the unfolding of a degenerate Takens-Bogdanov bifurcation of codimension 3 and a slow subsystem (z) that steers the fast one back and forth along a path in parameter space, producing bursting. Two additional ultra-slow state variables (uA, uB) modulate the offset (A) and onset (B) points of the burster along great arcs on a sphere of radius R, allowing the model to switch between different classes of bursters (Hysteresis-Loop bursters c0, c0', c2s, c3s, c4s, c10s, c11s, c2b, c4b, c8b, c14b, c16b as classified in Saggio et al. 2017 Table 2). The bifurcation parameters (mu1, mu2, nu) at the offset (A) and onset (B) points are obtained by parametrising great arcs between the points Ain/Aend and Bin/Bend on the sphere. This capture uses the default branch of the resting state (N = 1) and the default stabilising modification (modification = True)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "EpileptorCodim3SlowMod"
  } ],
