  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "bids_root (study)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Path to BIDS dataset root directory. When set, subject networks and empirical data paths are resolved relative to this root. A workflow kit copies the files its experiments read from here into its own ``data/<dataset_id>/`` and freezes this path to that copy."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/study"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "bids_root"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/study/bids_version",
