}, {
  "@id" : "https://w3id.org/tvbo/DecoBalancedExcInh",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Deco Balanced Exc-Inh model. It extends the Reduced Wong-Wang Exc-Inh (RWW_EI) dynamic mean-field model with an effective regional gain parameter M_i that scales both the excitatory and inhibitory input currents, capturing the dynamical consequences of regional heterogeneity in the brain's transcriptional landscape (Deco et al., 2021)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "DecoBalancedExcInh"
  } ],
