    "@value" : "E2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "E2"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "nu_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "First component of the unit vector F parametrising the great arc (normalised ((A x B) x A) with B = [mu2_stop, -mu1_stop, nu_stop])."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "F0 (EpileptorCodim3 derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "F0"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "F0"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second component of the unit vector F parametrising the great arc."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "F1 (EpileptorCodim3 derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "F1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "F1"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Third component of the unit vector F parametrising the great arc."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "F2 (EpileptorCodim3 derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "F2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "F2"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_a",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Half of mu1 (the Cardano coefficient mu1/2 for the depressed cubic xs**3 - mu2*xs - mu1 = 0)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "cardano_a (EpileptorCodim3 derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "cardano_a"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "cardano_a"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "mu1/2"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_d",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Cardano discriminant mu1**2/4 - mu2**3/27 for the cubic xs**3 - mu2*xs - mu1 = 0."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "cardano_d (EpileptorCodim3 derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "cardano_d"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "cardano_d"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "mu1**2/4 - mu2**3/27"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Bifurcation parameter mu1 along the great arc as a function of the slow variable z."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "mu1 (EpileptorCodim3 derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "mu1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "mu1"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-R*(E1*cos(z) + F1*sin(z))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Bifurcation parameter mu2 along the great arc as a function of the slow variable z."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "mu2 (EpileptorCodim3 derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "mu2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "mu2"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "R*(E0*cos(z) + F0*sin(z))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/nu",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Bifurcation parameter nu along the great arc as a function of the slow variable z."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "nu (EpileptorCodim3 derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "nu"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "nu"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "R*(E2*cos(z) + F2*sin(z))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/xs",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The x-coordinate of the resting state (branch N=1), the real part of the Cardano root of xs**3 - mu2*xs - mu1 = 0, reproducing TVB's principal-branch complex cube root. For negative discriminant (three real roots) the trigonometric form is used; for non-negative discriminant the principal-branch real cube root sum is used (a real cube root for non-negative argument, half the real cube root of the magnitude for negative argument)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "xs (EpileptorCodim3 derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "xs"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "xs"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((2*(cardano_a**2 - cardano_d)**(1/6)*cos(atan2(sqrt(-cardano_d), cardano_a)/3), cardano_d < 0), (Piecewise(((cardano_a + sqrt(cardano_d))**(1/3), (cardano_a + sqrt(cardano_d)) >= 0), (Abs(cardano_a + sqrt(cardano_d))**(1/3)/2, True)) + Piecewise(((cardano_a - sqrt(cardano_d))**(1/3), (cardano_a - sqrt(cardano_d)) >= 0), (Abs(cardano_a - sqrt(cardano_d))**(1/3)/2, True)), True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/parameters/Ks",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Slow permittivity coupling strength, the default of zero is no coupling."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Ks (EpileptorCodim3 parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Slow permittivity coupling strength."
