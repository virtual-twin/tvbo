  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "One cell of the figure. kind selects grammar (cartesian/heatmap) vs escape-hatch (image/custom); every kind shares the label, placeholder, legend and annotation machinery. Reuses label (human title)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/figure"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "PanelKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid3062"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "What a panel draws. cartesian/heatmap are grammar-driven (mark + encoding); surface paints a layer on a mesh, volume projects one through a labelled volume and network draws one on a node-link graph; grid tiles a composite of sub-panels; colorbar/legend are shared keys in their own slot; image (external file) and custom (registered callable) are peer escape-hatch kinds. A new kind is added when its bsplot leaf exists."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/figure"
  } ],
  "https://w3id.org/linkml/permissible_values" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind#cartesian"
  }, {
    "@id" : "https://w3id.org/tvbo/PanelKind#colorbar"
  }, {
    "@id" : "https://w3id.org/tvbo/PanelKind#custom"
  }, {
    "@id" : "https://w3id.org/tvbo/PanelKind#grid"
  }, {
    "@id" : "https://w3id.org/tvbo/PanelKind#heatmap"
  }, {
    "@id" : "https://w3id.org/tvbo/PanelKind#image"
  }, {
    "@id" : "https://w3id.org/tvbo/PanelKind#legend"
  }, {
    "@id" : "https://w3id.org/tvbo/PanelKind#line3d"
  }, {
    "@id" : "https://w3id.org/tvbo/PanelKind#network"
  }, {
    "@id" : "https://w3id.org/tvbo/PanelKind#surface"
  }, {
    "@id" : "https://w3id.org/tvbo/PanelKind#volume"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind#cartesian",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "cartesian (PanelKind)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Line/scatter/rule/band marks in a 2-D cartesian frame."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "cartesian"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind#colorbar",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "colorbar (PanelKind)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A colour scale in its own slot, for panels that share one. Attaching it to any single panel steals that panel's width and implies the scale is local to it. Limits come from opts or, with a layer bound, from the data. Built in."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "colorbar"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind#custom",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "custom (PanelKind)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A registered callable fn(container, ax, **opts)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "custom"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind#grid",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "grid (PanelKind)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A composite of sub-panels inside ONE lettered panel, labelled once per row and column. What a paper's lettered panel usually is: a row of mode surfaces under a single (a), or a Data/Reconstruction matrix whose task name is written once at the left. Declaring each cell as its own mosaic entry instead would repeat those labels in every cell and renumber panels the paper letters once. Cells come from `cells:` or, in the common case, from `layers:` — one cell per layer, all drawn by the shared `cell:` template."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "grid"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind#heatmap",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "heatmap (PanelKind)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A 2-D array field drawn as pcolormesh/imshow."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "heatmap"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind#image",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "image (PanelKind)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An external raster/vector file placed in the grid cell."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "image"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind#legend",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "legend (PanelKind)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A key in its own slot, for a convention several panels share. Entries are parallel `labels`/`colors`/`linestyles` lists. Built in."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "legend"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind#line3d",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "line3d (PanelKind)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Line/scatter marks in a 3-D frame (x/y/z channels) — a phase-space orbit or trajectory. Camera via opts (elev, azim); axis via zlabel/zlim."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "line3d"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind#network",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "network (PanelKind)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The connectome as a node-link graph: one marker per region at its anatomical centre, edges drawn for the connections that survive `edge_percentile`. A layer supplies one value per region and colours the markers with it, so what the panel shows is a state living ON the network rather than beside it. Geometry comes from the `network:` the panel names, values are placed BY LABEL through the node labels, and `projection` picks the anatomical plane the centres flatten onto. Needs no code_modules — the drawing is built in."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "network"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind#surface",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "surface (PanelKind)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A layer's per-vertex values painted on a mesh. Geometry comes from the network (`network:`, whose companion carries a mesh group) or a mesh file (`mesh:` — GIFTI/VTK/FreeSurfer, or an npz of vertices/faces); camera via opts (view, hemi), colour via cmap/symmetric/percentile/vmin/vmax, and `mask:` greys a medial wall out of both the map and its colour range. A layer shorter than the mesh is placed BY LABEL from its `vertex` coordinate. With `color:`/`edgecolor:` and no layer it draws the bare geometry. Needs no code_modules — the drawing is built in."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "surface"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PanelKind#volume",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "volume (PanelKind)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/PanelKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A layer's per-region values painted into a labelled volume and projected as a glass brain — the volumetric counterpart of `surface`, and how a paper shows a whole-brain map without committing to a cortical mesh. Geometry and the label lookup come from a curated atlas (`atlas:`, whose companion dseg carries one integer label per region) or a segmentation file (`volume:`); values are placed BY LABEL through the atlas terminology, never by array position, so a region's value cannot land on its neighbour. Camera via opts (view, intensity_projection), colour via cmap/symmetric/percentile/vmin/vmax. Needs no code_modules — the drawing is built in."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "volume"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ParallelMode",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ParallelMode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid3074"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "How a trial / grid-point axis is realised at JAX codegen time. The choice trades peak memory against throughput: vmap batches in parallel (fast, n_trials × working-set memory), lax_map runs sequentially via ``jax.lax.map`` (memory bounded by one trial), pmap shards across devices, auto picks vmap when the estimated batched memory fits and lax_map otherwise."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "https://w3id.org/linkml/permissible_values" : [ {
    "@id" : "https://w3id.org/tvbo/ParallelMode#auto"
  }, {
    "@id" : "https://w3id.org/tvbo/ParallelMode#lax_map"
  }, {
    "@id" : "https://w3id.org/tvbo/ParallelMode#pmap"
  }, {
    "@id" : "https://w3id.org/tvbo/ParallelMode#vmap"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ParallelMode#auto",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "auto (ParallelMode)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/ParallelMode"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Pick vmap when memory permits, lax_map otherwise."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "auto"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ParallelMode#lax_map",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "lax_map (ParallelMode)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/ParallelMode"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Sequential execution via jax.lax.map. Slower; bounded memory."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "lax_map"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ParallelMode#pmap",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "pmap (ParallelMode)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/ParallelMode"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Parallel execution across the local devices of a single node (jax.pmap over the several GPUs/TPUs visible to that task). Intra-task only — it never spans nodes; inter-node parallelism is scheduler fan-out (DistributionConfig.chunk), not pmap. On a one-GPU (or CPU) task this degenerates to vmap."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "pmap"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ParallelMode#vmap",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "vmap (ParallelMode)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/ParallelMode"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Parallel batched execution (jax.vmap). Fast; high peak memory."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "vmap"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Parameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
