}, {
  "@id" : "https://w3id.org/tvbo/CoombesByrne",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "4D model describing the Ott-Antonsen reduction of infinite all-to-all\ncoupled QIF neurons (Theta-neurons).\n\nNote: the original equations describe the dynamics of the Kuramoto parameter\n$Z$. Using the conformal transformation $Z=(1-W^\\star)/(1+W^\\star)$ and $W= \\pi r + i V$, we express the system dynamics in terms of two state variables $r$ and $V$ representing the average firing rate and the average membrane potential of our QIF neurons. The conductance variable and its derivative are $g$ and $q$.\n"
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Byrne2020"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CoombesByrne"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Coombes-Byrne"
  } ],
  "https://w3id.org/tvbo/exhibitsBifurcation" : [ {
    "@id" : "_:genid3437"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Oscillatory"
  }, {
    "@id" : "https://w3id.org/tvbo/Quiescent"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/FixedPoint"
  }, {
    "@id" : "https://w3id.org/tvbo/LimitCycle"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/CoombesByrne/parameters/Delta"
  }, {
    "@id" : "https://w3id.org/tvbo/CoombesByrne/parameters/alpha"
  }, {
    "@id" : "https://w3id.org/tvbo/CoombesByrne/parameters/eta"
  }, {
    "@id" : "https://w3id.org/tvbo/CoombesByrne/parameters/k"
  }, {
    "@id" : "https://w3id.org/tvbo/CoombesByrne/parameters/v_syn"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/CoombesByrne/state_variables/V"
  }, {
