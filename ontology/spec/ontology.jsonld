}, {
  "@id" : "https://w3id.org/tvbo/neuroml/expOneSynapse",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Ohmic synapse model whose conductance rises instantaneously by (_gbase * _weight) on receiving an event, and which decays exponentially to zero with time course _tauDecay"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "expOneSynapse"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml/baseConductanceBasedSynapse"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#expOneSynapse"
  } ],
  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "tauDecay"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/expThreeSynapse",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Ohmic synapse similar to expTwoSynapse but consisting of two components that can differ in decay times and max conductances but share the same rise time."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "expThreeSynapse"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml/baseConductanceBasedSynapseTwo"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#expThreeSynapse"
  } ],
  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "tauDecay1"
  }, {
    "@value" : "tauDecay2"
  }, {
    "@value" : "tauRise"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/expTwoSynapse",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Ohmic synapse model whose conductance waveform on receiving an event has a rise time of _tauRise and a decay time of _tauDecay. Max conductance reached during this time (assuming zero conductance before) is _gbase * _weight."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "expTwoSynapse"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml/baseConductanceBasedSynapse"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#expTwoSynapse"
  } ],
  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "tauDecay"
  }, {
    "@value" : "tauRise"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/explicitConnection",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
