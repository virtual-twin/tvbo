}, {
  "@id" : "https://w3id.org/tvbo/software/vbi",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Virtual Brain Inference. Probabilistic inference toolkit for whole-brain models — multi-backend simulators (Numba, C++, CuPy, JAX, PyTorch, TVB kernels), a 40+ time-series feature library (statistical, spectral, FC/FCD, complexity, event-detection), and two parallel inference paths (SBI via sbi-toolkit SNPE/SNLE/SNRE with MAF/NSF, and a built-in autograd-based CDE with MDN/MAF estimators). Targets the inverse problem of mapping observed neuroimaging (EEG/MEG/fMRI) onto brain-model parameters."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@value" : "MIT"
  } ],
  "http://schema.org/codeRepository" : [ {
    "@value" : "https://github.com/ins-amu/vbi"
  } ],
  "http://schema.org/identifier" : [ {
    "@value" : "10.5281/zenodo.14795543"
  } ],
  "http://schema.org/url" : [ {
    "@value" : "https://vbi.readthedocs.io"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SoftwarePackage"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "vbi"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/software/vbjax",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "JAX-based virtual brain library. Provides stochastic Heun integrators for ODE/SDE/DDE/SDDE, canonical neural-mass models (Jansen-Rit, Montbrio-Pazo-Roxin, BVEP, bilinear DCM, Dopa), BOLD/EEG monitors, delay-coupling helpers, a spherical-harmonic neural-field operator, and JAX-native parameter sweeps with gradient-based fitting and MCMC."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@value" : "Apache-2.0"
  } ],
  "http://schema.org/codeRepository" : [ {
    "@value" : "https://github.com/ins-amu/vbjax"
  } ],
  "http://schema.org/identifier" : [ {
    "@value" : "10.5281/zenodo.14204250"
  } ],
  "http://schema.org/url" : [ {
    "@value" : "https://github.com/ins-amu/vbjax"
  } ],
