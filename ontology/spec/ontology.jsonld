}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/x0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Degree of excitability or epileptogenicity in Epileptor2D (Proix et al"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "-1.6"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0043179"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x0 (Epileptor2D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Degree of excitability or epileptogenicity in Epileptor2D (Proix et al.,2014).\n\nIf x0 is greater than a critical value, x0,critic = −2.05 (i.e., in the supercritical regime), the system can trigger seizures autonomously; otherwise it is in its equilibrium state (i.e., in the subcritical regime).\n\nNote:\n- If modification_E2D:\nif x0 is smaller than a critical value, x0,critic = 2.91, can trigger seizures autonomously; otherwise it is in its equilibrium state (Proix et al., 2014)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x0"
  } ],
  "https://w3id.org/tvbo/surrogate_of" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0043179"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/state_variables/x1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "First state-variable in the Epileptor2D (Proix et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x1 (Epileptor2D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x1, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(Iext + Kvf*c_glob + c + local_coupling*x1 - x1*x1cond - z)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/state_variables/z",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Slow permittivity state-variable of the Epileptor2D (Proix et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "z (Epileptor2D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "z"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(z, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "r*tt*(Ks*c_glob + h - z)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Stefanescu-McDonald reduced 3D Epileptor variant migrated as a placeholder scaffold from the legacy tvb-o.owl ontology. The original publication for this exact variant could not be located; the only OWL-side parameter is `N` (population size, grounded to \"regulation of resting membrane potential\"). Equations are minimal placeholders: a fast (x1) - slow (z) excitable system inspired by the canonical Epileptor (Jirsa et al. 2014), gated by N. This scaffold preserves the ontology lineage and parameter grounding; it should be replaced with the published equations once located, or removed if the variant is confirmed obsolete."
  } ],
  "http://purl.org/dc/terms/subject" : [ {
    "@id" : "http://purl.bioontology.org/ontology/MESH/D004827"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
