}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/derived_variables/Iext_total",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "External input to the first population including local coupling input on x1."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Iext_total (Epileptor derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "Iext_total"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Iext_total"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Iext + local_coupling*x1"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/derived_variables/f1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Nonlinear function in the first state variable x1, piecewise on the sign of x1."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "f1 (Epileptor derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "f1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "f1"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((-a*x1**2 + b*x1, x1 < 0), (slope - x2 + 0.6*(z - 4.0)**2, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/derived_variables/f2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Nonlinear function in the fifth state variable y2, piecewise on the value of x2."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "f2 (Epileptor derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "f2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "f2"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((0, x2 < -0.25), (aa*(x2 + 0.25), True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/derived_variables/h",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Permittivity drive for z: sigmoidal when modification>0, else linear (Piecewise on modification)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "h (Epileptor derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((x0 + 3/(1 + exp(-(x1 + 0.5)/0.1)), modification > 0), (4*(x1 - x0) + Piecewise((-0.1*z**7, z < 0), (0, True)), True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/derived_variables/lfp",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Local field potential proxy: TVB Epileptor observable x2 - x1."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "lfp (Epileptor derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "lfp"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "lfp"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "x2 - x1"
  } ]
}, {
