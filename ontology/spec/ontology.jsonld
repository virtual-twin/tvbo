  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Diffusionless variant of Lorenz-type flow supporting a pair of linked Malasoma\nstrange attractors with fractal basin boundaries for typical parameter values."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Sprott2014"
  } ],
