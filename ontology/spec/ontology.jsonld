}, {
  "@id" : "https://w3id.org/tvbo/models/ZerlautAdaptationFirstOrder/state_variables/W_e",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Level of adaptation of excitatory in pA"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "W_e (ZerlautAdaptationFirstOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "W_e"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(W_e, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "E*b_e - W_e/tau_w_e + a_e*(-E_L_e + mu_V_e)/tau_w_e"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/ZerlautAdaptationFirstOrder/state_variables/W_i",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Level of adaptation of inhibitory in pA"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "W_i (ZerlautAdaptationFirstOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "W_i"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(W_i, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "I*b_i - W_i/tau_w_i + a_i*(-E_L_i + mu_V_i)/tau_w_i"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/ZerlautAdaptationFirstOrder/state_variables/ou_drift",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
