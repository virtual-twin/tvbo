}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Tsodyks-Markram mean-field model of short-term synaptic plasticity. A three-variable neural mass model with firing rate E, synaptic depression variable x, and facilitation variable u. The transfer function uses a softplus nonlinearity α·log(1 + exp(s/α)). Reproduces the dynamics from BifurcationKit.jl/examples/TMModel.jl."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Tsodyks1997"
  }, {
    "@id" : "https://w3id.org/tvbo/studies/Tsodyks1998"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TsodyksMarkram"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Tsodyks-Markram"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Oscillatory"
  }, {
    "@id" : "https://w3id.org/tvbo/Quiescent"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/FixedPoint"
  }, {
    "@id" : "https://w3id.org/tvbo/LimitCycle"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/derived_variables/SS0"
  }, {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/derived_variables/SS1"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/E0"
  }, {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/J"
  }, {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/U0"
  }, {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/alpha"
  }, {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/tau"
  }, {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/tauD"
  }, {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/tauF"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/state_variables/E"
  }, {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/state_variables/u"
  }, {
    "@id" : "https://w3id.org/tvbo/TsodyksMarkram/state_variables/x"
  } ],
  "https://w3id.org/tvbo/hasStochasticityCharacter" : [ {
    "@id" : "https://w3id.org/tvbo/Deterministic"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "neural_mass"
  } ],
  "https://w3id.org/tvbo/modelsAnatomicalRegion" : [ {
    "@id" : "http://purl.obolibrary.org/obo/UBERON_0000956"
  } ],
  "https://w3id.org/tvbo/modelsNeurotransmitterSystem" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0035249"
  } ],
  "https://w3id.org/tvbo/phaseSpaceDimension" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "3"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/derived_variables/SS0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Total synaptic input (recurrent + external)"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "SS0 (TsodyksMarkram derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "SS0"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "SS0"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "J*u*x*E + E0"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/derived_variables/SS1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Softplus transfer function output"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "SS1 (TsodyksMarkram derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "SS1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "SS1"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "alpha*log(1 + exp(SS0/alpha))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/E0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "External input (baseline excitability)"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "-2.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "E0 (TsodyksMarkram parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "E0"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/J",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Synaptic coupling strength"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "3.07"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "J (TsodyksMarkram parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "J"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/U0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Baseline release probability"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.3"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "U0 (TsodyksMarkram parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "U0"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/alpha",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Softplus nonlinearity steepness (smoothed threshold gain)"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.5"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "alpha (TsodyksMarkram parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "alpha"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/tau",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Membrane time constant (firing rate relaxation)"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.013"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tau (TsodyksMarkram parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/tauD",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Synaptic depression recovery time constant"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.2"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tauD (TsodyksMarkram parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tauD"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/parameters/tauF",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Synaptic facilitation decay time constant"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.5"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tauF (TsodyksMarkram parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tauF"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/state_variables/E",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Mean firing rate of the excitatory population"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "E (TsodyksMarkram state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "E"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(E, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(-E + SS1)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/state_variables/u",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Synaptic facilitation variable (release probability). Decays to U0 with time constant tauF and is enhanced proportionally to firing."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "u (TsodyksMarkram state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "u"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(u, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(U0 - u)/tauF + U0*(1 - u)*E"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TsodyksMarkram/state_variables/x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Synaptic depression variable (fraction of available neurotransmitter). Recovers to 1 with time constant tauD and is depleted proportionally to firing."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x (TsodyksMarkram state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
