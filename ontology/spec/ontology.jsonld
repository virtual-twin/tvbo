  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Graph generator specification.  When set, overrides explicit edges/nodes for graph construction.  The type field is a free string; StandardGraphType lists well-known types that get automatic code generation across backends.\n"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "graph_generator"
  } ]
