  } ]
}, {
  "@id" : "https://w3id.org/tvbo/InitialStateMethod#from_branch",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "from_branch (InitialStateMethod)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/InitialStateMethod"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Start from a point on a previously computed branch. No continuation backend implements it: a continuation declaring it is refused by name before anything renders or runs. A continuation from a special point of another is declared as a branch of that continuation instead (Continuation.branches, with its BranchSwitch.source_point)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "from_branch"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/InitialStateMethod#from_experiment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "from_experiment (InitialStateMethod)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/InitialStateMethod"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Seed from the settled endpoint state of another already-run experiment in the study (referenced by InitialState.source_experiment). Reuses a working point that experiment already reached instead of recomputing it — the cross-experiment counterpart of from_working_point (which recomputes the ramp inline). source_point selects which settled point of the source run (default 'endpoint')."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "from_experiment"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/InitialStateMethod#from_working_point",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "from_working_point (InitialStateMethod)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/InitialStateMethod"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Ramp a parameter quasi-statically (warm-start / from_previous) to a target value (see InitialState.ramp) and start from the endpoint state — reach a working point on the solution branch before the run."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "from_working_point"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/InitialStateMethod#given",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "given (InitialStateMethod)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/InitialStateMethod"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Start from the model's declared initial values as they are. A continuation takes them as its starting equilibrium on every continuation backend, and refuses a state whose right-hand side exceeds InitialState.abs_tol in any component, since AUTO-07p would start its branch at a state that is not an equilibrium and BifurcationKit would correct it first; newton finds the equilibrium near such a state."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "given"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/InitialStateMethod#newton",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "newton (InitialStateMethod)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/InitialStateMethod"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Start from the equilibrium Newton's method converges to from the model's declared initial values: SciPy's root by MINPACK's hybr, to a relative step of InitialState.abs_tol, refused where it does not converge. Resolved once, before any backend runs, so every continuation backend starts from the same state; on a network every node starts from it."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "newton"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/InitialStateMethod#time_integration",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
