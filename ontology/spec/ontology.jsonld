  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/FitzHughNagumo1969_Ex9",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "FitzHugh-Nagumo 1969 model matching NeuroML2 fitzHughNagumo1969Cell. Parameters from canonical NML2_AbstractCells.nml example. Uses TS=1ms (time_unit: ms) as defined in the ComponentType.\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
