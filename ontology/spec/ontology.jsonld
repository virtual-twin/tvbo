}, {
  "@id" : "https://w3id.org/tvbo/equation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "equation (slot)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/tvbo/Equation"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "equation"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/equation_order",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "equation_order (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Order of the time derivative on the LHS. Default 1 means dx/dt = rhs (first-order ODE). Order 2 means d²x/dt² = rhs (second-order ODE), etc. Higher-order ODEs are automatically lowered to coupled first-order systems by backends like ModelingToolkit.jl via mtkcompile."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "equation_order"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/equation_type",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "equation_type (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "How to interpret ``equation.rhs`` when advancing this state: 'differential' (default) integrates it as ``dx/dt = rhs``; 'algebraic' is a constraint ``0 = rhs`` / ``x ~ rhs`` (DAE); 'recurrence' is a discrete per-step update ``x_next = rhs`` (no integrator applied), used by an observation's auxiliary ``dynamics`` for online reductions/accumulators (e.g. a running sum ``x_next = x + f``) — the symbolic, backend-independent sibling of the continuous 'differential' form. Algebraic equations are used by ModelingToolkit.jl backend."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "equation_type"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/event_type",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "event_type (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Type of event trigger mechanism."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "event_type"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/events",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "https://w3id.org/tvbo/evict_equation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "evict_equation (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Optional reverse recurrence for a **sliding-window** reduction: the per-step downdate that removes the sample leaving the window, the inverse of ``equation`` (which folds an arriving sample in). Only meaningful when ``equation_type: recurrence`` on an observation's auxiliary ``dynamics``. When present, the observer is a windowed reduction — its state is maintained by ``equation`` (add) and ``evict_equation`` (evict) and rebuilt exactly from the window on resync — rather than a cumulative accumulator over the whole trajectory (``equation`` alone). Absent for ordinary state variables and cumulative reductions."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "evict_equation"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/executableOn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "executable on"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/tvbo/Backend"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/execution",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "https://w3id.org/tvbo/executor",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "executor (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
