    "@id" : "https://w3id.org/tvbo/models/VanDerPolForced/parameters/F"
  }, {
    "@id" : "https://w3id.org/tvbo/models/VanDerPolForced/parameters/T"
  }, {
    "@id" : "https://w3id.org/tvbo/models/VanDerPolForced/parameters/mu"
  } ],
