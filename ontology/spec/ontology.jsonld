}, {
  "@id" : "https://w3id.org/tvbo/surrogate",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "surrogate (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Optional permutation-significance test: this derived variable's value is the exceedance p-value of a named statistic under permutations of a field (a general surrogate null — any permutation test, not wave-specific — emitted as a vmap-fold over the captured permutations; the wrapped statistic stays symbolic). When set, the variable's own ``equation`` may be omitted."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "surrogate"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/surrogate_of",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "General grounding relation: the subject (parameter, state variable, model, ...) is a surrogate / abstraction / model of an external ontology term (typically GO, ChEBI, UBERON, CL, MeSH). The target term's own ontology carries the specificity, so no per-domain relation is required. Populated inline from the LinkML `grounding` slot; the `models*` properties below are sub-properties that refine the range."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "surrogate of"
  } ]
}, {
