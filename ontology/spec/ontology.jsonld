    "@value" : "requires (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "requires"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/requiresCapability",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The task is only well-posed on a backend that provides the named capability."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationTask"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "requires capability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/tvbo/BackendCapability"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/requiresCoupling",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The model's dynamics are defined against this specific coupling function (e.g. a sigmoidal transform of afferent activity); substituting a different coupling yields a different model."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "requires coupling"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/tvbo/Coupling"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/reset_state",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "reset_state (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Start this stage from the model's declared initial conditions rather than the previous stage's endpoint. The update rules' tuned targets always cross the stage boundary; what resets is the dynamical state — state variables, delay and coupling history, observation window buffers and monitors — and the noise stream, which restarts from the run's seed so each stage samples the same realisation. False, the default, makes the schedule one continuous trajectory; true makes each stage an independent simulation warm-started from the parameters learned so far."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "reset_state"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/results",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "results (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The named numbers the prose cites, each keyed by the manuscript token that stands in for it (``key``) and bound either to a computed value (``used:`` a DataRef into this study's or a nested study's analysis) or to an authored constant quoted from prior work (``value`` + ``source``). ``tvbo run`` collects these into a results manifest the document reads, so no reported figure is transcribed by hand and a stale or missing key fails the build rather than printing a wrong number."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "results"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/resync",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "resync (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Recurrence rebuilding the state exactly from the whole window `x`."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "resync"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/resync_masked",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "resync_masked (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Recurrence rebuilding the state from a fixed-size ring in which only `L` rows are live, selected by mask `m`. Separate from `resync` because a ring sized for the longest window carries rows that are not yet part of it, and summing over them would fold padding into the result. Absent where a reducer has no ring to mask."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "resync_masked"
