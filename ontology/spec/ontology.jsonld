}, {
  "@id" : "https://w3id.org/tvbo/observation_models/temporal_average_tvb",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Running temporal mean over non-overlapping windows of `period`, windowed exactly as TVB's TemporalAverage monitor windows: the first window covers integration steps 0..istep-1, and `istep` is TVB's own `iround(period / dt)`. Verified against TVB's own monitor driven through its `sample()` loop."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TemporalAverage"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/temporal_average_tvboptim",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Running temporal mean over non-overlapping windows of `period`, windowed as tvboptim's TemporalAverage windows them: the first window covers integration steps 1..istep. Use TemporalAverage for TVB's windowing, which opens at step 0."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
