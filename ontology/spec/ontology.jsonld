  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "2000.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TR (bold_gamma parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "TR"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "ms"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_hrf_strided",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "BOLD fMRI observation model identical to BOLD_TVB's HRF+Volterra forward model, but with the HRF convolution and TR subsampling fused into a single strided convolution (strided_convolve): the convolution is evaluated only at the retained [stride::stride] output samples, avoiding the full-length FFT. Byte-identical to a direct full 'valid' convolution + subsample; equal to the FFT path to FFT roundoff (~1e-12 float64 / ~1e-6 float32); ~70x cheaper with no FFT buffer."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "BOLD_HRF_strided"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/observation_models/bold_hrf_strided/parameters/TR"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_hrf_strided/parameters/TR",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Repetition time (sampling period)"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "720.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TR (bold_hrf_strided parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "TR"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "ms"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/observation_models/bold_mixture_of_gammas",
