  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Evaluate `distribution`'s density at the positions named by `of` — a spatial field (e.g. a Gaussian sink/source whose difference forms an in-strength gradient)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "distribution_pdf"
  } ]
}, {
