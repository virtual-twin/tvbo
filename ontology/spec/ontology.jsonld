  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Thomas' cyclically symmetric attractor: a smooth three-dimensional system with\nrotational symmetry across cyclic permutations (x,y,z). Reduces to the labyrinth\nsystem when b = 0. Displays a strange attractor with intertwined scroll-like lobes."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Thomas1999"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
