    "@id" : "https://w3id.org/tvbo/Bursting"
  }, {
    "@id" : "https://w3id.org/tvbo/Chaotic"
  }, {
    "@id" : "https://w3id.org/tvbo/Oscillatory"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/LimitCycle"
  }, {
    "@id" : "https://w3id.org/tvbo/StrangeAttractor"
  } ],
