  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-y"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/y",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Fast-subsystem state variable y."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y (EpileptorCodim3SlowMod state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "x**3 - mu2*x - mu1 - y*(nu + b*x + x**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/state_variables/z",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Slow-subsystem permittivity variable z."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "z (EpileptorCodim3SlowMod state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "z"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(z, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-c*(sqrt((x - xs)**2 + y**2) - dstar + Piecewise(((z - 1/2)**7/10, modification > 0), (0, True)) + Ks*c_glob)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/EpileptorRestingState",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Epileptor Resting-State (ERS) is an extension of the phenomenological neural mass model of Epileptor5D, tuned to express regionally specific physiological oscillations in addition to the epileptiform discharges (Courtiol et al., 2020). This extension was made using the Generic 2-dimensional Oscillator model (parametrized close to a supercritical Hopf Bifurcation) (Sanz-Leon et al., 2013, 2015) to reproduce the spontaneous local field potential-like signal.\n        \nThis model, its motivation and derivation can be found in the published article (Courtiol et al., 2020)."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Courtiol2020"
  }, {
    "@id" : "https://w3id.org/tvbo/studies/Jirsa2014"
  } ],
