    "@value" : "coupled_input (ZetterbergJansen derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "coupled_input"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "coupled_input"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "2*e0/(exp(rho_1*(-c_glob - local_coupling*v6 + rho_2)) + 1)"
