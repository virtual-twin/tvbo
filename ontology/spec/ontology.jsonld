  }, {
    "@id" : "https://w3id.org/tvbo/models/Generic2dOscillator/parameters/beta"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Generic2dOscillator/parameters/c"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Generic2dOscillator/parameters/d"
