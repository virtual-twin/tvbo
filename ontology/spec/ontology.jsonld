    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "MagneticPendulum"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/derived_variables/sum_gamma_terms_x"
  }, {
    "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/derived_variables/sum_gamma_terms_y"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/parameters/N"
  }, {
    "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/parameters/alpha"
  }, {
    "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/parameters/d"
  }, {
    "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/parameters/gamma"
  }, {
    "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/parameters/omega"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/state_variables/vx"
  }, {
    "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/state_variables/vy"
  }, {
    "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/state_variables/x"
  }, {
    "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/state_variables/y"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "generic"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/derived_variables/sum_gamma_terms_x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Sum over magnetic x-forces for N magnets on unit circle (default N=3 expanded)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sum_gamma_terms_x (MagneticPendulum derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sum_gamma_terms_x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "sum_gamma_terms_x"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "gamma*((x - 1)/((x - 1)**2 + y**2 + d**2)**(3/2) + (x - cos(2*pi/3))/((x - cos(2*pi/3))**2 + (y - sin(2*pi/3))**2 + d**2)**(3/2) + (x - cos(4*pi/3))/((x - cos(4*pi/3))**2 + (y - sin(4*pi/3))**2 + d**2)**(3/2))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/MagneticPendulum/derived_variables/sum_gamma_terms_y",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Sum over magnetic y-forces for N magnets on unit circle (default N=3 expanded)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sum_gamma_terms_y (MagneticPendulum derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sum_gamma_terms_y"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "sum_gamma_terms_y"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "gamma*(y/((x - 1)**2 + y**2 + d**2)**(3/2) + (y - sin(2*pi/3))/((x - cos(2*pi/3))**2 + (y - sin(2*pi/3))**2 + d**2)**(3/2) + (y - sin(4*pi/3))/((x - cos(4*pi/3))**2 + (y - sin(4*pi/3))**2 + d**2)**(3/2))"
  } ]
}, {
