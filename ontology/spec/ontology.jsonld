  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/x_0"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/x1"
  }, {
