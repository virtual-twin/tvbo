}, {
  "@id" : "https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Sigmoid function that transforms the average membrane potential of the PCs populations (y0) into an average firing rate to the excitatory interneurons EINs."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sigma_y0_1 (JansenRit derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sigma_y0_1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "sigma_y0_1"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "2.0*nu_max/(exp(r*(-J*a_1*y0 + v0)) + 1.0)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Sigmoid function that transforms the average membrane potential of the PCs populations (y0) into an average firing rate to the inhibitory interneurons IINs."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sigma_y0_3 (JansenRit derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sigma_y0_3"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "sigma_y0_3"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "2.0*nu_max/(exp(r*(-J*a_3*y0 + v0)) + 1.0)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y1_y2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Sigmoid function that transforms the average membrane potential of the interneurons populations (y1-y2)\ninto an average firing rate to the PCs."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sigma_y1_y2 (JansenRit derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sigma_y1_y2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "sigma_y1_y2"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "2.0*nu_max/(exp(r*(v0 - y1 + y2)) + 1.0)"
  } ]
