    "@language" : "en",
    "@value" : "Edge-list adjacency with a delay-history buffer, used when any coupling carries a conduction delay and graph_representation resolves to sparse."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
