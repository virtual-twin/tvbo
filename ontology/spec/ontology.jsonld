}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/disc",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Discriminant mu1^2/4 - mu2^3/27 of the depressed cubic for the resting-state x-coordinate."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "disc (EpileptorCodim3SlowMod derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "disc"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "disc"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "mu1**2/4 - mu2**3/27"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/mu1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Bifurcation parameter mu1 along the great arc (E, F, R) at slow variable z."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "mu1 (EpileptorCodim3SlowMod derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "mu1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "mu1"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-R*(E1*cos(z) + F1*sin(z))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/mu2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Bifurcation parameter mu2 along the great arc (E, F, R) at slow variable z."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "mu2 (EpileptorCodim3SlowMod derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "mu2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "mu2"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "R*(E0*cos(z) + F0*sin(z))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normA",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "normA (EpileptorCodim3SlowMod derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "normA"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "normA"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "sqrt(A0**2 + A1**2 + A2**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normF",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "normF (EpileptorCodim3SlowMod derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "normF"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "normF"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "sqrt(Fx0**2 + Fx1**2 + Fx2**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/nu",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Bifurcation parameter nu along the great arc (E, F, R) at slow variable z."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "nu (EpileptorCodim3SlowMod derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "nu"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "nu"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "R*(E2*cos(z) + F2*sin(z))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/sqdisc",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Square root of the absolute discriminant."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sqdisc (EpileptorCodim3SlowMod derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sqdisc"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "sqdisc"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "sqrt(Abs(disc))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/xs",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Real x-coordinate of the resting state, the branch (N = 1) real solution of x_s^3 - mu2 x_s - mu1 = 0 via Cardano's formula, taking the real part of the principal complex cube roots in both the one-real-root (disc >= 0) and three-real-roots (disc < 0) regimes."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "xs (EpileptorCodim3SlowMod derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "xs"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "xs"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((Abs(mu1/2 + sqdisc)**(1/3)*cos(atan2(0, mu1/2 + sqdisc)/3) + Abs(mu1/2 - sqdisc)**(1/3)*cos(atan2(0, mu1/2 - sqdisc)/3), disc >= 0), (sqrt((mu1/2)**2 + sqdisc**2)**(1/3)*cos(atan2(sqdisc, mu1/2)/3) + sqrt((mu1/2)**2 + sqdisc**2)**(1/3)*cos(atan2(-sqdisc, mu1/2)/3), True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/Ks",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Slow permittivity coupling strength, the default is no coupling."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Ks (EpileptorCodim3SlowMod parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "Ks"
  } ]
}, {
