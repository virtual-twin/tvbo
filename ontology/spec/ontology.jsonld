  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "py"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/HenonMap",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Hénon map is a two-dimensional discrete-time dynamical system exhibiting a strange\nattractor for the default parameters a=1.4, b=0.3. It serves as a simple model for\nchaotic dynamics in smooth invertible maps."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Henon1976"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "HenonMap"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/HenonMap/parameters/a"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HenonMap/parameters/b"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/HenonMap/state_variables/x"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HenonMap/state_variables/y"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "generic"
  } ]
}, {
