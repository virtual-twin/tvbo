  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "LorenzBounded"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/LorenzBounded/derived_variables/f"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/LorenzBounded/parameters/beta"
  }, {
    "@id" : "https://w3id.org/tvbo/models/LorenzBounded/parameters/r"
