    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "d (Epileptor parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Coefficient of the squared term in the second state variable."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "d"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/parameters/modification",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Switch between linear (0/False) and sigmoidal (>0/True) z-drive h."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "modification (Epileptor parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Selects the permittivity-drive form: >0 (True) uses the sigmoidal influence on z, default 0 (False) the linear influence."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "modification"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/parameters/r",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Temporal scaling in the third state variable z, called 1/tau0 in the Jirsa et al. (2014) paper."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "3.5E-4"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "r (Epileptor parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Temporal scaling in the third state variable."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "r"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/parameters/s",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Linear coefficient in the third state variable z."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "4.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "s (Epileptor parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Linear coefficient in the third state variable."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "s"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/parameters/slope",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Linear coefficient in the first state variable x1."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "slope (Epileptor parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Linear coefficient in the first state variable."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "slope"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/parameters/tau",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Temporal scaling coefficient in the fifth state variable y2."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "10.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tau (Epileptor parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Temporal scaling coefficient in the fifth state variable."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/parameters/tt",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Time scaling of the whole system."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tt (Epileptor parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Time scaling of the whole system."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tt"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/parameters/x0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Epileptogenicity parameter."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "-1.6"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x0 (Epileptor parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Epileptogenicity parameter."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x0"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/state_variables/g",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Lowpass-filtered excitatory coupling variable."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "g (Epileptor state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "g"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(g, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(-0.01*(g - 0.1*x1))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/state_variables/x1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "First state variable of the first (fast) population."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x1 (Epileptor state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x1, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(y1 - z + Iext_total + Kvf*c_glob0 + f1*x1)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/state_variables/x2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "First state variable of the second (slow) population."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x2 (Epileptor state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x2, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(-y2 + x2 - x2**3 + Iext2 + bb*g - 0.3*(z - 3.5) + Kf*c_glob1)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/state_variables/y1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second state variable of the first (fast) population."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y1 (Epileptor state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y1, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(c - d*x1**2 - y1)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/state_variables/y2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second state variable of the second (slow) population."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y2 (Epileptor state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y2, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(-y2 + f2)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/state_variables/z",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Slow permittivity (energy) state variable."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "z (Epileptor state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "z"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(z, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*r*(h - z + Ks*c_glob0)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Epileptor2D (E2D) is a phenomenological neural mass model consisting in the two-dimensional reduction ('x', 'z') of the original Epileptor model (see Epileptor5D; Proix et al., 2014, 2017).\n\nNote: \n------\n- Equations and default parameters are taken from (Proix et al.,2014),\n- The slow permittivity state-variable (z_E2D) can be modified to account for the time difference between the interictal (between seizures) and ictal (during seizure) states (see Proix et al., 2014)."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Proix2014"
  }, {
    "@id" : "https://w3id.org/tvbo/studies/Proix2017"
  } ],
  "http://purl.org/dc/terms/subject" : [ {
    "@id" : "http://purl.bioontology.org/ontology/MESH/D004827"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Epileptor2D"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Epileptor 2D"
  } ],
  "https://w3id.org/tvbo/exhibitsBifurcation" : [ {
    "@id" : "_:genid3442"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Bistable"
  }, {
    "@id" : "https://w3id.org/tvbo/Oscillatory"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/FixedPoint"
  }, {
    "@id" : "https://w3id.org/tvbo/LimitCycle"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/derived_variables/h"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/derived_variables/x1cond"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/derived_variables/zcond"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/Iext"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/Ks"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/Kvf"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/a"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/b"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/c"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/d"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/modification"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/r"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/slope"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/tt"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/x0"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/state_variables/x1"
  }, {
    "@id" : "https://w3id.org/tvbo/Epileptor2D/state_variables/z"
  } ],
  "https://w3id.org/tvbo/hasStochasticityCharacter" : [ {
    "@id" : "https://w3id.org/tvbo/Deterministic"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "phenomenological"
  } ],
  "https://w3id.org/tvbo/modelsAnatomicalRegion" : [ {
    "@id" : "http://purl.obolibrary.org/obo/UBERON_0002728"
  } ],
  "https://w3id.org/tvbo/phaseSpaceDimension" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "2"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/derived_variables/h",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "h (Epileptor2D derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "h"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((x0 + 3.0/(exp((-x1 - 1*0.5)/0.1) + 1.0), modification > 0), (zcond + 4*(-x0 + x1), True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/derived_variables/x1cond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x1cond (Epileptor2D derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((a*x1**2 + x1*(-b + d), x1 < 0), (d*x1 - slope - 0.6*(z - 4.0)**2, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/derived_variables/zcond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "zcond (Epileptor2D derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "zcond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "zcond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((-0.1*z**7, z < 0), (0, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/Iext",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "3.1"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Iext (Epileptor2D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al.,2014)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "Iext"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/Ks",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Ks (Epileptor2D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al., 2014).\n\nThe coupling quantifies the influence of neuronal fast discharges x_E2D on the local slow permittivity variable z_E2D."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "Ks"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/Kvf",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Coupling scaling on a very fast time scale"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Kvf (Epileptor2D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Coupling scaling on a very fast time scale."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "Kvf"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor2D/parameters/a",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
