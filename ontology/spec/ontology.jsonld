}, {
  "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/derived_variables/sqdisc",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Square root of the absolute discriminant."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sqdisc (EpileptorCodim3SlowMod derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sqdisc"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "sqdisc"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "sqrt(Abs(disc))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/derived_variables/xs",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Real x-coordinate of the resting state, the branch (N = 1) real solution of x_s^3 - mu2 x_s - mu1 = 0 via Cardano's formula, taking the real part of the principal complex cube roots in both the one-real-root (disc >= 0) and three-real-roots (disc < 0) regimes."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "xs (EpileptorCodim3SlowMod derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "xs"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "xs"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((Abs(mu1/2 + sqdisc)**(1/3)*cos(atan2(0, mu1/2 + sqdisc)/3) + Abs(mu1/2 - sqdisc)**(1/3)*cos(atan2(0, mu1/2 - sqdisc)/3), disc >= 0), (sqrt((mu1/2)**2 + sqdisc**2)**(1/3)*cos(atan2(sqdisc, mu1/2)/3) + sqrt((mu1/2)**2 + sqdisc**2)**(1/3)*cos(atan2(-sqdisc, mu1/2)/3), True))"
  } ]
