}, {
  "@id" : "https://w3id.org/tvbo/neuroml/expCurrSynapse",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Current based synapse with instantaneous rise and single exponential decay (with time constant tau_syn)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml"
  } ],
