}, {
  "@id" : "https://w3id.org/tvbo/CouplingDependentAuxiliaryRecording",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationTask"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Recording (via `output` or `record: true`) a derived/auxiliary variable whose equation reads a coupling input, with the auxiliary aligned to the state it is recorded alongside. Under the default per-step (frozen) coupling the recorded auxiliary carries the step-start coupling — one integration step behind the recorded post-step state — so exact state/coupling alignment requires per-stage coupling evaluation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Coupling-dependent auxiliary recording"
  } ],
  "https://w3id.org/tvbo/requiresCapability" : [ {
    "@id" : "https://w3id.org/tvbo/PerStageCouplingEvaluation"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/CouplingInput",
