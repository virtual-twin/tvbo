  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid2625"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "How a stochastic run's noise realization is generated."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "https://w3id.org/linkml/permissible_values" : [ {
    "@id" : "https://w3id.org/tvbo/NoiseDraw#blocked"
  }, {
    "@id" : "https://w3id.org/tvbo/NoiseDraw#fused"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/NoiseDraw#blocked",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "blocked (NoiseDraw)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/NoiseDraw"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Regenerate each block's noise from the key and the block index. The realization never depends on the total step count, so a run measured by folding an observable in-carry and the same run materialized in full agree sample for sample. Holds no O(n_steps) noise tensor, and regenerates rather than stores on the backward pass. Keyed by Integrator.block_size."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "blocked"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/NoiseDraw#fused",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "fused (NoiseDraw)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/NoiseDraw"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Draw the whole [n_steps, n_noise_states, n_nodes] tensor once from the key. Fuses with the scan, but the realization is a function of the step count, so the same recipe measured two ways gives two trajectories, and the tensor costs as much memory as the trajectory it drives."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "fused"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/NoiseType",
