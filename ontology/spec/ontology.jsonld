  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Default tier a sweep axis is placed on when it is not named explicitly in a DistributionConfig. Vectorized axes are packed into one batched backend call; workflow axes are fanned out into independent scheduler tasks."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "https://w3id.org/linkml/permissible_values" : [ {
    "@id" : "https://w3id.org/tvbo/WorkflowDistributeBy#auto"
  }, {
    "@id" : "https://w3id.org/tvbo/WorkflowDistributeBy#vectorize"
  }, {
    "@id" : "https://w3id.org/tvbo/WorkflowDistributeBy#workflow"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/WorkflowDistributeBy#auto",
