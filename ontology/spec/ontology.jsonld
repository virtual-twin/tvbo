  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Unified class for all observation/measurement specifications. Covers monitors (BOLD, EEG), tuning observables, and derived quantities. Pipeline is a sequence of Functions with input -> output flow."
  } ],
