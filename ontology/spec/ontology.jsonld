    "@value" : "Whether one best iterate is chosen over the whole run (run, the default) or one per stage, restored before the next stage starts (stage)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
