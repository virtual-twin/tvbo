  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(M2*(cos(phi)*(L1*omega1**2*sin(phi) + G*sin(theta2)) + L2*omega2**2*sin(phi)) - (M1 + M2)*G*sin(theta1))/(L1*Delta)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/DoublePendulum/state_variables/omega2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
