  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tau_s"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "ms"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/w",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Excitatory recurrence strength (local feedback)"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.5"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "w (ReducedWongWangTvboptim parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Local excitatory recurrence strength. Controls the positive feedback within each cortical population. Higher values increase local excitation and push the system toward higher firing rates."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "w"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "dimensionless"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWangTvboptim/state_variables/S",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Average NMDA synaptic gating variable, representing the fraction of open NMDA channels at each network node."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "S (ReducedWongWangTvboptim state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "S"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(S, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-S/tau_s + (1 - S)*H(x)*gamma"
  } ]
