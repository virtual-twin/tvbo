  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/NodeReconciliation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Restrict to the shared node labels by name (keyed ``.sel``), preserving the consuming network's order, on every node axis (a vector on its node axis, a matrix on both). Never positional."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "by_label"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/NodeReconciliation#none",
