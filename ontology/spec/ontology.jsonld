    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "mu_se (CakanObermayer state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "mu_se"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(mu_se, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(J_EE*r_E + J_EI*r_I + mu_E + c_glob - I_A_var/C - mu_se)/tau_se"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/CakanObermayer/state_variables/mu_si",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Filtered mean synaptic input current to the inhibitory population."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "mu_si (CakanObermayer state variable)"
