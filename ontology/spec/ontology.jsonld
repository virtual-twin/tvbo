    "@value" : "Mathematically derived mean-field models obtained by exact reduction of spiking networks (Ott-Antonsen ansatz, Lorentzian heterogeneity, etc.). Examples: MontbrioPazoRoxin, CoombesByrne, ReducedWongWang, ZerlautAdaptationFirstOrder."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "mean_field"
  } ]
}, {
