  } ]
}, {
  "@id" : "https://w3id.org/tvbo/correlated_over",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "correlated_over (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Which axis `covariance` indexes — `node` (equivalently `region`) for spatially correlated drive, or `state` for correlation between the noise on different state variables. Required whenever `covariance` is set: a covariance without a named axis does not identify a process. A multi-mode model carries its modes inside the state axis, so a modal covariance is declared over `state`."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "correlated_over"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/correlation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "correlation (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "correlation"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/coupling",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "https://w3id.org/tvbo/coupling_evaluation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "coupling_evaluation (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Backend-neutral numerical treatment of the network coupling term across the stages of a multi-stage integrator (Heun, RK4, ...): re-evaluated at every stage (per_stage — standard ODE accuracy) or computed once per step and held constant across stages (per_step — a TVB-style efficiency shortcut). Single- stage methods (Euler) and always-recompute solvers (diffrax) ignore it. per_stage is required to match reference integrators for stiff / chaotic / multistable systems, where the frozen- coupling error can select a different trajectory or attractor. See CouplingStageEvaluation."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "coupling_evaluation"
  } ]
