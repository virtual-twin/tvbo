  } ]
}, {
  "@id" : "https://w3id.org/tvbo/producer",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "producer (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "http://www.w3.org/ns/prov#wasGeneratedBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "HOW to compute this parameter's value, when it is derived rather than obtained — the callable that produces it, its arguments, and (via `output:`) which entry to take from a callable returning several named arrays. The callable resolves against the recipe's `code_source`. Use instead of `source:` for a value that is a deterministic function of the spec's own inputs (a mesh operator, a template matrix): declaring the producer keeps the spec the single source of truth, where pointing at a pre-built file would let the two drift apart silently. The result is cached and invalidated by the artifact fingerprint, so it is computed once rather than per run. Mutually exclusive with `value:`/`source:`."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "producer"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/provenance",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "provenance (slot)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/tvbo/Provenance"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "http://www.w3.org/ns/prov#wasGeneratedBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "W3C PROV-O aligned provenance for this entity — what it was derived from, which agent produced it, and when."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "provenance"
  } ]
