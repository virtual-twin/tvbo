  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
