  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "One kind of study the layout accounts for. A template is a *specialisation*: it names the entries a kind adds to the study every kind already shares, and nothing else. The general study is therefore not a template and names none — a kind earns an entry here only once some directory or file genuinely belongs to it and not to the rest."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/study"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "StudyTemplate"
  } ]
