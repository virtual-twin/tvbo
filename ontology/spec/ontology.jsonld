  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "eta2"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/StommelThermohaline/parameters/eta3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Salinity damping coefficient η₃."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.3"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "eta3 (StommelThermohaline parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "eta3"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/StommelThermohaline/state_variables/S",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "S (StommelThermohaline state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "S"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(S, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "eta2 - eta3*S - abs(T - S)*S"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/StommelThermohaline/state_variables/T",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "T (StommelThermohaline state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "T"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(T, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "eta1 - T - abs(T - S)*T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/StuartLandauOscillator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Normal form of supercritical Hopf bifurcation in Cartesian coordinates; radius\ndynamics decouple giving stable limit cycle of radius sqrt(mu) for mu > 0."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Landau1944"
