  } ]
}, {
  "@id" : "https://w3id.org/tvbo/GraphRepresentation#auto",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/struct"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "auto (GraphRepresentation)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/GraphRepresentation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Select by connection density: use the sparse representation when the adjacency is sparse enough that edge-wise evaluation is cheaper than the dense product, dense otherwise. Default. Lets the backend apply its own crossover without the recipe hard-coding a data structure."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "auto"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/GraphRepresentation#dense",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/struct"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "dense (GraphRepresentation)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/GraphRepresentation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Force the dense-adjacency representation. Preferred for densely connected or small networks, where dense linear algebra's constant-factor efficiency outweighs its nodes-squared scaling."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "dense"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/GraphRepresentation#sparse",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/struct"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sparse (GraphRepresentation)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/GraphRepresentation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Force the edge-list (sparse) representation. Preferred for large, sparsely connected networks (structural connectomes, power grids) where coupling cost then scales with the number of edges rather than nodes-squared."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sparse"
  } ]
}, {
