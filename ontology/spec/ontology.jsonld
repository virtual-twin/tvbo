  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(-E + SS1)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/TsodyksMarkram/state_variables/u",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Synaptic facilitation variable (release probability). Decays to U0 with time constant tauF and is enhanced proportionally to firing."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
