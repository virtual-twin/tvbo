    "@value" : "gather (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Observer parameter ``(n_groups, n)`` of node indices selecting each group's nodes out of the whole-source signal; its leading axis is the group count."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
