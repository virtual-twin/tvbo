  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "z (LorenzDiffusionless state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "z"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(z, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "x*y - R"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/LotkaVolterraPredPrey",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The famous Lotka-Volterra model is a simple ecological model describing the interaction\nbetween a predator and a prey species (or also parasite and host species). It has been\nused independently in epidemics, ecology, and economics. The prey (x) grows\nexponentially in absence of predators; predation converts prey into predator growth;\npredator (y) declines without prey. Default parameters produce sustained oscillations."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Hoppensteadt2006"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "LotkaVolterraPredPrey"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/LotkaVolterraPredPrey/parameters/alpha"
  }, {
    "@id" : "https://w3id.org/tvbo/models/LotkaVolterraPredPrey/parameters/beta"
  }, {
    "@id" : "https://w3id.org/tvbo/models/LotkaVolterraPredPrey/parameters/delta"
  }, {
    "@id" : "https://w3id.org/tvbo/models/LotkaVolterraPredPrey/parameters/gamma"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/LotkaVolterraPredPrey/state_variables/x"
  }, {
    "@id" : "https://w3id.org/tvbo/models/LotkaVolterraPredPrey/state_variables/y"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "generic"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/LotkaVolterraPredPrey/parameters/alpha",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Prey intrinsic growth rate α."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.5"
