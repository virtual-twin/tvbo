}, {
  "@id" : "https://w3id.org/tvbo/backend",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "backend (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Execution backend this experiment runs on when no backend is passed explicitly (e.g. 'tvboptim', 'tvb', 'jax', 'julia', 'brian2'). Declares the engine the experiment requires — a spiking point-neuron network sets 'brian2', a mean-field model leaves it unset. run(format=...) and ``tvbo run --backend`` override it; when unset the default backend (tvboptim) is used."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "backend"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/backendParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Concrete backend parameter that realises a backend-neutral tvbo term (e.g. the tvboptim solver keyword an evaluation scheme lowers to). Documentary: states how a value is enacted per backend without binding tvbo to any one of them."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "backend parameter"
  } ]
