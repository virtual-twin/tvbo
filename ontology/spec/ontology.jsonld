  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "subdir"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/subject_id",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "subject_id (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "BIDS subject identifier."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "subject_id"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/subjects",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "subjects (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Ordered list of subject IDs (e.g. HCP-YA 6-digit IDs). Each ``measures/<name>`` array in the h5 companion is indexed by this order."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "subjects"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/subnetwork",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "subnetwork (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Optional finer-scale Network that \"lives inside\" this Node (network-of-networks / multi-scale primitive). The subnetwork's nodes map (one-to-many) to this single parent Node. Cross-scale signal flow is declared as ordinary Edges in the subnetwork's `edges` list, using `source_network` / `target_network` with the `parent` sentinel to traverse up the hierarchy. The subnetwork may carry its own `graph_generator` (discrete sub-network — reservoir, spiking population, jaxley compartments) and/or `mesh` (continuous surface field) — one unified slot for reservoirs-per-region, spiking-populations-per-region, cells-per-region, and surface-mesh-patches-per-region. Recursive: a subnetwork's Nodes can themselves carry subnetworks."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "subnetwork"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/suffix",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "suffix (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "BIDS suffix (e.g., relmat), the trailing name component before the extension"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "suffix"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/supportsTask",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/tvbo/Backend"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "supports task"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationTask"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/surrogate",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "surrogate (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Optional permutation-significance test: this derived variable's value is the exceedance p-value of a named statistic under permutations of a field (a general surrogate null — any permutation test, not wave-specific — emitted as a vmap-fold over the captured permutations; the wrapped statistic stays symbolic). When set, the variable's own ``equation`` may be omitted."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "surrogate"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/surrogate_of",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "General grounding relation: the subject (parameter, state variable, model, ...) is a surrogate / abstraction / model of an external ontology term (typically GO, ChEBI, UBERON, CL, MeSH). The target term's own ontology carries the specificity, so no per-domain relation is required. Populated inline from the LinkML `grounding` slot; the `models*` properties below are sub-properties that refine the range."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "surrogate of"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/sweep_direction",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sweep_direction (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Order in which a branch-following axis (sweep_seeding: from_previous) is traversed: 'up' increases the parameter once, 'down' decreases it once, 'bidirectional' increases then decreases over the same values and records both branches — a hysteresis loop where they differ. Ignored when sweep_seeding is 'independent'. Applies to a single swept axis."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sweep_direction"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/sweep_seeding",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sweep_seeding (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "How each sweep point's initial state is obtained. 'independent' (default) cold-starts every point from the model's initial values, so points are order-independent and may run in parallel (see parallel_mode). 'from_previous' seeds each point from the final state of the preceding point, so the trajectory follows the solution branch as the swept parameter changes quasi-statically; this forces sequential execution (a scan, not a vmap) and, with sweep_direction, exposes hysteresis / multistability. It is forward-integration branch following, not numerical continuation (cf. the Continuation class)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sweep_seeding"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/symbol",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "symbol (slot)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "symbol"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/symmetry",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "symmetry (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Edge symmetry type for NetworkDynamics.jl EdgeModel: 'directed' (default), 'antisymmetric', or 'symmetric'. AntiSymmetric edges flip sign for the reverse direction."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "symmetry"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/system_size",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "system_size (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "System size (van Kampen Ω) for the stochastic 'gillespie' backend: the number of discrete units per unit of the activity variable, and the sole source of noise. Runs a mean-field rate model as a finite birth-death process (Gillespie SSA): the activity state variable X becomes a discrete count n ≈ Ω·X, its relaxation equation tau*X' = -X + F(...) is read as birth propensity Ω·F/tau (the gain) and death propensity n/tau (the leak), while the remaining state variables integrate deterministically between events. Larger Ω means finer discreteness and weaker fluctuations, recovering the deterministic mean field as Ω→∞. For an activity already expressed as a fraction in [0,1], Ω is the population size N; for a firing rate it is N divided by the rate at full activation. Required by the 'gillespie' backend; ignored by every other backend."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "system_size"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/system_type",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "system_type (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "system_type"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/tail_samples",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tail_samples (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Number of samples from the end to use. Takes the last N samples before aggregation. E.g., tail_samples: 500 means use data[-500:]."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tail_samples"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/target",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "https://w3id.org/tvbo/target_component",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "target_component (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Component to attach this event to. Can be a node label, edge label, or 'all_edges'/'all_vertices' for broadcast. If not specified, event is experiment-level."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "target_component"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/target_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "target_data (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Reference to empirical data observation for matching objectives"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "target_data"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/target_network",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "target_network (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Path or name of the Network whose nodes define the target endpoints (e.g. the columns of a non-square projection matrix such as a gain matrix region → EEG sensors). Also accepts the relative-path sentinel `parent` / `parent/parent` for cross-scale signal flow up the Node.subnetwork hierarchy. One mechanism handles both projection matrices (absolute IRI) and multi-scale boundaries (sentinel)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "target_network"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/target_parameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "target_parameter (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The parameter to update (e.g., J_i, wLRE)"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "target_parameter"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/target_range",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "target_range (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Target interval for a `minmax_rescale` step (e.g. lo -1, hi 1)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "target_range"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/target_regions",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "target_regions (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Regions a stimulus-type event targets: 'all' (broadcast to every node) or explicit region labels / indices. More expressive than the integer-only `regions` slot; when both are absent the event applies to all regions."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "target_regions"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/target_value",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "target_value (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Target value for activity objectives"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "target_value"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/target_var",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "target_var (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "target_variable"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Input variable on target node to connect to (e.g., 'c_in'). If not specified, uses first coupling input from target dynamics. The alias `target_variable` is accepted."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "target_var"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/target_variable",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ]
}, {
  "@id" : "https://w3id.org/tvbo/targets",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "targets (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "State variables this noise applies to; if omitted, applies globally."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "targets"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/task_iri",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "task_iri (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Cognitive Atlas (``cogat:``) IRI of the assessment instrument / task that produced this measure (e.g. ``cogat:trm_4a3fd79d09cba`` for PMAT24)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "task_iri"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/task_name",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "task_name (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "BIDS task name for the simulation (e.g., 'rest', 'simulation')."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "task_name"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/template",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "template (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "BIDS tpl- entity (e.g., FSLMNI152, MNI152NLin2009cAsym)"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "template"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/tensor_coefficient",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tensor_coefficient (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Optional anisotropic tensor (e.g., diffusion)."
