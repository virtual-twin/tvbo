}, {
  "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3SlowMod/derived_variables/nu",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Bifurcation parameter nu along the great arc (E, F, R) at slow variable z."
  } ],
