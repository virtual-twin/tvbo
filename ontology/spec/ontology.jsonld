  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "constructor_args (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Arguments passed to __init__ when instantiating the class. Example: period=1000.0, downsample_period=4.0 for Bold monitor."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "constructor_args"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/container",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "container (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Container image wrapping each task; tasks run as ``<runtime> exec <image> …``. A concrete image passes through as given — either a registry reference the engine resolves and materialises itself (``docker://…:tag``) or a path to an image file already built on the target, which pins the exact image and needs no pull. A reference that leaves the version open is resolved to the tvbo image matching the running CLI: the symbolic value ``tvbo``, or a tvbo registry reference with no ``:tag``. Left unset while ``requirements`` are declared, the base still defaults to that tvbo image (the deps layer onto it); unset with no requirements, tasks run bare."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "container"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/container_args",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "container_args (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Additional arguments passed verbatim to the container runtime when it executes a task. The extension point for runtime flags the typed fields do not cover, mirroring ``WorkflowEngineConfig.options`` for scheduler directives."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "container_args"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/container_binds",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "container_binds (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Host paths that must be visible inside the container beyond the ones its runtime binds by default (typically ``$HOME`` and the working directory). Required whenever a task reads or writes a site filesystem outside those defaults — a shared cache, a data tree, or a scratch area a symlink resolves into. Rendered into each runtime's own flag (``--bind`` for Apptainer/Singularity)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "container_binds"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/continuation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "continuation (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Override solver settings for this branch. Uses the same Continuation type — only explicitly set attributes override the parent's values."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "continuation"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/continuations",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "continuations (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Numerical continuation and bifurcation analysis specifications. Each entry defines a continuation experiment (equilibrium branch, codim-2 curve, periodic orbit family, etc.).            # Either reference a full reusable environment (preferred) or, for"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "continuations"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/continuations/Generic2dOscillator-bifurcation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Continue the equilibrium branch of the Generic2dOscillator as parameter a is varied. Detect Hopf bifurcations and continue periodic orbits from all Hopf points."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Continuation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "eq_in_a"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/continuations/Generic2dOscillator-bifurcation-full",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Comprehensive bifurcation analysis of the Generic2dOscillator. Continues the equilibrium branch as parameter a is varied, detects fold and Hopf bifurcations, then branches to periodic orbits from both Hopf points with fine-tuned solver settings."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Continuation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "eq_in_a_full"
  } ]
}, {
