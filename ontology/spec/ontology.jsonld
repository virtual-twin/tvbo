  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tau (EpileptorRestingState parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Temporal scaling coefficient in the fifth state-variable y2."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/parameters/tau_rs",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Temporal scaling coefficient in the third population (x_rs, y_rs)"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tau_rs (EpileptorRestingState parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Temporal scaling coefficient in the third population (x_rs, y_rs)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tau_rs"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/parameters/tt",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Time scaling of the Epileptor"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tt (EpileptorRestingState parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Time scaling of the Epileptor."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tt"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/parameters/x0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Epileptogenicity parameter"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "-1.6"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x0 (EpileptorRestingState parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Epileptogenicity parameter."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x0"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/state_variables/g",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "g (EpileptorRestingState state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "g"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(g, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(-0.01*g + 0.001*x1)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/state_variables/x1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x1 (EpileptorRestingState state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x1, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(Iext + Kvf*c_glob0 + local_coupling*x1 + x1*x1cond + y1 - z)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/state_variables/x2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x2 (EpileptorRestingState state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x2, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(Iext2 + Kf*c_glob1 + bb*g - x2**3 + x2 - y2 - 0.3*z + 1.05)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/state_variables/x_rs",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x_rs (EpileptorRestingState state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x_rs"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x_rs, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "d_rs*tau_rs*(I_rs*gamma_rs + K_rs*c_glob2*gamma_rs + alpha_rs*y_rs + e_rs*x_rs**2 - f_rs*x_rs**3 + lc_1)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/state_variables/y1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y1 (EpileptorRestingState state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y1, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(c - d*x1**2 - y1)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/state_variables/y2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y2 (EpileptorRestingState state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y2, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(-y2 + y2cond)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/state_variables/y_rs",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y_rs (EpileptorRestingState state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y_rs"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y_rs, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "d_rs*(a_rs + b_rs*x_rs - beta_rs*y_rs)/tau_rs"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/state_variables/z",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "z (EpileptorRestingState state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "z"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(z, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "r*tt*(Ks*c_glob0 - 4*x0 + 4*x1 - z + zcond)"
  } ]
}, {
