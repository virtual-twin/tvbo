  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "executor"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/exhibitsBifurcation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Range is a reified BifurcationEvent that records the bifurcation type, the locus parameter, and (optionally) the critical value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "exhibits bifurcation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/tvbo/BifurcationEvent"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/exhibitsRegime",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Object is a Regime class (open-world: model may admit additional regimes for parameter values not yet catalogued)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "exhibits regime"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiment",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "experiment (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "WHERE (short form): an in-study experiment id whose saved result holds the array, resolved within the enclosing study like ``initial_state.source_experiment``. Mutually exclusive with ``iri`` (the full cross-study / curated / external form). When both are absent the reference is local — ``output`` names this experiment's own output — otherwise falling back to ``initial_state.source_experiment`` when present."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/common"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "experiment"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiment_yaml_hash",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "experiment_yaml_hash (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "SHA-256 hex digest of the normalised experiment YAML that produced this artifact. Used by the cross-experiment cache (see :class:`SimulationStudy.from_file`) to detect when a cached upstream result has gone stale because the experiment's spec was edited. Computed as ``hashlib.sha256(yaml.safe_dump(normalized_yaml).encode()).hexdigest()`` over the fully resolved (post-``!include``) experiment block."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "experiment_yaml_hash"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/Delay_Speed_Synchronization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Coupled Kuramoto phase oscillators on the Desikan-Killiany connectome. A sweep over the conduction speed varies the transmission delays (delays = tract length / speed) and measures the Kuramoto order parameter, reproducing the non-monotonic delay-organised synchronization of Petkoski & Jirsa (2019).\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Delays Shape Synchronization"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/EI_Tuning_FIC_EIB_Optimization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Fitting functional connectivity using the two-population Reduced Wong-Wang model with explicit excitatory and inhibitory populations. Combines Feedback Inhibition Control (FIC) to maintain local E-I balance with EIB tuning to globally optimize network connectivity. Supports both iterative (FIC+EIB) and gradient-based optimization approaches.\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "EI Tuning: Functional Connectivity Fitting"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/Hopf_Pareto_ParallelOpt",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Fit a delay-coupled SupHopf network to two competing targets — empirical FC and a spatial peak-frequency gradient — replicating tvboptim Hopf_Pareto_ParallelOpt. Stage 0: NSGA-II genetic pre-search over (G, a, log10 sigma). Stage 1: parallel gradient refinement from every Pareto seed. Byte-identical to the reference workflow.\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Hopf Pareto: FC vs Frequency-Gradient (NSGA-II + parallel refinement)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/JR_MEG_FrequencyGradient_Optimization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Reproducing MEG Resting-State Frequency Gradients with Network Dynamics. This experiment fits region-specific Jansen-Rit parameters to reproduce the empirical frequency gradient from visual cortex (11 Hz) to association areas (7 Hz).\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "JR Peak Frequency Optimization"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/RWW_BOLD_FC_Optimization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Fitting functional connectivity using the Reduced Wong-Wang model. Two-stage optimization: global parameters first, then regional heterogeneity. Based on tvboptim RWW.qmd tutorial.\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "RWW Functional Connectivity Fitting"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/RateML_ReducedWongWang",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "RateML rwongwang ground truth"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/Stimulation_Bayesian_Inference",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Recover stimulus amplitude and excitability I of a pulse-driven Generic2dOscillator from one noisy recording, via numpyro NUTS/MCMC. Three prior scenarios steer the posterior along the amplitude/excitability degeneracy ridge. Replicates tvboptim.\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Bayesian Inference (Stimulation)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/experiments/TBPTT_JansenRit_FC_Optimization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Truncated backprop-through-time for a chaotic Jansen-Rit network. Fits global coupling G to empirical FC; contrasts full-BPTT vs windowed (grad_horizon) gradients. Based on tvboptim TBPTT.qmd.\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TBPTT Jansen-Rit FC Fitting"
  } ]
