  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "omega (SupHopf parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Angular frequency."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "omega"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/SupHopf/state_variables/x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "First state-variable of the Supercritical Hopf model"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x (SupHopf state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "c_glob0 + lc_0 - omega*y + x*(a - x**2 - y**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/SupHopf/state_variables/y",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second state-variable of the Supercritical Hopf model"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y (SupHopf state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "c_glob1 + omega*x + y*(a - x**2 - y**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/SupercriticalHopf",
