  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Steepness of the sigmoidal transformation [mV^-1]."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "rho_1"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZetterbergJansen/parameters/rho_2",
