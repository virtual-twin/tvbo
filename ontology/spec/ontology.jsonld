    "@value" : "s_i"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "c_i/(1.0 + exp(-a_i*(-b_i + x_i))) - 1.0*shift_sigmoid/(exp(a_i*b_i) + 1.0)"
