    "@value" : "Derivative(y5, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Hi*gamma_5*ki*sigma_v45 - ke**2*v5 - 2*ki*y5"
  } ]
