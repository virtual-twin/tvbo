    "@value" : "AlgorithmCompositionMode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid289"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "How an included algorithm is composed with the outer algorithm. Determines whether the inner algorithm's update rules are merged into the same loop (combined) or run as a converging inner loop on each outer iteration (nested)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "https://w3id.org/linkml/permissible_values" : [ {
    "@id" : "https://w3id.org/tvbo/AlgorithmCompositionMode#combined"
  }, {
    "@id" : "https://w3id.org/tvbo/AlgorithmCompositionMode#nested"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/AlgorithmCompositionMode#combined",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "combined (AlgorithmCompositionMode)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/AlgorithmCompositionMode"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The included algorithm's update rules are merged into the outer loop and applied ONCE per outer iteration (1:1). Use when both algorithms update at the same cadence on the same observations. This is the default."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "combined"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/AlgorithmCompositionMode#nested",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "nested (AlgorithmCompositionMode)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/AlgorithmCompositionMode"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The included algorithm runs as a full inner loop on EACH outer iteration, re-converging before the outer update rules are applied. Use when the inner algorithm maintains an invariant the outer one would otherwise perturb — e.g. FIC holding the E-I working point (mean S_e = 0.25) while EIB retunes per-edge coupling. The outer update's validity depends on that invariant, so the inner loop must re-settle it between every outer step."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "nested"
  } ]
