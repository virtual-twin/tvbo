    "@value" : "initialConcentration"
  }, {
    "@value" : "initialExtConcentration"
  }, {
    "@value" : "surfaceArea"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/connection",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Event connection directly between named components, which gets processed via a new instance of a _synapse component which is created on the target component. Normally contained inside a _projection_ element."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
