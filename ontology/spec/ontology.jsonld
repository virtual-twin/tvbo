  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/StuartLandauOscillator/parameters/b"
  }, {
    "@id" : "https://w3id.org/tvbo/models/StuartLandauOscillator/parameters/mu"
  }, {
    "@id" : "https://w3id.org/tvbo/models/StuartLandauOscillator/parameters/omega"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
