  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "E (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "E"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(E, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(TFe - E + 0.5*C_ee*d2_fefe_e + 0.5*C_ei*d2_fefi_e + 0.5*C_ei*d2_fife_e + 0.5*C_ii*d2_fifi_e)/T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/ZerlautAdaptationSecondOrder/state_variables/I",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Firing rate of the inhibitory population [kHz]."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "I (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "I"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(I, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(TFi - I + 0.5*C_ee*d2_fefe_i + 0.5*C_ei*d2_fefi_i + 0.5*C_ei*d2_fife_i + 0.5*C_ii*d2_fifi_i)/T"
  } ]
}, {
