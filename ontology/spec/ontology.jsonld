  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "gamma_5"
  } ],
  "https://w3id.org/tvbo/surrogate_of" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CL_0000099"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZetterbergJansen/parameters/ke",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Reciprocal of the time constant of passive membrane and all         other spatially distributed delays in the dendritic network [ms^-1]"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.1"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ke (ZetterbergJansen parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Reciprocal of the time constant of passive membrane and all\n        other spatially distributed delays in the dendritic network [ms^-1].\n        Also called average synaptic time constant."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "ke"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZetterbergJansen/parameters/ki",
