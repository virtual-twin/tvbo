  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Excitatory population firing rate. In full aLN this is ``Phi(mu_E_eff, s_EE)`` with ``Phi`` precomputed; here a sigmoid stand-in is used."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
