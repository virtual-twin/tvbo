  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The envelope of a record written as its own file. ``tvbo_class`` names the class the file holds and ``schema_version`` the schema it was written against; both are facts about the file, so TVBO's dialect drops them before construction and no object ever carries them. Declaring them here is what lets a third party validate a TVBO file with plain ``linkml-validate``. A class taking this mixin pins its own CURIE with ``slot_usage: {tvbo_class: {equals_string: ...}}``, so a file naming the wrong class is refused natively."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/common"
  } ]
