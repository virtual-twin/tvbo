  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Ten-dimensional explicit expansion of the Lorenz-96 system: dx_i/dt = (x_{i+1} - x_{i-2}) x_{i-1} - x_i + F\nwith cyclic indices modulo N (here N=10 unrolled to avoid symbolic indexing that the\ncurrent parser cannot interpret). Initial conditions follow the Julia reference\ndefault u0 = range(0; length=N, step=0.1) i.e. x_i(0) = 0.1*i."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Lorenz1996"
  } ],
