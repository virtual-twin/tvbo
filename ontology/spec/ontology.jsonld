}, {
  "@id" : "https://w3id.org/tvbo/graph_generators/WeightShuffle",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Derived generator: load a reference adjacency by IRI and permute its non-zero entries, holding one structural property fixed. Used for null-model controls (e.g. a shuffled SC matrix that keeps the source's density and weight multiset while randomising which edge carries which weight)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/GraphGenerator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "WeightShuffle"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/graph_generators/WeightShuffle/parameters/preserve"
  }, {
    "@id" : "https://w3id.org/tvbo/graph_generators/WeightShuffle/parameters/source"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/graph_generators/WeightShuffle/parameters/preserve",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Which structural property to hold fixed under permutation. Only `binary_mask` is implemented: keep the {0, nonzero} pattern and permute the weight values among their existing positions, so density and topology stay fixed while the weight-to-edge assignment is randomised. Any other value is rejected — a null model that silently controlled a different property than the one asked for would invalidate the comparison it exists to support."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "preserve (WeightShuffle parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "preserve"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/graph_generators/WeightShuffle/parameters/source",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "IRI of the reference Network whose weights matrix is shuffled."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "source (WeightShuffle parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "source"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/graph_representation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "graph_representation (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Representation used to evaluate coupling over this network's connectivity (``auto`` | ``dense`` | ``sparse``). ``auto`` lets the backend choose by connection density. This names whether to exploit edge sparsity, not a concrete data structure, so it is backend-independent; the delayed-vs-instantaneous graph kind is decided separately from the couplings' conduction delays."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "graph_representation"
  } ]
}, {
