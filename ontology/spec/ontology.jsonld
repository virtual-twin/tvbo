    "@value" : "Coefficient of the squared term in the first state variable."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "b"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Epileptor/parameters/bb",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Linear coefficient of lowpass excitatory coupling in the fourth state variable x2."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "2.0"
