  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "s (Epileptor5D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Linear coefficient in the slow permittivity state-variable z_E5D in Epileptor5D (Jirsa et al.,2014)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "s"
  } ]
