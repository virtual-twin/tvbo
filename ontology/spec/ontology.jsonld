    "@id" : "http://purl.obolibrary.org/obo/UBERON_0000956"
  }, {
    "@id" : "http://purl.obolibrary.org/obo/UBERON_0002728"
  } ],
  "https://w3id.org/tvbo/phaseSpaceDimension" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "8"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/derived_variables/lc_1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "lc_1 (EpileptorRestingState derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "lc_1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "lc_1"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "local_coupling*x_rs"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/derived_variables/output",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "output (EpileptorRestingState derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "output"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "output"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "p*(-x1 + x2) + x_rs*(1 - p)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/derived_variables/x1cond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x1cond (EpileptorRestingState derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "x1cond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise(((-a)*x1**2 + b*x1, x1 < 0), (slope - x2 + 0.6*(z - 4.0)**2, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/derived_variables/y2cond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y2cond (EpileptorRestingState derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y2cond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "y2cond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((0.0, x2 < -0.25), (aa*(x2 + 0.25), True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/derived_variables/zcond",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "zcond (EpileptorRestingState derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "zcond"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "zcond"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((-0.1*z**7, z < 0), (0.0, True))"
  } ]
}, {
