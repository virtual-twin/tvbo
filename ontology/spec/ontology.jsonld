  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "phase_oscillator"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/StuartLandauOscillator/parameters/b",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Nonlinear frequency shift coefficient b."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "b (StuartLandauOscillator parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "b"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/StuartLandauOscillator/parameters/mu",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Linear growth (bifurcation) parameter μ."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "mu (StuartLandauOscillator parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "mu"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/StuartLandauOscillator/parameters/omega",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Base angular frequency ω."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "omega (StuartLandauOscillator parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "omega"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/StuartLandauOscillator/state_variables/x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x (StuartLandauOscillator state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "x*(mu - x**2 - y**2) - omega*y - b*(x**2 + y**2)*y"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/StuartLandauOscillator/state_variables/y",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y (StuartLandauOscillator state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "y*(mu - x**2 - y**2) + omega*x + b*(x**2 + y**2)*x"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/SupHopf",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Supercritical Hopf (SUPH) is an oscillatory/excitable neural mass model that describe the normal form of a supercritical Hopf bifurcation in Cartesian coordinates (Kuznetsov, 2013; Deco et al., 2017). \n\nThis normal form has a supercritical bifurcation at 'a=0' with 'a' the bifurcation parameter in the model. So for 'a < 0', the local dynamics has a stable fixed point and the system corresponds to a damped oscillatory state, whereas for 'a > 0', the local dynamics enters in a stable limit cycle and the system switches to an oscillatory state."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Deco2017"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "SupHopf"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Supercritical Hopf"
  } ],
  "https://w3id.org/tvbo/exhibitsBifurcation" : [ {
    "@id" : "_:genid5077"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Oscillatory"
  }, {
    "@id" : "https://w3id.org/tvbo/Quiescent"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/FixedPoint"
  }, {
    "@id" : "https://w3id.org/tvbo/LimitCycle"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/SupHopf/derived_variables/lc_0"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/SupHopf/parameters/a"
  }, {
    "@id" : "https://w3id.org/tvbo/models/SupHopf/parameters/omega"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/SupHopf/state_variables/x"
  }, {
    "@id" : "https://w3id.org/tvbo/models/SupHopf/state_variables/y"
  } ],
  "https://w3id.org/tvbo/hasStochasticityCharacter" : [ {
    "@id" : "https://w3id.org/tvbo/Deterministic"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "generic"
  } ],
  "https://w3id.org/tvbo/phaseSpaceDimension" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "2"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/SupHopf/derived_variables/lc_0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "lc_0 (SupHopf derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "lc_0"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "lc_0"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "local_coupling*x"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/SupHopf/parameters/a",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Local bifurcation parameter"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "-0.5"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "a (SupHopf parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Local bifurcation parameter."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "a"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/SupHopf/parameters/omega",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Angular frequency"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "omega (SupHopf parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Angular frequency."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "omega"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/SupHopf/state_variables/x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "First state-variable of the Supercritical Hopf model"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x (SupHopf state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "c_glob0 + lc_0 - omega*y + x*(a - x**2 - y**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/SupHopf/state_variables/y",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second state-variable of the Supercritical Hopf model"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y (SupHopf state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "c_glob1 + omega*x + y*(a - x**2 - y**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/SwingingAtwood",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The swinging Atwood machine couples a pendulum to a vertically moving mass via a\nsingle inextensible string over a pulley. Competing exchanges between vertical and\nangular motion create a rich mixed phase space with coexisting regular islands and\nchaotic seas, providing a canonical laboratory example of low-dimensional Hamiltonian\nchaos and resonance overlap."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Tufillaro1992"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "SwingingAtwood"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/SwingingAtwood/derived_variables/energy"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/SwingingAtwood/parameters/g"
  }, {
    "@id" : "https://w3id.org/tvbo/models/SwingingAtwood/parameters/l"
  }, {
    "@id" : "https://w3id.org/tvbo/models/SwingingAtwood/parameters/m1"
  }, {
    "@id" : "https://w3id.org/tvbo/models/SwingingAtwood/parameters/m2"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/SwingingAtwood/state_variables/omega"
  }, {
    "@id" : "https://w3id.org/tvbo/models/SwingingAtwood/state_variables/theta"
  }, {
    "@id" : "https://w3id.org/tvbo/models/SwingingAtwood/state_variables/v"
  }, {
    "@id" : "https://w3id.org/tvbo/models/SwingingAtwood/state_variables/y"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "generic"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/SwingingAtwood/derived_variables/energy",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "energy (SwingingAtwood derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "energy"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "energy"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "0.5*m1*(l**2*omega**2 + v**2 + 2*l*v*omega*sin(theta)) + 0.5*m2*v**2 + m1*g*l*(1 - cos(theta)) + (m1 + m2)*g*y"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/SwingingAtwood/parameters/g",
