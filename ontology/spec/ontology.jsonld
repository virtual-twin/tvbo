  "@id" : "https://w3id.org/tvbo/correlated",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "correlated (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Deprecated. Whether the noise is correlated, without saying across which axis or by how much. Use `covariance` + `correlated_over`."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "correlated"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/correlated_over",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "correlated_over (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Which axis `covariance` indexes — `node` (equivalently `region`) for spatially correlated drive, or `state` for correlation between the noise on different state variables. Required whenever `covariance` is set: a covariance without a named axis does not identify a process. A multi-mode model carries its modes inside the state axis, so a modal covariance is declared over `state`."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "correlated_over"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/correlation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "correlation (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "correlation"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/count",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "count (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A structural tally computed from the specification, not a run: ``<study>.<collection>`` counts a collection on a nested study named by its citekey or label (e.g. ``Jansen1995.figures``), resolved at any depth, or a bare ``<collection>`` counts one on the study holding the binding (e.g. ``studies``). Mutually exclusive with ``used`` and ``value``."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "count"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/coupling",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "coupling (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "coupling"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/coupling_evaluation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "coupling_evaluation (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Backend-neutral numerical treatment of the network coupling term across the stages of a multi-stage integrator (Heun, RK4, ...): re-evaluated at every stage (per_stage, standard ODE accuracy) or computed once per step and held across the stages (per_step, the TVB scheme). A single-stage method (Euler) and a single node integrate the same system under both. tvboptim's native solvers, NetworkDynamics.jl and the jax backend honour both values, the jax backend per_stage over an undelayed coupling only; TVB and the Python graph runner integrate per_step and refuse per_stage, and tvboptim's diffrax solvers and PyRates always integrate per_stage, whatever is declared (CouplingStageEvaluation states each value's behaviour). per_stage is required to match reference integrators for stiff, chaotic or multistable systems, where the frozen-coupling error can select a different trajectory or attractor."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "coupling_evaluation"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/coupling_function",
