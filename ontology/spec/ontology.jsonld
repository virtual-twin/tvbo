  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Hardware accelerator the run targets. 'auto' (default) lets JAX detect the machine — GPU/TPU when present, else CPU; 'cpu', 'gpu', or 'tpu' pin the JAX platform explicitly. tvbo maps this to JAX_PLATFORMS before JAX initialises (an existing JAX_PLATFORMS in the environment still wins); tvboptim then spreads work across that platform's devices via n_pmap/n_vmap. In a workflow kit, 'gpu' also makes the experiment's rule request a SLURM gres unless one is set."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "accelerator"
  } ]
