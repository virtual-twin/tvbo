  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "trailing"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/transform",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "transform (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "transform"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/transforms",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "transforms (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Ordered list of transforms applied to edge property matrices. Each entry rewrites the edge property its `output:` names, else the one its `name:` is (e.g. 'weight', 'length'), and that property is also the value under transform inside the entry's own equation, which is written over the network's edge attributes. Supports equation-based (symbolic) or callable-based (software) transforms. Multiple transforms on the same target are applied sequentially, each seeing the previous one's output; since `name:` identifies an entry, each after the first states the target as its `output:`."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "transforms"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/transient_time",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "transient_time (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Length of the leading settling window, prepended to `duration`. It marks part of ONE integration — never a separate simulation: the backend integrates `transient_time + duration` in a single scan and the marked head is cut where the run is consumed (observations, analyses, plots, saved data), so the settle is in-band for any observation kernel that needs warm-up. Time is measured from the START of the measured window: the settle carries non-positive timestamps and ends at 0, the measured window opens one step later, and a declared event `t0` is relative to measurement, never to the scan. A settle that a fit reuses across many candidate evaluations is NOT this slot — that is a seed, declared as `initial_state.method: time_integration` with its own `duration`."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "transient_time"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/transparent",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "transparent (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Save figures with a transparent page instead of the `background` colour."
  } ],
