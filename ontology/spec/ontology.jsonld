    "@value" : "random_seed (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Experiment-global RNG seed (default 0). Governs every stochastic draw — additive noise, initial-condition and parameter distributions, and n_trials ensembles — unless a specific `Distribution.seed` overrides it for that distribution."
  } ],
