}, {
  "@id" : "https://w3id.org/tvbo/models/CakanObermayer/state_variables/I_A_var",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Adaptation current."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "I_A_var (CakanObermayer state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "I_A_var"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(I_A_var, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(I_A*(mu_se - E_A) - I_A_var)/tau_A"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/CakanObermayer/state_variables/mu_se",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Filtered mean synaptic input current to the excitatory population."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "mu_se (CakanObermayer state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "mu_se"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(mu_se, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(J_EE*r_E + J_EI*r_I + mu_E + c_glob - I_A_var/C - mu_se)/tau_se"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/CakanObermayer/state_variables/mu_si",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Filtered mean synaptic input current to the inhibitory population."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "mu_si (CakanObermayer state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "mu_si"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(mu_si, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(J_IE*r_E + J_II*r_I + mu_I - mu_si)/tau_si"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Chua",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "This is a 3D continuous system that exhibits chaos.\n\nChua designed an electronic circuit with the expressed goal of exhibiting\nchaotic motion, and this system is obtained by rescaling the circuit units\nto simplify the form of the equation. [^Chua1992]\n\nThe parameters are a, b, m0, and m1. Setting a = 15.6, m0 = -8/7 and m1 = -5/7, and\nvarying the parameter b from b = 25 to b = 51, one observes a classic period-doubling\nbifurcation route to chaos. [^Chua2007]"
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Chua1992"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Chua"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/Chua/derived_variables/h_x"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/Chua/parameters/a"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Chua/parameters/b"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Chua/parameters/m0"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Chua/parameters/m1"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/Chua/state_variables/x"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Chua/state_variables/y"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Chua/state_variables/z"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "generic"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Chua/derived_variables/h_x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Piecewise-linear Chua diode characteristic h(x)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "h_x (Chua derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "h_x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "h_x"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "m1*x + 0.5*(m0 - m1)*(abs(x + 1) - abs(x - 1))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Chua/parameters/a",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Parameter a scaling the active conductance term."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "15.6"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "a (Chua parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "a"
  } ]
}, {
