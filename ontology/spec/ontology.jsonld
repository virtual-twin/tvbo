}, {
  "@id" : "https://w3id.org/tvbo/code_modules",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "code_modules (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Importable module names whose import registers this figure's custom panels / transforms (via bsplot.register_panel / register_transform). The emitted plot.py imports them, so a study ships its bespoke figure code in its code_source instead of in core tvbo. The modules must be importable when the figure renders (loading the study puts its code/ dir on the path)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/figure"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "code_modules"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/code_source",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "code_source (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Where this study's callable code lives — the builders and transform/observation callables it references by bare ``module:`` name. Decouples the specification from its code: a local directory (relative to the recipe YAML or absolute) or a git repository fetched and cached at load time. When absent, the conventional ``<recipe-dir>/code/`` is used."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "code_source"
  } ]
}, {
