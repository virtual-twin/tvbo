  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Admits a cohort's members by a measure of a phenotype table: the candidates are cut into ``n_groups`` groups along ``measure`` and the cohort holds the group ``group``. The candidates are the members of the cohort ``of`` names, else the subjects the dataset lists, else every subject of the table. Each candidate needs one row in the table. A candidate without a row, or whose value is missing or not finite, is treated as ``missing`` says, before any group is formed. The members come in the candidates' order, not in the order of the measure. A group no candidate falls in is an error, as a cohort without members is."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/study"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "CohortRule"
  } ]
