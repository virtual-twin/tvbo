  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/HenonHeiles",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Hénon–Heiles system is a conservative 2 DoF Hamiltonian model introduced to\nstudy stellar motion near a galactic center and the search for a third integral\nof motion. The default initial condition is a typical chaotic orbit."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "HenonHeiles"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/HenonHeiles/derived_variables/H"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/HenonHeiles/state_variables/px"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HenonHeiles/state_variables/py"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HenonHeiles/state_variables/x"
  }, {
    "@id" : "https://w3id.org/tvbo/models/HenonHeiles/state_variables/y"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "generic"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/HenonHeiles/derived_variables/H",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Hamiltonian energy."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "H (HenonHeiles derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "H"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "H"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "0.5*(px**2 + py**2) + 0.5*(x**2 + y**2) + (x**2*y - (y**3)/3)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/HenonHeiles/state_variables/px",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Conjugate momentum p_x."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "px (HenonHeiles state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "px"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(px, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-x - 2*x*y"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/HenonHeiles/state_variables/py",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Conjugate momentum p_y."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
