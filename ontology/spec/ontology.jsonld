    "@value" : "Constant parameter to scale the rate of feedback from the\n            slow variable to itself"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "beta"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Generic2dOscillator/parameters/c",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
