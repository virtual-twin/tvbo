}, {
  "@id" : "https://w3id.org/tvbo/models/CakanObermayer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Adaptive linear-nonlinear (aLN) mean-field model of a network of adaptive exponential integrate-and-fire (AdEx) neurons, comprising one excitatory (E) and one inhibitory (I) population. Originally developed by Augustin, Ladenbauer, Liebe & Obermayer (2017) and used as the whole-brain mean-field in neurolib by Cakan, Jajcay & Obermayer (2021).\nThe legacy tvb-o.owl ontology referred to this model by the short name ``Cortical`` (suffix ``_CO``); ``iri`` is preserved for backward ontology mapping while ``name`` reflects the canonical attribution.\nDefaults are taken verbatim from ``neurolib/models/aln/loadDefaultParams.py``. Note that the full aLN dynamics require a precomputed transfer-function lookup table (``aln-precalc/quantities_cascade.h5``) that maps the filtered mean input ``mu`` and the membrane-potential standard deviation ``sigma`` to a steady-state firing rate. The state-variable equations below are the structural filtered-mean-input scaffold; the nonlinear transfer function ``r_E = Phi(mu_E, sigma_E)`` cannot be expressed in YAML and is therefore approximated as a sigmoid for backend code generation."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CakanObermayer"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Cakan-Obermayer ALN"
  } ],
  "https://w3id.org/tvbo/exhibitsBifurcation" : [ {
    "@id" : "_:genid5057"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Bistable"
  }, {
    "@id" : "https://w3id.org/tvbo/Oscillatory"
  }, {
    "@id" : "https://w3id.org/tvbo/Quiescent"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/FixedPoint"
  }, {
    "@id" : "https://w3id.org/tvbo/LimitCycle"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/CakanObermayer/derived_variables/r_E"
  }, {
    "@id" : "https://w3id.org/tvbo/models/CakanObermayer/derived_variables/r_I"
  } ],
  "https://w3id.org/tvbo/hasModelFeature" : [ {
    "@id" : "https://w3id.org/tvbo/ExcitatoryInhibitorySubpopulations"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/CakanObermayer/parameters/C"
  }, {
    "@id" : "https://w3id.org/tvbo/models/CakanObermayer/parameters/E_A"
  }, {
    "@id" : "https://w3id.org/tvbo/models/CakanObermayer/parameters/E_L"
  }, {
    "@id" : "https://w3id.org/tvbo/models/CakanObermayer/parameters/I_A"
  }, {
    "@id" : "https://w3id.org/tvbo/models/CakanObermayer/parameters/J_EE"
  }, {
