}, {
  "@id" : "https://w3id.org/tvbo/study/bundle",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "bundle (study)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "When true, emitting a self-contained kit copies this dataset's per-subject files into the kit (``spec/<exp>/dataset/``) and rewrites ``bids_root`` to that bundled copy, so the kit needs no external mount or ``$TVBO_BIDS_ROOT`` at run time. The exact files are resolved from the dataset-sourced observation's BIDS query (atlas, desc, …) — the same query that scopes the fan-out — so no CLI selection is needed. Declares the packaging intent in metadata instead of a ``--bundle-dataset`` flag; a subset is scoped via ``subjects``."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/study"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "bundle"
  } ]
