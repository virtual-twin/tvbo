}, {
  "@id" : "https://w3id.org/tvbo/networks/tpl-MNI152NLin2009cAsym_cohort-HCPYA_rec-avgMatrix_atlas-DesikanKilliany_desc-SCFC_relmat",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Group-average connectome of the HCP Young Adult S900 release on 84 Desikan-Killiany regions, 34 cortical, 7 subcortical and the cerebellar cortex per hemisphere: normalised streamline counts (`weight`) and mean tract lengths (`length`) from diffusion MRI, and the Pearson correlation of resting-state BOLD (`fc`). The arrays are tvboptim's `dk_average` (`src/tvboptim/data/connectivity/dk_average/data.npz` and `functional/dk_average/data.npz`), cast to float32 by `scripts/import_tvboptim_networks.py` (commit 2f6c965c6); `networks/bids/dk_average/dataset_description.json` lists Schirner, Deco and Ritter (2023) under `SourceDatasets`."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Network"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tpl-MNI152NLin2009cAsym_cohort-HCPYA_rec-avgMatrix_atlas-DesikanKilliany_desc-SCFC_relmat"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "DesikanKilliany (avgMatrix SC+FC)"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/networks/tpl-MNI152NLin2009cAsym_cohort-HCPYA_rec-avgMatrix_atlas-DesikanKilliany_desc-SCFC_relmat/parameters/conduction_speed"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/networks/tpl-MNI152NLin2009cAsym_cohort-HCPYA_rec-avgMatrix_atlas-DesikanKilliany_desc-SCFC_relmat/parameters/conduction_speed",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "3.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
