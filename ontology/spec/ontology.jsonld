}, {
  "@id" : "https://w3id.org/tvbo/models/ReducedSetFitzHughNagumo/state_variables/alpha",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "alpha (ReducedSetFitzHughNagumo state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "alpha"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(alpha, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tau*(alpha - f_i*alpha**3/3 - beta) + K21*(mode_dot(xi, Cik) - alpha) + tau*(II_i + mode_sum(c_glob0) + local_coupling*xi)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/ReducedSetFitzHughNagumo/state_variables/beta",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "beta (ReducedSetFitzHughNagumo state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "beta"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(beta, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(alpha - b*beta + n_i)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/ReducedSetFitzHughNagumo/state_variables/eta",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "eta (ReducedSetFitzHughNagumo state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "eta"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(eta, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(xi - b*eta + m_i)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/ReducedSetFitzHughNagumo/state_variables/xi",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "xi (ReducedSetFitzHughNagumo state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "xi"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(xi, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tau*(xi - e_i*xi**3/3 - eta) + K11*(mode_dot(xi, Aik) - xi) - K12*(mode_dot(alpha, Bik) - xi) + tau*(IE_i + mode_sum(c_glob0) + local_coupling*xi)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/ReducedSetHindmarshRose",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Reduced set of Hindmarsh-Rose oscillators (Stefanescu & Jirsa 2008); 3 modes coupled via mode-mixing matrices with Gaussian-quadrature coefficients recomputed from mu/sigma."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ReducedSetHindmarshRose"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/ReducedSetHindmarshRose/parameters/A_ik"
  }, {
