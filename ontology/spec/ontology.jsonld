  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/E_input_excitatory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "External excitatory input onto the excitatory population (clamped to be non-negative)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "E_input_excitatory (ZerlautAdaptationSecondOrder derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "E_input_excitatory"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "E_input_excitatory"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((0.0, c_glob + local_coupling*E + external_input_ex_ex + weight_noise*ou_drift < 0), (c_glob + local_coupling*E + external_input_ex_ex + weight_noise*ou_drift, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/E_input_inhibitory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "External excitatory input onto the inhibitory population (clamped to be non-negative)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "E_input_inhibitory (ZerlautAdaptationSecondOrder derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "E_input_inhibitory"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "E_input_inhibitory"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((0.0, S_i*c_glob + local_coupling*E + external_input_in_ex + weight_noise*ou_drift < 0), (S_i*c_glob + local_coupling*E + external_input_in_ex + weight_noise*ou_drift, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/I_input_excitatory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "External inhibitory input onto the excitatory population."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "I_input_excitatory (ZerlautAdaptationSecondOrder derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "I_input_excitatory"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "I_input_excitatory"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "local_coupling*I + external_input_ex_in"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/I_input_inhibitory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "External inhibitory input onto the inhibitory population."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "I_input_inhibitory (ZerlautAdaptationSecondOrder derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "I_input_inhibitory"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "I_input_inhibitory"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "local_coupling*I + external_input_in_in"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/TFe",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Excitatory transfer-function output evaluated at the current state."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TFe (ZerlautAdaptationSecondOrder derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "TFe"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "TFe"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "TF_e(E, I, E_input_excitatory, I_input_excitatory, W_e)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/TFi",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Inhibitory transfer-function output evaluated at the current state."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TFi (ZerlautAdaptationSecondOrder derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "TFi"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "TFi"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "TF_i(E, I, E_input_inhibitory, I_input_inhibitory, W_i)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fefe_e",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second central difference of TF_e w.r.t. excitatory rate."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "d2_fefe_e (ZerlautAdaptationSecondOrder derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "d2_fefe_e"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "d2_fefe_e"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(TF_e(E + 1.0e-7, I, E_input_excitatory, I_input_excitatory, W_e) - 2*TFe + TF_e(E - 1.0e-7, I, E_input_excitatory, I_input_excitatory, W_e))/((1.0e-7*1000.0)**2)"
