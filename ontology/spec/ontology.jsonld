}, {
  "@id" : "https://w3id.org/tvbo/JansenRit/state_variables/y3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second state-variable of the first Jansen-Rit population (excitatory PCs)"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CL_0000598"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y3 (JansenRit state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y3"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y3, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "A*a*sigma_y1_y2 - a**2*y0 - 2.0*a*y3"
  } ],
  "https://w3id.org/tvbo/surrogate_of" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CL_0000598"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/JansenRit/state_variables/y4",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second state-variable of the second excitatory Jansen-Rit population (excitatory EINs)"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CL_0000099"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y4 (JansenRit state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y4"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y4, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "A*a*(J*a_2*sigma_y0_1 + c_glob + local_coupling*(y1 - y2) + mu) - a**2*y1 - 2.0*a*y4"
  } ],
  "https://w3id.org/tvbo/surrogate_of" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CL_0000099"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/JansenRit/state_variables/y5",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second state-variable of the third (inhibitory) Jansen-Rit population (IINs)"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CL_0000099"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y5 (JansenRit state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y5"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y5, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "B*J*a_4*b*sigma_y0_3 - b**2*y2 - 2.0*b*y5"
  } ],
  "https://w3id.org/tvbo/surrogate_of" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CL_0000099"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/JansenRit1995",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Lumped-parameter cortical column model with three neural populations: pyramidal cells, excitatory interneurons, and inhibitory interneurons. Each population is modeled by a PSP block (2nd-order linear filter) and a sigmoidal potential-to-firing-rate transformation. The model produces EEG-like output as the pyramidal PSP difference v_pyr = y1 - y2. Based on Lopes da Silva et al. (1974, 1976) and Jansen et al. (1993)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
