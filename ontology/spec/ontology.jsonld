    "@value" : "nu_max (JansenRit parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Asymptotic of the sigmoid function Sigm_JR corresponds to the maximum firing rate of the neural populations."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "nu_max"
  } ],
  "https://w3id.org/tvbo/surrogate_of" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0099605"
  } ],
  "https://w3id.org/tvbo/unit" : [ {
    "@value" : "per_ms"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/JansenRit/parameters/r",
