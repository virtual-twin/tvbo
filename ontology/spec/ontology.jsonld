    "@value" : "V_i"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(V_i, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(I_i + V_i**2 + eta_i - pi**2*r_i**2*tau_i**2 + s_ie*tau_i - s_ii*tau_i)/tau_i"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/DumontGutkin/state_variables/r_e",
