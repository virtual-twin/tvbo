    "@value" : "r (Epileptor5D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Temporal scaling in the third state variable,         called :math:`1/\\tau_{0}` in Jirsa paper"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "r"
  } ]
