  "@id" : "https://w3id.org/tvbo/update_expression",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "update_expression (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "update_expression"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/update_rules",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "update_rules (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "How parameters are updated each iteration. When using 'includes', update_rules are inherited from included algorithms."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "update_rules"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/update_start",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "update_start (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Simulated time, counted from the start of each stage (or of the run when there are no stages), before which the update rules are not applied: an iteration applies its update only if its simulation period ends at or after this time. In the same unit as `simulation_period`. Absent, every iteration applies its update. A rule taken in through `includes` keeps the start of the algorithm it comes from."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "update_start"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/used",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "used (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A labelled array sourced from another experiment's result, a dataset, or a curated entity — the cross-container form of a value (WHERE + WHICH + SLICE, PROV ``prov:used``). Mutually exclusive with ``value``; an in-study ``experiment`` reference also registers the workflow dependency so the source runs first. Resolved lazily, never inlined into generated code."
  }, {
    "@value" : "Bind the annotation to a scalar in a result container (same reference form a Layer uses, and the same PROV edge). The referenced value is formatted through `text` at render time, so a statistic printed on a panel is computed, never transcribed."
  }, {
    "@value" : "Bind the key to a computed scalar in a result container (same reference form a figure Layer uses, and the same PROV edge). Mutually exclusive with ``value`` and ``count``."
  }, {
    "@value" : "IRIs of the inputs, outputs and environment the activity consumed (BEP028 ``Used``)."
  }, {
    "@value" : "The p-value, a scalar in a result container (same reference form a Layer uses, and the same PROV edge)."
  }, {
    "@value" : "WHERE + WHICH + SLICE for a template edge whose whole matrix is read rather than stored or computed: another network's layer, an analysis result, or a cohort member's own connectome (``used: {cohort: <id>, query: {...}, output: weight, reconcile: by_label}``). Inside a per-subject run a cohort reference resolves to that run's subject, which is what binds a model network to each subject's own connectivity. ``reconcile: by_label`` aligns the read matrix to this network's node order through its atlas aliases. Resolved lazily and never inlined, and it wins over a same-named layer in the companion file. Mutually exclusive with ``producer:``."
  }, {
    "@value" : "WHERE + WHICH + SLICE in one edge — this parameter's array sourced from another experiment's result (an operating point, a tuned ``estimate__<name>`` a fit persisted), a dataset, or a curated entity, PROV ``prov:used``. The full cross-container form of which `source:`+`measure:` is the no-``sel``/no-``experiment`` shorthand; adds label ``reconcile`` and a swept-point ``sel``. Like `source:` the array is resolved lazily and never inlined. An in-study ``experiment`` reference also registers the workflow dependency. Mutually exclusive with `value:`/`source:`/`producer:`."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.w3.org/ns/prov#used"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  }, {
    "@id" : "https://w3id.org/tvbo/figure"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "used"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/va",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "va (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Vertical alignment against (x, y) — bottom, center, top, baseline. Defaults to center."
  } ],
