}, {
  "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/struct"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CouplingStageEvaluation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid557"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "How the network coupling term is evaluated within one step of a multi-stage integrator (Heun, RK4, ...). A backend-neutral numerical contract: whether the coupling is part of the vector field, re-evaluated at each solver stage, or computed once per step and held constant across the stages. Matters because the two choices integrate a different effective system — for stiff / chaotic / multistable dynamics they can converge to different trajectories or attractors."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "https://w3id.org/linkml/permissible_values" : [ {
    "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation#per_stage"
  }, {
    "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation#per_step"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation#per_stage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/struct"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "per_stage (CouplingStageEvaluation)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "per_stage"
  }, {
    "@value" : "recompute_coupling_per_stage"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Re-evaluate the coupling at every integrator stage — the coupling is a full part of the vector field (standard ODE integration). Accurate; required to reproduce reference integrators for stiff / chaotic / multistable systems. (tvboptim maps this to recompute_coupling_per_stage=True; diffrax already recomputes the whole RHS per stage.)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "per_stage"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "per-stage coupling evaluation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Re-evaluate the network coupling term at every stage of a multi-stage integrator. Costlier, but the coupling seen by each stage is consistent with that stage's state; the difference from per-step matters for stiff or chaotic coupled networks."
  } ],
  "https://w3id.org/tvbo/backendParameter" : [ {
    "@value" : "tvboptim: recompute_coupling_per_stage=True"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation#per_step",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/struct"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "per_step (CouplingStageEvaluation)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "per_step"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Evaluate the coupling once per integration step and hold it constant across the stages — a TVB-style efficiency shortcut (the coupling reduction runs once per step). Faster but lower- order in the coupling; can change the trajectory for sensitive systems. (tvboptim: recompute_coupling_per_stage=False, the current backend default.)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "per_step"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "per-step coupling evaluation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Evaluate the network coupling once per integration step and hold it frozen across the integrator's stages. The default, and the classic TVB treatment."
  } ],
  "https://w3id.org/tvbo/backendParameter" : [ {
    "@value" : "tvboptim: recompute_coupling_per_stage=False"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Cusp",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Codim-2 organising centre where two fold curves meet tangentially."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Cusp"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/Bifurcation"
  }, {
    "@id" : "_:genid560"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "CP"
  }, {
    "@value" : "cp"
  }, {
    "@value" : "cusp"
  } ],
  "https://w3id.org/tvbo/canonicalCode" : [ {
    "@value" : "CP"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/DDEIntegration",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationTask"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Forward integration of a delay differential equation (e.g. long-range axonal delays)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DDE integration"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/DataRef",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
