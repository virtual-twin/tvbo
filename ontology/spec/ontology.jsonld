  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "bar (MarkType)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/MarkType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Vertical bars, one per x (spectrum, per-category magnitude). Distinct from `line` because a spectrum read as a line implies interpolation between mode numbers that do not exist."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "bar"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/MarkType#errorbar",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "errorbar (MarkType)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/MarkType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "One vertical bar per x between two edges (a group's mean ± SD at each discrete group). The data contract of `band`, drawn as separate segments, because a band filled between discrete groups implies values between them that were never measured."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "errorbar"
  } ]
