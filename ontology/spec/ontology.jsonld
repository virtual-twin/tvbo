  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A named subset of a dataset's subjects: the unit a group-level quantity is defined over, such as a mean connectome, a per-edge presence count or a normalisation constant. A dataset may hold several, and they may overlap: the sites of a multi-centre study, a patient and a control group, the subjects a processing pipeline has finished so far. Naming the subset is what pins an aggregate. A quantity computed over ``hcpy93`` states which subjects went into it, and moving to a larger cohort is a change to one identifier rather than to every consumer."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/study"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "Cohort"
  } ]
