    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "slope (EpileptorRestingState parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Linear coefficient in the first state-variable x1."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "slope"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorRestingState/parameters/tau",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
