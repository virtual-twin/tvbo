  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(x0 - x7)*x8 - x9 + F"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/LorenzBounded",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Lorenz system modified by smooth radial confinement factor f = 1 - (||X||^2)/r^2\nproducing bounded dynamics with altered basin geometry while retaining core\nstretching and folding mechanisms."
  } ],
