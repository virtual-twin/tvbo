}, {
  "@id" : "https://w3id.org/tvbo/CakanObermayer/derived_variables/r_E",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Excitatory population firing rate. In full aLN this is ``Phi(mu_E_eff, s_EE)`` with ``Phi`` precomputed; here a sigmoid stand-in is used."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "r_E (CakanObermayer derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "r_E"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "r_E"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "r_max/(1 + exp(-k_phi*(mu_se - mu_th)))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/CakanObermayer/derived_variables/r_I",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Inhibitory population firing rate (sigmoid stand-in for aLN Phi)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
