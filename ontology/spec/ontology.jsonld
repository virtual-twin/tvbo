  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ee",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Variance of the excitatory population activity."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "C_ee (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "C_ee"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(C_ee, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(TFe*(1.0/T - TFe)/(N_tot*(1.0 - g)) + (TFe - E)**2 + 2.0*C_ee*dfe_TFe + 2.0*C_ei*dfi_TFe - 2.0*C_ee)/T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ei",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Covariance between the excitatory and inhibitory population activities."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "C_ei (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "C_ei"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(C_ei, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "((TFe - E)*(TFi - I) + C_ee*dfe_TFe + C_ei*dfe_TFi + C_ei*dfi_TFe + C_ii*dfi_TFi - 2.0*C_ei)/T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ii",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Variance of the inhibitory population activity."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "C_ii (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "C_ii"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(C_ii, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(TFi*(1.0/T - TFi)/(N_tot*g) + (TFi - I)**2 + 2.0*C_ii*dfi_TFi + 2.0*C_ei*dfe_TFi - 2.0*C_ii)/T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/E",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Firing rate of the excitatory population [kHz]."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "E (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "E"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(E, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(TFe - E + 0.5*C_ee*d2_fefe_e + 0.5*C_ei*d2_fefi_e + 0.5*C_ei*d2_fife_e + 0.5*C_ii*d2_fifi_e)/T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/I",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Firing rate of the inhibitory population [kHz]."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "I (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "I"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(I, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(TFi - I + 0.5*C_ee*d2_fefe_i + 0.5*C_ei*d2_fefi_i + 0.5*C_ei*d2_fife_i + 0.5*C_ii*d2_fifi_i)/T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_e",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Adaptation current of the excitatory population [pA]."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "W_e (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "W_e"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(W_e, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-W_e/tau_w_e + b_e*E + a_e*(muV_e - E_L_e)/tau_w_e"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_i",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Adaptation current of the inhibitory population [pA]."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "W_i (ZerlautAdaptationSecondOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "W_i"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(W_i, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-W_i/tau_w_i + b_i*I + a_i*(muV_i - E_L_i)/tau_w_i"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/ou_drift",
