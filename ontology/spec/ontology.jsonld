  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/TickPlacement"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The plotting backend's own locator: nothing is re-placed, so the ticks are the ones the drawing produced. What an axis gets when no theme says otherwise."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "native"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TickPlacement#round",
