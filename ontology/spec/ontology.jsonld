    "@value" : "cardano_a"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "cardano_a"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "mu1/2"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/cardano_d",
