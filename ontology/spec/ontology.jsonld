  }, {
    "@id" : "https://w3id.org/tvbo/EpileptorCodim3/parameters/dstar"
  }, {
    "@id" : "https://w3id.org/tvbo/EpileptorCodim3/parameters/modification"
  }, {
    "@id" : "https://w3id.org/tvbo/EpileptorCodim3/parameters/mu1_start"
  }, {
    "@id" : "https://w3id.org/tvbo/EpileptorCodim3/parameters/mu1_stop"
  }, {
    "@id" : "https://w3id.org/tvbo/EpileptorCodim3/parameters/mu2_start"
  }, {
    "@id" : "https://w3id.org/tvbo/EpileptorCodim3/parameters/mu2_stop"
  }, {
    "@id" : "https://w3id.org/tvbo/EpileptorCodim3/parameters/nu_start"
  }, {
    "@id" : "https://w3id.org/tvbo/EpileptorCodim3/parameters/nu_stop"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/EpileptorCodim3/state_variables/x"
  }, {
    "@id" : "https://w3id.org/tvbo/EpileptorCodim3/state_variables/y"
  }, {
    "@id" : "https://w3id.org/tvbo/EpileptorCodim3/state_variables/z"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "neural_mass"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "First component of the unit vector E parametrising the great arc (A/||A|| with A = [mu2_start, -mu1_start, nu_start])."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "E0 (EpileptorCodim3 derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "E0"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "E0"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "mu2_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second component of the unit vector E parametrising the great arc."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "E1 (EpileptorCodim3 derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "E1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "E1"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-mu1_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Third component of the unit vector E parametrising the great arc."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
