  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Complete specification of a numerical continuation / bifurcation analysis. All universal solver settings live directly here. Toolkit-specific string options go in the options slot. When used inside a BranchSwitch, only explicitly set attributes override the parent's values."
  } ],
