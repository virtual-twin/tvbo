    "@value" : "The ticks each panel gives in `xticks` and `yticks`, and nothing else. A numeric axis that gives none is refused, so a figure under this rule carries no tick nobody chose."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "declared"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/TickPlacement#native",
