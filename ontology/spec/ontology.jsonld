  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "backends (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Codegen backends this recipe is registered for; others recompute."
