}, {
  "@id" : "https://w3id.org/tvbo/models/MagneticPendulum",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Damped planar magnetic pendulum over N fixed magnets forming a symmetric multistable\npotential. Exhibits fractal basin boundaries and sensitive dependence in final magnet\nattraction region selection."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
