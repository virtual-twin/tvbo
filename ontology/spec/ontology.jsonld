}, {
  "@id" : "https://w3id.org/tvbo/DumontGutkin/state_variables/V_e",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "V_e (DumontGutkin state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "V_e"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(V_e, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(I_e + V_e**2 + eta_e - pi**2*r_e**2*tau_e**2 + s_ee*tau_e - s_ei*tau_e)/tau_e"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/DumontGutkin/state_variables/V_i",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "V_i (DumontGutkin state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "V_i"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(V_i, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(I_i + V_i**2 + eta_i - pi**2*r_i**2*tau_i**2 + s_ie*tau_i - s_ii*tau_i)/tau_i"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/DumontGutkin/state_variables/r_e",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "r_e (DumontGutkin state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "r_e"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(r_e, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(Delta_e/(pi*tau_e) + 2*V_e*r_e)/tau_e"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/DumontGutkin/state_variables/r_i",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "r_i (DumontGutkin state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "r_i"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(r_i, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(Delta_i/(pi*tau_i) + 2*V_i*r_i)/tau_i"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/DumontGutkin/state_variables/s_ee",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "s_ee (DumontGutkin state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "s_ee"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(s_ee, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(J_ee*r_e + c_glob - s_ee)/tau_s"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/DumontGutkin/state_variables/s_ei",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "s_ei (DumontGutkin state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "s_ei"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(s_ei, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(J_ei*r_i - s_ei)/tau_s"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/DumontGutkin/state_variables/s_ie",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "s_ie (DumontGutkin state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "s_ie"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(s_ie, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(Gamma*c_glob + J_ie*r_e - s_ie)/tau_s"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/DumontGutkin/state_variables/s_ii",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "s_ii (DumontGutkin state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "s_ii"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(s_ii, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(J_ii*r_i - s_ii)/tau_s"
  } ]
