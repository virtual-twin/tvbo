  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "A (GastSchmidtKnosche_SF state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "A"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(A, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "B/tau_A"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/GastSchmidtKnosche_SF/state_variables/B",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "B (GastSchmidtKnosche_SF state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "B"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(B, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(-A - 2*B + alpha*r)/tau_A"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/GastSchmidtKnosche_SF/state_variables/V",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "V (GastSchmidtKnosche_SF state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "V"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(V, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(-A + I + J*r*tau + V**2 + c_glob0*cr + c_glob1*cv + eta - pi**2*r**2*tau**2)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/GastSchmidtKnosche_SF/state_variables/r",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "r (GastSchmidtKnosche_SF state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "r"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(r, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(Delta/(pi*tau) + 2*V*r)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Generic2dOscillator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Generic 2-Dimensional Oscillator (G2D) is a phenomenological, coupled, nonlinear two-dimensional (i.e., two state-variables ('V', 'W')) oscillatory, neural mass model. The G2D is a generalization of the well-known FitzHugh-Nagumo model (FitzHugh, 1961; Nagumo et. al, 1962), adapted here for reproducing a wilder class of dynamical configurations of physiological phenomena as observed in neuronal population using phase-portrait method."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/FitzHugh1961"
  }, {
    "@id" : "https://w3id.org/tvbo/studies/Nagumo1962"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Generic2dOscillator"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Generic 2-D oscillator"
  } ],
  "https://w3id.org/tvbo/exhibitsBifurcation" : [ {
    "@id" : "_:genid5068"
  }, {
    "@id" : "_:genid5069"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Bistable"
  }, {
    "@id" : "https://w3id.org/tvbo/Excitable"
  }, {
    "@id" : "https://w3id.org/tvbo/Oscillatory"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/FixedPoint"
  }, {
    "@id" : "https://w3id.org/tvbo/LimitCycle"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/Generic2dOscillator/parameters/I"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Generic2dOscillator/parameters/a"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Generic2dOscillator/parameters/alpha"
