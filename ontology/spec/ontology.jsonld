  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Firing rate of inhibitory population in KHz"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "I (ZerlautAdaptationFirstOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "I"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(I, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(-I + f_out_i)/T"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/W_e",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Level of adaptation of excitatory in pA"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "W_e (ZerlautAdaptationFirstOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "W_e"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(W_e, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "E*b_e - W_e/tau_w_e + a_e*(-E_L_e + mu_V_e)/tau_w_e"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/W_i",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Level of adaptation of inhibitory in pA"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "W_i (ZerlautAdaptationFirstOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "W_i"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(W_i, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "I*b_i - W_i/tau_w_i + a_i*(-E_L_i + mu_V_i)/tau_w_i"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/ou_drift",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ou_drift (ZerlautAdaptationFirstOrder state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "ou_drift"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(ou_drift, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "-ou_drift/tau_OU"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second-order mean-field model of a conductance-based network of adaptive exponential integrate-and-fire (AdEx) excitatory and inhibitory neurons (di Volo et al. 2018, Zerlaut et al. 2018). It tracks the mean firing rates of the excitatory (E) and inhibitory (I) populations, their second-order statistics (the covariance matrix C_ee, C_ei, C_ii), the adaptation currents (W_e, W_i) and an Ornstein-Uhlenbeck noise drift (ou_drift). The population firing rate is given by a semi-analytic transfer function (TF) whose argument is the membrane-potential fluctuation regime (mu_V, sigma_V, T_V) and a phenomenological voltage threshold fitted by a second-order polynomial. The first and second derivatives of the transfer function with respect to the pre-synaptic rates are evaluated with the SAME central finite-difference stencil (df = 1e-7) used in the original TVB implementation, so the drift is reproduced bit-for-bit."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Zerlaut2018"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ZerlautAdaptationSecondOrder"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/E_input_excitatory"
  }, {
