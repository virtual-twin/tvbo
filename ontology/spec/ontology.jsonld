  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sigma_v23 (ZetterbergJansen derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sigma_v23"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "sigma_v23"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise((0, rho_1*(rho_2 - (v2 - v3)) > 709), (2*e0/(exp(rho_1*(rho_2 - (v2 - v3))) + 1), True))"
  } ]
