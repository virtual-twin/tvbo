  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Trim surrounding whitespace from the saved figure (default true). Trimming re-crops to the drawn content, so the saved aspect can differ from width/height; set false to preserve the declared width×height proportions exactly, e.g. to match an original figure. Renders as bbox_inches='tight' on a matplotlib backend."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
