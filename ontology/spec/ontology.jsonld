    "@value" : "env (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Environment variables exported before the task command on every engine (e.g. XLA_PYTHON_CLIENT_PREALLOCATE=false). An ordered list of {name, value}; values are shell-quoted at emit time."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
