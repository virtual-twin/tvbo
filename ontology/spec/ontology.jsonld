  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/d"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/gamma"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/tau_s"
  }, {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/parameters/w"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/ReducedWongWang/state_variables/S"
  } ],
  "https://w3id.org/tvbo/hasStochasticityCharacter" : [ {
    "@id" : "https://w3id.org/tvbo/Deterministic"
  } ],
  "https://w3id.org/tvbo/hasTimescaleSeparation" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "false"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "mean_field"
  } ],
  "https://w3id.org/tvbo/modelsCellType" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CL_0000099"
  }, {
    "@id" : "http://purl.obolibrary.org/obo/CL_0000598"
  } ],
  "https://w3id.org/tvbo/modelsNeurotransmitterSystem" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0007214"
  }, {
    "@id" : "http://purl.obolibrary.org/obo/GO_0035249"
  } ],
  "https://w3id.org/tvbo/phaseSpaceDimension" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWang/derived_variables/H",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Sigmoid input-output function of the synaptic input current, x_RWW, that computes the averaged firing rate of the neurons population (Deco et al., 2013)."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0099605"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "H (ReducedWongWang derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "H"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "H"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(a*x - b)/(1 - exp(-d*(a*x - b)))"
  } ],
  "https://w3id.org/tvbo/surrogate_of" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0099605"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ReducedWongWang/derived_variables/x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "(NMDAR)-mediated synaptic input current to the neurons population (Deco et al., 2013)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x (ReducedWongWang derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "I_o + J_N*S*local_coupling + J_N*S*w + J_N*c_glob"
  } ]
