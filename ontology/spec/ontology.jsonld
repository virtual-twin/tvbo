}, {
  "@id" : "https://w3id.org/tvbo/held_parameters",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "held_parameters (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The parameters the continuation holds to a target while it varies its free parameter, as feedback inhibition control holds J_i: each names the parameter and the algorithm whose objective states the target. The continued system gains each held parameter as an unknown whose equation is that objective's residual. Refused when the objective states no target_variable and target_value, when no update rule of the algorithm targets the parameter, and on a continuation backend that holds no parameters (bifurcationkit holds them)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "held_parameters"
  } ]
