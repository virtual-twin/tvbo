  "@id" : "https://w3id.org/tvbo/experiments/IntegrateAndFire_Ex0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Reproduces NeuroML2 LEMS canonical example 0, iafTauCell variant. Single leaky integrate-and-fire cell with spike/reset event. No external input — fires rhythmically because leakReversal > thresh. Simulated for 300ms at 0.005ms step.\n"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/SimulationExperiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
