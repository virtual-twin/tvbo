}, {
  "@id" : "https://w3id.org/tvbo/HemodynamicObservation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An observation model that maps neural activity to a haemodynamic / BOLD signal by causal convolution with a finite-support HRF kernel."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Hemodynamic observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/Observation"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/HemodynamicWarmupRequirement",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Modelling axiom: for any tvbo:HemodynamicObservation, the discarded transient (tvbo:transient_time) MUST be ≥ the observation's HRF kernel duration (tvbo:hrfKernelDuration). Otherwise the causal HRF convolution is under-filled and the BOLD time axis shifts earlier, so the signal spuriously precedes the stimulus rather than lagging it by the hemodynamic delay. Example: the tvboptim BOLD pipeline uses a 20000 ms kernel (5000 samples at dt = 4 ms) via prepend_history + valid-mode convolution, so transient_time ≥ 20000 ms is required."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Hemodynamic warm-up requirement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://w3id.org/tvbo/HemodynamicObservation"
  }, {
    "@id" : "https://w3id.org/tvbo/hrfKernelDuration"
  }, {
    "@id" : "https://w3id.org/tvbo/transient_time"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Hemodynamic warm-up requirement"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Observed empirically (TVB-O acoustic-stimulation use-case, 2026): a 15000 ms transient (< 20000 ms kernel) made auditory BOLD precede the loudness by ~1 s with a mislabelled 1043 ms TR; transient ≥ 20000 ms restored a causal hemodynamic lag (≈ +1.5 s) and the correct 1000 ms TR."
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/HomoclinicBifurcation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Global bifurcation where a limit cycle collides with a saddle equilibrium, forming a homoclinic orbit of infinite period."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Homoclinic"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/Bifurcation"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "hom"
  }, {
    "@value" : "homoclinic"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Hopf",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Andronov-Hopf: an equilibrium loses stability as a complex-conjugate eigenvalue pair crosses the imaginary axis, giving birth to a limit cycle."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Hopf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/Bifurcation"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid1386"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "HB"
  }, {
    "@value" : "andronov hopf"
  }, {
    "@value" : "andronov-hopf"
  }, {
    "@value" : "hb"
  }, {
    "@value" : "hopf"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Hopf"
  } ],
  "https://w3id.org/tvbo/canonicalCode" : [ {
    "@value" : "HB"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/HopfHopf",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Codim-2 point where two Hopf curves cross (two imaginary pairs simultaneously)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Hopf-Hopf (double Hopf)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/Bifurcation"
  }, {
    "@id" : "_:genid1392"
  }, {
    "@id" : "_:genid1393"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "HH"
  }, {
    "@value" : "double hopf"
  }, {
    "@value" : "hh"
  }, {
    "@value" : "hopf-hopf"
  } ],
  "https://w3id.org/tvbo/canonicalCode" : [ {
    "@value" : "HH"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Hopfield",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Hopfield neural network is a discrete time dynamical system composed of multiple binary nodes, with a connectivity matrix built from a predetermined set of patterns. The update, inspired from the spin-glass model (used to describe magnetic properties of dilute alloys), is based on a random scanning of every node. The existence of a fixed point dynamics is guaranteed by a Lyapunov function. The Hopfield network is expected to have those multiple patterns as attractors (multistable dynamical system).\nWhen the initial conditions are close to one of the 'learned' patterns, the dynamical system is expected to relax on the corresponding attractor. A possible output of the system is the final attractive state (interpreted as an associative memory).\n\nVarious extensions of the initial model have been proposed, among which a noiseless and continuous version [Hopfield 1984] having a slightly different Lyapunov function, but essentially the same dynamical properties, with more straightforward physiological Interpretation. A continuous Hopfield neural network (with a sigmoid transfer function) can indeed be interpreted as a network of neural masses with every node corresponding to the mean field activity of a local brain region, with many bridges with the Wilson Cowan model [WC_1972].\n\nNote:\n- This model uses the modifications implemented by Golos et al. (2015)."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Hopfield1982"
  }, {
    "@id" : "https://w3id.org/tvbo/studies/Hopfield1984"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Hopfield"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Hopfield"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Multistable"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/FixedPoint"
  } ],
  "https://w3id.org/tvbo/hasModelFeature" : [ {
    "@id" : "https://w3id.org/tvbo/SigmoidActivation"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/Hopfield/parameters/dynamic"
  }, {
    "@id" : "https://w3id.org/tvbo/Hopfield/parameters/tauT"
  }, {
    "@id" : "https://w3id.org/tvbo/Hopfield/parameters/taux"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/Hopfield/state_variables/theta"
  }, {
    "@id" : "https://w3id.org/tvbo/Hopfield/state_variables/x"
  } ],
  "https://w3id.org/tvbo/hasStochasticityCharacter" : [ {
    "@id" : "https://w3id.org/tvbo/Deterministic"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "neural_mass"
  } ],
  "https://w3id.org/tvbo/phaseSpaceDimension" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "2"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Hopfield/parameters/dynamic",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Threshold dynamics: 0 (default) -> theta tracks x (TVB display hack); >0 -> theta relaxes to its own coupling input."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "dynamic (Hopfield parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "dynamic"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Hopfield/parameters/tauT",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The slow time-scale for threshold calculus :math:`\\\\theta`, state-variable of the model"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "5.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "tauT (Hopfield parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The slow time-scale for threshold calculus :math:`\\\\theta`, state-variable of the model."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "tauT"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Hopfield/parameters/taux",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The fast time-scale for potential calculus :math:`x`, state-variable of the model"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "1.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "taux (Hopfield parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The fast time-scale for potential calculus :math:`x`, state-variable of the model."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "taux"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Hopfield/state_variables/theta",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Slow state variable at node i"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "theta (Hopfield state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "theta"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(theta, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Piecewise(((c_glob1 - theta)/tauT, dynamic > 0), ((c_glob0 - x)/taux, True))"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/Hopfield/state_variables/x",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x (Hopfield state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(c_glob0 - x)/taux"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ImagingModality",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/struct"
