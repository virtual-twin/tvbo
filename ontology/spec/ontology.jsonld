  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A propagation requirement on a grouped wave reduction. A per-timestep wave test cannot tell a standing field from a travelling one, since a standing field repeats the same spatial pattern every timestep. The reduction sums the per-element unit direction vector over the post-transient timesteps and computes each group's direction dispersion, the ``mask``-weighted mean over elements of 1 - |time-mean direction|: 0 for a direction field fixed in time, growing as the direction moves. A group whose dispersion falls below ``min_dispersion`` has no travelling waves, so its proportion of waves is 0 and its proportion-directed and rho are undefined (NaN)."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/tvbo/PropagationGate"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ]
