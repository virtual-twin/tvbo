  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Series filled down to the baseline (a density/pdf, a cumulative share). Distinct from `band`, which spans two series, and from `bar`, which asserts the x values are discrete categories."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "area"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/MarkType#band",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "band (MarkType)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/MarkType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Filled band between two series (an error band, a CI). Its layer's output carries a length-2 axis beside the swept one, holding the two edges in ONE array — binding a lower edge and an upper edge as separate layers lets them come from different runs."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "band"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/MarkType#bar",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
