    "@value" : "a_3 (JansenRit parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Average probability constant of the number of synapses made by the PCs to the dendrites of the IINs. It characterizes the connectivity between the PCs and inhibitory IINs."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "a_3"
  } ],
  "https://w3id.org/tvbo/surrogate_of" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0099536"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/JansenRit/parameters/a_4",
