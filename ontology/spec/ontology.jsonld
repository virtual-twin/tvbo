  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(U_e_i**2*fe_i*tau_e**2 + U_i_i**2*fi_i*tau_i**2)/(U_e_i**2*fe_i*tau_e**2/(T_m_i + tau_e) + U_i_i**2*fi_i*tau_i**2/(T_m_i + tau_i))"
