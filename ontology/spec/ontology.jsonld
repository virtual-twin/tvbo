  "@id" : "https://w3id.org/tvbo/models/Epileptor5D/parameters/x0",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Epileptogenicity Parameter"
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "-1.6"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0060079"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x0 (Epileptor5D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Epileptogenicity Parameter. Degree of excitability or epileptogenicity in Epileptor5D (Jirsa et al.,2014).\n\nIf x0 is greater than a critical value, x0,critic = −2.05, the system can trigger seizures autonomously; otherwise it is in its equilibrium state.\n\nNote:\n- If modification_E5D:\nif x0 is smaller than a critical value, x0,critic = 2.91, can trigger seizures autonomously; otherwise it is in its equilibrium state (Proix et al., 2014)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x0"
  } ],
  "https://w3id.org/tvbo/surrogate_of" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0060079"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor5D/state_variables/g",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "g_E5D is a low-pass filtered excitatory coupling function from sub-population (x1_E5D, y1_E5D) to (x2_E5D, y2_E5D) in Epileptor5D (Jirsa et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "g (Epileptor5D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "g"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(g, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(-0.01*g + 0.001*x1)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor5D/state_variables/x1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "First state-variable of the first Epileptor5D population (Jirsa et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x1 (Epileptor5D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x1, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(Iext + Kvf*c_glob0 + local_coupling*x1 + x1*x1cond + y1 - z)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor5D/state_variables/x2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "First state-variable of the second Epileptor5D sub-population (Jirsa et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x2 (Epileptor5D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(x2, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(Iext2 + Kf*c_glob1 + bb*g - x2**3 + x2 - y2 - 0.3*z + 1.05)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor5D/state_variables/y1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second state-variable of the first Epileptor5D sub-population (Jirsa et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y1 (Epileptor5D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y1"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y1, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(c - d*x1**2 - y1)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor5D/state_variables/y2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Second state-variable of the second Epileptor5D population (Jirsa et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "y2 (Epileptor5D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "y2"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y2, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "tt*(-y2 + y2cond)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Epileptor5D/state_variables/z",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Slow permittivity state-variable of the Epileptor5D (Jirsa et al"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "z (Epileptor5D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "z"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(z, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "r*tt*(Ks*c_glob0 + h - z)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Epileptor codim 3 model is a neural mass model containing two subsystems acting at different timescales. The fast subsystem (x, y) uses the unfolding of a degenerate Takens-Bogdanov bifurcation of codimension 3; the slow subsystem (z) steers the fast one back and forth along a great arc of a sphere, producing bursting behavior. It reproduces almost all classes of bursting predicted for systems with a planar fast subsystem. The default parameters correspond to Hysteresis-Loop burster class c2s (Saddle-Node at onset, Saddle-Homoclinic at offset, branch N=1, with the stabilising modification for negative dstar)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "EpileptorCodim3"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/E0"
  }, {
    "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/E1"
  }, {
    "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/E2"
  }, {
    "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/F0"
  }, {
    "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/F1"
  }, {
    "@id" : "https://w3id.org/tvbo/models/EpileptorCodim3/derived_variables/F2"
  }, {
