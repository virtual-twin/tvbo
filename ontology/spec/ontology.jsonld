  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Lorenz63",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The famous three dimensional system due to Lorenz [^Lorenz1963], shown to exhibit\nso-called \"deterministic nonperiodic flow\". It was originally invented to study a\nsimplified form of atmospheric convection.\n\nCurrently, it is most famous for its strange attractor (occuring at the default\nparameters), which resembles a butterfly. For the same reason it is\nalso associated with the term \"butterfly effect\" (a term which Lorenz himself disliked)\neven though the effect applies generally to dynamical systems.\nDefault values are the ones used in the original paper."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Lorenz1963"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Lorenz63"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/Lorenz63/parameters/beta"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Lorenz63/parameters/rho"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Lorenz63/parameters/sigma"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/Lorenz63/state_variables/X"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Lorenz63/state_variables/Y"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Lorenz63/state_variables/Z"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "generic"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Lorenz63/parameters/beta",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Geometric factor (β = 8/3) related to aspect ratio."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "2.666667"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "beta (Lorenz63 parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "beta"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Lorenz63/parameters/rho",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Rayleigh number (ρ) scaled parameter driving convection."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "28.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "rho (Lorenz63 parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "rho"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Lorenz63/parameters/sigma",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Prandtl number (σ) controlling rate of convection."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "10.0"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sigma (Lorenz63 parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sigma"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Lorenz63/state_variables/X",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "State variable X (convective intensity component)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "X (Lorenz63 state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "X"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(X, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "sigma*(Y - X)"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Lorenz63/state_variables/Y",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "State variable Y (temperature difference component 1)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Y (Lorenz63 state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "Y"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(Y, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "X*(rho - Z) - Y"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Lorenz63/state_variables/Z",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "State variable Z (temperature difference component 2)."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Z (Lorenz63 state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "Z"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(Z, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "X*Y - beta*Z"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Lorenz84",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Low-order atmospheric circulation model exhibiting multistability and fractal\nbasin boundaries with coexisting attractors under standard parameter set."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Freire2008"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Lorenz84"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
