  "@id" : "https://w3id.org/tvbo/Kuramoto",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Kuramoto model is a model of synchronization phenomena derived by Yoshiki Kuramoto in 1975 which has since been applied to diverse domains including the study of neuronal oscillations and synchronization."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Cabral2011"
  }, {
    "@id" : "https://w3id.org/tvbo/studies/Kuramoto1975"
  }, {
    "@id" : "https://w3id.org/tvbo/studies/Strogatz2000"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Kuramoto"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Kuramoto"
  } ],
  "https://w3id.org/tvbo/exhibitsRegime" : [ {
    "@id" : "https://w3id.org/tvbo/Oscillatory"
  } ],
  "https://w3id.org/tvbo/hasAttractor" : [ {
    "@id" : "https://w3id.org/tvbo/LimitCycle"
  }, {
    "@id" : "https://w3id.org/tvbo/Torus"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/Kuramoto/derived_variables/I"
  }, {
    "@id" : "https://w3id.org/tvbo/Kuramoto/derived_variables/lc_0"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/Kuramoto/parameters/omega"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/Kuramoto/state_variables/theta"
  } ],
  "https://w3id.org/tvbo/hasStochasticityCharacter" : [ {
    "@id" : "https://w3id.org/tvbo/Deterministic"
  } ],
  "https://w3id.org/tvbo/hasTimescaleSeparation" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "false"
