  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "gamma"
  }, {
    "@value" : "tau"
  }, {
    "@value" : "tauMin"
  }, {
    "@value" : "vHalf"
  }, {
    "@value" : "z"
  } ],
  "https://w3id.org/tvbo/neuroml/requires" : [ {
    "@value" : "v"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/variableParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Specifies a _parameter (e.g. condDensity) which can vary its value across a _segmentGroup. The value is calculated from _value attribute of the _inhomogeneousValue_ subelement. This element is normally a child of _channelDensityNonUniform_, _channelDensityNonUniformNernst_ or _channelDensityNonUniformGHK_ and is used to calculate the value of the conductance, etc. which will vary on different parts of the cell. The _segmentGroup specified here needs to define an _inhomogeneousParameter_ (referenced from _inhomogeneousParameter in the _inhomogeneousValue_), which calculates a _variable (e.g. p) varying across the cell (e.g. based on the path length from soma), which is then used in the _value attribute of the _inhomogeneousValue_ (so for example condDensity = f(p))"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "variableParameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#variableParameter"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/voltageClamp",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Voltage clamp. Applies a variable current _i to try to keep parent at _targetVoltage. Not yet fully tested!!! Consider using voltageClampTriple!!"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "voltageClamp"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml/baseVoltageDepPointCurrent"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#voltageClamp"
  } ],
  "https://w3id.org/tvbo/neuroml/eventPort" : [ {
    "@value" : "in"
  } ],
  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "delay"
  }, {
    "@value" : "duration"
  }, {
    "@value" : "simpleSeriesResistance"
  }, {
    "@value" : "targetVoltage"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/voltageClampTriple",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Voltage clamp with 3 clamp levels. Applies a variable current _i (through _simpleSeriesResistance) to try to keep parent cell at _conditioningVoltage until time _delay, _testingVoltage until _delay + _duration, and _returnVoltage afterwards. Only enabled if _active = 1. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "voltageClampTriple"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml/baseVoltageDepPointCurrent"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#voltageClampTriple"
  } ],
  "https://w3id.org/tvbo/neuroml/eventPort" : [ {
    "@value" : "in"
  } ],
  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "active"
  }, {
    "@value" : "conditioningVoltage"
  }, {
    "@value" : "delay"
  }, {
    "@value" : "duration"
  }, {
    "@value" : "returnVoltage"
  }, {
    "@value" : "simpleSeriesResistance"
  }, {
    "@value" : "testingVoltage"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/neuroml/voltageConcDepBlockMechanism",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Synaptic blocking mechanism which varys with membrane potential across the synapse, e.g. in NMDA receptor mediated synapses"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "voltageConcDepBlockMechanism"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/neuroml/baseBlockMechanism"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.neuroml.org/schema/neuroml2#voltageConcDepBlockMechanism"
  } ],
  "https://w3id.org/tvbo/neuroml/hasParameter" : [ {
    "@value" : "blockConcentration"
  }, {
    "@value" : "scalingConc"
  }, {
    "@value" : "scalingVolt"
  } ],
  "https://w3id.org/tvbo/neuroml/requires" : [ {
    "@value" : "v"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/nev",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "nev (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Number of eigenvalues to compute. Must be >= number of state variables for reliable Hopf detection."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "nev"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/newton_max_iterations",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "newton_max_iterations (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Maximum Newton corrector iterations per step: NewtonPar max_iterations on BifurcationKit.jl, and both ITNW and ITMX on the AUTO-07p backends. Unset, each backend keeps its own default, BifurcationKit.jl 25 and AUTO-07p ITNW 5 and ITMX 9. A branch's nested continuation that leaves it unset takes its parent's."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "newton_max_iterations"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/newton_tol",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "newton_tol (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Absolute tolerance on the residual at which the Newton corrector has converged: the norm of the right-hand side f(x, p) at the corrected point must fall below it, in the units of f. BifurcationKit.jl applies it as that bound (NewtonPar tol). AUTO-07p tests the size of each Newton correction instead, relative to the size of the solution, so the AUTO-07p backends (auto-07p and pyrates-bifurcation) set both of its relative criteria to it, EPSL on the parameter and EPSU on the state, and only approximate the residual bound: a correction and the residual it removes differ by the conditioning of the Jacobian. Unset, each backend keeps its own default, BifurcationKit.jl 1e-12 on the residual and AUTO-07p 1e-7 on the correction. A branch's nested continuation that leaves it unset takes its parent's."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "newton_tol"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/nextflow",
