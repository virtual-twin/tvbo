  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/WorkflowDistributeBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Vectorize every axis the backend can batch; fan out the rest."
