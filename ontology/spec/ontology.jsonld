  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y4, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "He*ke*(gamma_3*sigma_v23 + gamma_3T*(Q + coupled_input)) - ke**2*v4 - 2*ke*y4"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZetterbergJansen/state_variables/y5",
