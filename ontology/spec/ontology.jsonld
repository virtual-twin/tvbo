  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A grouped streaming reduction over a node partition (e.g. per-hemisphere cortical wave metrics): the per-timestep observer body is evaluated ONCE for a single group and vmapped over the partition axis, and the per-group outputs are folded to per-group scalar metrics. General in its group-vmap (``gather`` + ``over``); the metric roles (``waves`` / ``directed`` / ``correlation``) name the per-group derived variables the wave finalize reduces to proportion-of-waves, proportion-directed and the median flow–instrength correlation (rho)."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/tvbo/Partition"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PerStageCouplingEvaluation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/BackendCapability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The network coupling is re-evaluated at every stage of a multi-stage integrator (a full part of the vector field) instead of being frozen once per step. Backend-independent numerical contract carried by `Integration.coupling_evaluation: per_stage` (tvboptim maps this to recompute_coupling_per_stage=True; diffrax recomputes the whole RHS per stage regardless)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Per-stage coupling evaluation"
  } ],
  "https://w3id.org/tvbo/enabledByIntegrationSlot" : [ {
    "@value" : "coupling_evaluation:per_stage"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/PeriodDoubling",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Flip bifurcation of a limit cycle: a Floquet multiplier crosses -1 and a period-doubled cycle branches off."
  } ],
