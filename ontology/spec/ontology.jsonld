    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Roessler"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/Roessler/parameters/a"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Roessler/parameters/b"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Roessler/parameters/c"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/Roessler/state_variables/x"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Roessler/state_variables/y"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Roessler/state_variables/z"
  } ],
  "https://w3id.org/tvbo/model_type" : [ {
    "@value" : "generic"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Roessler/parameters/a",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Linear dissipation parameter in y equation."
  } ],
  "http://schema.org/defaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#double",
    "@value" : "0.2"
  } ],
