  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "HowToAcknowledge"
  }, {
    "@value" : "howToAcknowledge"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Sentences that anyone who reuses the artifact must reproduce, one per source that requires one. The meaning of the BIDS `dataset_description.json` field `HowToAcknowledge` (instructions to reusers), never of BIDS `Acknowledgements` (the producer's own thanks); a BIDS export joins the entries into that one field. A step that derives an artifact carries over the entries of every input it read."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "how_to_acknowledge"
  } ]
