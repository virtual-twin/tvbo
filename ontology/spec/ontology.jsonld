}, {
  "@id" : "https://w3id.org/tvbo/models/JansenRit/derived_variables/sigma_y1_y2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Sigmoid function that transforms the average membrane potential of the interneurons populations (y1-y2)\ninto an average firing rate to the PCs."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
