  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Roessler",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "This three-dimensional continuous system is due to Rössler [^Roessler1976]. It is a\nsystem that by design behaves similarly to the Lorenz system and displays a strange\nattractor. However, it is easier to analyze qualitatively, as for example the attractor\nis composed of a single manifold. Default values are the same as the original paper."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Roessler1976"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
