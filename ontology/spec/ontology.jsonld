  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "annotations (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "annotations"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/applied",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "applied (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Whether the nodes listed beside this record are the selected ones. Set by tvbo when it applies the selection, so a resolved network that is saved, frozen into a kit or dumped keeps the selection as the record of how it was derived. Read back beside arrays that are already the selected ones (a save, a kit) it selects nothing again; beside a source that still delivers the dropped nodes (a dumped record naming the unselected companion, a curated network or an atlas) it is applied again by label, and the nodes it keeps have to be the ones the record lists, or the record is refused as written from a source that has changed since. A generated graph is generated at the record's count, which is the kept one, so a dumped selection of one is refused; ``save`` writes its arrays. A recipe leaves it unset; one that sets it beside a node list the selection would still cut is refused."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "applied"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/apply_every",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "apply_every (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Apply update every N iterations"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "apply_every"
  } ]
