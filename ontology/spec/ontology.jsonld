}, {
  "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CouplingStageEvaluation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid839"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "How the network coupling term is evaluated within one step of a multi-stage integrator (Heun, RK4, ...). A backend-neutral numerical contract: whether the coupling is part of the vector field, re-evaluated at each solver stage, or computed once per step and held constant across the stages. Matters because the two choices integrate a different effective system — for stiff / chaotic / multistable dynamics they can converge to different trajectories or attractors."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "https://w3id.org/linkml/permissible_values" : [ {
    "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation#per_stage"
  }, {
    "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation#per_step"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation#per_stage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "per_stage (CouplingStageEvaluation)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "per_stage"
  }, {
    "@value" : "recompute_coupling_per_stage"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Re-evaluate the coupling at every integrator stage, as part of the vector field: standard ODE integration, and what a reference integrator of a stiff, chaotic or multistable network computes. tvboptim's native solvers honour it as recompute_coupling_per_stage=True, NetworkDynamics.jl integrates this way natively, and the jax backend re-evaluates an undelayed coupling at each stage's state and refuses it over a delayed one, whose history read it cannot shift to a stage's time. TVB and the Python graph runner compute the coupling once per step, so they refuse it wherever it changes the system integrated: a multi-stage method over more than one node. tvboptim's diffrax solvers and PyRates integrate this way whatever is declared."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "per_stage"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "per-stage coupling evaluation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Re-evaluate the network coupling term at every stage of a multi-stage integrator. Costlier, but the coupling seen by each stage is consistent with that stage's state; the difference from per-step matters for stiff or chaotic coupled networks."
  } ],
  "https://w3id.org/tvbo/backendParameter" : [ {
    "@value" : "tvboptim: recompute_coupling_per_stage=True"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation#per_step",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "per_step (CouplingStageEvaluation)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/tvbo/CouplingStageEvaluation"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "per_step"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Evaluate the coupling once per integration step and hold it across the step's stages, the TVB scheme: the coupling reduction runs once per step, at the cost of an order of accuracy in the coupling, which can move a sensitive system onto another trajectory. TVB and the Python graph runner always integrate this way, and the jax backend and tvboptim's native solvers do as their default (recompute_coupling_per_stage=False on tvboptim). NetworkDynamics.jl holds each vertex's summed input on parameters that a callback sets at the start of every step, for every multi-stage method, adaptive ones included, and refuses it together with execution.find_fixpoint. tvboptim's diffrax solvers and PyRates re-evaluate the coupling at every stage whatever is declared."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "per_step"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "per-step coupling evaluation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Evaluate the network coupling once per integration step and hold it frozen across the integrator's stages. The default, and the classic TVB treatment."
  } ],
  "https://w3id.org/tvbo/backendParameter" : [ {
    "@value" : "tvboptim: recompute_coupling_per_stage=False"
  } ]
}, {
