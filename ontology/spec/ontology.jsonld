    "@value" : "A*a*(p + C2*Sigm(C1*y0) + c_intercolumn) - 2*a*y4 - a**2*y1"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/JansenRit1995/state_variables/y5",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
