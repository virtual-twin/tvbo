    "@value" : "trim_margins (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "trim_margins"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/truncation_window",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "truncation_window (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Truncated-BPTT window in milliseconds of simulated time: gradients flow back at most this far. Omit for full BPTT."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "truncation_window"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/tvbo.owl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@value" : "https://doi.org/10.1101/2025.11.19.689211"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "https://orcid.org/0000-0001-5266-7235"
  }, {
    "@id" : "https://orcid.org/0000-0002-2599-0165"
  }, {
    "@id" : "https://orcid.org/0000-0002-4643-4782"
  }, {
    "@id" : "https://orcid.org/0000-0003-0197-2576"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "TVB-O, The Virtual Brain Ontology, describes large-scale brain network models and their simulation: neural mass and neural field models with their parameters, state variables and equations, coupling functions, connectomes and brain atlases, integrators and noise, observation models, and the simulation experiments and studies that combine them. Every model, network and experiment curated in the TVB-O database is an individual of the ontology at https://w3id.org/tvbo/<collection>/<name>."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-11-20"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-11-13"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "The Virtual Brain Ontology"
  } ],
  "http://purl.org/pav/version" : [ {
    "@value" : "0.9.0"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "tvbo"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/tvbo/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
