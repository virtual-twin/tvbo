}, {
  "@id" : "https://w3id.org/tvbo/study/subjects_file",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "subjects_file (study)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Path of a file that lists this dataset's subjects, in place of ``subjects``; a dataset states one of the two. A ``.yaml`` or ``.json`` file holds what ``subjects`` would hold (identifiers, ``Subject`` records or a mapping keyed by identifier), a ``.tsv`` or ``.csv`` file is a participants table read by its ``participant_id`` column, and any other file holds one identifier per line. Read each time the subjects are asked for and resolved as ``Cohort.members_file`` is, with the same rule for what a message may say."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/study"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "subjects_file"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/study/template",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "template (study)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "template"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/study/template_variants",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "template_variants (study)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Seeds that supersede ``template`` for one init variant, keyed by variant name. A file every study gets may still need different starting text once the variant says what kind of study this is — a replication's provenance note names a paper, and a general study has no paper to name — so stating only the difference keeps one entry per file rather than two that drift apart. The first selected variant naming a seed wins; absent means every variant starts from ``template``."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/study"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "template_variants"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/study/templates",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "templates (study)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The kinds of study this record covers, keyed by the name ``tvbo study init --template`` takes. An entry's ``in_templates`` names one of these, so a template that nothing declares is a typo rather than a silently empty variant."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo/study"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "templates"
  } ]
}, {
