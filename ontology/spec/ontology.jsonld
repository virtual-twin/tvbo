  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(y2, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "He*ke*(gamma_2*sigma_v1 + gamma_2T*(P + coupled_input)) - ke**2*v2 - 2*ke*y2"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/ZetterbergJansen/state_variables/y3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
