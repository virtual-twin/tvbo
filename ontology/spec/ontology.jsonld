  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Two-dimensional dissipative map exhibiting chaotic attractors for standard parameter\nsets; sometimes mischaracterized as the “simplest” strange attractor."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Zaslavskii1978"
  } ],
