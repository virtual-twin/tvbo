}, {
  "@id" : "https://w3id.org/tvbo/models/DoublePendulum",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Famous chaotic double pendulum (planar) with two point masses connected by\nmassless rods. The ordering of variables is [θ₁, ω₁, θ₂, ω₂]. Shows sensitive\ndependence and rich energy-dependent phase space structure. The auxiliary\nvariables φ = θ₂ - θ₁ and Δ = (M1 + M2) - M2 cos² φ appear in the equations."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "DoublePendulum"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/DoublePendulum/derived_variables/Delta"
  }, {
    "@id" : "https://w3id.org/tvbo/models/DoublePendulum/derived_variables/phi"
  } ],
