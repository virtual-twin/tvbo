  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "events"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/evict",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "evict (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Recurrence taking one leaving sample `v` back out of the state."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "evict"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/evict_equation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "evict_equation (slot)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Optional reverse recurrence for a **sliding-window** reduction: the per-step downdate that removes the sample leaving the window, the inverse of ``equation`` (which folds an arriving sample in). Only meaningful when ``equation_type: recurrence`` on an observation's auxiliary ``dynamics``. When present, the observer is a windowed reduction — its state is maintained by ``equation`` (add) and ``evict_equation`` (evict) and rebuilt exactly from the window on resync — rather than a cumulative accumulator over the whole trajectory (``equation`` alone). Absent for ordinary state variables and cumulative reductions."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/tvbo"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "evict_equation"
  } ]
}, {
