}, {
  "@id" : "https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/A",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "A (GastSchmidtKnosche_SD state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "A"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(A, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "B/tau_A"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/B",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "B (GastSchmidtKnosche_SD state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "B"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(B, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(-A - 2*B + alpha*r)/tau_A"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/V",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "V (GastSchmidtKnosche_SD state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "V"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(V, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(I + J*r*tau*(1 - A) + V**2 + c_glob0*cr + c_glob1*cv + eta - pi**2*r**2*tau**2)/tau"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/r",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "r (GastSchmidtKnosche_SD state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "r"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(r, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(Delta/(pi*tau) + 2*V*r)/tau"
  } ]
}, {
