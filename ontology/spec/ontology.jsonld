    "@value" : "gamma (GenericLinear parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Slope parameter of the state-variable 'x_GL', representing the inverse of the relaxation time.\n\nNote: The ‘minus’ sign for the self-connections, scaled by 'gamma_GL', guarantees that the nodes have a stable equilibrium point (ref)."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "gamma"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/GenericLinear/state_variables/x",
