  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0042391"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "v_syn (CoombesByrne2D parameter)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "QIF membrane reversal potential"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "v_syn"
  } ],
  "https://w3id.org/tvbo/surrogate_of" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0042391"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/CoombesByrne2D/state_variables/V",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "V (CoombesByrne2D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "V"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(V, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "V**2 + c_glob + eta + pi*k*r*(-V + v_syn) - pi**2*r**2"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/CoombesByrne2D/state_variables/r",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/StateVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "r (CoombesByrne2D state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "r"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(r, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "Delta/pi + 2*V*r - pi*k*r**2"
  } ]
