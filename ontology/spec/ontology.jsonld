  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "w (AdaptiveExponentialIF state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "w"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(a*(v - EL) - w) / tauw"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/Antidots",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Hamiltonian antidot lattice (periodic Sinai-like billiard) with smooth circular\nrepulsive potentials and perpendicular magnetic field. Models guiding center\ndynamics and magnetotransport phenomena in mesoscopic systems. Smooth radial\nrepulsion implemented as a quartic polynomial potential inside radius (d0/2 + c)\nmatching the original implementation (Datseris 2019); outside region force is zero."
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@id" : "https://w3id.org/tvbo/studies/Datseris2019"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/Dynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/tvbo/tvbo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Antidots"
  } ],
  "https://w3id.org/tvbo/hasDerivedVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/Antidots/derived_variables/Ux"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Antidots/derived_variables/Uy"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Antidots/derived_variables/rho"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Antidots/derived_variables/xt"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Antidots/derived_variables/yt"
  } ],
  "https://w3id.org/tvbo/hasParameter" : [ {
    "@id" : "https://w3id.org/tvbo/models/Antidots/parameters/B"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Antidots/parameters/c"
  }, {
    "@id" : "https://w3id.org/tvbo/models/Antidots/parameters/d0"
  } ],
  "https://w3id.org/tvbo/hasStateVariable" : [ {
    "@id" : "https://w3id.org/tvbo/models/Antidots/state_variables/vx"
  }, {
