  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "V_e (DumontGutkin state variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "V_e"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "Derivative(V_e, t)"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "(I_e + V_e**2 + eta_e - pi**2*r_e**2*tau_e**2 + s_ee*tau_e - s_ei*tau_e)/tau_e"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/models/DumontGutkin/state_variables/V_i",
