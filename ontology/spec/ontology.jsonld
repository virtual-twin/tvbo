}, {
  "@id" : "https://w3id.org/tvbo/WilsonCowan/derived_variables/x_e",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Average level of excitation in excitatory neuron at time t. Can be interpreted as membrane potential (Sanz-Leon et al., 2015)."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0042391"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x_e (WilsonCowan derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x_e"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "x_e"
  } ],
  "https://w3id.org/tvbo/rhs" : [ {
    "@value" : "alpha_e*(-I*c_ei + P + c_ee*E + c_glob + lc_0 + lc_1 - theta_e)"
  } ],
  "https://w3id.org/tvbo/surrogate_of" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0042391"
  } ]
}, {
  "@id" : "https://w3id.org/tvbo/WilsonCowan/derived_variables/x_i",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "Average level of excitation in inhibitory neuron at time t. Can be interpreted as membrane potential. (Sanz-Leon et al., 2015)."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GO_0042391"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/tvbo/DerivedVariable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "x_i (WilsonCowan derived variable)"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "x_i"
  } ],
  "https://w3id.org/tvbo/lhs" : [ {
    "@value" : "x_i"
