@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix biotools: <https://bio.tools/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tvbo: <https://w3id.org/tvbo/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

linkml:Any a sh:NodeShape ;
    rdfs:comment "A scalar value: float, integer, string, or boolean. Used for slots that accept literals of any primitive type, such as argument values which may be numbers, strings, references, or booleans." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass linkml:Any .

tvbo:ColorScale a sh:NodeShape ;
    rdfs:comment "How values become colours, and where the scale starts and stops. Shared by everything that paints a field rather than drawing marks — a colour bar, a cortical surface, a labelled volume, a connectome — so the same question is answered with the same words wherever it is asked, and a limit means the same thing on all four. Every slot here reaches all four; a scale concern only one of them can answer is declared on that one, which is why `center` sits on `Colorbar`." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label tvbo:aspect tvbo:atlas tvbo:center tvbo:color tvbo:connectome tvbo:decimals tvbo:density tvbo:edge_alpha tvbo:edge_color tvbo:edge_percentile tvbo:edge_width tvbo:fraction tvbo:geometry tvbo:hemi tvbo:image tvbo:intensity_projection tvbo:labels tvbo:location tvbo:mask tvbo:mesh tvbo:mesh_format tvbo:missing_color tvbo:node_edge_color tvbo:node_edge_width tvbo:node_size tvbo:orientation tvbo:pad tvbo:projection tvbo:show tvbo:surface_atlas tvbo:template tvbo:ticklabels tvbo:ticks tvbo:view tvbo:width ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "The value the scale ends at. See `vmin`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:vmax ],
        [ sh:datatype xsd:float ;
            sh:description "Clip the limit to this percentile of the values (100 = no clipping), so one outlier region cannot wash the whole map out. Applies whether or not the scale is centred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:percentile ],
        [ sh:datatype xsd:float ;
            sh:description "The value the scale starts at. A declared end is honoured as given; the other is still derived from the data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:vmin ],
        [ sh:datatype xsd:string ;
            sh:description "The scale, as a key of the theme's `colormaps` (`sequential`, `diverging`, or one a project added) or a name the backend knows. Unset takes the theme's `sequential`, or its `diverging` where the scale is centred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:colormap ],
        [ sh:datatype xsd:boolean ;
            sh:description "Centre the limits on zero, so zero is the map's midpoint. What a field of signed deviations needs — read on an off-centre scale it is misleading in a way no axis label catches." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:symmetric ] ;
    sh:targetClass tvbo:ColorScale .

tvbo:Document a sh:NodeShape ;
    rdfs:comment "The envelope of a record written as its own file. ``tvbo_class`` names the class the file holds and ``schema_version`` the schema it was written against; both are facts about the file, so TVBO's dialect drops them before construction and no object ever carries them. Declaring them here is what lets a third party validate a TVBO file with plain ``linkml-validate``. A class taking this mixin pins its own CURIE with ``slot_usage: {tvbo_class: {equals_string: ...}}``, so a file naming the wrong class is refused natively." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The class a file holds, as a CURIE (``tvbo:Network``) — the envelope `Document` declares." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:tvbo_class ;
            sh:pattern "^tvbo:[A-Z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "The schema version a file was written against — the envelope `Document` declares." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:schema_version ] ;
    sh:targetClass tvbo:Document .

tvbo:ExperimentResultSidecar a sh:NodeShape ;
    rdfs:comment "Descriptor for a cached ``ExperimentResult``: the ``.h5`` companion holding the fitted parameter arrays, one ``CachedArray`` entry per array, and the provenance a downstream cache needs to decide whether the result is still valid. Written by ``tvbo.data.experiment_result_io.save_sidecar``, so it is generated rather than authored — but it is self-describing (it carries a ``tvbo_class`` envelope naming this class), which is what lets ``tvbo validate schema`` check a generated sidecar instead of falling back to some unrelated class and failing on its required slots." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Provenance ;
            sh:description "Producing experiment's YAML hash, its input fingerprints and the writing agent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:provenance ],
        [ sh:description "Free-form extra metadata passed through by the writer's caller, so any value shape (``linkml:Any``) rather than a declared one." ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path tvbo:metadata ],
        [ sh:class tvbo:CachedArray ;
            sh:description "One entry per array in the ``.h5`` companion's ``parameters`` group." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path tvbo:parameters ],
        [ sh:datatype xsd:string ;
            sh:description "The schema version a file was written against — the envelope `Document` declares." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:schema_version ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the h5 companion (relative to the yaml)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:data_file ],
        [ sh:datatype xsd:string ;
            sh:description "The class a file holds, as a CURIE (``tvbo:Network``) — the envelope `Document` declares." ;
            sh:in ( "tvbo:ExperimentResultSidecar" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:tvbo_class ;
            sh:pattern "^tvbo:[A-Z][A-Za-z0-9]*$" ] ;
    sh:targetClass tvbo:ExperimentResultSidecar .

tvbo:LossFunction a sh:NodeShape ;
    rdfs:comment "A loss function for optimization with optional aggregation. Extends Function with aggregation specification for per-element losses." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name for this function's output (referenced by subsequent functions)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:output ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:class tvbo:Equation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:Equation ],
        [ sh:class tvbo:Range ;
            sh:description "Time range for generated TimeSeries (for kernel generators). Equation is evaluated at each time point." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path tvbo:time_range ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path skos:notation ],
        [ sh:description "Which dimension to apply the transformation on" ;
            sh:in ( "time" "state" "node" "region" "mode" "sample" "batch" "frequency" "subject" ) ;
            sh:maxCount 1 ;
            sh:order 15 ;
            sh:path tvbo:apply_on_dimension ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path skos:definition ],
        [ sh:class tvbo:Argument ;
            sh:description "Variables consumed by the function (referenced in the equation), keyed by argument name. Each value carries the optional metadata (value, description, unit); the key is the name (no redundant `name:` inside)." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path tvbo:arguments ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareRequirement> ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path tvbo:requirements ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:source_code ],
        [ sh:class tvbo:Aggregation ;
            sh:description "How to aggregate the loss across dimensions. Example: aggregate.over=node, aggregate.type=mean computes loss per node, then averages." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path tvbo:aggregate ],
        [ sh:class tvbo:Callable ;
            sh:description "Software implementation reference (if software-based)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path tvbo:callable ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Function ;
            sh:description "Simple input reference: name of previous function's output in pipeline. For multi-argument functions, use arguments with value references instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path tvbo:input ],
        [ sh:class tvbo:Equation ;
            sh:description "Output transformation equation (if equation-based)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path tvbo:output_equation ] ;
    sh:targetClass tvbo:LossFunction .

tvbo:NamedArray a sh:NodeShape ;
    rdfs:comment "A named numeric array. Used as a sidecar slot value where a schema-typed object (e.g. ``ExperimentResult.parameters``) holds multiple arrays addressable by name (``w_LRE``, ``w_FFI``, ``J_i``, ...). The actual numeric data lives in the companion ``.h5`` at ``parameters/<name>``; the YAML carries only the descriptor." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Array dimensions." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:shape ],
        [ sh:datatype xsd:string ;
            sh:description "Optional unit annotation (e.g. 'nA')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:unit ],
        [ sh:datatype xsd:string ;
            sh:description "Field name; matches the h5 dataset path under ``parameters/``." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Numpy dtype string, recording what the companion actually holds." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:dtype ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:description ] ;
    sh:targetClass tvbo:NamedArray .

tvbo:Palette a sh:NodeShape ;
    rdfs:comment "A project's colours, named by role. The colour half of a `Theme`, and a document in its own right for a consumer that wants colours and nothing else (:mod:`tvbo.plot.palette`, the documentation site's stylesheet). A style sheet carries only what matplotlib has an rcParam for, which stops short of the roles a figure reasons in: the one colour that means *this is the point*, the neutral everything unlabelled is drawn in, the hairline behind it. Naming them here is what makes recolouring a project one edit that every panel follows. The cycler is `[base] + palette`, so a plot that names no colour comes out neutral and only a panel meaning to separate conditions reaches into the hues; `highlight` sits outside the cycler, because a colour handed to the second line of every plot cannot also mean emphasis. TVB-O's own is curated at `tvbo:themes/default`, and is the palette in force until a project names one of its own." ;
    sh:closed true ;
    sh:ignoredProperties ( dcterms:identifier rdf:type tvbo:align_labels tvbo:axis_ends tvbo:axis_margin tvbo:axis_width tvbo:bar_edge_width tvbo:colorbar_ends tvbo:colorbar_outline tvbo:dpi tvbo:editable_text tvbo:end_tick_reach tvbo:errorbar_cap_size tvbo:exponent_as_power tvbo:font_family tvbo:font_size tvbo:font_weight tvbo:format tvbo:grid_below tvbo:grid_lines tvbo:grid_style tvbo:grid_width tvbo:label_pad tvbo:label_scale tvbo:label_weight tvbo:layout_engine tvbo:legend_frame tvbo:legend_handle_length tvbo:legend_handle_text_pad tvbo:legend_label_spacing tvbo:legend_loc tvbo:legend_marker_scale tvbo:legend_pad tvbo:legend_scale tvbo:line_cap tvbo:line_width tvbo:marker_edge_width tvbo:marker_size tvbo:math_font tvbo:max_ticks tvbo:minor_tick_length tvbo:minor_tick_width tvbo:minor_ticks tvbo:mirror_ticks tvbo:opts tvbo:pad tvbo:panel_number_case tvbo:panel_number_format tvbo:panel_number_loc tvbo:panel_number_offset tvbo:panel_number_scale tvbo:panel_number_weight tvbo:panel_numbers tvbo:schema_version tvbo:spine_offset tvbo:spine_trim tvbo:spines tvbo:style tvbo:tick_direction tvbo:tick_format tvbo:tick_label_scale tvbo:tick_length tvbo:tick_pad tvbo:tick_steps tvbo:tick_width tvbo:ticks tvbo:title_loc tvbo:title_pad tvbo:title_scale tvbo:title_weight tvbo:transparent tvbo:trim_margins tvbo:tvbo_class tvbo:unicode_minus ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Standard lines, bars and markers, wherever the colour carries no meaning. Leads the cycler." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:base ],
        [ sh:datatype xsd:string ;
            sh:description "The categorical hues, reached into only where a panel separates conditions. Ordered, and named by index from zero (`palette.0` is the first), so inserting a hue recolours every figure that names one after it." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:palette ],
        [ sh:class tvbo:Colormaps ;
            sh:description "The continuous scales, so both kinds of colour move together and no figure names a colormap of its own." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:colormaps ],
        [ sh:datatype xsd:string ;
            sh:description "The page the figure is printed on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:background ],
        [ sh:datatype xsd:string ;
            sh:description "Hairlines and de-emphasised strokes: present, and not competing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:muted ],
        [ sh:datatype xsd:string ;
            sh:description "Text, spines and ticks: the near-black everything is read against." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:ink ],
        [ sh:datatype xsd:string ;
            sh:description "The single emphasis colour, kept out of the cycler so it never lands on a panel by accident." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:highlight ] ;
    sh:targetClass tvbo:Palette .

tvbo:Phenotype a sh:NodeShape ;
    rdfs:comment """Per-subject phenotype table (BIDS ``phenotype/`` directory convention). Carries cognitive scores, clinical scales, demographic variables, behavioral task outputs, physiological measures, or any other per-subject numeric measurement bundle for a cohort. Sidecar companion to per-subject Network sidecars in multi-subject studies that correlate simulated quantities with empirical scores (e.g. PMAT24_A, g-factor, CardSort, ProcSpeed for Schirner 2023). The yaml carries metadata + the measure list; the h5 carries ``measures/<name>`` 1-D float arrays of length ``len(subjects)``.
Aligns with the BIDS phenotype standard (https://bids-specification.readthedocs.io/en/stable/modality-agnostic-files/phenotypic-and-assessment-data.html) and with NIDM's ``nidm:Phenotype`` concept. Per-measure metadata can optionally carry Cognitive Atlas (https://www.cognitiveatlas.org/) ``cogat:Task`` and ``cogat:Concept`` IRIs via ``measure_specs``.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Path to the h5 companion (relative to the yaml)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:data_file ],
        [ sh:datatype xsd:string ;
            sh:description "The schema version a file was written against — the envelope `Document` declares." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:schema_version ],
        [ sh:datatype xsd:string ;
            sh:description "Names of the measures present in the h5 companion (one ``measures/<name>`` dataset per name). Example: ``[g_factor, PMAT24_A_CR, PMAT24_A_RTCR, CardSort_Unadj, ProcSpeed_Unadj]``." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:measures ],
        [ sh:datatype xsd:string ;
            sh:description "Cohort label (e.g. 'HCPYA', 'PPMI')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:cohort ],
        [ sh:class tvbo:MeasureSpec ;
            sh:description "Optional per-measure metadata (Cognitive Atlas IRIs, units, description). When present, each entry's ``name`` must match an entry in ``measures``." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:measure_specs ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for this phenotype bundle." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Ordered list of subject IDs (e.g. HCP-YA 6-digit IDs). Each ``measures/<name>`` array in the h5 companion is indexed by this order." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:subjects ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "The class a file holds, as a CURIE (``tvbo:Network``) — the envelope `Document` declares." ;
            sh:in ( "tvbo:Phenotype" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:tvbo_class ;
            sh:pattern "^tvbo:[A-Z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "cognitive" ;
            sh:description "Coarse classification of the phenotype bundle, used for filtering in larger study libraries. Canonical values: ``cognitive`` (intelligence / memory / attention scores), ``clinical`` (UPDRS, MMSE, …), ``behavioral`` (raw task outputs), ``demographic``, ``physiological``, ``derived`` (composite scores like g-factor or brain-age). Free string — extend as needed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:category ],
        [ sh:class tvbo:Provenance ;
            sh:description "W3C PROV-O aligned provenance for this entity — what it was derived from, which agent produced it, and when." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:provenance ] ;
    sh:targetClass tvbo:Phenotype .

tvbo:Reducer a sh:NodeShape ;
    rdfs:comment "A streaming reduction, authored as symbolic recurrences over its own state rather than as backend code. Folded into the integrator carry so a windowed observable (a sliding-window FC, a running mean) is computed without ever materialising the trajectory. `add` folds an arriving sample in, `evict` takes a leaving one back out, `resync` rebuilds the state exactly from the window when incremental drift would accumulate, and `emit` reads the reduced value out. TVBO lowers all four through the sympy printers, so no backend ships a reducer and adding one is a YAML file rather than code." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Assignment ;
            sh:description "Recurrence rebuilding the state exactly from the whole window `x`." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:resync ],
        [ sh:class tvbo:Assignment ;
            sh:description "Recurrence rebuilding the state from a fixed-size ring in which only `L` rows are live, selected by mask `m`. Separate from `resync` because a ring sized for the longest window carries rows that are not yet part of it, and summing over them would fold padding into the result. Absent where a reducer has no ring to mask." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path tvbo:resync_masked ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class tvbo:Assignment ;
            sh:description "Recurrence taking one leaving sample `v` back out of the state." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path tvbo:evict ],
        [ sh:datatype xsd:string ;
            sh:description "Codegen backends this recipe is registered for; others recompute." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:backends ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:defaultValue "window" ;
            sh:description "Whether the reduced value is read out every step or every stride." ;
            sh:in ( "window" "stride" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path tvbo:emit_kind ],
        [ sh:datatype xsd:string ;
            sh:description "The names carried across steps — the reducer's own carry." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:state ],
        [ sh:datatype xsd:string ;
            sh:description "Dotted references to the post-scan pipeline reducers this streams." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:replaces ],
        [ sh:datatype xsd:string ;
            sh:description "Expression reading the reduced value out of the state." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:emit ],
        [ sh:class tvbo:Assignment ;
            sh:description "Recurrence folding one arriving sample `v` into the state." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:add ] ;
    sh:targetClass tvbo:Reducer .

tvbo:SpatialField a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Scalar, vector, or tensor." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:quantity_kind ],
        [ sh:datatype xsd:float ;
            sh:description "Constant initial value for the field. Absent means undeclared; see ``StateVariable.initial_value``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:initial_value ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:time_dependent ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Mesh ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:mesh ],
        [ sh:class tvbo:NDArray ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:values ],
        [ sh:class tvbo:Equation ;
            sh:description "Analytic initial condition for the field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:initial_expression ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:unit ] ;
    sh:targetClass tvbo:SpatialField .

tvbo:Study a sh:NodeShape ;
    rdfs:comment "Bibliographic anchor for a source publication, identified by its citation key (``citekey``).  The full bibliographic record lives in the project BibTeX library (references.bib) and is resolved by citekey; this node carries only identity, display fields and the knowledge-graph hooks (the concepts that cite it).  Specialised by SimulationStudy, which adds the experiments derived from the source." ;
    sh:closed true ;
    sh:ignoredProperties ( dcterms:references rdf:type rdfs:label prov:wasDerivedFrom tvbo:analyses tvbo:archive tvbo:code_source tvbo:datasets tvbo:figures tvbo:key tvbo:model tvbo:requires tvbo:results tvbo:sample tvbo:simulation_experiments tvbo:studies tvbo:theme tvbo:workflow ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path bibo:doi ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "BibTeX citation key; the join key into references.bib for full bibliographic detail. A study is identified by its key/citekey and described by its title — no ``name`` needed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:citekey ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Author display strings (full detail in references.bib)." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:authors ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:issued ],
        [ sh:datatype xsd:string ;
            sh:description "Publication type (article, book, inproceedings, …)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:type ] ;
    sh:targetClass tvbo:Study .

<https://w3id.org/tvbo/dbs/DBSDataset> a sh:NodeShape ;
    rdfs:comment "Collection of data related to a specific DBS study." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/tvbo/study/Cohort> ;
            sh:description "Named subsets of this dataset's subjects (``Cohort``). A reference reads a cohort by its identifier (``used: {cohort: <id>}``): each member's file is found under this dataset's ``bids_root``." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/study/cohorts> ],
        [ sh:datatype xsd:string ;
            sh:description "Global condition labels applied across all subjects (e.g., ['rest', 'task-nback', 'task-motor'])." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <https://w3id.org/tvbo/study/conditions> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:description ],
        [ sh:defaultValue "fan_out" ;
            sh:description "How the per-subject fits are executed. ``fan_out`` (default) runs one per-subject job, each binding its own targets at run time. ``on_device`` evaluates the whole cohort together as one vectorised batch on a single device — the subject axis mapped in parallel while the shared network is reused across subjects. Backend-independent intent: the scientific spec is identical either way; only the execution strategy differs (a backend realises the batch with its own vectorised-map primitive)." ;
            sh:in ( "fan_out" "on_device" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path <https://w3id.org/tvbo/study/batch_mode> ],
        [ sh:datatype xsd:string ;
            sh:description "Path of this dataset's phenotype table, which a cohort ``rule`` reads its measure from: a ``Phenotype`` sidecar (``.yaml``, values in its companion) or a tabular file (``.tsv`` or ``.csv``, one row per subject under ``participant_id``, one column per measure, ``n/a`` for a missing value); a file of another suffix is an error. Resolved as ``Cohort.members_file`` is." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/study/phenotype_file> ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Transformation> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/dbs/coordinate_space> ],
        [ sh:datatype xsd:string ;
            sh:description "Path to BIDS dataset root directory. When set, subject networks and empirical data paths are resolved relative to this root. A workflow kit copies the files its experiments read from here into its own ``data/<dataset_id>/`` and freezes this path to that copy." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <https://w3id.org/tvbo/study/bids_root> ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable dataset name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:integer ;
            sh:description "On-device chunk width — how many subjects form one vectorised batch. Absent = the whole cohort in one batch, bounded by the working-memory budget (as for exploration ``n_parallel``). Ignored when ``batch_mode`` is ``fan_out``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://w3id.org/tvbo/study/batch_size> ],
        [ sh:class <https://w3id.org/tvbo/dbs/DBSSubject> ;
            sh:description "Subjects in a dataset." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/dbs/subjects> ],
        [ sh:datatype xsd:string ;
            sh:description "DOI or citation for this dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dcterms:references ],
        [ sh:class <https://w3id.org/tvbo/dbs/ClinicalScore> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/tvbo/dbs/clinical_scores> ],
        [ sh:datatype xsd:string ;
            sh:description "Path of a file that lists this dataset's subjects, in place of ``subjects``; a dataset states one of the two. A ``.yaml`` or ``.json`` file holds what ``subjects`` would hold (identifiers, ``Subject`` records or a mapping keyed by identifier), a ``.tsv`` or ``.csv`` file is a participants table read by its ``participant_id`` column, and any other file holds one identifier per line. Read each time the subjects are asked for and resolved as ``Cohort.members_file`` is, with the same rule for what a message may say." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/study/subjects_file> ] ;
    sh:targetClass <https://w3id.org/tvbo/dbs/DBSDataset> .

<https://w3id.org/tvbo/study/StudyLayout> a sh:NodeShape ;
    rdfs:comment "Directory layout of a study dataset, and the single ground truth for it. Everything that creates, resolves, ignores, validates or documents a study's directories reads this record instead of restating the tree, so the layout cannot drift between the scaffolder, the path resolvers, the ignore files, the validator and the docs. The vocabulary deliberately mirrors the BIDS ``rules/directories.yaml`` (``name``, ``level``, ``opaque``, ``subdirs``) so a layout can be diffed against the standard." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:defaultValue "study" ;
            sh:description "BIDS ``DatasetType`` this layout realises, written into the dataset's ``dataset_description.json``." ;
            sh:in ( "raw" "derivative" "study" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/study/dataset_type> ],
        [ sh:class <https://w3id.org/tvbo/study/StudyDirectory> ;
            sh:description "Directories under the dataset root, in the order a reader should meet them." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/study/subdirs> ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class <https://w3id.org/tvbo/study/StudyTemplate> ;
            sh:description "The kinds of study this record covers, keyed by the name ``tvbo study init --template`` takes. An entry's ``in_templates`` names one of these, so a template that nothing declares is a typo rather than a silently empty variant." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/study/templates> ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS version the layout was written against." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/study/bids_version> ],
        [ sh:class <https://w3id.org/tvbo/study/StudyFile> ;
            sh:description "Files at the dataset root." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/study/files> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass <https://w3id.org/tvbo/study/StudyLayout> .

schema1:ImageObject a sh:NodeShape ;
    rdfs:comment "A publication figure, a mosaic of panels rendered from result containers. Reuses name (identifier) and description (caption)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Relative heights of the mosaic rows, e.g. [1.15, 1, 1, 1] to make the top panel taller. Length = number of rows." ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path tvbo:height_ratios ],
        [ sh:datatype xsd:float ;
            sh:description "How far the left and bottom spines of this figure sit outside the data area, in axes fractions. 0 makes them meet at the origin. Unset takes the theme's `spine_offset`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path tvbo:spine_offset ],
        [ sh:datatype xsd:string ;
            sh:description "Panel groups that share one y scale, each entry a comma-separated list of mosaic keys ('c,g,h'). Same rule as share_x." ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path tvbo:share_y ],
        [ sh:datatype xsd:boolean ;
            sh:description "Trim surrounding whitespace from the saved figure (default true). Trimming re-crops to the drawn content, so the saved aspect can differ from width/height; set false to preserve the declared width×height proportions exactly, e.g. to match an original figure. Renders as bbox_inches='tight' on a matplotlib backend." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:trim_margins ],
        [ sh:description "Which layout engine positions the panels. Unset lets the backend pick; name one to stop a dense mosaic being laid out by whatever the engine falls back to when its solver gives up, and 'none' to keep the gridspec's own positions when panels place their content at absolute geometry." ;
            sh:in ( "constrained" "compressed" "tight" "none" ) ;
            sh:maxCount 1 ;
            sh:order 25 ;
            sh:path tvbo:layout_engine ],
        [ sh:class tvbo:Animation ;
            sh:description "Turns the figure into a movie over one dimension of its data instead of a still. Every other field keeps its meaning — the mosaic, the panels, the sizing and the styling are the frame; the animation only says which dimension advances and how fast. Declaring it is what makes a figure whose subject is a *process* show the process rather than a snapshot of it, without a second, hand-written plotting path." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 31 ;
            sh:path tvbo:animation ],
        [ sh:datatype xsd:float ;
            sh:description "[dx, dy] shift of every panel letter from its corner, in axes fractions. The default sits it on the axes corner, where a top y-tick label can reach it; a small negative dx clears the tick labels. Unset takes the theme's `panel_number_offset`." ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path tvbo:panel_number_offset ],
        [ sh:datatype xsd:string ;
            sh:description "Style layers underneath the theme, applied left to right: a registered bsplot style name (`tvbo`, `nature`) or a path to an .mplstyle. This is where a look TVB-O has no field for goes — another project's house style, a journal's sheet, the rcParams of a paper being reproduced. Anything `theme` states wins over all of it. The name 'tvbo-palette' is an alias for `theme: {iri: tvbo:themes/default}`, kept because it reads well in a list." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:style ],
        [ sh:class tvbo:Theme ;
            sh:description "The look this figure declares where it differs from its study's `theme`: its colours, the geometry a style sheet used to own, and its axis rule. Whatever it states beats the study's theme and every layer in `style`, always — declared beats layered, so a figure's look can be read off its own spec instead of reconstructed from the sheets underneath it. An `iri` named here draws this figure in that curated theme in place of the study's, and the fields stated beside it override that theme in turn." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:theme ],
        [ sh:datatype xsd:float ;
            sh:description "Figure width in mm (physical print size). Font size is in points and independent of this, so a smaller figure makes text relatively larger." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:width ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "The heading this figure carries in a report. Unset, a report reads the paper's own number out of the name (Fig4, EDF10). A replication that answers a question the paper left open produces figures with no published counterpart, and those need a title of their own rather than a number that would read as the paper's." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:label ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this figure's axes follow a theme's axis rule. `false` leaves every axis exactly as its panels drew it, whatever the study's theme says: no tick re-placed, no limit moved, no spine detached or trimmed, no labels aligned. `true` draws it by the curated `tvbo:themes/bsplot` rule wherever neither its own theme nor its study's states one. Unset follows the theme." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:auto_format ],
        [ sh:class tvbo:WorkflowConfig ;
            sh:description "Per-figure HPC/workflow resource refinement (reuses WorkflowConfig, same pattern as SimulationExperiment.workflow_overrides); lets a heavy render request its own resources when figures are emitted as workflow jobs. The figure's Layer.used edges become the render rule's input dependencies." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path tvbo:workflow_overrides ],
        [ sh:datatype xsd:float ;
            sh:description "Panel-letter size in points. Unset scales it above the body font_size by the theme's `panel_number_scale`, the convention most journals follow — a letter set at the body size reads as a tick label rather than as the panel's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path tvbo:panel_number_size ],
        [ sh:datatype xsd:float ;
            sh:description "Relative widths of the mosaic columns." ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path tvbo:width_ratios ],
        [ sh:datatype xsd:string ;
            sh:description "bsplot mosaic string; letters = panel keys, slash (or newline) = new row, repeated letters span cells, dot = empty. e.g. aab/ccb." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:layout ],
        [ sh:datatype xsd:integer ;
            sh:description "Raster resolution (dots per inch); scales pixel output only, not the physical size or the font size. Unset takes the theme's `dpi`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:dpi ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Output format (pdf/svg/png). Unset defers to the renderer default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:format ],
        [ sh:datatype xsd:string ;
            sh:description "Panel groups that share one x scale, each entry a comma-separated list of mosaic keys ('c,g,h'). Every panel in a group ends on the union of the group's limits. Declare it whenever a panel's tick labels are hidden as another panel's: hiding them alone asserts a shared scale the axes do not actually have, and a reader then compares two panels drawn at different ranges." ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path tvbo:share_x ],
        [ sh:class tvbo:Provenance ;
            sh:description "W3C PROV-O aligned provenance for this entity — what it was derived from, which agent produced it, and when." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Base font size in points (physical: 1 pt = 1/72 inch). The real text size, unchanged by figure size or dpi; set it (or the width) so labels are legible at print size. Unset takes the theme's `font_size`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:font_size ],
        [ sh:datatype xsd:string ;
            sh:description "The published figure this one reproduces, as a path relative to the study root (e.g. original_study/img/fig_04.png). Names the A/B target for `tvbo figure compare`, which measures panel geometry against it; it is never a data source, and never rendered into a panel." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:reference_image ],
        [ sh:description "Which corner the panel letter sits in. Unset takes the theme's `panel_number_loc`, then bsplot's own placement on top of the left spine." ;
            sh:in ( "upper left" "upper right" "lower left" "lower right" ) ;
            sh:maxCount 1 ;
            sh:order 19 ;
            sh:path tvbo:panel_number_loc ],
        [ sh:description "Which sides of the axes frame this figure draws: `box` (all four) or `open` (left and bottom). Unset takes the theme's `spines`, and failing that the active style's." ;
            sh:in ( "open" "box" ) ;
            sh:maxCount 1 ;
            sh:order 24 ;
            sh:path tvbo:spines ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw automatic panel letters (a, b, ...). Unset takes the theme's `panel_numbers`, and draws them where the theme says nothing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path tvbo:panel_numbers ],
        [ sh:datatype xsd:float ;
            sh:description "Figure height in mm (physical print size)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:height ],
        [ sh:defaultValue "main" ;
            sh:description "Which part of a generated report this belongs in — the main Methods or the supplementary material. Placement only: every experiment runs and every figure renders regardless, so demoting one never changes what is computed. It answers a different question from a replication's target tier (how central a claim is) and from the source paper's own Fig/EDF numbering (where *they* printed it), because our document may carry a headline result's parameter dump in the SI, or relegate a figure the paper printed up front. Defaults to ``main``, so a recipe that says nothing keeps everything in the Methods." ;
            sh:in ( "main" "supplementary" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path tvbo:part ],
        [ sh:class tvbo:Panel ;
            sh:description "Panels keyed by their mosaic label." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 32 ;
            sh:path tvbo:panels ],
        [ sh:datatype xsd:float ;
            sh:description "Whitespace left around the content when trimming, in inches. Defaults to the backend's own margin (0.1 in for matplotlib), which is visible padding at journal column widths; 0 crops flush to the drawn content. Ignored when trim_margins is false, where the declared canvas fixes the margins instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:pad ],
        [ sh:datatype xsd:string ;
            sh:description "Python format string applied to each panel letter: '{}' -> 'a', '({})' -> '(a)', '{}.' -> 'a.'. Unset takes the theme's `panel_number_format`, then '{}'." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:panel_number_format ],
        [ sh:datatype xsd:string ;
            sh:description "Importable module names whose import registers this figure's custom panels / transforms (via bsplot.register_panel / register_transform). The emitted plot.py imports them, so a study ships its bespoke figure code in its code_source instead of in core tvbo. The modules must be importable when the figure renders (loading the study puts its code/ dir on the path)." ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path tvbo:code_modules ] ;
    sh:targetClass schema1:ImageObject .

<http://uri.interlex.org/tgbugs/uris/readable/atlas/Atlas> a sh:NodeShape ;
    rdfs:comment "A schema for representing a version of a brain atlas." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/parcellationTerminology> ;
            sh:description "Add the parcellation terminology version used for this brain atlas version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/terminology> ],
        [ sh:class tvbo:Provenance ;
            sh:description "W3C PROV-O aligned provenance for this entity — what it was derived from, which agent produced it, and when." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path tvbo:provenance ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:creator ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Linked type for the version of a brain atlas or coordinate space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:isVersionOf ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Transformation> ;
            sh:description "Common coordinate space (e.g. MNI152NLin6Asym, MNI152NLin2009cAsym). Reference by name; the CommonCoordinateSpace must be defined in tvbo/database/coordinate_spaces/ (or future equivalent location)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/coordinateSpace> ],
        [ sh:datatype xsd:string ;
            sh:description "Slot for the abbreviation of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path skos:notation ],
        [ sh:datatype xsd:string ;
            sh:description "Enter the version identifier of this brain atlas or coordinate space version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:hasVersion ] ;
    sh:targetClass <http://uri.interlex.org/tgbugs/uris/readable/atlas/Atlas> .

<http://uri.interlex.org/tgbugs/uris/readable/parcellationTerminology> a sh:NodeShape ;
    rdfs:comment "A schema for representing a parcellation terminology, which consists of parcellation entities." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Enter the version identifier of this brain atlas or coordinate space version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:hasVersion ],
        [ sh:datatype xsd:string ;
            sh:description "Add the location of the data file containing the parcellation terminology." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Region> ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/entities> ],
        [ sh:datatype xsd:string ;
            sh:description "Enter the internationalized resource identifier (IRI) to the related ontological terms." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/atlas/hasIlxId> ] ;
    sh:targetClass <http://uri.interlex.org/tgbugs/uris/readable/parcellationTerminology> .

prov:Activity a sh:NodeShape ;
    rdfs:comment "One thing that was done: a solve, a fit, an analysis, a render. The PROV complement of ``Provenance``, which describes an artifact — an artifact is ``prov:wasGeneratedBy`` an Activity, and an Activity ``prov:used`` the artifacts and environment it consumed. Slot names follow BEP028's activity record (``Id``, ``Label``, ``Command``, ``AssociatedWith``, ``Used``, ``StartedAtTime``, ``EndedAtTime``) so a record in that vocabulary serializes to it without a translation table." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "ISO 8601 start time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:started_at ],
        [ sh:class schema1:SoftwareApplication ;
            sh:description "The software that carried the activity out (BEP028 ``AssociatedWith``)." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path tvbo:associated_with ],
        [ sh:description "IRIs of the inputs, outputs and environment the activity consumed (BEP028 ``Used``)." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path tvbo:used ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:description "Controlled-vocabulary terms narrowing what kind of activity this was." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path tvbo:type ],
        [ sh:datatype xsd:string ;
            sh:description "ISO 8601 end time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:ended_at ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "The command performed, parameters included. Null for something done by hand, which BEP028 reads as a manual step and asks a ``description`` for." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:command ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass prov:Activity .

tvbo:AlgorithmInclude a sh:NodeShape ;
    rdfs:comment "Reference to an included algorithm with optional argument overrides. Allows combining algorithms with different hyperparameter values." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Algorithm ;
            sh:description "Reference to the algorithm to include" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path tvbo:algorithm ],
        [ sh:datatype xsd:integer ;
            sh:description "For mode=nested only: number of inner-loop iterations to run per outer iteration. Defaults to the included algorithm's own n_iterations. A small value (e.g. 5-10) is usually enough to correct the drift introduced by one outer step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:inner_iterations ],
        [ sh:class tvbo:Parameter ;
            sh:description "Override hyperparameter values for the included algorithm. Maps parameter names to new values." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path tvbo:arguments ],
        [ sh:defaultValue "combined" ;
            sh:description "How the included algorithm composes with the outer one. 'combined' (default) merges its update rules into the outer loop (applied once per outer iteration); 'nested' runs it as a converging inner loop on each outer iteration before the outer update rules. Use 'nested' when the inner algorithm maintains an invariant the outer would perturb (e.g. FIC holding the working point while EIB retunes coupling)." ;
            sh:in ( "combined" "nested" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path tvbo:mode ] ;
    sh:targetClass tvbo:AlgorithmInclude .

tvbo:AlgorithmStage a sh:NodeShape ;
    rdfs:comment "One stage of a multi-stage tuning schedule. The algorithm body runs once per stage, in order, each stage overriding n_iterations and selected hyperparameters — so a schedule can anneal a learning rate or widen an estimation window as tuning proceeds." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Number of outer iterations to run in this stage." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:n_iterations ],
        [ sh:datatype xsd:boolean ;
            sh:description "Start this stage from the model's declared initial conditions rather than the previous stage's endpoint. The update rules' tuned targets always cross the stage boundary; what resets is the dynamical state — state variables, delay and coupling history, observation window buffers and monitors — and the noise stream, which restarts from the run's seed so each stage samples the same realisation. False, the default, makes the schedule one continuous trajectory; true makes each stage an independent simulation warm-started from the parameters learned so far." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:reset_state ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Parameter ;
            sh:description "Hyperparameter overrides for this stage (e.g. eta, window_size). Names not listed fall back to the algorithm's own hyperparameter defaults." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path tvbo:arguments ] ;
    sh:targetClass tvbo:AlgorithmStage .

tvbo:Animation a sh:NodeShape ;
    rdfs:comment "A figure rendered as a movie over one dimension of its data. The dimension is named, never positional, so the frames advance along the axis the spec means rather than along whatever happens to be axis 0; and because the frame is the same mosaic the still would draw, an animated figure and its still cannot disagree about what they show." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "How many frames to draw. Unset draws one per position along `over`, which for a simulation is one frame per integration sample and is almost never what a figure wants; a smaller number subsamples the axis evenly, so a 600 000-step run becomes a movie of the length declared here." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:frames ],
        [ sh:datatype xsd:string ;
            sh:description "The dimension the frames advance along, by NAME (e.g. `time`). Every layer carrying it is sliced at the current frame unless its own `frame:` says otherwise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:over ],
        [ sh:datatype xsd:integer ;
            sh:description "Which frame is also saved as a still image beside the movie, for the contexts a movie cannot reach — a printed page, a PDF report, a thumbnail. Unset saves no still." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:still ],
        [ sh:datatype xsd:string ;
            sh:description "Movie container: `gif` (default, needs nothing installed) or `mp4` (much smaller, needs ffmpeg on the machine that renders). The saved file takes this extension in place of the still's, so a figure cannot be half-written as both." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:format ],
        [ sh:datatype xsd:integer ;
            sh:description "Playback rate of the saved movie in frames per second (default 20). Independent of `frames`: together they set how long the movie runs, and separately from how much of the data it shows." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:fps ] ;
    sh:targetClass tvbo:Animation .

tvbo:ArchiveConfig a sh:NodeShape ;
    rdfs:comment "How a study packages its run into a COMBINE/OMEX archive: the output location and format, plus any extra files to include beyond the recipes, derived containers, figures and manifest added automatically." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Extra file globs to add beyond the recipes, derived containers, figures and manifest included automatically." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:include ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "omex" ;
            sh:description "Archive format; ``omex`` (COMBINE) by default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:format ],
        [ sh:datatype xsd:string ;
            sh:description "Output archive path, relative to the study recipe. Defaults to ``<name>.omex``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:path ] ;
    sh:targetClass tvbo:ArchiveConfig .

tvbo:AxisReduction a sh:NodeShape ;
    rdfs:comment "Marks an exploration/sweep axis to be collapsed by a statistic in the result container. When set on an ExplorationAxis, that axis's named grid dimension is reduced across every observation that carries it (e.g. an `execution.random_seed` trial ensemble becomes a first-class reduced observation). Backend-independent: states the reduction intent; the result layer applies it by dimension name." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:defaultValue "mean" ;
            sh:description "Statistic used to collapse the axis (mean, sum, std, sem, median). Defaults to mean." ;
            sh:in ( "mean" "sum" "std" "sem" "median" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path tvbo:statistic ] ;
    sh:targetClass tvbo:AxisReduction .

tvbo:Binding a sh:NodeShape ;
    rdfs:comment "Per-backend construction binding for a GraphGenerator: how to build the graph in a specific target library.  Keyed by backend id — the ``name`` is the backend (e.g. python, julia, networkx)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Native library/module providing the callable." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:library ],
        [ sh:datatype xsd:string ;
            sh:description "Ordered parameter names passed to the callable." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:args ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the constructor function in the library." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:callable ] ;
    sh:targetClass tvbo:Binding .

tvbo:BranchSwitch a sh:NodeShape ;
    rdfs:comment "Specification for switching from a detected bifurcation point to a new branch (periodic orbits from Hopf, fold continuation, etc.). Each BranchSwitch says: \"from which special point on the parent branch, continue what kind of object, with what settings.\" Override parent solver settings via the inline continuation field: every setting it leaves unset is the parent Continuation's, on every continuation backend." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Option ;
            sh:description "Toolkit-specific string options for this branch (linear solver, etc.)." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path tvbo:options ],
        [ sh:class tvbo:Continuation ;
            sh:description "Solver settings for this branch, of the same Continuation type. Every setting it leaves unset is the parent's (ds, ds_min, ds_max, max_steps, the tolerances, and the detection and Newton settings), on every continuation backend; one neither declares is the backend's own default for that kind of branch." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path tvbo:continuation ],
        [ sh:datatype xsd:string ;
            sh:description "The special points of the parent continuation the branch starts from, written '<kind>:<n>' for one point and '<kind>:all', or the bare '<kind>', for every point of that kind. <kind> is hopf, fold or bp; <n> is a nonzero integer counting from 1 for the first point, and negative counting back from -1 for the last. Anything else is refused. A periodic-orbit branch starts from Hopf points only, and unset starts from every one ('hopf:all'). A two-parameter branch must declare it: its kind decides whether a fold curve or a Hopf curve is continued, so an unset one is refused by name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:source_point ],
        [ sh:datatype xsd:float ;
            sh:description "Initial parameter offset from the bifurcation point." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:delta_p ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:boolean ;
            sh:description "Continue the branch in both directions from each point it starts from. Unset, the nested continuation's bothside applies, and false where that is unset too; a branch never takes its parent's, which is the direction of the parent's own start. Declaring it here and on the nested continuation with different values is refused." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:bothside ],
        [ sh:class tvbo:Discretization ;
            sh:description "Discretization method for the branch solution. Required for periodic orbit branches (Hopf → PO). Not needed for codim-2 branches (fold/Hopf continuation)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:discretization ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:parameters ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass tvbo:BranchSwitch .

tvbo:CachedArray a sh:NodeShape ;
    rdfs:comment "One numeric array inside a cached-result ``.h5`` companion, described by name, shape and dtype so a reader can check the layout it expects without opening the file." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "NumPy dtype name of the stored array (e.g. ``float64``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:dtype ],
        [ sh:datatype xsd:integer ;
            sh:description "Array shape, outermost axis first." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:shape ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass tvbo:CachedArray .

tvbo:CodeSource a sh:NodeShape ;
    rdfs:comment "Location of a recipe's callable code so the specification is decoupled from where the code lives. Either a local directory or a git repository; the resolved directory (optionally a ``subdir`` within it) is placed on the import path at load time so ``module:`` references resolve by bare name. ``path`` and ``git`` are mutually exclusive." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Git repository URL to fetch the code from (shallow-cloned and cached under ``~/.cache/tvbo/code_sources``). Mutually exclusive with ``path``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:git ],
        [ sh:datatype xsd:string ;
            sh:description "Local directory holding the code, relative to the recipe YAML or absolute. Mutually exclusive with ``git``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:path ],
        [ sh:datatype xsd:string ;
            sh:description "Subdirectory within the source to place on the import path (defaults to the source root)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:subdir ],
        [ sh:datatype xsd:string ;
            sh:description "Git branch, tag, or commit to check out (``git`` sources only). Defaults to the repository's default branch." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:ref ] ;
    sh:targetClass tvbo:CodeSource .

tvbo:ConditionalBlock a sh:NodeShape ;
    rdfs:comment "A single condition and its corresponding equation segment." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The equation to apply when the condition is met." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:expression ],
        [ sh:datatype xsd:string ;
            sh:description "The condition for this block (e.g., t > onset)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:condition ] ;
    sh:targetClass tvbo:ConditionalBlock .

tvbo:CouplingInput a sh:NodeShape ;
    rdfs:comment "Specification of a coupling input channel for multi-coupling dynamics" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Named keys for multi-dimensional coupling. When dimension > 1, provides symbolic names for each index (e.g., keys: [lre, ffi] for dimension: 2). Used in equations as variable names." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:keys ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:symbol ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Dimensionality of the coupling input (number of coupled values)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:dimension ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the coupling function that feeds this input. When omitted, resolved automatically: (1) same name as a coupling function → direct match, (2) single coupling input and single coupling function → auto-mapped, (3) multiple of each → positional order." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:source ],
        [ sh:datatype xsd:boolean ;
            sh:description "Marks this as a LOCAL (surface/local-connectivity) coupling term rather than a global long-range coupling. Local terms are never wired to the connectome; they evaluate to 0 unless a local/surface connectivity is supplied (TVB's ``local_coupling``). Global coupling inputs (the default) are driven by ``Network.coupling``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:local ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass tvbo:CouplingInput .

tvbo:DataSource a sh:NodeShape ;
    rdfs:comment "Specification for loading external/empirical data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "File path or URI to the data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:path ],
        [ sh:datatype xsd:string ;
            sh:description "Key/variable name within the file (for .mat, .npz, etc.)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:key ],
        [ sh:class tvbo:Callable ;
            sh:description "Callable that loads the data (e.g., load_functional_connectivity)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path tvbo:loader ],
        [ sh:class tvbo:Function ;
            sh:description "Optional preprocessing to apply after loading" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:preprocessing ],
        [ sh:datatype xsd:string ;
            sh:description "Data format: 'npy', 'mat', 'csv', 'nifti', etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:format ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ] ;
    sh:targetClass tvbo:DataSource .

tvbo:DifferentialOperator a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Parameter ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path tvbo:coefficient ],
        [ sh:in ( "gradient" "divergence" "laplacian" "curl" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path tvbo:operator_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class tvbo:Equation ;
            sh:description "Symbolic form (e.g., '-div(D * grad(u))')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:expression ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:definition ],
        [ sh:class tvbo:Equation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:Equation ],
        [ sh:class tvbo:Parameter ;
            sh:description "Optional anisotropic tensor (e.g., diffusion)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path tvbo:tensor_coefficient ] ;
    sh:targetClass tvbo:DifferentialOperator .

tvbo:Differentiation a sh:NodeShape ;
    rdfs:comment "Backend-neutral configuration for how gradients are propagated through the temporal integration. Expressed in physical/semantic terms; each backend maps it to its own mechanism (JAX solver grad_horizon / block_size, Julia adjoint sensitivity, ...). Backends without autodiff (e.g. MATLAB) emit a comment noting differentiation is unsupported and proceed with the plain forward integration -- they do not raise." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Gradient-checkpointing interval in milliseconds (backward-pass memory/time trade-off). Omit for no checkpointing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:checkpoint_interval ],
        [ sh:datatype xsd:float ;
            sh:description "Truncated-BPTT window in milliseconds of simulated time: gradients flow back at most this far. Omit for full BPTT." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:truncation_window ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "reverse" ;
            sh:description "Autodiff direction: 'reverse' (default) or 'forward'." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:mode ] ;
    sh:targetClass tvbo:Differentiation .

tvbo:Digest a sh:NodeShape ;
    rdfs:comment "One checksum of an artifact, keyed by the function that produced it. Collected on ``Provenance.digest``, whose collection KEY is the function name — BEP028 takes the names ``MD5``, ``SHA1``, ``SHA-256`` and the rest of that list, and allows an arbitrary label otherwise. Keyed rather than a bare string so an artifact can carry several digests and a reader knows which function to check with." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The checksum as computed by ``algorithm``." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:value ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum function name, e.g. ``SHA-256``." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:algorithm ] ;
    sh:targetClass tvbo:Digest .

tvbo:Discretization a sh:NodeShape ;
    rdfs:comment "Discretization method for boundary value problems in continuation (periodic orbits, connecting orbits, quasi-periodic tori). Specifies the method; method-specific numerics go in parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:defaultValue 3 ;
            sh:description "Number of shooting sections for shooting or Poincaré methods." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:n_sections ],
        [ sh:class tvbo:Option ;
            sh:description "Toolkit-specific string options (jacobian type, etc.)." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:options ],
        [ sh:class tvbo:Solver ;
            sh:description "ODE solver for flow-based methods (shooting, poincaré). Specifies algorithm (e.g. Vern9, Rodas5) and tolerances. Not needed for collocation or trapezoid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:ode_solver ],
        [ sh:defaultValue "collocation" ;
            sh:description "Discretization method." ;
            sh:in ( "collocation" "trapezoid" "shooting" "poincare" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path tvbo:method ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 50 ;
            sh:description "Number of mesh intervals (time slices) for collocation or trapezoid methods. Collocation: N in PeriodicOrbitOCollProblem(N, m). Trapezoid: M in PeriodicOrbitTrapProblem(M=...)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:mesh_intervals ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path tvbo:parameters ],
        [ sh:class tvbo:Solver ;
            sh:description "Linear solver for the Newton bordered system. E.g. COPBLS (collocation), MatrixBLS (shooting/poincaré)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:linear_solver ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 4 ;
            sh:description "Polynomial degree per mesh interval for collocation. The m in PeriodicOrbitOCollProblem(N, m)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:degree ] ;
    sh:targetClass tvbo:Discretization .

tvbo:DistributionConfig a sh:NodeShape ;
    rdfs:comment "Policy for mapping a parameter sweep's exploration axes onto the two parallelism tiers when rendering a distributed workflow. Vectorized axes are packed into a single batched backend call (e.g. vmap/pmap); workflow axes are fanned out into independent scheduler tasks, one per value combination. Backend-independent: the emitter validates that a requested vectorized axis is one the chosen backend can actually batch." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Axis names or parameters to fan out into independent scheduler tasks (one workflow cell per value combination)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:workflow ],
        [ sh:datatype xsd:integer ;
            sh:description "Sharding granularity — the inter-task (inter-node) tier. For a fully vectorized sweep, the number of independent scheduler shards to split the batched cells across (each task runs ``1/chunk`` of the grid on its own node). For a fanned sweep, the number of workflow cells packed into one task. Unset means one shard. This is orthogonal to the intra-task device tier (Exploration.parallel_mode: vmap/lax_map/pmap): on CPU, where nodes are plentiful, raise chunk to fan the grid across many nodes; on GPU, where nodes are scarce, keep chunk=1 so one node holds the whole grid and batches it on-device with vmap rather than claiming many GPUs." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:chunk ],
        [ sh:datatype xsd:string ;
            sh:description "Axis names or parameters to pack into a single vectorized backend call. It is an error to name an axis the backend cannot batch." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:vectorize ],
        [ sh:description "Default tier for axes not named in ``vectorize`` or ``workflow``. Unset means ``auto``." ;
            sh:in ( "auto" "vectorize" "workflow" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path tvbo:by ] ;
    sh:targetClass tvbo:DistributionConfig .

tvbo:Encoding a sh:NodeShape ;
    rdfs:comment "Map visual channels to container dims/coords/vars, by NAME (keyed, never positional). Common case: {x: time, y: rate}. A channel may later accept a scale object without breaking this string form." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Dim/coord/var whose values SEPARATE the marks by colour — a field name, never a colour. `color: node` draws one line per node from the cycler; to fix a mark's colour, use `Style.color`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:color ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:y ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:x ],
        [ sh:datatype xsd:string ;
            sh:description "Non-visual grouping dim (e.g. the hue/iterate dim)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:detail ],
        [ sh:datatype xsd:string ;
            sh:description "Depth channel for a line3d panel (the third phase-space axis); ignored by 2-D kinds." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:z ] ;
    sh:targetClass tvbo:Encoding .

tvbo:EnvironmentVariable a sh:NodeShape ;
    rdfs:comment "One environment variable assignment exported before executing the workflow task command. Use this for reproducible runtime knobs such as XLA/OMP settings in emitted workflow artefacts." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Environment variable name (e.g. XLA_FLAGS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Value exported for this variable." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:value ] ;
    sh:targetClass tvbo:EnvironmentVariable .

tvbo:FieldStateVariable a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Initial value for the first time derivative, used when equation_order > 1. For a second-order ODE d²x/dt² = f, this sets dx/dt(0). Required by ModelingToolkit.jl to fully specify higher-order initial value problems." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path tvbo:derivative_initial_value ],
        [ sh:class tvbo:Noise ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path tvbo:noise ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:variable_of_interest ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:name ],
        [ sh:class tvbo:Equation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:Equation ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Order of the time derivative on the LHS. Default 1 means dx/dt = rhs (first-order ODE). Order 2 means d²x/dt² = rhs (second-order ODE), etc. Higher-order ODEs are automatically lowered to coupled first-order systems by backends like ModelingToolkit.jl via mtkcompile." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:equation_order ],
        [ sh:class tvbo:Equation ;
            sh:description "Optional reverse recurrence for a **sliding-window** reduction: the per-step downdate that removes the sample leaving the window, the inverse of ``equation`` (which folds an arriving sample in). Only meaningful when ``equation_type: recurrence`` on an observation's auxiliary ``dynamics``. When present, the observer is a windowed reduction — its state is maintained by ``equation`` (add) and ``evict_equation`` (evict) and rebuilt exactly from the window on resync — rather than a cumulative accumulator over the whole trajectory (``equation`` alone). Absent for ordinary state variables and cumulative reductions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path tvbo:evict_equation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path skos:definition ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether to include this element in simulation output files. Applicable to state variables (default true), derived variables (default false), and network nodes (default true). On an observation it forces (true) or suppresses (false) persistence in the result; left unset, a terminal observation (one not consumed by another observation or a loss) is recorded and an intermediate one is not. Set false to suppress recording." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:record ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:stimulation_variable ],
        [ sh:class tvbo:Mesh ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:mesh ],
        [ sh:description "External ontology IRIs (typically GO, ChEBI, UBERON, CL, MeSH) that this entity is a surrogate / abstraction / model of. Realized as the `tvbo:surrogate_of` object property, carried inline with the YAML data instance. Multiple IRIs allowed: a single parameter may abstract several biological processes (e.g. a synaptic conductance grounding both GO:0060079 (excitatory PSP) and GO:0007268 (chemical synaptic transmission))." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path tvbo:surrogate_of ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "differential" ;
            sh:description "How to interpret ``equation.rhs`` when advancing this state: 'differential' (default) integrates it as ``dx/dt = rhs``; 'algebraic' is a constraint ``0 = rhs`` / ``x ~ rhs`` (DAE); 'recurrence' is a discrete per-step update ``x_next = rhs`` (no integrator applied), used by an observation's auxiliary ``dynamics`` for online reductions/accumulators (e.g. a running sum ``x_next = x + f``) — the symbolic, backend-independent sibling of the continuous 'differential' form. Algebraic equations are used by ModelingToolkit.jl backend." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:equation_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:symbol ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this state variable is transmitted to connected nodes through the coupling function. In TVB terms, this determines the cvar indices (state variables extracted from history and fed into the coupling function). The coupling function may override this via its incoming_states attribute." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:coupling_variable ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:BoundaryCondition ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:boundary_conditions ],
        [ sh:class tvbo:Range ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path tvbo:domain ],
        [ sh:class tvbo:Distribution ;
            sh:description "Distribution for sampling initial conditions per node. If present, initial_value is used as fallback/mean." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path tvbo:distribution ],
        [ sh:datatype xsd:float ;
            sh:description "Value this state starts at. Absent means undeclared: the consumer supplies its own fallback via ``tvbo.utils.initial_value``, which documents why this slot carries no schema default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path tvbo:initial_value ],
        [ sh:class tvbo:TimeSeries ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path tvbo:history ],
        [ sh:description "Physical unit of measurement. `UnitEnum` is the curated vocabulary — each of its values is vendored from QUDT (`ontology/tvb-o-units.ttl`) and can be reasoned about dimensionally. The range is deliberately open beyond it: a unit nobody has curated yet is recorded as written and reported `uncurated`, because a closed range forces the author to either misdeclare the quantity or leave it undeclared, and both lose more than an unrecognised string does. An uncurated unit carries no dimensional claim, so a check involving it reports `underdetermined` rather than guessing. Promote one with `tvbo units add <unit>`, which pulls its QUDT record into the vendored module — so every unit TVBO *reasons* about stays authoritative, and only what it *records* is open." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 9 ;
            sh:path qudt:unit ] ;
    sh:targetClass tvbo:FieldStateVariable .

tvbo:File a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:extension ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:path ] ;
    sh:targetClass tvbo:File .

tvbo:GraphGenerator a sh:NodeShape ;
    rdfs:comment """Backend-agnostic graph generator specification.  Captures the mathematical family and its parameter declarations so that each backend can emit the correct constructor call (Graphs.jl, NetworkX, etc.) via per-backend ``bindings``; derived generators may also carry a symbolic ``procedure``.  The number of nodes is always taken from Network.number_of_nodes.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether to generate a directed graph." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:directed ],
        [ sh:datatype xsd:integer ;
            sh:description "Random seed for reproducible graph generation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:seed ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:class tvbo:Procedure ;
            sh:description """Optional symbolic procedure for derived generators (e.g. null-model shuffles): ordered steps and named outputs, each carrying an Equation.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:procedure ],
        [ sh:datatype xsd:string ;
            sh:description """Optional graph family name.  Use a StandardGraphType value for automatic backend mapping, or any custom string for documentation purposes.  When absent, the backend ``bindings`` determine construction directly.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:type ],
        [ sh:class tvbo:Callable ;
            sh:description """Optional Python callable that builds the network at YAML load time. When set, ``Network._resolve`` imports ``<module>.<name>`` and invokes it with the ``parameters`` block as keyword arguments. The callable must return either a ``Network`` instance or a tuple ``(weights, lengths, node_params)``. Use the existing ``Callable`` slots (``name`` is the function name, ``module`` is its dotted module path). Reuses the same idiom as TVB monitor class references; no free ``module:function`` strings.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path tvbo:builder ],
        [ sh:class tvbo:Binding ;
            sh:description """Per-backend construction bindings, keyed by backend id (e.g. python, julia, networkx).  Each names the native library, callable and the ordered parameter names to pass.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:bindings ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Parameter ;
            sh:description """Generator parameters keyed by name (e.g. n, k, p, seed). A curated entry *declares* each parameter's interface via the general ``Parameter`` slots — ``datatype`` (its type), ``default`` (fallback when absent) and ``required`` — while a concrete experiment supplies the same key by ``value``. Builder (Callable) generators receive the resolved values as keyword arguments; declarative library generators pass them positionally via the per-backend ``bindings`` map. The number of nodes is always taken from Network.number_of_nodes.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path tvbo:parameters ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass tvbo:GraphGenerator .

tvbo:HeldParameter a sh:NodeShape ;
    rdfs:comment "A parameter a continuation holds to a target: the parameter, and the algorithm whose objective (a TuningObjective with target_variable and target_value) states the target it is held to." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Algorithm ;
            sh:description "The algorithm, by name, whose objective gives the target." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path tvbo:algorithm ],
        [ sh:datatype xsd:string ;
            sh:description "The parameter held, by name, a parameter of the continuation's dynamics." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:parameter ] ;
    sh:targetClass tvbo:HeldParameter .

tvbo:Inference a sh:NodeShape ;
    rdfs:comment "Bayesian inference of model parameters from an observation, via MCMC. A standalone, first-class concept (NOT an Optimization): it produces a POSTERIOR, not a point estimate, using priors + a likelihood + a sampler instead of a loss + optimizer. It runs the SAME differentiable forward model, wrapped in a probabilistic model (sample priors -> forward -> likelihood)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:class tvbo:ExecutionConfig ;
            sh:description "Per-inference execution config (overrides experiment defaults)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path tvbo:execution ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "nuts" ;
            sh:description "MCMC sampler ('nuts'). Each backend maps its own way." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:sampler ],
        [ sh:class tvbo:Integrator ;
            sh:description "Forward-model integration settings (overrides experiment defaults)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path tvbo:integration ],
        [ sh:class tvbo:Prior ;
            sh:description "Priors over the inferred parameters, keyed by each parameter's dotted name (e.g. \"Generic2dOscillator.eta\" or \"PulseInput.amplitude\"). The KEYS are the inferred parameters — there is no separate free-parameter list." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:priors ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1000 ;
            sh:description "Warmup/adaptation steps before sampling." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:num_warmup ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Independent MCMC chains." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:num_chains ],
        [ sh:datatype xsd:integer ;
            sh:description "PRNG seed for reproducible sampling." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:seed ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1000 ;
            sh:description "Posterior samples to draw." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:num_samples ],
        [ sh:class tvbo:Algorithm ;
            sh:description "Optional algorithm whose result state seeds the inference." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path tvbo:depends_on ],
        [ sh:class tvbo:Likelihood ;
            sh:description "Observation model p(data | sim(theta))." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path tvbo:likelihood ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ] ;
    sh:targetClass tvbo:Inference .

tvbo:Likelihood a sh:NodeShape ;
    rdfs:comment "Observation model for Bayesian inference: p(data | sim(theta)). Points at the observation holding the data and specifies the noise family + scale. `name` is the noise family (default Normal); `source` uses the same referencing as `Observation.source`, so the observed data can come from this experiment's integration, an empirical network measure, or a runtime-bound array — one flexible hook, no data-loading path of its own. `predicted` names the other side of the residual when it differs from the data's own observable." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Observation-noise scale of the likelihood. May deliberately differ from the data's generative noise — it sets how tightly the likelihood constrains the (possibly degenerate) parameter ridge." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:sigma ],
        [ sh:datatype xsd:string ;
            sh:description "Observation(s) providing the observed data, evaluated once at the declared configuration." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:source ],
        [ sh:datatype xsd:string ;
            sh:description "Observation(s) the model PREDICTS, recomputed for every proposed theta. Defaults to `source`, which is right whenever the data enters from outside — a runtime-bound array or an empirical measure — because then the same observable serves both sides. Name it separately when the recording is itself declared in the forward pipeline: measurement noise applied to both sides is the same deterministic draw twice, so it cancels in the residual and the inference silently fits noiseless data." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:predicted ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Normal" ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass tvbo:Likelihood .

tvbo:MeasureSpec a sh:NodeShape ;
    rdfs:comment "Metadata for one phenotype measure. Optional per-measure entry on ``Phenotype.measure_specs``." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Cognitive Atlas IRI of the cognitive construct measured (e.g. ``cogat:trm_521ef89ce5e84`` for fluid intelligence)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:concept_iri ],
        [ sh:datatype xsd:string ;
            sh:description "Cognitive Atlas (``cogat:``) IRI of the assessment instrument / task that produced this measure (e.g. ``cogat:trm_4a3fd79d09cba`` for PMAT24)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:task_iri ],
        [ sh:datatype xsd:string ;
            sh:description "Must match the measure name in ``Phenotype.measures``." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:description ],
        [ sh:datatype xsd:string ;
            sh:description "Unit annotation (e.g. 'count', 'ms', 'z-score')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:unit ],
        [ sh:datatype xsd:string ;
            sh:description "Sub-type within the phenotype (e.g. 'raw', 'unadjusted', 'age-corrected', 'derived', 'RT', 'accuracy')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:measure_type ] ;
    sh:targetClass tvbo:MeasureSpec .

tvbo:NDArray a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:shape ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:dataLocation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:unit ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:dtype ] ;
    sh:targetClass tvbo:NDArray .

tvbo:Node a sh:NodeShape ;
    rdfs:comment "A node in a network with its own dynamics and properties" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            sh:description "Spatial coordinates (x, y, z) of the node" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:position ],
        [ sh:datatype xsd:string ;
            sh:description "Brain region or anatomical label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:region ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique node identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:identifier ],
        [ sh:description "The hemisphere this node lies in, the SANDS `Hemisphere` value `left` or `right`. Absent for a midline node or one whose side is not curated. A consumer that needs sides fails on an absent value rather than inferring one from the label." ;
            sh:in ( "left" "right" "both" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path tvbo:hemisphere ],
        [ sh:class tvbo:StateValue ;
            sh:description "Per-node initial state variable values, keyed by state variable name." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path tvbo:state ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether to include this element in simulation output files. Applicable to state variables (default true), derived variables (default false), and network nodes (default true). On an observation it forces (true) or suppresses (false) persistence in the result; left unset, a terminal observation (one not consumed by another observation or a loss) is recorded and an intermediate one is not. Set false to suppress recording." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:record ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:parameters ],
        [ sh:class tvbo:Network ;
            sh:description "Optional finer-scale Network that \"lives inside\" this Node (network-of-networks / multi-scale primitive). The subnetwork's nodes map (one-to-many) to this single parent Node. Cross-scale signal flow is declared as ordinary Edges in the subnetwork's `edges` list, using `source_network` / `target_network` with the `parent` sentinel to traverse up the hierarchy. The subnetwork may carry its own `graph_generator` (discrete sub-network — reservoir, spiking population, jaxley compartments) and/or `mesh` (continuous surface field) — one unified slot for reservoirs-per-region, spiking-populations-per-region, cells-per-region, and surface-mesh-patches-per-region. Recursive: a subnetwork's Nodes can themselves carry subnetworks." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path tvbo:subnetwork ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Number of identical cells this node represents as a population. The default (1) is a single unit; size>1 makes the node a population of N cells sharing this node's dynamics, addressed by index 0..N-1 when a connectivity rule on an incident Edge is expanded. Maps to a NeuroML <population size=\"N\">. Backend-independent: it states the population's cardinality, not a storage layout." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:size ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Dynamics ;
            sh:description "Dynamics model governing this node's behavior. Can be a reference (by name) or inline definition. If not provided, uses experiment's dynamics." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:dynamics ],
        [ sh:datatype xsd:string ;
            sh:description "Enter any alternate names, including abbreviations, for this entity." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/atlas/hasName> ],
        [ sh:class tvbo:Event ;
            sh:description "Events attached to this node (e.g., threshold-based state changes)." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path tvbo:events ],
        [ sh:datatype xsd:string ;
            sh:description "Label of this node's counterpart in the other hemisphere, so that a mirrored drive or readout is a declared permutation rather than a positional guess. Absent when the node has no homologue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:homologue ] ;
    sh:targetClass tvbo:Node .

tvbo:NodeSelection a sh:NodeShape ;
    rdfs:comment """The nodes of a network to keep or to drop, by label; exactly one of ``keep`` and ``drop`` is stated. A label is matched as written or through the aliases a ``by_label`` reconciliation uses (a node's ``alternateName`` and the atlas terminology). A selection is a set: the kept nodes stay in the order the network carries them, whatever order ``keep`` lists them in, and are renumbered from 0.
The selection is applied when the network is resolved, after its source has delivered nodes and arrays and before anything else reads them. Every stored layer, edge-parameter matrix and per-node array (``nodes/<name>``) is restricted to the kept nodes, an edge listed between two nodes goes with either of its nodes, and ``number_of_nodes`` is the kept count. Transforms, delays and couplings therefore see the selected network only: a normalisation by the largest weight is taken over the kept pairs. A layer or argument read through ``used:`` is read for the selected nodes: with ``reconcile: by_label`` it is aligned to them by name, without it the array has to come in the selected node count. A layer a ``producer:`` builds is not cut and has to come in the selected node count, and a per-node parameter read by ``source`` and ``measure`` from a network with more nodes is aligned to the kept nodes by label.
A warning names the network and both counts whenever a selection drops nodes from what the network carries; read back beside arrays that are already the selected ones, it drops none and gives none.
Refused, naming what is wrong: a label the network does not carry, ``keep`` beside ``drop``, a label listed twice, a selection that leaves no node, a node declared by label that the selection drops, and a network that carries a mesh or a route to another network, whose arrays the selection cannot restrict.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Labels of the nodes that stay; every other node is dropped." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:keep ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the nodes listed beside this record are the selected ones. Set by tvbo when it applies the selection, so a resolved network that is saved, frozen into a kit or dumped keeps the selection as the record of how it was derived. Read back beside arrays that are already the selected ones (a save, a kit) it selects nothing again; beside a source that still delivers the dropped nodes (a dumped record naming the unselected companion, a curated network or an atlas) it is applied again by label, and the nodes it keeps have to be the ones the record lists, or the record is refused as written from a source that has changed since. A generated graph is generated at the record's count, which is the kept one, so a dumped selection of one is refused; ``save`` writes its arrays. A recipe leaves it unset; one that sets it beside a node list the selection would still cut is refused." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:applied ],
        [ sh:datatype xsd:string ;
            sh:description "Labels of the nodes that are dropped; every other node stays." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:drop ] ;
    sh:targetClass tvbo:NodeSelection .

tvbo:NodeTemplate a sh:NodeShape ;
    rdfs:comment "The node slots a network's `node_template` sets on every node it does not set them on itself: what a node is and how it runs, and nothing that says which node it is. It shares these slots with `Node` and lacks the per-node slots `id`, `label`, `position` and `region`, which the network's data gives each node; a template that sets one is refused, naming it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Number of identical cells this node represents as a population. The default (1) is a single unit; size>1 makes the node a population of N cells sharing this node's dynamics, addressed by index 0..N-1 when a connectivity rule on an incident Edge is expanded. Maps to a NeuroML <population size=\"N\">. Backend-independent: it states the population's cardinality, not a storage layout." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:size ],
        [ sh:description "The hemisphere this node lies in, the SANDS `Hemisphere` value `left` or `right`. Absent for a midline node or one whose side is not curated. A consumer that needs sides fails on an absent value rather than inferring one from the label." ;
            sh:in ( "left" "right" "both" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path tvbo:hemisphere ],
        [ sh:datatype xsd:string ;
            sh:description "Label of this node's counterpart in the other hemisphere, so that a mirrored drive or readout is a declared permutation rather than a positional guess. Absent when the node has no homologue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:homologue ],
        [ sh:class tvbo:Event ;
            sh:description "Events attached to this node (e.g., threshold-based state changes)." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path tvbo:events ],
        [ sh:datatype xsd:string ;
            sh:description "Enter any alternate names, including abbreviations, for this entity." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/atlas/hasName> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Dynamics ;
            sh:description "Dynamics model governing this node's behavior. Can be a reference (by name) or inline definition. If not provided, uses experiment's dynamics." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path tvbo:dynamics ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:parameters ],
        [ sh:class tvbo:Network ;
            sh:description "Optional finer-scale Network that \"lives inside\" this Node (network-of-networks / multi-scale primitive). The subnetwork's nodes map (one-to-many) to this single parent Node. Cross-scale signal flow is declared as ordinary Edges in the subnetwork's `edges` list, using `source_network` / `target_network` with the `parent` sentinel to traverse up the hierarchy. The subnetwork may carry its own `graph_generator` (discrete sub-network — reservoir, spiking population, jaxley compartments) and/or `mesh` (continuous surface field) — one unified slot for reservoirs-per-region, spiking-populations-per-region, cells-per-region, and surface-mesh-patches-per-region. Recursive: a subnetwork's Nodes can themselves carry subnetworks." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path tvbo:subnetwork ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether to include this element in simulation output files. Applicable to state variables (default true), derived variables (default false), and network nodes (default true). On an observation it forces (true) or suppresses (false) persistence in the result; left unset, a terminal observation (one not consumed by another observation or a loss) is recorded and an intermediate one is not. Set false to suppress recording." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:record ],
        [ sh:class tvbo:StateValue ;
            sh:description "Per-node initial state variable values, keyed by state variable name." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path tvbo:state ] ;
    sh:targetClass tvbo:NodeTemplate .

tvbo:Optimization a sh:NodeShape ;
    rdfs:comment "Configuration for parameter optimization. Inherits single-stage fields from OptimizationStage. For multi-stage workflows, use 'stages' (ignores inherited single-stage fields). Loss equation references observations directly by name." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path rdfs:label ],
        [ sh:description "Upstream task whose result seeds this optimization. An `Algorithm` supplies a single tuned state (start from it). An `Exploration` with an adaptive `strategy` (e.g. nsga2) supplies a *front* of N non-dominated solutions: the optimization then runs batched-parallel — one gradient refinement per Pareto seed — reusing `parallel_mode`/`n_parallel`. If absent, optimization starts from the initial simulation state. Forward-compatible with the unified `Search.depends_on`." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:class tvbo:Algorithm ] [ sh:class tvbo:Exploration ] ) ;
            sh:order 4 ;
            sh:path tvbo:depends_on ],
        [ sh:class tvbo:OptimizationStage ;
            sh:description "Ordered list of optimization stages. Stages run sequentially. Stage n+1 starts from optimized values of stage n. When defined, inherited single-stage fields are ignored." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:stages ],
        [ sh:class tvbo:Parameter ;
            sh:description "Stage-specific hyperparameters (e.g., b2=0.9999 for adam)" ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path tvbo:hyperparameters ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:name ],
        [ sh:class tvbo:FunctionCall ;
            sh:description "Loss function call. Uses FunctionCall to either: 1. Reference existing function: function: rmse 2. Inline callable: callable: {module: ..., name: ...} Arguments specify inputs (simulated_fc, empirical_fc, etc.)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:loss ],
        [ sh:class tvbo:ExecutionConfig ;
            sh:description "Per-optimization execution configuration (overrides experiment-level defaults). Useful for setting random_seed, precision, or hardware for optimization phase." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path tvbo:execution ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "adam" ;
            sh:description "Optimizer for this stage: 'adam', 'adamw', 'sgd', etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:algorithm ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.001"^^xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:learning_rate ],
        [ sh:class tvbo:Parameter ;
            sh:description "Parameters from previous stages to freeze (keep at optimized value but not update)" ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path tvbo:freeze_parameters ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:FreeParameter ;
            sh:description "Parameters to optimize in this stage. Each entry is a FreeParameter that references an existing Parameter by dotted scope (e.g. \"ReducedWongWang.w\" or \"FastLinearCoupling.G\") and supplies optimization-specific metadata (heterogeneous, shape, bounds). No new Parameter is created here." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:free_parameters ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 100 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:max_iterations ],
        [ sh:class tvbo:OptimizationStage ;
            sh:description "Previous stage to initialize from. Final values from that stage become initial values for this stage." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path tvbo:warmup_from ],
        [ sh:class tvbo:Integrator ;
            sh:description "Integration settings for optimization simulations (overrides experiment defaults). If specified, creates a fresh model_fn and state with prepare() before optimization. Can specify different duration, step_size, method than the experiment. If not specified, uses experiment-level integration settings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path tvbo:integration ] ;
    sh:targetClass tvbo:Optimization .

tvbo:PDE a sh:NodeShape ;
    rdfs:comment "Partial differential equation problem definition." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:FieldStateVariable ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path tvbo:state_variables ],
        [ sh:class tvbo:DerivedVariable ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path tvbo:derived_variables ],
        [ sh:class tvbo:Equation ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path tvbo:sources ],
        [ sh:class tvbo:BoundaryCondition ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:boundary_conditions ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:parameters ],
        [ sh:class tvbo:PDESolver ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path tvbo:solver ],
        [ sh:class tvbo:DerivedParameter ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path tvbo:derived_parameters ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class tvbo:Function ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path tvbo:functions ],
        [ sh:class tvbo:SpatialDomain ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:domain ],
        [ sh:class tvbo:DifferentialOperator ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:operators ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Mesh ;
            sh:description "Shared mesh for all field state variables in this PDE." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:mesh ] ;
    sh:targetClass tvbo:PDE .

tvbo:PDESolver a sh:NodeShape ;
    rdfs:comment "Numerical solver for a PDE: the time-integration algorithm, tolerances and step inherited from `Solver`, plus the spatial discretization and preconditioner a PDE additionally needs." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:in ( "FDM" "FEM" "FVM" "Spectral" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path tvbo:discretization ],
        [ sh:datatype xsd:string ;
            sh:description "Time-integration algorithm, e.g. implicit Euler or Crank-Nicolson." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:method ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareRequirement> ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:requirements ],
        [ sh:datatype xsd:float ;
            sh:description "Fixed time step of the solver. Unset for an adaptive solver, which chooses its own step from `abs_tol` / `rel_tol`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:step_size ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1e-10"^^xsd:float ;
            sh:description "Absolute tolerance for adaptive solvers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:abs_tol ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:preconditioner ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareEnvironment> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:environment ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1e-10"^^xsd:float ;
            sh:description "Relative tolerance for adaptive solvers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:rel_tol ] ;
    sh:targetClass tvbo:PDESolver .

tvbo:Panel a sh:NodeShape ;
    rdfs:comment "One cell of the figure. kind selects grammar (cartesian/heatmap) vs escape-hatch (image/custom); every kind shares the label, placeholder, legend and annotation machinery. Reuses label (human title)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Inset ;
            sh:description "What every cell of a `grid` is: the kind they all draw, and the opts they share. Each entry in `layers:` then fills one cell with this template, which is why a grid of twenty surfaces needs the surface declared once. Its `bounds` stay unset — the grid positions its cells." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:cell ],
        [ sh:description "The DATA aspect ratio: `equal` — one unit of x is one unit of y, what a matrix or a spatial map needs — or `auto` to fill the cell, or a number. `box_aspect` shapes the frame instead." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 43 ;
            sh:path tvbo:aspect ],
        [ sh:description "A key for this panel's own marks. `legend: true` draws it wherever the backend finds room, `legend: upper right` fixes the corner, and the object form states the rest — frame, columns, title. All three are one slot, so a panel that starts with a corner and later needs two columns keeps the word it had. Distinct from `kind: legend`, a standalone legend PANEL that occupies a cell of its own." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:class tvbo:Legend ] [ sh:datatype xsd:boolean ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 49 ;
            sh:path tvbo:legend ],
        [ sh:datatype xsd:string ;
            sh:description "Name of a registered custom-panel callable fn(container, ax, **opts) (custom kind)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:render ],
        [ sh:datatype xsd:float ;
            sh:description "The x tick positions, stated outright. Unset lets the locator choose them." ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path tvbo:xticks ],
        [ sh:datatype xsd:integer ;
            sh:description "Cells of blank left along the diagonal between two `triangle` layers, so the two halves of a split matrix read as two quantities rather than one image." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 56 ;
            sh:path tvbo:triangle_gap ],
        [ sh:datatype xsd:float ;
            sh:description "The y range, `[min, max]`. See `xlim`." ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path tvbo:ylim ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the x axis descending." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 45 ;
            sh:path tvbo:invert_x ],
        [ sh:class tvbo:Inset ;
            sh:description "Sub-axes drawn inside this panel after its own body — the zoom windows, corner thumbnails and small key maps papers place over a plot. Declaring them keeps a panel that needs one from becoming a custom callable, which would take its whole interior out of the grammar." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 61 ;
            sh:path tvbo:insets ],
        [ sh:datatype xsd:float ;
            sh:description "Rotate the y tick labels, in degrees counter-clockwise." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path tvbo:ytick_rotation ],
        [ sh:class tvbo:Region ;
            sh:description "Rectangles ringing the windows this panel calls out — the parameter band a regime lives in, the interval a statistic was taken over." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 58 ;
            sh:path tvbo:regions ],
        [ sh:datatype xsd:string ;
            sh:description "For an `image` panel, the producing artifact its committed `path` is rendered FROM: a committed HTML/SVG file, a producing script, or a URL. `path` stays the placed output; `source` is what regenerates it deterministically, so a schematic or a live-platform view is provenance-tracked rather than an opaque binary pasted into the repo. Rendered through `capture:` when it is HTML/a URL; run as a script otherwise." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:integer ;
            sh:description "Upper bound on the number of ticks per axis. The lever to reach for when a dense mosaic runs its numbers together." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:nbins ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the panel keeps its frame and its ticks. `false` strips both, for a panel with no measurable axis: an image, a schematic, a connectivity matrix shown as a picture. Unset keeps them." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 48 ;
            sh:path tvbo:frame ],
        [ sh:class tvbo:Annotation ;
            sh:description "Positioned text labels drawn on the panel (e.g. 'K≈272') — a declarative alternative to a custom callable." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 60 ;
            sh:path tvbo:annotations ],
        [ sh:description "Which edge the y axis LABEL sits on. See `xlabel_side`." ;
            sh:in ( "left" "right" "top" "bottom" ) ;
            sh:maxCount 1 ;
            sh:order 37 ;
            sh:path tvbo:ylabel_side ],
        [ sh:datatype xsd:float ;
            sh:description "The frame's height over its width, independent of the data ranges: a square panel over data that is not square. `aspect` constrains the data instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 44 ;
            sh:path tvbo:box_aspect ],
        [ sh:description "Drop the first, last, or both end ticks, for the case where a corner tick collides with its neighbour panel's." ;
            sh:in ( "lower" "upper" "both" ) ;
            sh:maxCount 1 ;
            sh:order 17 ;
            sh:path tvbo:tick_prune ],
        [ sh:class tvbo:Grid ;
            sh:description "How a `kind: grid` panel tiles its cells. Ignored by every other kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 54 ;
            sh:path tvbo:grid ],
        [ sh:description "Which edge the y ticks sit on." ;
            sh:in ( "left" "right" "top" "bottom" ) ;
            sh:maxCount 1 ;
            sh:order 28 ;
            sh:path tvbo:ytick_side ],
        [ sh:datatype xsd:string ;
            sh:description "The authored interpretive clause for this panel — the one part of its caption a human writes. The caption composer merges it with the structural descriptor it derives from the panel's layers (axis quantities/units, model/experiment, transform), so the sentence a reader sees is authored intent over computed fact and cannot drift when panels move or layers change." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:float ;
            sh:description "The depth range of a 3-D panel, `[min, max]`. Ignored by every flat kind." ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path tvbo:zlim ],
        [ sh:class tvbo:Inset ;
            sh:description "A `grid`'s cells stated one at a time, for a grid whose cells differ — a first cell showing the bare mesh the rest are maps on, or a row pairing two kinds. Each is merged over `cell:`, and carries its own layers. Mutually exclusive with `layers:`, which is the compact form of the same thing." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:cells ],
        [ sh:datatype xsd:float ;
            sh:description "Gap in points between the x axis label and its tick numbers, for where the default lets the two touch. Unset takes the theme's `label_pad`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path tvbo:xlabel_pad ],
        [ sh:datatype xsd:string ;
            sh:description "The x axis label, as the figure prints it — unit included, LaTeX included. Unset leaves the renderer's own, which is the encoded field's bare name: right for a working figure, wrong for a printed one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path tvbo:xlabel ],
        [ sh:class tvbo:Graph ;
            sh:description "Graph and colour scale of a `kind: network` panel. Ignored by every other kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 53 ;
            sh:path tvbo:network ],
        [ sh:description "How y tick numbers are written." ;
            sh:in ( "sci" "plain" ) ;
            sh:maxCount 1 ;
            sh:order 26 ;
            sh:path tvbo:ytick_format ],
        [ sh:datatype xsd:float ;
            sh:description "The y tick positions, stated outright." ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path tvbo:yticks ],
        [ sh:datatype xsd:string ;
            sh:description "Mosaic label this panel binds to (matches a letter in Figure.layout)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:panel_key ],
        [ sh:class tvbo:Layer ;
            sh:description "Marks sharing this panel's axes (overlay). Grammar kinds only." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path tvbo:layers ],
        [ sh:in ( "cartesian" "heatmap" "line3d" "surface" "volume" "grid" "colorbar" "legend" "network" "image" "custom" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path tvbo:kind ],
        [ sh:datatype xsd:string ;
            sh:description "Honest-placeholder text drawn when this panel's data is missing or degenerate (never a source-replot). Setting it wraps the draw so a missing container falls back to this label instead of erroring." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:placeholder ],
        [ sh:datatype xsd:float ;
            sh:description "Gap in points between the y axis label and its tick numbers. See `xlabel_pad`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path tvbo:ylabel_pad ],
        [ sh:description "Which edge the x axis LABEL sits on. The tick numbers stay where `xtick_side` puts them, so a label can cross to the far side of a panel whose ticks do not follow it." ;
            sh:in ( "left" "right" "top" "bottom" ) ;
            sh:maxCount 1 ;
            sh:order 36 ;
            sh:path tvbo:xlabel_side ],
        [ sh:class tvbo:Colorbar ;
            sh:description "The colour scale printed beside this panel's field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 50 ;
            sh:path tvbo:colorbar ],
        [ sh:description "Per-panel override of the figure's panel_number_loc — e.g. wide top panels upper-right, grid panels upper-left." ;
            sh:in ( "upper left" "upper right" "lower left" "lower right" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path tvbo:number_loc ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the y ticks without their numbers. Same rule as `hide_xticklabels`, with `share_y`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path tvbo:hide_yticklabels ],
        [ sh:datatype xsd:float ;
            sh:description "The x range, `[min, max]`. Declared rather than inferred, because two panels a figure asks the reader to compare must not end up on whatever ranges their own data happened to reach." ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path tvbo:xlim ],
        [ sh:description "Which edge the x ticks sit on." ;
            sh:in ( "left" "right" "top" "bottom" ) ;
            sh:maxCount 1 ;
            sh:order 27 ;
            sh:path tvbo:xtick_side ],
        [ sh:class tvbo:Rule ;
            sh:description "Straight reference lines drawn across the panel: a zero, a threshold, the identity line of a target-versus-simulated plot. Each carries its own colour and dash, so a rule and the way it is drawn cannot be stated apart." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 57 ;
            sh:path tvbo:rules ],
        [ sh:class tvbo:Surface ;
            sh:description "Geometry and colour scale of a `kind: surface` panel. Ignored by every other kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 51 ;
            sh:path tvbo:surface ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the depth axis of a 3-D panel descending." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 47 ;
            sh:path tvbo:invert_z ],
        [ sh:datatype xsd:string ;
            sh:description "External image file (image kind)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:path ],
        [ sh:datatype xsd:float ;
            sh:description "Length of this panel's tick marks in points, overriding the theme's." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:tick_length ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the y axis descending — the matrix convention, row 0 at the top." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 46 ;
            sh:path tvbo:invert_y ],
        [ sh:class tvbo:Argument ;
            sh:description "The keyword options of a `custom` callable, and of the kinds that carry their own option family — a `surface`/`volume`/`network` panel's geometry, a colorbar's. No part of how an axis is DRAWN belongs here: the labels, limits, scales, shape and legend are slots on the panel itself, the tick family sits beside them, and `rules`, `regions` and `camera` carry the marks that travel with a colour. The renderer refuses a retired name here rather than passing it into the emitted script, and names the slot that replaced it." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path tvbo:opts ],
        [ sh:datatype xsd:string ;
            sh:description "A heading above the panel, in the panel's own words. A panel LETTER is not a title — that is `number`, which the layout places and sizes to the journal's convention." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path tvbo:title ],
        [ sh:datatype xsd:float ;
            sh:description "Rotate the x tick labels, in degrees counter-clockwise. Worth reaching for when a dense row would otherwise run its numbers together: a slanted label is anchored at its tick rather than centred under it, so it costs width it would otherwise steal from its neighbour." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path tvbo:xtick_rotation ],
        [ sh:class tvbo:Volume ;
            sh:description "Geometry and colour scale of a `kind: volume` panel. Ignored by every other kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 52 ;
            sh:path tvbo:volume ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the x ticks without their numbers. Declare `share_x` on the figure alongside it: hiding the numbers alone asserts a shared scale the axes may not have, and a reader then compares two panels drawn at different ranges." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path tvbo:hide_xticklabels ],
        [ sh:description "How the y axis maps values to distance." ;
            sh:in ( "linear" "log" "symlog" "logit" ) ;
            sh:maxCount 1 ;
            sh:order 42 ;
            sh:path tvbo:yscale ],
        [ sh:datatype xsd:string ;
            sh:description "The panel letter to draw, overriding the mosaic key, or the string 'false' to draw none. Needed whenever the paper's panels do not map one-to-one onto mosaic cells: a row of five mode surfaces under a single (a), or a schematic cell that carries no letter of its own. Without it a grouped figure numbers every cell and its letters stop matching the paper's." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:number ],
        [ sh:datatype xsd:float ;
            sh:description "Gap in points between the z axis label and its tick numbers. See `xlabel_pad`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path tvbo:zlabel_pad ],
        [ sh:datatype xsd:string ;
            sh:description "The depth axis label of a 3-D panel. Ignored by every flat kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path tvbo:zlabel ],
        [ sh:description "How the x axis maps values to distance." ;
            sh:in ( "linear" "log" "symlog" "logit" ) ;
            sh:maxCount 1 ;
            sh:order 41 ;
            sh:path tvbo:xscale ],
        [ sh:description "How x tick numbers are written: `sci` forces scientific notation, `plain` forbids it." ;
            sh:in ( "sci" "plain" ) ;
            sh:maxCount 1 ;
            sh:order 25 ;
            sh:path tvbo:xtick_format ],
        [ sh:class tvbo:RenderSpec ;
            sh:description "How to turn an `image` panel's HTML/URL `source` into its `path`: the headless-browser recipe (viewport, scale, wait, clip). The declarative form of code/capture-screenshots.py, so a screenshot regenerates from the spec instead of being hand-captured. Ignored when `source` is a static file or a script." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:capture ],
        [ sh:class tvbo:Camera ;
            sh:description "Viewpoint for a 3-D panel or a surface. Ignored by every flat kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 59 ;
            sh:path tvbo:camera ],
        [ sh:datatype xsd:boolean ;
            sh:description "Keep the position the layout engine gave this panel, rather than letting a later pass move it. For a panel whose position carries meaning — aligned with the one above it, or sized to match a sibling." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 55 ;
            sh:path tvbo:fill_cell ],
        [ sh:datatype xsd:float ;
            sh:description "Tick-label size in points, overriding the figure's `font_size` for this panel's ticks alone." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:tick_size ],
        [ sh:datatype xsd:string ;
            sh:description "The y axis label. See `xlabel`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path tvbo:ylabel ] ;
    sh:targetClass tvbo:Panel .

tvbo:Partition a sh:NodeShape ;
    rdfs:comment "A grouped streaming reduction over a node partition (e.g. per-hemisphere cortical wave metrics): the per-timestep observer body is evaluated ONCE for a single group and vmapped over the partition axis, and the per-group outputs are folded to per-group scalar metrics. General in its group-vmap (``gather`` + ``over``); the metric roles (``waves`` / ``directed`` / ``correlation``) name the per-group derived variables the wave finalize reduces to proportion-of-waves, proportion-directed and the median flow–instrength correlation (rho)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:PropagationGate ;
            sh:description "Requires a group's waves to travel before they are counted. Absent, every wave-present timestep counts. See PropagationGate." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:propagation ],
        [ sh:datatype xsd:string ;
            sh:description "Per-group float derived variable whose masked median over wave-present timesteps is the reported rho." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:correlation ],
        [ sh:datatype xsd:string ;
            sh:description "Per-group boolean derived variable: the flow is significantly directed this timestep (proportion_directed = directed-and-wave timesteps / wave timesteps)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:directed ],
        [ sh:datatype xsd:string ;
            sh:description "Observer parameter ``(n_groups, n)`` of node indices selecting each group's nodes out of the whole-source signal; its leading axis is the group count." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:gather ],
        [ sh:datatype xsd:string ;
            sh:description "Operator parameters carrying a leading group axis, sliced per group under the vmap (the per-group meshes' fixed operators). Parameters not listed are shared." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:over ],
        [ sh:datatype xsd:string ;
            sh:description "Per-group boolean derived variable: a wave is present this timestep." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:waves ] ;
    sh:targetClass tvbo:Partition .

tvbo:Prior a sh:NodeShape ;
    rdfs:comment "Prior belief over one inferred parameter. In `Inference.priors` the collection KEY is the parameter's dotted name; the value wraps a `Distribution` as the belief (reusing the standard distribution vocabulary rather than inventing a new one). Distinct from `Parameter.distribution`, which specifies per-node SAMPLING, not a prior." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Distribution ;
            sh:description "The prior distribution: e.g. {name: Normal, parameters: {mean, std}} or {name: Uniform, domain: {lo, hi}}." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:distribution ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass tvbo:Prior .

tvbo:Procedure a sh:NodeShape ;
    rdfs:comment "Symbolic procedure: an ordered list of steps producing named outputs.  Documents a derived generator's algorithm independently of any backend binding." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:ProcedureStep ;
            sh:description "Ordered intermediate steps, keyed by name — the same keyed-collection form as ``output``, so a step's name is its key rather than a field repeated inside it. Order is the evaluation order: a step may only reference names defined before it." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path tvbo:steps ],
        [ sh:class tvbo:ProcedureStep ;
            sh:description "Named outputs (keyed by name), e.g. 'weights'." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path tvbo:output ] ;
    sh:targetClass tvbo:Procedure .

tvbo:PropagationGate a sh:NodeShape ;
    rdfs:comment "A propagation requirement on a grouped wave reduction. A per-timestep wave test cannot tell a standing field from a travelling one, since a standing field repeats the same spatial pattern every timestep. The reduction sums the per-element unit direction vector over the post-transient timesteps and computes each group's direction dispersion, the ``mask``-weighted mean over elements of 1 - |time-mean direction|: 0 for a direction field fixed in time, growing as the direction moves. A group whose dispersion falls below ``min_dispersion`` has no travelling waves, so its proportion of waves is 0 and its proportion-directed and rho are undefined (NaN)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Smallest direction dispersion at which a group's waves count as travelling." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:min_dispersion ],
        [ sh:datatype xsd:string ;
            sh:description "Per-group derived variables that are the components of the per-element unit direction vector (for example the normalised phase gradient on each mesh face), one per spatial component, each of shape ``(n_elements,)``." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:direction ],
        [ sh:datatype xsd:string ;
            sh:description "Observer parameter ``(n_groups, n_elements)`` weighting each element's contribution to its group's dispersion mean (1 for a real element, 0 for padding)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:mask ] ;
    sh:targetClass tvbo:PropagationGate .

tvbo:RandomStream a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Add the location of the data file containing the parcellation terminology." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass tvbo:RandomStream .

tvbo:Reference a sh:NodeShape ;
    rdfs:comment "A small typed pointer to another TVBO entity (Network, Mesh, Observation, …). The ``iri`` identifies the target via the registry; the optional ``field`` is a dotted-path subkey resolved by attribute walk on the loaded target (e.g. ``field: 'weight_alpha'`` picks the ``weight_alpha`` named edge matrix on a Network; ``field: 'mesh.faces'`` picks the mesh face array). Used uniformly anywhere a TVBO entity needs to point at a sub-array of another entity without inlining the data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Optional dotted-path subkey into the referenced entity (e.g. ``weight_alpha`` for a Network's named edge matrix, ``mesh.faces`` for the face array, or ``nodes.ef_alpha`` for a per-node scalar field). Resolved by attribute walk at load time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:field ],
        [ sh:description "CURIE or full IRI of the referenced TVBO entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path tvbo:iri ] ;
    sh:targetClass tvbo:Reference .

tvbo:ReferenceFingerprint a sh:NodeShape ;
    rdfs:comment "Cache-invalidation fingerprint for one ``aux_data`` reference. Captures enough about the upstream artifact that a downstream cache can decide cheaply (via mtime + size) whether to trust the cached result, falling back to a hash recompute on mismatch." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "File size in bytes at fingerprinting." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:size ],
        [ sh:description "IRI of the referenced artifact (Network, ExperimentResult, BehavioralData, ...)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path tvbo:iri ],
        [ sh:datatype xsd:float ;
            sh:description "File modification time at fingerprinting (POSIX timestamp)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:mtime ],
        [ sh:datatype xsd:string ;
            sh:description "Dotted-path subkey within the referenced entity (optional)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:field ],
        [ sh:datatype xsd:string ;
            sh:description "SHA-256 hex digest of the file at fingerprinting (recomputed lazily when mtime/size differ)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:hash ] ;
    sh:targetClass tvbo:ReferenceFingerprint .

tvbo:RenderSpec a sh:NodeShape ;
    rdfs:comment "A headless-browser capture recipe turning an `image` panel's HTML/URL `source` into the static file placed at its `path`. Mirrors one shot of code/capture-screenshots.py so a screenshot of the live platform (or any HTML render) is reproducible from the spec, not hand-captured. Only the `source` needs committing alongside the rendered `path`." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Extra settle time in seconds after load / wait_selector, for late layout or animation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:warmup ],
        [ sh:datatype xsd:string ;
            sh:description "Capture output format (png/pdf/svg); unset defers to the panel path's extension." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:format ],
        [ sh:datatype xsd:integer ;
            sh:description "Viewport width in CSS pixels." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:width ],
        [ sh:datatype xsd:float ;
            sh:description "Device pixel ratio; 2-3 renders a crisp raster at print resolution (the browser analogue of dpi)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:device_scale_factor ],
        [ sh:datatype xsd:integer ;
            sh:description "Viewport height in CSS pixels. Unset lets the page's own content height decide (full-page capture)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:height ],
        [ sh:datatype xsd:float ;
            sh:description "[x, y, width, height] in CSS pixels to crop the capture to a region of the page; unset captures the whole viewport." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:clip ],
        [ sh:datatype xsd:string ;
            sh:description "CSS selector to wait for before capturing, so the shot is taken only once the content that matters has rendered." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:wait_selector ] ;
    sh:targetClass tvbo:RenderSpec .

tvbo:ResultBinding a sh:NodeShape ;
    rdfs:comment "One entry in a study's results manifest: a manuscript key bound to the value it stands for. Exactly one of three forms: COMPUTED FROM A RUN — ``used:`` a DataRef reading a scalar out of a nested study's or this study's own analysis/experiment, formatted through ``format`` — COMPUTED FROM THE SPEC — ``count:`` a structural tally of a collection (e.g. the figures a nested study regenerates), needing no run — or AUTHORED — a literal ``value`` quoted from prior work and attributed by ``source``. So a number printed in prose is computed or an authored constant marked as such, never transcribed by hand." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Citation key attributing an authored ``value`` to its origin, so the manifest records which numbers are external constants and which the run computed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:source ],
        [ sh:datatype xsd:string ;
            sh:description "A literal value, for a constant quoted from prior work rather than computed here. Mutually exclusive with ``used:``; pair with ``source``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:value ],
        [ sh:datatype xsd:string ;
            sh:description "A structural tally computed from the specification, not a run: ``<study>.<collection>`` counts a collection on a nested study named by its citekey or label (e.g. ``Jansen1995.figures``), resolved at any depth, or a bare ``<collection>`` counts one on the study holding the binding (e.g. ``studies``). Mutually exclusive with ``used`` and ``value``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:count ],
        [ sh:datatype xsd:string ;
            sh:description "Python format string applied to the referenced value, e.g. '{:.2f}' or '{:d}'. Applies to a ``used:`` binding." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:format ],
        [ sh:class prov:Entity ;
            sh:description "Bind the key to a computed scalar in a result container (same reference form a figure Layer uses, and the same PROV edge). Mutually exclusive with ``value`` and ``count``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "The manuscript token this number is cited by (e.g. ``n_errors_found``), addressed in prose as ``{{< meta results.<key> >}}``. Unique within the manifest." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:key ] ;
    sh:targetClass tvbo:ResultBinding .

tvbo:Sample a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:size ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:groups ] ;
    sh:targetClass tvbo:Sample .

tvbo:SchedulerDirective a sh:NodeShape ;
    rdfs:comment "One engine-native scheduler directive passed through verbatim by the engine's emitter (e.g. a Slurm ``#SBATCH --<name>=<value>`` line). The open extension point of WorkflowEngineConfig: it carries any directive the typed fields do not name, so a new scheduler flag needs no schema change." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Directive name without its flag prefix (e.g. 'qos', 'constraint')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Directive value (e.g. 'normal')." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:value ] ;
    sh:targetClass tvbo:SchedulerDirective .

tvbo:Significance a sh:NodeShape ;
    rdfs:comment "How significant a printed statistic is, as the asterisks a paper sets after it. The p-value is read from a result container and compared with every threshold in `levels`; the label gains one asterisk per threshold the p-value is below, and none when it reaches the largest." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class prov:Entity ;
            sh:description "The p-value, a scalar in a result container (same reference form a Layer uses, and the same PROV edge)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path prov:used ],
        [ sh:datatype xsd:float ;
            sh:description "The thresholds, each strictly between 0 and 1, one asterisk apiece. Defaults to 0.05, 0.01 and 0.001, so p < 0.001 prints three." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:levels ] ;
    sh:targetClass tvbo:Significance .

tvbo:SimulationStudy a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/tvbo/study/Dataset> ;
            sh:description "The datasets this study reads per-subject files from, each with the cohorts defined over it (``Dataset.cohorts``). Declared here, at the study, a dataset is visible to every analysis and experiment, so a reference names a cohort by identifier alone (``used: {cohort: <id>}``)." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path tvbo:datasets ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:references ],
        [ sh:class tvbo:ResultBinding ;
            sh:description "The named numbers the prose cites, each keyed by the manuscript token that stands in for it (``key``) and bound either to a computed value (``used:`` a DataRef into this study's or a nested study's analysis) or to an authored constant quoted from prior work (``value`` + ``source``). ``tvbo run`` collects these into a results manifest the document reads, so no reported figure is transcribed by hand and a stale or missing key fails the build rather than printing a wrong number." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path tvbo:results ],
        [ sh:class schema1:ImageObject ;
            sh:description "Declarative Figure specs rendered from this study's experiment results — closes the replication loop (a study is its experiments plus the figures that read them)." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path tvbo:figures ],
        [ sh:datatype xsd:string ;
            sh:description "BibTeX citation key; the join key into references.bib for full bibliographic detail. A study is identified by its key/citekey and described by its title — no ``name`` needed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:citekey ],
        [ sh:class tvbo:SimulationStudy ;
            sh:description "Other studies this one aggregates, each a ``SimulationStudy`` in its own right — so a study-of-studies is the same class as the studies it holds, and nesting recurses to any depth without a wrapper class standing between a study and the studies it holds. A whole manuscript is then one runnable specification whose sub-studies are runnable specifications. Written as ``!include <path>`` so each sub-study keeps its own recipe file and therefore its own directory: its ``code_source``, its results root and its relative references all resolve against where it lives, not against whoever included it. ``tvbo run`` walks the nested studies depth first, then runs the owning study's own experiments, analyses and figures — the paper-native content belonging to no sub-study. Legitimized by COMBINE/OMEX, SED-ML and the ISA ``Investigation`` top-level container it parallels." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path tvbo:studies ],
        [ sh:datatype xsd:string ;
            sh:description "Author display strings (full detail in references.bib)." ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path tvbo:authors ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path bibo:doi ],
        [ sh:class tvbo:Sample ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:sample ],
        [ sh:class tvbo:ArchiveConfig ;
            sh:description "How to package the run into a COMBINE/OMEX archive — the single supplementary artifact from which every figure, number and caption regenerates. Unset means no archive is emitted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path tvbo:archive ],
        [ sh:class tvbo:CodeSource ;
            sh:description "Where this study's callable code lives — the builders and transform/observation callables it references by bare ``module:`` name. Decouples the specification from its code: a local directory (relative to the recipe YAML or absolute) or a git repository fetched and cached at load time. When absent, the conventional ``<recipe-dir>/code/`` is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path tvbo:code_source ],
        [ sh:class schema1:SoftwareApplication ;
            sh:description "Packages this study's own code needs beyond what tvbo itself installs, keyed by package name and carrying the version it was reproduced against. A replication that matches a paper's method often has to use the paper's tool — a spectral parameterisation, a specific solver — and a study whose report imports one that nothing declares runs only on the machine that happens to have it. This states what is required; ``prov-<label>_soft`` records what actually ran, so the two can be compared rather than assumed equal." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path tvbo:requires ],
        [ sh:datatype xsd:string ;
            sh:description "Deprecated alias of the inherited ``citekey``; retained for back-compatibility with existing tooling." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:key ],
        [ sh:class tvbo:SimulationExperiment ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:simulation_experiments ],
        [ sh:class tvbo:Dynamics ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:model ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dcterms:issued ],
        [ sh:class tvbo:WorkflowConfig ;
            sh:description "Study-wide default orchestration for rendering its experiments' sweeps into distributed workflows (Slurm/Snakemake/Nextflow). Individual experiments refine it via ``workflow_overrides``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:workflow ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Analysis ;
            sh:description "Analyses of this study's results, each persisted as its own container and so bindable by a figure or a later analysis exactly like a run. These take the ``Analysis`` form that invokes a ``callable`` over ``arguments`` (the ``type``/``target``/``wrt`` form analyses a solve and belongs on an ``Observation`` instead), and each needs a unique ``name`` — it keys the container. An argument's ``used:`` DataRef both records what was consumed and orders the run: ``tvbo run`` executes the analyses around the experiments — one an experiment consumes first, one consuming an experiment after — and then renders the figures." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path tvbo:analyses ],
        [ sh:class tvbo:Theme ;
            sh:description "The look every figure of this study is drawn in: one rule, stated once, usually a ``tvbo:Theme`` file under ``spec/`` named with ``!include``. It carries the colours, the type, the stroke weights and the axis rule (who places the ticks, where an axis ends, which spines are drawn and whether they meet). A figure's own ``theme`` and its own slots beat it wherever they state something; nothing else does. Start from a curated one with ``theme: {iri: tvbo:themes/default}`` (or ``tvbo:themes/bsplot``) and state only the differences." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path tvbo:theme ],
        [ sh:datatype xsd:string ;
            sh:description "Publication type (article, book, inproceedings, …)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path tvbo:type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dcterms:title ] ;
    sh:targetClass tvbo:SimulationStudy .

tvbo:SpatialDomain a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Optional file for geometry/ROI mask (e.g., NIfTI, GIfTI)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:geometry ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Optional named region/ROI in the atlas/parcellation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:region ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Transformation> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:coordinate_space ] ;
    sh:targetClass tvbo:SpatialDomain .

tvbo:StateSelection a sh:NodeShape ;
    rdfs:comment "Which iterate of an online tuning run hands its parameters to the post-tuning evaluation and to the algorithms that depend on it. Absent, the final iterate does. Declared, the loop keeps the tuned parameters and the settled state of the iteration whose criterion was best, tracked across every stage jointly and restored after the last stage (or per stage under `scope: stage`); the run records the chosen iteration and its criterion value. This is the published feedback-inhibition simulator's practice of keeping the weights of the iteration with the lowest in-loop FC error rather than the last ones." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:defaultValue "min" ;
            sh:description "Whether the smallest (min, the default) or the largest (max) criterion value is best." ;
            sh:in ( "min" "max" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path tvbo:mode ],
        [ sh:defaultValue "run" ;
            sh:description "Whether one best iterate is chosen over the whole run (run, the default) or one per stage, restored before the next stage starts (stage)." ;
            sh:in ( "run" "stage" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path tvbo:scope ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the in-loop quantity to rank iterations by, one of the algorithm's `observations` or `functions` (e.g. an in-loop `fc_rmse` of the windowed FC against the target); its per-iteration mean is ranked, so a per-node value is averaged over nodes. It is measured on the parameters in effect during that iteration, so the kept snapshot is the one that produced it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:criterion ],
        [ sh:datatype xsd:integer ;
            sh:description "First iteration eligible for selection, counted from the first tuning iteration after the observation window has filled; it continues across stages under `scope: run` and restarts with every stage under `scope: stage`. Use it to skip the iterations a still-settling window makes look good." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:from_iteration ] ;
    sh:targetClass tvbo:StateSelection .

tvbo:Style a sh:NodeShape ;
    rdfs:comment "Layer/panel styling, portable intent plus a namespaced backend passthrough. Reuses Argument for the passthrough (matplotlib implicit in the MVP)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Semantic colour or palette name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:color ],
        [ sh:datatype xsd:string ;
            sh:description "Named colormap (routed through the cmap resolver)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:colormap ],
        [ sh:class tvbo:Argument ;
            sh:description "Raw backend passthrough (e.g. linewidth, linestyle); matplotlib implicit until a second backend lands." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:opts ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:opacity ] ;
    sh:targetClass tvbo:Style .

tvbo:Surrogate a sh:NodeShape ;
    rdfs:comment "A permutation-significance test: re-evaluate a named statistic under n_perm fixed permutations of a field and report the per-element exceedance p-value. General (any permutation null — spatial nulls, FC significance, wave detection, …). Codegen emits ``(vmap(lambda p: stat(field[p]))(perms) <cmp> stat(field)).mean(axis over perms)``; the wrapped statistic is an ordinary symbolic derived variable, so only the permutation fold is structural." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:defaultValue "greater_equal" ;
            sh:description "Exceedance direction: ``greater_equal`` (fraction of permutations whose statistic ≥ the observed) or ``less_equal`` (one-sided negative test)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:direction ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the derived variable to re-evaluate under permutation." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:statistic ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the observer parameter holding the fixed ``(n_perm, n)`` permutation- index array (a produced/sourced constant, reused across the window and grid)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:permutations ],
        [ sh:datatype xsd:string ;
            sh:description "The symbol whose entries are permuted (the observation source, or a parameter such as an in-strength vector)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:permute ],
        [ sh:datatype xsd:boolean ;
            sh:description "Apply a Westfall–Young family-wise (max-T) correction: collapse the permuted statistic to its extremum over the element axes, forming one family-wise null per permutation that every observed element is tested against. The extremum follows ``direction`` (``greater_equal`` → maximum, ``less_equal`` → minimum). Absent → the symmetric per-element test." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:family_wise ] ;
    sh:targetClass tvbo:Surrogate .

tvbo:Tractogram a sh:NodeShape ;
    rdfs:comment "Reference to tractography/diffusion MRI data used to derive structural connectivity" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Number of subjects in the tractography dataset" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:number_of_subjects ],
        [ sh:datatype xsd:string ;
            sh:description "Path or URI to the tractography data file" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:data_source ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Acquisition protocol or scanner information" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:acquisition ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Processing pipeline used to generate the tractography" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:processing_pipeline ],
        [ sh:datatype xsd:string ;
            sh:description "Publication or DOI reference for this tractography dataset" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:references ] ;
    sh:targetClass tvbo:Tractogram .

tvbo:TuningObjective a sh:NodeShape ;
    rdfs:comment "Defines what the tuning algorithm optimizes for. Can be an activity target (FIC) or a connectivity target (EIB)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Equation ;
            sh:description "Metric equation for matching (e.g., correlation, rmse)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:metric ],
        [ sh:class tvbo:Observation ;
            sh:description "Reference to empirical data observation for matching objectives" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path tvbo:target_data ],
        [ sh:datatype xsd:float ;
            sh:description "Target value for activity objectives" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:target_value ],
        [ sh:datatype xsd:string ;
            sh:description "Type of objective: 'activity_target', 'fc_matching', 'custom'" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:type ],
        [ sh:class tvbo:StateVariable ;
            sh:description "State variable for activity targets (e.g., S_e)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:target_variable ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ] ;
    sh:targetClass tvbo:TuningObjective .

tvbo:UpdateRule a sh:NodeShape ;
    rdfs:comment "Defines how a parameter is updated based on observables. Represents iterative learning rules like FIC or EIB updates. Functions from experiment.functions are available in the equation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Observation ;
            sh:description "Observables required by this update rule" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path tvbo:requires ],
        [ sh:class tvbo:Range ;
            sh:description "Constraints on parameter values after update" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:bounds ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class tvbo:Parameter ;
            sh:description "The parameter to update (e.g., J_i, wLRE)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:target_parameter ],
        [ sh:class tvbo:Equation ;
            sh:description "Update equation (e.g., 'J_i + eta * delta'). Can use functions defined in experiment.functions section." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:equation ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether to apply learning rate warmup to this update rule. When true, the learning rate (eta) is scaled by (i+1)/n_iterations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:warmup ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass tvbo:UpdateRule .

<https://w3id.org/tvbo/dbs/ClinicalImprovement> a sh:NodeShape ;
    rdfs:comment "Relative improvement on a defined clinical score." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Preoperative baseline value of the score" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/dbs/baseline_value> ],
        [ sh:datatype xsd:string ;
            sh:description "Timepoint of assessment (e.g., \"1 month post-op\", \"6 months post-op\")" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/dbs/timepoint> ],
        [ sh:datatype xsd:float ;
            sh:description "Timepoint of assessment in days or months after implantation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/dbs/time_post_surgery> ],
        [ sh:datatype xsd:float ;
            sh:description "Percent change compared to preoperative baseline (positive = improvement)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/dbs/percent_change> ],
        [ sh:datatype xsd:string ;
            sh:description "Who performed the rating (e.g., rater initials, clinician ID, or system)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/dbs/evaluator> ],
        [ sh:class <https://w3id.org/tvbo/dbs/ClinicalScore> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/tvbo/dbs/score> ],
        [ sh:datatype xsd:float ;
            sh:description "Absolute value of the score at the time of assessment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/dbs/absolute_value> ] ;
    sh:targetClass <https://w3id.org/tvbo/dbs/ClinicalImprovement> .

<https://w3id.org/tvbo/dbs/ClinicalScale> a sh:NodeShape ;
    rdfs:comment "A clinical assessment inventory or structured scale composed of multiple scores or items." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Full name of the scale (e.g., Unified Parkinson’s Disease Rating Scale)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Overall clinical domain (e.g., motor, cognition)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/dbs/domain> ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the instrument (e.g., 3.0)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:softwareVersion ],
        [ sh:datatype xsd:string ;
            sh:description "DOI, PMID or persistent identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:references ],
        [ sh:datatype xsd:string ;
            sh:description "Short abbreviation (e.g., UPDRS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path skos:notation ] ;
    sh:targetClass <https://w3id.org/tvbo/dbs/ClinicalScale> .

<https://w3id.org/tvbo/dbs/Contact> a sh:NodeShape ;
    rdfs:comment "Individual contact on a DBS electrode." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Optional human-readable label (e.g., \"1a\")" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            sh:description "3D coordinate of the contact center in the defined coordinate space" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/dbs/coordinate> ],
        [ sh:datatype xsd:integer ;
            sh:description "Identifier (e.g., 0, 1, 2)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass <https://w3id.org/tvbo/dbs/Contact> .

<https://w3id.org/tvbo/dbs/DBSProtocol> a sh:NodeShape ;
    rdfs:comment "A protocol describing DBS therapy, potentially bilateral or multi-lead." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/tvbo/dbs/ClinicalImprovement> ;
            sh:description "Observed improvement relative to baseline based on a defined score." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/dbs/clinical_improvement> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/dbs/notes> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/dbs/timing_info> ],
        [ sh:class <https://w3id.org/tvbo/dbs/Electrode> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/dbs/electrodes> ],
        [ sh:class <https://w3id.org/tvbo/dbs/StimulationSetting> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/dbs/settings> ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass <https://w3id.org/tvbo/dbs/DBSProtocol> .

<https://w3id.org/tvbo/dbs/DBSSubject> a sh:NodeShape ;
    rdfs:comment "Human or animal subject receiving DBS." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/dbs/handedness> ],
        [ sh:datatype xsd:float ;
            sh:description "Age at time of study (years)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/tvbo/study/age> ],
        [ sh:datatype xsd:string ;
            sh:description "Path to subject-specific connectome (when not session-dependent). Relative to dataset root or BIDS derivatives. For session-specific networks, use Session.network instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://w3id.org/tvbo/study/network> ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Additional subject metadata as key-value pairs or path to a sidecar JSON file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://w3id.org/tvbo/study/metadata> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/tvbo/dbs/diagnosis> ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Transformation> ;
            sh:description "Coordinate space used for this subject's data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/dbs/coordinate_space> ],
        [ sh:class <https://w3id.org/tvbo/study/Session> ;
            sh:description "Data collection sessions for this subject. Each session can have its own network, empirical data, and conditions." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path <https://w3id.org/tvbo/study/sessions> ],
        [ sh:class <https://w3id.org/tvbo/dbs/DBSProtocol> ;
            sh:description "All DBS protocols assigned to this subject." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/dbs/protocols> ],
        [ sh:description "Biological sex." ;
            sh:in ( "male" "female" "other" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path <https://w3id.org/tvbo/study/sex> ],
        [ sh:datatype xsd:string ;
            sh:description "Group assignment (e.g., 'control', 'patient', 'healthy'). Maps to participants.tsv 'group' column in BIDS." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/study/group> ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS-compatible subject identifier (without 'sub-' prefix). Examples: '01', 'ctrl03', 'patient17'." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass <https://w3id.org/tvbo/dbs/DBSSubject> .

<https://w3id.org/tvbo/dbs/EField> a sh:NodeShape ;
    rdfs:comment "Simulated electric field from DBS modeling." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Reference to raw or thresholded volume" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/tvbo/dbs/volume_data> ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Transformation> ;
            sh:description "Reference to a common coordinate space (e.g. MNI152)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/dbs/coordinate_space> ],
        [ sh:datatype xsd:float ;
            sh:description "Threshold value applied to the E-field simulation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/dbs/threshold_applied> ] ;
    sh:targetClass <https://w3id.org/tvbo/dbs/EField> .

<https://w3id.org/tvbo/dbs/StimulationSetting> a sh:NodeShape ;
    rdfs:comment "DBS parameters for a specific session." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/tvbo/dbs/Electrode> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/tvbo/dbs/electrode_reference> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/dbs/mode> ],
        [ sh:class tvbo:Parameter ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/dbs/pulse_width> ],
        [ sh:datatype xsd:integer ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/dbs/active_contacts> ],
        [ sh:class tvbo:Parameter ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/dbs/amplitude> ],
        [ sh:class tvbo:Parameter ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/dbs/frequency> ],
        [ sh:class <https://w3id.org/tvbo/dbs/EField> ;
            sh:description "Metadata about the E-field result for this setting" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/dbs/efield> ] ;
    sh:targetClass <https://w3id.org/tvbo/dbs/StimulationSetting> .

<https://w3id.org/tvbo/study/CohortRule> a sh:NodeShape ;
    rdfs:comment "Admits a cohort's members by a measure of a phenotype table: the candidates are cut into ``n_groups`` groups along ``measure`` and the cohort holds the group ``group``. The candidates are the members of the cohort ``of`` names, else the subjects the dataset lists, else every subject of the table. Each candidate needs one row in the table. A candidate without a row, or whose value is missing or not finite, is treated as ``missing`` says, before any group is formed. The members come in the candidates' order, not in the order of the measure. A group no candidate falls in is an error, as a cohort without members is." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "``cohort_id`` of another cohort of the same dataset whose members are the candidates, so a split is taken inside a cohort. That cohort may itself be typed, read from a file or admitted by a rule; a chain that leads back to this cohort is an error." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/study/of> ],
        [ sh:description "How the candidates are cut into groups." ;
            sh:in ( "equal_width" "equal_count" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/study/grouping> ],
        [ sh:defaultValue "refuse" ;
            sh:description "What happens to a candidate without a finite value of the measure." ;
            sh:in ( "refuse" "exclude" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/study/missing> ],
        [ sh:datatype xsd:string ;
            sh:description "Path of the phenotype table this rule reads, where it is not the dataset's own (``Dataset.phenotype_file``). Resolved as ``Cohort.members_file`` is." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/study/phenotype_file> ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of groups the candidates are cut into." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/study/n_groups> ],
        [ sh:datatype xsd:integer ;
            sh:description "Which group this cohort holds, counted from 1 for the lowest values of the measure to ``n_groups`` for the highest." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/study/group> ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the measure the candidates are split by: a measure of a ``Phenotype`` sidecar or a column of a tabular file." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/tvbo/study/measure> ] ;
    sh:targetClass <https://w3id.org/tvbo/study/CohortRule> .

<https://w3id.org/tvbo/study/LayoutTemplateVariant> a sh:NodeShape ;
    rdfs:comment "One variant's seed for a file the record already accounts for." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Asset seeding the file when that variant is selected." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/study/template> ],
        [ sh:datatype xsd:string ;
            sh:description "The ``tvbo study init --template`` name this seed belongs to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/tvbo/study/variant> ] ;
    sh:targetClass <https://w3id.org/tvbo/study/LayoutTemplateVariant> .

<https://w3id.org/tvbo/study/StudyTemplate> a sh:NodeShape ;
    rdfs:comment "One kind of study the layout accounts for. A template is a *specialisation*: it names the entries a kind adds to the study every kind already shares, and nothing else. The general study is therefore not a template and names none — a kind earns an entry here only once some directory or file genuinely belongs to it and not to the rest." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass <https://w3id.org/tvbo/study/StudyTemplate> .

<https://w3id.org/tvbo/study/Subject> a sh:NodeShape ;
    rdfs:comment "A participant in a study. Each subject typically has their own brain network (connectome) and empirical recordings. Corresponds to a BIDS 'sub-' entity." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type tvbo:coordinate_space <https://w3id.org/tvbo/dbs/diagnosis> <https://w3id.org/tvbo/dbs/handedness> <https://w3id.org/tvbo/dbs/protocols> ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional subject metadata as key-value pairs or path to a sidecar JSON file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/tvbo/study/metadata> ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS-compatible subject identifier (without 'sub-' prefix). Examples: '01', 'ctrl03', 'patient17'." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Path to subject-specific connectome (when not session-dependent). Relative to dataset root or BIDS derivatives. For session-specific networks, use Session.network instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/study/network> ],
        [ sh:description "Biological sex." ;
            sh:in ( "male" "female" "other" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/study/sex> ],
        [ sh:datatype xsd:string ;
            sh:description "Group assignment (e.g., 'control', 'patient', 'healthy'). Maps to participants.tsv 'group' column in BIDS." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/study/group> ],
        [ sh:class <https://w3id.org/tvbo/study/Session> ;
            sh:description "Data collection sessions for this subject. Each session can have its own network, empirical data, and conditions." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/study/sessions> ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:float ;
            sh:description "Age at time of study (years)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/study/age> ] ;
    sh:targetClass <https://w3id.org/tvbo/study/Subject> .

<https://w3id.org/tvbo/sw/ToolUnit> a sh:NodeShape ;
    rdfs:comment """One TVBO unit as a single tool writes it.
A tool's unit vocabulary is a fact about that tool, not about the unit — LEMS calls `Hz` a `per_time` quantity and writes it `per_s`, and no other backend need agree. Keyed by the `UnitEnum` value so a record states only the units its tool knows.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The tool's name for the physical dimension of this unit. Absent where the tool has no dimension for it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/sw/dimension> ],
        [ sh:datatype xsd:string ;
            sh:description "The tool's spelling of the unit itself, appended to numeric values. Absent where the tool writes the value bare." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/sw/symbol> ],
        [ sh:datatype xsd:string ;
            sh:description "The `UnitEnum` value this entry translates." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/tvbo/sw/unit> ] ;
    sh:targetClass <https://w3id.org/tvbo/sw/ToolUnit> .

tvbo:Analysis a sh:NodeShape ;
    rdfs:comment """A quantity obtained by ANALYZING something — a model, its solve, a derived loss, simulated results, or empirical data — rather than by transforming a recorded trajectory. Nothing here requires a model: decomposing empirical maps into a basis, taking their spectrum, or running a permutation test over measured data are analyses in exactly this sense, and so are parameter sensitivities/gradients (autodiff or finite-difference), stability spectra (Lyapunov), bifurcation quantities, identifiability metrics, and reductions spanning several experiments.
It is an invocation (``is_a: FunctionCall``) with two mutually exclusive ways of saying WHAT is analyzed, the same alternative-specification idiom ``Parameter`` uses for provenance:
- **the solve** — ``type`` names the analysis (a free string, extensible;
  the vocabulary lives in the ontology as AnalysisObservable concepts rather
  than a closed enum), ``target`` and ``wrt`` bind it to what is analyzed and
  with respect to what, and ``parameters`` configures it. Evaluated as part
  of the integration, so it is emitted by the same codegen and limited to
  what that backend can trace. Declared on ``Observation.analysis``.

- **saved data** — ``callable`` (or ``class_call``) invoked with
  ``arguments``, each a literal ``value`` or a ``used:`` DataRef reading an
  experiment, another analysis, or a dataset. The data need not be simulated:
  this is equally the form for analysing empirical maps, an atlas, or a
  measured connectome. Because it consumes containers rather than a running
  solve, it is scheduled on its own — before or after the experiments,
  according to what it uses. Declared in ``SimulationStudy.analyses``, where
  the result is persisted as its own container
  (``derivatives/tvbo/ana-<name>_result.h5``) — which is what lets a figure bind it
  with ``used: {analysis: <name>}`` exactly as it binds a run, and why a study
  needs no driver script for its non-simulation figures. ``name`` is then
  required and unique, since it keys that container. The invocation yields a
  mapping of name -> labelled array (or one array, keyed by the analysis
  name); each key becomes an ``observation__<key>`` data-variable keeping its
  dims and coordinates, so a figure ``encoding`` can name them.

Like a ``SimulationExperiment``, an Analysis declares its own ``execution``: which backend renders it, at what precision, on which accelerator. That states a requirement, not a mechanism — the same analysis is renderable by more than one backend, and one that cannot render it says so rather than silently substituting another.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Aggregation ;
            sh:description "How to aggregate the result across dimensions. Example: aggregate.over=node, aggregate.type=mean applies function per node, then averages. Used in loss functions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path tvbo:aggregate ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Axis to apply the function over, one element at a time (generates a vmap in code). ``node`` applies per node, ``time`` per sample. Inside an observation pipeline the axes are the solve grid's and the ``DimensionType`` vocabulary names them; a study-level ``Analysis`` maps over the axes of the CONTAINERS it reads, which are declared by whatever produced them (``subject``, ``parcel``, ``n_modes``, ``variant``), so this is a free string rather than that closed enum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:apply_on_dimension ],
        [ sh:class tvbo:Argument ;
            sh:description "Function arguments keyed by name (the key is the argument name)." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path tvbo:arguments ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the result is kept as a container under the study. ``false`` declares a TRANSIENT analysis: it still runs in dependency order and its outputs feed every analysis that reads it in the same run, but they are written to a temporary directory outside the study for the length of the process, and no container, sidecar or provenance record of them is left behind. It is the form for an intermediate table whose rows are individual-level data (one row per subject of a cohort) that a study must not keep on disk, where only the reductions downstream are results. A transient analysis is re-run whenever a run needs it, counts as neither missing nor stale, and is read only by the analyses and experiments of the same run: a figure, a report or a kit, which read containers, are refused it by name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:persist ],
        [ sh:class tvbo:Function ;
            sh:description "Reference to a defined Function (by name)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path tvbo:function ],
        [ sh:class tvbo:ExecutionConfig ;
            sh:description "Which backend renders this analysis, and at what precision / accelerator / worker count — the same declaration a ``SimulationExperiment`` carries, so an analysis is not tied to one engine. Unset means the study's default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path tvbo:execution ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Reference to previous function's output in pipeline (by name)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:input ],
        [ sh:class tvbo:Callable ;
            sh:description "Direct callable specification (alternative to function reference)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path tvbo:callable ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path tvbo:source_code ],
        [ sh:datatype xsd:string ;
            sh:description "Quantity/quantities the analysis is taken with respect to, e.g. a parameter 'c_sigmJR.G' for a gradient/sensitivity. Omitted for analyses that need no explicit differentiation target." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:wrt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path skos:notation ],
        [ sh:datatype xsd:string ;
            sh:description "Axis names of this analysis's output, in order — declared, never inferred from the result's shape, which cannot tell a frequency-by-node spectrum from a node-by-node matrix. Needed only where the expression RESHAPES: for the ordinary map-then-aggregate form the axes follow from ``apply_on_dimension`` plus the inputs' own axes minus ``aggregate.over``, and a renderer derives them and cross-checks the result's rank against that derivation. Declare it when the expression builds an axis none of its inputs carried (an outer product, a correlation matrix) or the derivation raises." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:dims ],
        [ sh:datatype xsd:string ;
            sh:description "Name for this step's output (referenced by subsequent functions)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path tvbo:output ],
        [ sh:class tvbo:Equation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path tvbo:Equation ],
        [ sh:datatype xsd:string ;
            sh:description "What is analyzed: typically an observation or loss name (e.g. 'loss' for a gradient). Omitted when the analysis acts on the whole solve (e.g. a Lyapunov spectrum)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:target ],
        [ sh:datatype xsd:string ;
            sh:description "Optional step label; used in pipelines to key step outputs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path schema1:name ],
        [ sh:class tvbo:ClassReference ;
            sh:description "Class instantiation and call (alternative to callable/function). Use for external library classes that need __init__ then __call__. Example: Bold monitor from tvboptim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path tvbo:class_call ],
        [ sh:datatype xsd:string ;
            sh:description "The analysis kind, e.g. 'gradient', 'finite_difference', 'lyapunov', 'bifurcation', 'identifiability', 'sensitivity'. A free string, not a closed enum, so backends can extend the set; the backend-independent vocabulary (what each kind computes) is defined as AnalysisObservable concepts in the ontology (tvb-o-axioms §4.1d). Backends dispatch on it and skip (with a comment, not a raise) when they have no equivalent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:type ],
        [ sh:class tvbo:Range ;
            sh:description "Time range for generated TimeSeries (for kernel generators)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path tvbo:time_range ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path tvbo:parameters ] ;
    sh:targetClass tvbo:Analysis .

tvbo:Annotation a sh:NodeShape ;
    rdfs:comment "A positioned text label on a panel, in axes-fraction coordinates. With a `used:` binding the number in it is READ from a result rather than typed, which is what keeps a panel's printed statistic (an r, a p-value) from drifting away from the run that produced it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Text colour; defaults to the current text colour." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:color ],
        [ sh:class prov:Entity ;
            sh:description "The arrow tail's y, read from a result container (same reference form a Layer uses). What lets a panel point AT a computed value — a curve's height at a marked x — without that height being typed into the spec." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:datatype xsd:float ;
            sh:description "Text rotation in degrees counter-clockwise; 90 for a label running up the side of a reference line." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:rotation ],
        [ sh:datatype xsd:string ;
            sh:description "Vertical alignment against (x, y) — bottom, center, top, baseline. Defaults to center." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:va ],
        [ sh:datatype xsd:float ;
            sh:description "y in axes fraction (0 = bottom, 1 = top); defaults to 0.95." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:y ],
        [ sh:datatype xsd:string ;
            sh:description "The label. With `used:` it is a Python format string applied to the referenced value, e.g. 'r = {:.2f}'." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:text ],
        [ sh:datatype xsd:string ;
            sh:description "Named corner ('upper right', 'upper left', 'center', ...) as an alternative to x/y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:loc ],
        [ sh:datatype xsd:string ;
            sh:description "Horizontal alignment against (x, y) — left, center, right. Defaults to center." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:ha ],
        [ sh:datatype xsd:float ;
            sh:description "Text size in points, overriding the figure's font size for this label alone." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:size ],
        [ sh:datatype xsd:float ;
            sh:description "Draw an arrow POINTING AT (x, y), starting (dx, dy) away from it in axes fractions — e.g. [-0.08, 0.06] for one coming from the upper left. The text, when non-empty, sits at the tail. This is how a paper's callout arrowheads are declared instead of drawn in code." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:arrow ],
        [ sh:class tvbo:Significance ;
            sh:description "Asterisks set after the text for a p-value READ from a result, as a paper prints `r=0.89***`. On the panel only: a caption states a test in words, so a `placement: caption` annotation that declares one is refused." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path tvbo:significance ],
        [ sh:class prov:Entity ;
            sh:description "Bind the annotation to a scalar in a result container (same reference form a Layer uses, and the same PROV edge). The referenced value is formatted through `text` at render time, so a statistic printed on a panel is computed, never transcribed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path prov:used ],
        [ sh:description "Where the text appears: on the panel (absent, or `panel`) or in the figure's composed caption (`caption`), where the position and text style slots do not apply." ;
            sh:in ( "panel" "caption" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path tvbo:placement ],
        [ sh:datatype xsd:float ;
            sh:description "x in axes fraction (0 = left, 1 = right); defaults to 0.5." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:x ],
        [ sh:datatype xsd:float ;
            sh:description "Start the arrow at this x in DATA coordinates instead of at an axes-fraction offset. Pair with tail_used, which supplies the y: together they anchor the arrow's tail on a point the run computed, so a callout keeps pointing at its data when the data changes. Ignored unless tail_used is also set." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:tail_x ] ;
    sh:targetClass tvbo:Annotation .

tvbo:BoundaryCondition a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:time_dependent ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:in ( "Dirichlet" "Neumann" "Robin" "Periodic" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path tvbo:bc_type ],
        [ sh:datatype xsd:string ;
            sh:description "Mesh/atlas subset where BC applies." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:on_region ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Equation ;
            sh:description "What the boundary is held at — a constant, a parameter, or an expression in space and time. An `Equation` because a Dirichlet value is not always a number: `value` is the older spelling, and said `Parameter.value` (a number) about something that is not one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:equation ] ;
    sh:targetClass tvbo:BoundaryCondition .

tvbo:BrainRegionSeries a sh:NodeShape ;
    rdfs:comment "A series whose values represent latitude" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:values ] ;
    sh:targetClass tvbo:BrainRegionSeries .

tvbo:Camera a sh:NodeShape ;
    rdfs:comment "Where a 3-D panel is looked at from. Only a `line3d` panel or a surface reads it; every other kind ignores it. Stated as a class rather than three loose options because a viewpoint is one thing, and a figure that states two of its three numbers is under-specified in a way nothing else would catch." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Angle around the vertical axis, in degrees." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:azimuth ],
        [ sh:datatype xsd:float ;
            sh:description "Scale factor on the projected view; above 1 moves the camera in." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:zoom ],
        [ sh:datatype xsd:float ;
            sh:description "Angle above the horizontal plane, in degrees." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:elevation ] ;
    sh:targetClass tvbo:Camera .

tvbo:Colorbar a sh:NodeShape ;
    rdfs:comment """The colour scale a panel prints beside its field. Declared as one object because nine loose `colorbar_*` options were nine chances to style a bar that is not drawn, and because a tick list written in an options bag is not a list of numbers to anything that reads it.

A heatmap carries one unasked, since it is unreadable without one; a scatter shaded by a third quantity asks with `show: true`, because a row of them conventionally shares ONE bar. `kind: colorbar` is the standalone form — a bar occupying its own cell of the mosaic, keying the panels around it, and the only case that states its own `colormap` and limits rather than taking them from the field it sits beside.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Text for the marked values of a STANDALONE `kind: colorbar` panel, where the numbers themselves are not what the figure wants to print. A bar attached to a panel writes its own numbers, which the shared format pass rounds to `decimals`." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:ticklabels ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the bar is drawn. Unset means yes for a heatmap and no for a scatter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:show ],
        [ sh:datatype xsd:string ;
            sh:description "What the scale measures, printed along the bar." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:label ],
        [ sh:datatype xsd:string ;
            sh:description "The scale, as a key of the theme's `colormaps` (`sequential`, `diverging`, or one a project added) or a name the backend knows. Unset takes the theme's `sequential`, or its `diverging` where the scale is centred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:colormap ],
        [ sh:description "Which side of the panel it sits on." ;
            sh:in ( "left" "right" "top" "bottom" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path tvbo:location ],
        [ sh:datatype xsd:float ;
            sh:description "Pin the map's neutral colour to this value and truncate the map to the half-range the data reaches, keeping the data's own limits: a unit of change is the same colour distance either side, and the bar shows no colour the field never takes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:center ],
        [ sh:datatype xsd:float ;
            sh:description "The value the scale starts at. A declared end is honoured as given; the other is still derived from the data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:vmin ],
        [ sh:datatype xsd:float ;
            sh:description "The values to mark. A declared tick list is the paper's own; unset lets the backend choose." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:ticks ],
        [ sh:description "Which way the bar runs." ;
            sh:in ( "vertical" "horizontal" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path tvbo:orientation ],
        [ sh:datatype xsd:boolean ;
            sh:description "Centre the limits on zero, so zero is the map's midpoint. What a field of signed deviations needs — read on an off-centre scale it is misleading in a way no axis label catches." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:symmetric ],
        [ sh:datatype xsd:float ;
            sh:description "Width of the bar as a fraction of the panel. The default is slim on purpose: matplotlib's own steals about a fifth of a small panel." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:fraction ],
        [ sh:datatype xsd:float ;
            sh:description "The value the scale ends at. See `vmin`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:vmax ],
        [ sh:datatype xsd:float ;
            sh:description "The bar's length over its width." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:aspect ],
        [ sh:datatype xsd:float ;
            sh:description "Gap between the panel and its bar, in the same fraction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:pad ],
        [ sh:datatype xsd:integer ;
            sh:description "How many decimal places the tick numbers are written to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:decimals ],
        [ sh:datatype xsd:float ;
            sh:description "Width of a STANDALONE `kind: colorbar` panel's bar within its own cell, as a fraction of that cell." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:width ],
        [ sh:datatype xsd:float ;
            sh:description "Clip the limit to this percentile of the values (100 = no clipping), so one outlier region cannot wash the whole map out. Applies whether or not the scale is centred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:percentile ] ;
    sh:targetClass tvbo:Colorbar .

tvbo:Colormaps a sh:NodeShape ;
    rdfs:comment "Continuous colour scales, by key: anything ordinal or continuous draws from one of these, anything categorical draws from `Palette.palette`, and an ordinal scale drawn as discrete swatches samples one rather than picking hues that imply no order. A value is either a registered colormap name (`viridis`) or the list of colours to ramp between (`['#000000', '#ffffff']`). The namespace is open — a project adds its own keys for the scales it distinguishes (`bold: viridis, meg: plasma, eeg: cividis`) and names them anywhere a colormap is named. `sequential` and `diverging` are the two the renderer reaches for on its own, so they are typed here and always present: a project that declares neither still has both. An open namespace cannot catch a misspelt key — `sequentiel` is read as a project key, not as a typo — which is the price of letting a project name its own scales. A key that shadows a registered colormap name is refused, so a name cannot mean two things at once." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Signed quantities read against a midpoint, where the two directions must be told apart at a glance. The scale a mark whose limits are centred takes, so a map of signed deviations is not drawn on a one-directional ramp." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] [ ] ) ;
            sh:order 1 ;
            sh:path tvbo:diverging ],
        [ sh:description "Ordered magnitudes with no meaningful zero. The scale an undeclared continuous mark takes, and what `image.cmap` is set to." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] [ ] ) ;
            sh:order 0 ;
            sh:path tvbo:sequential ] ;
    sh:targetClass tvbo:Colormaps .

tvbo:Continuation a sh:NodeShape ;
    rdfs:comment "Complete specification of a numerical continuation / bifurcation analysis. All universal solver settings live directly here. Toolkit-specific string options go in the options slot. When used inside a BranchSwitch, only explicitly set attributes override the parent's values." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Maximum adaptive step size." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:ds_max ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of eigenvalue sign inversions to flag a bifurcation. Must be even. Higher = fewer false positives." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:n_inversion ],
        [ sh:datatype xsd:integer ;
            sh:description "Maximum bisection steps for bifurcation point localization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path tvbo:max_bisection_steps ],
        [ sh:class tvbo:Option ;
            sh:description "Toolkit-specific string options (tangent method, solver name, etc.)." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path tvbo:options ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum adaptive step size." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:ds_min ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of eigenvalues to compute. Must be >= number of state variables for reliable Hopf detection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:nev ],
        [ sh:datatype xsd:float ;
            sh:description "Initial arc-length step size." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:ds ],
        [ sh:datatype xsd:float ;
            sh:description "Tolerance on real part of eigenvalue for stability boundary." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:tol_stability ],
        [ sh:datatype xsd:boolean ;
            sh:description "Enable fold (limit point) detection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:detect_fold ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class tvbo:ExecutionConfig ;
            sh:description "Per-analysis execution configuration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path tvbo:execution ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:integer ;
            sh:description "Maximum continuation steps." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:max_steps ],
        [ sh:datatype xsd:boolean ;
            sh:description "Continue in both directions from the starting point; unset, false. On a branch's nested continuation it applies only where the branch declares no bothside of its own (BranchSwitch.bothside)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path tvbo:bothside ],
        [ sh:datatype xsd:integer ;
            sh:description "Maximum Newton corrector iterations per step: NewtonPar max_iterations on BifurcationKit.jl, and both ITNW and ITMX on the AUTO-07p backends. Unset, each backend keeps its own default, BifurcationKit.jl 25 and AUTO-07p ITNW 5 and ITMX 9. A branch's nested continuation that leaves it unset takes its parent's." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:newton_max_iterations ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareRequirement> ;
            sh:description "Backend engine (BifurcationKit, AUTO-07p, MatCont, etc.)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path tvbo:software ],
        [ sh:datatype xsd:float ;
            sh:description "Absolute tolerance on the residual at which the Newton corrector has converged: the norm of the right-hand side f(x, p) at the corrected point must fall below it, in the units of f. BifurcationKit.jl applies it as that bound (NewtonPar tol). AUTO-07p tests the size of each Newton correction instead, relative to the size of the solution, so the AUTO-07p backends (auto-07p and pyrates-bifurcation) set both of its relative criteria to it, EPSL on the parameter and EPSU on the state, and only approximate the residual bound: a correction and the residual it removes differ by the conditioning of the Jacobian. Unset, each backend keeps its own default, BifurcationKit.jl 1e-12 on the residual and AUTO-07p 1e-7 on the correction. A branch's nested continuation that leaves it unset takes its parent's." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:newton_tol ],
        [ sh:class tvbo:Parameter ;
            sh:description "The parameters the continuation varies, each a parameter of its dynamics with a domain (lo, hi) bounding it and an optional value it starts from, the dynamics' own value where none is given. A bound the domain leaves out is the dynamics parameter's own; one neither declares is refused by name, since the range decides which part of the diagram is computed. A continuation an experiment declares frees one parameter, and is refused when it frees none. A two-parameter (codim-2) continuation is a branch of it: the branch's nested continuation frees the second parameter, listed alone or after the primary it inherits (for primary p and second C, [C] or [p, C]), and is continued from the special points the branch's source_point selects. Its result carries the primary in param and the second in param2 on every backend." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path tvbo:free_parameters ],
        [ sh:class tvbo:InitialState ;
            sh:description "How to obtain the initial equilibrium. Default: time integration to steady state." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path tvbo:initial_state ],
        [ sh:datatype xsd:integer ;
            sh:description "Bifurcation detection level. 0 = off, 1 = eigenvalues only, 2 = detect, 3 = locate precisely." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:detect_bifurcation ],
        [ sh:class tvbo:Dynamics ;
            sh:description "Reference to the dynamical system model (by name). Resolved from the experiment's dynamics dict at runtime." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:dynamics ],
        [ sh:class tvbo:BranchSwitch ;
            sh:description "Child branches to continue from detected bifurcation points (PO from Hopf, fold continuation, etc.)." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path tvbo:branches ],
        [ sh:defaultValue "PALC" ;
            sh:description "Predictor-corrector algorithm." ;
            sh:in ( "PALC" "MoorePenrose" "Natural" ) ;
            sh:maxCount 1 ;
            sh:order 18 ;
            sh:path tvbo:algorithm ],
        [ sh:class tvbo:HeldParameter ;
            sh:description "The parameters the continuation holds to a target while it varies its free parameter, as feedback inhibition control holds J_i: each names the parameter and the algorithm whose objective states the target. The continued system gains each held parameter as an unknown whose equation is that objective's residual. Refused when the objective states no target_variable and target_value, when no update rule of the algorithm targets the parameter, and on a continuation backend that holds no parameters (bifurcationkit holds them)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:held_parameters ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass tvbo:Continuation .

tvbo:Coupling a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:defaultValue "Linear" ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Output symbol names for the edge model. E.g. ['P'] for a scalar power flow, ['Fx', 'Fy'] for 2D forces. Maps directly to outsym in ND.jl EdgeModel. If not specified, derived from coupling variables of the connected vertex dynamics." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:outsym ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "directed" ;
            sh:description "Declared symmetry of the edge function: 'directed' (default), 'antisymmetric', or 'symmetric', shown in reports. Every backend evaluates each direction of a connection as its own directed edge, so it changes no simulation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:symmetry ],
        [ sh:class tvbo:Equation ;
            sh:description "Pre-processing expression applied before coupling" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path tvbo:pre_expression ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether coupling includes transmission delays" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:delayed ],
        [ sh:description "The coupling function this record is an instance of. A ``network.coupling`` entry is keyed by its role in the network ('excitatory', 'delayed'), so naming the function it instantiates is what ``iri`` is for; ``type`` is accepted as the older spelling of the same thing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the coupling uses sparse representations" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:sparse ],
        [ sh:class tvbo:Equation ;
            sh:description "Post-processing expression applied after coupling" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:post_expression ],
        [ sh:datatype xsd:boolean ;
            sh:description "Opt in to the vectorized matmul fast path for a source-only coupling — one whose pre_expression depends only on source states (e.g. the angle-addition decomposition [sin(theta_j), cos(theta_j)]). The W-reduction then becomes a single ``pre @ weights`` matmul instead of materialising the dense per-edge tensor. ONLY valid for INSTANTANEOUS coupling on a SYMMETRIC connectome (W == Wᵀ): the matmul contracts W while the per-edge path contracts Wᵀ, so the two agree only when W is symmetric. Default false keeps the always-correct per-edge reduction (and delays are inherently per-edge, so this flag is ignored when delayed=true)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:vectorized ],
        [ sh:class tvbo:StateVariable ;
            sh:description "References to state variables from the local (target) node. Used by name in pre_expression." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path tvbo:local_states ],
        [ sh:class tvbo:StateVariable ;
            sh:description "References to state variables from connected (source) nodes. Auto-populated from state_variables with coupling_variable=true when omitted. Used by name in pre_expression." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path tvbo:incoming_states ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:class tvbo:DerivedVariable ;
            sh:description "Observable functions computed from edge inputs and parameters after simulation. Maps to obsf/obssym in ND.jl EdgeModel. Example: absolute force magnitude computed from force components." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path tvbo:observed ],
        [ sh:datatype xsd:boolean ;
            sh:description "For delayed coupling: read delayed states by linear interpolation between the two bracketing history time-steps instead of snapping each delay to the nearest integer step. Removes sub-step quantisation error and makes the coupling differentiable w.r.t. the continuous delay — hence w.r.t. conduction speed v (delay = tract_length / v) — so v can be gradient-optimised. Default false preserves exact nearest-step behaviour (tvboptim roll strategy)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:interpolate_delays ],
        [ sh:class tvbo:Equation ;
            sh:description "Mathematical function defining the coupling" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:coupling_function ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:parameters ] ;
    sh:targetClass tvbo:Coupling .

tvbo:DerivedParameter a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Range ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path tvbo:domain ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:reported_optimum ],
        [ sh:description "External ontology IRIs (typically GO, ChEBI, UBERON, CL, MeSH) that this entity is a surrogate / abstraction / model of. Realized as the `tvbo:surrogate_of` object property, carried inline with the YAML data instance. Multiple IRIs allowed: a single parameter may abstract several biological processes (e.g. a synaptic conductance grounding both GO:0060079 (excitatory PSP) and GO:0007268 (chemical synaptic transmission))." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path tvbo:surrogate_of ],
        [ sh:class prov:Entity ;
            sh:description "WHERE + WHICH + SLICE in one edge — this parameter's array sourced from another experiment's result (an operating point, a tuned ``estimate__<name>`` a fit persisted), a dataset, or a curated entity, PROV ``prov:used``. The full cross-container form of which `source:`+`measure:` is the no-``sel``/no-``experiment`` shorthand; adds label ``reconcile`` and a swept-point ``sel``. Like `source:` the array is resolved lazily and never inlined. An in-study ``experiment`` reference also registers the workflow dependency. Mutually exclusive with `value:`/`source:`/`producer:`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path prov:used ],
        [ sh:description "The ontology classes this record is an instance of (`tvbo:GlobalCouplingScaling`). A class membership, where `iri` is the record's own address and `grounding` names what it stands in for." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path rdf:type ],
        [ sh:datatype xsd:string ;
            sh:description "Declared value type of this parameter, given as a schema range name — a primitive (``integer``, ``float``, ``string``, ``uriorcurie``) or a class (e.g. ``Distribution``). Documents the expected type when the parameter is a *declaration* carrying no concrete ``value`` (e.g. a GraphGenerator's typed argument interface). Distinct from ``domain`` (numeric bounds) and ``unit``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path tvbo:datatype ],
        [ sh:datatype xsd:string ;
            sh:description "WHICH array to select out of `source`. The address space is the source's own: a per-node measure name for a Network (aligning with Network.structural_measures / observational_measures), a dataset key for an HDF5/Zarr store, a recorded measure for an experiment result. Omit when the source resolves to a single array. Without a `source`, or beside the CSV a CSV save writes for it, it is the array's path in the network's own companion (``nodes/parent_index``), and on a ``node_template`` parameter that array runs over the nodes: node ``i`` takes its entry ``i``, so it has one entry per node, and one of another length is refused when the network is read or saved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:measure ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rdfs:label ],
        [ sh:class tvbo:Equation ;
            sh:description "The value of a dynamics or coupling parameter as an expression of the other parameters of the same owner, evaluated once when the network is built. It stands in place of `value`, and declaring both is refused. Beside a parameter `u` that declares a `distribution`, `p: {equation: {rhs: \"1 + u\"}}` and `q: {equation: {rhs: \"1 - u\"}}` give two parameters that share one draw. The result is a value like any other: an algorithm that tunes the parameter, or the one it was computed from, does not evaluate the equation again. A backend that cannot evaluate it refuses the declaration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:Equation ],
        [ sh:class tvbo:Argument ;
            sh:description "Arguments handed to whatever resolves `source`, such as the normalisation or the conduction velocity a per-node measure is computed with. They travel with the parameter so a spec states not only where a value comes from but how it is derived, and a resolver refuses an argument it does not know." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path tvbo:source_arguments ],
        [ sh:description "Physical unit of measurement. `UnitEnum` is the curated vocabulary — each of its values is vendored from QUDT (`ontology/tvb-o-units.ttl`) and can be reasoned about dimensionally. The range is deliberately open beyond it: a unit nobody has curated yet is recorded as written and reported `uncurated`, because a closed range forces the author to either misdeclare the quantity or leave it undeclared, and both lose more than an unrecognised string does. An uncurated unit carries no dimensional claim, so a check involving it reports `underdetermined` rather than guessing. Promote one with `tvbo units add <unit>`, which pulls its QUDT record into the vendored module — so every unit TVBO *reasons* about stays authoritative, and only what it *records* is open." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 4 ;
            sh:path qudt:unit ],
        [ sh:description "WHERE this parameter's value comes from — a curated entity's IRI, or a path (resolved against the declaring spec's directory when relative, as `Network.bids_dir` / `Network.data_file` are). The referent is typically a Network with per-node parameters (dscalar pattern), a binary store (HDF5, Zarr, TSV), or the CSV holding the array alone that a CSV save writes for a parameter whose ``measure`` names its path in the companion. Combine with `measure:` to pick one array out of a source that holds several. A sourced value is never inlined into generated code: it is resolved lazily and the backend reads it from storage, so an array of any size costs nothing in the spec or the emitted module. Mutually exclusive with `value:` (a YAML literal, which IS materialised) and with `producer:` (bytes that are computed rather than read). Distinct from the global `iri:` slot, which is reserved for ontology grounding." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path tvbo:source ],
        [ sh:class tvbo:Distribution ;
            sh:description "The distribution a dynamics or coupling parameter's value is drawn from. Sampled over space (the default `axis`), the parameter starts from one draw per run: one value per node, or, for a coupling parameter whose `shape` is the graph's `(n_nodes, n_nodes)`, one per connection on the network's edges in row order, every other entry keeping `value`. The draw is keyed by `execution.random_seed` unless the distribution declares its own `seed`, and two parameters under one seed draw independently, so each cell of an `execution.random_seed` axis draws its own start and the trials of one cell share it. Sampled per trial (`axis: trial`), each trial of an `n_trials` ensemble starts from its own draw instead. An algorithm that tunes the parameter starts from the draw. Sampled over time (`axis: time`), the parameter is a stochastic input redrawn at every integration step. Implies heterogeneous=true. A backend that cannot draw refuses the declaration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path tvbo:distribution ],
        [ sh:class tvbo:FunctionCall ;
            sh:description "HOW to compute this value, when it is derived rather than obtained — the callable that produces it, its arguments, and (via `output:`) which entry to take from a callable returning several named arrays. The callable resolves against the recipe's `code_source`. Use instead of `source:` for a value that is a deterministic function of the spec's own inputs (a mesh operator, a template matrix): declaring the producer keeps the spec the single source of truth, where pointing at a pre-built file would let the two drift apart silently — and would need a prep step run by hand before the spec could execute. The result is cached and invalidated by the artifact fingerprint, so it is computed once rather than per run. On a `Parameter` it produces the value; on an `Edge` it produces the whole template matrix, which is what lets a connectome or a discrete differential operator be declared rather than pre-built. Mutually exclusive with `value:`/`source:`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path tvbo:producer ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path skos:definition ],
        [ sh:description "Numeric, string, or boolean value, OR an array (nested list) for array-valued constants such as mode-coupling coefficient matrices. ScalarValue accepts any literal primitive type, allowing parameters to carry control flags (e.g., booleans) or symbolic placeholders alongside numeric defaults." ;
            sh:maxCount 1 ;
            sh:or ( [ ] [ ] ) ;
            sh:order 7 ;
            sh:path schema1:value ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:symbol ],
        [ sh:datatype xsd:string ;
            sh:description "The network parameter giving each entry of this vocabulary its parent, an entry of a coarser vocabulary: it holds one code per entry of this one, each a code into the vocabulary its own ``levels`` names, or ``-1`` for an entry with no parent. Declares a hierarchy of vocabularies, such as the regions of an atlas within its lobes. A name no network parameter carries, one without ``levels``, a count of codes other than this vocabulary's entry count, and a code outside the parent vocabulary are refused when the network is resolved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path tvbo:parent ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:defaultValue ],
        [ sh:datatype xsd:string ;
            sh:description "The shape of the parameter's array, as ``(n_nodes,)`` or ``(100, 3)``. A CSV save writes it for each array it links, since a file of rows does not say whether one column is a 1-D array." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path tvbo:shape ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether a value for this parameter must be supplied. Optional parameters (e.g. a generator's ``seed``) set this to false. Declaration metadata; unset means unconstrained." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path tvbo:required ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "The network parameter holding the vocabulary this parameter's values are codes into: value ``k`` is that vocabulary's entry ``k``, which is its ``value`` or the array its ``measure`` names. Declares a categorical attribute, such as each node's functional network on a ``node_template`` parameter, whose array runs over the nodes, beside the network parameter listing the networks' names. A name no network parameter carries is refused when the network is resolved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path tvbo:levels ],
        [ sh:class tvbo:Range ;
            sh:description "Per-element domain overrides for heterogeneous parameters. When specified, element_domains[i] overrides domain for element i during exploration auto-expansion. Length must match parameter shape (e.g., n_nodes for shape \"(n_nodes,)\"). If not set, all elements share the same domain." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path tvbo:element_domains ],
        [ sh:datatype xsd:boolean ;
            sh:description "One value per node of the network the parameter's owner runs on, rather than one shared value. Inside a templated subnetwork, every copy of the template gets its own value at the parameter's declared shape; without it, every copy holds the template's value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:heterogeneous ],
        [ sh:datatype xsd:float ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path tvbo:explored_values ],
        [ sh:datatype xsd:string ;
            sh:description "The NumPy dtype the parameter's array is held at (``float32``, ``int32``, ``|S15``) where it is read from a file, through ``source`` and ``measure``. A CSV does not record it, so a CSV save writes it for each array it links, and the array reads back at it; absent means float64. Distinct from ``datatype``, a schema range name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path tvbo:dtype ] ;
    sh:targetClass tvbo:DerivedParameter .

tvbo:Edge a sh:NodeShape ;
    rdfs:comment "An edge in a network. Three modes: explicit (source+target set, scalar parameters in YAML), template (no source/target, N×N matrix measure in HDF5), or produced (a `producer:` computes the whole matrix from the spec's own inputs, so no pre-built file is needed). All coexist in the same edges list." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Dynamics ;
            sh:description "Dynamics model for this edge. When specified, the edge has its own state variables and ODE (EdgeModel with f in ND.jl). Uses the same Dynamics class as nodes — state_variables define edge states, derived_variables define observables, output defines what is visible for plotting/analysis. The coupling_function on Coupling still defines how vertex outputs map to edge outputs for aggregation at vertices." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path tvbo:dynamics ],
        [ sh:datatype xsd:string ;
            sh:description "Data type the matrix is stored as in the companion file (template edges only), e.g. 'float32'. Absent — the default — stores it as computed, so a read returns what was written. Set it only to narrow deliberately: halving a measured connectome's file is a fair trade against its own measurement error, silently halving a computed operator is not." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:dtype ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Matrix entries carry weights (not just 0/1)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:weighted ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Path or name of the Network whose nodes define the source endpoints of this Edge. Symmetric counterpart to `target_network`. Together they let an Edge bridge any two Networks: both unset (within-Network edge), one set (this Network ↔ the named one), or both set (peer-to-peer projection between two other Networks). Accepts either an absolute IRI (peer Network) or the relative-path sentinel `parent` / `parent/parent` (cross-scale up/down via the Node.subnetwork hierarchy)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path tvbo:source_network ],
        [ sh:datatype xsd:float ;
            sh:description "Conduction delay (explicit edges, ms)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:delay ],
        [ sh:class tvbo:Event ;
            sh:description "Events attached to this edge (e.g., threshold-based line tripping)." ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path tvbo:events ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "All values >= 0" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:non_negative ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the edge is directed. If false, represents a symmetric/bidirectional connection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path tvbo:directed ],
        [ sh:class prov:Entity ;
            sh:description "WHERE + WHICH + SLICE for a template edge whose whole matrix is read rather than stored or computed: another network's layer, an analysis result, or a cohort member's own connectome (``used: {cohort: <id>, query: {...}, output: weight, reconcile: by_label}``). Inside a per-subject run a cohort reference resolves to that run's subject, which is what binds a model network to each subject's own connectivity. ``reconcile: by_label`` aligns the read matrix to this network's node order through its atlas aliases. Resolved lazily and never inlined, and it wins over a same-named layer in the companion file. Mutually exclusive with ``producer:``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path prov:used ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:parameters ],
        [ sh:datatype xsd:integer ;
            sh:description "Source node ID (set for explicit edges, absent for template edges)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:source ],
        [ sh:datatype xsd:string ;
            sh:description "Output variable from source node to use (e.g., 'x_out'). If not specified, uses first output variable from source dynamics. The alias `source_variable` is accepted (harmonized with the `*_variable` spelling used elsewhere, e.g. the stimulus event's `target_variable`)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path tvbo:source_var ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Unit for matrix values (template edges only)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:unit ],
        [ sh:datatype xsd:string ;
            sh:description "Input variable on target node to connect to (e.g., 'c_in'). If not specified, uses first coupling input from target dynamics. The alias `target_variable` is accepted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:target_var ],
        [ sh:class tvbo:FunctionCall ;
            sh:description "HOW to compute this value, when it is derived rather than obtained — the callable that produces it, its arguments, and (via `output:`) which entry to take from a callable returning several named arrays. The callable resolves against the recipe's `code_source`. Use instead of `source:` for a value that is a deterministic function of the spec's own inputs (a mesh operator, a template matrix): declaring the producer keeps the spec the single source of truth, where pointing at a pre-built file would let the two drift apart silently — and would need a prep step run by hand before the spec could execute. The result is cached and invalidated by the artifact fingerprint, so it is computed once rather than per run. On a `Parameter` it produces the value; on an `Edge` it produces the whole template matrix, which is what lets a connectome or a discrete differential operator be declared rather than pre-built. Mutually exclusive with `value:`/`source:`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:producer ],
        [ sh:class tvbo:Coupling ;
            sh:description "Coupling function for this edge, named by reference into 'network.coupling' or defined inline. If not provided, the edge takes the network's coupling." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path tvbo:coupling ],
        [ sh:datatype xsd:string ;
            sh:description "Path or name of the Network whose nodes define the target endpoints (e.g. the columns of a non-square projection matrix such as a gain matrix region → EEG sensors). Also accepts the relative-path sentinel `parent` / `parent/parent` for cross-scale signal flow up the Node.subnetwork hierarchy. One mechanism handles both projection matrices (absolute IRI) and multi-scale boundaries (sentinel)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path tvbo:target_network ],
        [ sh:datatype xsd:boolean ;
            sh:description "Self-connections are meaningful" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:valid_diagonal ],
        [ sh:datatype xsd:string ;
            sh:description "Ordered labels for the matrix columns (dim-1) when the matrix is non-square.  Row labels (dim-0) are the parent Network's node labels.  Stored as HDF5 dimension scales in the companion file." ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path tvbo:dimension_labels ],
        [ sh:description "Storage format in HDF5 (template edges only)" ;
            sh:in ( "dense" "csr" "coo" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path tvbo:format ],
        [ sh:datatype xsd:float ;
            sh:description "Connection weight (explicit edges)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:weight ],
        [ sh:description "Connectivity rule for a population-level Edge. When set, this Edge is a projection between the source and target population nodes (see Node.size); the backend expands it into the individual cell-to-cell connections (e.g. all_to_all -> size_src x size_tgt connections) so the user never enumerates them. When unset, the Edge is a single explicit connection between the source and target node indices (the original per-cell edge semantics)." ;
            sh:in ( "all_to_all" "one_to_one" "random" ) ;
            sh:maxCount 1 ;
            sh:order 21 ;
            sh:path tvbo:connectivity ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "For a self-projection (source and target are the same population) expanded under a connectivity rule, whether to include the diagonal i->i self connections. Ignored when the source and target populations differ." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path tvbo:allow_self_connections ],
        [ sh:datatype xsd:float ;
            sh:description "Edge length / tract distance (explicit edges, mm)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:distance ],
        [ sh:datatype xsd:string ;
            sh:description "The file holding this layer's matrix alone, relative to the sidecar (template edges only): the CSV ``save(binary_format=\"csv\")`` writes for it, read at the edge's ``dtype`` and in its sparse ``format``, a sparse matrix as one ``row column value`` line per stored entry. Unset beside an HDF5 or Zarr companion, which holds every layer under ``edges/<label>``, and an HDF5 or Zarr file here is refused." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:data_file ],
        [ sh:datatype xsd:integer ;
            sh:description "Target node ID (set for explicit edges, absent for template edges)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:target ] ;
    sh:targetClass tvbo:Edge .

tvbo:Exploration a sh:NodeShape ;
    rdfs:comment "Parameter space exploration (grid search, sweep)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Grid batch size for parameter exploration — how many sweep cells the backend evaluates as one vectorised chunk. ``auto`` (the default) vectorises the grid, bounded by a cell-count cap (``min(grid_size, 64)``, env ``TVBO_NVMAP_AUTO_CAP``) and a working-memory budget (env ``TVBO_NVMAP_MEM_BUDGET_GB``, default 2 GB) estimated from the per-cell output and live state: fast on every backend, and the memory budget keeps a large-per-cell grid (e.g. a whole-brain delay network) from inflating peak memory. Vectorising still holds ``n_vmap`` cells at once, so auto uses more working memory than a sequential run — the budget bounds it. An integer fixes the chunk size and bypasses both bounds (``1`` = fully sequential, minimal memory; a larger value trades memory for fewer, wider batches). Backends translate this into their own execution primitive (e.g. tvboptim's vmap chunk width) without exposing any backend-specific names in the schema." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:integer ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 12 ;
            sh:path tvbo:n_parallel ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:FunctionCall ;
            sh:description "Observable to compute at each point. Use function: obs_name for simple observation, or function: func_name + arguments for FunctionCall." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path tvbo:observable ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "grid" ;
            sh:description "Search strategy over the decision space (the `space` axes). 'grid' (default) exhaustively evaluates the Cartesian/zip grid of axis points — today's behaviour. 'nsga2' runs an adaptive multi-objective genetic search (pymoo NSGA-II) that returns the non-dominated Pareto front over `objectives`; axes then supply only decision-variable bounds (domain lo/hi), and per-strategy hyper-parameters (population_size, num_generations, seed, reference_point) live in `parameters`. Extensible later to 'random' / 'sobol' / 'cmaes'. Forward-compatible with the planned unified `Search.strategy`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:strategy ],
        [ sh:datatype xsd:string ;
            sh:description "Names of observations to compute and record at EACH grid point, stacked over the sweep into one array per name. Entries may be derived observations (e.g. `loss`) or `analysis` diagnostics (e.g. `ad_gradient`, `fd_gradient`, `lyapunov`) — this is how a sweep of the diagnostics themselves is declared, replacing any per-point Python driver. Complementary to `observable` (a single scalar reduction); when both are absent the full observation Bunch is recorded." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:record ],
        [ sh:defaultValue "independent" ;
            sh:description "How each sweep point's initial state is obtained. 'independent' (default) cold-starts every point from the model's initial values, so points are order-independent and may run in parallel (see parallel_mode). 'from_previous' seeds each point from the final state of the preceding point, so the trajectory follows the solution branch as the swept parameter changes quasi-statically; this forces sequential execution (a scan, not a vmap) and, with sweep_direction, exposes hysteresis / multistability. It is forward-integration branch following, not numerical continuation (cf. the Continuation class)." ;
            sh:in ( "independent" "from_previous" ) ;
            sh:maxCount 1 ;
            sh:order 18 ;
            sh:path tvbo:sweep_seeding ],
        [ sh:datatype xsd:string ;
            sh:description "Averaging mode across trials. 'trials' = average over n_trials independent runs (evoked potential paradigm). None = return all trials." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:average ],
        [ sh:datatype xsd:string ;
            sh:description "Names of observations minimised by an adaptive `strategy` (e.g. 'nsga2'). Each entry references an existing observation already framed lower-is-better (e.g. `one_minus_fc`, `psd_mae`). Count sets the semantics: 0 → pure sweep (use `record`), 1 → single-objective, ≥2 → multi-objective / Pareto. Ignored when strategy is 'grid'. Forward-compatible with `Search.objectives`." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:objectives ],
        [ sh:defaultValue "up" ;
            sh:description "Order in which a branch-following axis (sweep_seeding: from_previous) is traversed: 'up' increases the parameter once, 'down' decreases it once, 'bidirectional' increases then decreases over the same values and records both branches — a hysteresis loop where they differ. Ignored when sweep_seeding is 'independent'. Applies to a single swept axis." ;
            sh:in ( "up" "down" "bidirectional" ) ;
            sh:maxCount 1 ;
            sh:order 19 ;
            sh:path tvbo:sweep_direction ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:integer ;
            sh:description "Chunk size for ``lax_map`` and chunked-``vmap`` modes. ``1`` = strictly sequential (minimum memory). Larger values amortise compile overhead across trials at the cost of memory. Ignored when parallel_mode is ``vmap`` (which always uses the full n_trials axis)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path tvbo:parallel_batch_size ],
        [ sh:class tvbo:Parameter ;
            sh:description "Hyper-parameters of the exploration itself (e.g. tolerances, sampler settings, grid-refinement controls), keyed by name. Distinct from `space`, which defines what is being swept." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path tvbo:parameters ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class tvbo:ExecutionConfig ;
            sh:description "Per-exploration execution configuration (overrides experiment-level defaults). Useful for setting random_seed, n_workers for parallel grid search." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:execution ],
        [ sh:class tvbo:ExplorationAxis ;
            sh:description "Exploration axes spanning the search space, keyed by the dotted parameter reference each axis sweeps (e.g. \"ReducedWongWang.w\" or \"FastLinearCoupling.G\"). Insertion order is preserved and defines the grid axis order. Each axis references an existing Parameter and supplies the Range to sweep; no new Parameter is created here." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:space ],
        [ sh:description "How trial-axis parallelism is realised at codegen time. ``vmap`` batches all trials in parallel (fast, peak memory ~n_trials × per-trial working set). ``lax_map`` runs them sequentially via ``jax.lax.map`` (slower, peak memory bounded by one trial). ``pmap`` shards across devices for multi-GPU. ``auto`` (default) picks ``vmap`` when the estimated batched memory fits, ``lax_map`` otherwise." ;
            sh:in ( "auto" "vmap" "lax_map" "pmap" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path tvbo:parallel_mode ],
        [ sh:datatype xsd:string ;
            sh:description "Names of the experiment's algorithms (keys in `experiment.algorithms`) to run AT EACH exploration point, in order, BEFORE computing the observable. Explicitly wires algorithms into the exploration so per-point tuning / constraints are applied at every sweep point — e.g. FIC re-tuning J_i at each E/I ratio. With this set, the sweep evaluates the full algorithm→observation pipeline per point (executed sequentially), not a bare simulation. Empty/absent = bare simulation per point. This is the declarative replacement for any Python per-point driver: the composition is derived entirely from YAML metadata." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:algorithms ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "product" ;
            sh:description "Combination mode: 'product' (full grid), 'zip' (paired)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:mode ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Number of independent trials per grid point. Each trial uses a different noise seed, redraws the initial condition of every state variable that declares a distribution, and redraws the start of every parameter whose distribution declares `axis: trial`. Used for averaging stochastic simulations (e.g., VEP = average of 20 trials)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:n_trials ],
        [ sh:datatype xsd:integer ;
            sh:description "Streaming-fold granularity: how many integration steps form one block that is folded into a streaming reducer's carry in a single batched update (tvboptim's per-block fold; see the solver's block_size). Unset uses the backend default. A smaller block bounds the per-fold working memory of a heavy streaming reduction — e.g. a permutation-surrogate wave detector whose per-downsampled-frame cost is large — at the price of more blocks. It trades against n_parallel, which batches grid cells over the same device memory: the peak is ~ n_parallel × (block_size / downsample_period) × per-frame. Must be a whole number of the observation's downsample period. Backend-neutral; a backend without block streaming ignores it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:block_size ] ;
    sh:targetClass tvbo:Exploration .

tvbo:ExplorationAxis a sh:NodeShape ;
    rdfs:comment "One axis of a parameter exploration grid. Points to an existing Parameter (by dotted reference, e.g. \"ReducedWongWang.w\" or \"FastLinearCoupling.G\") and supplies the sweep specification (domain, explored_values, or per-element overrides). No new Parameter is created." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class tvbo:Range ;
            sh:description "Sweep range for this axis (lo, hi, n, step, log_scale)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:domain ],
        [ sh:class tvbo:Range ;
            sh:description "Per-element sweep overrides for heterogeneous parameters (e.g. shape \"(n_nodes,)\"). When set, element_domains[i] replaces the shared domain for element i." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:element_domains ],
        [ sh:datatype xsd:float ;
            sh:description "Explicit list of values to sweep (overrides domain)." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:explored_values ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:FunctionCall ;
            sh:description "Callable that generates this axis's swept values, as an alternative to domain / explored_values. Use when the points cannot be written as a static list because each is an array or depends on other results — e.g. per-count control-gain vectors g whose entries are chosen from a runtime-computed solitary-node ordering. The callable returns the stacked sweep values (leading axis = sweep points); its `arguments` may reference other observations by name. The value-supplying analogue of graph_generator.builder, keeping computed sweeps declarative rather than requiring a Python driver." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path tvbo:builder ],
        [ sh:class tvbo:AxisReduction ;
            sh:description "Optional marker to collapse this axis by a statistic in the result container instead of keeping it as a grid dimension. Use for an ensemble axis (e.g. `execution.random_seed`, a trial ensemble) so the reduced observation (mean/sem/…) becomes first-class. The named grid dim is reduced across every observation that carries it; observations without that dim are left untouched." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path tvbo:reduce ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "none" ;
            sh:description "Optional decode applied to this axis's value before it is bound to the referenced Parameter: 'none' (default) or 'log10' (the parameter is set to 10 ** value, so an adaptive strategy searches the raw bounds in log10 units — e.g. sigma searched over domain {lo: -2.0, hi: -0.5}). Distinct from a logarithmic grid *spacing*; this is an evaluation-time decode. Forward-compatible with the harmonised `Axis`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:transform ],
        [ sh:datatype xsd:string ;
            sh:description "Dotted reference to the quantity being swept; also the key of the enclosing `Exploration.space` collection. Format \"<scope>.<name>\", where <scope> is a Dynamics class name (e.g. \"ReducedWongWang.a\"), a coupling key (e.g. \"FastLinearCoupling.G\"), or one of the reserved scopes: \"network.\" for a connectome leaf (e.g. \"network.conduction_speed\", \"network.edges.weight\", \"network.edges.delay\"), \"execution.random_seed\" for a per-cell noise-seed ensemble, or \"initial_conditions.<state_var>\" to sweep the initial value of one state variable (a deterministic initial-condition ensemble). Resolved against the enclosing experiment at runtime." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:parameter ],
        [ sh:datatype xsd:string ;
            sh:description "Optional axis unit (defaults to the referenced Parameter's unit)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:unit ] ;
    sh:targetClass tvbo:ExplorationAxis .

tvbo:FreeParameter a sh:NodeShape ;
    rdfs:comment "One degree of freedom in an OptimizationStage. References an existing Parameter by dotted scope (e.g. \"ReducedWongWang.w\" or \"FastLinearCoupling.G\") and supplies optimization-specific metadata (heterogeneous, shape, bounds, initial value). No new Parameter is created here." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Parameter ;
            sh:description "Dotted reference to the Parameter to optimize. Format: \"<scope>.<param_name>\" where <scope> is either a Dynamics class name or a coupling key." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:parameter ],
        [ sh:datatype xsd:boolean ;
            sh:description "`true` fits one value per node where the parameter declares one scalar, and `false` one scalar where it declares one value per node. An entry fits its parameter at the parameter's own layout and writes `heterogeneous` or `shape` only to change it; an entry that writes the layout its parameter already declares is refused." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:heterogeneous ],
        [ sh:description "Optional initial value for the optimizer (overrides the referenced Parameter's value)." ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path tvbo:initial_value ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "The shape the parameter is fitted at, as a Python-tuple-style string (e.g. \"(n_nodes,)\" or \"(n_nodes, n_nodes)\"), written only to change the parameter's own layout; \"()\" fits one scalar." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:shape ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Range ;
            sh:description "Optional bounds (lo, hi) for constrained optimization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:domain ] ;
    sh:targetClass tvbo:FreeParameter .

tvbo:Graph a sh:NodeShape ;
    rdfs:comment "A node-link panel's graph and how it is drawn: the connectome the model actually ran on, with a state living on it. The geometry is the network's own — one marker per region at its anatomical centre — and a layer supplies one value per region, placed by label." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Outline colour of the region markers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:node_edge_color ],
        [ sh:datatype xsd:string ;
            sh:description "The network whose nodes and edges are drawn, as a curated IRI (`tvbo:DesikanKilliany`) or a path beside the study. Required: the panel draws the network, not the result." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:connectome ],
        [ sh:datatype xsd:float ;
            sh:description "Marker size for the regions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:node_size ],
        [ sh:datatype xsd:float ;
            sh:description "The value the scale ends at. See `vmin`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:vmax ],
        [ sh:datatype xsd:float ;
            sh:description "The value the scale starts at. A declared end is honoured as given; the other is still derived from the data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:vmin ],
        [ sh:datatype xsd:string ;
            sh:description "One flat colour for every node, for a panel whose subject is the network rather than a state on it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:color ],
        [ sh:datatype xsd:float ;
            sh:description "Keep only edges above this percentile of the weights. A dense connectome drawn whole is a filled square, not a graph." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:edge_percentile ],
        [ sh:description "Which plane the region centres flatten onto." ;
            sh:in ( "axial" "coronal" "sagittal" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path tvbo:projection ],
        [ sh:datatype xsd:string ;
            sh:description "The scale, as a key of the theme's `colormaps` (`sequential`, `diverging`, or one a project added) or a name the backend knows. Unset takes the theme's `sequential`, or its `diverging` where the scale is centred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:colormap ],
        [ sh:datatype xsd:float ;
            sh:description "Base line weight of the connections; the drawn widths scale with the weight, so a strong connection reads as strong." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:edge_width ],
        [ sh:datatype xsd:float ;
            sh:description "Outline weight of the region markers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:node_edge_width ],
        [ sh:datatype xsd:float ;
            sh:description "Opacity of those connections." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:edge_alpha ],
        [ sh:datatype xsd:string ;
            sh:description "Colour of the connections that survive `edge_percentile`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:edge_color ],
        [ sh:datatype xsd:boolean ;
            sh:description "Annotate each node with its region name. Off by default — 87 names on one panel is a block of text, not a figure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:labels ],
        [ sh:datatype xsd:boolean ;
            sh:description "Centre the limits on zero, so zero is the map's midpoint. What a field of signed deviations needs — read on an off-centre scale it is misleading in a way no axis label catches." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:symmetric ],
        [ sh:datatype xsd:float ;
            sh:description "Clip the limit to this percentile of the values (100 = no clipping), so one outlier region cannot wash the whole map out. Applies whether or not the scale is centred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:percentile ] ;
    sh:targetClass tvbo:Graph .

tvbo:Grid a sh:NodeShape ;
    rdfs:comment """How a `grid` panel tiles its cells, and what the strips around them are labelled with. Rows and columns are labelled ONCE, at the left and the top — the whole reason a paper's composite panel is one lettered panel rather than n of them.

The reserved label strips are taken out of the drawable area, so declaring one shrinks the cells to make room instead of being drawn over them. The axis labels the cells SHARE are the panel's own `xlabel`/`ylabel`, one word at two levels, not slots of this object.

A directive that varies down the rows or across the columns is still written as `row.<name>` / `col.<name>` in `opts`: it supplies one value per row or column of ANY directive, so it cannot be a fixed slot of anything.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Strip reserved at the right — what cells carrying their ticks on that side need, or their labels are drawn over the panel next door." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:right ],
        [ sh:datatype xsd:float ;
            sh:description "Gap between columns, as a fraction of the panel. A value approaching the cell width collapses the cells rather than separating them." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:wspace ],
        [ sh:datatype xsd:integer ;
            sh:description "Cells per row. Unset puts every cell in one row." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:ncols ],
        [ sh:datatype xsd:float ;
            sh:description "Type size of the column headings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:col_label_size ],
        [ sh:datatype xsd:float ;
            sh:description "Gap between rows, in the same fraction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:hspace ],
        [ sh:datatype xsd:string ;
            sh:description "One heading per column, written just above the cells rather than at the panel's own top, so it keeps reading as belonging to its column." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:col_labels ],
        [ sh:datatype xsd:string ;
            sh:description "Text written in the gap BEFORE each cell, which is what turns a row of maps into a paper's decomposition equation." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:between ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation of the row headings, in degrees." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:row_label_rotation ],
        [ sh:datatype xsd:float ;
            sh:description "Gap between a column heading and the cells under it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:col_label_pad ],
        [ sh:datatype xsd:float ;
            sh:description "Strip reserved at the top for the column labels." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:top ],
        [ sh:datatype xsd:string ;
            sh:description "Text written after the last cell, closing such an equation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:trailing ],
        [ sh:datatype xsd:integer ;
            sh:description "Rows to fill. Unset holds every cell, so declaring only `ncols` wraps rather than drops; an explicit value still crops the extras, deliberately." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:nrows ],
        [ sh:datatype xsd:float ;
            sh:description "Strip reserved at the left for the row labels, as a fraction of the panel." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:left ],
        [ sh:datatype xsd:float ;
            sh:description "Strip reserved at the bottom for the cells' tick labels or a shared axis label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:bottom ],
        [ sh:datatype xsd:string ;
            sh:description "One heading per row, in the reserved left strip." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:row_labels ] ;
    sh:targetClass tvbo:Grid .

tvbo:InitialState a sh:NodeShape ;
    rdfs:comment "How a run obtains its starting state. A continuation starts by time_integration, given or newton, the same on every continuation backend, and refuses any other method by name." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:defaultValue "1e-10"^^xsd:float ;
            sh:description "Relative tolerance for ODE integration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:rel_tol ],
        [ sh:class tvbo:Solver ;
            sh:description "ODE solver of the time_integration settle, by method and step or tolerances. A continuation backend integrates by it or refuses it by name: bifurcationkit takes any DifferentialEquations.jl solver (Tsit5, Rodas5), auto-07p a SciPy one (Dopri5, LSODA, BDF) or a fixed-step method at a step_size, and pyrates-bifurcation none, since it settles by AUTO-07p's own initial-value run. Undeclared, each settles by its own default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:solver ],
        [ sh:datatype xsd:string ;
            sh:description "Name of a previously computed branch, for the from_branch method, which no continuation backend implements (InitialStateMethod.from_branch)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:source_branch ],
        [ sh:defaultValue "time_integration" ;
            sh:description "Strategy for finding the initial state." ;
            sh:in ( "time_integration" "newton" "given" "from_branch" "from_working_point" "from_experiment" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path tvbo:method ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "2000.0"^^xsd:float ;
            sh:description "Integration duration for time_integration method, the same on every continuation backend." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:duration ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1e-10"^^xsd:float ;
            sh:description "Absolute tolerance: of the integration for time_integration, of the relative step at which newton has converged, and of the right-hand side a given state may leave in any component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:abs_tol ],
        [ sh:class tvbo:ExplorationAxis ;
            sh:description "For method=from_working_point: the parameter + domain to ramp quasi-statically (warm-start, from_previous) to reach the working point; the run then seeds from the ramp endpoint. Reuses ExplorationAxis (parameter + Range domain) — the same primitive an Exploration warm-start uses; the per-step settle comes from the experiment's integration (transient, else duration)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:ramp ],
        [ sh:datatype xsd:string ;
            sh:description "Which point of the source branch/run seeds this run: 'endpoint' (default, the last recorded point), a step number, 'hopf:1', 'fold:2', etc. — a single operating point. The special value 'branch' instead selects the WHOLE recorded branch: every recorded point becomes one cell of this experiment's exploration, seeded from that point's swept-parameter value and settled state. That turns a sequential branch (e.g. a from_previous warm-start scan) into an independent, parallel per-point restart analysis — Lyapunov spectra, Jacobian/Floquet eigenvalues, basin sampling, perturbation kicks, first-passage — that shards across a cluster. The consuming exploration declares one axis (the source's swept parameter) with no domain; its values come from the branch, keeping the source run as the single source of truth for which points exist." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:source_point ],
        [ sh:class tvbo:SimulationExperiment ;
            sh:description "For method=from_experiment: the experiment whose settled per-node endpoint state seeds this run (its operating point). Referenced by identifier (id); the referenced run's saved final state is loaded as this run's initial condition, with source_point selecting which settled point (default 'endpoint'). Lets a control/perturbation experiment start from a working point another experiment already reached, without recomputing its warm-start ramp — a declarative data dependency the workflow engine can order." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:source_experiment ] ;
    sh:targetClass tvbo:InitialState .

tvbo:Layer a sh:NodeShape ;
    rdfs:comment "One mark bound to one data reference, with its encoding." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Optional presentation-only reduction. Prefer declaring an Observation upstream; else name a declarative postprocessing (tvbo schema) or a registered callable fn(da)->da." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:transform ],
        [ sh:description "Fill only this triangle of a square matrix, masking the other half so a sibling layer fills it. Two layers then compose one matrix image whose halves are the quantities being compared." ;
            sh:in ( "lower" "upper" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path tvbo:triangle ],
        [ sh:class tvbo:Style ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path tvbo:style ],
        [ sh:class tvbo:Encoding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:encoding ],
        [ sh:datatype xsd:string ;
            sh:description "Legend entry for this layer. Needed whenever a panel's legend distinguishes layers rather than entries along a `color` dim, which supplies its own labels. Without it a layer is drawn but unnamed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:label ],
        [ sh:description "Cartesian mark; omitted for heatmap panels (implied by the panel kind)." ;
            sh:in ( "line" "scatter" "rule" "band" "errorbar" "area" "bar" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path tvbo:mark ],
        [ sh:description "This layer's part in an animation: whether it advances with the frame, stays whole, or draws the cursor that marks the current frame. Ignored by a still figure." ;
            sh:in ( "slice" "static" "cursor" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path tvbo:frame ],
        [ sh:class prov:Entity ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path prov:used ] ;
    sh:targetClass tvbo:Layer .

tvbo:Legend a sh:NodeShape ;
    rdfs:comment """A panel's key: whether it is drawn, where it sits, and the three things a figure actually asks of one beyond that. An object rather than a bare position because `frame` had nowhere to live — the renderer drew every key frameless whatever the theme said, so a theme asking for a boxed legend never got one.

The shorthands are the same slot: `legend: true` is `{show: true}` and `legend: upper right` is `{loc: upper right}`, expanded on load, so a panel that starts with a corner and later needs two columns keeps the word it had.

Distinct from `kind: legend`, which is a standalone legend PANEL occupying a cell of the mosaic and sharing no axes with anything.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Which corner the key sits in. Unset lets the backend choose." ;
            sh:in ( "best" "upper right" "upper left" "lower left" "lower right" "right" "center left" "center right" "lower center" "upper center" "center" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path tvbo:loc ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether to draw the key. Unset means yes: declaring the slot at all is the request, and `show: false` is how a shared theme's legend is switched off for one panel without deleting what it says." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:show ],
        [ sh:datatype xsd:string ;
            sh:description "One colour per entry of a standalone legend, as a palette role, a hue or any colour the backend reads." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:colors ],
        [ sh:datatype xsd:string ;
            sh:description "One marker per entry of a standalone legend, for a key whose entries are scatter marks." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:markers ],
        [ sh:datatype xsd:string ;
            sh:description "A heading above the entries, for the case where the labels alone do not say what varies between them." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:title ],
        [ sh:datatype xsd:string ;
            sh:description "What each entry of a standalone legend is drawn as: `line`, `marker`, or `patch`, a filled swatch for a key to coloured areas such as regions on a brain map. Unset, an entry is a line, carrying its marker where one is given." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:handles ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the key is boxed. Unset takes the theme's `legend_frame`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:frame ],
        [ sh:datatype xsd:string ;
            sh:description "The entries of a STANDALONE `kind: legend` panel, named outright. A panel-attached key takes its entries from the marks it belongs to instead." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:labels ],
        [ sh:datatype xsd:float ;
            sh:description "Length of each entry's sample line." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:handle_length ],
        [ sh:datatype xsd:string ;
            sh:description "One dash pattern per entry of a standalone legend." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:linestyles ],
        [ sh:datatype xsd:integer ;
            sh:description "How many columns the entries are laid out in. A wide panel with six short labels reads better as one row than as a six-deep column over the data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:columns ] ;
    sh:targetClass tvbo:Legend .

tvbo:Parcellation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Atlas> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:atlas ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:data_source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass tvbo:Parcellation .

tvbo:ProcedureStep a sh:NodeShape ;
    rdfs:comment """A single named step (or output) in a Procedure: one typed operation producing one named intermediate.
`type` selects the operation and therefore which of the fields below apply; it defaults to `equation`, the general case, so a Procedure written purely as equations needs no type annotations. The remaining fields carry each operation's options as *metadata* rather than as call syntax, which is what lets a step lower directly to a backend-native primitive: expression parsing cannot represent keyword arguments at all, so any option written as one would be unresolvable.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Value written onto the diagonal of a `pairwise_distance` result, e.g. infinity to suppress self-connections. Omitted leaves the true zero self-distance in place." ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path tvbo:diagonal ],
        [ sh:datatype xsd:integer ;
            sh:description "Array axis a `normalize` step reduces over (0 = columns)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:axis ],
        [ sh:defaultValue "le" ;
            sh:description "Comparison a `stochastic_mask` applies between `of` and the draw." ;
            sh:in ( "le" "lt" "ge" "gt" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path tvbo:comparison ],
        [ sh:defaultValue "equation" ;
            sh:description "Which operation this step performs. Defaults to `equation`." ;
            sh:in ( "equation" "pairwise_distance" "distribution_pdf" "sample" "stochastic_mask" "normalize" "minmax_rescale" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path tvbo:type ],
        [ sh:class tvbo:Distribution ;
            sh:description "Distribution sampled by a `sample` / `stochastic_mask` step, or whose density a `distribution_pdf` step evaluates. Reuses the Distribution class, so a generator's randomness is declared exactly like any other sampled quantity in TVBO. On a `sample` step it is the family the generator defaults to, which the parameter named by `of` overrides when one is supplied." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:distribution ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the input this step consumes — the positions for `pairwise_distance` / `distribution_pdf`, the matrix for `normalize`, the compared quantity for `stochastic_mask`, and for `sample` (which consumes no array) the Distribution-valued generator parameter to draw from. It names either a previously defined step or a generator parameter; steps are ordered, so a referenced step must already be defined." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:of ],
        [ sh:class tvbo:Range ;
            sh:description "Target interval for a `minmax_rescale` step (e.g. lo -1, hi 1)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path tvbo:target_range ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:integer ;
            sh:description "Sub-stream this step draws from, offset from the generator's seed. Two seeded steps must use different offsets to be independent. Stated here rather than inferred from step order so it is a property of the generator that every backend derives identically (numpy re-seeds, jax folds the offset into the key) — and so inserting or reordering steps cannot silently change an existing generator's output." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:seed_offset ],
        [ sh:class tvbo:Equation ;
            sh:description "The equation defining this step/output. Used by `equation` steps (and by every output expression)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:equation ] ;
    sh:targetClass tvbo:ProcedureStep .

tvbo:Region a sh:NodeShape ;
    rdfs:comment "A rectangle drawn over a panel to ring the window a paper calls out — the parameter band a regime lives in, the interval a statistic was taken over. Declared rather than drawn by a custom callable, so the window a figure highlights is part of the spec that can be read back." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The outline's colour, as a palette role, a hue, or any colour the backend reads." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:color ],
        [ sh:datatype xsd:boolean ;
            sh:description "Fill the rectangle rather than outlining it. A filled region sits under the data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:fill ],
        [ sh:datatype xsd:float ;
            sh:description "Opacity of the fill, 0-1. Ignored when `fill` is unset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:opacity ],
        [ sh:datatype xsd:float ;
            sh:description "[x0, x1, y0, y1] in data coordinates." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:bounds ] ;
    sh:targetClass tvbo:Region .

tvbo:Rule a sh:NodeShape ;
    rdfs:comment "A straight reference line drawn across a panel: the zero a signal is measured from, the threshold a value has to clear, the agreement line of a target-versus-simulated plot. One object, so the line and the colour it is drawn in cannot be stated apart — as two loose panel options they could disagree, and a colour could be given to a rule that was never declared." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Legend entry for the rule. Unset draws it without one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:label ],
        [ sh:datatype xsd:string ;
            sh:description "The rule's colour, as a palette role (`muted`), a hue (`palette.2`), or any colour the backend reads. A rule is scaffolding, so `muted` is usually what it wants." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:color ],
        [ sh:datatype xsd:float ;
            sh:description "Where the rule sits: one value for a horizontal or vertical rule, `[slope, intercept]` for a diagonal one." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:at ],
        [ sh:datatype xsd:float ;
            sh:description "Line weight in points. Unset takes the theme's `line_width`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:width ],
        [ sh:description "`horizontal` and `vertical` take a single `at`; `diagonal` takes `[slope, intercept]`, which is the only way to draw the identity line `[1, 0]` a target-versus-simulated panel is read against." ;
            sh:in ( "horizontal" "vertical" "diagonal" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path tvbo:orientation ],
        [ sh:datatype xsd:string ;
            sh:description "Dash pattern (`solid`, `dashed`, `dotted`, `dashdot`). A reference line is conventionally dashed, so it is not read as data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:dash ] ;
    sh:targetClass tvbo:Rule .

tvbo:StateValue a sh:NodeShape ;
    rdfs:comment "A named state variable value for per-node initialization." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Numeric, string, or boolean value, OR an array (nested list) for array-valued constants such as mode-coupling coefficient matrices. ScalarValue accepts any literal primitive type, allowing parameters to carry control flags (e.g., booleans) or symbolic placeholders alongside numeric defaults." ;
            sh:maxCount 1 ;
            sh:or ( [ ] [ ] ) ;
            sh:order 1 ;
            sh:path schema1:value ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass tvbo:StateValue .

tvbo:Stimulus a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:defaultValue "1000.0"^^xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:duration ],
        [ sh:class tvbo:Noise ;
            sh:description "Optional stochastic contribution to the stimulus. Mirrors state_variables.noise on the Dynamics side. The stimulus value at each integration step is the sum of `equation`'s evaluation (deterministic, if set) and a draw from this Noise process. When only `noise` is set and `equation` is absent, the stimulus IS the noise (pure stochastic source — e.g. iid uniform driver for memory-capacity benchmarks; signal+noise paradigms for psychophysics)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:noise ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:integer ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:regions ],
        [ sh:datatype xsd:string ;
            sh:description "Add the location of the data file containing the parcellation terminology." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path tvbo:parameters ],
        [ sh:datatype xsd:float ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:weighting ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rdfs:label ],
        [ sh:class tvbo:Equation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path tvbo:Equation ] ;
    sh:targetClass tvbo:Stimulus .

tvbo:Surface a sh:NodeShape ;
    rdfs:comment "A cortical surface panel's geometry and how a field is painted on it. One object, so the three mutually exclusive places a mesh can come from — a tvbo `Network` carrying one, a mesh file, or a named template — sit together with the options that only apply to each, instead of being loose names that could be given in any combination." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Read the layer as (V, 3) vertex COORDINATES rather than as a field: what the panel then shows is the surface a reconstruction rebuilt, not a quantity living on a fixed one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:geometry ],
        [ sh:datatype xsd:string ;
            sh:description "Draw the triangulation in this colour, for a panel whose subject is the mesh the model is solved on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:edge_color ],
        [ sh:datatype xsd:string ;
            sh:description "The atlas to read vertex labels from, where it differs from the one the values are keyed by." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:surface_atlas ],
        [ sh:datatype xsd:string ;
            sh:description "The parcellation the layer's per-region values are placed through, BY LABEL — a per-region array ordered differently would otherwise paint every region with its neighbour's number and still look like a brain." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:atlas ],
        [ sh:datatype xsd:string ;
            sh:description "The scale, as a key of the theme's `colormaps` (`sequential`, `diverging`, or one a project added) or a name the backend knows. Unset takes the theme's `sequential`, or its `diverging` where the scale is centred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:colormap ],
        [ sh:description "Where the camera sits." ;
            sh:in ( "lateral" "medial" "dorsal" "ventral" "anterior" "posterior" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path tvbo:view ],
        [ sh:datatype xsd:string ;
            sh:description "Draw the mesh itself in one flat colour instead of painting a map on it. With no layer, that is the bare geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:color ],
        [ sh:datatype xsd:string ;
            sh:description "A tvbo `Network` whose companion carries a mesh group. Geometry belongs to the network, so a study that has one needs no mesh file beside it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:connectome ],
        [ sh:datatype xsd:string ;
            sh:description "A named template surface (`fsaverage`), fetched rather than committed, so a parcellated map needs no mesh checked in beside the page." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:template ],
        [ sh:datatype xsd:float ;
            sh:description "The value the scale starts at. A declared end is honoured as given; the other is still derived from the data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:vmin ],
        [ sh:datatype xsd:string ;
            sh:description "A per-vertex 0/1 file. Vertices OUTSIDE it — a medial wall — are drawn grey and kept out of the colour range rather than coloured as zeros." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:mask ],
        [ sh:description "Which hemisphere to draw (`left`, `right`, or `both` joined into one mesh — what a paper prints for a dorsal view). Applies only to `template`. The vocabulary is the schema's own, shared with everything else that names a hemisphere." ;
            sh:in ( "left" "right" "both" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path tvbo:hemi ],
        [ sh:datatype xsd:float ;
            sh:description "Line weight of the triangulation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:edge_width ],
        [ sh:datatype xsd:string ;
            sh:description "The colour of the atlas regions the layer carries no value for, so a region a map leaves out on purpose, such as the target the mapped quantity is measured in, reads apart from the medial wall and the rest of the mesh no region covers, which stay the base grey. Only with `atlas:`; unset, both are grey." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:missing_color ],
        [ sh:datatype xsd:boolean ;
            sh:description "Centre the limits on zero, so zero is the map's midpoint. What a field of signed deviations needs — read on an off-centre scale it is misleading in a way no axis label catches." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:symmetric ],
        [ sh:datatype xsd:float ;
            sh:description "The value the scale ends at. See `vmin`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path tvbo:vmax ],
        [ sh:datatype xsd:string ;
            sh:description "The mesh file's format, where the extension does not say." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:mesh_format ],
        [ sh:datatype xsd:string ;
            sh:description "A surface mesh file — GIFTI, VTK, FreeSurfer, or an `.npz` holding `vertices`/`faces` for a mesh an analysis derived rather than measured." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:mesh ],
        [ sh:datatype xsd:string ;
            sh:description "The template's vertex density (`164k`). Applies only to `template`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:density ],
        [ sh:datatype xsd:float ;
            sh:description "Clip the limit to this percentile of the values (100 = no clipping), so one outlier region cannot wash the whole map out. Applies whether or not the scale is centred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path tvbo:percentile ] ;
    sh:targetClass tvbo:Surface .

tvbo:Theme a sh:NodeShape ;
    rdfs:comment "A project's whole look in one declarable object: its colours (inherited from `Palette`), the geometry a style sheet used to own — tick shape, axis weight, line weights, legend, grid, type — and the rule its axes follow: who places the ticks, where an axis ends, which spines are drawn and whether they meet. Declared on a study (`SimulationStudy.theme`) it is the one rule every figure of that study is drawn by; declared on a figure it states only that figure's differences. Either way it beats every layer in `Figure.style`, so a look a spec states cannot be quietly overridden by a sheet underneath it. It is the reason a study need not ship a `.mplstyle`: a sheet is a backend's vocabulary written outside the spec, where nothing validates it and no other backend can read it. TVB-O's own is curated at `tvbo:themes/default`; a project names that in `iri` and states only what it changes, exactly as an `Observation` or a `Coupling` reuses a curated one. A slot left unset is not a value — the layer underneath keeps it, so a theme states the look it means to fix and nothing else." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Weight of a panel title." ;
            sh:in ( "normal" "bold" ) ;
            sh:maxCount 1 ;
            sh:order 24 ;
            sh:path tvbo:title_weight ],
        [ sh:description "The case panel letters are drawn in, whatever case the mosaic keys were typed in. Unset draws each key as typed." ;
            sh:in ( "lower" "upper" ) ;
            sh:maxCount 1 ;
            sh:order 46 ;
            sh:path tvbo:panel_number_case ],
        [ sh:datatype xsd:string ;
            sh:description "Standard lines, bars and markers, wherever the colour carries no meaning. Leads the cycler." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 74 ;
            sh:path tvbo:base ],
        [ sh:datatype xsd:boolean ;
            sh:description "Write an axis's shared exponent as a power of ten (x10^-3 typeset) rather than in E notation (1e-3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path tvbo:exponent_as_power ],
        [ sh:datatype xsd:string ;
            sh:description "The typefaces to set text in, most-wanted first (`[Helvetica, Arial, DejaVu Sans]`). A generic family (`sans-serif`, `serif`, `monospace`) as the first entry selects that family outright; otherwise the list is taken as the concrete faces to try within `sans-serif`, which is how a person means it." ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path tvbo:font_family ],
        [ sh:datatype xsd:float ;
            sh:description "Length of a major tick mark, in points. The default for a panel's own `tick_length`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:tick_length ],
        [ sh:description "Weight of a panel letter." ;
            sh:in ( "normal" "bold" ) ;
            sh:maxCount 1 ;
            sh:order 50 ;
            sh:path tvbo:panel_number_weight ],
        [ sh:datatype xsd:boolean ;
            sh:description "End each of the left and bottom spines on its outermost ticks instead of running it the full length of the axis. Ignored on a boxed frame." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path tvbo:spine_trim ],
        [ sh:datatype xsd:string ;
            sh:description "Text, spines and ticks: the near-black everything is read against." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 73 ;
            sh:path tvbo:ink ],
        [ sh:description "How a drawn line ends." ;
            sh:in ( "butt" "round" "projecting" ) ;
            sh:maxCount 1 ;
            sh:order 53 ;
            sh:path tvbo:line_cap ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the box around a legend." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:legend_frame ],
        [ sh:description "Whether tick marks point out of the axes, into them, or both." ;
            sh:in ( "out" "in" "inout" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path tvbo:tick_direction ],
        [ sh:datatype xsd:float ;
            sh:description "Line weight of the outline of a bar or any other filled patch, in points." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 52 ;
            sh:path tvbo:bar_edge_width ],
        [ sh:datatype xsd:float ;
            sh:description "Size of a panel title as a multiple of the body size. Unset draws it at the body size." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path tvbo:title_scale ],
        [ sh:datatype xsd:float ;
            sh:description "Default marker size, in points, for any layer whose own style does not fix one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:marker_size ],
        [ sh:datatype xsd:float ;
            sh:description "Whitespace left around the content when trimming, in inches. The default for a figure's own `pad`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 64 ;
            sh:path tvbo:pad ],
        [ sh:datatype xsd:boolean ;
            sh:description "Save figures with a transparent page instead of the `background` colour." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 66 ;
            sh:path tvbo:transparent ],
        [ sh:datatype xsd:float ;
            sh:description "Size of a panel letter as a multiple of the body size. A figure's own `panel_number_size`, in points, wins over it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 49 ;
            sh:path tvbo:panel_number_scale ],
        [ sh:datatype xsd:float ;
            sh:description "Default weight of a drawn line, in points, for any layer whose own style does not fix one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:line_width ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the caps on an error bar, in points. 0 draws none." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 54 ;
            sh:path tvbo:errorbar_cap_size ],
        [ sh:datatype xsd:boolean ;
            sh:description "Keep text as text in vector output (embedded TrueType in PDF and PostScript, live text in SVG), so a typesetter can edit a label instead of receiving outlines." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 67 ;
            sh:path tvbo:editable_text ],
        [ sh:datatype xsd:integer ;
            sh:description "The most ticks a `round` axis carries. Unset is 4. A panel that states its own `nbins` keeps the backend's locator on that budget instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path tvbo:max_ticks ],
        [ sh:datatype xsd:float ;
            sh:description "Distance from a legend to the axes it sits against, in font-size units." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:legend_pad ],
        [ sh:description "The typeface mathematical text is set in." ;
            sh:in ( "dejavusans" "dejavuserif" "cm" "stix" "stixsans" ) ;
            sh:maxCount 1 ;
            sh:order 27 ;
            sh:path tvbo:math_font ],
        [ sh:datatype xsd:string ;
            sh:description "The single emphasis colour, kept out of the cycler so it never lands on a panel by accident." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 76 ;
            sh:path tvbo:highlight ],
        [ sh:datatype xsd:float ;
            sh:description "Size of a tick number as a multiple of the body size. Unset draws it at the body size." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path tvbo:tick_label_scale ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the grid and the ticks beneath the data rather than over it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 61 ;
            sh:path tvbo:grid_below ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw tick marks on the top and right sides of a boxed frame as well as on the two that carry the numbers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path tvbo:mirror_ticks ],
        [ sh:datatype xsd:float ;
            sh:description "Line weight of the axes grid, in points. Ignored unless `grid_lines` is set." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 59 ;
            sh:path tvbo:grid_width ],
        [ sh:datatype xsd:float ;
            sh:description "Distance from a panel title to the axes, in points." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:title_pad ],
        [ sh:datatype xsd:boolean ;
            sh:description "Put a colour bar's ticks at the two ends of its range and at its centre (at zero where the range crosses it), each written in full, instead of on the round values inside it. A bar whose panel declares `colorbar_ticks` keeps those." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 42 ;
            sh:path tvbo:colorbar_ends ],
        [ sh:datatype xsd:float ;
            sh:description "How far the left and bottom spines sit outside the data area, in axes fractions. 0 makes them meet at the origin; a small value separates them. The default for a figure's own `spine_offset`. Ignored on a boxed frame." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path tvbo:spine_offset ],
        [ sh:class tvbo:Colormaps ;
            sh:description "The continuous scales, so both kinds of colour move together and no figure names a colormap of its own." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 79 ;
            sh:path tvbo:colormaps ],
        [ sh:datatype xsd:float ;
            sh:description "Space between a legend's sample and its text, in font-size units." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 57 ;
            sh:path tvbo:legend_handle_text_pad ],
        [ sh:datatype xsd:string ;
            sh:description "The class a file holds, as a CURIE (``tvbo:Network``) — the envelope `Document` declares." ;
            sh:in ( "tvbo:Theme" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 71 ;
            sh:path tvbo:tvbo_class ;
            sh:pattern "^tvbo:[A-Z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the frame around a colour bar." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 43 ;
            sh:path tvbo:colorbar_outline ],
        [ sh:description "The curated theme this one starts from (`tvbo:themes/default`). Its slots are merged under this document's own, so a theme states only its differences." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:description "Where a panel title sits along the top of its axes." ;
            sh:in ( "left" "center" "right" ) ;
            sh:maxCount 1 ;
            sh:order 25 ;
            sh:path tvbo:title_loc ],
        [ sh:datatype xsd:float ;
            sh:description "Body type size in points, for every figure that states none of its own. A figure whose print size differs from its siblings' still fixes its own `font_size`, which wins." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:font_size ],
        [ sh:datatype xsd:float ;
            sh:description "Line weight of a minor tick mark, in points. Ignored unless `minor_ticks` is set." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:minor_tick_width ],
        [ sh:datatype xsd:boolean ;
            sh:description "Write a negative number with a true minus sign rather than a hyphen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path tvbo:unicode_minus ],
        [ sh:description "Where an automatically scaled axis ends relative to its ticks. Unset is `data`: no limit moves. An axis whose limits or ticks a panel declares, or that frames an image, keeps its limits whatever this says." ;
            sh:in ( "data" "ticks" "near" ) ;
            sh:maxCount 1 ;
            sh:order 34 ;
            sh:path tvbo:axis_ends ],
        [ sh:datatype xsd:float ;
            sh:description "Length of a legend's sample line, in font-size units." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:legend_handle_length ],
        [ sh:datatype xsd:float ;
            sh:description "Line weight of the axes frame, in points. A figure whose spines are heavier than its data is drawn the wrong way round." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:axis_width ],
        [ sh:datatype xsd:float ;
            sh:description "Line weight of a marker's outline, in points." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 51 ;
            sh:path tvbo:marker_edge_width ],
        [ sh:datatype xsd:string ;
            sh:description "Hairlines and de-emphasised strokes: present, and not competing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 75 ;
            sh:path tvbo:muted ],
        [ sh:description "Who places the ticks of an axis nobody placed ticks on. Unset is `native`: nothing moves. A panel's own `xticks`/`yticks`, its `nbins`, and the ticks a custom drawer fixed always stand, whatever this says." ;
            sh:in ( "native" "round" "declared" ) ;
            sh:maxCount 1 ;
            sh:order 31 ;
            sh:path tvbo:ticks ],
        [ sh:description "Which sides of the axes frame are drawn. The default for a figure's own `spines`." ;
            sh:in ( "open" "box" ) ;
            sh:maxCount 1 ;
            sh:order 38 ;
            sh:path tvbo:spines ],
        [ sh:datatype xsd:float ;
            sh:description "Distance from a tick mark to its label, in points." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:tick_pad ],
        [ sh:datatype xsd:string ;
            sh:description "Output format (pdf, svg, png). The default for a figure's own `format`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 65 ;
            sh:path tvbo:format ],
        [ sh:description "Which layout engine positions the panels. The default for a figure's own `layout_engine`." ;
            sh:in ( "constrained" "compressed" "tight" "none" ) ;
            sh:maxCount 1 ;
            sh:order 68 ;
            sh:path tvbo:layout_engine ],
        [ sh:description "Dash pattern of the axes grid. Ignored unless `grid_lines` is set." ;
            sh:in ( "solid" "dashed" "dotted" "dashdot" ) ;
            sh:maxCount 1 ;
            sh:order 60 ;
            sh:path tvbo:grid_style ],
        [ sh:datatype xsd:float ;
            sh:description "Vertical space between legend entries, in font-size units." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 56 ;
            sh:path tvbo:legend_label_spacing ],
        [ sh:datatype xsd:float ;
            sh:description "[dx, dy] shift of every panel letter from its corner, in axes fractions. The default for a figure's own `panel_number_offset`." ;
            sh:nodeKind sh:Literal ;
            sh:order 48 ;
            sh:path tvbo:panel_number_offset ],
        [ sh:description "Where a legend sits when its panel names no place." ;
            sh:in ( "best" "upper right" "upper left" "lower left" "lower right" "right" "center left" "center right" "lower center" "upper center" "center" ) ;
            sh:maxCount 1 ;
            sh:order 55 ;
            sh:path tvbo:legend_loc ],
        [ sh:description "Weight of body text." ;
            sh:in ( "normal" "bold" ) ;
            sh:maxCount 1 ;
            sh:order 19 ;
            sh:path tvbo:font_weight ],
        [ sh:description "Which corner a panel letter sits in. The default for a figure's own `panel_number_loc`." ;
            sh:in ( "upper left" "upper right" "lower left" "lower right" ) ;
            sh:maxCount 1 ;
            sh:order 47 ;
            sh:path tvbo:panel_number_loc ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the axes grid. Off in most journals, and worth stating either way rather than inheriting." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:grid_lines ],
        [ sh:description "Weight of an axis label." ;
            sh:in ( "normal" "bold" ) ;
            sh:maxCount 1 ;
            sh:order 21 ;
            sh:path tvbo:label_weight ],
        [ sh:datatype xsd:string ;
            sh:description "The categorical hues, reached into only where a panel separates conditions. Ordered, and named by index from zero (`palette.0` is the first), so inserting a hue recolours every figure that names one after it." ;
            sh:nodeKind sh:Literal ;
            sh:order 78 ;
            sh:path tvbo:palette ],
        [ sh:datatype xsd:string ;
            sh:description "The schema version a file was written against — the envelope `Document` declares." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 72 ;
            sh:path tvbo:schema_version ],
        [ sh:datatype xsd:float ;
            sh:description "How far an axis end may move outward to land on a tick under `axis_ends: near`, as a fraction of the data's span. Unset is 0.2." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path tvbo:end_tick_reach ],
        [ sh:datatype xsd:boolean ;
            sh:description "Align the axis labels of neighbouring panels with one another, so a column of y labels sits on one line." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path tvbo:align_labels ],
        [ sh:datatype xsd:boolean ;
            sh:description "Trim surrounding whitespace from every saved figure. The default for a figure's own `trim_margins`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 63 ;
            sh:path tvbo:trim_margins ],
        [ sh:datatype xsd:float ;
            sh:description "Size of an axis label as a multiple of the body size. Unset draws it at the body size." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path tvbo:label_scale ],
        [ sh:datatype xsd:float ;
            sh:description "Size of legend text as a multiple of the body size. Unset draws it at the body size." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path tvbo:legend_scale ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw panel letters. The default for a figure's own `panel_numbers`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 44 ;
            sh:path tvbo:panel_numbers ],
        [ sh:datatype xsd:string ;
            sh:description "Python format string applied to each panel letter: '{}' gives a, '({})' gives (a). The default for a figure's own `panel_number_format`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 45 ;
            sh:path tvbo:panel_number_format ],
        [ sh:datatype xsd:float ;
            sh:description "Distance from an axis label to its axis, in points. The default for a panel's own `xlabel_pad`/`ylabel_pad`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:label_pad ],
        [ sh:datatype xsd:float ;
            sh:description "Line weight of a major tick mark, in points." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:tick_width ],
        [ sh:datatype xsd:float ;
            sh:description "How far an axis extends past its data where its end is not on a tick, as a fraction of the data's span. Unset keeps the backend's own margin." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path tvbo:axis_margin ],
        [ sh:class tvbo:Argument ;
            sh:description "Raw backend settings for a look no slot above names, applied after every slot (matplotlib rcParams until a second backend lands), e.g. `{hatch.linewidth: 0.5}`. The escape hatch that keeps a study from needing a style sheet of its own." ;
            sh:nodeKind sh:IRI ;
            sh:order 70 ;
            sh:path tvbo:opts ],
        [ sh:datatype xsd:float ;
            sh:description "Length of a minor tick mark, in points. Ignored unless `minor_ticks` is set." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:minor_tick_length ],
        [ sh:datatype xsd:string ;
            sh:description "The page the figure is printed on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 77 ;
            sh:path tvbo:background ],
        [ sh:datatype xsd:string ;
            sh:description "Style layers underneath this theme, applied left to right: a registered bsplot style name or a path to an .mplstyle, relative to the study root. The default for a figure's own `style`. Everything the theme itself states wins over them." ;
            sh:nodeKind sh:Literal ;
            sh:order 69 ;
            sh:path tvbo:style ],
        [ sh:datatype xsd:float ;
            sh:description "The step multiples that count as round, each read times any power of ten. Unset is `[1, 2, 5]`; adding 2.5 admits 0, 25, 50." ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path tvbo:tick_steps ],
        [ sh:datatype xsd:float ;
            sh:description "Size of a legend's sample marker as a multiple of the drawn one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 58 ;
            sh:path tvbo:legend_marker_scale ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw minor tick marks between the major ones." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:minor_ticks ],
        [ sh:datatype xsd:integer ;
            sh:description "Raster resolution in dots per inch. The default for a figure's own `dpi`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 62 ;
            sh:path tvbo:dpi ],
        [ sh:description "How tick numbers are written on every axis that states no `xtick_format` or `ytick_format` of its own." ;
            sh:in ( "sci" "plain" ) ;
            sh:maxCount 1 ;
            sh:order 30 ;
            sh:path tvbo:tick_format ] ;
    sh:targetClass tvbo:Theme .

tvbo:TimeSeries a sh:NodeShape ;
    rdfs:comment "Time series data from simulations or measurements. Supports BIDS-compatible export for computational modeling (BEP034)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "BIDS ModelEq reference: path to _eq.xml LEMS file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path tvbo:model_equation_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS task name for the simulation (e.g., 'rest', 'simulation')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:task_name ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Timestamp when this TimeSeries was generated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:generated_at ],
        [ sh:class tvbo:Matrix ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Sampling rate in Hz." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:sampling_rate ],
        [ sh:datatype xsd:string ;
            sh:description "Ordering of dimensions: Time, State Variable, Space, Mode." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:labels_ordering ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS session identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS subject identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:float ;
            sh:description "Time between samples (inverse of sampling_rate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:sampling_period ],
        [ sh:datatype xsd:string ;
            sh:description "Physical unit of the time series values." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:string ;
            sh:description "Mapping of dimension names to their labels (JSON-encoded dict)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:labels_dimensions ],
        [ sh:class tvbo:SimulationExperiment ;
            sh:description "Reference to the SimulationExperiment that generated this TimeSeries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path tvbo:source_experiment ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:description "Imaging modality or simulation output type." ;
            sh:in ( "BOLD" "EEG" "MEG" "SEEG" "IEEG" ) ;
            sh:maxCount 1 ;
            sh:order 18 ;
            sh:path tvbo:modality ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareEnvironment> ;
            sh:description "Software environment used to generate this data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path tvbo:software_environment ],
        [ sh:datatype xsd:integer ;
            sh:description "BIDS run number." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Add the location of the data file containing the parcellation terminology." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ sh:class tvbo:Matrix ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:data ],
        [ sh:datatype xsd:string ;
            sh:description "Reference to connectivity data (_conndata-network_connectivity.tsv)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path tvbo:connectivity_ref ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "ms" ;
            sh:description "Unit of the sampling period (e.g., 'ms', 's')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:sampling_period_unit ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS ModelParam reference: path to _param.xml LEMS file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path tvbo:model_param_ref ] ;
    sh:targetClass tvbo:TimeSeries .

tvbo:Volume a sh:NodeShape ;
    rdfs:comment "A labelled-volume panel's geometry: the volumetric counterpart of `Surface`, same layer and same colour scale, with the geometry coming from an atlas instead of a mesh. Values are placed BY LABEL through the atlas crosswalk, never by array position." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Clip the limit to this percentile of the values (100 = no clipping), so one outlier region cannot wash the whole map out. Applies whether or not the scale is centred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:percentile ],
        [ sh:datatype xsd:float ;
            sh:description "The value the scale starts at. A declared end is honoured as given; the other is still derived from the data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:vmin ],
        [ sh:datatype xsd:boolean ;
            sh:description "Centre the limits on zero, so zero is the map's midpoint. What a field of signed deviations needs — read on an off-centre scale it is misleading in a way no axis label catches." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:symmetric ],
        [ sh:datatype xsd:string ;
            sh:description "The scale, as a key of the theme's `colormaps` (`sequential`, `diverging`, or one a project added) or a name the backend knows. Unset takes the theme's `sequential`, or its `diverging` where the scale is centred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:colormap ],
        [ sh:datatype xsd:string ;
            sh:description "A `dseg` segmentation file, for a parcellation nobody has curated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:image ],
        [ sh:datatype xsd:string ;
            sh:description "The curated atlas whose segmentation the values are painted into." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:atlas ],
        [ sh:datatype xsd:float ;
            sh:description "The value the scale ends at. See `vmin`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:vmax ],
        [ sh:datatype xsd:string ;
            sh:description "How voxels collapse along the view axis (`absmax` by default)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:intensity_projection ],
        [ sh:description "Which plane the volume is projected along." ;
            sh:in ( "sagittal" "coronal" "horizontal" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path tvbo:view ] ;
    sh:targetClass tvbo:Volume .

<https://w3id.org/tvbo/dbs/Electrode> a sh:NodeShape ;
    rdfs:comment "Implanted DBS electrode and contact geometry." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique identifier for this electrode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/dbs/manufacturer> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/dbs/model> ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Transformation> ;
            sh:description "Coordinate space used for implantation planning" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path <https://w3id.org/tvbo/dbs/coordinate_space> ],
        [ sh:class <https://w3id.org/tvbo/dbs/Contact> ;
            sh:description "List of physical contacts along the electrode" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/dbs/contacts> ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "left" ;
            sh:description "Hemisphere of electrode (left/right)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/dbs/hemisphere> ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/dbs/head> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://w3id.org/tvbo/dbs/recon_path> ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/dbs/tail> ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Region> ;
            sh:description "Anatomical target structure from a brain atlas" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path <https://w3id.org/tvbo/dbs/target_structure> ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            sh:description "The planned trajectory for electrode implantation" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://w3id.org/tvbo/dbs/trajectory> ] ;
    sh:targetClass <https://w3id.org/tvbo/dbs/Electrode> .

<https://w3id.org/tvbo/study/Cohort> a sh:NodeShape ;
    rdfs:comment "A named subset of a dataset's subjects: the unit a group-level quantity is defined over, such as a mean connectome, a per-edge presence count or a normalisation constant. A dataset may hold several, and they may overlap: the sites of a multi-centre study, a patient and a control group, the subjects a processing pipeline has finished so far. Naming the subset is what pins an aggregate. A quantity computed over ``hcpy93`` states which subjects went into it, and moving to a larger cohort is a change to one identifier rather than to every consumer." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/tvbo/study/CohortRule> ;
            sh:description "A rule on a phenotype measure that admits the members (``CohortRule``): one group of a split of the subjects by a score. The members are computed from the phenotype table each time the cohort is used, so no list is typed or stored." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/study/rule> ],
        [ sh:datatype xsd:string ;
            sh:description "The subject identifiers this cohort holds, without the ``sub-`` prefix, in the order a stacked read returns them. When the enclosing dataset lists its ``subjects``, every member must be one of them. A cohort states its members in exactly one way: typed here, read from ``members_file``, or admitted by ``rule``." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/study/members> ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a cohort, unique within the study: the name a reference addresses it by (``used: {cohort: <id>}``). Corresponds to the BIDS ``cohort-`` entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable cohort name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Path of a file that lists the members, read each time the cohort is used, so a list its producer keeps (the subjects a pipeline has finished) is never copied into the recipe. A ``.yaml`` or ``.json`` file holds what ``members`` would hold; a ``.tsv`` or ``.csv`` file is a participants table (the BIDS ``participants.tsv`` layout, tab- or comma-separated), read by its ``participant_id`` column, and a row with a value but no participant is an error; any other file holds one identifier per line, blank lines and lines starting with ``#`` skipped. Members come in the file's order and a ``sub-`` prefix is dropped. A relative path is read from the directory of the experiment or network file the dataset is part of, also when the dataset comes into that file by ``!include`` from another directory, and, when the file is not there, from the root of the study that file belongs to; a missing file is an error naming the places tried. Messages about a list read from a file give counts and positions, never an identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/study/members_file> ],
        [ sh:datatype xsd:string ;
            sh:description "What admits a subject to this cohort, in words: the selection rule, the site, the diagnostic group." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ] ;
    sh:targetClass <https://w3id.org/tvbo/study/Cohort> .

<https://w3id.org/tvbo/study/Dataset> a sh:NodeShape ;
    rdfs:comment "A collection of subjects for a multi-subject study. Provides the subject/session structure needed for workflow rendering. Optionally backed by a BIDS directory layout." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type tvbo:coordinate_space <https://w3id.org/tvbo/dbs/clinical_scores> ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Global condition labels applied across all subjects (e.g., ['rest', 'task-nback', 'task-motor'])." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://w3id.org/tvbo/study/conditions> ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:class <https://w3id.org/tvbo/study/Subject> ;
            sh:description "Subjects in a dataset." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/study/subjects> ],
        [ sh:datatype xsd:string ;
            sh:description "Path of a file that lists this dataset's subjects, in place of ``subjects``; a dataset states one of the two. A ``.yaml`` or ``.json`` file holds what ``subjects`` would hold (identifiers, ``Subject`` records or a mapping keyed by identifier), a ``.tsv`` or ``.csv`` file is a participants table read by its ``participant_id`` column, and any other file holds one identifier per line. Read each time the subjects are asked for and resolved as ``Cohort.members_file`` is, with the same rule for what a message may say." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/study/subjects_file> ],
        [ sh:datatype xsd:string ;
            sh:description "Path to BIDS dataset root directory. When set, subject networks and empirical data paths are resolved relative to this root. A workflow kit copies the files its experiments read from here into its own ``data/<dataset_id>/`` and freezes this path to that copy." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/tvbo/study/bids_root> ],
        [ sh:datatype xsd:string ;
            sh:description "DOI or citation for this dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:references ],
        [ sh:defaultValue "fan_out" ;
            sh:description "How the per-subject fits are executed. ``fan_out`` (default) runs one per-subject job, each binding its own targets at run time. ``on_device`` evaluates the whole cohort together as one vectorised batch on a single device — the subject axis mapped in parallel while the shared network is reused across subjects. Backend-independent intent: the scientific spec is identical either way; only the execution strategy differs (a backend realises the batch with its own vectorised-map primitive)." ;
            sh:in ( "fan_out" "on_device" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path <https://w3id.org/tvbo/study/batch_mode> ],
        [ sh:class <https://w3id.org/tvbo/study/Cohort> ;
            sh:description "Named subsets of this dataset's subjects (``Cohort``). A reference reads a cohort by its identifier (``used: {cohort: <id>}``): each member's file is found under this dataset's ``bids_root``." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/study/cohorts> ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable dataset name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:integer ;
            sh:description "On-device chunk width — how many subjects form one vectorised batch. Absent = the whole cohort in one batch, bounded by the working-memory budget (as for exploration ``n_parallel``). Ignored when ``batch_mode`` is ``fan_out``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <https://w3id.org/tvbo/study/batch_size> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Path of this dataset's phenotype table, which a cohort ``rule`` reads its measure from: a ``Phenotype`` sidecar (``.yaml``, values in its companion) or a tabular file (``.tsv`` or ``.csv``, one row per subject under ``participant_id``, one column per measure, ``n/a`` for a missing value); a file of another suffix is an error. Resolved as ``Cohort.members_file`` is." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/study/phenotype_file> ] ;
    sh:targetClass <https://w3id.org/tvbo/study/Dataset> .

<https://w3id.org/tvbo/study/Session> a sh:NodeShape ;
    rdfs:comment "A data collection session for a subject. Corresponds to a BIDS 'ses-' entity. Sessions capture longitudinal timepoints (baseline, follow-up), different experimental conditions, or repeated measures." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "BIDS session identifier (without 'ses-' prefix). Examples: 'baseline', '6month', 'pre', 'post'." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable session label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Path to session-specific connectome. Overrides Subject.network when set. Relative to dataset root or BIDS derivatives." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/study/network> ],
        [ sh:datatype xsd:string ;
            sh:description "Experimental condition label (e.g., 'rest', 'task-nback'). Maps to BIDS 'task-' entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/study/condition> ],
        [ sh:datatype xsd:string ;
            sh:description "Paths to empirical recordings for this session (e.g., BOLD time series, MEG/EEG). Relative to dataset root." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/study/empirical_data> ] ;
    sh:targetClass <https://w3id.org/tvbo/study/Session> .

<https://w3id.org/tvbo/study/StudyDirectory> a sh:NodeShape ;
    rdfs:comment "One directory in a study layout. ``role`` is the stable key code resolves by: a resolver asks the layout where the ``results`` go and never for a literal path, so moving a directory is a one-line edit to this record. ``bids`` states the directory's standing with the standard, which is what decides whether it needs a ``.bidsignore`` entry, and ``tracked`` states what version control keeps." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:defaultValue "optional" ;
            sh:description "Whether a study MUST, SHOULD or MAY have this directory. Enforced by ``tvbo validate study``; a BIDS-sanctioned directory is optional to BIDS regardless of what a study requires of itself." ;
            sh:in ( "required" "recommended" "optional" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/study/level> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class <https://w3id.org/tvbo/study/StudyFile> ;
            sh:description "Files this directory is expected to carry." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path <https://w3id.org/tvbo/study/files> ],
        [ sh:datatype xsd:string ;
            sh:description "Init templates that include this directory. Absent means every study gets it, so one record covers the general layout and its specialisations without a second copy of the tree to keep in step." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://w3id.org/tvbo/study/in_templates> ],
        [ sh:description "Semantic key this directory is resolved by. Absent for a directory that only groups others, whose own path no code needs." ;
            sh:in ( "spec" "code_source" "sourcedata" "original_study" "raw_bids" "docs" "analysis" "manuscript_sections" "figures" "figure_scripts" "figures_restricted" "derivatives" "results" "logs" "build" "kits" "cache" "notes" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/study/role> ],
        [ sh:class <https://w3id.org/tvbo/study/StudyDirectory> ;
            sh:description "Nested directories." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path <https://w3id.org/tvbo/study/subdirs> ],
        [ sh:defaultValue "all" ;
            sh:description "What version control keeps, which is what the ``.gitignore`` writer emits." ;
            sh:in ( "all" "declared_files" "none" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/study/tracked> ],
        [ sh:datatype xsd:boolean ;
            sh:description "BIDS: the standard does not specify the contents, so a validator does not read inside. A sanctioned opaque directory therefore needs no ``.bidsignore`` entry however its files are named." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/study/opaque> ],
        [ sh:datatype xsd:string ;
            sh:description "Init templates that do *not* get this directory, though every other kind does. The complement of ``in_templates``, for a directory one kind replaces rather than adds to." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <https://w3id.org/tvbo/study/not_in_templates> ],
        [ sh:datatype xsd:string ;
            sh:description "For an unsanctioned or proposed directory, what would retire its ``.bidsignore`` entry (a BEP identifier, or a change we would have to propose). Naming the exit keeps the ignore surface from becoming permanent by default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/tvbo/study/expires_with> ],
        [ sh:defaultValue "sanctioned" ;
            sh:description "Standing with the BIDS standard." ;
            sh:in ( "sanctioned" "proposed" "nested_dataset" "unsanctioned" "hidden" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/study/bids> ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass <https://w3id.org/tvbo/study/StudyDirectory> .

<https://w3id.org/tvbo/study/StudyFile> a sh:NodeShape ;
    rdfs:comment "One file a study layout accounts for. ``name`` may interpolate ``{study}``, the dataset's own name, which is how the entry recipe is named without the layout knowing any particular study." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Init templates that do *not* get this file, though every other kind does. The complement of ``in_templates``, for a file the general study has and one kind replaces rather than adds to: a collection's document stands in for a single study's report, so naming the kinds that keep the report would leave every kind added later to be edited in here as well." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://w3id.org/tvbo/study/not_in_templates> ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:defaultValue "optional" ;
            sh:in ( "required" "recommended" "optional" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/study/level> ],
        [ sh:defaultValue "sanctioned" ;
            sh:description "Standing with the BIDS standard; an unsanctioned file needs a ``.bidsignore`` entry." ;
            sh:in ( "sanctioned" "proposed" "nested_dataset" "unsanctioned" "hidden" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/study/bids> ],
        [ sh:class <https://w3id.org/tvbo/study/LayoutTemplateVariant> ;
            sh:description "Seeds that supersede ``template`` for one init variant, keyed by variant name. A file every study gets may still need different starting text once the variant says what kind of study this is — a replication's provenance note names a paper, and a general study has no paper to name — so stating only the difference keeps one entry per file rather than two that drift apart. The first selected variant naming a seed wins; absent means every variant starts from ``template``." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <https://w3id.org/tvbo/study/template_variants> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:boolean ;
            sh:description "Written by tooling and overwritten on the next run, so it is never hand-edited." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://w3id.org/tvbo/study/generated> ],
        [ sh:datatype xsd:string ;
            sh:description "Init templates that include this file. Absent means every study gets it." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <https://w3id.org/tvbo/study/in_templates> ],
        [ sh:defaultValue "all" ;
            sh:in ( "all" "declared_files" "none" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/study/tracked> ],
        [ sh:datatype xsd:string ;
            sh:description "For an unsanctioned or proposed file, what would retire its ``.bidsignore`` entry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/study/expires_with> ],
        [ sh:datatype xsd:string ;
            sh:description "Asset that seeds the file at ``tvbo study init``, resolved against the scaffolder's template directory. Absent means the file is written from the layout record itself, or left to the author." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/tvbo/study/template> ],
        [ sh:description "Semantic key this file is resolved by." ;
            sh:in ( "dataset_description" "readme" "citation" "license" "changelog" "recipe" "gitignore" "bidsignore" "results_manifest" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/study/role> ] ;
    sh:targetClass <https://w3id.org/tvbo/study/StudyFile> .

<http://uri.interlex.org/tgbugs/uris/readable/atlas/Region> a sh:NodeShape ;
    rdfs:comment "A schema for representing a parcellation entity, which is an anatomical location or study target." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Slot for the abbreviation of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path skos:notation ],
        [ sh:datatype xsd:string ;
            sh:description "Enter any alternate names, including abbreviations, for this entity." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/atlas/hasName> ],
        [ sh:datatype xsd:string ;
            sh:description "Add the related anatomical entity as defined by the UBERON ontology." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/relatedUBERONTerm> ],
        [ sh:datatype xsd:integer ;
            sh:description "Enter the label used for looking up this entity in the parcellation terminology." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/atlas/lookupLabel> ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:name ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Region> ;
            sh:description "Add all anatomical parent structures for this entity as defined within the corresponding brain atlas." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/atlas/hasParent> ],
        [ sh:datatype xsd:integer ;
            sh:description "Add the original label of this entity as defined in the parcellation terminology." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/originalLookupLabel> ],
        [ sh:datatype xsd:string ;
            sh:description "Add the color code used for visual representation of this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/color> ],
        [ sh:datatype xsd:string ;
            sh:description "Enter the version identifier of this brain atlas or coordinate space version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:hasVersion ],
        [ sh:datatype xsd:float ;
            sh:description "Add the volume, in cubic millimetres, that this entity occupies in the label image of its brain atlas version. Given for labelled entities only: a parent entity names a whole structure that the label image may cover only in part." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <http://www.wikidata.org/prop/direct/P2234> ],
        [ sh:description "Add the hemisphere of this entity." ;
            sh:in ( "left" "right" "both" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/hemisphere> ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            sh:description "Add the center coordinate of this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/center> ],
        [ sh:datatype xsd:string ;
            sh:description "Enter the internationalized resource identifier (IRI) to the related ontological terms." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/atlas/hasIlxId> ] ;
    sh:targetClass <http://uri.interlex.org/tgbugs/uris/readable/atlas/Region> .

tvbo:BidsEntities a sh:NodeShape ;
    rdfs:comment "BIDS filename entities (BEP017-aligned) for provenance and data discovery. Reusable on Network, BrainAtlas, Tractogram, or any dataset with BIDS-conformant naming." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "BIDS acq- entity (e.g., EEGstandard1005, MEGBrainstorm)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:acquisition ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS scale- entity (BEP017, e.g., 1000)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:scale ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS cohort- entity (e.g., HCPYA, PPMI85)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:cohort ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS atlas- entity (e.g., Schaefer2018, HCPMMP1)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:atlas ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS hemi- entity (L or R) for hemisphere-specific surface/volume data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:hemi ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS desc- entity (e.g., FCavg, SC), for disambiguating derived data variants" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:desc ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS rec- entity (e.g., dTOR)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:reconstruction ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS tpl- entity, a TemplateFlow identifier (e.g., MNI152NLin6Asym, MNI152NLin2009cAsym, fsLR)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:template ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS den- entity, the density of a surface mesh (e.g., 32k, 164k)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:density ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS suffix (e.g., relmat), the trailing name component before the extension" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:suffix ],
        [ sh:datatype xsd:string ;
            sh:description "BIDS seg- entity (e.g., 7Networks, 17Networks)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:segmentation ] ;
    sh:targetClass tvbo:BidsEntities .

tvbo:ClassReference a sh:NodeShape ;
    rdfs:comment "Reference to a class that can be instantiated and called. Used for external library classes (e.g., tvboptim.Bold, custom monitors). The class is instantiated with constructor_args, then called with call_args. Generalizable pattern: works for tvboptim, TVB, or any Python class." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:module ],
        [ sh:class tvbo:Argument ;
            sh:description "Arguments passed to __init__ when instantiating the class. Example: period=1000.0, downsample_period=4.0 for Bold monitor." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path tvbo:constructor_args ],
        [ sh:datatype xsd:float ;
            sh:description "How much signal this class convolves against before its first output is meaningful, as a duration in the integration's time unit. An external class is a black box, so its memory is declared here rather than inferred from the length of what it returns -- a class that pads or trims would make that inference wrong silently, and the result would look like a plausible series. Absent means memoryless: the class emits one output per period with no history behind it (GlobalAverage, SpatialAverage, EEG, AfferentCoupling), and the settle's own output samples are simply dropped. Present means kernel-bearing (a BOLD monitor and its HRF variants): the settle is cut at the INPUT instead, leaving this much of it in front of t = 0 for the class to eat, so the first reported sample is the first measured one and no arithmetic is done on the output at all. A settle shorter than the warm-up opens the class on zeros, which is what it would do at t = 0 anyway." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:warmup ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this callable can be traced by an array-programming backend (jit/vmap under JAX), asserted by the recipe rather than inferred from the module name. A backend that batches a parameter grid must know whether an observation's callable survives tracing; without this it can only guess from the import root, which makes every study-local callable untraceable however it is written. Set it true only for a callable written against the backend's array API -- a host NumPy/SciPy callable declared traceable fails inside the trace, with the tracer error naming this claim as its cause. Unset means \"infer\", preserving the import-root default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:traceable ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareRequirement> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path tvbo:software ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ],
        [ sh:class tvbo:Argument ;
            sh:description "Arguments passed when calling the instance (__call__). Usually the input data from simulation result. Example: result (simulation output array)." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path tvbo:call_args ] ;
    sh:targetClass tvbo:ClassReference .

tvbo:Matrix a sh:NodeShape ;
    rdfs:comment "Adjacency matrix of a network." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Add the location of the data file containing the parcellation terminology." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ sh:datatype xsd:string ;
            sh:description "Data type the matrix values are stored as. Absent stores them as computed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:dtype ],
        [ sh:class tvbo:BrainRegionSeries ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:y ],
        [ sh:description "Storage format in binary companion (dense, csr, coo)" ;
            sh:in ( "dense" "csr" "coo" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path tvbo:format ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:integer ;
            sh:description "Matrix dimensions [N, M]" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:shape ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:float ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:values ],
        [ sh:class tvbo:BrainRegionSeries ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:x ] ;
    sh:targetClass tvbo:Matrix .

tvbo:OptimizationStage a sh:NodeShape ;
    rdfs:comment "A single stage in a multi-stage optimization workflow. Stages run sequentially, with each stage potentially using different parameters, shapes, learning rates, and algorithms." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type tvbo:depends_on tvbo:execution tvbo:integration tvbo:loss tvbo:stages ) ;
    sh:property [ sh:class tvbo:Parameter ;
            sh:description "Parameters from previous stages to freeze (keep at optimized value but not update)" ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path tvbo:freeze_parameters ],
        [ sh:class tvbo:OptimizationStage ;
            sh:description "Previous stage to initialize from. Final values from that stage become initial values for this stage." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path tvbo:warmup_from ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "adam" ;
            sh:description "Optimizer for this stage: 'adam', 'adamw', 'sgd', etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:algorithm ],
        [ sh:class tvbo:FreeParameter ;
            sh:description "Parameters to optimize in this stage. Each entry is a FreeParameter that references an existing Parameter by dotted scope (e.g. \"ReducedWongWang.w\" or \"FastLinearCoupling.G\") and supplies optimization-specific metadata (heterogeneous, shape, bounds). No new Parameter is created here." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:free_parameters ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 100 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:max_iterations ],
        [ sh:class tvbo:Parameter ;
            sh:description "Stage-specific hyperparameters (e.g., b2=0.9999 for adam)" ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:hyperparameters ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.001"^^xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:learning_rate ] ;
    sh:targetClass tvbo:OptimizationStage .

tvbo:Option a sh:NodeShape ;
    rdfs:comment "A toolkit-specific key-value option (string name + string value). Used for backend settings that are not universal numeric parameters (e.g., solver name, tangent method, jacobian type)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Option value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:value ],
        [ sh:datatype xsd:string ;
            sh:description "Option name (key)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass tvbo:Option .

tvbo:SimulationExperiment a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:references ],
        [ sh:class tvbo:Optimization ;
            sh:description "Parameter optimization configurations" ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path tvbo:optimizations ],
        [ sh:class tvbo:Network ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path tvbo:connectivity ],
        [ sh:class tvbo:Continuation ;
            sh:description "Numerical continuation and bifurcation analysis specifications. Each entry defines a continuation experiment (equilibrium branch, codim-2 curve, periodic orbit family, etc.).            # Either reference a full reusable environment (preferred) or, for" ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path tvbo:continuations ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:defaultValue "main" ;
            sh:description "Which part of a generated report this belongs in — the main Methods or the supplementary material. Placement only: every experiment runs and every figure renders regardless, so demoting one never changes what is computed. It answers a different question from a replication's target tier (how central a claim is) and from the source paper's own Fig/EDF numbering (where *they* printed it), because our document may carry a headline result's parameter dump in the SI, or relegate a figure the paper printed up front. Defaults to ``main``, so a recipe that says nothing keeps everything in the Methods." ;
            sh:in ( "main" "supplementary" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path tvbo:part ],
        [ sh:class tvbo:Equation ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:additional_equations ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path rdfs:label ],
        [ sh:class tvbo:Event ;
            sh:description "Events that apply at the experiment level. For component-level events, attach them to individual nodes or edges instead." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path tvbo:events ],
        [ sh:class tvbo:PDE ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path tvbo:field_dynamics ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:class tvbo:Function ;
            sh:description "Reusable function definitions. Referenced by name in observation pipelines. Enables DRY: define compute_fc once, use in both simulated and empirical paths." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path tvbo:functions ],
        [ sh:class <https://w3id.org/tvbo/study/Dataset> ;
            sh:description "Multi-subject dataset for workflow rendering. When set, render_workflow() uses dataset.subjects/sessions to generate per-subject parallel jobs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path tvbo:dataset ],
        [ sh:class tvbo:Observation ;
            sh:description "All observations on this experiment, keyed by name. An Observation is considered derived (computed from other observations rather than directly from state variables) when any item in its multivalued ``source`` slot names another observation in this same dict." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path tvbo:observations ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareEnvironment> ;
            sh:description "Execution environment (collection of requirements)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path tvbo:environment ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareRequirement> ;
            sh:description "(Deprecated) Single software requirement; prefer 'environment' with aggregated requirements." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path tvbo:software ],
        [ sh:class tvbo:Algorithm ;
            sh:description "Iterative parameter tuning algorithms (FIC, EIB, etc.)" ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path tvbo:algorithms ],
        [ sh:class tvbo:Integrator ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path tvbo:integration ],
        [ sh:class tvbo:Provenance ;
            sh:description "W3C PROV-O aligned provenance for this entity — what it was derived from, which agent produced it, and when." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path tvbo:provenance ],
        [ sh:class tvbo:Exploration ;
            sh:description "Parameter exploration/grid search specifications" ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path tvbo:explorations ],
        [ sh:class tvbo:Dynamics ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path tvbo:model ],
        [ sh:class tvbo:Dynamics ;
            sh:description "Default dynamics model for all nodes. For heterogeneous networks with multiple dynamics, use network.dynamics instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path tvbo:dynamics ],
        [ sh:class tvbo:InitialState ;
            sh:description "How to obtain the starting state for the run. Default: the model's declared initial values (method ``given``). ``from_working_point`` ramps a parameter quasi-statically to a target (reusing the warm-start ``from_previous`` primitive, see ``ramp``) and starts the run from the branch endpoint — e.g. the operating point reached by an adiabatic K-upsweep. ``from_experiment`` instead reuses a working point another experiment already reached, seeding from its saved endpoint (see ``source_experiment``) rather than recomputing the ramp." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path tvbo:initial_state ],
        [ sh:class tvbo:Network ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path tvbo:network ],
        [ sh:class tvbo:ExecutionConfig ;
            sh:description "Computational execution configuration (parallelization, devices)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path tvbo:execution ],
        [ sh:class tvbo:WorkflowConfig ;
            sh:description "Orchestration for distributing this experiment's sweep across a workflow engine. Refines the study's ``workflow`` block: only the fields it sets take precedence, the rest are inherited. Use it to give one experiment its own shard count or resources." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path tvbo:workflow ],
        [ sh:class tvbo:Stimulus ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path tvbo:stimulation ],
        [ sh:class tvbo:Inference ;
            sh:description "Bayesian inference configurations (posterior over parameters given an observation, via MCMC). Keyed by name, like optimizations." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path tvbo:inferences ] ;
    sh:targetClass tvbo:SimulationExperiment .

tvbo:Solver a sh:NodeShape ;
    rdfs:comment "Lightweight specification of a numerical ODE solver / integrator. Covers adaptive solvers (Vern9, Rodas5, Tsit5, etc.) used in shooting methods, initial-state integration, and other contexts where only the algorithm and tolerances matter." ;
    sh:closed true ;
    sh:ignoredProperties ( dcterms:description qudt:unit rdf:type rdfs:label tvbo:block_size tvbo:coupling_evaluation tvbo:delayed tvbo:differentiation tvbo:discretization tvbo:duration tvbo:environment tvbo:intermediate_expressions tvbo:noise tvbo:noise_draw tvbo:number_of_stages tvbo:parameters tvbo:preconditioner tvbo:requirements tvbo:scipy_ode_base tvbo:state_wise_sigma tvbo:steps tvbo:time_unit tvbo:transient_time tvbo:update_expression ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Fixed time step of the solver. Unset for an adaptive solver, which chooses its own step from `abs_tol` / `rel_tol`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:step_size ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Tsit5" ;
            sh:description "Solver algorithm name (e.g., Vern9, Rodas5, Tsit5, euler, heun, rk4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:method ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1e-10"^^xsd:float ;
            sh:description "Absolute tolerance for adaptive solvers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:abs_tol ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1e-10"^^xsd:float ;
            sh:description "Relative tolerance for adaptive solvers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:rel_tol ] ;
    sh:targetClass tvbo:Solver .

tvbo:WorkflowConfig a sh:NodeShape ;
    rdfs:comment "Declarative orchestration for rendering a parameter sweep into a distributed, reproducible workflow (Slurm array, Snakemake, Nextflow). Backend- and engine-independent: it names *what* to distribute, *where* results go, and the per-engine resources, while each engine emitter renders the concrete artefact. Declared on a study as ``workflow`` and refined per experiment via ``workflow_overrides``; unset fields fall back to the emitter's defaults so an override sets only what it names." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Container image wrapping each task; tasks run as ``<runtime> exec <image> …``. A concrete image passes through as given — either a registry reference the engine resolves and materialises itself (``docker://…:tag``) or a path to an image file already built on the target, which pins the exact image and needs no pull; a registry reference written without a transport gains ``docker://``. Only tvbo's own image has an open version filled in, with the version of the running tvbo: the symbolic value ``tvbo``, or tvbo's repository (``ghcr.io/virtual-twin/tvbo``) with no ``:tag``. Any other reference without a tag keeps the registry's default tag. Unset, tasks run in the surrounding environment, and declared ``requirements`` are provisioned into it rather than forcing a container." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:container ],
        [ sh:datatype xsd:string ;
            sh:description "Output directory template. ``{study}`` and ``{experiment}`` are substituted with the study and experiment keys at emit time. Unset means the kit's own ``derivatives/tvbo``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:out_dir ],
        [ sh:datatype xsd:integer ;
            sh:description "Automatic retries per failed task. Unset means none." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:retries ],
        [ sh:datatype xsd:string ;
            sh:description "Host paths that must be visible inside the container beyond the ones its runtime binds by default (typically ``$HOME`` and the working directory). Required whenever a task reads or writes a site filesystem outside those defaults — a shared cache, a data tree, or a scratch area a symlink resolves into. Rendered into each runtime's own flag (``--bind`` for Apptainer/Singularity)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:container_binds ],
        [ sh:datatype xsd:string ;
            sh:description "Additional arguments passed verbatim to the container runtime when it executes a task. The extension point for runtime flags the typed fields do not cover, mirroring ``WorkflowEngineConfig.options`` for scheduler directives." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:container_args ],
        [ sh:class tvbo:WorkflowEngineConfig ;
            sh:description "Nextflow execution directives." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path tvbo:nextflow ],
        [ sh:class tvbo:DistributionConfig ;
            sh:description "How exploration axes map onto the vectorized vs fanned-out tiers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path tvbo:distribute ],
        [ sh:datatype xsd:string ;
            sh:description "Random-seed policy across shards. ``deterministic`` (the default when unset) derives each task's seed from its shard index so the fan-out is reproducible." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:rng ],
        [ sh:class tvbo:WorkflowEngineConfig ;
            sh:description "Snakemake execution directives." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path tvbo:snakemake ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareRequirement> ;
            sh:description "Software requirements for the workflow environment; overrides ``experiment.environment.requirements`` when set." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path tvbo:requirements ],
        [ sh:datatype xsd:integer ;
            sh:description "Default shard count used when ``distribute.chunk`` is unset (see DistributionConfig.chunk)." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:chunk ],
        [ sh:class tvbo:WorkflowEngineConfig ;
            sh:description "Slurm sbatch directives for array-job execution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path tvbo:slurm ] ;
    sh:targetClass tvbo:WorkflowConfig .

tvbo:WorkflowEngineConfig a sh:NodeShape ;
    rdfs:comment "Execution directives for a workflow engine. Every field is optional and each engine's emitter consumes the subset it supports, so one block may carry directives for more than one target. The generic resource fields (cpus_per_task, mem, time) map across engines; the remaining fields are named for the engine that reads them (Slurm: partition/account/gres/ mail_*/array_chunk; Snakemake: cores; Nextflow: executor/queue). Any directive not named here is passed through ``options`` verbatim, so the block stays extensible without a schema change." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Concurrent jobs the workflow engine keeps in flight (Snakemake ``--jobs``, written into the emitted profile). A site's queue limit is a property of the run, so it belongs beside partition and account; unset means 100." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:jobs ],
        [ sh:datatype xsd:string ;
            sh:description "Accounting allocation to charge the tasks against (Slurm)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:account ],
        [ sh:datatype xsd:string ;
            sh:description "Environment modules to load before running (module load …)." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:modules ],
        [ sh:datatype xsd:string ;
            sh:description "Scheduler partition to submit to (Slurm)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:partition ],
        [ sh:datatype xsd:integer ;
            sh:description "CPU cores requested per task (Slurm --cpus-per-task)." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:cpus_per_task ],
        [ sh:datatype xsd:string ;
            sh:description "Wall-clock limit per task (e.g. '24:00:00')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:time ],
        [ sh:class tvbo:EnvironmentVariable ;
            sh:description "Environment variables exported before the task command on every engine (e.g. XLA_PYTHON_CLIENT_PREALLOCATE=false). An ordered list of {name, value}; values are shell-quoted at emit time." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path tvbo:env ],
        [ sh:datatype xsd:string ;
            sh:description "Notification email address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:mail_user ],
        [ sh:datatype xsd:string ;
            sh:description "Shell lines run verbatim before the task command, after ``set -euo pipefail`` and any module/venv activation. The general hook for environment setup the typed fields do not cover, e.g. activating a conda env (``conda activate <name>``), sourcing a profile, or exporting a computed path. Ordered; each line is emitted as-is." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:setup ],
        [ sh:datatype xsd:string ;
            sh:description "Scheduler queue for the executor (Nextflow process.queue)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:queue ],
        [ sh:class tvbo:SchedulerDirective ;
            sh:description "Additional engine-native scheduler directives passed through verbatim, each in the target's native form: a Slurm ``#SBATCH --<name>=<value>`` line, a Snakemake ``resources:`` entry, or a Nextflow ``process.<name>`` assignment. The extension point for any flag the typed fields do not cover." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path tvbo:options ],
        [ sh:datatype xsd:string ;
            sh:description "Path to a virtual environment to activate before running." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:venv ],
        [ sh:datatype xsd:integer ;
            sh:description "Overrides ``distribute.chunk`` for this engine only: the number of array-task shards to split the vectorized sweep across." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:array_chunk ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text provenance tag on each submitted job (Slurm ``--comment``), visible in ``squeue -o %k``. Unset means an auto-generated ``tvbo:<study>/exp_<experiment>`` tag so a queued job maps back to its experiment; set it to override with a custom string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:comment ],
        [ sh:datatype xsd:integer ;
            sh:description "Total cores for local engines (Snakemake --cores)." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:cores ],
        [ sh:datatype xsd:string ;
            sh:description "Generic scheduler resources, e.g. 'gpu:1' (Slurm --gres)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:gres ],
        [ sh:datatype xsd:string ;
            sh:description "Scheduler notification trigger (e.g. 'END,FAIL')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:mail_type ],
        [ sh:datatype xsd:string ;
            sh:description "Executor to run the pipeline through (Nextflow process.executor)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:executor ],
        [ sh:datatype xsd:string ;
            sh:description "Memory per task in scheduler syntax (e.g. '16G')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:mem ] ;
    sh:targetClass tvbo:WorkflowEngineConfig .

<https://w3id.org/tvbo/dbs/ClinicalScore> a sh:NodeShape ;
    rdfs:comment "Metadata about a clinical score or scale." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Full name of the score (e.g., Unified Parkinson's Disease Rating Scale - Part III)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Domain assessed (e.g. motor, mood, pain)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/dbs/domain> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path skos:notation ],
        [ sh:class <https://w3id.org/tvbo/dbs/ClinicalScale> ;
            sh:description "The scale this score belongs to, if applicable" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/dbs/scale> ],
        [ sh:datatype xsd:string ;
            sh:description "PubMed ID, DOI, or other reference to the score definition" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:references ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:class <https://w3id.org/tvbo/dbs/ClinicalScore> ;
            sh:description "If this score is a subscore of a broader composite" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/dbs/parent_score> ] ;
    sh:targetClass <https://w3id.org/tvbo/dbs/ClinicalScore> .

tvbo:Aggregation a sh:NodeShape ;
    rdfs:comment "Specifies how to aggregate values across a dimension. Used for loss functions to define per-element loss with reduction." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:defaultValue "mean" ;
            sh:description "Aggregation operation (mean, sum, max, min, none)" ;
            sh:in ( "mean" "sum" "max" "min" "none" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path tvbo:type ],
        [ sh:description "Dimension to aggregate over (e.g., node, time, state)" ;
            sh:in ( "time" "state" "node" "region" "mode" "sample" "batch" "frequency" "subject" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path tvbo:over ] ;
    sh:targetClass tvbo:Aggregation .

tvbo:Assignment a sh:NodeShape ;
    rdfs:comment "One step of a sequential recurrence: the expression assigned to a target name. Sequential rather than simultaneous — a later step's expression sees the value the steps above it assigned — which is what lets a reducer's update be authored as ordinary arithmetic instead of with `new_*` temporaries. Authored terse as a `[target, expression]` pair and lifted to this form on load." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The state name this step assigns to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:target ],
        [ sh:datatype xsd:string ;
            sh:description "Symbolic right-hand side, parsed and printed per backend." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:expression ] ;
    sh:targetClass tvbo:Assignment .

tvbo:Integrator a sh:NodeShape ;
    rdfs:comment "Fixed-step or adaptive ODE integrator with TVB-specific extensions (noise, transient time, etc.). Inherits abs_tol, rel_tol from Solver; `method` defaults to Heun." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:defaultValue "0.01220703125"^^xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:step_size ],
        [ sh:defaultValue "fused" ;
            sh:description "How the base solve draws its noise realization, and therefore WHICH realization it is: `fused` draws the whole [n_steps, ...] tensor in one call, `blocked` regenerates each block of `block_size` steps from (key, block_index). Those are different draws from the same seed, so the grain is a declared property of the integration rather than something inferred from how the run is consumed. An observable declared `reduce: streaming` folds block by block whatever this says, because a reduction has no trajectory to fold otherwise; declare `blocked` to put the whole run on that same grain." ;
            sh:in ( "blocked" "fused" ) ;
            sh:maxCount 1 ;
            sh:order 12 ;
            sh:path tvbo:noise_draw ],
        [ sh:class tvbo:DerivedVariable ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path tvbo:intermediate_expressions ],
        [ sh:datatype xsd:float ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:state_wise_sigma ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path tvbo:delayed ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:number_of_stages ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1e-10"^^xsd:float ;
            sh:description "Relative tolerance for adaptive solvers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path tvbo:rel_tol ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:steps ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1000 ;
            sh:description "Granularity of the nested block scan, in integration steps. Bounds the per-block memory so a streaming reduction folds an observable in-carry instead of materializing the trajectory. On a STOCHASTIC network this value is not a free tuning knob: with `noise_draw: blocked` the realization is a pure function of the noise key and the block index, so changing it changes the trajectory. Declare it and leave it alone." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:block_size ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1000.0"^^xsd:float ;
            sh:description "Length of the MEASURED window — what the run hands back. Any `transient_time` is prepended to it, so total integrated time is `transient_time + duration` and raising the settle never shortens the data. Every backend measures this same window." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:duration ],
        [ sh:class tvbo:Noise ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:noise ],
        [ sh:class tvbo:DerivedVariable ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path tvbo:update_expression ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1e-10"^^xsd:float ;
            sh:description "Absolute tolerance for adaptive solvers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path tvbo:abs_tol ],
        [ sh:description "Physical unit of measurement. `UnitEnum` is the curated vocabulary — each of its values is vendored from QUDT (`ontology/tvb-o-units.ttl`) and can be reasoned about dimensionally. The range is deliberately open beyond it: a unit nobody has curated yet is recorded as written and reported `uncurated`, because a closed range forces the author to either misdeclare the quantity or leave it undeclared, and both lose more than an unrecognised string does. An uncurated unit carries no dimensional claim, so a check involving it reports `underdetermined` rather than guessing. Promote one with `tvbo units add <unit>`, which pulls its QUDT record into the vendored module — so every unit TVBO *reasons* about stays authoritative, and only what it *records* is open." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path qudt:unit ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:parameters ],
        [ sh:description "Unit of every time-valued number in this scope — the step size, any period, and the physical meaning of one model time-step. Declared at whichever scope owns the clock (network, integrator, observation); `tvbo.utils.units.time_unit_of` resolves a scope to its effective unit by walking outwards, and states the `ms` fallback once, at the end of that walk. Deliberately carries no default: a defaulted slot cannot be inherited through, so `ifabsent: ms` made an unset unit indistinguishable from one someone wrote, and masked an explicitly declared `s` one scope out. `time_scale` is accepted as a synonym." ;
            sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path tvbo:time_unit ],
        [ sh:class tvbo:Differentiation ;
            sh:description "Backend-neutral strategy for propagating gradients through the temporal integration (e.g. truncated backprop-through-time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path tvbo:differentiation ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:scipy_ode_base ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the leading settling window, prepended to `duration`. It marks part of ONE integration — never a separate simulation: the backend integrates `transient_time + duration` in a single scan and the marked head is cut where the run is consumed (observations, analyses, plots, saved data), so the settle is in-band for any observation kernel that needs warm-up. Time is measured from the START of the measured window: the settle carries non-positive timestamps and ends at 0, the measured window opens one step later, and a declared event `t0` is relative to measurement, never to the scan. A settle that a fit reuses across many candidate evaluations is NOT this slot — that is a seed, declared as `initial_state.method: time_integration` with its own `duration`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:transient_time ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Heun" ;
            sh:description "Integration method (Euler, Heun, RungeKutta4thOrder, or any spelling `tvbo.utils.integration_method` accepts); Heun when absent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:method ],
        [ sh:defaultValue "per_step" ;
            sh:description "Backend-neutral numerical treatment of the network coupling term across the stages of a multi-stage integrator (Heun, RK4, ...): re-evaluated at every stage (per_stage, standard ODE accuracy) or computed once per step and held across the stages (per_step, the TVB scheme). A single-stage method (Euler) and a single node integrate the same system under both. tvboptim's native solvers, NetworkDynamics.jl and the jax backend honour both values, the jax backend per_stage over an undelayed coupling only; TVB and the Python graph runner integrate per_step and refuse per_stage, and tvboptim's diffrax solvers and PyRates always integrate per_stage, whatever is declared (CouplingStageEvaluation states each value's behaviour). per_stage is required to match reference integrators for stiff, chaotic or multistable systems, where the frozen-coupling error can select a different trajectory or attractor." ;
            sh:in ( "per_stage" "per_step" ) ;
            sh:maxCount 1 ;
            sh:order 19 ;
            sh:path tvbo:coupling_evaluation ] ;
    sh:targetClass tvbo:Integrator .

tvbo:Mesh a sh:NodeShape ;
    rdfs:comment "Triangle (or higher-order) mesh geometry. May stand alone (via ``mesh_file`` pointing at an external GIFTI/VTK/MSH file) OR be inlined on a Network as ``Network.mesh``. In the inlined-on-Network case, the vertices are the parent Network's ``nodes/coordinates`` (so ``coordinates`` here may be left empty), the faces live in the same h5 companion under a path given by ``elements`` (default ``mesh/faces``), and optional per-vertex ``normals`` / ``curvature`` live alongside. The optional ``parcel_map_field`` points at the parent Network's per-vertex parcel-id array (default ``nodes/parent_index`` from the hierarchical-Network pattern, see Network.qmd §7.1)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "When the mesh is inlined on a Network with a parcellation, the dotted path inside the parent's h5 to the per-vertex parcel id array. Default: ``nodes/parent_index``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:parcel_map_field ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of vertices in the mesh." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:number_of_vertices ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Transformation> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path tvbo:coordinate_space ],
        [ sh:class tvbo:Parcellation ;
            sh:description "Brain parcellation this mesh's parcel_map indexes into. Inlined to match Network.parcellation's existing pattern. When the mesh is inlined on a Network that already declares ``parcellation``, this slot is optional and defaults to the parent's value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path tvbo:parcellation ],
        [ sh:datatype xsd:string ;
            sh:description "Add the location of the data file containing the parcellation terminology." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            sh:description "Node coordinates (x,y,z) in the given coordinate space." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:coordinates ],
        [ sh:datatype xsd:string ;
            sh:description "Explicit format override (gifti, freesurfer, meshio, vtk, gmsh). Auto-detected from extension if null." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:mesh_format ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of elements (triangles, quads, tetrahedra, etc.)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:number_of_elements ],
        [ sh:datatype xsd:string ;
            sh:description "Path to external mesh file (GIFTI, VTK, MSH, FreeSurfer, etc.)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:mesh_file ],
        [ sh:datatype xsd:string ;
            sh:description "Topology indices: either a file reference, or (when inlined on a Network) a dotted path inside the parent Network's h5 companion to the (M, 3) int triangle face array. Default convention: ``mesh/faces``. A network saved with CSV companions names the CSV holding them here." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:elements ],
        [ sh:datatype xsd:string ;
            sh:description "Optional path to per-vertex curvature (N,) float. Default convention: ``mesh/curvature``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:curvature ],
        [ sh:datatype xsd:string ;
            sh:description "When the mesh is inlined on a Network, the dotted path inside the parent's h5 to vertex coordinates, or a file holding them. Default: ``nodes/coordinates``. A network saved with CSV companions names the CSV holding them here." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:vertices_field ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:in ( "triangle" "quad" "tetrahedron" "hexahedron" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path tvbo:element_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Optional path inside the parent Network's h5 (or an external file) to per-vertex normals (N, 3) float. Default convention: ``mesh/normals``. A network saved with CSV companions names the CSV holding them here." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:normals ] ;
    sh:targetClass tvbo:Mesh .

tvbo:Network a sh:NodeShape ;
    rdfs:comment "Network specification with nodes, edges, and reusable coupling configurations. Supports both explicit node/edge representation and matrix-based connectivity (Connectome compatibility)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:parameters ],
        [ sh:datatype xsd:string ;
            sh:description "BEP017 measure names for structural connectivity (e.g., streamlineCount, tractLength)" ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path tvbo:structural_measures ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of nodes in the network, derived from `nodes` when it lists them. Beside a source (an `iri`, a `data_file`, a `bids_dir` or the curated network of a `parcellation`) it is the number of the source's nodes the network keeps: all of them at the source's own count, and below it a random subset drawn once at build from `execution.random_seed`, which `node_selection` then names. A count above the source's is refused." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:number_of_nodes ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Path to companion data file: .h5 (HDF5) or .zarr/ (Zarr), which hold every array under its path, or .csv. A network saved with CSV companions has one CSV per array, each named on the record of what it holds (``Edge.data_file``, the ``source`` of a parameter, the fields of ``mesh``), and names the first of them here. A .csv here that no record names is a companion written when a CSV held one matrix: it holds the first template edge's matrix, or the weights when none is declared, and every other declared layer reads as missing. Null if no companion data needed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path tvbo:data_file ],
        [ sh:class tvbo:Dynamics ;
            sh:description "Dictionary of dynamics models keyed by name. Nodes reference these by name. For heterogeneous networks with per-node dynamics." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path tvbo:dynamics ],
        [ sh:datatype xsd:string ;
            sh:description "The schema version a file was written against — the envelope `Document` declares." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path tvbo:schema_version ],
        [ sh:description "Unit of every time-valued number in this scope — the step size, any period, and the physical meaning of one model time-step. Declared at whichever scope owns the clock (network, integrator, observation); `tvbo.utils.units.time_unit_of` resolves a scope to its effective unit by walking outwards, and states the `ms` fallback once, at the end of that walk. Deliberately carries no default: a defaulted slot cannot be inherited through, so `ifabsent: ms` made an unset unit indistinguishable from one someone wrote, and masked an explicitly declared `s` one scope out. `time_scale` is accepted as a synonym." ;
            sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path tvbo:time_unit ],
        [ sh:class tvbo:Edge ;
            sh:description "List of directed edges with coupling references (optional, for explicit edge definition)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path tvbo:edges ],
        [ sh:datatype xsd:string ;
            sh:description "Path to BEP017-compliant BIDS directory for loading connectivity matrices" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path tvbo:bids_dir ],
        [ sh:class tvbo:Integrator ;
            sh:description "Clock this network's nodes run on. A subnetwork declaring its own is how a finer scale runs on a finer step than its parent: the fold reads both and converts between their `time_unit`, since a factor of 1000 living only in a modeller's head is invisible in every backend's output." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:integration ],
        [ sh:class tvbo:Function ;
            sh:description "Ordered list of transforms applied to edge property matrices. Each entry rewrites the edge property its `output:` names, else the one its `name:` is (e.g. 'weight', 'length'), and that property is also the value under transform inside the entry's own equation, which is written over the network's edge attributes. Supports equation-based (symbolic) or callable-based (software) transforms. Multiple transforms on the same target are applied sequentially, each seeing the previous one's output; since `name:` identifies an entry, each after the first states the target as its `output:`." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path tvbo:transforms ],
        [ sh:class tvbo:GraphGenerator ;
            sh:description """Graph generator specification.  When set, overrides explicit edges/nodes for graph construction.  The type field is a free string; StandardGraphType lists well-known types that get automatic code generation across backends.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path tvbo:graph_generator ],
        [ sh:class tvbo:Edge ;
            sh:description "Default Edge attributes applied to every Edge in this Network. Explicit entries in `edges:` override the template field-by-field. Reserved per-Edge slots (source, target, weight, delay, distance) come from the data backbone (loaded matrix or procedural generator) and are ignored if set on the template." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path tvbo:edge_template ],
        [ sh:class tvbo:Mesh ;
            sh:description "Optional triangle mesh geometry. When set, the Network carries triangle faces (and optionally normals, curvature) alongside its node coordinates. Used by surface-based observations (cortical wave detection, Helmholtz-Hodge decomposition, spectrospatial mode analysis). Mesh face data lives in the same h5 companion under a ``mesh/`` group." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path tvbo:mesh ],
        [ sh:class tvbo:NodeSelection ;
            sh:description "Makes this network a subset by node of what it declares (``NodeSelection``): the nodes to keep or to drop, named by label. Everything else is as declared, so a network that includes another and adds a selection is that network without some of its nodes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path tvbo:node_selection ],
        [ sh:class tvbo:Tractogram ;
            sh:description "Reference to tractography data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path tvbo:tractogram ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Transformation> ;
            sh:description "Coordinate space for node positions (e.g., MNI152NLin2009cAsym). Mirrors BrainAtlas.coordinateSpace so network node positions are unambiguous." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path tvbo:coordinate_space ],
        [ sh:datatype xsd:string ;
            sh:description "BEP017 measure names for observational targets (e.g., BoldCorrelation)" ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path tvbo:observational_measures ],
        [ sh:class tvbo:NodeTemplate ;
            sh:description "Default Node attributes applied to every Node in this Network. Explicit entries in `nodes:` override the template field-by-field (shallow replace, same semantics as `dict.update`). The per-Node slots (id, label, position, region) come from the data backbone (Network.iri-loaded parcellation or procedural generator) and are no template slots, so a template that sets one is refused, naming it. Lets a homogeneous Network declare its per-Node configuration once without enumerating regions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path tvbo:node_template ],
        [ sh:class tvbo:Node ;
            sh:description "List of nodes with individual dynamics (optional, for heterogeneous networks)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:nodes ],
        [ sh:datatype xsd:string ;
            sh:description "HDF5 dataset path for node-to-parent mapping. Int32 array of shape (N,) where entry i is the parent node ID. Required when parent_network is set." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path tvbo:node_mapping ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the edge whose matrix is the network's weights: ``matrix(\"weight\")`` reads it, and a save writes the weights under it. Lets a single Network sidecar bundle several connectivity variants (e.g. band-specific NMF reweightings, distance-modulated SC, shuffled controls) under different edge names while presenting one of them as the weights to consumers (simulators, observation pipelines). Without it the weights are the ``weight`` edge; a network that holds its weights under another name (``sc``, ``weights``) declares that name here, and is refused naming the edge until it does." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:primary_weight ],
        [ sh:class tvbo:Coupling ;
            sh:description "How activity travels along this network's connections — the one place a coupling function is declared, because a coupling acts over a connectivity and has no meaning without one. Keyed by the role each plays in the network ('excitatory', 'delayed', 'inhibitory'), so a network may carry several and an edge names the one it uses. A network with a single coupling applies it to every edge." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path tvbo:coupling ],
        [ sh:datatype xsd:string ;
            sh:description "Short alphanumeric identifier for the BIDS desc- filename entity (e.g., SC, FC, EC, SCFC). Classifies the connectivity modality of the network's edge measures." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path tvbo:descriptor ],
        [ sh:class tvbo:File ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path tvbo:edge_matrix_files ],
        [ sh:datatype xsd:string ;
            sh:description "Path/URI to parent (coarser) Network. When set, this network is a refinement where each node maps to exactly one parent node via node_mapping." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path tvbo:parent_network ],
        [ sh:defaultValue "auto" ;
            sh:description "Representation used to evaluate coupling over this network's connectivity (``auto`` | ``dense`` | ``sparse``). ``auto`` lets the backend choose by connection density. This names whether to exploit edge sparsity, not a concrete data structure, so it is backend-independent; the delayed-vs-instantaneous graph kind is decided separately from the couplings' conduction delays." ;
            sh:in ( "auto" "dense" "sparse" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path tvbo:graph_representation ],
        [ sh:class tvbo:Parcellation ;
            sh:description "Brain parcellation/atlas reference" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path tvbo:parcellation ],
        [ sh:class tvbo:BidsEntities ;
            sh:description "BIDS filename entities for this dataset" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path tvbo:bids ],
        [ sh:class tvbo:Provenance ;
            sh:description "W3C PROV-O aligned provenance for this entity — what it was derived from, which agent produced it, and when." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path tvbo:provenance ],
        [ sh:defaultValue "mm" ;
            sh:description "Unit for distances/lengths in the network" ;
            sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ;
            sh:maxCount 1 ;
            sh:order 29 ;
            sh:path tvbo:distance_unit ],
        [ sh:datatype xsd:string ;
            sh:description "The class a file holds, as a CURIE (``tvbo:Network``) — the envelope `Document` declares." ;
            sh:in ( "tvbo:Network" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path tvbo:tvbo_class ;
            sh:pattern "^tvbo:[A-Z][A-Za-z0-9]*$" ] ;
    sh:targetClass tvbo:Network .

tvbo:Noise a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Seed for the noise the settle integrates, when the settle runs as its own scan. Absent -- the default -- leaves the settle on whatever stream its solver hands it, which is what an unmodified upstream warm start does; the backend is not silently given a different draw than the reference implementation it is checked against. Present means the settle uses exactly this seed. Both interesting cases are then sayable: equal to `seed` puts the two scans on one stream, and different from it decorrelates them. Equal is not neutral -- where the two scans take the same number of steps a shorter draw is a prefix of a longer one, so the measured noise repeats the settle's sample for sample, and corr(settle, measured) on demeaned fluctuations is +0.49 against -0.01 decorrelated. Its effect on the reported statistics was null everywhere it was measured (FC bias below 0.03 sigma, no trend), so this slot exists to make the choice visible and reproducible rather than because either answer is known to be wrong." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:settle_seed ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 42 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:seed ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path tvbo:parameters ],
        [ sh:class tvbo:RandomStream ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path tvbo:random_state ],
        [ sh:class tvbo:StateVariable ;
            sh:description "State variables this noise applies to; if omitted, applies globally." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path tvbo:targets ],
        [ sh:datatype xsd:boolean ;
            sh:description "Deprecated. Whether the noise is correlated, without saying across which axis or by how much. Use `covariance` + `correlated_over`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:correlated ],
        [ sh:class tvbo:Parameter ;
            sh:description "Covariance of the unit-intensity noise increment across the axis named by `correlated_over` — the second-order structure of the driving process, stated as mathematics rather than as a factorisation. Must be square in that axis, symmetric and positive semi-definite; its diagonal carries per-element variances and need NOT be unity, so unequal variances and cross-element correlation are expressed together. The realised increment is the declared sigma times a draw from this covariance, so `parameters: {sigma: ...}` continues to mean what it means for uncorrelated noise. Absent (the default) means the increment is independent across that axis. Being a `Parameter`, it carries the full provenance triple: a literal `value:`, existing bytes via `source:`+`measure:`, or — the usual case for a derived operator — `producer:`, whose FunctionCall records how the structure was obtained (projecting a spatially white field into a modal basis, spreading independent per-region drives through a connectome). The generative account therefore lives in the provenance, and the matrix itself stays a statement about the process. How a backend samples it (Cholesky, eigendecomposition, whitening) is a backend concern and is never stated here." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:covariance ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "gaussian" ;
            sh:description "Temporal character of the process: `gaussian`/`white` (delta-correlated in time) or `ou`/`ornstein-uhlenbeck` (exponentially correlated in time). Governs the TIME axis only, and composes freely with `covariance`, which governs a spatial axis." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:noise_type ],
        [ sh:class tvbo:Function ;
            sh:description "Optional functional form of the noise (callable specification)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path tvbo:function ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Indicates whether the noise is additive" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:additive ],
        [ sh:class tvbo:Distribution ;
            sh:description "Optional probability distribution from which the noise draws its samples. When set, takes precedence over the `noise_type` / `gaussian` flags — any Distribution family is accepted (Uniform { lo, hi }, Normal { mean, std }, LogNormal { mu, sigma }, Beta, …). Reuses the existing Distribution class also used by Parameter.distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path tvbo:distribution ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicates whether the noise is Gaussian" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:gaussian ],
        [ sh:datatype xsd:string ;
            sh:description "Inline Python code representation of the noise process." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:pycode ],
        [ sh:description "Which axis `covariance` indexes — `node` (equivalently `region`) for spatially correlated drive, or `state` for correlation between the noise on different state variables. Required whenever `covariance` is set: a covariance without a named axis does not identify a process. A multi-mode model carries its modes inside the state axis, so a modal covariance is declared over `state`." ;
            sh:in ( "time" "state" "node" "region" "mode" "sample" "batch" "frequency" "subject" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path tvbo:correlated_over ],
        [ sh:class tvbo:Equation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path tvbo:Equation ] ;
    sh:targetClass tvbo:Noise .

tvbo:Event a sh:NodeShape ;
    rdfs:comment "A discrete or continuous event that modifies the system during simulation. Generalizes Stimulus: can represent external inputs (stimulus type), threshold-triggered state changes (continuous/discrete type), or time-scheduled interventions (preset_time type). Attaches to components (nodes/edges) or to the experiment level." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Path to a data file (.npy) holding the stimulus waveform of a *data-driven* stimulus event — the samples are interpolated at simulation time instead of evaluating `equation`. 1-D arrays are a single time-series broadcast to the targeted `nodes`; the event's `name` is still the symbol injected into the dynamics." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path tvbo:dataLocation ],
        [ sh:class tvbo:Parameter ;
            sh:description "Per-node stimulus weighting supplied as a Parameter, so a DERIVED weighting carries its provenance instead of being inlined as a list of numbers. Use it when the weighting is measured or computed rather than hand-listed: `source:` + `measure:` names the stored array, `producer:` names the call that builds it (an ROI mask projected through a basis, a retinotopic map, a measured stimulation field). This is the same provenance triple every other external array uses, so a spatial stimulus pattern is described by where it came from rather than by a literal a reader cannot check. Resolved at load time into the per-node `weights`, aligned with `nodes` exactly as a literal weighting is; mutually exclusive with `weight_distribution`, and a literal `weights` wins over both." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path tvbo:weight_parameter ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Parameter symbols accessible in the condition function." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:condition_parameters ],
        [ sh:datatype xsd:string ;
            sh:description "Parameter symbols modifiable in the affect function." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:affect_parameters ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Sample rate of the `dataLocation` waveform in samples per millisecond (e.g. 1.0 = 1 kHz). Sample i is placed at time i / sampling_rate ms." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path tvbo:sampling_rate ],
        [ sh:datatype xsd:string ;
            sh:description "Component to attach this event to. Can be a node label, edge label, or 'all_edges'/'all_vertices' for broadcast. If not specified, event is experiment-level." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:target_component ],
        [ sh:class tvbo:Equation ;
            sh:description "Condition function. For continuous events: triggers when expression crosses zero. For discrete events: triggers when expression evaluates to true. Not used for preset_time or stimulus types." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:condition ],
        [ sh:datatype xsd:string ;
            sh:description "State variable symbols modifiable in the affect function." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:affect_states ],
        [ sh:class tvbo:Equation ;
            sh:description "Stimulus equation for stimulus-type events. Legacy compatibility with Stimulus class." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path tvbo:equation ],
        [ sh:datatype xsd:string ;
            sh:description "State variable that a stimulus-type event drives — the variable its signal is injected into (e.g. 'y_0' for Jansen-Rit, or a named 'stimulus' input exposed to coupling). If absent, the stimulus adds to the model's default external-input variable." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path tvbo:target_variable ],
        [ sh:defaultValue "stimulus" ;
            sh:description "Type of event trigger mechanism." ;
            sh:in ( "continuous" "discrete" "preset_time" "stimulus" "stimulation" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path tvbo:event_type ],
        [ sh:class tvbo:Equation ;
            sh:description "Affect on downcrossing (continuous events only). If not specified, uses the same affect for both crossings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path tvbo:affect_negative ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:float ;
            sh:description "Duration of stimulus-type events." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path tvbo:duration ],
        [ sh:class tvbo:Equation ;
            sh:description "Affect function: what happens when the event triggers. Can modify state variables and/or parameters. For stimulus type, this is the stimulus equation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:affect ],
        [ sh:datatype xsd:integer ;
            sh:description "Network nodes a stimulus-type event is applied to (node ids / indices). Pairs with `weights`. (Formerly `regions`.)" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:nodes ],
        [ sh:datatype xsd:float ;
            sh:description "Predetermined trigger times for preset_time events. The solver will step exactly to these times." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:trigger_times ],
        [ sh:datatype xsd:string ;
            sh:description "State variable symbols accessible in the condition function. For edges, can include source/destination vertex outputs." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:condition_states ],
        [ sh:datatype xsd:float ;
            sh:description "Per-node stimulus weighting, aligned with `nodes`. (Formerly `weighting`.)" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:weights ],
        [ sh:class tvbo:Distribution ;
            sh:description "Distribution to sample per-region stimulus weights from, as an alternative to the explicit `weighting` array (e.g. Uniform(-1, 1) per node). When set, the codegen samples one weight per target region using the distribution's seed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path tvbo:weight_distribution ],
        [ sh:datatype xsd:string ;
            sh:description "Regions a stimulus-type event targets: 'all' (broadcast to every node) or explicit region labels / indices. More expressive than the integer-only `regions` slot; when both are absent the event applies to all regions." ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path tvbo:target_regions ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "linear" ;
            sh:description "Interpolation for a data-driven stimulus: 'linear' or 'cubic'." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path tvbo:interpolation ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:parameters ] ;
    sh:targetClass tvbo:Event .

tvbo:Inset a sh:NodeShape ;
    rdfs:comment "A sub-axes that draws exactly as a panel does — same kinds, layers, opts, annotations — minus the things only a mosaic cell has (a panel letter, a placeholder, a position in the layout). One class for both an inset and a grid cell, so a cell cannot behave unlike the inset beside it; they differ only in who positions them." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Rule ;
            sh:description "Straight reference lines drawn across the panel: a zero, a threshold, the identity line of a target-versus-simulated plot. Each carries its own colour and dash, so a rule and the way it is drawn cannot be stated apart." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 49 ;
            sh:path tvbo:rules ],
        [ sh:datatype xsd:float ;
            sh:description "Gap in points between the x axis label and its tick numbers, for where the default lets the two touch. Unset takes the theme's `label_pad`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path tvbo:xlabel_pad ],
        [ sh:description "Which edge the y axis LABEL sits on. See `xlabel_side`." ;
            sh:in ( "left" "right" "top" "bottom" ) ;
            sh:maxCount 1 ;
            sh:order 29 ;
            sh:path tvbo:ylabel_side ],
        [ sh:class tvbo:Graph ;
            sh:description "Graph and colour scale of a `kind: network` panel. Ignored by every other kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 45 ;
            sh:path tvbo:network ],
        [ sh:datatype xsd:string ;
            sh:description "Name of a registered custom-panel callable (custom kind) — the same registry the host panel draws from." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:render ],
        [ sh:datatype xsd:string ;
            sh:description "The y axis label. See `xlabel`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path tvbo:ylabel ],
        [ sh:datatype xsd:float ;
            sh:description "The depth range of a 3-D panel, `[min, max]`. Ignored by every flat kind." ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path tvbo:zlim ],
        [ sh:description "A key for this panel's own marks. `legend: true` draws it wherever the backend finds room, `legend: upper right` fixes the corner, and the object form states the rest — frame, columns, title. All three are one slot, so a panel that starts with a corner and later needs two columns keeps the word it had. Distinct from `kind: legend`, a standalone legend PANEL that occupies a cell of its own." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:class tvbo:Legend ] [ sh:datatype xsd:boolean ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 41 ;
            sh:path tvbo:legend ],
        [ sh:datatype xsd:float ;
            sh:description "[x0, y0, width, height] in host-axes fractions, as matplotlib's inset_axes takes them. Values outside 0-1 place the inset beyond the host frame, which is how a thumbnail sits in the margin above a plot. Required of an inset, and left unset by a `grid` cell, whose bounds the grid computes from the row/column it lands in." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:bounds ],
        [ sh:class tvbo:Inset ;
            sh:description "What every cell of a `grid` is: the kind they all draw, and the opts they share. Each entry in `layers:` then fills one cell with this template, which is why a grid of twenty surfaces needs the surface declared once. Its `bounds` stay unset — the grid positions its cells." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path tvbo:cell ],
        [ sh:description "Which edge the x ticks sit on." ;
            sh:in ( "left" "right" "top" "bottom" ) ;
            sh:maxCount 1 ;
            sh:order 19 ;
            sh:path tvbo:xtick_side ],
        [ sh:class tvbo:Annotation ;
            sh:description "Positioned text labels drawn on the inset, in ITS axes fractions." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 54 ;
            sh:path tvbo:annotations ],
        [ sh:datatype xsd:float ;
            sh:description "The x range, `[min, max]`. Declared rather than inferred, because two panels a figure asks the reader to compare must not end up on whatever ranges their own data happened to reach." ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path tvbo:xlim ],
        [ sh:datatype xsd:boolean ;
            sh:description "Keep the position the layout engine gave this panel, rather than letting a later pass move it. For a panel whose position carries meaning — aligned with the one above it, or sized to match a sibling." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 47 ;
            sh:path tvbo:fill_cell ],
        [ sh:class tvbo:Inset ;
            sh:description "A `grid`'s cells stated one at a time, for a grid whose cells differ — a first cell showing the bare mesh the rest are maps on, or a row pairing two kinds. Each is merged over `cell:`, and carries its own layers. Mutually exclusive with `layers:`, which is the compact form of the same thing." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:cells ],
        [ sh:class tvbo:Region ;
            sh:description "Rectangles ringing the windows this panel calls out — the parameter band a regime lives in, the interval a statistic was taken over." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 50 ;
            sh:path tvbo:regions ],
        [ sh:datatype xsd:float ;
            sh:description "Gap in points between the y axis label and its tick numbers. See `xlabel_pad`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path tvbo:ylabel_pad ],
        [ sh:description "The DATA aspect ratio: `equal` — one unit of x is one unit of y, what a matrix or a spatial map needs — or `auto` to fill the cell, or a number. `box_aspect` shapes the frame instead." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 35 ;
            sh:path tvbo:aspect ],
        [ sh:datatype xsd:float ;
            sh:description "Gap in points between the z axis label and its tick numbers. See `xlabel_pad`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path tvbo:zlabel_pad ],
        [ sh:class tvbo:Colorbar ;
            sh:description "The colour scale printed beside this panel's field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 42 ;
            sh:path tvbo:colorbar ],
        [ sh:class tvbo:Grid ;
            sh:description "How a `kind: grid` panel tiles its cells. Ignored by every other kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 46 ;
            sh:path tvbo:grid ],
        [ sh:description "Drop the first, last, or both end ticks, for the case where a corner tick collides with its neighbour panel's." ;
            sh:in ( "lower" "upper" "both" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path tvbo:tick_prune ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the y axis descending — the matrix convention, row 0 at the top." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path tvbo:invert_y ],
        [ sh:description "How y tick numbers are written." ;
            sh:in ( "sci" "plain" ) ;
            sh:maxCount 1 ;
            sh:order 18 ;
            sh:path tvbo:ytick_format ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the depth axis of a 3-D panel descending." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path tvbo:invert_z ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the panel keeps its frame and its ticks. `false` strips both, for a panel with no measurable axis: an image, a schematic, a connectivity matrix shown as a picture. Unset keeps them." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path tvbo:frame ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the x axis descending." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path tvbo:invert_x ],
        [ sh:class tvbo:Camera ;
            sh:description "Viewpoint for a 3-D panel or a surface. Ignored by every flat kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 51 ;
            sh:path tvbo:camera ],
        [ sh:datatype xsd:float ;
            sh:description "Length of this panel's tick marks in points, overriding the theme's." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:tick_length ],
        [ sh:datatype xsd:string ;
            sh:description "The x axis label, as the figure prints it — unit included, LaTeX included. Unset leaves the renderer's own, which is the encoded field's bare name: right for a working figure, wrong for a printed one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path tvbo:xlabel ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the x ticks without their numbers. Declare `share_x` on the figure alongside it: hiding the numbers alone asserts a shared scale the axes may not have, and a reader then compares two panels drawn at different ranges." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:hide_xticklabels ],
        [ sh:description "How x tick numbers are written: `sci` forces scientific notation, `plain` forbids it." ;
            sh:in ( "sci" "plain" ) ;
            sh:maxCount 1 ;
            sh:order 17 ;
            sh:path tvbo:xtick_format ],
        [ sh:datatype xsd:float ;
            sh:description "The x tick positions, stated outright. Unset lets the locator choose them." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:xticks ],
        [ sh:in ( "cartesian" "heatmap" "line3d" "surface" "volume" "grid" "colorbar" "legend" "network" "image" "custom" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path tvbo:kind ],
        [ sh:datatype xsd:float ;
            sh:description "Rotate the x tick labels, in degrees counter-clockwise. Worth reaching for when a dense row would otherwise run its numbers together: a slanted label is anchored at its tick rather than centred under it, so it costs width it would otherwise steal from its neighbour." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:xtick_rotation ],
        [ sh:datatype xsd:float ;
            sh:description "Rotate the y tick labels, in degrees counter-clockwise." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:ytick_rotation ],
        [ sh:datatype xsd:float ;
            sh:description "Tick-label size in points, overriding the figure's `font_size` for this panel's ticks alone." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:tick_size ],
        [ sh:description "How the x axis maps values to distance." ;
            sh:in ( "linear" "log" "symlog" "logit" ) ;
            sh:maxCount 1 ;
            sh:order 33 ;
            sh:path tvbo:xscale ],
        [ sh:datatype xsd:integer ;
            sh:description "Upper bound on the number of ticks per axis. The lever to reach for when a dense mosaic runs its numbers together." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:nbins ],
        [ sh:datatype xsd:string ;
            sh:description "The depth axis label of a 3-D panel. Ignored by every flat kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path tvbo:zlabel ],
        [ sh:class tvbo:Argument ;
            sh:description "The keyword options of a `custom` callable, and of the kinds that carry their own option family — a `surface`/`volume`/`network` panel's geometry, a colorbar's. No part of how an axis is DRAWN belongs here: the labels, limits, scales, shape and legend are slots on the panel itself, the tick family sits beside them, and `rules`, `regions` and `camera` carry the marks that travel with a colour. The renderer refuses a retired name here rather than passing it into the emitted script, and names the slot that replaced it." ;
            sh:nodeKind sh:IRI ;
            sh:order 52 ;
            sh:path tvbo:opts ],
        [ sh:description "Which edge the y ticks sit on." ;
            sh:in ( "left" "right" "top" "bottom" ) ;
            sh:maxCount 1 ;
            sh:order 20 ;
            sh:path tvbo:ytick_side ],
        [ sh:class tvbo:Volume ;
            sh:description "Geometry and colour scale of a `kind: volume` panel. Ignored by every other kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 44 ;
            sh:path tvbo:volume ],
        [ sh:datatype xsd:float ;
            sh:description "The frame's height over its width, independent of the data ranges: a square panel over data that is not square. `aspect` constrains the data instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path tvbo:box_aspect ],
        [ sh:datatype xsd:boolean ;
            sh:description "Draw the y ticks without their numbers. Same rule as `hide_xticklabels`, with `share_y`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:hide_yticklabels ],
        [ sh:datatype xsd:string ;
            sh:description "External image file (image kind)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 53 ;
            sh:path tvbo:path ],
        [ sh:datatype xsd:integer ;
            sh:description "Cells of blank left along the diagonal between two `triangle` layers, so the two halves of a split matrix read as two quantities rather than one image." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 48 ;
            sh:path tvbo:triangle_gap ],
        [ sh:datatype xsd:float ;
            sh:description "The y tick positions, stated outright." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:yticks ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "A heading above the panel, in the panel's own words. A panel LETTER is not a title — that is `number`, which the layout places and sizes to the journal's convention." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path tvbo:title ],
        [ sh:description "Which edge the x axis LABEL sits on. The tick numbers stay where `xtick_side` puts them, so a label can cross to the far side of a panel whose ticks do not follow it." ;
            sh:in ( "left" "right" "top" "bottom" ) ;
            sh:maxCount 1 ;
            sh:order 28 ;
            sh:path tvbo:xlabel_side ],
        [ sh:class tvbo:Surface ;
            sh:description "Geometry and colour scale of a `kind: surface` panel. Ignored by every other kind." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 43 ;
            sh:path tvbo:surface ],
        [ sh:datatype xsd:float ;
            sh:description "The y range, `[min, max]`. See `xlim`." ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path tvbo:ylim ],
        [ sh:class tvbo:Layer ;
            sh:description "Marks sharing the inset's axes. Grammar kinds only." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:layers ],
        [ sh:description "How the y axis maps values to distance." ;
            sh:in ( "linear" "log" "symlog" "logit" ) ;
            sh:maxCount 1 ;
            sh:order 34 ;
            sh:path tvbo:yscale ] ;
    sh:targetClass tvbo:Inset .

tvbo:Observation a sh:NodeShape ;
    rdfs:comment "Unified class for all observation/measurement specifications. Covers monitors (BOLD, EEG), tuning observables, and derived quantities. Pipeline is a sequence of Functions with input -> output flow." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Ordered list of inputs this observation derives from. Each entry is either a StateVariable reference (raw observation of an integrated trajectory, e.g. ``S_e``) or an Observation reference (derived observation, e.g. ``bold``). Codegen checks each source name against ``experiment.observations``; names matching an existing observation flag the parent as derived." ;
            sh:or ( [ sh:class tvbo:StateVariable ] [ sh:class tvbo:Observation ] ) ;
            sh:order 13 ;
            sh:path tvbo:source ],
        [ sh:class tvbo:Analysis ;
            sh:description "Marks this observation as an analysis observable that operates on the solve/loss rather than a result-data pipeline (autodiff gradient, finite-difference gradient, or Lyapunov spectrum)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 34 ;
            sh:path tvbo:analysis ],
        [ sh:class tvbo:ClassReference ;
            sh:description "Direct class reference (alternative to pipeline). Use for external library classes like tvboptim.Bold, custom monitors, or any callable class. The class is instantiated with constructor_args and called with call_args. Example: {name: Bold, module: tvboptim.observations.tvb_monitors.bold, constructor_args: [{name: period, value: 1000.0}]}" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 33 ;
            sh:path tvbo:class_reference ],
        [ sh:datatype xsd:integer ;
            sh:description "Variable of interest index (which state variable to monitor). Default: 0." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:voi ],
        [ sh:class tvbo:Function ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path tvbo:functions ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether to include this element in simulation output files. Applicable to state variables (default true), derived variables (default false), and network nodes (default true). On an observation it forces (true) or suppresses (false) persistence in the result; left unset, a terminal observation (one not consumed by another observation or a loss) is recorded and an intermediate one is not. Set false to suppress recording." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:record ],
        [ sh:class tvbo:DataSource ;
            sh:description "Load data from external source (file, database, API). When specified, this observation represents empirical/external data rather than simulated data. Enables unified treatment of all data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path tvbo:data_source ],
        [ sh:datatype xsd:float ;
            sh:description "Intermediate downsampling period (ms). For BOLD: typically matches dt." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path tvbo:downsample_period ],
        [ sh:class tvbo:Partition ;
            sh:description "Marks a grouped streaming reduction over a node partition (e.g. per-hemisphere cortical wave metrics): the observer `dynamics` body is vmapped over the partition axis and folded to per-group scalar metrics. Requires `period` (the downsample) and an observer whose derived variables produce the per-group outputs named by the Partition. See Partition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path tvbo:partition ],
        [ sh:class tvbo:Range ;
            sh:description "Bin spec (`lo`, `hi`, `n`) for a streaming order-statistic aggregation (`aggregation: median`). Should span the expected value range of the reduced per-step quantity; the quantile is linearly interpolated within the crossing bin. Only used by the streaming-median reduction path." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path tvbo:histogram ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:description "How to aggregate over time" ;
            sh:in ( "mean" "median" "variance" "std" "first_passage" "last" "first" "window" "none" ) ;
            sh:maxCount 1 ;
            sh:order 26 ;
            sh:path tvbo:aggregation ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path tvbo:parameters ],
        [ sh:description "Opt into streaming evaluation of this observation: fold it into the integrator carry as an (init, update, finalize) reducer via prepare(reduce=...) instead of computing it post-scan from a materialised trajectory. Byte-identical to the pipeline value (to f64 rounding) but with O(block) instead of O(n_time) peak memory, so a fit whose per-stage simulation is too long to hold the trajectory (e.g. the Schirner 2023 group fit) can still evaluate it. Supported for the HRF-Volterra BOLD pipeline (the resolver lifts the HRF kernel, downsample stride, TR stride and Volterra k_1/V_0 from the declared pipeline), for cumulative mean/std/variance aggregations, and for a matrix co-moment FC (compute_fc as a running covariance emitted at finalize, never a trajectory). Byte-identical holds noise-off; with a per-block noise draw the realization shifts with block size (ergodically vanishing). Absent (the default) keeps the post-scan pipeline unchanged — no other observation or experiment is affected." ;
            sh:in ( "streaming" "trials" ) ;
            sh:maxCount 1 ;
            sh:order 32 ;
            sh:path tvbo:reduce ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ],
        [ sh:description "Physical unit of measurement. `UnitEnum` is the curated vocabulary — each of its values is vendored from QUDT (`ontology/tvb-o-units.ttl`) and can be reasoned about dimensionally. The range is deliberately open beyond it: a unit nobody has curated yet is recorded as written and reported `uncurated`, because a closed range forces the author to either misdeclare the quantity or leave it undeclared, and both lose more than an unrecognised string does. An uncurated unit carries no dimensional claim, so a check involving it reports `underdetermined` rather than guessing. Promote one with `tvbo units add <unit>`, which pulls its QUDT record into the vendored module — so every unit TVBO *reasons* about stays authoritative, and only what it *records* is open." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 10 ;
            sh:path qudt:unit ],
        [ sh:defaultValue "by_label" ;
            sh:description "How a dataset-sourced target's nodes are aligned to the model network before comparison. ``by_label`` selects the shared node labels on both sides by name (keyed ``.sel``), never by position, so a differing node count or order cannot silently misalign the comparison. Matching is alias-aware: a target label matches a model node when it equals that node's ``label`` or any of its ``alternateName`` entries, so a differing nomenclature reconciles without relabelling either side. ``none`` disables reconciliation (identical node sets)." ;
            sh:in ( "by_label" "none" ) ;
            sh:maxCount 1 ;
            sh:order 22 ;
            sh:path tvbo:reconcile ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of samples from the end to use. Takes the last N samples before aggregation. E.g., tail_samples: 500 means use data[-500:]. Prefer `tail_duration` when the window means a duration — a sample count silently rescales when the step size changes. On an algorithm's observation it must fit within one `simulation_period`; a window across iterations is a `tail_duration`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path tvbo:tail_samples ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:references ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum fraction of the model network's nodes that a ``by_label`` reconciliation must cover, else resolution raises. The realised coverage is always logged. Absent (``null``) means require full coverage (``1.0``) for a dataset-sourced target — silently fitting on a partial node subset must be an explicit opt-in (e.g. ``0.95`` to tolerate a few genuinely-missing empirical parcels), never the default." ;
            sh:maxCount 1 ;
            sh:maxInclusive 1e+00 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path tvbo:min_coverage ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:notation ],
        [ sh:description "Unit of every time-valued number in this scope — the step size, any period, and the physical meaning of one model time-step. Declared at whichever scope owns the clock (network, integrator, observation); `tvbo.utils.units.time_unit_of` resolves a scope to its effective unit by walking outwards, and states the `ms` fallback once, at the end of that walk. Deliberately carries no default: a defaulted slot cannot be inherited through, so `ifabsent: ms` made an unset unit indistinguishable from one someone wrote, and masked an explicitly declared `s` one scope out. `time_scale` is accepted as a synonym." ;
            sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path tvbo:time_unit ],
        [ sh:class tvbo:BidsEntities ;
            sh:description "BIDS entity filter that selects one per-subject file under the experiment's ``dataset.bids_root`` when ``source`` is dataset-sourced (``dataset.subject.<measure>``). The active subject fills the ``sub-`` entity at resolution time; the remaining entities (e.g. ``desc: FCavg, atlas: Schaefer1000, suffix: relmat``) disambiguate among the subject's several networks/measurements. The same filter enumerates the cohort for the per-subject workflow fan-out, so one declaration drives both discovery and resolution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path tvbo:query ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareEnvironment> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:environment ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of samples for windowed aggregation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path tvbo:window_size ],
        [ sh:datatype xsd:float ;
            sh:description "Sampling period for monitors (ms). For BOLD: TR in ms." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:period ],
        [ sh:class tvbo:Dynamics ;
            sh:description "Auxiliary state system co-integrated with the model to compute this observation online, so the full trajectory need never be held. Its state variables advance in step with the model, and the observation's value is the derived variable this Dynamics marks ``record: true`` — read at the final step for a reduction (e.g. effective frequency) or, when ``period`` is set, emitted at that period as a time series for a monitor (e.g. a Balloon-Windkessel hemodynamic forward model, which then costs O(nodes) instead of O(time x nodes)). A backend that implements this folds the observer into its own integration, so a batched parameter sweep carries only the accumulator and not a per-cell trajectory; ``tvboptim`` does. An alternative to the post-scan ``pipeline`` / ``class_reference`` for observations expressible as a time recurrence. Its ``parameters`` are the observer's named constants, bound by name in every recurrence expression exactly as a model Dynamics' parameters are — scalar or array-valued (``value`` a nested list, ``shape`` declaring its extent), so a fixed operator the reduction consumes (a mesh gradient, a template matrix) is declared as data on the observer rather than hidden inside a backend callable. Its expressions name the observed signal ``x``, bound to whatever this observation's ``source`` names — the same device a curated coupling's ``pre_expression`` uses with ``x_j`` — so an observation model is curated once and pointed at any model's state variable. An observer that declares its own ``x`` (state, parameter or derived variable) means that ``x`` and gets no binding." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path tvbo:dynamics ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:float ;
            sh:description "The trailing span of simulated time to aggregate over, in the same time unit as the integration step. Converted to a sample count against the spacing of the samples it is cut from, so the window stays the same length of simulated time at any step: this observation's own sample period (its `period`/`downsample_period`, else the integration `step_size`) for a recorded trajectory, and the integration `step_size` for a `reduce: streaming` reducer or a tuning loop, which fold every step. On an algorithm's observation the span may cover several iterations: a duration longer than the algorithm's `simulation_period` must be a whole multiple of it, and the observation is then the mean over that many most recent periods, or over every period so far while fewer have run. Mutually exclusive with `tail_samples`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path tvbo:tail_duration ],
        [ sh:class tvbo:Equation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:Equation ],
        [ sh:class tvbo:Reference ;
            sh:description "Ordered list of auxiliary inputs the observation pipeline consumes. Examples: a Surface mesh's faces array, an empirical FC matrix on a reference Network, or another Observation's output. Resolved load-time eagerly; rendered code is self-contained." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path tvbo:aux_data ],
        [ sh:datatype xsd:string ;
            sh:description "Axis names of this observation's output, outermost first, e.g. ``[node]`` for a per-region value or ``[time, node]`` for a trajectory. Declare it when the shape cannot be derived: a standard reduction states its own axes and needs nothing here, but a ``pipeline`` of user functions has an output shape only its author knows. Without it the container falls back to positional names built from the CONTAINER VARIABLE, not from the observation — ``integration__target_peak_frequencies_d0``, not ``target_peak_frequencies_d0`` — because inferring an axis from a length is how a four-sample trace in a four-node network comes to be labelled by region. A declaration that does not match the value it describes is refused by name rather than ignored." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:dims ],
        [ sh:description "Type of imaging modality (BOLD, EEG, MEG, etc.)" ;
            sh:in ( "BOLD" "EEG" "MEG" "SEEG" "IEEG" ) ;
            sh:maxCount 1 ;
            sh:order 19 ;
            sh:path tvbo:imaging_modality ],
        [ sh:class tvbo:FunctionCall ;
            sh:description "Ordered sequence of Functions. Each step has a unique `name` (used to key step outputs) and transforms input -> output. List form preserves execution order." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path tvbo:pipeline ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ] ;
    sh:targetClass tvbo:Observation .

<https://w3id.org/tvbo/sw/SoftwareEnvironment> a sh:NodeShape ;
    rdfs:comment "A reproducible software environment aggregating one or more SoftwareRequirement entries. Used by SimulationExperiment to specify the execution context." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Category: conda, venv, docker, etc." ;
            sh:in ( "conda" "venv" "docker" "singularity" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/sw/environment_type> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/sw/dataLocation> ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Environment definition version (not a package version)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/sw/version> ],
        [ sh:datatype xsd:string ;
            sh:description "Container image reference (e.g., ghcr.io/org/img:tag@sha256:...)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/tvbo/sw/container_image> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "OS / architecture (e.g., linux-64, macos-arm64)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/sw/platform> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareRequirement> ;
            sh:description "Constituent software requirements." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path <https://w3id.org/tvbo/sw/requirements> ],
        [ sh:datatype xsd:string ;
            sh:description "Deterministic hash of the resolved dependency set." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://w3id.org/tvbo/sw/build_hash> ] ;
    sh:targetClass <https://w3id.org/tvbo/sw/SoftwareEnvironment> .

schema1:SoftwareApplication a sh:NodeShape ;
    rdfs:comment "A software tool for computational neuroscience simulation, analysis, or model specification. Extends SoftwarePackage with neuroscience-specific controlled vocabularies for scale, paradigm, role, and interoperability. Aligned with CodeMeta v3 and DOAP.",
        "Identity and metadata for a software package, aligned with schema.org/SoftwareApplication and CodeMeta v3." ;
    sh:closed true ;
    sh:ignoredProperties ( dcterms:creator dcterms:references schema1:applicationCategory schema1:citation schema1:dateModified schema1:funder schema1:isAccessibleForFree schema1:keywords schema1:maintainer schema1:operatingSystem schema1:programmingLanguage schema1:runtimePlatform schema1:sameAs rdf:type tvbo:date_created tvbo:scale <https://w3id.org/tvbo/sw/codegen_format> <https://w3id.org/tvbo/sw/development_status> <https://w3id.org/tvbo/sw/interoperates_with> <https://w3id.org/tvbo/sw/issue_tracker> <https://w3id.org/tvbo/sw/model_paradigm> <https://w3id.org/tvbo/sw/tool_role> <https://w3id.org/tvbo/sw/units> ),
        ( rdf:type ) ;
    sh:property [ sh:description "Project homepage URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path schema1:url ],
        [ sh:description "Spatial/organizational scales the tool operates at." ;
            sh:in ( wd:Q898786 wd:Q43054 wd:Q484761 wd:Q7003015 wd:Q1073340 wd:Q239456 ) ;
            sh:order 1 ;
            sh:path <https://w3id.org/tvbo/sw/scale> ],
        [ sh:description "Source code repository URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path schema1:codeRepository ],
        [ sh:datatype xsd:string ;
            sh:description "Original author(s) or creating organization(s)." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dcterms:creator ],
        [ sh:description "URL of the bug tracker or issue board." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path <https://w3id.org/tvbo/sw/issue_tracker> ],
        [ sh:datatype xsd:string ;
            sh:description "High-level category (e.g., simulation, analysis, specification)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:applicationCategory ],
        [ sh:datatype xsd:string ;
            sh:description "SPDX license identifier (e.g., MIT, GPL-3.0-only)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:license ],
        [ sh:description "Package ecosystem(s) through which the software is distributed." ;
            sh:in ( wd:Q2984888 wd:Q105593788 wd:Q901584 "julia_registry" wd:Q7067518 "bioconda" "github" wd:Q6795527 wd:Q15206305 ) ;
            sh:order 9 ;
            sh:path <https://w3id.org/tvbo/sw/ecosystem> ],
        [ sh:description "Package ecosystem(s) through which the software is distributed." ;
            sh:in ( wd:Q2984888 wd:Q105593788 wd:Q901584 "julia_registry" wd:Q7067518 "bioconda" "github" wd:Q6795527 wd:Q15206305 ) ;
            sh:order 31 ;
            sh:path <https://w3id.org/tvbo/sw/ecosystem> ],
        [ sh:datatype xsd:string ;
            sh:description "Current or latest stable version string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:softwareVersion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Additional citation strings or DOIs." ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path schema1:citation ],
        [ sh:datatype xsd:date ;
            sh:description "Date the software was first released (YYYY-MM-DD)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:dateCreated ],
        [ sh:class schema1:SoftwareApplication ;
            sh:description "Tools this tool can exchange data with or delegate to." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path <https://w3id.org/tvbo/sw/interoperates_with> ],
        [ sh:datatype xsd:string ;
            sh:description "DOI of the primary reference publication for this tool." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dcterms:references ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the package as it ran. Required by BEP028's software record, where a provenance claim without a version is unverifiable." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:softwareVersion ],
        [ sh:description "Primary function(s) in a simulation workflow." ;
            sh:in ( wd:Q1569346 wd:Q271680 "backend_runtime" wd:Q816286 wd:Q2661442 "workflow_framework" biotools:operation_2945 biotools:operation_0337 wd:Q7397 wd:Q858926 wd:Q3508889 wd:Q1392628 ) ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/sw/tool_role> ],
        [ sh:datatype xsd:date ;
            sh:description "Date of the most recent release or significant update." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:dateModified ],
        [ sh:description "Implementation languages." ;
            sh:in ( wd:Q28865 wd:Q15777 wd:Q2407 wd:Q251 wd:Q4010477 wd:Q182017 wd:Q206904 wd:Q83303 wd:Q34010 wd:Q575650 wd:Q2005 wd:Q2115 wd:Q5765633 wd:Q2370 ) ;
            sh:order 4 ;
            sh:path schema1:programmingLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path schema1:name ],
        [ sh:description "URIs that unambiguously identify this tool (Wikidata, bio.tools, RRID, SciCrunch)." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path schema1:sameAs ],
        [ sh:description "Project homepage URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Supported operating systems (e.g., Linux, macOS, Windows)." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:operatingSystem ],
        [ sh:datatype xsd:string ;
            sh:description "SPDX license identifier (e.g., MIT, GPL-3.0-only)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path dcterms:license ],
        [ sh:datatype xsd:string ;
            sh:description "Funding bodies or grants (e.g., 'EU H2020 945539', 'NIH R01...')." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path schema1:funder ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Execution backends or platforms (e.g., MPI, OpenMP, CUDA, JAX)." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:runtimePlatform ],
        [ sh:description "Further identifiers for the same package, an RRID among them (BEP028 ``AlternativeIdentifier``)." ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path <https://w3id.org/tvbo/sw/alternative_identifier> ],
        [ sh:datatype xsd:string ;
            sh:description "Digital Object Identifier for the software or its reference publication." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path bibo:doi ],
        [ sh:description "Computational paradigms supported." ;
            sh:in ( wd:Q7003015 wd:Q1368960 wd:Q7579783 wd:Q72484 wd:Q5155691 wd:Q3685405 wd:Q634884 wd:Q851270 wd:Q747830 "generic" wd:Q1948412 "dynamic_mean_field" wd:Q7003015 wd:Q317623 "model_description" wd:Q858926 ) ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/sw/model_paradigm> ],
        [ sh:datatype xsd:string ;
            sh:description "Tags for topic-based discovery and clustering." ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path schema1:keywords ],
        [ sh:class schema1:SoftwareApplication ;
            sh:description "Packages whose use triggered this one, so a backend invoked through a framework records the chain rather than only the innermost caller." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path <https://w3id.org/tvbo/sw/acted_on_behalf_of> ],
        [ sh:datatype xsd:string ;
            sh:description "Export-registry key of the format TVBO emits for this tool (`tvbo formats`). Present only on tools TVBO generates code for." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path <https://w3id.org/tvbo/sw/codegen_format> ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the tool is free/open-source." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path schema1:isAccessibleForFree ],
        [ sh:class schema1:SoftwareApplication ;
            sh:description "Packages whose use triggered this one, so a backend invoked through a framework records the chain rather than only the innermost caller." ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path <https://w3id.org/tvbo/sw/acted_on_behalf_of> ],
        [ sh:description "Development status (repostatus.org aligned)." ;
            sh:in ( "active" "inactive" "concept" "wip" "suspended" "unsupported" "moved" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path <https://w3id.org/tvbo/sw/development_status> ],
        [ sh:datatype xsd:string ;
            sh:description "Current maintainer(s) or responsible organization(s)." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path schema1:maintainer ],
        [ sh:description "Source code repository URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path schema1:codeRepository ],
        [ sh:datatype xsd:string ;
            sh:description "Digital Object Identifier for the software or its reference publication." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path bibo:doi ],
        [ sh:class <https://w3id.org/tvbo/sw/ToolUnit> ;
            sh:description "How this tool spells the units TVBO declares. Only units the tool has its own name for appear; anything absent is emitted unitless." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path <https://w3id.org/tvbo/sw/units> ],
        [ sh:description "Further identifiers for the same package, an RRID among them (BEP028 ``AlternativeIdentifier``)." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path <https://w3id.org/tvbo/sw/alternative_identifier> ] ;
    sh:targetClass schema1:SoftwareApplication .

tvbo:Algorithm a sh:NodeShape ;
    rdfs:comment "A complete specification of an iterative parameter tuning algorithm. Combines update rules, objectives, observations, and hyperparameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Linear warmup of learning rate from 0 to learning_rate over n_iterations. eta_effective = eta * (i+1) / n_iterations" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:learning_rate_warmup ],
        [ sh:class tvbo:TuningObjective ;
            sh:description "What the algorithm optimizes for" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:objective ],
        [ sh:datatype xsd:string ;
            sh:description "Algorithm type: 'fic', 'eib', 'homeostatic', 'custom'" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:type ],
        [ sh:datatype xsd:float ;
            sh:description "Learning rate (eta) for the tuning algorithm" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:learning_rate ],
        [ sh:datatype xsd:float ;
            sh:description "Duration of each simulation step (e.g., one BOLD TR)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:simulation_period ],
        [ sh:class tvbo:FunctionCall ;
            sh:description "Function calls for tracking progress, computing metrics, etc. Each FunctionCall references a function from the experiment's functions section and specifies arguments for that specific algorithm context." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path tvbo:functions ],
        [ sh:class tvbo:UpdateRule ;
            sh:description "How parameters are updated each iteration. When using 'includes', update_rules are inherited from included algorithms." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path tvbo:update_rules ],
        [ sh:class tvbo:Observation ;
            sh:description "References to observations defined in the observations section. Includes both simulated observations and external data (via data_source)." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:observations ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Materialise this algorithm's post-tuning evaluation: a simulation of the tuned model over the experiment's full duration, recorded as algorithm__<name>__<observation>. False keeps only the tuned parameters and state, which is all a dependency of another algorithm contributes - the algorithm that follows supersedes its observations - while the evaluation itself costs a complete run of the experiment's duration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path tvbo:evaluate ],
        [ sh:class tvbo:AlgorithmInclude ;
            sh:description "Include update rules from other algorithms with optional argument overrides. Unlike depends_on (sequential), includes means combined execution. Example: includes: [{algorithm: fic, arguments: [{name: eta, value: 0.1}]}]" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:includes ],
        [ sh:class tvbo:Algorithm ;
            sh:description "Other algorithms that must run first (e.g., EIB depends on FIC)" ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path tvbo:depends_on ],
        [ sh:datatype xsd:string ;
            sh:description "Learning rate schedule: 'constant', 'linear', 'exponential'" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:learning_rate_schedule ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of iterations to run" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:n_iterations ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Apply update every N iterations" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:apply_every ],
        [ sh:datatype xsd:float ;
            sh:description "Simulated time, counted from the start of each stage (or of the run when there are no stages), before which the update rules are not applied: an iteration applies its update only if its simulation period ends at or after this time. In the same unit as `simulation_period`. Absent, every iteration applies its update. A rule taken in through `includes` keeps the start of the algorithm it comes from." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:update_start ],
        [ sh:class tvbo:Parameter ;
            sh:description "Additional algorithm-specific parameters" ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path tvbo:hyperparameters ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class tvbo:ExecutionConfig ;
            sh:description "Per-algorithm execution configuration (overrides experiment-level defaults). Useful for setting random_seed per algorithm to ensure reproducibility." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:execution ],
        [ sh:class tvbo:StateSelection ;
            sh:description "Optional best-iterate selection. Absent, the tuned state is the final iterate. Declared, the iterate with the best `criterion` (across all stages, or per stage under `scope: stage`) is restored before the post-tuning evaluation, and `<algorithm>__selected_iteration` / `<algorithm>__selected_value` record which one it was (one value per stage under `scope: stage`)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path tvbo:selection ],
        [ sh:class tvbo:AlgorithmStage ;
            sh:description "Optional multi-stage schedule. When present, the algorithm body is run once per stage IN ORDER, carrying trajectory state, FC window buffer, and monitors forward (one continuous online run). Each stage overrides n_iterations + selected hyperparameters. Replaces the top-level n_iterations for execution. Example (Schirner 2023): 6 stages with eta halving and window_size doubling per stage." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path tvbo:stages ] ;
    sh:targetClass tvbo:Algorithm .

tvbo:Callable a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type tvbo:call_args tvbo:constructor_args tvbo:warmup ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this callable can be traced by an array-programming backend (jit/vmap under JAX), asserted by the recipe rather than inferred from the module name. A backend that batches a parameter grid must know whether an observation's callable survives tracing; without this it can only guess from the import root, which makes every study-local callable untraceable however it is written. Set it true only for a callable written against the backend's array API -- a host NumPy/SciPy callable declared traceable fails inside the trace, with the tracer error naming this claim as its cause. Unset means \"infer\", preserving the import-root default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:traceable ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareRequirement> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:software ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:module ] ;
    sh:targetClass tvbo:Callable .

tvbo:DerivedVariable a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "External ontology IRIs (typically GO, ChEBI, UBERON, CL, MeSH) that this entity is a surrogate / abstraction / model of. Realized as the `tvbo:surrogate_of` object property, carried inline with the YAML data instance. Multiple IRIs allowed: a single parameter may abstract several biological processes (e.g. a synaptic conductance grounding both GO:0060079 (excitatory PSP) and GO:0007268 (chemical synaptic transmission))." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:surrogate_of ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether to include this element in simulation output files. Applicable to state variables (default true), derived variables (default false), and network nodes (default true). On an observation it forces (true) or suppresses (false) persistence in the result; left unset, a terminal observation (one not consumed by another observation or a loss) is recorded and an intermediate one is not. Set false to suppress recording." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:record ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ],
        [ sh:description "Physical unit of measurement. `UnitEnum` is the curated vocabulary — each of its values is vendored from QUDT (`ontology/tvb-o-units.ttl`) and can be reasoned about dimensionally. The range is deliberately open beyond it: a unit nobody has curated yet is recorded as written and reported `uncurated`, because a closed range forces the author to either misdeclare the quantity or leave it undeclared, and both lose more than an unrecognised string does. An uncurated unit carries no dimensional claim, so a check involving it reports `underdetermined` rather than guessing. Promote one with `tvbo units add <unit>`, which pulls its QUDT record into the vendored module — so every unit TVBO *reasons* about stays authoritative, and only what it *records* is open." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 5 ;
            sh:path qudt:unit ],
        [ sh:class tvbo:Equation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:Equation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:symbol ],
        [ sh:class tvbo:Surrogate ;
            sh:description "Optional permutation-significance test: this derived variable's value is the exceedance p-value of a named statistic under permutations of a field (a general surrogate null — any permutation test, not wave-specific — emitted as a vmap-fold over the captured permutations; the wrapped statistic stays symbolic). When set, the variable's own ``equation`` may be omitted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path tvbo:surrogate ] ;
    sh:targetClass tvbo:DerivedVariable .

tvbo:StateVariable a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type tvbo:boundary_conditions tvbo:mesh ) ;
    sh:property [ sh:class tvbo:Distribution ;
            sh:description "Distribution for sampling initial conditions per node. If present, initial_value is used as fallback/mean." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path tvbo:distribution ],
        [ sh:description "Physical unit of measurement. `UnitEnum` is the curated vocabulary — each of its values is vendored from QUDT (`ontology/tvb-o-units.ttl`) and can be reasoned about dimensionally. The range is deliberately open beyond it: a unit nobody has curated yet is recorded as written and reported `uncurated`, because a closed range forces the author to either misdeclare the quantity or leave it undeclared, and both lose more than an unrecognised string does. An uncurated unit carries no dimensional claim, so a check involving it reports `underdetermined` rather than guessing. Promote one with `tvbo units add <unit>`, which pulls its QUDT record into the vendored module — so every unit TVBO *reasons* about stays authoritative, and only what it *records* is open." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 7 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "differential" ;
            sh:description "How to interpret ``equation.rhs`` when advancing this state: 'differential' (default) integrates it as ``dx/dt = rhs``; 'algebraic' is a constraint ``0 = rhs`` / ``x ~ rhs`` (DAE); 'recurrence' is a discrete per-step update ``x_next = rhs`` (no integrator applied), used by an observation's auxiliary ``dynamics`` for online reductions/accumulators (e.g. a running sum ``x_next = x + f``) — the symbolic, backend-independent sibling of the continuous 'differential' form. Algebraic equations are used by ModelingToolkit.jl backend." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:equation_type ],
        [ sh:datatype xsd:float ;
            sh:description "Initial value for the first time derivative, used when equation_order > 1. For a second-order ODE d²x/dt² = f, this sets dx/dt(0). Required by ModelingToolkit.jl to fully specify higher-order initial value problems." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:derivative_initial_value ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Order of the time derivative on the LHS. Default 1 means dx/dt = rhs (first-order ODE). Order 2 means d²x/dt² = rhs (second-order ODE), etc. Higher-order ODEs are automatically lowered to coupled first-order systems by backends like ModelingToolkit.jl via mtkcompile." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:equation_order ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class tvbo:Range ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:domain ],
        [ sh:class tvbo:TimeSeries ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path tvbo:history ],
        [ sh:description "External ontology IRIs (typically GO, ChEBI, UBERON, CL, MeSH) that this entity is a surrogate / abstraction / model of. Realized as the `tvbo:surrogate_of` object property, carried inline with the YAML data instance. Multiple IRIs allowed: a single parameter may abstract several biological processes (e.g. a synaptic conductance grounding both GO:0060079 (excitatory PSP) and GO:0007268 (chemical synaptic transmission))." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path tvbo:surrogate_of ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether to include this element in simulation output files. Applicable to state variables (default true), derived variables (default false), and network nodes (default true). On an observation it forces (true) or suppresses (false) persistence in the result; left unset, a terminal observation (one not consumed by another observation or a loss) is recorded and an intermediate one is not. Set false to suppress recording." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:record ],
        [ sh:class tvbo:Equation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:Equation ],
        [ sh:class tvbo:Equation ;
            sh:description "Optional reverse recurrence for a **sliding-window** reduction: the per-step downdate that removes the sample leaving the window, the inverse of ``equation`` (which folds an arriving sample in). Only meaningful when ``equation_type: recurrence`` on an observation's auxiliary ``dynamics``. When present, the observer is a windowed reduction — its state is maintained by ``equation`` (add) and ``evict_equation`` (evict) and rebuilt exactly from the window on resync — rather than a cumulative accumulator over the whole trajectory (``equation`` alone). Absent for ordinary state variables and cumulative reductions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path tvbo:evict_equation ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:stimulation_variable ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path skos:definition ],
        [ sh:class tvbo:Noise ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path tvbo:noise ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this state variable is transmitted to connected nodes through the coupling function. In TVB terms, this determines the cvar indices (state variables extracted from history and fed into the coupling function). The coupling function may override this via its incoming_states attribute." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:coupling_variable ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:symbol ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:float ;
            sh:description "Value this state starts at. Absent means undeclared: the consumer supplies its own fallback via ``tvbo.utils.initial_value``, which documents why this slot carries no schema default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path tvbo:initial_value ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:variable_of_interest ] ;
    sh:targetClass tvbo:StateVariable .

<http://uri.interlex.org/tgbugs/uris/readable/Coordinate> a sh:NodeShape ;
    rdfs:comment "A 3D coordinate with X, Y, Z values." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Y coordinate" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/y> ],
        [ sh:datatype xsd:float ;
            sh:description "X coordinate" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/x> ],
        [ sh:class <http://uri.interlex.org/tgbugs/uris/readable/atlas/Transformation> ;
            sh:description "Common coordinate space (e.g. MNI152NLin6Asym, MNI152NLin2009cAsym). Reference by name; the CommonCoordinateSpace must be defined in tvbo/database/coordinate_spaces/ (or future equivalent location)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/coordinateSpace> ],
        [ sh:datatype xsd:float ;
            sh:description "Z coordinate" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/z> ] ;
    sh:targetClass <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> .

tvbo:ExecutionConfig a sh:NodeShape ;
    rdfs:comment "Configuration for computational execution (parallelization, precision, hardware)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Execution backend this experiment runs on when no backend is passed explicitly (e.g. 'tvboptim', 'tvb', 'jax', 'julia', 'brian2'). Declares the engine the experiment requires — a spiking point-neuron network sets 'brian2', a mean-field model leaves it unset. run(format=...) and ``tvbo run --backend`` override it; when unset the default backend (tvboptim) is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:backend ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether to find a fixed point (steady state) before time integration. Used as initial condition for ODEProblem. Maps to NLsolve.fixpoint! in ND.jl or similar in other backends." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:find_fixpoint ],
        [ sh:datatype xsd:integer ;
            sh:description "Batch size for vectorized operations (None = auto)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:batch_size ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "float64" ;
            sh:description "Floating point precision: 'float32' or 'float64'" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:precision ],
        [ sh:datatype xsd:float ;
            sh:description "System size (van Kampen Ω) for the stochastic 'gillespie' backend: the number of discrete units per unit of the activity variable, and the sole source of noise. Runs a mean-field rate model as a finite birth-death process (Gillespie SSA): the activity state variable X becomes a discrete count n ≈ Ω·X, its relaxation equation tau*X' = -X + F(...) is read as birth propensity Ω·F/tau (the gain) and death propensity n/tau (the leak), while the remaining state variables integrate deterministically between events. Larger Ω means finer discreteness and weaker fluctuations, recovering the deterministic mean field as Ω→∞. For an activity already expressed as a fraction in [0,1], Ω is the population size N; for a firing rate it is N divided by the rate at full activation. Required by the 'gillespie' backend; ignored by every other backend." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:system_size ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue -1 ;
            sh:description "Number of CPU threads per worker (-1 = auto-detect)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tvbo:n_threads ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "auto" ;
            sh:description "Hardware accelerator the run targets. 'auto' (default) lets JAX detect the machine — GPU/TPU when present, else CPU; 'cpu', 'gpu', or 'tpu' pin the JAX platform explicitly. tvbo maps this to JAX_PLATFORMS before JAX initialises (an existing JAX_PLATFORMS in the environment still wins); tvboptim then spreads work across that platform's devices via n_pmap/n_vmap. In a workflow kit, 'gpu' also makes the experiment's rule request a SLURM gres unless one is set." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:accelerator ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Number of parallel workers (maps to pmap devices in JAX, processes in multiprocessing)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tvbo:n_workers ],
        [ sh:datatype xsd:integer ;
            sh:description "Experiment-global RNG seed (default 0). Governs every stochastic draw — additive noise, initial-condition and parameter distributions, and n_trials ensembles — unless a specific `Distribution.seed` overrides it for that distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:random_seed ] ;
    sh:targetClass tvbo:ExecutionConfig .

tvbo:Provenance a sh:NodeShape ;
    rdfs:comment """W3C PROV-O aligned provenance ABOUT the artifact that carries it — reusable on any entity (Network, TimeSeries, Dynamics, ...), which is why it holds no identity of its own: the parent supplies that. The identified ``prov:Entity`` a standalone provenance record names is ``ResultEntity``, which carries one of these.
Carried by the frozen spec beside a result container, this is the whole record of the run: ``activities`` says what was executed and when, ``environment`` says on what machine and against which package versions, and ``digest`` checksums what came out. None of that is derivable from a recipe, which is why it is recorded — and all of it travels with the artifact it describes rather than in a parallel directory that has to be kept in step.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "SHA-256 hex digest of the normalised experiment YAML that produced this artifact. Used by the cross-experiment cache (see :class:`SimulationStudy.from_file`) to detect when a cached upstream result has gone stale because the experiment's spec was edited. Computed as ``hashlib.sha256(yaml.safe_dump(normalized_yaml).encode()).hexdigest()`` over the fully resolved (post-``!include``) experiment block." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:experiment_yaml_hash ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:references ],
        [ sh:datatype xsd:string ;
            sh:description "ISO 8601 (prov:generatedAtTime)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:date_created ],
        [ sh:datatype xsd:string ;
            sh:description "Sentences that anyone who reuses the artifact must reproduce, one per source that requires one. The meaning of the BIDS `dataset_description.json` field `HowToAcknowledge` (instructions to reusers), never of BIDS `Acknowledgements` (the producer's own thanks); a BIDS export joins the entries into that one field. A step that derives an artifact carries over the entries of every input it read." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:creditText ],
        [ sh:class prov:Activity ;
            sh:description "The runs that produced this artifact, serialized to BEP028's activity record. Each names the command, the software that carried it out and what it consumed." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path tvbo:activities ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareEnvironment> ;
            sh:description "The machine and the resolved package set the run actually loaded, carried in full rather than by name: this record travels with one container's sidecar, so a reference to an environment defined elsewhere would point outside the only file a reader has." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:environment ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class tvbo:ReferenceFingerprint ;
            sh:description "Per-input fingerprints for cache invalidation. Each entry records the IRI + dotted-field path of an ``aux_data`` reference plus the (mtime, size, sha256) of the underlying file at the time the artifact was produced. A downstream cache hit requires every fingerprint to match the current file state." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path tvbo:inputs ],
        [ sh:datatype xsd:string ;
            sh:description "Software/agent identifier: the prov:Agent this artifact is attributed to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:generated_by ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:license ],
        [ sh:datatype xsd:string ;
            sh:description "The data variables the container actually holds, read off it when the record is written rather than predicted from the spec, so a run that recorded less than it declared is visible here. The one fact in this record that the recipe beside it cannot supply." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:outputs ],
        [ sh:class tvbo:Digest ;
            sh:description "Checksums of the artifact itself, keyed by function name. BEP028's ``Digest``, and distinct from ``experiment_yaml_hash``, which digests the spec that produced the artifact rather than the artifact." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path tvbo:digest ] ;
    sh:targetClass tvbo:Provenance .

tvbo:Distribution a sh:NodeShape ;
    rdfs:comment "A probability distribution for sampling parameters or initial conditions. Standard distributions (Uniform, Gaussian) are specified by name and domain/parameters. Custom distributions use a Function for the PDF/sampling rule. Default name is Uniform when only domain is given." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:defaultValue "space" ;
            sh:description "Dimension along which the distribution is sampled. 'space' = once per node or connection (default), 'time' = per-timestep (stochastic input), 'trial' = once per node or connection for each trial of an `n_trials` ensemble." ;
            sh:in ( "space" "time" "trial" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path tvbo:axis ],
        [ sh:class tvbo:Matrix ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:correlation ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Uniform" ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class tvbo:Function ;
            sh:description "Custom distribution function (PDF or sampling callable). Only needed for non-standard distributions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path tvbo:function ],
        [ sh:class tvbo:Range ;
            sh:description "Support of the distribution (sampling bounds). For Uniform this fully defines the distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:domain ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path tvbo:parameters ],
        [ sh:datatype xsd:integer ;
            sh:description "Local RNG seed for THIS distribution's draws. When set it overrides the experiment-global `execution.random_seed`; when unset the distribution inherits `execution.random_seed`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:seed ] ;
    sh:targetClass tvbo:Distribution .

tvbo:FunctionCall a sh:NodeShape ;
    rdfs:comment "Invocation of a function in a pipeline. Can reference a defined Function by name, OR inline a callable directly for external library functions, OR inline an equation, OR use class_call for class instantiation, OR name a curated step with `iri` and state only what differs from it. Mirrors Function attributes so pipeline steps can be self-contained. The `name` is an optional step label (used in pipelines for keyed access to step outputs); it is NOT a global identifier (singleton uses like `loss`, `observable` may omit it)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type tvbo:dims tvbo:execution tvbo:parameters tvbo:persist tvbo:target tvbo:type tvbo:wrt ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Reference to previous function's output in pipeline (by name)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:input ],
        [ sh:datatype xsd:string ;
            sh:description "Optional step label; used in pipelines to key step outputs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:source_code ],
        [ sh:datatype xsd:string ;
            sh:description "Name for this step's output (referenced by subsequent functions)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path tvbo:output ],
        [ sh:datatype xsd:string ;
            sh:description "Axis to apply the function over, one element at a time (generates a vmap in code). ``node`` applies per node, ``time`` per sample. Inside an observation pipeline the axes are the solve grid's and the ``DimensionType`` vocabulary names them; a study-level ``Analysis`` maps over the axes of the CONTAINERS it reads, which are declared by whatever produced them (``subject``, ``parcel``, ``n_modes``, ``variant``), so this is a free string rather than that closed enum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path tvbo:apply_on_dimension ],
        [ sh:class tvbo:Callable ;
            sh:description "Direct callable specification (alternative to function reference)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:callable ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:class tvbo:Equation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path tvbo:Equation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path skos:notation ],
        [ sh:class tvbo:ClassReference ;
            sh:description "Class instantiation and call (alternative to callable/function). Use for external library classes that need __init__ then __call__. Example: Bold monitor from tvboptim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path tvbo:class_call ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:class tvbo:Range ;
            sh:description "Time range for generated TimeSeries (for kernel generators)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path tvbo:time_range ],
        [ sh:class tvbo:Function ;
            sh:description "Reference to a defined Function (by name)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path tvbo:function ],
        [ sh:class tvbo:Aggregation ;
            sh:description "How to aggregate the result across dimensions. Example: aggregate.over=node, aggregate.type=mean applies function per node, then averages. Used in loss functions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path tvbo:aggregate ],
        [ sh:class tvbo:Argument ;
            sh:description "Function arguments keyed by name (the key is the argument name)." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path tvbo:arguments ] ;
    sh:targetClass tvbo:FunctionCall .

<http://uri.interlex.org/tgbugs/uris/readable/atlas/Transformation> a sh:NodeShape ;
    rdfs:comment "A schema for representing a version of a common coordinate space." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Enter any alternate names, including abbreviations, for this entity." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/atlas/hasName> ],
        [ sh:datatype xsd:string ;
            sh:description "Add the axes orientation in standard anatomical terms (XYZ)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/anatomicalAxesOrientation> ],
        [ sh:datatype xsd:string ;
            sh:description "Add the native unit that is used for this common coordinate space version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/nativeUnit> ],
        [ sh:datatype xsd:string ;
            sh:description "Linked type for the license of the brain atlas or coordinate space version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:license ],
        [ sh:description "Physical unit of measurement. `UnitEnum` is the curated vocabulary — each of its values is vendored from QUDT (`ontology/tvb-o-units.ttl`) and can be reasoned about dimensionally. The range is deliberately open beyond it: a unit nobody has curated yet is recorded as written and reported `uncurated`, because a closed range forces the author to either misdeclare the quantity or leave it undeclared, and both lose more than an unrecognised string does. An uncurated unit carries no dimensional claim, so a check involving it reports `underdetermined` rather than guessing. Promote one with `tvbo units add <unit>`, which pulls its QUDT record into the vendored module — so every unit TVBO *reasons* about stays authoritative, and only what it *records* is open." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 4 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:string ;
            sh:description "Slot for the abbreviation of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:notation ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Enter the origin (central point where all axes intersect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/axesOrigin> ],
        [ sh:datatype xsd:string ;
            sh:description "Add all image files used as visual representation of this common coordinate space version." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/defaultImage> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ] ;
    sh:targetClass <http://uri.interlex.org/tgbugs/uris/readable/atlas/Transformation> .

prov:Entity a sh:NodeShape ;
    rdfs:comment "A pointer to one labelled array in a result container, dataset, or curated entity — the single cross-container reference primitive (a PROV entity a consumer ``prov:used``). WHERE is ``experiment`` (an in-study experiment id, resolved like ``initial_state.source_experiment``), ``analysis`` (an in-study analysis name), ``cohort`` (a named subset of a study dataset, read from each member's own file chosen by ``query``), or the full ``iri`` (a curated / result / external pointer); at most one. An ``iri`` that names a network, by the path of its sidecar file or by a curated network's exact id, reads ``output`` as a layer of that network (an edge layer or a per-node quantity) as the network delivers it, its own sources read and its transforms applied. WHICH is ``output`` (a recorded variable, ``observation__<name>``, ``estimate__<param>``, an external variable, or the measure a cohort member's file holds). SLICE is ``sel`` (label-keyed ``.sel``, never positional). ``reconcile`` optionally aligns the sourced array to the consuming network's node order by label. One model reused by figure layers (``Layer.used``), sourced arguments (``Argument.used``), sourced parameters (``Parameter.used``) and sourced network layers (``Edge.used``), so data binding, cross-experiment sourcing and PROV provenance are the same edge. A sourced array is resolved lazily and never inlined into generated code.",
        """One persisted result container, described. The ``prov:Entity`` of BEP028's ``prov-<label>_ent`` record: what the file is, what produced it, and what it holds. Every field is either a pointer or read off the artifact when it is written — nothing here restates a value the frozen spec beside the container already carries, which is what made the earlier curated JSON sidecar drift from the YAML next to it.
Named for the entity rather than for the experiment because an analysis container (``ana-<name>_result.h5``) gets one too, and because the in-memory ``tvbo.data.types.ExperimentResult`` is a different thing: the arrays themselves, not the description of the file holding them.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ),
        ( rdf:type ) ;
    sh:property [ sh:class tvbo:Provenance ;
            sh:description "When it was made, under what licence, by which activities, from which inputs, and its checksums — the PROV assertions about this entity, in the one class that already carries them." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:provenance ],
        [ sh:description "The experiment or analysis that computed it, by IRI (``tvbo:exp/<study>/exp-<id>``, ``tvbo:ana/<study>/<name>``) — the same scope grammar a ``DataRef`` resolves through, so a record and a reference name the producer the one way." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path tvbo:produced_by ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Path of the container this record describes, relative to the study root, so the record stays valid wherever the study is checked out." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:container ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:class tvbo:BidsEntities ;
            sh:description "With ``cohort``: the BIDS entity filter that selects one file per subject under the dataset's ``bids_root`` (``{atlas: HCPMMP1, desc: SCconn, suffix: relmat}``). The subject fills the ``sub-`` entity; a filter that matches none or several of a subject's files raises." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:query ],
        [ sh:class tvbo:Argument ;
            sh:description "SLICE: label-based selector (xarray ``.sel``), keyed by dimension (reuses ``Argument``; name = dim, value = coordinate label), taking the nearest coordinate for a numeric selection. Never positional — picks e.g. one operating point out of a swept branch by its parameter value." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path tvbo:sel ],
        [ sh:datatype xsd:string ;
            sh:description "Optional named reduction applied to the sourced array after ``sel``, before ``reconcile`` — a registered ``fn(da) -> da`` (the same ``bsplot.register_transform`` registry a figure ``Layer.transform`` uses). Handles a selection a label ``sel`` cannot express on its own, e.g. picking the operating point (endpoint) out of a branch-restart container keyed by ordinal. Presentation/selection only — prefer a ``sel`` or an upstream observation when one suffices." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:transform ],
        [ sh:datatype xsd:string ;
            sh:description "The data variables the container actually holds, read from it at write time rather than predicted from the spec: a run that recorded less than it declared is then visible in the record." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:outputs ],
        [ sh:datatype xsd:string ;
            sh:description "WHERE (dataset form): the identifier of a cohort one of the study's datasets declares (``Dataset.cohorts``). The array is read from each member's own file under that dataset's ``bids_root``: ``query`` chooses the file and ``output`` the array in it. Read by a study analysis the reference is the whole cohort, stacked along a leading ``subject`` dimension in the cohort's member order; read inside a per-subject run it is that run's own subject, which must be a member. Mutually exclusive with ``experiment``, ``analysis`` and ``iri``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tvbo:cohort ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:description "WHERE (short form): an in-study experiment id whose saved result holds the array, resolved within the enclosing study like ``initial_state.source_experiment``. Written as the bare integer id (``34``), or as one of the string spellings the workflow planner also accepts (``exp-34``, ``\"34\"``) — ``tvbo.data.dataref`` normalises all three to the integer it globs the container by. Mutually exclusive with ``iri`` (the full cross-study / curated / external form). When both are absent the reference is local — ``output`` names this experiment's own output — otherwise falling back to ``initial_state.source_experiment`` when present." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:integer ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path tvbo:experiment ],
        [ sh:datatype xsd:string ;
            sh:description "WHERE (short form): an in-study analysis name whose saved result holds the array (``derivatives/tvbo/ana-<name>_result.h5``). Mutually exclusive with ``experiment`` and ``iri``, and — like ``experiment`` — it registers the run-order dependency, so the analysis runs before whatever consumes it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:analysis ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:defaultValue "none" ;
            sh:description "Align the sourced array's nodes to the consuming network by label (``by_label``) or take it as-is (``none``, the default — a sibling experiment usually already shares the node order). A property of the reference, so figure layers, dataset targets and warm-starts share one flag." ;
            sh:in ( "by_label" "none" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path tvbo:reconcile ],
        [ sh:datatype xsd:string ;
            sh:description "WHICH array to take from the container at ``experiment`` / ``iri``: a recorded state variable, an ``observation__<name>``, an ``estimate__<param>`` (the value an algorithm's update rules tuned), an ``optimization__<name>__fitted__<path>`` (the value an optimization fitted), or an external variable. Matched exactly or by the ``<producer>__<name>`` suffix." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:output ] ;
    sh:targetClass prov:Entity .

<https://w3id.org/tvbo/sw/SoftwareRequirement> a sh:NodeShape ;
    rdfs:comment "An individual software requirement binding a package to a version constraint and a role within an environment." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dcterms:license ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/tvbo/sw/dataLocation> ],
        [ sh:datatype xsd:string ;
            sh:description "Version or constraint specifier (e.g., '==2.7.3', '>=1.2,<2')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/tvbo/sw/version_spec> ],
        [ sh:datatype xsd:string ;
            sh:description "(Deprecated) Use version_spec." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <https://w3id.org/tvbo/sw/version> ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://w3id.org/tvbo/sw/optional> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Canonical source or repository URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://w3id.org/tvbo/sw/source_url> ],
        [ sh:class schema1:SoftwareApplication ;
            sh:description "Reference to the software package identity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/tvbo/sw/package> ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "(Deprecated) Use source_url." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <https://w3id.org/tvbo/sw/url> ],
        [ sh:datatype xsd:string ;
            sh:description "(Deprecated) Use environment.requirements list instead." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://w3id.org/tvbo/sw/modules> ],
        [ sh:datatype xsd:string ;
            sh:description "Build or artifact hash for exact reproducibility." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/tvbo/sw/hash> ],
        [ sh:defaultValue "runtime" ;
            sh:in ( "engine" "runtime" "analysis" "dev" "optional" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path <https://w3id.org/tvbo/sw/role> ] ;
    sh:targetClass <https://w3id.org/tvbo/sw/SoftwareRequirement> .

tvbo:Dynamics a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Parameter ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path tvbo:local_coupling_term ],
        [ sh:datatype xsd:string ;
            sh:description "Output variable names to include in simulation results. References to state_variables or derived_variables by name." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path tvbo:output ],
        [ sh:class tvbo:Dynamics ;
            sh:description "Named child dynamics this model is composed of, each with its own parameters, state and equations — NeuroML's nested components (a cell's ion channels, a channel's gates, a gate's rates), keyed by the child's name. Distinct from ``number_of_modes``, which replicates this model's own state along a mode axis." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path tvbo:components ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:references ],
        [ sh:class tvbo:CouplingInput ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path tvbo:coupling_inputs ],
        [ sh:class tvbo:StateVariable ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path tvbo:state_variables ],
        [ sh:class tvbo:Stimulus ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path tvbo:stimulus ],
        [ sh:defaultValue "continuous" ;
            sh:in ( "continuous" "discrete" ) ;
            sh:maxCount 1 ;
            sh:order 22 ;
            sh:path tvbo:system_type ],
        [ sh:class tvbo:Dynamics ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path tvbo:derived_from_model ],
        [ sh:class tvbo:DerivedVariable ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path tvbo:derived_variables ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Dynamics" ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:class tvbo:Function ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path tvbo:functions ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:description "Coarse classification of this model (mean_field, neural_mass, phase_oscillator, phenomenological, spiking, generic, field). Used for filtering in Dynamics.list_db(model_type=...)." ;
            sh:in ( "mean_field" "neural_mass" "phase_oscillator" "phenomenological" "spiking" "generic" "field" ) ;
            sh:maxCount 1 ;
            sh:order 21 ;
            sh:path tvbo:model_type ],
        [ sh:class tvbo:DerivedParameter ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path tvbo:derived_parameters ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path tvbo:modified ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:boolean ;
            sh:description "Code-generation hint (opt-in, backend-independent): eliminate common subexpressions. When true, the generator evaluates each repeated subexpression — including repeated calls to model-defined functions — once and reuses the result instead of re-emitting it at every occurrence. Purely a performance hint: results are numerically identical. A backend whose compiler already performs this elimination may honour it as a no-op. Off by default (expressions are emitted in flat form)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path tvbo:cse ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:references ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path tvbo:parameters ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Length of the mode axis every state variable carries (TVB's ``number_of_modes``): the same equations evaluated once per mode, the modes differing only through per-mode parameter vectors and mixing through mode-coupling matrices (``mode_dot``), as in the Stefanescu–Jirsa reduced sets. Distinct from ``components``, which nests different dynamics." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path tvbo:number_of_modes ],
        [ sh:class tvbo:Event ;
            sh:description "Discrete state transitions intrinsic to the dynamical system, such as threshold-triggered resets in spiking neuron models. Unlike experiment-level events (stimulation, perturbation), these define the model's own discontinuous behavior." ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path tvbo:events ],
        [ sh:datatype xsd:string ;
            sh:description "Add the location of the data file containing the parcellation terminology." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the system is autonomous (equations do not depend explicitly on time t). Non-autonomous systems have explicit time dependence, e.g. f*cos(omega*t)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path tvbo:autonomous ],
        [ sh:datatype xsd:boolean ;
            sh:description "Code-generation hint (opt-in, backend-independent): request that the generated dynamics be compiled to machine code rather than interpreted, where the target backend supports it. Purely a performance hint with no effect on results; a backend that is inherently compiled (or cannot compile) honours it as a no-op. Off by default. Independent of, and composable with, ``cse``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path tvbo:compile ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:DerivedVariable ;
            sh:description "Observable functions computed from states, inputs, and parameters after simulation. Unlike derived_variables (which are intermediate algebraic expressions used within the ODE), observed variables are post-hoc quantities recoverable from the solution. Maps to obsf/obssym in ND.jl EdgeModel/VertexModel. Example: absolute force magnitude computed from force components." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path tvbo:observed ] ;
    sh:targetClass tvbo:Dynamics .

tvbo:Function a sh:NodeShape ;
    rdfs:comment "A function with explicit input -> transformation -> output flow. Can be equation-based (symbolic) or software-based (callable). In a pipeline, functions are chained: output of one becomes input of next." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Range ;
            sh:description "Time range for generated TimeSeries (for kernel generators). Equation is evaluated at each time point." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path tvbo:time_range ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Equation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path tvbo:Equation ],
        [ sh:datatype xsd:string ;
            sh:description "Name for this function's output (referenced by subsequent functions)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:output ],
        [ sh:class tvbo:Argument ;
            sh:description "Variables consumed by the function (referenced in the equation), keyed by argument name. Each value carries the optional metadata (value, description, unit); the key is the name (no redundant `name:` inside)." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path tvbo:arguments ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class tvbo:Equation ;
            sh:description "Output transformation equation (if equation-based)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path tvbo:output_equation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path tvbo:source_code ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path skos:definition ],
        [ sh:description "Which dimension to apply the transformation on" ;
            sh:in ( "time" "state" "node" "region" "mode" "sample" "batch" "frequency" "subject" ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path tvbo:apply_on_dimension ],
        [ sh:description "Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareRequirement> ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:requirements ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:notation ],
        [ sh:class tvbo:Callable ;
            sh:description "Software implementation reference (if software-based)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path tvbo:callable ],
        [ sh:class tvbo:Function ;
            sh:description "Simple input reference: name of previous function's output in pipeline. For multi-argument functions, use arguments with value references instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path tvbo:input ],
        [ sh:class tvbo:Aggregation ;
            sh:description "How to aggregate the result across dimensions. E.g., aggregate.over=node computes per-row (per-node) with keepdims. The type field controls whether to reduce (mean/sum) or keep dimensions (none)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path tvbo:aggregate ] ;
    sh:targetClass tvbo:Function .

tvbo:Argument a sh:NodeShape ;
    rdfs:comment "A function argument with explicit value specification. A value is either ``value`` (a literal / array / local reference) or ``used`` (a labelled array sourced from another experiment or dataset); the two are mutually exclusive. Value can be: literal (number/string), reference to input (input.key), or cross-observation reference (observation_name.output_key). A bare scalar is the value, as it is for a Parameter: ``sel: {variable: phi}`` and ``opts: {xlabel: \"time (s)\"}`` mean ``{value: …}``, which is how both are written throughout the docs." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:unit ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class prov:Entity ;
            sh:description "A labelled array sourced from another experiment's result, a dataset, or a curated entity — the cross-container form of a value (WHERE + WHICH + SLICE, PROV ``prov:used``). Mutually exclusive with ``value``; an in-study ``experiment`` reference also registers the workflow dependency so the source runs first. Resolved lazily, never inlined into generated code." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path prov:used ],
        [ sh:description """Argument value. Can be: - Literal: 1.0, "string", boolean, etc. - Array (nested list): an array-valued constant such as a
  per-node target vector consumed by the function.
- Input reference: "input.frequencies" (from source_observation outputs) - Cross-observation: "target_frequencies.peak_freqs" (from another observation)""" ;
            sh:maxCount 1 ;
            sh:or ( [ ] [ ] ) ;
            sh:order 2 ;
            sh:path tvbo:value ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass tvbo:Argument .

tvbo:Range a sh:NodeShape ;
    rdfs:comment "Specifies a range for array generation, parameter bounds, or grid exploration." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether to use logarithmic spacing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:log_scale ],
        [ sh:description "Lower bound or starting value. Can be a number or argument name." ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path tvbo:lo ],
        [ sh:datatype xsd:float ;
            sh:description "Explicit explored values for this element. When set on an element_domain entry, overrides the parent parameter's explored_values for this specific element." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path tvbo:explored_values ],
        [ sh:defaultValue "none" ;
            sh:description "For a state-variable ``domain``: whether/how to enforce the range during integration (none/clamp/wrap). Ignored for parameter, distribution and grid ranges. See DomainEnforcement." ;
            sh:in ( "none" "clamp" "wrap" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path tvbo:enforce ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of points (alternative to step for grid exploration)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:n ],
        [ sh:description "Upper bound or stopping value. Can be a number or argument name." ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path tvbo:hi ],
        [ sh:datatype xsd:integer ;
            sh:description "Element/node index this range applies to. Used in element_domains to explicitly link a domain to a specific element of a heterogeneous parameter (e.g., element: 0 for node 0). Required when used in element_domains to avoid ambiguous positional indexing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:element ],
        [ sh:description "Step size. Can be: number, argument name, or expression." ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path tvbo:step ] ;
    sh:targetClass tvbo:Range .

tvbo:Parameter a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:Distribution ;
            sh:description "The distribution a dynamics or coupling parameter's value is drawn from. Sampled over space (the default `axis`), the parameter starts from one draw per run: one value per node, or, for a coupling parameter whose `shape` is the graph's `(n_nodes, n_nodes)`, one per connection on the network's edges in row order, every other entry keeping `value`. The draw is keyed by `execution.random_seed` unless the distribution declares its own `seed`, and two parameters under one seed draw independently, so each cell of an `execution.random_seed` axis draws its own start and the trials of one cell share it. Sampled per trial (`axis: trial`), each trial of an `n_trials` ensemble starts from its own draw instead. An algorithm that tunes the parameter starts from the draw. Sampled over time (`axis: time`), the parameter is a stochastic input redrawn at every integration step. Implies heterogeneous=true. A backend that cannot draw refuses the declaration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path tvbo:distribution ],
        [ sh:description "Physical unit of measurement. `UnitEnum` is the curated vocabulary — each of its values is vendored from QUDT (`ontology/tvb-o-units.ttl`) and can be reasoned about dimensionally. The range is deliberately open beyond it: a unit nobody has curated yet is recorded as written and reported `uncurated`, because a closed range forces the author to either misdeclare the quantity or leave it undeclared, and both lose more than an unrecognised string does. An uncurated unit carries no dimensional claim, so a check involving it reports `underdetermined` rather than guessing. Promote one with `tvbo units add <unit>`, which pulls its QUDT record into the vendored module — so every unit TVBO *reasons* about stays authoritative, and only what it *records* is open." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:NanoSEC qudt:MIN qudt:HR qudt:DAY qudt:YR qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV "per_mV" "mV_per_ms" "mV_per_s" qudt:A qudt:NanoA qudt:PicoA "uA_per_cm2" qudt:PicoFARAD qudt:NanoFARAD "uF_per_cm2" qudt:NanoS qudt:MicroS qudt:PicoS "S_per_cm2" "mS_per_cm2" "S_per_m2" "nS_per_mV" "per_nC" "per_pC" qudt:MOL-PER-M3 "mol_per_cm3" qudt:MilliMOL-PER-M3 "mol_per_m_per_A_per_s" qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:KiloM "per_mm2" qudt:PER-M2 qudt:M-PER-SEC "mm_per_ms" "Hz_per_nA" qudt:S-PER-M qudt:H-PER-M qudt:OHM "Mohm" "kohm_cm" qudt:DEG_C "rad_per_ms" qudt:UNITLESS qudt:PERCENT "arbitrary_unit" qudt:KiloGM "kg_per_s" qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW "per_unit" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 10 ;
            sh:path qudt:unit ],
        [ sh:datatype xsd:string ;
            sh:description "Declared value type of this parameter, given as a schema range name — a primitive (``integer``, ``float``, ``string``, ``uriorcurie``) or a class (e.g. ``Distribution``). Documents the expected type when the parameter is a *declaration* carrying no concrete ``value`` (e.g. a GraphGenerator's typed argument interface). Distinct from ``domain`` (numeric bounds) and ``unit``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path tvbo:datatype ],
        [ sh:class tvbo:Argument ;
            sh:description "Arguments handed to whatever resolves `source`, such as the normalisation or the conduction velocity a per-node measure is computed with. They travel with the parameter so a spec states not only where a value comes from but how it is derived, and a resolver refuses an argument it does not know." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path tvbo:source_arguments ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:defaultValue ],
        [ sh:description "Numeric, string, or boolean value, OR an array (nested list) for array-valued constants such as mode-coupling coefficient matrices. ScalarValue accepts any literal primitive type, allowing parameters to carry control flags (e.g., booleans) or symbolic placeholders alongside numeric defaults." ;
            sh:maxCount 1 ;
            sh:or ( [ ] [ ] ) ;
            sh:order 4 ;
            sh:path schema1:value ],
        [ sh:description "The ontology classes this record is an instance of (`tvbo:GlobalCouplingScaling`). A class membership, where `iri` is the record's own address and `grounding` names what it stands in for." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path rdf:type ],
        [ sh:datatype xsd:string ;
            sh:description "The network parameter holding the vocabulary this parameter's values are codes into: value ``k`` is that vocabulary's entry ``k``, which is its ``value`` or the array its ``measure`` names. Declares a categorical attribute, such as each node's functional network on a ``node_template`` parameter, whose array runs over the nodes, beside the network parameter listing the networks' names. A name no network parameter carries is refused when the network is resolved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path tvbo:levels ],
        [ sh:class tvbo:Range ;
            sh:description "Per-element domain overrides for heterogeneous parameters. When specified, element_domains[i] overrides domain for element i during exploration auto-expansion. Length must match parameter shape (e.g., n_nodes for shape \"(n_nodes,)\"). If not set, all elements share the same domain." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path tvbo:element_domains ],
        [ sh:datatype xsd:string ;
            sh:description "WHICH array to select out of `source`. The address space is the source's own: a per-node measure name for a Network (aligning with Network.structural_measures / observational_measures), a dataset key for an HDF5/Zarr store, a recorded measure for an experiment result. Omit when the source resolves to a single array. Without a `source`, or beside the CSV a CSV save writes for it, it is the array's path in the network's own companion (``nodes/parent_index``), and on a ``node_template`` parameter that array runs over the nodes: node ``i`` takes its entry ``i``, so it has one entry per node, and one of another length is refused when the network is read or saved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path tvbo:measure ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "The shape of the parameter's array, as ``(n_nodes,)`` or ``(100, 3)``. A CSV save writes it for each array it links, since a file of rows does not say whether one column is a 1-D array." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path tvbo:shape ],
        [ sh:datatype xsd:string ;
            sh:description "Globally unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:boolean ;
            sh:description "One value per node of the network the parameter's owner runs on, rather than one shared value. Inside a templated subnetwork, every copy of the template gets its own value at the parameter's declared shape; without it, every copy holds the template's value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path tvbo:heterogeneous ],
        [ sh:class prov:Entity ;
            sh:description "WHERE + WHICH + SLICE in one edge — this parameter's array sourced from another experiment's result (an operating point, a tuned ``estimate__<name>`` a fit persisted), a dataset, or a curated entity, PROV ``prov:used``. The full cross-container form of which `source:`+`measure:` is the no-``sel``/no-``experiment`` shorthand; adds label ``reconcile`` and a swept-point ``sel``. Like `source:` the array is resolved lazily and never inlined. An in-study ``experiment`` reference also registers the workflow dependency. Mutually exclusive with `value:`/`source:`/`producer:`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path prov:used ],
        [ sh:class tvbo:Range ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:domain ],
        [ sh:datatype xsd:string ;
            sh:description "The network parameter giving each entry of this vocabulary its parent, an entry of a coarser vocabulary: it holds one code per entry of this one, each a code into the vocabulary its own ``levels`` names, or ``-1`` for an entry with no parent. Declares a hierarchy of vocabularies, such as the regions of an atlas within its lobes. A name no network parameter carries, one without ``levels``, a count of codes other than this vocabulary's entry count, and a code outside the parent vocabulary are refused when the network is resolved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path tvbo:parent ],
        [ sh:class tvbo:Equation ;
            sh:description "The value of a dynamics or coupling parameter as an expression of the other parameters of the same owner, evaluated once when the network is built. It stands in place of `value`, and declaring both is refused. Beside a parameter `u` that declares a `distribution`, `p: {equation: {rhs: \"1 + u\"}}` and `q: {equation: {rhs: \"1 - u\"}}` give two parameters that share one draw. The result is a value like any other: an algorithm that tunes the parameter, or the one it was computed from, does not evaluate the equation again. A backend that cannot evaluate it refuses the declaration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path tvbo:Equation ],
        [ sh:datatype xsd:string ;
            sh:description "The NumPy dtype the parameter's array is held at (``float32``, ``int32``, ``|S15``) where it is read from a file, through ``source`` and ``measure``. A CSV does not record it, so a CSV save writes it for each array it links, and the array reads back at it; absent means float64. Distinct from ``datatype``, a schema range name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path tvbo:dtype ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path tvbo:reported_optimum ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path skos:definition ],
        [ sh:class tvbo:FunctionCall ;
            sh:description "HOW to compute this value, when it is derived rather than obtained — the callable that produces it, its arguments, and (via `output:`) which entry to take from a callable returning several named arrays. The callable resolves against the recipe's `code_source`. Use instead of `source:` for a value that is a deterministic function of the spec's own inputs (a mesh operator, a template matrix): declaring the producer keeps the spec the single source of truth, where pointing at a pre-built file would let the two drift apart silently — and would need a prep step run by hand before the spec could execute. The result is cached and invalidated by the artifact fingerprint, so it is computed once rather than per run. On a `Parameter` it produces the value; on an `Edge` it produces the whole template matrix, which is what lets a connectome or a discrete differential operator be declared rather than pre-built. Mutually exclusive with `value:`/`source:`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path tvbo:producer ],
        [ sh:description "External ontology IRIs (typically GO, ChEBI, UBERON, CL, MeSH) that this entity is a surrogate / abstraction / model of. Realized as the `tvbo:surrogate_of` object property, carried inline with the YAML data instance. Multiple IRIs allowed: a single parameter may abstract several biological processes (e.g. a synaptic conductance grounding both GO:0060079 (excitatory PSP) and GO:0007268 (chemical synaptic transmission))." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path tvbo:surrogate_of ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether a value for this parameter must be supplied. Optional parameters (e.g. a generator's ``seed``) set this to false. Declaration metadata; unset means unconstrained." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path tvbo:required ],
        [ sh:datatype xsd:float ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path tvbo:explored_values ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tvbo:symbol ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rdfs:comment ],
        [ sh:description "WHERE this parameter's value comes from — a curated entity's IRI, or a path (resolved against the declaring spec's directory when relative, as `Network.bids_dir` / `Network.data_file` are). The referent is typically a Network with per-node parameters (dscalar pattern), a binary store (HDF5, Zarr, TSV), or the CSV holding the array alone that a CSV save writes for a parameter whose ``measure`` names its path in the companion. Combine with `measure:` to pick one array out of a source that holds several. A sourced value is never inlined into generated code: it is resolved lazily and the backend reads it from storage, so an array of any size costs nothing in the spec or the emitted module. Mutually exclusive with `value:` (a YAML literal, which IS materialised) and with `producer:` (bytes that are computed rather than read). Distinct from the global `iri:` slot, which is reserved for ontology grounding." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path tvbo:source ] ;
    sh:targetClass tvbo:Parameter .

tvbo:Equation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class tvbo:ConditionalBlock ;
            sh:description "Conditional logic for piecewise equations — the one place a piecewise definition is written, for a state variable, a derived variable or a derived parameter alike. When present, the branches define the equation and `rhs` may be omitted." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path tvbo:conditionals ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tvbo:lhs ],
        [ sh:datatype xsd:string ;
            sh:description "Python code for the equation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path tvbo:pycode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class <https://w3id.org/tvbo/sw/SoftwareRequirement> ;
            sh:description "Primary engine (must appear in environment.requirements; migration target replacing deprecated 'software')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path tvbo:engine ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:definition ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path tvbo:rhs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ],
        [ sh:class tvbo:Parameter ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path tvbo:parameters ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path tvbo:latex ] ;
    sh:targetClass tvbo:Equation .

