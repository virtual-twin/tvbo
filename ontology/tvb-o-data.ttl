<https://w3id.org/tvbo/Epileptor5D/parameters/c> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "c (Epileptor5D parameter)" ;
    dcterms:description "Additive coefficient for the second state variable,         called :math:`y_{0}` in Jirsa paper" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "Additive coefficient for the second state variable,         called :math:`y_{0}` in Jirsa paper" ;
    skos:notation "c" .

<https://w3id.org/tvbo/Epileptor5D/parameters/d> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "d (Epileptor5D parameter)" ;
    dcterms:description "Coefficient of the squared term in the derivative of the second state-variable y1_E5D in Epileptor5D (Jirsa et al" ;
    schema1:defaultValue 5e+00 ;
    skos:definition "Coefficient of the squared term in the derivative of the second state-variable y1_E5D in Epileptor5D (Jirsa et al.,2014)." ;
    skos:notation "d" .

<https://w3id.org/tvbo/Epileptor5D/parameters/modification> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "modification (Epileptor5D parameter)" ;
    dcterms:description "When modification is True, the function h_E5D uses a nonlinear influence on z_E5D" ;
    schema1:defaultValue 0e+00 ;
