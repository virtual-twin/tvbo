<https://w3id.org/tvbo/KIonEx/derived_variables/r> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "r (KIonEx derived variable)" ;
    skos:notation "r" ;
    tvbo:lhs "r" ;
    tvbo:rhs "R_minus*x/pi" .

<https://w3id.org/tvbo/KIonEx/derived_variables/xcond> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "xcond (KIonEx derived variable)" ;
    skos:notation "xcond" ;
    tvbo:lhs "xcond" ;
    tvbo:rhs "Piecewise((Delta - J*r*x + 2*R_minus*x*(V - c_minus), V <= Vstar), (Delta - J*r*x + 2*R_plus*x*(V - c_plus), True))" .

