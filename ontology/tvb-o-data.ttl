<https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/cr> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "cr (GastSchmidtKnosche_SF parameter)" ;
    dcterms:description "It is the weight on Coupling through variable r" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "It is the weight on Coupling through variable r." ;
    skos:notation "cr" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/cv> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "cv (GastSchmidtKnosche_SF parameter)" ;
    dcterms:description "It is the weight on Coupling through variable V" ;
    schema1:defaultValue 0e+00 ;
    skos:definition "It is the weight on Coupling through variable V." ;
    skos:notation "cv" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/eta> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "eta (GastSchmidtKnosche_SF parameter)" ;
    dcterms:description "Mean of heterogeneous noise distribution" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "Mean of heterogeneous noise distribution" ;
    skos:notation "eta" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/tau> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tau (GastSchmidtKnosche_SF parameter)" ;
    dcterms:description "Characteristic time" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "Characteristic time" ;
    skos:notation "tau" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/tau_A> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tau_A (GastSchmidtKnosche_SF parameter)" ;
    dcterms:description "Adaptation time scale" ;
    schema1:defaultValue 1e+01 ;
    skos:definition "Adaptation time scale" ;
    skos:notation "tau_A" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/A> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "A (GastSchmidtKnosche_SF state variable)" ;
    skos:notation "A" ;
    tvbo:lhs "Derivative(A, t)" ;
    tvbo:rhs "B/tau_A" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/B> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "B (GastSchmidtKnosche_SF state variable)" ;
    skos:notation "B" ;
    tvbo:lhs "Derivative(B, t)" ;
    tvbo:rhs "(-A - 2*B + alpha*r)/tau_A" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/V> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "V (GastSchmidtKnosche_SF state variable)" ;
    skos:notation "V" ;
    tvbo:lhs "Derivative(V, t)" ;
    tvbo:rhs "(-A + I + J*r*tau + V**2 + c_pop0*cr + c_pop1*cv + eta - pi**2*r**2*tau**2)/tau" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/r> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "r (GastSchmidtKnosche_SF state variable)" ;
    skos:notation "r" ;
    tvbo:lhs "Derivative(r, t)" ;
    tvbo:rhs "(Delta/(pi*tau) + 2*V*r)/tau" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/I> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "I (Generic2dOscillator parameter)" ;
    dcterms:description "Baseline shift of the cubic nullcline" ;
    schema1:defaultValue 0e+00 ;
    oboInOwl:hasDbXref GO:0060079 ;
    skos:definition "Baseline shift of the cubic nullcline" ;
    skos:notation "I" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/a> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "a (Generic2dOscillator parameter)" ;
    dcterms:description "Vertical shift of the configurable nullcline" ;
    schema1:defaultValue -2e+00 ;
    skos:definition "Vertical shift of the configurable nullcline" ;
    skos:notation "a" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/alpha> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "alpha (Generic2dOscillator parameter)" ;
    dcterms:description "Constant parameter to scale the rate of feedback from the slow variable to the fast variable." ;
    schema1:defaultValue 1e+00 ;
    skos:definition "alpha_G2D is the coefficient of the linear feedback coupling term of the state-variable W_G2D to the first state-equation Vdot_G2D. Constant parameter to scale the rate of feedback from the slow variable to the fast variable." ;
    skos:notation "alpha" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/b> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "b (Generic2dOscillator parameter)" ;
    dcterms:description "Linear slope of the configurable nullcline" ;
    schema1:defaultValue -1e+01 ;
    oboInOwl:hasDbXref GO:0098873,
        GO:0099178 ;
    skos:definition "Linear slope of the configurable nullcline" ;
    skos:notation "b" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/beta> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "beta (Generic2dOscillator parameter)" ;
    dcterms:description "Constant parameter to scale the rate of feedback from the             slow variable to itself" ;
    schema1:defaultValue 1e+00 ;
    skos:definition """Constant parameter to scale the rate of feedback from the
            slow variable to itself""" ;
    skos:notation "beta" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/c> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "c (Generic2dOscillator parameter)" ;
    dcterms:description "Parabolic term of the configurable nullcline" ;
    schema1:defaultValue 0e+00 ;
    skos:definition "Parabolic term of the configurable nullcline" ;
    skos:notation "c" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/d> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "d (Generic2dOscillator parameter)" ;
    dcterms:description "Temporal scale factor" ;
    schema1:defaultValue 2e-02 ;
    skos:definition """Temporal scale factor. Warning: do not use it unless
        you know what you are doing and know about time tides.""" ;
    skos:notation "d" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/e> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "e (Generic2dOscillator parameter)" ;
    dcterms:description "Coefficient of the quadratic term of the cubic nullcline" ;
    schema1:defaultValue 3e+00 ;
    skos:definition "Coefficient of the quadratic term of the cubic nullcline." ;
    skos:notation "e" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/f> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "f (Generic2dOscillator parameter)" ;
    dcterms:description "Coefficient of the cubic term of the cubic nullcline" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "Coefficient of the cubic term of the cubic nullcline." ;
    skos:notation "f" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/g> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "g (Generic2dOscillator parameter)" ;
    dcterms:description "Coefficient of the linear term of the cubic nullcline" ;
    schema1:defaultValue 0e+00 ;
    skos:definition "Coefficient of the linear term of the cubic nullcline." ;
    skos:notation "g" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/gamma> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "gamma (Generic2dOscillator parameter)" ;
    dcterms:description "Constant parameter to reproduce FHN dynamics where                excitatory input currents are negative" ;
    schema1:defaultValue 1e+00 ;
    skos:definition """Constant parameter to reproduce FHN dynamics where
               excitatory input currents are negative.
               It scales both I and the long range coupling term.""" ;
    skos:notation "gamma" .

<https://w3id.org/tvbo/Generic2dOscillator/parameters/tau> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tau (Generic2dOscillator parameter)" ;
    dcterms:description "A time-scale hierarchy can be introduced for the state         variables :math:`V` and :math:`W`" ;
    schema1:defaultValue 1e+00 ;
    skos:definition """A time-scale hierarchy can be introduced for the state
        variables :math:`V` and :math:`W`. Default parameter is 1, which means
        no time-scale hierarchy.""" ;
    skos:notation "tau" .

<https://w3id.org/tvbo/Generic2dOscillator/state_variables/V> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "V (Generic2dOscillator state variable)" ;
    dcterms:description "V_G2D is the first state-variable of the Generic 2-Dimensional Oscillator model, that can be associated with membrane potentials and sodium activation (FitzHugh, 1961)" ;
    oboInOwl:hasDbXref GO:0005272 ;
    skos:notation "V" ;
    tvbo:lhs "Derivative(V, t)" ;
    tvbo:rhs "d*tau*(I*gamma - V**3*f + V**2*e + V*g + V*local_coupling + W*alpha + c_glob*gamma)" .

<https://w3id.org/tvbo/Generic2dOscillator/state_variables/W> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "W (Generic2dOscillator state variable)" ;
    dcterms:description "W_G2D is the second state-variable of the Generic 2-Dimensional Oscillator model, that can be associated with accommodation and refractoriness and considered to represent potassium activation, sodium inactivation, or both (FitzHugh, 1961)" ;
    oboInOwl:hasDbXref GO:0005272 ;
    skos:notation "W" ;
    tvbo:lhs "Derivative(W, t)" ;
    tvbo:rhs "d*(V**2*c + V*b - W*beta + a)/tau" .

<https://w3id.org/tvbo/GenericLinear/parameters/gamma> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "gamma (GenericLinear parameter)" ;
    dcterms:description "Slope parameter of the state-variable 'x_GL', representing the inverse of the relaxation time" ;
    schema1:defaultValue -1e+01 ;
    skos:definition """Slope parameter of the state-variable 'x_GL', representing the inverse of the relaxation time.

Note: The ‘minus’ sign for the self-connections, scaled by 'gamma_GL', guarantees that the nodes have a stable equilibrium point (ref).""" ;
    skos:notation "gamma" .

<https://w3id.org/tvbo/GenericLinear/state_variables/x> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "x (GenericLinear state variable)" ;
    dcterms:description "State-variable of the Generic Linear model" ;
    skos:notation "x" ;
    tvbo:lhs "Derivative(x, t)" ;
    tvbo:rhs "c_pop0 + gamma*x + local_coupling*x" .

<https://w3id.org/tvbo/Hopfield/parameters/tauT> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tauT (Hopfield parameter)" ;
    dcterms:description "The slow time-scale for threshold calculus :math:`\\\\theta`, state-variable of the model" ;
    schema1:defaultValue 5e+00 ;
    skos:definition "The slow time-scale for threshold calculus :math:`\\\\theta`, state-variable of the model." ;
    skos:notation "tauT" .

<https://w3id.org/tvbo/Hopfield/parameters/taux> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "taux (Hopfield parameter)" ;
    dcterms:description "The fast time-scale for potential calculus :math:`x`, state-variable of the model" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "The fast time-scale for potential calculus :math:`x`, state-variable of the model." ;
    skos:notation "taux" .

<https://w3id.org/tvbo/Hopfield/state_variables/theta> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "theta (Hopfield state variable)" ;
    dcterms:description "Slow state variable at node i" ;
    skos:notation "theta" ;
    tvbo:lhs "Derivative(theta, t)" ;
    tvbo:rhs "(c_pop1 - theta)/tauT" .

<https://w3id.org/tvbo/Hopfield/state_variables/x> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "x (Hopfield state variable)" ;
    skos:notation "x" ;
    tvbo:lhs "Derivative(x, t)" ;
    tvbo:rhs "(c_pop0 - x)/taux" .

<https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_1> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "sigma_y0_1 (JansenRit derived variable)" ;
    dcterms:description "Sigmoid function that transforms the average membrane potential of the PCs populations (y0) into an average firing rate to the excitatory interneurons EINs." ;
    skos:notation "sigma_y0_1" ;
    tvbo:lhs "sigma_y0_1" ;
    tvbo:rhs "2.0*nu_max/(exp(r*(-J*a_1*y0 + v0)) + 1.0)" .

<https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_3> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "sigma_y0_3 (JansenRit derived variable)" ;
    dcterms:description "Sigmoid function that transforms the average membrane potential of the PCs populations (y0) into an average firing rate to the inhibitory interneurons IINs." ;
    skos:notation "sigma_y0_3" ;
    tvbo:lhs "sigma_y0_3" ;
    tvbo:rhs "2.0*nu_max/(exp(r*(-J*a_3*y0 + v0)) + 1.0)" .

<https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y1_y2> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "sigma_y1_y2 (JansenRit derived variable)" ;
    dcterms:description """Sigmoid function that transforms the average membrane potential of the interneurons populations (y1-y2)
into an average firing rate to the PCs.""" ;
    skos:notation "sigma_y1_y2" ;
    tvbo:lhs "sigma_y1_y2" ;
    tvbo:rhs "2.0*nu_max/(exp(r*(v0 - y1 + y2)) + 1.0)" .

<https://w3id.org/tvbo/JansenRit/parameters/A> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "A (JansenRit parameter)" ;
    dcterms:description "Maximum amplitude of EPSP [mV]" ;
    schema1:defaultValue 3.25e+00 ;
    oboInOwl:hasDbXref GO:0060079 ;
    skos:definition "Maximum amplitude of EPSP [mV]. Also called average synaptic gain." ;
    skos:notation "A" ;
    tvbo:unit "mV" .

<https://w3id.org/tvbo/JansenRit/parameters/B> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "B (JansenRit parameter)" ;
    dcterms:description "Maximum amplitude of IPSP [mV]" ;
    schema1:defaultValue 2.2e+01 ;
    oboInOwl:hasDbXref GO:0060080 ;
    skos:definition "Maximum amplitude of IPSP [mV]. Also called average synaptic gain." ;
    skos:notation "B" ;
    tvbo:unit "mV" .

<https://w3id.org/tvbo/JansenRit/parameters/J> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "J (JansenRit parameter)" ;
    dcterms:description "Average number of synapses between three neuronal populations of the model" ;
    schema1:defaultValue 1.35e+02 ;
    oboInOwl:hasDbXref GO:0051124,
        GO:0150092 ;
    skos:definition "Average number of synapses between three neuronal populations of the model. It accounts for synaptic phenomena such as neurotransmitter depletion." ;
    skos:notation "J" .

<https://w3id.org/tvbo/JansenRit/parameters/a> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "a (JansenRit parameter)" ;
    dcterms:description "Reciprocal of the time constant of passive membrane and all other spatially distributed delays in the dendritic network. Also called average synaptic time constant." ;
    schema1:defaultValue 1e-01 ;
    oboInOwl:hasDbXref GO:0099605 ;
    skos:definition "Rate constant of the excitatory post-synaptic potential (EPSP). It is interpreted as being the lumped representation of the sum of the reciprocal of the time constant of passive membrane and all other spatially distributed delays, including temporal dispersion in the afferent tract, synaptic diffusion, and resistive-capacitive delay in the dendritic network." ;
    skos:notation "a" ;
    tvbo:unit "per_ms" .

<https://w3id.org/tvbo/JansenRit/parameters/a_1> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "a_1 (JansenRit parameter)" ;
    dcterms:description "Average probability constant of the number of synapses made by the pyramidal cells to the dendrites of the excitatory interneurons  (feedback excitatory loop)" ;
    schema1:defaultValue 1e+00 ;
    oboInOwl:hasDbXref GO:0099536 ;
    skos:definition "Average probability constant of the number of synapses made by the pyramidal cells to the dendrites of the excitatory interneurons  (feedback excitatory loop). It characterizes the connectivity between the PCs and EINs." ;
    skos:notation "a_1" .

<https://w3id.org/tvbo/JansenRit/parameters/a_2> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "a_2 (JansenRit parameter)" ;
    dcterms:description "Average probability constant of the number of synapses made by the EINs to the dendrites of the PCs" ;
    schema1:defaultValue 8e-01 ;
    oboInOwl:hasDbXref GO:0099536 ;
    skos:definition "Average probability constant of the number of synapses made by the EINs to the dendrites of the PCs. It characterizes the excitatory connectivity between the EINs and PCs." ;
    skos:notation "a_2" .

<https://w3id.org/tvbo/JansenRit/parameters/a_3> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "a_3 (JansenRit parameter)" ;
    dcterms:description "Average probability constant of the number of synapses made by the PCs to the dendrites of the IINs" ;
    schema1:defaultValue 2.5e-01 ;
    oboInOwl:hasDbXref GO:0099536 ;
    skos:definition "Average probability constant of the number of synapses made by the PCs to the dendrites of the IINs. It characterizes the connectivity between the PCs and inhibitory IINs." ;
    skos:notation "a_3" .

<https://w3id.org/tvbo/JansenRit/parameters/a_4> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "a_4 (JansenRit parameter)" ;
    dcterms:description "Average probability constant of the number of synapses made by the IINs to the dendrites of the PCs" ;
    schema1:defaultValue 2.5e-01 ;
    oboInOwl:hasDbXref GO:0060077,
        GO:0099536 ;
    skos:definition "Average probability constant of the number of synapses made by the IINs to the dendrites of the PCs. It characterizes the connectivity between the IINs and  PCs." ;
    skos:notation "a_4" .

<https://w3id.org/tvbo/JansenRit/parameters/b> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "b (JansenRit parameter)" ;
    dcterms:description "Rate constant of the inhibitory post-synaptic potential (IPSP)" ;
    schema1:defaultValue 5e-02 ;
    oboInOwl:hasDbXref GO:0060080 ;
    skos:definition "Rate constant of the inhibitory post-synaptic potential (IPSP). It is interpreted as being the lumped representation of the sum of the reciprocal of the time constant of passive membrane and all other spatially distributed delays, including temporal dispersion in the afferent tract, synaptic diffusion, and resistive-capacitive delay in the dendritic network (Freeman 1975)." ;
    skos:notation "b" ;
    tvbo:unit "per_ms" .

<https://w3id.org/tvbo/JansenRit/parameters/mu> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "mu (JansenRit parameter)" ;
    dcterms:description "Mean excitatory external input to the derivative of the state-variable y4_JR (PCs) represented by a pulse density, that consists of activity originating from adjacent and more distant cortical columns, as well as from subcortical structures (e" ;
    schema1:defaultValue 2.2e-01 ;
    oboInOwl:hasDbXref GO:0060079 ;
    skos:definition "Mean excitatory external input to the derivative of the state-variable y4_JR (PCs) represented by a pulse density, that consists of activity originating from adjacent and more distant cortical columns, as well as from subcortical structures (e.g., thalamus)." ;
    skos:notation "mu" ;
    tvbo:unit "per_ms" .

<https://w3id.org/tvbo/JansenRit/parameters/nu_max> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "nu_max (JansenRit parameter)" ;
    dcterms:description "Asymptotic of the sigmoid function Sigm_JR corresponds to the maximum firing rate of the neural populations" ;
    schema1:defaultValue 2.5e-03 ;
    oboInOwl:hasDbXref GO:0099605 ;
    skos:definition "Asymptotic of the sigmoid function Sigm_JR corresponds to the maximum firing rate of the neural populations." ;
    skos:notation "nu_max" ;
    tvbo:unit "per_ms" .

<https://w3id.org/tvbo/JansenRit/parameters/r> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "r (JansenRit parameter)" ;
    dcterms:description "Steepness (or gain) parameter of the sigmoid function Sigm_JR" ;
    schema1:defaultValue 5.6e-01 ;
