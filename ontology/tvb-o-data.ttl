    skos:notation "modification" .

<https://w3id.org/tvbo/Epileptor5D/parameters/r> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "r (Epileptor5D parameter)" ;
    dcterms:description "Temporal scaling in the third state variable,         called :math:`1/\\tau_{0}` in Jirsa paper" ;
    schema1:defaultValue 3.5e-04 ;
