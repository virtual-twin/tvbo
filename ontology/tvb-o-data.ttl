    skos:notation "y3" ;
    tvbo:lhs "Derivative(y3, t)" ;
    tvbo:rhs "Hi*gamma_4*ki*sigma_v45 - ki**2*v3 - 2*ki*y3" .

<https://w3id.org/tvbo/ZetterbergJansen/state_variables/y4> a owl:NamedIndividual,
        tvbo:StateVariable ;
