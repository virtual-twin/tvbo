<https://w3id.org/tvbo/software/vbi> a owl:NamedIndividual,
        tvbo:SoftwarePackage ;
    rdfs:label "vbi" ;
    dcterms:description "Virtual Brain Inference. Probabilistic inference toolkit for whole-brain models — multi-backend simulators (Numba, C++, CuPy, JAX, PyTorch, TVB kernels), a 40+ time-series feature library (statistical, spectral, FC/FCD, complexity, event-detection), and two parallel inference paths (SBI via sbi-toolkit SNPE/SNLE/SNRE with MAF/NSF, and a built-in autograd-based CDE with MDN/MAF estimators). Targets the inverse problem of mapping observed neuroimaging (EEG/MEG/fMRI) onto brain-model parameters." ;
    dcterms:license "MIT" ;
    schema1:codeRepository "https://github.com/ins-amu/vbi" ;
    schema1:identifier "10.5281/zenodo.14795543" ;
    schema1:url "https://vbi.readthedocs.io" .

<https://w3id.org/tvbo/software/vbjax> a owl:NamedIndividual,
        tvbo:SoftwarePackage ;
    rdfs:label "vbjax" ;
    dcterms:description "JAX-based virtual brain library. Provides stochastic Heun integrators for ODE/SDE/DDE/SDDE, canonical neural-mass models (Jansen-Rit, Montbrio-Pazo-Roxin, BVEP, bilinear DCM, Dopa), BOLD/EEG monitors, delay-coupling helpers, a spherical-harmonic neural-field operator, and JAX-native parameter sweeps with gradient-based fitting and MCMC." ;
    dcterms:license "Apache-2.0" ;
    schema1:codeRepository "https://github.com/ins-amu/vbjax" ;
    schema1:identifier "10.5281/zenodo.14204250" ;
    schema1:url "https://github.com/ins-amu/vbjax" .

