<https://w3id.org/tvbo/ZetterbergJansen/state_variables/y1> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "y1 (ZetterbergJansen state variable)" ;
    skos:notation "y1" ;
    tvbo:lhs "Derivative(y1, t)" ;
    tvbo:rhs "He*ke*(gamma_1*sigma_v23 + gamma_1T*(U + coupled_input)) - ke**2*v1 - 2*ke*y1" .

<https://w3id.org/tvbo/ZetterbergJansen/state_variables/y2> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "y2 (ZetterbergJansen state variable)" ;
    skos:notation "y2" ;
    tvbo:lhs "Derivative(y2, t)" ;
    tvbo:rhs "He*ke*(gamma_2*sigma_v1 + gamma_2T*(P + coupled_input)) - ke**2*v2 - 2*ke*y2" .

<https://w3id.org/tvbo/ZetterbergJansen/state_variables/y3> a owl:NamedIndividual,
        tvbo:StateVariable ;
