<https://w3id.org/tvbo/EpileptorRestingState/derived_variables/output> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "output (EpileptorRestingState derived variable)" ;
    skos:notation "output" ;
    tvbo:lhs "output" ;
    tvbo:rhs "p*(-x1 + x2) + x_rs*(1 - p)" .

<https://w3id.org/tvbo/EpileptorRestingState/derived_variables/x1cond> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "x1cond (EpileptorRestingState derived variable)" ;
    skos:notation "x1cond" ;
    tvbo:lhs "x1cond" ;
    tvbo:rhs "Piecewise(((-a)*x1**2 + b*x1, x1 < 0), (slope - x2 + 0.6*(z - 4.0)**2, True))" .

<https://w3id.org/tvbo/EpileptorRestingState/derived_variables/y2cond> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "y2cond (EpileptorRestingState derived variable)" ;
    skos:notation "y2cond" ;
    tvbo:lhs "y2cond" ;
    tvbo:rhs "Piecewise((0.0, x2 < -0.25), (aa*(x2 + 0.25), True))" .

<https://w3id.org/tvbo/EpileptorRestingState/derived_variables/zcond> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "zcond (EpileptorRestingState derived variable)" ;
    skos:notation "zcond" ;
    tvbo:lhs "zcond" ;
    tvbo:rhs "Piecewise((-0.1*z**7, z < 0), (0.0, True))" .

