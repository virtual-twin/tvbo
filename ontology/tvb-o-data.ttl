<https://w3id.org/tvbo/Epileptor5D/parameters/s> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "s (Epileptor5D parameter)" ;
    dcterms:description "Linear coefficient in the slow permittivity state-variable z_E5D in Epileptor5D (Jirsa et al" ;
    schema1:defaultValue 4e+00 ;
    skos:definition "Linear coefficient in the slow permittivity state-variable z_E5D in Epileptor5D (Jirsa et al.,2014)." ;
    skos:notation "s" .

<https://w3id.org/tvbo/Epileptor5D/parameters/slope> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "slope (Epileptor5D parameter)" ;
    dcterms:description "Linear coefficient in the first state variable" ;
    schema1:defaultValue 0e+00 ;
    skos:definition "Linear coefficient in the first state variable" ;
    skos:notation "slope" .

<https://w3id.org/tvbo/Epileptor5D/parameters/tau> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tau (Epileptor5D parameter)" ;
    dcterms:description "Temporal scaling coefficient in fifth state variable" ;
    schema1:defaultValue 1e+01 ;
    skos:definition "Temporal scaling coefficient in fifth state variable" ;
    skos:notation "tau" .

<https://w3id.org/tvbo/Epileptor5D/parameters/tt> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tt (Epileptor5D parameter)" ;
    dcterms:description "Characteristic time scale of the whole-system Epileptor5D" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "Characteristic time scale of the whole-system Epileptor5D." ;
    skos:notation "tt" .

<https://w3id.org/tvbo/Epileptor5D/parameters/x0> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "x0 (Epileptor5D parameter)" ;
    dcterms:description "Epileptogenicity Parameter" ;
    schema1:defaultValue -1.6e+00 ;
    oboInOwl:hasDbXref GO:0060079 ;
    skos:definition """Epileptogenicity Parameter. Degree of excitability or epileptogenicity in Epileptor5D (Jirsa et al.,2014).

If x0 is greater than a critical value, x0,critic = −2.05, the system can trigger seizures autonomously; otherwise it is in its equilibrium state.

Note:
- If modification_E5D:
if x0 is smaller than a critical value, x0,critic = 2.91, can trigger seizures autonomously; otherwise it is in its equilibrium state (Proix et al., 2014).""" ;
    skos:notation "x0" .

<https://w3id.org/tvbo/Epileptor5D/state_variables/g> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "g (Epileptor5D state variable)" ;
    dcterms:description "g_E5D is a low-pass filtered excitatory coupling function from sub-population (x1_E5D, y1_E5D) to (x2_E5D, y2_E5D) in Epileptor5D (Jirsa et al" ;
    skos:notation "g" ;
    tvbo:lhs "Derivative(g, t)" ;
    tvbo:rhs "tt*(-0.01*g + 0.001*x1)" .

<https://w3id.org/tvbo/Epileptor5D/state_variables/x1> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "x1 (Epileptor5D state variable)" ;
    dcterms:description "First state-variable of the first Epileptor5D population (Jirsa et al" ;
    skos:notation "x1" ;
    tvbo:lhs "Derivative(x1, t)" ;
    tvbo:rhs "tt*(Iext + Kvf*c_pop0 + local_coupling*x1 + x1*x1cond + y1 - z)" .

<https://w3id.org/tvbo/Epileptor5D/state_variables/x2> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "x2 (Epileptor5D state variable)" ;
    dcterms:description "First state-variable of the second Epileptor5D sub-population (Jirsa et al" ;
    skos:notation "x2" ;
    tvbo:lhs "Derivative(x2, t)" ;
    tvbo:rhs "tt*(Iext2 + Kf*c_pop1 + bb*g - x2**3 + x2 - y2 - 0.3*z + 1.05)" .

<https://w3id.org/tvbo/Epileptor5D/state_variables/y1> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "y1 (Epileptor5D state variable)" ;
    dcterms:description "Second state-variable of the first Epileptor5D sub-population (Jirsa et al" ;
    skos:notation "y1" ;
    tvbo:lhs "Derivative(y1, t)" ;
    tvbo:rhs "tt*(c - d*x1**2 - y1)" .

<https://w3id.org/tvbo/Epileptor5D/state_variables/y2> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "y2 (Epileptor5D state variable)" ;
    dcterms:description "Second state-variable of the second Epileptor5D population (Jirsa et al" ;
    skos:notation "y2" ;
    tvbo:lhs "Derivative(y2, t)" ;
    tvbo:rhs "tt*(-y2 + y2cond)/tau" .

<https://w3id.org/tvbo/Epileptor5D/state_variables/z> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "z (Epileptor5D state variable)" ;
    dcterms:description "Slow permittivity state-variable of the Epileptor5D (Jirsa et al" ;
    skos:notation "z" ;
    tvbo:lhs "Derivative(z, t)" ;
    tvbo:rhs "r*tt*(Ks*c_pop0 + h - z)" .

<https://w3id.org/tvbo/EpileptorRestingState/derived_variables/lc_1> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "lc_1 (EpileptorRestingState derived variable)" ;
    skos:notation "lc_1" ;
    tvbo:lhs "lc_1" ;
