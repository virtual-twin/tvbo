<https://w3id.org/tvbo/CakanObermayer/state_variables/I_A_var> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "I_A_var (CakanObermayer state variable)" ;
    dcterms:description "Adaptation current." ;
    skos:notation "I_A_var" ;
    tvbo:lhs "Derivative(I_A_var, t)" ;
    tvbo:rhs "(I_A*(mu_se - E_A) - I_A_var)/tau_A" .

<https://w3id.org/tvbo/CakanObermayer/state_variables/mu_se> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "mu_se (CakanObermayer state variable)" ;
    dcterms:description "Filtered mean synaptic input current to the excitatory population." ;
    skos:notation "mu_se" ;
    tvbo:lhs "Derivative(mu_se, t)" ;
    tvbo:rhs "(J_EE*r_E + J_EI*r_I + mu_E + c_pop0 - I_A_var/C - mu_se)/tau_se" .

<https://w3id.org/tvbo/CakanObermayer/state_variables/mu_si> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "mu_si (CakanObermayer state variable)" ;
    dcterms:description "Filtered mean synaptic input current to the inhibitory population." ;
    skos:notation "mu_si" ;
    tvbo:lhs "Derivative(mu_si, t)" ;
    tvbo:rhs "(J_IE*r_E + J_II*r_I + mu_I - mu_si)/tau_si" .

