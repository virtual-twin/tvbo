<https://w3id.org/tvbo/continuations/Generic2dOscillator-bifurcation> a owl:NamedIndividual,
        tvbo:Continuation ;
    rdfs:label "eq_in_a" ;
    dcterms:description "Continue the equilibrium branch of the Generic2dOscillator as parameter a is varied. Detect Hopf bifurcations and continue periodic orbits from all Hopf points." .

<https://w3id.org/tvbo/continuations/Generic2dOscillator-bifurcation-full> a owl:NamedIndividual,
        tvbo:Continuation ;
    rdfs:label "eq_in_a_full" ;
    dcterms:description "Comprehensive bifurcation analysis of the Generic2dOscillator. Continues the equilibrium branch as parameter a is varied, detects fold and Hopf bifurcations, then branches to periodic orbits from both Hopf points with fine-tuned solver settings." .

