<https://w3id.org/tvbo/WilsonCowan/state_variables/E> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "E (WilsonCowan state variable)" ;
    dcterms:description "State-variable of the Wilson and Cowan model (Wilson and Cowan, 1973), denoting the mean firing rate of all excitatory neurons of the population" ;
    oboInOwl:hasDbXref GO:0098815 ;
    skos:notation "E" ;
    tvbo:lhs "Derivative(E, t)" ;
    tvbo:rhs "(-E + s_e*(-E*r_e + k_e))/tau_e" .

<https://w3id.org/tvbo/WilsonCowan/state_variables/I> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "I (WilsonCowan state variable)" ;
    dcterms:description "State-variable of the Wilson and Cowan model (Wilson and Cowan, 1973), denoting the mean firing rate of all inhibitory neurons of the population" ;
    oboInOwl:hasDbXref GO:0060080 ;
    skos:notation "I" ;
    tvbo:lhs "Derivative(I, t)" ;
    tvbo:rhs "(-I + s_i*(-I*r_i + k_i))/tau_i" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/Fe_ext> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "Fe_ext (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "Fe_ext" ;
    tvbo:lhs "Fe_ext" ;
    tvbo:rhs "Piecewise((0, K_ext_e*(c_pop0 + lc_E + ou_drift*weight_noise) < 0), (c_pop0 + lc_E + ou_drift*weight_noise, True))" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/Fi_ext> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "Fi_ext (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "Fi_ext" ;
    tvbo:lhs "Fi_ext" ;
    tvbo:rhs "lc_I" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/S_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "S_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "S_e" ;
    tvbo:lhs "S_e" ;
    tvbo:rhs "(-sV0 + sigma_V_e)/DsV0" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/S_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "S_i (ZerlautAdaptationFirstOrder derived variable)" ;
    dcterms:description """Scaling of the remote input for the inhibitory population with
        respect to the excitatory population.""" ;
    skos:notation "S_i" ;
    tvbo:lhs "S_i" ;
    tvbo:rhs "(-sV0 + sigma_V_i)/DsV0" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_V_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "T_V_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "T_V_e" ;
    tvbo:lhs "T_V_e" ;
    tvbo:rhs "(U_e_e**2*fe_e*tau_e**2 + U_i_e**2*fi_e*tau_i**2)/(U_e_e**2*fe_e*tau_e**2/(T_m_e + tau_e) + U_i_e**2*fi_e*tau_i**2/(T_m_e + tau_i))" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_V_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "T_V_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "T_V_i" ;
    tvbo:lhs "T_V_i" ;
    tvbo:rhs "(U_e_i**2*fe_i*tau_e**2 + U_i_i**2*fi_i*tau_i**2)/(U_e_i**2*fe_i*tau_e**2/(T_m_i + tau_e) + U_i_i**2*fi_i*tau_i**2/(T_m_i + tau_i))" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "T_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "T_e" ;
    tvbo:lhs "T_e" ;
    tvbo:rhs "(-TvN0 + T_V_e*g_L/C_m)/DTvN0" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "T_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "T_i" ;
    tvbo:lhs "T_i" ;
    tvbo:rhs "(-TvN0 + T_V_i*g_L/C_m)/DTvN0" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_m_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "T_m_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "T_m_e" ;
    tvbo:lhs "T_m_e" ;
    tvbo:rhs "C_m/mu_G_e" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/T_m_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "T_m_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "T_m_i" ;
    tvbo:lhs "T_m_i" ;
    tvbo:rhs "C_m/mu_G_i" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_e_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "U_e_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "U_e_e" ;
    tvbo:lhs "U_e_e" ;
    tvbo:rhs "Q_e*(E_e - mu_V_e)/mu_G_e" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_e_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "U_e_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "U_e_i" ;
    tvbo:lhs "U_e_i" ;
    tvbo:rhs "Q_e*(E_e - mu_V_i)/mu_G_i" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_i_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "U_i_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "U_i_e" ;
    tvbo:lhs "U_i_e" ;
    tvbo:rhs "Q_i*(E_i - mu_V_e)/mu_G_e" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/U_i_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "U_i_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "U_i_i" ;
    tvbo:lhs "U_i_i" ;
    tvbo:rhs "Q_i*(E_i - mu_V_i)/mu_G_i" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "V_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "V_e" ;
    tvbo:lhs "V_e" ;
    tvbo:rhs "(-muV0 + mu_V_e)/DmuV0" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "V_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "V_i" ;
    tvbo:lhs "V_i" ;
    tvbo:rhs "(-muV0 + mu_V_i)/DmuV0" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_thre_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "V_thre_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "V_thre_e" ;
    tvbo:lhs "V_thre_e" ;
    tvbo:rhs "1000.0*P0_e + 1000.0*P1_e*V_e + 1000.0*P2_e*S_e + 1000.0*P3_e*T_e + 1000.0*P4_e*V_e**2 + 1000.0*P5_e*S_e**2 + 1000.0*P6_e*T_e**2 + 1000.0*P7_e*S_e*V_e + 1000.0*P8_e*T_e*V_e + 1000.0*P9_e*S_e*T_e" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/V_thre_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "V_thre_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "V_thre_i" ;
    tvbo:lhs "V_thre_i" ;
    tvbo:rhs "1000.0*P0_i + 1000.0*P1_i*V_i + 1000.0*P2_i*S_i + 1000.0*P3_i*T_i + 1000.0*P4_i*V_i**2 + 1000.0*P5_i*S_i**2 + 1000.0*P6_i*T_i**2 + 1000.0*P7_i*S_i*V_i + 1000.0*P8_i*T_i*V_i + 1000.0*P9_i*S_i*T_i" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/f_out_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "f_out_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "f_out_e" ;
    tvbo:lhs "f_out_e" ;
    tvbo:rhs "erfc(sqrt(2)*(V_thre_e - mu_V_e)/(2*sigma_V_e))/(2*T_V_e)" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/f_out_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "f_out_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "f_out_i" ;
    tvbo:lhs "f_out_i" ;
    tvbo:rhs "erfc(sqrt(2)*(V_thre_i - mu_V_i)/(2*sigma_V_i))/(2*T_V_i)" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fe_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "fe_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "fe_e" ;
    tvbo:lhs "fe_e" ;
    tvbo:rhs "K_ext_e*(Fe_ext + external_input_ex_ex) + N_tot*p_connect_e*(1.0 - g)*(E + 1/1000000)" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fe_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "fe_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "fe_i" ;
    tvbo:lhs "fe_i" ;
    tvbo:rhs "K_ext_e*(Fe_ext + external_input_in_ex) + N_tot*p_connect_e*(1.0 - g)*(E + 1/1000000)" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fi_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "fi_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "fi_e" ;
    tvbo:lhs "fi_e" ;
    tvbo:rhs "K_ext_i*(Fi_ext + external_input_ex_in) + N_tot*g*p_connect_i*(I + 1/1000000)" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/fi_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "fi_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "fi_i" ;
    tvbo:lhs "fi_i" ;
    tvbo:rhs "K_ext_i*(Fi_ext + external_input_in_in) + N_tot*g*p_connect_i*(I + 1/1000000)" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/lc_E> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "lc_E (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "lc_E" ;
    tvbo:lhs "lc_E" ;
    tvbo:rhs "local_coupling*E" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/lc_I> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "lc_I (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "lc_I" ;
    tvbo:lhs "lc_I" ;
    tvbo:rhs "I*local_coupling" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_G_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "mu_G_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "mu_G_e" ;
    tvbo:lhs "mu_G_e" ;
    tvbo:rhs "g_L + mu_Ge_e + mu_Gi_e" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_G_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "mu_G_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "mu_G_i" ;
    tvbo:lhs "mu_G_i" ;
    tvbo:rhs "g_L + mu_Ge_i + mu_Gi_i" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Ge_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "mu_Ge_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "mu_Ge_e" ;
    tvbo:lhs "mu_Ge_e" ;
    tvbo:rhs "Q_e*fe_e*tau_e" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Ge_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "mu_Ge_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "mu_Ge_i" ;
    tvbo:lhs "mu_Ge_i" ;
    tvbo:rhs "Q_e*fe_i*tau_e" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Gi_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "mu_Gi_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "mu_Gi_e" ;
    tvbo:lhs "mu_Gi_e" ;
    tvbo:rhs "Q_i*fi_e*tau_i" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_Gi_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "mu_Gi_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "mu_Gi_i" ;
    tvbo:lhs "mu_Gi_i" ;
    tvbo:rhs "Q_i*fi_i*tau_i" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_V_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "mu_V_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "mu_V_e" ;
    tvbo:lhs "mu_V_e" ;
    tvbo:rhs "(E_L_e*g_L + E_e*mu_Ge_e + E_i*mu_Gi_e - W_e)/mu_G_e" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/mu_V_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "mu_V_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "mu_V_i" ;
    tvbo:lhs "mu_V_i" ;
    tvbo:rhs "(E_L_i*g_L + E_e*mu_Ge_i + E_i*mu_Gi_i - W_i)/mu_G_i" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/sigma_V_e> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "sigma_V_e (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "sigma_V_e" ;
    tvbo:lhs "sigma_V_e" ;
    tvbo:rhs "sqrt(U_e_e**2*fe_e*tau_e**2/(2.0*T_m_e + 2.0*tau_e) + U_i_e**2*fi_e*tau_i**2/(2.0*T_m_e + 2.0*tau_i))" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/derived_variables/sigma_V_i> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "sigma_V_i (ZerlautAdaptationFirstOrder derived variable)" ;
    skos:notation "sigma_V_i" ;
    tvbo:lhs "sigma_V_i" ;
    tvbo:rhs "sqrt(U_e_i**2*fe_i*tau_e**2/(2.0*T_m_i + 2.0*tau_e) + U_i_i**2*fi_i*tau_i**2/(2.0*T_m_i + 2.0*tau_i))" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/C_m> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "C_m (ZerlautAdaptationFirstOrder parameter)" ;
    dcterms:description "membrane capacitance [pF]" ;
    schema1:defaultValue 2e+02 ;
    oboInOwl:hasDbXref GO:0042391 ;
    skos:definition "membrane capacitance [pF]" ;
    skos:notation "C_m" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/DTvN0> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "DTvN0 (ZerlautAdaptationFirstOrder parameter)" ;
    dcterms:description "Normalization factors page 48 after the equation 4 from [ZD_2018]" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "Normalization factors page 48 after the equation 4 from [ZD_2018]" ;
    skos:notation "DTvN0" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/DmuV0> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "DmuV0 (ZerlautAdaptationFirstOrder parameter)" ;
