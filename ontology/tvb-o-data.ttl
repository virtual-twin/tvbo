        tvbo:DerivedVariable ;
    rdfs:label "I_pump (KIonEx derived variable)" ;
    skos:notation "I_pump" ;
    tvbo:lhs "I_pump" ;
    tvbo:rhs "1.0*rho/((exp((Ckp - K_o)/DCkp) + 1.0)*(exp((Cnap - Na_i)/DCnap) + 1.0))" .

<https://w3id.org/tvbo/KIonEx/derived_variables/K_i> a owl:NamedIndividual,
