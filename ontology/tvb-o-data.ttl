<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/W_e> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "W_e (ZerlautAdaptationFirstOrder state variable)" ;
    dcterms:description "Level of adaptation of excitatory in pA" ;
    skos:notation "W_e" ;
    tvbo:lhs "Derivative(W_e, t)" ;
    tvbo:rhs "E*b_e - W_e/tau_w_e + a_e*(-E_L_e + mu_V_e)/tau_w_e" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/W_i> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "W_i (ZerlautAdaptationFirstOrder state variable)" ;
    dcterms:description "Level of adaptation of inhibitory in pA" ;
    skos:notation "W_i" ;
    tvbo:lhs "Derivative(W_i, t)" ;
    tvbo:rhs "I*b_i - W_i/tau_w_i + a_i*(-E_L_i + mu_V_i)/tau_w_i" .

<https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/ou_drift> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "ou_drift (ZerlautAdaptationFirstOrder state variable)" ;
    skos:notation "ou_drift" ;
    tvbo:lhs "Derivative(ou_drift, t)" ;
    tvbo:rhs "-ou_drift/tau_OU" .

<https://w3id.org/tvbo/ZetterbergJansen/derived_variables/coupled_input> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "coupled_input (ZetterbergJansen derived variable)" ;
    skos:notation "coupled_input" ;
    tvbo:lhs "coupled_input" ;
    tvbo:rhs "2*e0/(exp(rho_1*(-c_pop0 - local_coupling*v6 + rho_2)) + 1)" .

<https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v1> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "sigma_v1 (ZetterbergJansen derived variable)" ;
    skos:notation "sigma_v1" ;
    tvbo:lhs "sigma_v1" ;
    tvbo:rhs "Piecewise((0, rho_1*(rho_2 - v1) > 709), (2*e0/(exp(rho_1*(rho_2 - v1)) + 1), True))" .

<https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v23> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "sigma_v23 (ZetterbergJansen derived variable)" ;
    skos:notation "sigma_v23" ;
    tvbo:lhs "sigma_v23" ;
    tvbo:rhs "Piecewise((0, rho_1*(rho_2 - (v2 - v3)) > 709), (2*e0/(exp(rho_1*(rho_2 - (v2 - v3))) + 1), True))" .

<https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v45> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "sigma_v45 (ZetterbergJansen derived variable)" ;
    skos:notation "sigma_v45" ;
    tvbo:lhs "sigma_v45" ;
    tvbo:rhs "Piecewise((0, rho_1*(rho_2 - (v4 - v5)) > 709), (2*e0/(exp(rho_1*(rho_2 - (v4 - v5))) + 1), True))" .

