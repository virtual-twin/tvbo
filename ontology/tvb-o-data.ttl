    skos:notation "cv" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/eta> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "eta (GastSchmidtKnosche_SD parameter)" ;
    dcterms:description "Mean of heterogeneous noise distribution" ;
    schema1:defaultValue -6e+00 ;
    skos:definition "Mean of heterogeneous noise distribution" ;
    skos:notation "eta" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/tau> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tau (GastSchmidtKnosche_SD parameter)" ;
    dcterms:description "Characteristic time" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "Characteristic time" ;
    skos:notation "tau" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/tau_A> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tau_A (GastSchmidtKnosche_SD parameter)" ;
    dcterms:description "Adaptation time scale" ;
    schema1:defaultValue 1e+01 ;
    skos:definition "Adaptation time scale" ;
    skos:notation "tau_A" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/A> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "A (GastSchmidtKnosche_SD state variable)" ;
    skos:notation "A" ;
    tvbo:lhs "Derivative(A, t)" ;
    tvbo:rhs "B/tau_A" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/B> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "B (GastSchmidtKnosche_SD state variable)" ;
    skos:notation "B" ;
    tvbo:lhs "Derivative(B, t)" ;
    tvbo:rhs "(-A - 2*B + alpha*r)/tau_A" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/V> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "V (GastSchmidtKnosche_SD state variable)" ;
    skos:notation "V" ;
    tvbo:lhs "Derivative(V, t)" ;
    tvbo:rhs "(I + J*r*tau*(1 - A) + V**2 + c_pop0*cr + c_pop1*cv + eta - pi**2*r**2*tau**2)/tau" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/r> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "r (GastSchmidtKnosche_SD state variable)" ;
    skos:notation "r" ;
    tvbo:lhs "Derivative(r, t)" ;
    tvbo:rhs "(Delta/(pi*tau) + 2*V*r)/tau" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/Delta> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "Delta (GastSchmidtKnosche_SF parameter)" ;
    dcterms:description "Half-width of heterogeneous noise distribution" ;
    schema1:defaultValue 2e+00 ;
    skos:definition "Half-width of heterogeneous noise distribution" ;
    skos:notation "Delta" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/I> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "I (GastSchmidtKnosche_SF parameter)" ;
    dcterms:description "External homogeneous current" ;
    schema1:defaultValue 0e+00 ;
    skos:definition "External homogeneous current" ;
    skos:notation "I" .

<https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/J> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "J (GastSchmidtKnosche_SF parameter)" ;
    dcterms:description "Synaptic weight" ;
    schema1:defaultValue 2.12132e+01 ;
    oboInOwl:hasDbXref GO:0099536 ;
