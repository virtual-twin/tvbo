<https://w3id.org/tvbo/JansenRit/state_variables/y3> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "y3 (JansenRit state variable)" ;
    dcterms:description "Second state-variable of the first Jansen-Rit population (excitatory PCs)" ;
    oboInOwl:hasDbXref CL:0000598 ;
    skos:notation "y3" ;
    tvbo:lhs "Derivative(y3, t)" ;
    tvbo:rhs "A*a*sigma_y1_y2 - a**2*y0 - 2.0*a*y3" .

<https://w3id.org/tvbo/JansenRit/state_variables/y4> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "y4 (JansenRit state variable)" ;
    dcterms:description "Second state-variable of the second excitatory Jansen-Rit population (excitatory EINs)" ;
    oboInOwl:hasDbXref CL:0000099 ;
    skos:notation "y4" ;
    tvbo:lhs "Derivative(y4, t)" ;
    tvbo:rhs "A*a*(J*a_2*sigma_y0_1 + c_pop0 + local_coupling*(y1 - y2) + mu) - a**2*y1 - 2.0*a*y4" .

<https://w3id.org/tvbo/JansenRit/state_variables/y5> a owl:NamedIndividual,
