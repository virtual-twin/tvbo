<https://w3id.org/tvbo/WilsonCowan/parameters/theta_i> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "theta_i (WilsonCowan parameter)" ;
    dcterms:description "Excitation threshold of inhibitory population (Sanz-Leon et al" ;
