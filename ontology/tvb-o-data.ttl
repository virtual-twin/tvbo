    rdfs:label "h (KIonEx derived variable)" ;
    skos:notation "h" ;
    tvbo:lhs "h" ;
    tvbo:rhs "1.1 - 1.0/(1.0 + 24.5325301971094*exp(-8.0*n))" .

<https://w3id.org/tvbo/KIonEx/derived_variables/minf> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "minf (KIonEx derived variable)" ;
    skos:notation "minf" ;
    tvbo:lhs "minf" ;
