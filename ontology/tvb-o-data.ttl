<https://w3id.org/tvbo/CoombesByrne/state_variables/V> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "V (CoombesByrne state variable)" ;
    skos:notation "V" ;
    tvbo:lhs "Derivative(V, t)" ;
    tvbo:rhs "V**2 + c_pop0 + eta + g*(-V + v_syn) - pi**2*r**2" .

