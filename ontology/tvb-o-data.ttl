    schema1:defaultValue 1.5e+01 ;
    oboInOwl:hasDbXref GO:0060077,
        GO:0097060 ;
    skos:definition "Synaptic weight i-->i" ;
    skos:notation "J_ii" .

<https://w3id.org/tvbo/DumontGutkin/parameters/eta_e> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "eta_e (DumontGutkin parameter)" ;
    dcterms:description "Mean heterogeneous current on excitatory population" ;
    schema1:defaultValue -5e+00 ;
    oboInOwl:hasDbXref GO:0098815 ;
    skos:definition "Mean heterogeneous current on excitatory population" ;
    skos:notation "eta_e" .

<https://w3id.org/tvbo/DumontGutkin/parameters/eta_i> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "eta_i (DumontGutkin parameter)" ;
    dcterms:description "Mean heterogeneous current on inhibitory population" ;
    schema1:defaultValue -5e+00 ;
    oboInOwl:hasDbXref GO:0060080 ;
    skos:definition "Mean heterogeneous current on inhibitory population" ;
    skos:notation "eta_i" .

<https://w3id.org/tvbo/DumontGutkin/parameters/tau_e> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tau_e (DumontGutkin parameter)" ;
    dcterms:description "Characteristic time of excitatory population" ;
    schema1:defaultValue 1e+01 ;
    oboInOwl:hasDbXref GO:0043179,
        GO:0060079 ;
    skos:definition "Characteristic time of excitatory population" ;
    skos:notation "tau_e" .

<https://w3id.org/tvbo/DumontGutkin/parameters/tau_i> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tau_i (DumontGutkin parameter)" ;
    dcterms:description "Characteristic time of inhibitory population" ;
    schema1:defaultValue 1e+01 ;
    oboInOwl:hasDbXref GO:0043180,
        GO:0060080 ;
    skos:definition "Characteristic time of inhibitory population" ;
    skos:notation "tau_i" .

<https://w3id.org/tvbo/DumontGutkin/parameters/tau_s> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tau_s (DumontGutkin parameter)" ;
    dcterms:description "Synaptic time constant" ;
    schema1:defaultValue 1e+00 ;
    oboInOwl:hasDbXref GO:0099536 ;
    skos:definition "Synaptic time constant" ;
    skos:notation "tau_s" .

<https://w3id.org/tvbo/DumontGutkin/state_variables/V_e> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "V_e (DumontGutkin state variable)" ;
    skos:notation "V_e" ;
    tvbo:lhs "Derivative(V_e, t)" ;
    tvbo:rhs "(I_e + V_e**2 + eta_e - pi**2*r_e**2*tau_e**2 + s_ee*tau_e - s_ei*tau_e)/tau_e" .

<https://w3id.org/tvbo/DumontGutkin/state_variables/V_i> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "V_i (DumontGutkin state variable)" ;
    skos:notation "V_i" ;
    tvbo:lhs "Derivative(V_i, t)" ;
    tvbo:rhs "(I_i + V_i**2 + eta_i - pi**2*r_i**2*tau_i**2 + s_ie*tau_i - s_ii*tau_i)/tau_i" .

<https://w3id.org/tvbo/DumontGutkin/state_variables/r_e> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "r_e (DumontGutkin state variable)" ;
    skos:notation "r_e" ;
    tvbo:lhs "Derivative(r_e, t)" ;
    tvbo:rhs "(Delta_e/(pi*tau_e) + 2*V_e*r_e)/tau_e" .

<https://w3id.org/tvbo/DumontGutkin/state_variables/r_i> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "r_i (DumontGutkin state variable)" ;
    skos:notation "r_i" ;
    tvbo:lhs "Derivative(r_i, t)" ;
    tvbo:rhs "(Delta_i/(pi*tau_i) + 2*V_i*r_i)/tau_i" .

<https://w3id.org/tvbo/DumontGutkin/state_variables/s_ee> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "s_ee (DumontGutkin state variable)" ;
    skos:notation "s_ee" ;
    tvbo:lhs "Derivative(s_ee, t)" ;
    tvbo:rhs "(J_ee*r_e + c_pop0 - s_ee)/tau_s" .

<https://w3id.org/tvbo/DumontGutkin/state_variables/s_ei> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "s_ei (DumontGutkin state variable)" ;
    skos:notation "s_ei" ;
    tvbo:lhs "Derivative(s_ei, t)" ;
    tvbo:rhs "(J_ei*r_i - s_ei)/tau_s" .

<https://w3id.org/tvbo/DumontGutkin/state_variables/s_ie> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "s_ie (DumontGutkin state variable)" ;
    skos:notation "s_ie" ;
    tvbo:lhs "Derivative(s_ie, t)" ;
    tvbo:rhs "(Gamma*c_pop0 + J_ie*r_e - s_ie)/tau_s" .

<https://w3id.org/tvbo/DumontGutkin/state_variables/s_ii> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "s_ii (DumontGutkin state variable)" ;
    skos:notation "s_ii" ;
    tvbo:lhs "Derivative(s_ii, t)" ;
    tvbo:rhs "(J_ii*r_i - s_ii)/tau_s" .

<https://w3id.org/tvbo/Epileptor2D/derived_variables/h> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "h (Epileptor2D derived variable)" ;
    skos:notation "h" ;
    tvbo:lhs "h" ;
    tvbo:rhs "Piecewise((x0 + 3.0/(exp((-x1 - 1*0.5)/0.1) + 1.0), modification > 0), (zcond + 4*(-x0 + x1), True))" .

<https://w3id.org/tvbo/Epileptor2D/derived_variables/x1cond> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "x1cond (Epileptor2D derived variable)" ;
    skos:notation "x1cond" ;
    tvbo:lhs "x1cond" ;
    tvbo:rhs "Piecewise((a*x1**2 + x1*(-b + d), x1 < 0), (d*x1 - slope - 0.6*(z - 4.0)**2, True))" .

<https://w3id.org/tvbo/Epileptor2D/derived_variables/zcond> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "zcond (Epileptor2D derived variable)" ;
    skos:notation "zcond" ;
    tvbo:lhs "zcond" ;
    tvbo:rhs "Piecewise((-0.1*z**7, z < 0), (0, True))" .

<https://w3id.org/tvbo/Epileptor2D/parameters/Iext> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "Iext (Epileptor2D parameter)" ;
    dcterms:description "External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al" ;
    schema1:defaultValue 3.1e+00 ;
    skos:definition "External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al.,2014)." ;
    skos:notation "Iext" .

<https://w3id.org/tvbo/Epileptor2D/parameters/Ks> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "Ks (Epileptor2D parameter)" ;
    dcterms:description "Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al" ;
    schema1:defaultValue 0e+00 ;
    skos:definition """Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al., 2014).

The coupling quantifies the influence of neuronal fast discharges x_E2D on the local slow permittivity variable z_E2D.""" ;
    skos:notation "Ks" .

<https://w3id.org/tvbo/Epileptor2D/parameters/Kvf> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "Kvf (Epileptor2D parameter)" ;
    dcterms:description "Coupling scaling on a very fast time scale" ;
    schema1:defaultValue 0e+00 ;
    skos:definition "Coupling scaling on a very fast time scale." ;
    skos:notation "Kvf" .

<https://w3id.org/tvbo/Epileptor2D/parameters/a> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "a (Epileptor2D parameter)" ;
    dcterms:description "Coefficient of the cubic term in the first state-variable x_E2D via the function f(x)_E2D, in Epileptor2D Proix et al" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "Coefficient of the cubic term in the first state-variable x_E2D via the function f(x)_E2D, in Epileptor2D Proix et al.,2014)." ;
    skos:notation "a" .

<https://w3id.org/tvbo/Epileptor2D/parameters/b> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "b (Epileptor2D parameter)" ;
    dcterms:description "Coefficient of the squared term in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al" ;
    schema1:defaultValue 3e+00 ;
    skos:definition "Coefficient of the squared term in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al.,2014)." ;
    skos:notation "b" .

<https://w3id.org/tvbo/Epileptor2D/parameters/c> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "c (Epileptor2D parameter)" ;
    dcterms:description "Additive coefficient for the second state-variable x_{2},         called :math:`y_{0}` in Jirsa paper" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "Additive coefficient for the second state-variable x_{2},         called :math:`y_{0}` in Jirsa paper." ;
    skos:notation "c" .

<https://w3id.org/tvbo/Epileptor2D/parameters/d> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "d (Epileptor2D parameter)" ;
    dcterms:description "Coefficient of the squared term in the first state-variable x_E2D via the function f in Epileptor2D (Proix et al" ;
    schema1:defaultValue 5e+00 ;
    skos:definition "Coefficient of the squared term in the first state-variable x_E2D via the function f in Epileptor2D (Proix et al.,2014)." ;
    skos:notation "d" .

<https://w3id.org/tvbo/Epileptor2D/parameters/modification> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "modification (Epileptor2D parameter)" ;
    dcterms:description "When modification is True, the function h_E2D uses a nonlinear influence on z_E2D" ;
    schema1:defaultValue 0e+00 ;
    skos:definition "When modification is True, the function h_E2D uses a nonlinear influence on z_E2D. The default value is False, i.e., linear influence on z_E2D." ;
    skos:notation "modification" .

<https://w3id.org/tvbo/Epileptor2D/parameters/r> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "r (Epileptor2D parameter)" ;
    dcterms:description "Temporal scaling in the slow state-variable, \\         called :math:`1\\tau_{0}` in Jirsa paper (see class Epileptor)" ;
    schema1:defaultValue 3.5e-04 ;
    skos:definition """Temporal scaling in the slow state-variable, \\
        called :math:`1\\tau_{0}` in Jirsa paper (see class Epileptor).""" ;
    skos:notation "r" .

<https://w3id.org/tvbo/Epileptor2D/parameters/slope> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "slope (Epileptor2D parameter)" ;
    dcterms:description "Linear coefficient in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al" ;
    schema1:defaultValue 0e+00 ;
    skos:definition "Linear coefficient in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al.,2014)." ;
    skos:notation "slope" .

<https://w3id.org/tvbo/Epileptor2D/parameters/tt> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tt (Epileptor2D parameter)" ;
    dcterms:description "Characteristic time scale of the whole-system Epileptor2D" ;
    schema1:defaultValue 1e+00 ;
    skos:definition "Characteristic time scale of the whole-system Epileptor2D." ;
    skos:notation "tt" .

<https://w3id.org/tvbo/Epileptor2D/parameters/x0> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "x0 (Epileptor2D parameter)" ;
    dcterms:description "Degree of excitability or epileptogenicity in Epileptor2D (Proix et al" ;
    schema1:defaultValue -1.6e+00 ;
    oboInOwl:hasDbXref GO:0043179 ;
    skos:definition """Degree of excitability or epileptogenicity in Epileptor2D (Proix et al.,2014).

If x0 is greater than a critical value, x0,critic = −2.05 (i.e., in the supercritical regime), the system can trigger seizures autonomously; otherwise it is in its equilibrium state (i.e., in the subcritical regime).

Note:
- If modification_E2D:
if x0 is smaller than a critical value, x0,critic = 2.91, can trigger seizures autonomously; otherwise it is in its equilibrium state (Proix et al., 2014).""" ;
    skos:notation "x0" .

<https://w3id.org/tvbo/Epileptor2D/state_variables/x1> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "x1 (Epileptor2D state variable)" ;
    dcterms:description "First state-variable in the Epileptor2D (Proix et al" ;
    skos:notation "x1" ;
    tvbo:lhs "Derivative(x1, t)" ;
    tvbo:rhs "tt*(Iext + Kvf*c_pop0 + c + local_coupling*x1 - x1*x1cond - z)" .

<https://w3id.org/tvbo/Epileptor2D/state_variables/z> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "z (Epileptor2D state variable)" ;
    dcterms:description "Slow permittivity state-variable of the Epileptor2D (Proix et al" ;
    skos:notation "z" ;
    tvbo:lhs "Derivative(z, t)" ;
    tvbo:rhs "r*tt*(Ks*c_pop0 + h - z)" .

<https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/N> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "N (Epileptor3DStefanescuMcDonald parameter)" ;
    schema1:defaultValue 1e+00 ;
    oboInOwl:hasDbXref GO:0042391 ;
    skos:definition "Effective population size / scaling of the resting-state regulation term." ;
    skos:notation "N" .

<https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/tau_z> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "tau_z (Epileptor3DStefanescuMcDonald parameter)" ;
    schema1:defaultValue 2.857e+03 ;
    skos:definition "Slow timescale for the z permittivity variable." ;
    skos:notation "tau_z" ;
    tvbo:unit "ms" .

<https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/x_0> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "x_0 (Epileptor3DStefanescuMcDonald parameter)" ;
    schema1:defaultValue -1.6e+00 ;
    skos:definition "Excitability parameter (Epileptor convention)." ;
    skos:notation "x_0" .

<https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/x1> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "x1 (Epileptor3DStefanescuMcDonald state variable)" ;
    dcterms:description "Fast excitable variable (placeholder Epileptor-like dynamics)." ;
    skos:notation "x1" ;
    tvbo:lhs "Derivative(x1, t)" ;
    tvbo:rhs "N*(x1 - x1**3/3 - z + c_pop0)" .

<https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/z> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "z (Epileptor3DStefanescuMcDonald state variable)" ;
    dcterms:description "Slow permittivity / excitability variable." ;
    skos:notation "z" ;
    tvbo:lhs "Derivative(z, t)" ;
    tvbo:rhs "(4*(x1 - x_0) - z)/tau_z" .

<https://w3id.org/tvbo/Epileptor5D/derived_variables/h> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "h (Epileptor5D derived variable)" ;
    skos:notation "h" ;
    tvbo:lhs "h" ;
    tvbo:rhs "Piecewise((x0 + 3/(exp((-x1 - 1*0.5)/0.1) + 1), modification > 0), (zcond + 4*(-x0 + x1), True))" .

<https://w3id.org/tvbo/Epileptor5D/derived_variables/x1cond> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "x1cond (Epileptor5D derived variable)" ;
    skos:notation "x1cond" ;
    tvbo:lhs "x1cond" ;
    tvbo:rhs "Piecewise(((-a)*x1**2 + b*x1, x1 < 0), (slope - x2 + 0.6*(z - 4.0)**2, True))" .

<https://w3id.org/tvbo/Epileptor5D/derived_variables/y2cond> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "y2cond (Epileptor5D derived variable)" ;
    skos:notation "y2cond" ;
    tvbo:lhs "y2cond" ;
    tvbo:rhs "Piecewise((0.0, x2 < -0.25), (aa*(x2 + 0.25), True))" .

<https://w3id.org/tvbo/Epileptor5D/derived_variables/zcond> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "zcond (Epileptor5D derived variable)" ;
    skos:notation "zcond" ;
    tvbo:lhs "zcond" ;
    tvbo:rhs "Piecewise((-0.1*z**7, z < 0), (0.0, True))" .

<https://w3id.org/tvbo/Epileptor5D/parameters/Iext> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "Iext (Epileptor5D parameter)" ;
    dcterms:description "External input current to the first sub-population (x1_E5D, y1_E5D) via the state-variable x1_E5D, in Epileptor5D (Jirsa et al" ;
    schema1:defaultValue 3.1e+00 ;
    skos:definition "External input current to the first sub-population (x1_E5D, y1_E5D) via the state-variable x1_E5D, in Epileptor5D (Jirsa et al.,2014)." ;
    skos:notation "Iext" .

<https://w3id.org/tvbo/Epileptor5D/parameters/Iext2> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "Iext2 (Epileptor5D parameter)" ;
    dcterms:description "External input current to the second population" ;
    schema1:defaultValue 4.5e-01 ;
    skos:definition "External input current to the second population" ;
    skos:notation "Iext2" .

<https://w3id.org/tvbo/Epileptor5D/parameters/Kf> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "Kf (Epileptor5D parameter)" ;
    dcterms:description "Correspond to the coupling scaling on a fast time scale" ;
    schema1:defaultValue 0e+00 ;
    skos:definition "Correspond to the coupling scaling on a fast time scale." ;
    skos:notation "Kf" .

<https://w3id.org/tvbo/Epileptor5D/parameters/Ks> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "Ks (Epileptor5D parameter)" ;
    dcterms:description "Permittivity coupling on the slow permittivity state-variable z_E5D in Epileptor5D (Proix et al" ;
    schema1:defaultValue 0e+00 ;
    skos:definition """Permittivity coupling on the slow permittivity state-variable z_E5D in Epileptor5D (Proix et al., 2014).

The coupling quantifies the influence of neuronal fast discharges x1_E5D on the local slow permittivity variable z_E5D.""" ;
    skos:notation "Ks" .

<https://w3id.org/tvbo/Epileptor5D/parameters/Kvf> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "Kvf (Epileptor5D parameter)" ;
    dcterms:description "Coupling scaling on a very fast time scale" ;
    schema1:defaultValue 0e+00 ;
    skos:definition "Coupling scaling on a very fast time scale." ;
    skos:notation "Kvf" .

<https://w3id.org/tvbo/Epileptor5D/parameters/a> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "a (Epileptor5D parameter)" ;
