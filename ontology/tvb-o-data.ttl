<https://w3id.org/tvbo/KIonEx/derived_variables/Vcond> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "Vcond (KIonEx derived variable)" ;
    skos:notation "Vcond" ;
    tvbo:lhs "Vcond" ;
    tvbo:rhs "Piecewise((R_minus*c_pop0*(-V + E)/pi - R_minus*x**2 + V_temp + eta, V <= Vstar), (R_minus*c_pop0*(-V + E)/pi - R_plus*x**2 + V_temp + eta, True))" .

<https://w3id.org/tvbo/KIonEx/derived_variables/beta> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
