<https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/alpha> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "alpha (GastSchmidtKnosche_SF parameter)" ;
    dcterms:description "adaptation rate" ;
    schema1:defaultValue 1e+01 ;
    oboInOwl:hasDbXref GO:0042391 ;
