<https://w3id.org/tvbo/JansenRit/parameters/v0> a owl:NamedIndividual,
        tvbo:Parameter ;
    rdfs:label "v0 (JansenRit parameter)" ;
    dcterms:description "Average firing threshold (PSP) for which half of the firing rate is achieved" ;
    schema1:defaultValue 5.52e+00 ;
    oboInOwl:hasDbXref GO:0099605 ;
    skos:definition """Average firing threshold (PSP) for which half of the firing rate is achieved.

Note:
- The usual value for this parameter is 6.0 (Jansen et al., 1993; Jansen & Rit, 1995).""" ;
    skos:notation "v0" ;
    tvbo:unit "mV" .

