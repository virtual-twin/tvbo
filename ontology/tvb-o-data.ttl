<https://w3id.org/tvbo/CakanObermayer/derived_variables/r_E> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "r_E (CakanObermayer derived variable)" ;
    dcterms:description "Excitatory population firing rate. In full aLN this is ``Phi(mu_E_eff, s_EE)`` with ``Phi`` precomputed; here a sigmoid stand-in is used." ;
    skos:notation "r_E" ;
    tvbo:lhs "r_E" ;
    tvbo:rhs "r_max/(1 + exp(-k_phi*(mu_se - mu_th)))" .

<https://w3id.org/tvbo/CakanObermayer/derived_variables/r_I> a owl:NamedIndividual,
        tvbo:DerivedVariable ;
    rdfs:label "r_I (CakanObermayer derived variable)" ;
    dcterms:description "Inhibitory population firing rate (sigmoid stand-in for aLN Phi)." ;
    skos:notation "r_I" ;
    tvbo:lhs "r_I" ;
    tvbo:rhs "r_max/(1 + exp(-k_phi*(mu_si - mu_th)))" .

