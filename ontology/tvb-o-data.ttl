<https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/alpha> a owl:NamedIndividual,
        tvbo:StateVariable ;
    rdfs:label "alpha (StefanescuJirsa3D state variable)" ;
    dcterms:description "Inhibitory fast variable (per mode)." ;
    oboInOwl:hasDbXref GO:0060080 ;
    skos:notation "alpha" ;
    tvbo:lhs "Derivative(alpha, t)" ;
    tvbo:rhs "beta - e_i*alpha**3 + f_i*alpha**2 - gamma + K_21*(C_ik*xi - alpha) + II_i + c_pop0 + local_coupling*xi" .

<https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/beta> a owl:NamedIndividual,
        tvbo:StateVariable ;
