    skos:notation "y4" ;
    tvbo:lhs "Derivative(y4, t)" ;
    tvbo:rhs "He*ke*(gamma_3*sigma_v23 + gamma_3T*(Q + coupled_input)) - ke**2*v4 - 2*ke*y4" .

<https://w3id.org/tvbo/ZetterbergJansen/state_variables/y5> a owl:NamedIndividual,
