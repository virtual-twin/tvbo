@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The merged ontology's own annotations and its creators' names; `make gen-merged` stamps them over every header its inputs carry and adds the version and date.
<https://w3id.org/tvbo/tvbo.owl> a owl:Ontology ;
    dcterms:title "The Virtual Brain Ontology"@en ;
    rdfs:label "TVB-O" ;
    dcterms:description "TVB-O, The Virtual Brain Ontology, describes large-scale brain network models and their simulation: neural mass and neural field models with their parameters, state variables and equations, coupling functions, connectomes and brain atlases, integrators and noise, observation models, and the simulation experiments and studies that combine them. Every model, network and experiment curated in the TVB-O database is an individual of the ontology at https://w3id.org/tvbo/<collection>/<name>."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <https://orcid.org/0000-0002-2599-0165>, <https://orcid.org/0000-0001-5266-7235>, <https://orcid.org/0000-0003-0197-2576>, <https://orcid.org/0000-0002-4643-4782> ;
    vann:preferredNamespacePrefix "tvbo" ;
    vann:preferredNamespaceUri "https://w3id.org/tvbo/" ;
    dcterms:issued "2025-11-20"^^xsd:date ;
    dcterms:bibliographicCitation "https://doi.org/10.1101/2025.11.19.689211" ;
    rdfs:seeAlso <https://w3id.org/tvbo/tvb-o-axioms.ttl>, <https://w3id.org/tvbo/tvb-o.shacl.ttl> .

<https://orcid.org/0000-0002-2599-0165> schema:name "Leon Martin" .
<https://orcid.org/0000-0001-5266-7235> schema:name "Konstantin Bülau" .
<https://orcid.org/0000-0003-0197-2576> schema:name "Leon Stefanovski" .
<https://orcid.org/0000-0002-4643-4782> schema:name "Petra Ritter" .
