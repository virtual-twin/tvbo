    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/b_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/b_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode quadratic coefficient for the excitatory xi dynamics.</dcterms:description>
        <rdfs:label>b_i (StefanescuJirsa3D derived variable)</rdfs:label>
        <skos:notation>b_i</skos:notation>
        <tvbo:lhs>b_i</tvbo:lhs>
        <tvbo:rhs>b</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/c_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/c_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode constant for the excitatory eta dynamics.</dcterms:description>
        <rdfs:label>c_i (StefanescuJirsa3D derived variable)</rdfs:label>
        <skos:notation>c_i</skos:notation>
        <tvbo:lhs>c_i</tvbo:lhs>
        <tvbo:rhs>c</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/d_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/d_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode quadratic coefficient for the excitatory eta dynamics.</dcterms:description>
