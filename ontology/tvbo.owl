    <!-- https://w3id.org/tvbo/UpdateRule -->

    <owl:Class rdf:about="https://w3id.org/tvbo/UpdateRule">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
