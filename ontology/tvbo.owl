        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/alpha_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/b_e"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/b_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/c_e"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/c_ee"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/c_ei"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/c_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/c_ie"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/c_ii"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/k_e"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/k_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/r_e"/>
