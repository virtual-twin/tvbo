    <rdf:Description rdf:about="https://w3id.org/tvbo/dataset_path">
        <rdfs:label>dataset_path (slot)</rdfs:label>
        <skos:definition>Dataset path for array-valued parameters. When set, the parameter value is stored in the binary companion file (HDF5 or Zarr) at this path. The value slot is omitted.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>dataset_path</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/datatype">
        <rdfs:label>datatype (slot)</rdfs:label>
        <skos:definition>Declared value type of this parameter, given as a schema range name — a primitive (``integer``, ``float``, ``string``, ``uriorcurie``) or a class (e.g. ``Distribution``). Documents the expected type when the parameter is a *declaration* carrying no concrete ``value`` (e.g. a GraphGenerator&apos;s typed argument interface). Distinct from ``domain`` (numeric bounds) and ``unit``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>datatype</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/date_created">
        <rdfs:label>date_created (slot)</rdfs:label>
        <skos:definition>ISO 8601 (prov:generatedAtTime)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>date_created</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/default">
        <rdfs:label>default (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>default</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/definition">
        <rdfs:label>definition (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>definition</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/derived_from">
        <rdfs:label>derived_from (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>derived_from</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/description">
        <rdfs:label>description (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>description</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/descriptor">
        <rdfs:label>descriptor (slot)</rdfs:label>
        <skos:definition>Short alphanumeric identifier for the BIDS desc- filename entity (e.g., SC, FC, EC, SCFC). Classifies the connectivity modality of the network&apos;s edge measures.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>descriptor</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dimension_labels">
        <rdfs:label>dimension_labels (slot)</rdfs:label>
        <skos:definition>Ordered labels for the matrix columns (dim-1) when the matrix is non-square.  Row labels (dim-0) are the parent Network&apos;s node labels.  Stored as HDF5 dimension scales in the companion file.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>dimension_labels</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/doi">
        <rdfs:label>doi (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>doi</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/elements">
        <rdfs:label>elements (slot)</rdfs:label>
        <skos:definition>Topology indices: either a file reference, or (when inlined on a Network) a dotted path inside the parent Network&apos;s h5 companion to the (M, 3) int triangle face array. Default convention: ``mesh/faces``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>elements</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/equation_type">
        <rdfs:label>equation_type (slot)</rdfs:label>
        <skos:definition>Type of equation: &apos;differential&apos; (default) means dx/dt = rhs, &apos;algebraic&apos; means 0 = rhs or x ~ rhs (DAE constraint). Algebraic equations are used by ModelingToolkit.jl backend.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>equation_type</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/experiment_yaml_hash">
        <rdfs:label>experiment_yaml_hash (slot)</rdfs:label>
        <skos:definition>SHA-256 hex digest of the normalised experiment YAML that produced this artifact. Used by the cross-experiment cache (see :class:`SimulationStudy.from_file`) to detect when a cached upstream result has gone stale because the experiment&apos;s spec was edited. Computed as ``hashlib.sha256(yaml.safe_dump(normalized_yaml).encode()).hexdigest()`` over the fully resolved (post-``!include``) experiment block.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>experiment_yaml_hash</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/extension">
        <rdfs:label>extension (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>extension</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/generated_by">
        <rdfs:label>generated_by (slot)</rdfs:label>
        <skos:definition>Software/agent identifier (prov:wasGeneratedBy)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>generated_by</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/geometry">
        <rdfs:label>geometry (slot)</rdfs:label>
        <skos:definition>Optional file for geometry/ROI mask (e.g., NIfTI, GIfTI).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>geometry</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/groups">
        <rdfs:label>groups (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>groups</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/has_reference">
        <rdfs:label>has_reference (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>has_reference</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/hash">
        <rdfs:label>hash (slot)</rdfs:label>
        <skos:definition>SHA-256 hex digest of the file at fingerprinting (recomputed lazily when mtime/size differ).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>hash</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/hemi">
        <rdfs:label>hemi (slot)</rdfs:label>
        <skos:definition>BIDS hemi- entity (L or R) for hemisphere-specific surface/volume data</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>hemi</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/interpolation">
        <rdfs:label>interpolation (slot)</rdfs:label>
        <skos:definition>Interpolation for a data-driven stimulus: &apos;linear&apos; or &apos;cubic&apos;.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>interpolation</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/keys">
        <rdfs:label>keys (slot)</rdfs:label>
        <skos:definition>Named keys for multi-dimensional coupling. When dimension &gt; 1, provides symbolic names for each index (e.g., keys: [lre, ffi] for dimension: 2). Used in equations as variable names.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>keys</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/label">
        <rdfs:label>label (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>label</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/labels_dimensions">
        <rdfs:label>labels_dimensions (slot)</rdfs:label>
        <skos:definition>Mapping of dimension names to their labels (JSON-encoded dict).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>labels_dimensions</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/labels_ordering">
        <rdfs:label>labels_ordering (slot)</rdfs:label>
        <skos:definition>Ordering of dimensions: Time, State Variable, Space, Mode.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>labels_ordering</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/learning_rate_schedule">
        <rdfs:label>learning_rate_schedule (slot)</rdfs:label>
        <skos:definition>Learning rate schedule: &apos;constant&apos;, &apos;linear&apos;, &apos;exponential&apos;</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>learning_rate_schedule</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/lhs">
        <rdfs:label>lhs (slot)</rdfs:label>
        <skos:altLabel>lefthandside</skos:altLabel>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>lhs</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/library">
        <rdfs:label>library (slot)</rdfs:label>
        <skos:definition>Native library/module providing the callable.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>library</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/license">
        <rdfs:label>license (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>license</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/measure">
        <rdfs:label>measure (slot)</rdfs:label>
        <skos:definition>Selector into the source. When `source` points at a Network with per-node parameters (or a dscalar with multiple maps), picks which named measure to load. Aligns with names listed in Network.structural_measures / Network.observational_measures. Ignored when the source resolves to a scalar/array dataset.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>measure</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/measure_type">
        <rdfs:label>measure_type (slot)</rdfs:label>
        <skos:definition>Sub-type within the phenotype (e.g. &apos;raw&apos;, &apos;unadjusted&apos;, &apos;age-corrected&apos;, &apos;derived&apos;, &apos;RT&apos;, &apos;accuracy&apos;).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>measure_type</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/measures">
        <rdfs:label>measures (slot)</rdfs:label>
        <skos:definition>Names of the measures present in the h5 companion (one ``measures/&lt;name&gt;`` dataset per name). Example: ``[g_factor, PMAT24_A_CR, PMAT24_A_RTCR, CardSort_Unadj, ProcSpeed_Unadj]``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>measures</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/mesh_file">
        <rdfs:label>mesh_file (slot)</rdfs:label>
        <skos:definition>Path to external mesh file (GIFTI, VTK, MSH, FreeSurfer, etc.).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>mesh_file</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/mesh_format">
        <rdfs:label>mesh_format (slot)</rdfs:label>
        <skos:definition>Explicit format override (gifti, freesurfer, meshio, vtk, gmsh). Auto-detected from extension if null.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>mesh_format</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/model_equation_ref">
        <rdfs:label>model_equation_ref (slot)</rdfs:label>
        <skos:definition>BIDS ModelEq reference: path to _eq.xml LEMS file.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>model_equation_ref</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/model_param_ref">
        <rdfs:label>model_param_ref (slot)</rdfs:label>
        <skos:definition>BIDS ModelParam reference: path to _param.xml LEMS file.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>model_param_ref</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/module">
        <rdfs:label>module (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>module</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/name">
        <rdfs:label>name (slot)</rdfs:label>
        <skos:definition>Globally unique identifier for the entity.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/common"/>
        <skos:notation>name</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/node_mapping">
        <rdfs:label>node_mapping (slot)</rdfs:label>
        <skos:definition>HDF5 dataset path for node-to-parent mapping. Int32 array of shape (N,) where entry i is the parent node ID. Required when parent_network is set.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>node_mapping</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/noise_type">
        <rdfs:label>noise_type (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>noise_type</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/normals">
        <rdfs:label>normals (slot)</rdfs:label>
        <skos:definition>Optional path inside the parent Network&apos;s h5 (or an external file) to per-vertex normals (N, 3) float. Default convention: ``mesh/normals``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>normals</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/objectives">
        <rdfs:label>objectives (slot)</rdfs:label>
        <skos:definition>Names of observations minimised by an adaptive `strategy` (e.g. &apos;nsga2&apos;). Each entry references an existing observation already framed lower-is-better (e.g. `one_minus_fc`, `psd_mae`). Count sets the semantics: 0 → pure sweep (use `record`), 1 → single-objective, ≥2 → multi-objective / Pareto. Ignored when strategy is &apos;grid&apos;. Forward-compatible with `Search.objectives`.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>objectives</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/observational_measures">
        <rdfs:label>observational_measures (slot)</rdfs:label>
        <skos:definition>BEP017 measure names for observational targets (e.g., BoldCorrelation)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>observational_measures</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/on_region">
        <rdfs:label>on_region (slot)</rdfs:label>
        <skos:definition>Mesh/atlas subset where BC applies.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>on_region</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/outsym">
        <rdfs:label>outsym (slot)</rdfs:label>
        <skos:definition>Output symbol names for the edge model. E.g. [&apos;P&apos;] for a scalar power flow, [&apos;Fx&apos;, &apos;Fy&apos;] for 2D forces. Maps directly to outsym in ND.jl EdgeModel. If not specified, derived from coupling variables of the connected vertex dynamics.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>outsym</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/parcel_map_field">
        <rdfs:label>parcel_map_field (slot)</rdfs:label>
        <skos:definition>When the mesh is inlined on a Network with a parcellation, the dotted path inside the parent&apos;s h5 to the per-vertex parcel id array. Default: ``nodes/parent_index``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>parcel_map_field</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/parent_network">
        <rdfs:label>parent_network (slot)</rdfs:label>
        <skos:definition>Path/URI to parent (coarser) Network. When set, this network is a refinement where each node maps to exactly one parent node via node_mapping.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>parent_network</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/precision">
        <rdfs:label>precision (slot)</rdfs:label>
        <skos:definition>Floating point precision: &apos;float32&apos; or &apos;float64&apos;</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>precision</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/preconditioner">
        <rdfs:label>preconditioner (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>preconditioner</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/primary_weight">
        <rdfs:label>primary_weight (slot)</rdfs:label>
        <skos:definition>Name of the edge group that should serve as the canonical weights matrix when ``weights_matrix`` is queried. Lets a single Network sidecar bundle several connectivity variants (e.g. band-specific NMF reweightings, distance-modulated SC, shuffled controls) under different edge names while still presenting one of them as the active weight to consumers (simulators, observation pipelines). Defaults to ``weight`` / ``weights`` / ``sc`` lookup when not set.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>primary_weight</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/processing_pipeline">
        <rdfs:label>processing_pipeline (slot)</rdfs:label>
        <skos:definition>Processing pipeline used to generate the tractography</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>processing_pipeline</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/quantity_kind">
        <rdfs:label>quantity_kind (slot)</rdfs:label>
        <skos:definition>Scalar, vector, or tensor.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>quantity_kind</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/reconstruction">
        <rdfs:label>reconstruction (slot)</rdfs:label>
        <skos:definition>BIDS rec- entity (e.g., dTOR)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>reconstruction</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/record">
        <rdfs:label>record (slot)</rdfs:label>
        <skos:definition>Names of observations to compute and record at EACH grid point, stacked over the sweep into one array per name. Entries may be derived observations (e.g. `loss`) or `analysis` diagnostics (e.g. `ad_gradient`, `fd_gradient`, `lyapunov`) — this is how a sweep of the diagnostics themselves is declared, replacing any per-point Python driver. Complementary to `observable` (a single scalar reduction); when both are absent the full observation Bunch is recorded.</skos:definition>
        <skos:definition>Whether to include this element in simulation output files. Applicable to state variables (default true), derived variables (default false), and network nodes (default true). Set false to suppress recording.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>record</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/reference">
        <rdfs:label>reference (slot)</rdfs:label>
        <skos:definition>Publication or DOI reference for this tractography dataset</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>reference</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/references">
        <rdfs:label>references (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>references</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/rhs">
        <rdfs:label>rhs (slot)</rdfs:label>
        <skos:altLabel>righthandside</skos:altLabel>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>rhs</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/sampler">
        <rdfs:label>sampler (slot)</rdfs:label>
        <skos:definition>MCMC sampler (&apos;nuts&apos;). Each backend maps its own way.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>sampler</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/sampling_period_unit">
        <rdfs:label>sampling_period_unit (slot)</rdfs:label>
        <skos:definition>Unit of the sampling period (e.g., &apos;ms&apos;, &apos;s&apos;).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>sampling_period_unit</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/scale">
        <rdfs:label>scale (slot)</rdfs:label>
        <skos:definition>BIDS scale- entity (BEP017, e.g., 1000)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>scale</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/segmentation">
        <rdfs:label>segmentation (slot)</rdfs:label>
        <skos:definition>BIDS seg- entity (e.g., ordered, ranked, 17Networks)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>segmentation</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/session_id">
        <rdfs:label>session_id (slot)</rdfs:label>
        <skos:definition>BIDS session identifier.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>session_id</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/source">
        <rdfs:label>source (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>source</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/source_branch">
        <rdfs:label>source_branch (slot)</rdfs:label>
        <skos:definition>Name of a previously computed branch (for from_branch method).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>source_branch</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/source_network">
        <rdfs:label>source_network (slot)</rdfs:label>
        <skos:definition>Path or name of the Network whose nodes define the source endpoints of this Edge. Symmetric counterpart to `target_network`. Together they let an Edge bridge any two Networks: both unset (within-Network edge), one set (this Network ↔ the named one), or both set (peer-to-peer projection between two other Networks). Accepts either an absolute IRI (peer Network) or the relative-path sentinel `parent` / `parent/parent` (cross-scale up/down via the Node.subnetwork hierarchy).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>source_network</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/source_var">
        <rdfs:label>source_var (slot)</rdfs:label>
        <skos:definition>Output variable from source node to use (e.g., &apos;x_out&apos;). If not specified, uses first output variable from source dynamics.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>source_var</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/strategy">
        <rdfs:label>strategy (slot)</rdfs:label>
        <skos:definition>Search strategy over the decision space (the `space` axes). &apos;grid&apos; (default) exhaustively evaluates the Cartesian/zip grid of axis points — today&apos;s behaviour. &apos;nsga2&apos; runs an adaptive multi-objective genetic search (pymoo NSGA-II) that returns the non-dominated Pareto front over `objectives`; axes then supply only decision-variable bounds (domain lo/hi), and per-strategy hyper-parameters (population_size, num_generations, seed, reference_point) live in `parameters`. Extensible later to &apos;random&apos; / &apos;sobol&apos; / &apos;cmaes&apos;. Forward-compatible with the planned unified `Search.strategy` (see dev/unified_search.md).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>strategy</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/structural_measures">
        <rdfs:label>structural_measures (slot)</rdfs:label>
        <skos:definition>BEP017 measure names for structural connectivity (e.g., streamlineCount, tractLength)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>structural_measures</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/subject_id">
        <rdfs:label>subject_id (slot)</rdfs:label>
        <skos:definition>BIDS subject identifier.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>subject_id</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/subjects">
        <rdfs:label>subjects (slot)</rdfs:label>
        <skos:definition>Ordered list of subject IDs (e.g. HCP-YA 6-digit IDs). Each ``measures/&lt;name&gt;`` array in the h5 companion is indexed by this order.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>subjects</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/symbol">
        <rdfs:label>symbol (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>symbol</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/symmetry">
        <rdfs:label>symmetry (slot)</rdfs:label>
        <skos:definition>Edge symmetry type for NetworkDynamics.jl EdgeModel: &apos;directed&apos; (default), &apos;antisymmetric&apos;, or &apos;symmetric&apos;. AntiSymmetric edges flip sign for the reverse direction.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>symmetry</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/target_component">
        <rdfs:label>target_component (slot)</rdfs:label>
        <skos:definition>Component to attach this event to. Can be a node label, edge label, or &apos;all_edges&apos;/&apos;all_vertices&apos; for broadcast. If not specified, event is experiment-level.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>target_component</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/target_network">
        <rdfs:label>target_network (slot)</rdfs:label>
        <skos:definition>Path or name of the Network whose nodes define the target endpoints (e.g. the columns of a non-square projection matrix such as a gain matrix region → EEG sensors). Also accepts the relative-path sentinel `parent` / `parent/parent` for cross-scale signal flow up the Node.subnetwork hierarchy. One mechanism handles both projection matrices (absolute IRI) and multi-scale boundaries (sentinel).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>target_network</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/target_regions">
        <rdfs:label>target_regions (slot)</rdfs:label>
        <skos:definition>Regions a stimulus-type event targets: &apos;all&apos; (broadcast to every node) or explicit region labels / indices. More expressive than the integer-only `regions` slot; when both are absent the event applies to all regions.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>target_regions</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/target_var">
        <rdfs:label>target_var (slot)</rdfs:label>
        <skos:definition>Input variable on target node to connect to (e.g., &apos;c_in&apos;). If not specified, uses first coupling input from target dynamics.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>target_var</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/task_iri">
        <rdfs:label>task_iri (slot)</rdfs:label>
        <skos:definition>Cognitive Atlas (``cogat:``) IRI of the assessment instrument / task that produced this measure (e.g. ``cogat:trm_4a3fd79d09cba`` for PMAT24).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>task_iri</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/task_name">
        <rdfs:label>task_name (slot)</rdfs:label>
        <skos:definition>BIDS task name for the simulation (e.g., &apos;rest&apos;, &apos;simulation&apos;).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>task_name</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/template">
        <rdfs:label>template (slot)</rdfs:label>
        <skos:definition>BIDS tpl- entity (e.g., FSLMNI152, MNI152NLin2009cAsym)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>template</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/time_integrator">
        <rdfs:label>time_integrator (slot)</rdfs:label>
        <skos:definition>e.g., implicit Euler, Crank-Nicolson.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>time_integrator</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/title">
        <rdfs:label>title (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>title</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/tolerances">
        <rdfs:label>tolerances (slot)</rdfs:label>
        <skos:definition>Abs/rel tolerances.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>tolerances</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/transform">
        <rdfs:label>transform (slot)</rdfs:label>
        <skos:definition>Optional decode applied to this axis&apos;s value before it is bound to the referenced Parameter: &apos;none&apos; (default) or &apos;log10&apos; (the parameter is set to 10 ** value, so an adaptive strategy searches the raw bounds in log10 units — e.g. sigma searched over domain {lo: -2.0, hi: -0.5}). Distinct from a logarithmic grid *spacing*; this is an evaluation-time decode. Forward-compatible with the harmonised `Axis` (see dev/tvboptim_harmonization.md).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>transform</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/unit">
        <rdfs:label>unit (slot)</rdfs:label>
        <skos:definition>Physical unit of measurement. Values are drawn from the QUDT ontology (http://qudt.org/vocab/unit/) with UO cross-references where available.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>unit</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/value">
        <rdfs:label>value (slot)</rdfs:label>
        <skos:definition>Numeric, string, or boolean value, OR an array (nested list) for array-valued constants such as mode-coupling coefficient matrices. ScalarValue accepts any literal primitive type, allowing parameters to carry control flags (e.g., booleans) or symbolic placeholders alongside numeric defaults.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>value</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/vertices_field">
        <rdfs:label>vertices_field (slot)</rdfs:label>
        <skos:definition>When the mesh is inlined on a Network, the dotted path inside the parent&apos;s h5 to vertex coordinates. Default: ``nodes/coordinates``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>vertices_field</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/wrt">
        <rdfs:label>wrt (slot)</rdfs:label>
        <skos:definition>Quantity/quantities the analysis is taken with respect to, e.g. a parameter &apos;c_sigmJR.G&apos; for a gradient/sensitivity. Omitted for analyses that need no explicit differentiation target.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>wrt</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/acronym">
        <rdfs:label>acronym (dbs)</rdfs:label>
        <skos:definition>Short abbreviation (e.g., UPDRS)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>acronym</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/description">
        <rdfs:label>description (dbs)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>description</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/diagnosis">
        <rdfs:label>diagnosis (dbs)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>diagnosis</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/electrode_id">
        <rdfs:label>electrode_id (dbs)</rdfs:label>
        <skos:definition>Unique identifier for this electrode</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>electrode_id</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/evaluator">
        <rdfs:label>evaluator (dbs)</rdfs:label>
        <skos:definition>Who performed the rating (e.g., rater initials, clinician ID, or system)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>evaluator</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/handedness">
        <rdfs:label>handedness (dbs)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>handedness</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/hemisphere">
        <rdfs:label>hemisphere (dbs)</rdfs:label>
        <skos:definition>Hemisphere of electrode (left/right)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>hemisphere</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/label">
        <rdfs:label>label (dbs)</rdfs:label>
        <skos:definition>Optional human-readable label (e.g., &quot;1a&quot;)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>label</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/manufacturer">
        <rdfs:label>manufacturer (dbs)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>manufacturer</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/mode">
        <rdfs:label>mode (dbs)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>mode</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/model">
        <rdfs:label>model (dbs)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>model</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/name">
        <rdfs:label>name (dbs)</rdfs:label>
        <skos:definition>Full name of the scale (e.g., Unified Parkinson’s Disease Rating Scale)</skos:definition>
        <skos:definition>Full name of the score (e.g., Unified Parkinson&apos;s Disease Rating Scale - Part III)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>name</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/notes">
        <rdfs:label>notes (dbs)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>notes</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/recon_path">
        <rdfs:label>recon_path (dbs)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>recon_path</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/reference">
        <rdfs:label>reference (dbs)</rdfs:label>
        <skos:definition>DOI, PMID or persistent identifier</skos:definition>
        <skos:definition>PubMed ID, DOI, or other reference to the score definition</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>reference</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/timepoint">
        <rdfs:label>timepoint (dbs)</rdfs:label>
        <skos:definition>Timepoint of assessment (e.g., &quot;1 month post-op&quot;, &quot;6 months post-op&quot;)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>timepoint</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/timing_info">
        <rdfs:label>timing_info (dbs)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>timing_info</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/version">
        <rdfs:label>version (dbs)</rdfs:label>
        <skos:definition>Version of the instrument (e.g., 3.0)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>version</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/dbs/volume_data">
        <rdfs:label>volume_data (dbs)</rdfs:label>
        <skos:definition>Reference to raw or thresholded volume</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/dbs"/>
        <skos:notation>volume_data</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/application_category">
        <rdfs:label>application_category (software)</rdfs:label>
        <skos:definition>High-level category (e.g., simulation, analysis, specification).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <skos:notation>application_category</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/author">
        <rdfs:label>author (software)</rdfs:label>
        <skos:definition>Original author(s) or creating organization(s).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <skos:notation>author</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/build_hash">
        <rdfs:label>build_hash (software)</rdfs:label>
        <skos:definition>Deterministic hash of the resolved dependency set.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <skos:notation>build_hash</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/citation">
        <rdfs:label>citation (software)</rdfs:label>
        <skos:definition>Additional citation strings or DOIs.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <skos:notation>citation</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/container_image">
        <rdfs:label>container_image (software)</rdfs:label>
        <skos:definition>Container image reference (e.g., ghcr.io/org/img:tag@sha256:...).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <skos:notation>container_image</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/description">
        <rdfs:label>description (software)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <skos:notation>description</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/doi">
        <rdfs:label>doi (software)</rdfs:label>
        <skos:definition>Digital Object Identifier for the software or its reference publication.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <skos:notation>doi</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/funder">
        <rdfs:label>funder (software)</rdfs:label>
        <skos:definition>Funding bodies or grants (e.g., &apos;EU H2020 945539&apos;, &apos;NIH R01...&apos;).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <skos:notation>funder</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/hash">
        <rdfs:label>hash (software)</rdfs:label>
        <skos:definition>Build or artifact hash for exact reproducibility.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <skos:notation>hash</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/keywords">
        <rdfs:label>keywords (software)</rdfs:label>
        <skos:definition>Tags for topic-based discovery and clustering.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <skos:notation>keywords</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/label">
        <rdfs:label>label (software)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <skos:notation>label</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/software/license">
