        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>WeightShuffle (StandardGraphType)</rdfs:label>
        <skos:definition>Derived generator: permute the non-zero entries of a source matrix. Parameters: source (IRI to another Network), preserve (binary_mask | degree | weight_distribution), seed. Used for null-model controls (e.g. shuffled SC).</skos:definition>
        <skos:notation>WeightShuffle</skos:notation>
    </owl:Class>
    


