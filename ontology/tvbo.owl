        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/G"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/I_ext"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/I_o"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/J_N"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/J_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/W_e"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/W_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/a_e"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/a_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/b_e"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/b_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/d_e"/>
