        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>Edge</rdfs:label>
        <skos:definition>An edge in a network. Two modes: explicit (source+target set, scalar parameters in YAML) or template (no source/target, N×N matrix measure in HDF5). Both coexist in the same edges list.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/Edge"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/ElementType -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ElementType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ElementType#hexahedron"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ElementType#quad"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ElementType#tetrahedron"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ElementType#triangle"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>ElementType</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ElementType#hexahedron"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ElementType#quad"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ElementType#tetrahedron"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ElementType#triangle"/>
    </owl:Class>
    


