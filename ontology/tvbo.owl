        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>from_branch (InitialStateMethod)</rdfs:label>
        <skos:definition>Start from a point on a previously computed branch.</skos:definition>
        <skos:notation>from_branch</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/InitialStateMethod#given -->

    <owl:Class rdf:about="https://w3id.org/tvbo/InitialStateMethod#given">
