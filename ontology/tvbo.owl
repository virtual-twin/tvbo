    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/CoreNEURON -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/CoreNEURON">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>Optimized compute engine for the NEURON simulator. Provides efficient execution of NEURON models on CPUs and GPUs using NMODL code generation.</dcterms:description>
        <dcterms:license>BSD-3-Clause</dcterms:license>
        <schema1:codeRepository>https://github.com/BlueBrain/CoreNeuron</schema1:codeRepository>
        <schema1:url>https://github.com/BlueBrain/CoreNeuron</schema1:url>
        <rdfs:label>CoreNEURON</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/CxSystem2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/CxSystem2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
