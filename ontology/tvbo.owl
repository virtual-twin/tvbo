        <skos:notation>affect_states</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/args">
        <rdfs:label>args (slot)</rdfs:label>
        <skos:definition>Ordered parameter names passed to the callable.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>args</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/authors">
        <rdfs:label>authors (slot)</rdfs:label>
        <skos:definition>Author display strings (full detail in references.bib).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>authors</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/average">
        <rdfs:label>average (slot)</rdfs:label>
        <skos:definition>Averaging mode across trials. &apos;trials&apos; = average over n_trials independent runs (evoked potential paradigm). None = return all trials.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>average</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/bids_dir">
        <rdfs:label>bids_dir (slot)</rdfs:label>
        <skos:definition>Path to BEP017-compliant BIDS directory for loading connectivity matrices</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>bids_dir</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/category">
        <rdfs:label>category (slot)</rdfs:label>
        <skos:definition>Coarse classification of the phenotype bundle, used for filtering in larger study libraries. Canonical values: ``cognitive`` (intelligence / memory / attention scores), ``clinical`` (UPDRS, MMSE, …), ``behavioral`` (raw task outputs), ``demographic``, ``physiological``, ``derived`` (composite scores like g-factor or brain-age). Free string — extend as needed.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>category</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/citekey">
        <rdfs:label>citekey (slot)</rdfs:label>
        <skos:definition>BibTeX citation key; the join key into references.bib for full bibliographic detail. A study is identified by its key/citekey and described by its title — no ``name`` needed.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>citekey</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/comment">
        <rdfs:label>comment (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>comment</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/concept_iri">
        <rdfs:label>concept_iri (slot)</rdfs:label>
        <skos:definition>Cognitive Atlas IRI of the cognitive construct measured (e.g. ``cogat:trm_521ef89ce5e84`` for fluid intelligence).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>concept_iri</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/condition_parameters">
