        <rdfs:label>affect_parameters (slot)</rdfs:label>
        <skos:definition>Parameter symbols modifiable in the affect function.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>affect_parameters</skos:notation>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/tvbo/affect_states">
        <rdfs:label>affect_states (slot)</rdfs:label>
