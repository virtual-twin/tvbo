        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>c (StefanescuJirsa3D parameter)</rdfs:label>
        <skos:definition>Hindmarsh-Rose dimensionless coefficient c.</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>d (StefanescuJirsa3D parameter)</rdfs:label>
        <skos:definition>Hindmarsh-Rose dimensionless coefficient d.</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/parameters/mu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/parameters/mu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.3</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>mu (StefanescuJirsa3D parameter)</rdfs:label>
        <skos:definition>Mean of the Gaussian heterogeneity distribution.</skos:definition>
        <skos:notation>mu</skos:notation>
    </owl:NamedIndividual>
    


