        <skos:definition>BIDS ModelEq reference: path to _eq.xml LEMS file.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>model_equation_ref</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/model_param_ref -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/model_param_ref">
        <rdfs:label>model_param_ref (slot)</rdfs:label>
        <skos:definition>BIDS ModelParam reference: path to _param.xml LEMS file.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>model_param_ref</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/modified -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/modified">
        <rdfs:label>modified (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>modified</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/module -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/module"/>
    


    <!-- https://w3id.org/tvbo/n -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n">
        <rdfs:label>n (slot)</rdfs:label>
        <skos:definition>Number of points (alternative to step for grid exploration).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/n_inversion -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n_inversion">
        <rdfs:label>n_inversion (slot)</rdfs:label>
        <skos:definition>Number of eigenvalue sign inversions to flag a bifurcation. Must be even. Higher = fewer false positives.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_inversion</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/n_iterations -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n_iterations">
        <rdfs:label>n_iterations (slot)</rdfs:label>
        <skos:definition>Number of iterations to run</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_iterations</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/n_parallel -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n_parallel">
        <rdfs:label>n_parallel (slot)</rdfs:label>
        <skos:definition>Parallel evaluations</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_parallel</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/n_regions -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n_regions">
        <rdfs:label>n_regions (slot)</rdfs:label>
        <skos:definition>Total number of regions</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_regions</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/n_sections -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n_sections">
        <rdfs:label>n_sections (slot)</rdfs:label>
        <skos:definition>Number of shooting sections for shooting or Poincaré methods.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_sections</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/n_threads -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n_threads">
        <rdfs:label>n_threads (slot)</rdfs:label>
        <skos:definition>Number of CPU threads per worker (-1 = auto-detect)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_threads</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/n_trials -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n_trials">
        <rdfs:label>n_trials (slot)</rdfs:label>
        <skos:definition>Number of independent trials per grid point. Each trial uses a different noise seed. Used for averaging stochastic simulations (e.g., VEP = average of 20 trials).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_trials</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/n_vertices -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n_vertices">
        <rdfs:label>n_vertices (slot)</rdfs:label>
        <skos:definition>Total number of vertices</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_vertices</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/n_workers -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n_workers">
        <rdfs:label>n_workers (slot)</rdfs:label>
        <skos:definition>Number of parallel workers (maps to pmap devices in JAX, processes in multiprocessing)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_workers</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/name -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/name">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/nev -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/nev">
        <rdfs:label>nev (slot)</rdfs:label>
        <skos:definition>Number of eigenvalues to compute. Must be &gt;= number of state variables for reliable Hopf detection.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>nev</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/newton_max_iterations -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/newton_max_iterations">
        <rdfs:label>newton_max_iterations (slot)</rdfs:label>
        <skos:definition>Maximum Newton corrector iterations per step.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>newton_max_iterations</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/newton_tol -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/newton_tol">
        <rdfs:label>newton_tol (slot)</rdfs:label>
        <skos:definition>Absolute tolerance for Newton corrector convergence.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>newton_tol</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/node_mapping -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/node_mapping">
        <rdfs:label>node_mapping (slot)</rdfs:label>
        <skos:definition>HDF5 dataset path for node-to-parent mapping. Int32 array of shape (N,) where entry i is the parent node ID. Required when parent_network is set.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>node_mapping</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/noise_type -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/noise_type">
        <rdfs:label>noise_type (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>noise_type</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/non_negative -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/non_negative">
        <rdfs:label>non_negative (slot)</rdfs:label>
        <skos:definition>All values &gt;= 0</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>non_negative</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/number_of_elements -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/number_of_elements">
        <rdfs:label>number_of_elements (slot)</rdfs:label>
        <skos:definition>Number of elements (triangles, quads, tetrahedra, etc.).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>number_of_elements</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/number_of_modes -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/number_of_modes">
        <rdfs:label>number_of_modes (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>number_of_modes</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/number_of_nodes -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/number_of_nodes">
        <rdfs:label>number_of_nodes (slot)</rdfs:label>
        <skos:altLabel>number_of_nodes</skos:altLabel>
        <skos:altLabel>number_of_regions</skos:altLabel>
        <skos:definition>Number of nodes in the network (derived from nodes if not set)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>number_of_nodes</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/number_of_stages -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/number_of_stages">
        <rdfs:label>number_of_stages (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
