        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/type"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/tvbo/ReductionType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/over"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/type"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/over"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/type"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>Aggregation</rdfs:label>
        <skos:definition>Specifies how to aggregate values across a dimension. Used for loss functions to define per-element loss with reduction.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/Aggregation"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/AggregationType -->

    <owl:Class rdf:about="https://w3id.org/tvbo/AggregationType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/AggregationType#first"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/AggregationType#last"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/AggregationType#mean"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/AggregationType#none"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/AggregationType#window"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>AggregationType</rdfs:label>
        <skos:definition>How to aggregate time series data</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/AggregationType#first"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/AggregationType#last"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/AggregationType#mean"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/AggregationType#none"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/AggregationType#window"/>
    </owl:Class>
    


