    <!-- https://w3id.org/tvbo/InterpolatedDelays -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/InterpolatedDelays">
        <rdf:type rdf:resource="https://w3id.org/tvbo/BackendCapability"/>
        <rdfs:comment xml:lang="en">Delayed states read by linear interpolation between the two bracketing history time-steps instead of snapping to the nearest step, making the coupling differentiable w.r.t. the continuous delay — hence w.r.t. conduction speed (delay = tract_length / speed).</rdfs:comment>
        <rdfs:label xml:lang="en">Interpolated (differentiable) delays</rdfs:label>
        <tvbo:enabledByCouplingSlot>interpolate_delays</tvbo:enabledByCouplingSlot>
    </owl:NamedIndividual>
    


