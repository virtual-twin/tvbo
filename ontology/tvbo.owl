        <rdfs:label>I_ext (LarterBreakspear parameter)</rdfs:label>
        <skos:definition>Subcortical input current. Represents a non-specific excitation or thalamic inputs.</skos:definition>
        <skos:notation>I_ext</skos:notation>
    </owl:NamedIndividual>
    


