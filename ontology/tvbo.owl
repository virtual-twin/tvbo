        <rdfs:label>conduction_speed (tpl-MNI152NLin2009cAsym_rec-avgMatrix_atlas-DesikanKilliany_desc-SCFC_relmat parameter)</rdfs:label>
        <skos:notation>conduction_speed</skos:notation>
        <tvbo:unit>mm_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/networks/tpl-MNI152NLin2009cAsym_rec-avgMatrix_atlas-Lobar8_desc-SCFC_relmat/parameters/conduction_speed -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/networks/tpl-MNI152NLin2009cAsym_rec-avgMatrix_atlas-Lobar8_desc-SCFC_relmat/parameters/conduction_speed">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>conduction_speed (tpl-MNI152NLin2009cAsym_rec-avgMatrix_atlas-Lobar8_desc-SCFC_relmat parameter)</rdfs:label>
        <skos:notation>conduction_speed</skos:notation>
        <tvbo:unit>mm_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


