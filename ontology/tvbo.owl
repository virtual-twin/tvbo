    <!-- https://w3id.org/tvbo/InitialStateMethod -->

    <owl:Class rdf:about="https://w3id.org/tvbo/InitialStateMethod">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/InitialStateMethod#from_branch"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/InitialStateMethod#given"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/InitialStateMethod#newton"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/InitialStateMethod#time_integration"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>InitialStateMethod</rdfs:label>
        <skos:definition>Strategy for obtaining the starting equilibrium or periodic orbit.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/InitialStateMethod#from_branch"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/InitialStateMethod#given"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/InitialStateMethod#newton"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/InitialStateMethod#time_integration"/>
    </owl:Class>
    


