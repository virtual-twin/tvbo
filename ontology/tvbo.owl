    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/equation_order">
        <rdfs:label>equation_order (slot)</rdfs:label>
        <skos:definition>Order of the time derivative on the LHS. Default 1 means dx/dt = rhs (first-order ODE). Order 2 means d²x/dt² = rhs (second-order ODE), etc. Higher-order ODEs are automatically lowered to coupled first-order systems by backends like ModelingToolkit.jl via mtkcompile.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>equation_order</skos:notation>
    </owl:DatatypeProperty>
    


