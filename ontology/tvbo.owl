        <rdfs:label>GraphGenerator</rdfs:label>
        <skos:definition>Backend-agnostic graph generator specification.  Captures the mathematical family (type) and its parameters so that each backend can emit the correct constructor call (Graphs.jl, NetworkX, etc.). The number of nodes is always taken from Network.number_of_nodes.
</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/tvbo/GraphGenerator"/>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
    </owl:Class>
    


