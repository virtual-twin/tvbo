    <!-- https://w3id.org/tvbo/software/TVB -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/TVB">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>The Virtual Brain — a neuroinformatics platform for full-brain network simulation using neural mass and mean-field models on individual connectome data.</dcterms:description>
