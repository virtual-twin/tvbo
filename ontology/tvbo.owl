    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/anatomicalAxesOrientation"/>
    


    <!-- https://w3id.org/tvbo/axesOrigin -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/axesOrigin"/>
    


    <!-- https://w3id.org/tvbo/boundConstraint -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/boundConstraint">
        <rdfs:comment xml:lang="en">Numerical pre-condition the realised parameter must satisfy for the capability to stay correct.</rdfs:comment>
        <rdfs:label xml:lang="en">bound constraint</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/enabledByCouplingSlot -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/enabledByCouplingSlot">
        <rdfs:comment xml:lang="en">Name of the concrete Coupling metadata slot a SimulationExperiment must set to True to realise this capability; read at configure() time to materialise the slot.</rdfs:comment>
        <rdfs:label xml:lang="en">enabled by coupling slot</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/enabledByGraphParameter -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/enabledByGraphParameter">
        <rdfs:comment xml:lang="en">Name of the concrete graph parameter a SimulationExperiment must set to realise this capability; read at configure() time to materialise the value.</rdfs:comment>
        <rdfs:label xml:lang="en">enabled by graph parameter</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/hasDerivedVariable -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/hasDerivedVariable"/>
    


    <!-- https://w3id.org/tvbo/hasParameter -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/hasParameter"/>
    


    <!-- https://w3id.org/tvbo/hasStateVariable -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/hasStateVariable"/>
    


    <!-- https://w3id.org/tvbo/model_type -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/model_type">
        <rdfs:label>model_type (slot)</rdfs:label>
        <skos:definition>Coarse classification of this model (mean_field, neural_mass, phase_oscillator, phenomenological, spiking, generic, field). Used for filtering in Dynamics.list_db(model_type=...).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>model_type</skos:notation>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/unit -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/unit">
        <rdfs:range rdf:resource="https://w3id.org/tvbo/UnitEnum"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/tvbo/clinical/icd11Code -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/tvbo/clinical/icd11Code">
        <rdfs:label>ICD-11 code</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://uri.interlex.org/tgbugs/uris/readable/center -->

    <owl:ObjectProperty rdf:about="http://uri.interlex.org/tgbugs/uris/readable/center">
        <rdfs:label>center</rdfs:label>
        <skos:definition>Add the center coordinate of this entity.</skos:definition>
        <skos:inScheme rdf:resource="https://openminds.ebrains.eu/sands/BrainAtlas"/>
    </owl:ObjectProperty>
    


    <!-- http://uri.interlex.org/tgbugs/uris/readable/coordinateSpace -->

    <owl:ObjectProperty rdf:about="http://uri.interlex.org/tgbugs/uris/readable/coordinateSpace">
        <rdfs:range rdf:resource="http://uri.interlex.org/tgbugs/uris/readable/CommonCoordinateSpace"/>
        <rdfs:label>coordinateSpace</rdfs:label>
        <skos:definition>Common coordinate space (e.g. FSLMNI152, MNI152NLin2009cAsym). Reference by name; the CommonCoordinateSpace must be defined in tvbo/database/coordinate_spaces/ (or future equivalent location).</skos:definition>
        <skos:inScheme rdf:resource="https://openminds.ebrains.eu/sands/BrainAtlas"/>
    </owl:ObjectProperty>
    


    <!-- http://uri.interlex.org/tgbugs/uris/readable/entities -->

    <owl:ObjectProperty rdf:about="http://uri.interlex.org/tgbugs/uris/readable/entities">
        <rdfs:label>entities</rdfs:label>
        <skos:inScheme rdf:resource="https://openminds.ebrains.eu/sands/BrainAtlas"/>
    </owl:ObjectProperty>
    


    <!-- http://uri.interlex.org/tgbugs/uris/readable/hasParent -->

    <owl:ObjectProperty rdf:about="http://uri.interlex.org/tgbugs/uris/readable/hasParent">
        <rdfs:range rdf:resource="http://uri.interlex.org/tgbugs/uris/readable/ParcellationEntity"/>
        <rdfs:label>hasParent</rdfs:label>
        <skos:definition>Add all anatomical parent structures for this entity as defined within the corresponding brain atlas.</skos:definition>
        <skos:inScheme rdf:resource="https://openminds.ebrains.eu/sands/BrainAtlas"/>
    </owl:ObjectProperty>
    


    <!-- http://uri.interlex.org/tgbugs/uris/readable/hemisphere -->

    <owl:ObjectProperty rdf:about="http://uri.interlex.org/tgbugs/uris/readable/hemisphere">
        <rdfs:label>hemisphere</rdfs:label>
        <skos:definition>Add the hemisphere of this entity.</skos:definition>
        <skos:inScheme rdf:resource="https://openminds.ebrains.eu/sands/BrainAtlas"/>
    </owl:ObjectProperty>
    


    <!-- http://uri.interlex.org/tgbugs/uris/readable/terminology -->

    <owl:ObjectProperty rdf:about="http://uri.interlex.org/tgbugs/uris/readable/terminology">
        <rdfs:label>terminology</rdfs:label>
        <skos:definition>Add the parcellation terminology version used for this brain atlas version.</skos:definition>
        <skos:inScheme rdf:resource="https://openminds.ebrains.eu/sands/BrainAtlas"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/additional_equations -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/additional_equations">
        <rdfs:label>additional_equations (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>additional_equations</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/affect -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/affect">
        <rdfs:label>affect (slot)</rdfs:label>
        <skos:definition>Affect function: what happens when the event triggers. Can modify state variables and/or parameters. For stimulus type, this is the stimulus equation.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>affect</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/affect_negative -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/affect_negative">
        <rdfs:label>affect_negative (slot)</rdfs:label>
        <skos:definition>Affect on downcrossing (continuous events only). If not specified, uses the same affect for both crossings.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>affect_negative</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/affect_parameters -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/affect_parameters"/>
    


    <!-- https://w3id.org/tvbo/affect_states -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/affect_states"/>
    


    <!-- https://w3id.org/tvbo/aggregate -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/aggregate"/>
    


    <!-- https://w3id.org/tvbo/aggregation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/aggregation"/>
    


    <!-- https://w3id.org/tvbo/algorithm -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/algorithm"/>
    


    <!-- https://w3id.org/tvbo/algorithms -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/algorithms"/>
    


    <!-- https://w3id.org/tvbo/analysis -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/analysis">
        <rdfs:label>analysis (slot)</rdfs:label>
        <skos:definition>Marks this observation as an analysis observable that operates on the solve/loss rather than a result-data pipeline (autodiff gradient, finite-difference gradient, or Lyapunov spectrum).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>analysis</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/apply_on_dimension -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/apply_on_dimension"/>
    


    <!-- https://w3id.org/tvbo/arguments -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/arguments"/>
    


    <!-- https://w3id.org/tvbo/atlas -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/atlas"/>
    


    <!-- https://w3id.org/tvbo/aux_data -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/aux_data">
        <rdfs:label>aux_data (slot)</rdfs:label>
        <skos:definition>Ordered list of auxiliary inputs the observation pipeline consumes. Examples: a Surface mesh&apos;s faces array, an empirical FC matrix on a reference Network, or another Observation&apos;s output. Resolved load-time eagerly; rendered code is self-contained.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>aux_data</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/axis -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/axis">
        <rdfs:label>axis (slot)</rdfs:label>
        <skos:definition>Dimension along which the distribution is sampled. &apos;space&apos; = per-node (default), &apos;time&apos; = per-timestep (stochastic input).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>axis</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/bc_type -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/bc_type">
        <rdfs:label>bc_type (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>bc_type</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/bids -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/bids">
        <rdfs:label>bids (slot)</rdfs:label>
        <skos:definition>BIDS filename entities for this dataset</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>bids</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/bifurcationParameter -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/bifurcationParameter">
        <rdfs:domain rdf:resource="https://w3id.org/tvbo/BifurcationEvent"/>
        <rdfs:comment xml:lang="en">Parameter (CURIE into the per-model parameter namespace) along which the bifurcation is observed.</rdfs:comment>
        <rdfs:label xml:lang="en">bifurcation parameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/bifurcationType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/bifurcationType">
        <rdfs:domain rdf:resource="https://w3id.org/tvbo/BifurcationEvent"/>
        <rdfs:comment xml:lang="en">Object is a Bifurcation class (e.g. tvbo:Hopf). Encoded as a class so DL reasoners can use the subClassOf hierarchy on the Bifurcation tree.</rdfs:comment>
        <rdfs:label xml:lang="en">bifurcation type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/bindings -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/bindings">
        <rdfs:label>bindings (slot)</rdfs:label>
        <skos:definition>Per-backend construction bindings, keyed by backend id (e.g. python, julia, networkx).  Each names the native library, callable and the ordered parameter names to pass.
</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>bindings</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/boundary_conditions -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/boundary_conditions"/>
    


    <!-- https://w3id.org/tvbo/bounds -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/bounds">
        <rdfs:label>bounds (slot)</rdfs:label>
        <skos:definition>Constraints on parameter values after update</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>bounds</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/branches -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/branches">
        <rdfs:label>branches (slot)</rdfs:label>
        <skos:definition>Child branches to continue from detected bifurcation points (PO from Hopf, fold continuation, etc.).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>branches</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/builder -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/builder">
        <rdfs:label>builder (slot)</rdfs:label>
        <skos:definition>Optional Python callable that builds the network at YAML load time. When set, ``Network._resolve`` imports ``&lt;module&gt;.&lt;name&gt;`` and invokes it with the ``parameters`` block as keyword arguments. The callable must return either a ``Network`` instance or a tuple ``(weights, lengths, node_params)``. Use the existing ``Callable`` slots (``name`` is the function name, ``module`` is its dotted module path). Reuses the same idiom as TVB monitor class references; no free ``module:function`` strings.
</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>builder</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/call_args -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/call_args">
        <rdfs:label>call_args (slot)</rdfs:label>
        <skos:definition>Arguments passed when calling the instance (__call__). Usually the input data from simulation result. Example: result (simulation output array).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>call_args</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/callable -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/callable"/>
    


    <!-- https://w3id.org/tvbo/cases -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/cases">
        <rdfs:label>cases (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>cases</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/class_call -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/class_call">
        <rdfs:label>class_call (slot)</rdfs:label>
        <skos:definition>Class instantiation and call (alternative to callable/function). Use for external library classes that need __init__ then __call__. Example: Bold monitor from tvboptim.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>class_call</skos:notation>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/tvbo/class_reference -->

    <owl:ObjectProperty rdf:about="https://w3id.org/tvbo/class_reference">
        <rdfs:label>class_reference (slot)</rdfs:label>
        <skos:definition>Direct class reference (alternative to pipeline). Use for external library classes like tvboptim.Bold, custom monitors, or any callable class. The class is instantiated with constructor_args and called with call_args. Example: {name: Bold, module: tvboptim.observations.tvb_monitors.bold, constructor_args: [{name: period, value: 1000.0}]}</skos:definition>
