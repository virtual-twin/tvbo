        <rdfs:label>E_L_e (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>leak reversal potential for excitatory [mV]</skos:definition>
        <skos:notation>E_L_e</skos:notation>
    </owl:NamedIndividual>
    


