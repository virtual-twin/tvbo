    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/parameters/K_12 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/parameters/K_12">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
