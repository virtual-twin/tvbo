    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/Brian2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/Brian2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>A simulator for spiking neural networks. Equations are specified in standard mathematical notation, and Brian2 automatically generates efficient C++ code for numerical integration.</dcterms:description>
