    <!-- https://w3id.org/tvbo/SimulationScale -->

    <owl:Class rdf:about="https://w3id.org/tvbo/SimulationScale">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q1073340"/>
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q43054"/>
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q484761"/>
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q7003015"/>
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q898786"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>SimulationScale</rdfs:label>
        <skos:definition>Spatial / organizational scale at which a tool operates. Multi-valued: a tool can span multiple scales. Mapped to SIO and Wikidata where possible.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo/software"/>
        <linkml:permissible_values rdf:resource="http://www.wikidata.org/entity/Q1073340"/>
        <linkml:permissible_values rdf:resource="http://www.wikidata.org/entity/Q43054"/>
        <linkml:permissible_values rdf:resource="http://www.wikidata.org/entity/Q484761"/>
        <linkml:permissible_values rdf:resource="http://www.wikidata.org/entity/Q7003015"/>
        <linkml:permissible_values rdf:resource="http://www.wikidata.org/entity/Q898786"/>
    </owl:Class>
    


