        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/WilsonCowan/derived_variables/x_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/P"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/Q"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/WilsonCowan/parameters/a_e"/>
