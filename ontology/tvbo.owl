        <rdfs:label>alpha_e (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Balance parameter between excitatory and inhibitory masses (Sanz-Leon et al., 2015).</skos:definition>
        <skos:notation>alpha_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/alpha_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/alpha_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Balance parameter between excitatory and inhibitory masses (Sanz-Leon et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>alpha_i (WilsonCowan parameter)</rdfs:label>
        <skos:definition>Balance parameter between excitatory and inhibitory masses (Sanz-Leon et al., 2015).</skos:definition>
        <skos:notation>alpha_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/b_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/b_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
