        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/JansenRit/parameters/v0"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/JansenRit/state_variables/y0"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/JansenRit/state_variables/y1"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/JansenRit/state_variables/y2"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/JansenRit/state_variables/y3"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/JansenRit/state_variables/y4"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/JansenRit/state_variables/y5"/>
        <tvbo:model_type>neural_mass</tvbo:model_type>
    </owl:NamedIndividual>
