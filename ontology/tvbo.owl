    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/element">
        <rdfs:label>element (slot)</rdfs:label>
        <skos:definition>Element/node index this range applies to. Used in element_domains to explicitly link a domain to a specific element of a heterogeneous parameter (e.g., element: 0 for node 0). Required when used in element_domains to avoid ambiguous positional indexing.</skos:definition>
