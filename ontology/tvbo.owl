        <rdfs:label>P_i6 (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Inhibitory phenomenological-threshold polynomial coefficient (order 6).</skos:definition>
        <skos:notation>P_i6</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/P_i7 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/P_i7">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Polynome of inhibitory phenomenological threshold (coefficient 7)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.004502706</schema:defaultValue>
        <rdfs:label>P_i7 (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Inhibitory phenomenological-threshold polynomial coefficient (order 7).</skos:definition>
        <skos:notation>P_i7</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/P_i8 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/P_i8">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Polynome of inhibitory phenomenological threshold (coefficient 8)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.002847219</schema:defaultValue>
        <rdfs:label>P_i8 (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Inhibitory phenomenological-threshold polynomial coefficient (order 8).</skos:definition>
        <skos:notation>P_i8</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/P_i9 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/P_i9">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Polynome of inhibitory phenomenological threshold (coefficient 9)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-0.0153578</schema:defaultValue>
        <rdfs:label>P_i9 (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Inhibitory phenomenological-threshold polynomial coefficient (order 9).</skos:definition>
        <skos:notation>P_i9</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/Q_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/Q_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>excitatory quantal conductance [nS]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema:defaultValue>
        <rdfs:label>Q_e (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Excitatory quantal conductance.</skos:definition>
        <skos:notation>Q_e</skos:notation>
        <tvbo:unit>nS</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/Q_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/Q_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>inhibitory quantal conductance [nS]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>Q_i (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Inhibitory quantal conductance.</skos:definition>
        <skos:notation>Q_i</skos:notation>
        <tvbo:unit>nS</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/S_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/S_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Scaling of the remote input for the inhibitory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>S_i (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Scaling of the remote (long-range) input for the inhibitory population with respect to the excitatory population.</skos:definition>
        <skos:notation>S_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/T -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/T">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>time scale of describing network activity</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">20.0</schema:defaultValue>
        <rdfs:label>T (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Time scale describing the network activity.</skos:definition>
        <skos:notation>T</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/a_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/a_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Excitatory adaptation conductance [nS]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.0</schema:defaultValue>
        <rdfs:label>a_e (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Excitatory subthreshold adaptation conductance.</skos:definition>
        <skos:notation>a_e</skos:notation>
        <tvbo:unit>nS</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/a_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/a_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Inhibitory adaptation conductance [nS]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>a_i (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Inhibitory subthreshold adaptation conductance.</skos:definition>
        <skos:notation>a_i</skos:notation>
        <tvbo:unit>nS</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/b_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/b_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Excitatory adaptation current increment [pA]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">60.0</schema:defaultValue>
        <rdfs:label>b_e (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Excitatory adaptation current increment.</skos:definition>
        <skos:notation>b_e</skos:notation>
        <tvbo:unit>pA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/b_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/b_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Inhibitory adaptation current increment [pA]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>b_i (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Inhibitory adaptation current increment.</skos:definition>
        <skos:notation>b_i</skos:notation>
        <tvbo:unit>pA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/external_input_ex_ex -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/external_input_ex_ex">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>external drive</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>external_input_ex_ex (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>External excitatory drive onto the excitatory population.</skos:definition>
        <skos:notation>external_input_ex_ex</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/external_input_ex_in -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/external_input_ex_in">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>external drive</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>external_input_ex_in (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>External inhibitory drive onto the excitatory population.</skos:definition>
        <skos:notation>external_input_ex_in</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/external_input_in_ex -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/external_input_in_ex">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>external drive</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>external_input_in_ex (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>External excitatory drive onto the inhibitory population.</skos:definition>
        <skos:notation>external_input_in_ex</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/external_input_in_in -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/external_input_in_in">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>external drive</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>external_input_in_in (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>External inhibitory drive onto the inhibitory population.</skos:definition>
        <skos:notation>external_input_in_in</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>fraction of inhibitory cells</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2</schema:defaultValue>
        <rdfs:label>g (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Fraction of inhibitory cells.</skos:definition>
        <skos:notation>g</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/g_L -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/g_L">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>leak conductance [nS]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <rdfs:label>g_L (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Leak conductance.</skos:definition>
        <skos:notation>g_L</skos:notation>
        <tvbo:unit>nS</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/p_connect_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/p_connect_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>connectivity probability</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.05</schema:defaultValue>
        <rdfs:label>p_connect_e (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Connectivity probability of excitatory neurons.</skos:definition>
        <skos:notation>p_connect_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/p_connect_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/p_connect_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>connectivity probability</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.05</schema:defaultValue>
        <rdfs:label>p_connect_i (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Connectivity probability of inhibitory neurons.</skos:definition>
        <skos:notation>p_connect_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_OU -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_OU">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>time constant noise</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>tau_OU (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Time constant of the Ornstein-Uhlenbeck noise process.</skos:definition>
        <skos:notation>tau_OU</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>excitatory decay [ms]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>tau_e (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Excitatory synaptic decay time constant.</skos:definition>
        <skos:notation>tau_e</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>inhibitory decay [ms]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>tau_i (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Inhibitory synaptic decay time constant.</skos:definition>
        <skos:notation>tau_i</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_w_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_w_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Adaptation time constant of excitatory neurons [ms]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">500.0</schema:defaultValue>
        <rdfs:label>tau_w_e (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Adaptation time constant of excitatory neurons.</skos:definition>
        <skos:notation>tau_w_e</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_w_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/tau_w_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Adaptation time constant of inhibitory neurons [ms]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tau_w_i (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Adaptation time constant of inhibitory neurons.</skos:definition>
        <skos:notation>tau_w_i</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/weight_noise -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/parameters/weight_noise">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>weight noise</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.5</schema:defaultValue>
        <rdfs:label>weight_noise (ZerlautAdaptationSecondOrder parameter)</rdfs:label>
        <skos:definition>Weight of the Ornstein-Uhlenbeck noise drift onto the external excitatory input.</skos:definition>
        <skos:notation>weight_noise</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ee -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ee">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(C_ee, t)</tvbo:lhs>
        <tvbo:rhs>(TFe*(1.0/T - TFe)/(N_tot*(1.0 - g)) + (TFe - E)**2 + 2.0*C_ee*dfe_TFe + 2.0*C_ei*dfi_TFe - 2.0*C_ee)/T</tvbo:rhs>
        <terms:description>Variance of the excitatory population activity.</terms:description>
        <rdfs:label>C_ee (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>C_ee</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ei -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ei">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(C_ei, t)</tvbo:lhs>
        <tvbo:rhs>((TFe - E)*(TFi - I) + C_ee*dfe_TFe + C_ei*dfe_TFi + C_ei*dfi_TFe + C_ii*dfi_TFi - 2.0*C_ei)/T</tvbo:rhs>
        <terms:description>Covariance between the excitatory and inhibitory population activities.</terms:description>
        <rdfs:label>C_ei (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>C_ei</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ii -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/C_ii">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(C_ii, t)</tvbo:lhs>
        <tvbo:rhs>(TFi*(1.0/T - TFi)/(N_tot*g) + (TFi - I)**2 + 2.0*C_ii*dfi_TFi + 2.0*C_ei*dfe_TFi - 2.0*C_ii)/T</tvbo:rhs>
        <terms:description>Variance of the inhibitory population activity.</terms:description>
        <rdfs:label>C_ii (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>C_ii</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/E -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/E">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(E, t)</tvbo:lhs>
        <tvbo:rhs>(TFe - E + 0.5*C_ee*d2_fefe_e + 0.5*C_ei*d2_fefi_e + 0.5*C_ei*d2_fife_e + 0.5*C_ii*d2_fifi_e)/T</tvbo:rhs>
        <terms:description>Firing rate of the excitatory population [kHz].</terms:description>
        <rdfs:label>E (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>E</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(I, t)</tvbo:lhs>
        <tvbo:rhs>(TFi - I + 0.5*C_ee*d2_fefe_i + 0.5*C_ei*d2_fefi_i + 0.5*C_ei*d2_fife_i + 0.5*C_ii*d2_fifi_i)/T</tvbo:rhs>
        <terms:description>Firing rate of the inhibitory population [kHz].</terms:description>
        <rdfs:label>I (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(W_e, t)</tvbo:lhs>
        <tvbo:rhs>-W_e/tau_w_e + b_e*E + a_e*(muV_e - E_L_e)/tau_w_e</tvbo:rhs>
        <terms:description>Adaptation current of the excitatory population [pA].</terms:description>
        <rdfs:label>W_e (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>W_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/W_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(W_i, t)</tvbo:lhs>
        <tvbo:rhs>-W_i/tau_w_i + b_i*I + a_i*(muV_i - E_L_i)/tau_w_i</tvbo:rhs>
        <terms:description>Adaptation current of the inhibitory population [pA].</terms:description>
        <rdfs:label>W_i (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>W_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/ou_drift -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/state_variables/ou_drift">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(ou_drift, t)</tvbo:lhs>
        <tvbo:rhs>-ou_drift/tau_OU</tvbo:rhs>
        <terms:description>Ornstein-Uhlenbeck noise drift.</terms:description>
        <rdfs:label>ou_drift (ZerlautAdaptationSecondOrder state variable)</rdfs:label>
        <skos:notation>ou_drift</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/derived_variables/coupled_input -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/derived_variables/coupled_input">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>coupled_input</tvbo:lhs>
        <tvbo:rhs>2*e0/(exp(rho_1*(-c_glob - local_coupling*v6 + rho_2)) + 1)</tvbo:rhs>
        <rdfs:label>coupled_input (ZetterbergJansen derived variable)</rdfs:label>
        <skos:notation>coupled_input</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sigma_v1</tvbo:lhs>
        <tvbo:rhs>Piecewise((0, rho_1*(rho_2 - v1) &gt; 709), (2*e0/(exp(rho_1*(rho_2 - v1)) + 1), True))</tvbo:rhs>
        <rdfs:label>sigma_v1 (ZetterbergJansen derived variable)</rdfs:label>
        <skos:notation>sigma_v1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v23 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v23">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sigma_v23</tvbo:lhs>
        <tvbo:rhs>Piecewise((0, rho_1*(rho_2 - (v2 - v3)) &gt; 709), (2*e0/(exp(rho_1*(rho_2 - (v2 - v3))) + 1), True))</tvbo:rhs>
        <rdfs:label>sigma_v23 (ZetterbergJansen derived variable)</rdfs:label>
        <skos:notation>sigma_v23</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v45 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/derived_variables/sigma_v45">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sigma_v45</tvbo:lhs>
        <tvbo:rhs>Piecewise((0, rho_1*(rho_2 - (v4 - v5)) &gt; 709), (2*e0/(exp(rho_1*(rho_2 - (v4 - v5))) + 1), True))</tvbo:rhs>
        <rdfs:label>sigma_v45 (ZetterbergJansen derived variable)</rdfs:label>
        <skos:notation>sigma_v45</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/He -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/He">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Maximum amplitude of EPSP [mV]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.25</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>He (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Maximum amplitude of EPSP [mV]. Also called average synaptic gain.</skos:definition>
        <skos:notation>He</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/Hi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/Hi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Maximum amplitude of IPSP [mV]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">22.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>Hi (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Maximum amplitude of IPSP [mV]. Also called average synaptic gain.</skos:definition>
        <skos:notation>Hi</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/P -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/P">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Maximum firing rate to the pyramidal population [ms^-1]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.12</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000598"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>P (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Maximum firing rate to the pyramidal population [ms^-1].
        (External stimulus. Constant intensity.Entry point for coupling.)</skos:definition>
        <skos:notation>P</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/Q -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/Q">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Maximum firing rate to the interneurons population [ms^-1]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.12</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>Q (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Maximum firing rate to the interneurons population [ms^-1].
        (External stimulus. Constant intensity.Entry point for coupling.)</skos:definition>
        <skos:notation>Q</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/U -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/U">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Maximum firing rate to the stellate population [ms^-1]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.12</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>U (ZetterbergJansen parameter)</rdfs:label>
