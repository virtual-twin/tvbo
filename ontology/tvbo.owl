    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/parameters/a_ie">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Inhibitory-to-excitatory synaptic strength</terms:description>
