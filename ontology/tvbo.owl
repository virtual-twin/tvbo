    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/Snudda -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/Snudda">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>A Python tool for creating detailed neuronal network models with realistic 3D neuron placement, morphology, and connectivity using touch detection. Exports to NEURON via SONATA format.</dcterms:description>
        <dcterms:license>GPL-3.0-only</dcterms:license>
        <schema1:codeRepository>https://github.com/Hjorthmedansen/Snudda</schema1:codeRepository>
