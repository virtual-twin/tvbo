        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/Epileptor5D/state_variables/x1"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/Epileptor5D/state_variables/x2"/>
