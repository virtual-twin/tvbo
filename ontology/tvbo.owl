        <skos:notation>K_12</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/parameters/K_21 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/parameters/K_21">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.15</schema1:defaultValue>
