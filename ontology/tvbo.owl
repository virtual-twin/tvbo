        <rdfs:label>local (slot)</rdfs:label>
        <skos:definition>Marks this as a LOCAL (surface/local-connectivity) coupling term rather than a global long-range coupling. Local terms are never wired to the connectome; they evaluate to 0 unless a local/surface connectivity is supplied (TVB&apos;s ``local_coupling``). Global coupling inputs (the default) are driven by ``Network.coupling``.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>local</skos:notation>
    </owl:DatatypeProperty>
    


