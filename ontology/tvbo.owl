    <!-- https://w3id.org/tvbo/continuations/Generic2dOscillator-bifurcation -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/continuations/Generic2dOscillator-bifurcation">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Continuation"/>
        <terms:description>Continue the equilibrium branch of the Generic2dOscillator as parameter a is varied. Detect Hopf bifurcations and continue periodic orbits from all Hopf points.</terms:description>
        <rdfs:label>eq_in_a</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/continuations/Generic2dOscillator-bifurcation-full -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/continuations/Generic2dOscillator-bifurcation-full">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Continuation"/>
        <terms:description>Comprehensive bifurcation analysis of the Generic2dOscillator. Continues the equilibrium branch as parameter a is varied, detects fold and Hopf bifurcations, then branches to periodic orbits from both Hopf points with fine-tuned solver settings.</terms:description>
        <rdfs:label>eq_in_a_full</rdfs:label>
    </owl:NamedIndividual>
    


