        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/I_o"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/J_N"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/J_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/W_e"/>
