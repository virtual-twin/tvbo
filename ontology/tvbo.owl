    <!-- https://w3id.org/tvbo/HemodynamicObservation -->

    <owl:Class rdf:about="https://w3id.org/tvbo/HemodynamicObservation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Observation"/>
