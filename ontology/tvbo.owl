        <rdfs:label>generated_at (slot)</rdfs:label>
        <skos:definition>Timestamp when this TimeSeries was generated.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>generated_at</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/generated_by -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/generated_by">
        <rdfs:label>generated_by (slot)</rdfs:label>
        <skos:definition>Software/agent identifier (prov:wasGeneratedBy)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>generated_by</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/geometry -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/geometry">
        <rdfs:label>geometry (slot)</rdfs:label>
        <skos:definition>Optional file for geometry/ROI mask (e.g., NIfTI, GIfTI).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>geometry</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/grounding -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/grounding">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>grounding (slot)</rdfs:label>
        <skos:definition>External ontology IRIs (typically GO, ChEBI, UBERON, CL, MeSH) that this entity is a surrogate / abstraction / model of. Replaces the legacy OWL pattern `tvbo:surrogate_of` by carrying the link inline with the YAML data instance. Multiple IRIs allowed: a single parameter may abstract several biological processes (e.g. a synaptic conductance grounding both GO:0060079 (excitatory PSP) and GO:0007268 (chemical synaptic transmission)).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>grounding</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/groups -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/groups">
        <rdfs:label>groups (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>groups</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/hasConservedQuantity -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/hasConservedQuantity">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">has conserved quantity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/hasTimescaleSeparation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/hasTimescaleSeparation">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">has timescale separation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/has_reference -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/has_reference">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has_reference (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>has_reference</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/hemi -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/hemi">
        <rdfs:label>hemi (slot)</rdfs:label>
        <skos:definition>BIDS hemi- entity (L or R) for hemisphere-specific surface/volume data</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>hemi</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/heterogeneous -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/heterogeneous"/>
    


