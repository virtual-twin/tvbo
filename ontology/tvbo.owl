        <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/AcademicArticle"/>
        <rdfs:comment>A publication applying a whole-brain / neural-mass model to patient data.</rdfs:comment>
        <rdfs:label>Clinical application study</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/clinical/ClinicalDomain -->

    <owl:Class rdf:about="https://w3id.org/tvbo/clinical/ClinicalDomain">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment>A disease/condition area a model is applied to, cross-referenced to ICD-11 and MeSH.</rdfs:comment>
        <rdfs:label>Clinical domain</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/clinical/NodeDynamicsModel -->

    <owl:Class rdf:about="https://w3id.org/tvbo/clinical/NodeDynamicsModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/Dynamics"/>
        <rdfs:comment>Local node / mesoscale dynamics used in a whole-brain or microcircuit model: neural-mass and mean-field models (most align with tvbo:Dynamics), phenomenological oscillators (Hopf/Stuart-Landau), DCM convolution models, and spiking E/I networks.</rdfs:comment>
        <rdfs:label>Node dynamical model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/dbs/ClinicalImprovement -->

    <owl:Class rdf:about="https://w3id.org/tvbo/dbs/ClinicalImprovement">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/evaluator"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/score"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/tvbo/dbs/ClinicalScore"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/timepoint"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/score"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/score"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/absolute_value"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/baseline_value"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/percent_change"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/time_post_surgery"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/absolute_value"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/baseline_value"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/tvbo/dbs/evaluator"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
