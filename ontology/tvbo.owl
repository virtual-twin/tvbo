        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>mu_I (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Mean external input current to the inhibitory population (mui_ext_mean).</skos:definition>
        <skos:notation>mu_I</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/mu_th -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/mu_th">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>mu_th (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Half-maximum input of the sigmoid transfer-function surrogate.</skos:definition>
        <skos:notation>mu_th</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/r_max -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/r_max">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2</schema1:defaultValue>
        <rdfs:label>r_max (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Asymptotic firing rate used in the sigmoid surrogate for the aLN transfer function (sigmoid stand-in for the precomputed lookup table).</skos:definition>
        <skos:notation>r_max</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/s_EE -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/s_EE">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>s_EE (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the E-&gt;E channel (sigmae_ext component).</skos:definition>
        <skos:notation>s_EE</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/s_EI -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/s_EI">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>s_EI (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the I-&gt;E channel.</skos:definition>
        <skos:notation>s_EI</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/s_IE -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/s_IE">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>s_IE (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the E-&gt;I channel.</skos:definition>
        <skos:notation>s_IE</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/s_II -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/s_II">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>s_II (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the I-&gt;I channel.</skos:definition>
        <skos:notation>s_II</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/tau_A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/tau_A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">200.0</schema1:defaultValue>
        <rdfs:label>tau_A (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Time constant of the adaptation current.</skos:definition>
        <skos:notation>tau_A</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/tau_se -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/tau_se">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema1:defaultValue>
        <rdfs:label>tau_se (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Synaptic time constant of excitatory PSCs (E-&gt;E and E-&gt;I).</skos:definition>
        <skos:notation>tau_se</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/tau_si -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/tau_si">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema1:defaultValue>
        <rdfs:label>tau_si (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Synaptic time constant of inhibitory PSCs (I-&gt;E and I-&gt;I).</skos:definition>
        <skos:notation>tau_si</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/state_variables/I_A_var -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/state_variables/I_A_var">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Adaptation current.</dcterms:description>
        <rdfs:label>I_A_var (CakanObermayer state variable)</rdfs:label>
        <skos:notation>I_A_var</skos:notation>
        <tvbo:lhs>Derivative(I_A_var, t)</tvbo:lhs>
        <tvbo:rhs>(I_A*(mu_se - E_A) - I_A_var)/tau_A</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/state_variables/mu_se -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/state_variables/mu_se">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Filtered mean synaptic input current to the excitatory population.</dcterms:description>
        <rdfs:label>mu_se (CakanObermayer state variable)</rdfs:label>
        <skos:notation>mu_se</skos:notation>
        <tvbo:lhs>Derivative(mu_se, t)</tvbo:lhs>
        <tvbo:rhs>(J_EE*r_E + J_EI*r_I + mu_E + c_pop0 - I_A_var/C - mu_se)/tau_se</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/state_variables/mu_si -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/state_variables/mu_si">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Filtered mean synaptic input current to the inhibitory population.</dcterms:description>
        <rdfs:label>mu_si (CakanObermayer state variable)</rdfs:label>
        <skos:notation>mu_si</skos:notation>
        <tvbo:lhs>Derivative(mu_si, t)</tvbo:lhs>
        <tvbo:rhs>(J_IE*r_E + J_II*r_I + mu_I - mu_si)/tau_si</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Half-width of heterogeneous noise distribution</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema1:defaultValue>
        <rdfs:label>Delta (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Parameter of the alpha-function</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.95</schema1:defaultValue>
        <rdfs:label>alpha (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Parameter of the alpha-function</skos:definition>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Constant parameter to scale the rate of feedback from the             firing rate variable to itself</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">20.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>eta (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the
            firing rate variable to itself</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/k -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/k">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Local coupling strength</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>k (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Local coupling strength</skos:definition>
        <skos:notation>k</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/v_syn -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/v_syn">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>QIF membrane reversal potential</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-10.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>v_syn (CoombesByrne parameter)</rdfs:label>
        <skos:definition>QIF membrane reversal potential</skos:definition>
        <skos:notation>v_syn</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>V (CoombesByrne state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>V**2 + c_pop0 + eta + g*(-V + v_syn) - pi**2*r**2</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>g (CoombesByrne state variable)</rdfs:label>
        <skos:notation>g</skos:notation>
        <tvbo:lhs>Derivative(g, t)</tvbo:lhs>
        <tvbo:rhs>alpha*q</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/q -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/q">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>q (CoombesByrne state variable)</rdfs:label>
        <skos:notation>q</skos:notation>
        <tvbo:lhs>Derivative(q, t)</tvbo:lhs>
        <tvbo:rhs>alpha*(-g + pi*k*r - 2*q)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>r (CoombesByrne state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>Delta/pi + 2*V*r - g*r</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Half-width of heterogeneous noise distribution</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>Delta (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Constant parameter to scale the rate of feedback from the             firing rate variable to itself</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>eta (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the
            firing rate variable to itself</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/k -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/k">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Local coupling strength</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>k (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>Local coupling strength</skos:definition>
        <skos:notation>k</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/v_syn -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/v_syn">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>QIF membrane reversal potential</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-4.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>v_syn (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>QIF membrane reversal potential</skos:definition>
        <skos:notation>v_syn</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>V (CoombesByrne2D state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>V**2 + c_pop0 + eta + pi*k*r*(-V + v_syn) - pi**2*r**2</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>r (CoombesByrne2D state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>Delta/pi + 2*V*r - pi*k*r**2</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/Delta_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/Delta_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Half-width of heterogeneous noise distribution over excitatory population</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>Delta_e (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution over excitatory population</skos:definition>
        <skos:notation>Delta_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/Delta_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/Delta_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Half-width of heterogeneous noise distribution over inhibitory population</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0032228"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>Delta_i (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution over inhibitory population</skos:definition>
        <skos:notation>Delta_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/Gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/Gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Ratio of excitatory VS inhibitory global couplings G_ie/G_ee </dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>Gamma (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Ratio of excitatory VS inhibitory global couplings G_ie/G_ee .</skos:definition>
        <skos:notation>Gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/I_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/I_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External homogeneous current on excitatory population</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>I_e (DumontGutkin parameter)</rdfs:label>
        <skos:definition>External homogeneous current on excitatory population</skos:definition>
        <skos:notation>I_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/I_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/I_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External current on inhibitory population</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>I_i (DumontGutkin parameter)</rdfs:label>
        <skos:definition>External current on inhibitory population</skos:definition>
        <skos:notation>I_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/J_ee -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/J_ee">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Synaptic weight e--&gt;e</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060076"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J_ee (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic weight e--&gt;e</skos:definition>
        <skos:notation>J_ee</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/J_ei -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/J_ei">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Synaptic weight i--&gt;e</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <rdfs:label>J_ei (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic weight i--&gt;e</skos:definition>
        <skos:notation>J_ei</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/J_ie -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/J_ie">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Synaptic weight e--&gt;i</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J_ie (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic weight e--&gt;i</skos:definition>
        <skos:notation>J_ie</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/J_ii -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/J_ii">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Synaptic weight i--&gt;i</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">15.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060077"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <rdfs:label>J_ii (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic weight i--&gt;i</skos:definition>
        <skos:notation>J_ii</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/eta_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/eta_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Mean heterogeneous current on excitatory population</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-5.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>eta_e (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Mean heterogeneous current on excitatory population</skos:definition>
        <skos:notation>eta_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/eta_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/eta_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Mean heterogeneous current on inhibitory population</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-5.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>eta_i (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Mean heterogeneous current on inhibitory population</skos:definition>
        <skos:notation>eta_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/tau_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/tau_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Characteristic time of excitatory population</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0043179"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>tau_e (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Characteristic time of excitatory population</skos:definition>
        <skos:notation>tau_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/tau_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/tau_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Characteristic time of inhibitory population</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0043180"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>tau_i (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Characteristic time of inhibitory population</skos:definition>
        <skos:notation>tau_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/tau_s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/tau_s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Synaptic time constant</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>tau_s (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic time constant</skos:definition>
        <skos:notation>tau_s</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/V_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/V_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>V_e (DumontGutkin state variable)</rdfs:label>
        <skos:notation>V_e</skos:notation>
        <tvbo:lhs>Derivative(V_e, t)</tvbo:lhs>
        <tvbo:rhs>(I_e + V_e**2 + eta_e - pi**2*r_e**2*tau_e**2 + s_ee*tau_e - s_ei*tau_e)/tau_e</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/V_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/V_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>V_i (DumontGutkin state variable)</rdfs:label>
        <skos:notation>V_i</skos:notation>
        <tvbo:lhs>Derivative(V_i, t)</tvbo:lhs>
        <tvbo:rhs>(I_i + V_i**2 + eta_i - pi**2*r_i**2*tau_i**2 + s_ie*tau_i - s_ii*tau_i)/tau_i</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/r_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/r_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>r_e (DumontGutkin state variable)</rdfs:label>
        <skos:notation>r_e</skos:notation>
        <tvbo:lhs>Derivative(r_e, t)</tvbo:lhs>
        <tvbo:rhs>(Delta_e/(pi*tau_e) + 2*V_e*r_e)/tau_e</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/r_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/r_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>r_i (DumontGutkin state variable)</rdfs:label>
        <skos:notation>r_i</skos:notation>
        <tvbo:lhs>Derivative(r_i, t)</tvbo:lhs>
        <tvbo:rhs>(Delta_i/(pi*tau_i) + 2*V_i*r_i)/tau_i</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ee -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ee">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>s_ee (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ee</skos:notation>
        <tvbo:lhs>Derivative(s_ee, t)</tvbo:lhs>
        <tvbo:rhs>(J_ee*r_e + c_pop0 - s_ee)/tau_s</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ei -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ei">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>s_ei (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ei</skos:notation>
        <tvbo:lhs>Derivative(s_ei, t)</tvbo:lhs>
        <tvbo:rhs>(J_ei*r_i - s_ei)/tau_s</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ie -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ie">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>s_ie (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ie</skos:notation>
        <tvbo:lhs>Derivative(s_ie, t)</tvbo:lhs>
        <tvbo:rhs>(Gamma*c_pop0 + J_ie*r_e - s_ie)/tau_s</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ii -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ii">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>s_ii (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ii</skos:notation>
        <tvbo:lhs>Derivative(s_ii, t)</tvbo:lhs>
        <tvbo:rhs>(J_ii*r_i - s_ii)/tau_s</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/derived_variables/h -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/derived_variables/h">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>h (Epileptor2D derived variable)</rdfs:label>
        <skos:notation>h</skos:notation>
        <tvbo:lhs>h</tvbo:lhs>
        <tvbo:rhs>Piecewise((x0 + 3.0/(exp((-x1 - 1*0.5)/0.1) + 1.0), modification &gt; 0), (zcond + 4*(-x0 + x1), True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/derived_variables/x1cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/derived_variables/x1cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>x1cond (Epileptor2D derived variable)</rdfs:label>
        <skos:notation>x1cond</skos:notation>
        <tvbo:lhs>x1cond</tvbo:lhs>
        <tvbo:rhs>Piecewise((a*x1**2 + x1*(-b + d), x1 &lt; 0), (d*x1 - slope - 0.6*(z - 4.0)**2, True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/derived_variables/zcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/derived_variables/zcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>zcond (Epileptor2D derived variable)</rdfs:label>
        <skos:notation>zcond</skos:notation>
        <tvbo:lhs>zcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((-0.1*z**7, z &lt; 0), (0, True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/Iext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/Iext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.1</schema1:defaultValue>
        <rdfs:label>Iext (Epileptor2D parameter)</rdfs:label>
        <skos:definition>External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>Iext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>Ks (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al., 2014).

The coupling quantifies the influence of neuronal fast discharges x_E2D on the local slow permittivity variable z_E2D.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/Kvf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/Kvf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coupling scaling on a very fast time scale</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>Kvf (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a very fast time scale.</skos:definition>
        <skos:notation>Kvf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the cubic term in the first state-variable x_E2D via the function f(x)_E2D, in Epileptor2D Proix et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>a (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the first state-variable x_E2D via the function f(x)_E2D, in Epileptor2D Proix et al.,2014).</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the squared term in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema1:defaultValue>
        <rdfs:label>b (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Additive coefficient for the second state-variable x_{2},         called :math:`y_{0}` in Jirsa paper</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>c (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Additive coefficient for the second state-variable x_{2},         called :math:`y_{0}` in Jirsa paper.</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the squared term in the first state-variable x_E2D via the function f in Epileptor2D (Proix et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema1:defaultValue>
        <rdfs:label>d (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state-variable x_E2D via the function f in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>When modification is True, the function h_E2D uses a nonlinear influence on z_E2D</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>modification (Epileptor2D parameter)</rdfs:label>
        <skos:definition>When modification is True, the function h_E2D uses a nonlinear influence on z_E2D. The default value is False, i.e., linear influence on z_E2D.</skos:definition>
        <skos:notation>modification</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Temporal scaling in the slow state-variable, \         called :math:`1\tau_{0}` in Jirsa paper (see class Epileptor)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.5E-4</schema1:defaultValue>
        <rdfs:label>r (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Temporal scaling in the slow state-variable, \
        called :math:`1\tau_{0}` in Jirsa paper (see class Epileptor).</skos:definition>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/slope -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/slope">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Linear coefficient in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>slope (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>slope</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/tt -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/tt">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Characteristic time scale of the whole-system Epileptor2D</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>tt (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Characteristic time scale of the whole-system Epileptor2D.</skos:definition>
        <skos:notation>tt</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/x0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/x0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Degree of excitability or epileptogenicity in Epileptor2D (Proix et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0043179"/>
        <rdfs:label>x0 (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Degree of excitability or epileptogenicity in Epileptor2D (Proix et al.,2014).

If x0 is greater than a critical value, x0,critic = −2.05 (i.e., in the supercritical regime), the system can trigger seizures autonomously; otherwise it is in its equilibrium state (i.e., in the subcritical regime).

Note:
- If modification_E2D:
if x0 is smaller than a critical value, x0,critic = 2.91, can trigger seizures autonomously; otherwise it is in its equilibrium state (Proix et al., 2014).</skos:definition>
        <skos:notation>x0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>First state-variable in the Epileptor2D (Proix et al</dcterms:description>
        <rdfs:label>x1 (Epileptor2D state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext + Kvf*c_pop0 + c + local_coupling*x1 - x1*x1cond - z)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Slow permittivity state-variable of the Epileptor2D (Proix et al</dcterms:description>
        <rdfs:label>z (Epileptor2D state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>r*tt*(Ks*c_pop0 + h - z)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/N -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/N">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>N (Epileptor3DStefanescuMcDonald parameter)</rdfs:label>
        <skos:definition>Effective population size / scaling of the resting-state regulation term.</skos:definition>
        <skos:notation>N</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/tau_z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/tau_z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2857.0</schema1:defaultValue>
        <rdfs:label>tau_z (Epileptor3DStefanescuMcDonald parameter)</rdfs:label>
        <skos:definition>Slow timescale for the z permittivity variable.</skos:definition>
        <skos:notation>tau_z</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/x_0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/x_0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema1:defaultValue>
        <rdfs:label>x_0 (Epileptor3DStefanescuMcDonald parameter)</rdfs:label>
        <skos:definition>Excitability parameter (Epileptor convention).</skos:definition>
        <skos:notation>x_0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Fast excitable variable (placeholder Epileptor-like dynamics).</dcterms:description>
        <rdfs:label>x1 (Epileptor3DStefanescuMcDonald state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>N*(x1 - x1**3/3 - z + c_pop0)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Slow permittivity / excitability variable.</dcterms:description>
        <rdfs:label>z (Epileptor3DStefanescuMcDonald state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>(4*(x1 - x_0) - z)/tau_z</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/h -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/h">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>h (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>h</skos:notation>
        <tvbo:lhs>h</tvbo:lhs>
        <tvbo:rhs>Piecewise((x0 + 3/(exp((-x1 - 1*0.5)/0.1) + 1), modification &gt; 0), (zcond + 4*(-x0 + x1), True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/x1cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/x1cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>x1cond (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>x1cond</skos:notation>
        <tvbo:lhs>x1cond</tvbo:lhs>
        <tvbo:rhs>Piecewise(((-a)*x1**2 + b*x1, x1 &lt; 0), (slope - x2 + 0.6*(z - 4.0)**2, True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/y2cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/y2cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>y2cond (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>y2cond</skos:notation>
        <tvbo:lhs>y2cond</tvbo:lhs>
        <tvbo:rhs>Piecewise((0.0, x2 &lt; -0.25), (aa*(x2 + 0.25), True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/zcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/zcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>zcond (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>zcond</skos:notation>
        <tvbo:lhs>zcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((-0.1*z**7, z &lt; 0), (0.0, True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Iext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Iext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External input current to the first sub-population (x1_E5D, y1_E5D) via the state-variable x1_E5D, in Epileptor5D (Jirsa et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.1</schema1:defaultValue>
        <rdfs:label>Iext (Epileptor5D parameter)</rdfs:label>
        <skos:definition>External input current to the first sub-population (x1_E5D, y1_E5D) via the state-variable x1_E5D, in Epileptor5D (Jirsa et al.,2014).</skos:definition>
        <skos:notation>Iext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Iext2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Iext2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External input current to the second population</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.45</schema1:defaultValue>
        <rdfs:label>Iext2 (Epileptor5D parameter)</rdfs:label>
        <skos:definition>External input current to the second population</skos:definition>
        <skos:notation>Iext2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Kf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Kf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Correspond to the coupling scaling on a fast time scale</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>Kf (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Correspond to the coupling scaling on a fast time scale.</skos:definition>
        <skos:notation>Kf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Permittivity coupling on the slow permittivity state-variable z_E5D in Epileptor5D (Proix et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>Ks (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Permittivity coupling on the slow permittivity state-variable z_E5D in Epileptor5D (Proix et al., 2014).

The coupling quantifies the influence of neuronal fast discharges x1_E5D on the local slow permittivity variable z_E5D.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Kvf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Kvf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coupling scaling on a very fast time scale</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>Kvf (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a very fast time scale.</skos:definition>
        <skos:notation>Kvf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the cubic term in the first state variable</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>a (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the first state variable</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/aa -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/aa">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Linear coefficient in fifth state variable</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.0</schema1:defaultValue>
        <rdfs:label>aa (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in fifth state variable</skos:definition>
        <skos:notation>aa</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the squared term in the first state variabel</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema1:defaultValue>
        <rdfs:label>b (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state variabel</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/bb -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/bb">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Linear coefficient of lowpass excitatory coupling in fourth state variable</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema1:defaultValue>
        <rdfs:label>bb (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient of lowpass excitatory coupling in fourth state variable</skos:definition>
        <skos:notation>bb</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Additive coefficient for the second state variable,         called :math:`y_{0}` in Jirsa paper</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>c (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Additive coefficient for the second state variable,         called :math:`y_{0}` in Jirsa paper</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the squared term in the derivative of the second state-variable y1_E5D in Epileptor5D (Jirsa et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema1:defaultValue>
        <rdfs:label>d (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the derivative of the second state-variable y1_E5D in Epileptor5D (Jirsa et al.,2014).</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>When modification is True, the function h_E5D uses a nonlinear influence on z_E5D</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>modification (Epileptor5D parameter)</rdfs:label>
        <skos:definition>When modification is True, the function h_E5D uses a nonlinear influence on z_E5D. The default value is False, i.e., linear influence on z_E5D.</skos:definition>
        <skos:notation>modification</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Temporal scaling in the third state variable,         called :math:`1/\tau_{0}` in Jirsa paper</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.5E-4</schema1:defaultValue>
        <rdfs:label>r (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Temporal scaling in the third state variable,         called :math:`1/\tau_{0}` in Jirsa paper</skos:definition>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Linear coefficient in the slow permittivity state-variable z_E5D in Epileptor5D (Jirsa et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.0</schema1:defaultValue>
        <rdfs:label>s (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the slow permittivity state-variable z_E5D in Epileptor5D (Jirsa et al.,2014).</skos:definition>
        <skos:notation>s</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/slope -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/slope">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Linear coefficient in the first state variable</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>slope (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the first state variable</skos:definition>
        <skos:notation>slope</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Temporal scaling coefficient in fifth state variable</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema1:defaultValue>
        <rdfs:label>tau (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Temporal scaling coefficient in fifth state variable</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/tt -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/tt">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Characteristic time scale of the whole-system Epileptor5D</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>tt (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Characteristic time scale of the whole-system Epileptor5D.</skos:definition>
        <skos:notation>tt</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/x0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/x0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Epileptogenicity Parameter</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>x0 (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Epileptogenicity Parameter. Degree of excitability or epileptogenicity in Epileptor5D (Jirsa et al.,2014).

If x0 is greater than a critical value, x0,critic = −2.05, the system can trigger seizures autonomously; otherwise it is in its equilibrium state.

Note:
- If modification_E5D:
if x0 is smaller than a critical value, x0,critic = 2.91, can trigger seizures autonomously; otherwise it is in its equilibrium state (Proix et al., 2014).</skos:definition>
        <skos:notation>x0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>g_E5D is a low-pass filtered excitatory coupling function from sub-population (x1_E5D, y1_E5D) to (x2_E5D, y2_E5D) in Epileptor5D (Jirsa et al</dcterms:description>
        <rdfs:label>g (Epileptor5D state variable)</rdfs:label>
        <skos:notation>g</skos:notation>
        <tvbo:lhs>Derivative(g, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-0.01*g + 0.001*x1)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>First state-variable of the first Epileptor5D population (Jirsa et al</dcterms:description>
        <rdfs:label>x1 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext + Kvf*c_pop0 + local_coupling*x1 + x1*x1cond + y1 - z)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/x2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/x2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>First state-variable of the second Epileptor5D sub-population (Jirsa et al</dcterms:description>
        <rdfs:label>x2 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>x2</skos:notation>
        <tvbo:lhs>Derivative(x2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext2 + Kf*c_pop1 + bb*g - x2**3 + x2 - y2 - 0.3*z + 1.05)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Second state-variable of the first Epileptor5D sub-population (Jirsa et al</dcterms:description>
        <rdfs:label>y1 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
        <tvbo:lhs>Derivative(y1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(c - d*x1**2 - y1)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Second state-variable of the second Epileptor5D population (Jirsa et al</dcterms:description>
        <rdfs:label>y2 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
        <tvbo:lhs>Derivative(y2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-y2 + y2cond)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Slow permittivity state-variable of the Epileptor5D (Jirsa et al</dcterms:description>
        <rdfs:label>z (Epileptor5D state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>r*tt*(Ks*c_pop0 + h - z)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/derived_variables/lc_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/lc_1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>lc_1 (EpileptorRestingState derived variable)</rdfs:label>
        <skos:notation>lc_1</skos:notation>
        <tvbo:lhs>lc_1</tvbo:lhs>
        <tvbo:rhs>local_coupling*x_rs</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/derived_variables/output -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/output">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>output (EpileptorRestingState derived variable)</rdfs:label>
        <skos:notation>output</skos:notation>
        <tvbo:lhs>output</tvbo:lhs>
        <tvbo:rhs>p*(-x1 + x2) + x_rs*(1 - p)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/derived_variables/x1cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/x1cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>x1cond (EpileptorRestingState derived variable)</rdfs:label>
        <skos:notation>x1cond</skos:notation>
        <tvbo:lhs>x1cond</tvbo:lhs>
        <tvbo:rhs>Piecewise(((-a)*x1**2 + b*x1, x1 &lt; 0), (slope - x2 + 0.6*(z - 4.0)**2, True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/derived_variables/y2cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/y2cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>y2cond (EpileptorRestingState derived variable)</rdfs:label>
        <skos:notation>y2cond</skos:notation>
        <tvbo:lhs>y2cond</tvbo:lhs>
        <tvbo:rhs>Piecewise((0.0, x2 &lt; -0.25), (aa*(x2 + 0.25), True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/derived_variables/zcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/zcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>zcond (EpileptorRestingState derived variable)</rdfs:label>
        <skos:notation>zcond</skos:notation>
        <tvbo:lhs>zcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((-0.1*z**7, z &lt; 0), (0.0, True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/I_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/I_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External input current to the third population (x_rs, y_rs)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>I_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>External input current to the third population (x_rs, y_rs).</skos:definition>
        <skos:notation>I_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/Iext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/Iext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External input current to the first population (x1, y1)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.1</schema1:defaultValue>
        <rdfs:label>Iext (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>External input current to the first population (x1, y1).</skos:definition>
        <skos:notation>Iext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/Iext2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/Iext2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External input current to the second population (x2, y2)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.45</schema1:defaultValue>
        <rdfs:label>Iext2 (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>External input current to the second population (x2, y2).</skos:definition>
        <skos:notation>Iext2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/K_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/K_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coupling scaling on a fast time scale</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>K_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a fast time scale.</skos:definition>
        <skos:notation>K_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/Kf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/Kf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coupling scaling on a fast time scale</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>Kf (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a fast time scale.</skos:definition>
        <skos:notation>Kf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Permittivity coupling, that is from the very fast time scale         toward the slow time scale</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>Ks (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Permittivity coupling, that is from the very fast time scale         toward the slow time scale.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/Kvf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/Kvf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coupling scaling on a very fast time scale</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>Kvf (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a very fast time scale.</skos:definition>
        <skos:notation>Kvf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the cubic term in the first state-variable x1</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>a (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the first state-variable x1.</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/a_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/a_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Vertical shift of the configurable nullcline         in the state-variable y_rs</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-2.0</schema1:defaultValue>
        <rdfs:label>a_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Vertical shift of the configurable nullcline         in the state-variable y_rs.</skos:definition>
        <skos:notation>a_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/aa -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/aa">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Linear coefficient in the fifth state-variable y2</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.0</schema1:defaultValue>
        <rdfs:label>aa (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the fifth state-variable y2.</skos:definition>
        <skos:notation>aa</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/alpha_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/alpha_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Constant parameter to scale the rate of feedback from the         slow variable y_rs to the fast variable x_rs</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>alpha_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the         slow variable y_rs to the fast variable x_rs.</skos:definition>
        <skos:notation>alpha_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the squared term in the first state-variable x1</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema1:defaultValue>
        <rdfs:label>b (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state-variable x1.</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/b_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/b_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Linear coefficient of the state-variable y_rs</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-10.0</schema1:defaultValue>
        <rdfs:label>b_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Linear coefficient of the state-variable y_rs.</skos:definition>
        <skos:notation>b_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/bb -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/bb">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Linear coefficient of lowpass excitatory coupling in the fourth         state-variable x2</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema1:defaultValue>
        <rdfs:label>bb (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Linear coefficient of lowpass excitatory coupling in the fourth         state-variable x2.</skos:definition>
        <skos:notation>bb</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/beta_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/beta_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Constant parameter to scale the rate of feedback from the         slow variable y_rs to itself</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>beta_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the         slow variable y_rs to itself.</skos:definition>
        <skos:notation>beta_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Additive coefficient for the second state-variable y1,         called :math:&apos;y_{0}&apos; in Jirsa et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>c (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Additive coefficient for the second state-variable y1,         called :math:&apos;y_{0}&apos; in Jirsa et al. (2014).</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the squared term in the second state-variable y1</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema1:defaultValue>
        <rdfs:label>d (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the second state-variable y1.</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/d_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/d_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Temporal scaling of the whole third system (x_rs, y_rs)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.02</schema1:defaultValue>
        <rdfs:label>d_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Temporal scaling of the whole third system (x_rs, y_rs).</skos:definition>
        <skos:notation>d_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/e_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/e_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the squared term in the sixth state-variable x_rs</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema1:defaultValue>
        <rdfs:label>e_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the sixth state-variable x_rs.</skos:definition>
        <skos:notation>e_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/f_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/f_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the cubic term in the sixth state-variable x_rs</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>f_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the sixth state-variable x_rs.</skos:definition>
        <skos:notation>f_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/gamma_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/gamma_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Constant parameter to reproduce FHN dynamics where         excitatory input currents are negative</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>gamma_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Constant parameter to reproduce FHN dynamics where         excitatory input currents are negative.        Note: It scales both I_rs and the long-range coupling term.</skos:definition>
        <skos:notation>gamma_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/p -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/p">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Linear coefficient</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>p (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Linear coefficient.</skos:definition>
        <skos:notation>p</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Temporal scaling in the third state-variable z,         called :math:&apos;1/	au_{0}&apos; in Jirsa et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.5E-4</schema1:defaultValue>
        <rdfs:label>r (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Temporal scaling in the third state-variable z,         called :math:&apos;1/	au_{0}&apos; in Jirsa et al. (2014).</skos:definition>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/slope -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/slope">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Linear coefficient in the first state-variable x1</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>slope (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the first state-variable x1.</skos:definition>
        <skos:notation>slope</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Temporal scaling coefficient in the fifth state-variable y2</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema1:defaultValue>
        <rdfs:label>tau (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Temporal scaling coefficient in the fifth state-variable y2.</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/tau_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/tau_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Temporal scaling coefficient in the third population (x_rs, y_rs)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>tau_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Temporal scaling coefficient in the third population (x_rs, y_rs).</skos:definition>
        <skos:notation>tau_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/tt -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/tt">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Time scaling of the Epileptor</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>tt (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Time scaling of the Epileptor.</skos:definition>
        <skos:notation>tt</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/x0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/x0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Epileptogenicity parameter</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema1:defaultValue>
        <rdfs:label>x0 (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Epileptogenicity parameter.</skos:definition>
        <skos:notation>x0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>g (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>g</skos:notation>
        <tvbo:lhs>Derivative(g, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-0.01*g + 0.001*x1)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>x1 (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext + Kvf*c_pop0 + local_coupling*x1 + x1*x1cond + y1 - z)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/x2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/x2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>x2 (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>x2</skos:notation>
        <tvbo:lhs>Derivative(x2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext2 + Kf*c_pop1 + bb*g - x2**3 + x2 - y2 - 0.3*z + 1.05)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/x_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/x_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>x_rs (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>x_rs</skos:notation>
        <tvbo:lhs>Derivative(x_rs, t)</tvbo:lhs>
        <tvbo:rhs>d_rs*tau_rs*(I_rs*gamma_rs + K_rs*c_pop2*gamma_rs + alpha_rs*y_rs + e_rs*x_rs**2 - f_rs*x_rs**3 + lc_1)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y1 (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
        <tvbo:lhs>Derivative(y1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(c - d*x1**2 - y1)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y2 (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
        <tvbo:lhs>Derivative(y2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-y2 + y2cond)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/y_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/y_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y_rs (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>y_rs</skos:notation>
        <tvbo:lhs>Derivative(y_rs, t)</tvbo:lhs>
        <tvbo:rhs>d_rs*(a_rs + b_rs*x_rs - beta_rs*y_rs)/tau_rs</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>z (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>r*tt*(Ks*c_pop0 - 4*x0 + 4*x1 - z + zcond)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Half-width of heterogeneous noise distribution</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema1:defaultValue>
        <rdfs:label>Delta (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External homogeneous current</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>I (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>External homogeneous current</skos:definition>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/J -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/J">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Synaptic weight</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">21.2132</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>Synaptic weight</skos:definition>
        <skos:notation>J</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>adaptation rate</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema1:defaultValue>
        <rdfs:label>alpha (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>adaptation rate</skos:definition>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/cr -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/cr">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>It is the weight on Coupling through variable r</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>cr (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable r.</skos:definition>
        <skos:notation>cr</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/cv -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/cv">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>It is the weight on Coupling through variable V</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>cv (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable V.</skos:definition>
        <skos:notation>cv</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Mean of heterogeneous noise distribution</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-6.0</schema1:defaultValue>
        <rdfs:label>eta (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>Mean of heterogeneous noise distribution</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Characteristic time</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>tau (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>Characteristic time</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/tau_A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/tau_A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Adaptation time scale</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema1:defaultValue>
        <rdfs:label>tau_A (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>Adaptation time scale</skos:definition>
        <skos:notation>tau_A</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>A (GastSchmidtKnosche_SD state variable)</rdfs:label>
        <skos:notation>A</skos:notation>
        <tvbo:lhs>Derivative(A, t)</tvbo:lhs>
        <tvbo:rhs>B/tau_A</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/B -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/B">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>B (GastSchmidtKnosche_SD state variable)</rdfs:label>
        <skos:notation>B</skos:notation>
        <tvbo:lhs>Derivative(B, t)</tvbo:lhs>
        <tvbo:rhs>(-A - 2*B + alpha*r)/tau_A</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>V (GastSchmidtKnosche_SD state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>(I + J*r*tau*(1 - A) + V**2 + c_pop0*cr + c_pop1*cv + eta - pi**2*r**2*tau**2)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>r (GastSchmidtKnosche_SD state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>(Delta/(pi*tau) + 2*V*r)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Half-width of heterogeneous noise distribution</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema1:defaultValue>
        <rdfs:label>Delta (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External homogeneous current</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>I (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>External homogeneous current</skos:definition>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/J -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/J">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Synaptic weight</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">21.2132</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>Synaptic weight</skos:definition>
        <skos:notation>J</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>adaptation rate</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>alpha (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>adaptation rate</skos:definition>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/cr -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/cr">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>It is the weight on Coupling through variable r</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>cr (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable r.</skos:definition>
        <skos:notation>cr</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/cv -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/cv">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>It is the weight on Coupling through variable V</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>cv (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable V.</skos:definition>
        <skos:notation>cv</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Mean of heterogeneous noise distribution</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>eta (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>Mean of heterogeneous noise distribution</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Characteristic time</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>tau (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>Characteristic time</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/tau_A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/tau_A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Adaptation time scale</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema1:defaultValue>
        <rdfs:label>tau_A (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>Adaptation time scale</skos:definition>
        <skos:notation>tau_A</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>A (GastSchmidtKnosche_SF state variable)</rdfs:label>
        <skos:notation>A</skos:notation>
        <tvbo:lhs>Derivative(A, t)</tvbo:lhs>
        <tvbo:rhs>B/tau_A</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/B -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/B">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>B (GastSchmidtKnosche_SF state variable)</rdfs:label>
        <skos:notation>B</skos:notation>
        <tvbo:lhs>Derivative(B, t)</tvbo:lhs>
        <tvbo:rhs>(-A - 2*B + alpha*r)/tau_A</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>V (GastSchmidtKnosche_SF state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>(-A + I + J*r*tau + V**2 + c_pop0*cr + c_pop1*cv + eta - pi**2*r**2*tau**2)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>r (GastSchmidtKnosche_SF state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>(Delta/(pi*tau) + 2*V*r)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Baseline shift of the cubic nullcline</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>I (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Baseline shift of the cubic nullcline</skos:definition>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Vertical shift of the configurable nullcline</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-2.0</schema1:defaultValue>
        <rdfs:label>a (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Vertical shift of the configurable nullcline</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Constant parameter to scale the rate of feedback from the slow variable to the fast variable.</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>alpha (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>alpha_G2D is the coefficient of the linear feedback coupling term of the state-variable W_G2D to the first state-equation Vdot_G2D. Constant parameter to scale the rate of feedback from the slow variable to the fast variable.</skos:definition>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Linear slope of the configurable nullcline</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-10.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098873"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099178"/>
        <rdfs:label>b (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Linear slope of the configurable nullcline</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/beta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/beta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Constant parameter to scale the rate of feedback from the             slow variable to itself</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>beta (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the
            slow variable to itself</skos:definition>
        <skos:notation>beta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Parabolic term of the configurable nullcline</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>c (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Parabolic term of the configurable nullcline</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Temporal scale factor</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.02</schema1:defaultValue>
        <rdfs:label>d (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Temporal scale factor. Warning: do not use it unless
        you know what you are doing and know about time tides.</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the quadratic term of the cubic nullcline</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema1:defaultValue>
        <rdfs:label>e (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Coefficient of the quadratic term of the cubic nullcline.</skos:definition>
        <skos:notation>e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/f -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/f">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the cubic term of the cubic nullcline</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>f (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term of the cubic nullcline.</skos:definition>
        <skos:notation>f</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Coefficient of the linear term of the cubic nullcline</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>g (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Coefficient of the linear term of the cubic nullcline.</skos:definition>
        <skos:notation>g</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Constant parameter to reproduce FHN dynamics where                excitatory input currents are negative</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>gamma (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Constant parameter to reproduce FHN dynamics where
               excitatory input currents are negative.
               It scales both I and the long range coupling term.</skos:definition>
        <skos:notation>gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>A time-scale hierarchy can be introduced for the state         variables :math:`V` and :math:`W`</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>tau (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>A time-scale hierarchy can be introduced for the state
        variables :math:`V` and :math:`W`. Default parameter is 1, which means
        no time-scale hierarchy.</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>V_G2D is the first state-variable of the Generic 2-Dimensional Oscillator model, that can be associated with membrane potentials and sodium activation (FitzHugh, 1961)</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0005272"/>
        <rdfs:label>V (Generic2dOscillator state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>d*tau*(I*gamma - V**3*f + V**2*e + V*g + V*local_coupling + W*alpha + c_glob*gamma)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/state_variables/W -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/state_variables/W">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>W_G2D is the second state-variable of the Generic 2-Dimensional Oscillator model, that can be associated with accommodation and refractoriness and considered to represent potassium activation, sodium inactivation, or both (FitzHugh, 1961)</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0005272"/>
        <rdfs:label>W (Generic2dOscillator state variable)</rdfs:label>
        <skos:notation>W</skos:notation>
        <tvbo:lhs>Derivative(W, t)</tvbo:lhs>
        <tvbo:rhs>d*(V**2*c + V*b - W*beta + a)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GenericLinear/parameters/gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GenericLinear/parameters/gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Slope parameter of the state-variable &apos;x_GL&apos;, representing the inverse of the relaxation time</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-10.0</schema1:defaultValue>
        <rdfs:label>gamma (GenericLinear parameter)</rdfs:label>
        <skos:definition>Slope parameter of the state-variable &apos;x_GL&apos;, representing the inverse of the relaxation time.

Note: The ‘minus’ sign for the self-connections, scaled by &apos;gamma_GL&apos;, guarantees that the nodes have a stable equilibrium point (ref).</skos:definition>
        <skos:notation>gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GenericLinear/state_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GenericLinear/state_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>State-variable of the Generic Linear model</dcterms:description>
        <rdfs:label>x (GenericLinear state variable)</rdfs:label>
        <skos:notation>x</skos:notation>
        <tvbo:lhs>Derivative(x, t)</tvbo:lhs>
        <tvbo:rhs>c_pop0 + gamma*x + local_coupling*x</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Hopfield/parameters/tauT -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Hopfield/parameters/tauT">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>The slow time-scale for threshold calculus :math:`\\theta`, state-variable of the model</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema1:defaultValue>
        <rdfs:label>tauT (Hopfield parameter)</rdfs:label>
        <skos:definition>The slow time-scale for threshold calculus :math:`\\theta`, state-variable of the model.</skos:definition>
        <skos:notation>tauT</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Hopfield/parameters/taux -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Hopfield/parameters/taux">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>The fast time-scale for potential calculus :math:`x`, state-variable of the model</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>taux (Hopfield parameter)</rdfs:label>
        <skos:definition>The fast time-scale for potential calculus :math:`x`, state-variable of the model.</skos:definition>
        <skos:notation>taux</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Hopfield/state_variables/theta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Hopfield/state_variables/theta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Slow state variable at node i</dcterms:description>
        <rdfs:label>theta (Hopfield state variable)</rdfs:label>
        <skos:notation>theta</skos:notation>
        <tvbo:lhs>Derivative(theta, t)</tvbo:lhs>
        <tvbo:rhs>(c_pop1 - theta)/tauT</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Hopfield/state_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Hopfield/state_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>x (Hopfield state variable)</rdfs:label>
        <skos:notation>x</skos:notation>
        <tvbo:lhs>Derivative(x, t)</tvbo:lhs>
        <tvbo:rhs>(c_pop0 - x)/taux</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Sigmoid function that transforms the average membrane potential of the PCs populations (y0) into an average firing rate to the excitatory interneurons EINs.</dcterms:description>
        <rdfs:label>sigma_y0_1 (JansenRit derived variable)</rdfs:label>
        <skos:notation>sigma_y0_1</skos:notation>
        <tvbo:lhs>sigma_y0_1</tvbo:lhs>
        <tvbo:rhs>2.0*nu_max/(exp(r*(-J*a_1*y0 + v0)) + 1.0)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Sigmoid function that transforms the average membrane potential of the PCs populations (y0) into an average firing rate to the inhibitory interneurons IINs.</dcterms:description>
        <rdfs:label>sigma_y0_3 (JansenRit derived variable)</rdfs:label>
        <skos:notation>sigma_y0_3</skos:notation>
        <tvbo:lhs>sigma_y0_3</tvbo:lhs>
        <tvbo:rhs>2.0*nu_max/(exp(r*(-J*a_3*y0 + v0)) + 1.0)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y1_y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y1_y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Sigmoid function that transforms the average membrane potential of the interneurons populations (y1-y2)
into an average firing rate to the PCs.</dcterms:description>
        <rdfs:label>sigma_y1_y2 (JansenRit derived variable)</rdfs:label>
        <skos:notation>sigma_y1_y2</skos:notation>
        <tvbo:lhs>sigma_y1_y2</tvbo:lhs>
        <tvbo:rhs>2.0*nu_max/(exp(r*(v0 - y1 + y2)) + 1.0)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Maximum amplitude of EPSP [mV]</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.25</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>A (JansenRit parameter)</rdfs:label>
        <skos:definition>Maximum amplitude of EPSP [mV]. Also called average synaptic gain.</skos:definition>
        <skos:notation>A</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/B -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/B">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Maximum amplitude of IPSP [mV]</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">22.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>B (JansenRit parameter)</rdfs:label>
        <skos:definition>Maximum amplitude of IPSP [mV]. Also called average synaptic gain.</skos:definition>
        <skos:notation>B</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/J -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/J">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Average number of synapses between three neuronal populations of the model</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">135.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0051124"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0150092"/>
        <rdfs:label>J (JansenRit parameter)</rdfs:label>
        <skos:definition>Average number of synapses between three neuronal populations of the model. It accounts for synaptic phenomena such as neurotransmitter depletion.</skos:definition>
        <skos:notation>J</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Reciprocal of the time constant of passive membrane and all other spatially distributed delays in the dendritic network. Also called average synaptic time constant.</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.1</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>a (JansenRit parameter)</rdfs:label>
        <skos:definition>Rate constant of the excitatory post-synaptic potential (EPSP). It is interpreted as being the lumped representation of the sum of the reciprocal of the time constant of passive membrane and all other spatially distributed delays, including temporal dispersion in the afferent tract, synaptic diffusion, and resistive-capacitive delay in the dendritic network.</skos:definition>
        <skos:notation>a</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/a_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/a_1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Average probability constant of the number of synapses made by the pyramidal cells to the dendrites of the excitatory interneurons  (feedback excitatory loop)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>a_1 (JansenRit parameter)</rdfs:label>
        <skos:definition>Average probability constant of the number of synapses made by the pyramidal cells to the dendrites of the excitatory interneurons  (feedback excitatory loop). It characterizes the connectivity between the PCs and EINs.</skos:definition>
        <skos:notation>a_1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/a_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/a_2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Average probability constant of the number of synapses made by the EINs to the dendrites of the PCs</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.8</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>a_2 (JansenRit parameter)</rdfs:label>
        <skos:definition>Average probability constant of the number of synapses made by the EINs to the dendrites of the PCs. It characterizes the excitatory connectivity between the EINs and PCs.</skos:definition>
        <skos:notation>a_2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/a_3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/a_3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Average probability constant of the number of synapses made by the PCs to the dendrites of the IINs</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.25</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>a_3 (JansenRit parameter)</rdfs:label>
        <skos:definition>Average probability constant of the number of synapses made by the PCs to the dendrites of the IINs. It characterizes the connectivity between the PCs and inhibitory IINs.</skos:definition>
        <skos:notation>a_3</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/a_4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/a_4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Average probability constant of the number of synapses made by the IINs to the dendrites of the PCs</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.25</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060077"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>a_4 (JansenRit parameter)</rdfs:label>
        <skos:definition>Average probability constant of the number of synapses made by the IINs to the dendrites of the PCs. It characterizes the connectivity between the IINs and  PCs.</skos:definition>
        <skos:notation>a_4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Rate constant of the inhibitory post-synaptic potential (IPSP)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.05</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>b (JansenRit parameter)</rdfs:label>
        <skos:definition>Rate constant of the inhibitory post-synaptic potential (IPSP). It is interpreted as being the lumped representation of the sum of the reciprocal of the time constant of passive membrane and all other spatially distributed delays, including temporal dispersion in the afferent tract, synaptic diffusion, and resistive-capacitive delay in the dendritic network (Freeman 1975).</skos:definition>
        <skos:notation>b</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/mu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/mu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Mean excitatory external input to the derivative of the state-variable y4_JR (PCs) represented by a pulse density, that consists of activity originating from adjacent and more distant cortical columns, as well as from subcortical structures (e</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.22</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>mu (JansenRit parameter)</rdfs:label>
        <skos:definition>Mean excitatory external input to the derivative of the state-variable y4_JR (PCs) represented by a pulse density, that consists of activity originating from adjacent and more distant cortical columns, as well as from subcortical structures (e.g., thalamus).</skos:definition>
        <skos:notation>mu</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/nu_max -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/nu_max">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Asymptotic of the sigmoid function Sigm_JR corresponds to the maximum firing rate of the neural populations</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0025</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>nu_max (JansenRit parameter)</rdfs:label>
        <skos:definition>Asymptotic of the sigmoid function Sigm_JR corresponds to the maximum firing rate of the neural populations.</skos:definition>
        <skos:notation>nu_max</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Steepness (or gain) parameter of the sigmoid function Sigm_JR</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.56</schema1:defaultValue>
        <rdfs:label>r (JansenRit parameter)</rdfs:label>
        <skos:definition>Steepness (or gain) parameter of the sigmoid function Sigm_JR.</skos:definition>
        <skos:notation>r</skos:notation>
        <tvbo:unit>per_mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/v0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/v0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Average firing threshold (PSP) for which half of the firing rate is achieved</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.52</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>v0 (JansenRit parameter)</rdfs:label>
        <skos:definition>Average firing threshold (PSP) for which half of the firing rate is achieved.

Note:
- The usual value for this parameter is 6.0 (Jansen et al., 1993; Jansen &amp; Rit, 1995).</skos:definition>
        <skos:notation>v0</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>First state-variable of the first Jansen-Rit population</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000598"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>y0 (JansenRit state variable)</rdfs:label>
        <skos:notation>y0</skos:notation>
        <tvbo:lhs>Derivative(y0, t)</tvbo:lhs>
        <tvbo:rhs>y3</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>First state-variable of the second Jansen-Rit population (EINs)</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060076"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>y1 (JansenRit state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
        <tvbo:lhs>Derivative(y1, t)</tvbo:lhs>
        <tvbo:rhs>y4</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>First state-variable of the third Jansen-Rit population (IINs)</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060077"/>
        <rdfs:label>y2 (JansenRit state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
        <tvbo:lhs>Derivative(y2, t)</tvbo:lhs>
        <tvbo:rhs>y5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Second state-variable of the first Jansen-Rit population (excitatory PCs)</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000598"/>
        <rdfs:label>y3 (JansenRit state variable)</rdfs:label>
        <skos:notation>y3</skos:notation>
        <tvbo:lhs>Derivative(y3, t)</tvbo:lhs>
        <tvbo:rhs>A*a*sigma_y1_y2 - a**2*y0 - 2.0*a*y3</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Second state-variable of the second excitatory Jansen-Rit population (excitatory EINs)</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <rdfs:label>y4 (JansenRit state variable)</rdfs:label>
        <skos:notation>y4</skos:notation>
        <tvbo:lhs>Derivative(y4, t)</tvbo:lhs>
        <tvbo:rhs>A*a*(J*a_2*sigma_y0_1 + c_pop0 + local_coupling*(y1 - y2) + mu) - a**2*y1 - 2.0*a*y4</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y5 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y5">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Second state-variable of the third (inhibitory) Jansen-Rit population (IINs)</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <rdfs:label>y5 (JansenRit state variable)</rdfs:label>
        <skos:notation>y5</skos:notation>
        <tvbo:lhs>Derivative(y5, t)</tvbo:lhs>
        <tvbo:rhs>B*J*a_4*b*sigma_y0_3 - b**2*y2 - 2.0*b*y5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/derived_variables/v_pyr -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/derived_variables/v_pyr">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Aggregate pyramidal PSP (EEG-like output)</dcterms:description>
        <rdfs:label>v_pyr (JansenRit1995 derived variable)</rdfs:label>
        <skos:notation>v_pyr</skos:notation>
        <tvbo:rhs>y1 - y2</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Maximum amplitude of excitatory PSP (EPSP)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.25</schema1:defaultValue>
        <rdfs:label>A (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>A</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/B -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/B">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Maximum amplitude of inhibitory PSP (IPSP)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</schema1:defaultValue>
        <rdfs:label>B (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>B</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/C -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/C">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Lumped connectivity constant (C = C1)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">135</schema1:defaultValue>
        <rdfs:label>C (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>C</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Reciprocal of EPSP time constant</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</schema1:defaultValue>
        <rdfs:label>a (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>a</skos:notation>
        <tvbo:unit>per_s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Reciprocal of IPSP time constant</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</schema1:defaultValue>
        <rdfs:label>b (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>b</skos:notation>
        <tvbo:unit>per_s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/e0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/e0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Half of maximum firing rate (2*e0 = max rate)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.5</schema1:defaultValue>
        <rdfs:label>e0 (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>e0</skos:notation>
        <tvbo:unit>per_s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/p -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/p">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Mean external input (afferent pulse density)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">220</schema1:defaultValue>
        <rdfs:label>p (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>p</skos:notation>
        <tvbo:unit>per_s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Steepness of sigmoid transformation</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.56</schema1:defaultValue>
        <rdfs:label>r (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>r</skos:notation>
        <tvbo:unit>per_mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/v0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/v0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>PSP for 50% firing rate (sigmoid midpoint)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</schema1:defaultValue>
        <rdfs:label>v0 (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>v0</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y0 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y0</skos:notation>
        <tvbo:rhs>y3</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y1 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
        <tvbo:rhs>y4</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y2 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
        <tvbo:rhs>y5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y3 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y3</skos:notation>
        <tvbo:rhs>A*a*Sigm(y1 - y2) - 2*a*y3 - a**2*y0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y4 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y4</skos:notation>
        <tvbo:rhs>A*a*(p + C2*Sigm(C1*y0) + c_intercolumn) - 2*a*y4 - a**2*y1</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y5 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y5">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y5 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y5</skos:notation>
        <tvbo:rhs>B*b*(C4*Sigm(C3*y0)) - 2*b*y5 - b**2*y2</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/DK_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/DK_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>DK_o (KIonEx derived variable)</rdfs:label>
        <skos:notation>DK_o</skos:notation>
        <tvbo:lhs>DK_o</tvbo:lhs>
        <tvbo:rhs>-DKi*beta</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/DNa_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/DNa_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>DNa_i (KIonEx derived variable)</rdfs:label>
        <skos:notation>DNa_i</skos:notation>
        <tvbo:lhs>DNa_i</tvbo:lhs>
        <tvbo:rhs>-DKi</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/DNa_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/DNa_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>DNa_o (KIonEx derived variable)</rdfs:label>
        <skos:notation>DNa_o</skos:notation>
        <tvbo:lhs>DNa_o</tvbo:lhs>
        <tvbo:rhs>-DNa_i*beta</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/I_Cl -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/I_Cl">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>I_Cl (KIonEx derived variable)</rdfs:label>
        <skos:notation>I_Cl</skos:notation>
        <tvbo:lhs>I_Cl</tvbo:lhs>
        <tvbo:rhs>g_Cl*(V + 26.64*log(Cl_o0/Cl_i0))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/I_K -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/I_K">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>I_K (KIonEx derived variable)</rdfs:label>
        <skos:notation>I_K</skos:notation>
        <tvbo:lhs>I_K</tvbo:lhs>
        <tvbo:rhs>(V - 26.64*log(K_o/K_i))*(g_K*n + g_Kl)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/I_Na -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/I_Na">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>I_Na (KIonEx derived variable)</rdfs:label>
        <skos:notation>I_Na</skos:notation>
        <tvbo:lhs>I_Na</tvbo:lhs>
        <tvbo:rhs>(V - 26.64*log(Na_o/Na_i))*(g_Na*h*minf + g_Nal)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/I_pump -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/I_pump">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>I_pump (KIonEx derived variable)</rdfs:label>
        <skos:notation>I_pump</skos:notation>
        <tvbo:lhs>I_pump</tvbo:lhs>
        <tvbo:rhs>1.0*rho/((exp((Ckp - K_o)/DCkp) + 1.0)*(exp((Cnap - Na_i)/DCnap) + 1.0))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/K_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/K_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>K_i (KIonEx derived variable)</rdfs:label>
        <skos:notation>K_i</skos:notation>
        <tvbo:lhs>K_i</tvbo:lhs>
        <tvbo:rhs>DKi + K_i0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/K_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/K_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>K_o (KIonEx derived variable)</rdfs:label>
        <skos:notation>K_o</skos:notation>
        <tvbo:lhs>K_o</tvbo:lhs>
        <tvbo:rhs>DK_o + K_o0 + Kg</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/Na_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/Na_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>Na_i (KIonEx derived variable)</rdfs:label>
        <skos:notation>Na_i</skos:notation>
        <tvbo:lhs>Na_i</tvbo:lhs>
        <tvbo:rhs>DNa_i + Na_i0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/Na_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/Na_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>Na_o (KIonEx derived variable)</rdfs:label>
        <skos:notation>Na_o</skos:notation>
        <tvbo:lhs>Na_o</tvbo:lhs>
        <tvbo:rhs>DNa_o + Na_o0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/V_temp -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/V_temp">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>V_temp (KIonEx derived variable)</rdfs:label>
        <skos:notation>V_temp</skos:notation>
        <tvbo:lhs>V_temp</tvbo:lhs>
        <tvbo:rhs>-1.0*(I_Cl + I_K + I_Na + I_pump)/Cm</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/Vcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/Vcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>Vcond (KIonEx derived variable)</rdfs:label>
        <skos:notation>Vcond</skos:notation>
        <tvbo:lhs>Vcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((R_minus*c_pop0*(-V + E)/pi - R_minus*x**2 + V_temp + eta, V &lt;= Vstar), (R_minus*c_pop0*(-V + E)/pi - R_plus*x**2 + V_temp + eta, True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/beta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/beta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>beta (KIonEx derived variable)</rdfs:label>
        <skos:notation>beta</skos:notation>
        <tvbo:lhs>beta</tvbo:lhs>
        <tvbo:rhs>w_i/w_o</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/h -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/h">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>h (KIonEx derived variable)</rdfs:label>
        <skos:notation>h</skos:notation>
        <tvbo:lhs>h</tvbo:lhs>
        <tvbo:rhs>1.1 - 1.0/(1.0 + 24.5325301971094*exp(-8.0*n))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/minf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/minf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>minf (KIonEx derived variable)</rdfs:label>
        <skos:notation>minf</skos:notation>
        <tvbo:lhs>minf</tvbo:lhs>
        <tvbo:rhs>1.0/(exp((Cmna - V)/DCmna) + 1.0)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/ninf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/ninf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>ninf (KIonEx derived variable)</rdfs:label>
        <skos:notation>ninf</skos:notation>
        <tvbo:lhs>ninf</tvbo:lhs>
        <tvbo:rhs>1.0/(exp((Cnk - V)/DCnk) + 1.0)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>r (KIonEx derived variable)</rdfs:label>
        <skos:notation>r</skos:notation>
        <tvbo:lhs>r</tvbo:lhs>
        <tvbo:rhs>R_minus*x/pi</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/xcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/xcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>xcond (KIonEx derived variable)</rdfs:label>
        <skos:notation>xcond</skos:notation>
        <tvbo:lhs>xcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((Delta - J*r*x + 2*R_minus*x*(V - c_minus), V &lt;= Vstar), (Delta - J*r*x + 2*R_plus*x*(V - c_plus), True))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Chn -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Chn">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.4</schema1:defaultValue>
        <rdfs:label>Chn (KIonEx parameter)</rdfs:label>
        <skos:notation>Chn</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Ckp -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Ckp">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.5</schema1:defaultValue>
        <rdfs:label>Ckp (KIonEx parameter)</rdfs:label>
        <skos:notation>Ckp</skos:notation>
        <tvbo:unit>mol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Cl_i0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Cl_i0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>initial concentration of intracellular Cl</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema1:defaultValue>
        <rdfs:label>Cl_i0 (KIonEx parameter)</rdfs:label>
        <skos:definition>initial concentration of intracellular Cl</skos:definition>
        <skos:notation>Cl_i0</skos:notation>
        <tvbo:unit>mmol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Cl_o0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Cl_o0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>initial concentration of extracellular Cl</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">112.0</schema1:defaultValue>
        <rdfs:label>Cl_o0 (KIonEx parameter)</rdfs:label>
        <skos:definition>initial concentration of extracellular Cl</skos:definition>
        <skos:notation>Cl_o0</skos:notation>
        <tvbo:unit>mmol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Cm -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Cm">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>membrane capacitance</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>Cm (KIonEx parameter)</rdfs:label>
        <skos:definition>membrane capacitance</skos:definition>
        <skos:notation>Cm</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Cmna -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Cmna">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-24.0</schema1:defaultValue>
        <rdfs:label>Cmna (KIonEx parameter)</rdfs:label>
        <skos:notation>Cmna</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Cnap -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Cnap">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">21.0</schema1:defaultValue>
        <rdfs:label>Cnap (KIonEx parameter)</rdfs:label>
        <skos:notation>Cnap</skos:notation>
        <tvbo:unit>mol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Cnk -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Cnk">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-19.0</schema1:defaultValue>
        <rdfs:label>Cnk (KIonEx parameter)</rdfs:label>
        <skos:notation>Cnk</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/DChn -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/DChn">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-8.0</schema1:defaultValue>
        <rdfs:label>DChn (KIonEx parameter)</rdfs:label>
        <skos:notation>DChn</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/DCkp -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/DCkp">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>DCkp (KIonEx parameter)</rdfs:label>
        <skos:notation>DCkp</skos:notation>
        <tvbo:unit>mol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/DCmna -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/DCmna">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">12.0</schema1:defaultValue>
        <rdfs:label>DCmna (KIonEx parameter)</rdfs:label>
        <skos:notation>DCmna</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/DCnap -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/DCnap">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema1:defaultValue>
        <rdfs:label>DCnap (KIonEx parameter)</rdfs:label>
        <skos:notation>DCnap</skos:notation>
        <tvbo:unit>mol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/DCnk -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/DCnk">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">18.0</schema1:defaultValue>
        <rdfs:label>DCnk (KIonEx parameter)</rdfs:label>
        <skos:notation>DCnk</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>HWHM heterogeneous noise</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>Delta (KIonEx parameter)</rdfs:label>
        <skos:definition>HWHM heterogeneous noise</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/E -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/E">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Reversal Potential</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0019228"/>
        <rdfs:label>E (KIonEx parameter)</rdfs:label>
        <skos:definition>Reversal Potential</skos:definition>
        <skos:notation>E</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/J -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/J">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Mean Synaptic weight</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.1</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J (KIonEx parameter)</rdfs:label>
        <skos:definition>Mean Synaptic weight</skos:definition>
        <skos:notation>J</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/K_bath -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/K_bath">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Potassium concentration in bath</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.5</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0055075"/>
        <rdfs:label>K_bath (KIonEx parameter)</rdfs:label>
        <skos:definition>Potassium concentration in bath</skos:definition>
        <skos:notation>K_bath</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/K_i0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/K_i0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>initial concentration of intracellular K</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">130.0</schema1:defaultValue>
        <rdfs:label>K_i0 (KIonEx parameter)</rdfs:label>
        <skos:definition>initial concentration of intracellular K</skos:definition>
        <skos:notation>K_i0</skos:notation>
        <tvbo:unit>mmol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/K_o0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/K_o0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>initial concentration of extracellular K</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.8</schema1:defaultValue>
        <rdfs:label>K_o0 (KIonEx parameter)</rdfs:label>
        <skos:definition>initial concentration of extracellular K</skos:definition>
        <skos:notation>K_o0</skos:notation>
        <tvbo:unit>mmol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Na_i0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Na_i0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>initial concentration of intracellular Na</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">16.0</schema1:defaultValue>
        <rdfs:label>Na_i0 (KIonEx parameter)</rdfs:label>
        <skos:definition>initial concentration of intracellular Na</skos:definition>
        <skos:notation>Na_i0</skos:notation>
        <tvbo:unit>mmol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Na_o0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Na_o0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>initial concentration of extracellular Na</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">138.0</schema1:defaultValue>
        <rdfs:label>Na_o0 (KIonEx parameter)</rdfs:label>
        <skos:definition>initial concentration of extracellular Na</skos:definition>
        <skos:notation>Na_o0</skos:notation>
        <tvbo:unit>mmol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/R_minus -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/R_minus">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>curvature left parabola</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema1:defaultValue>
        <rdfs:label>R_minus (KIonEx parameter)</rdfs:label>
        <skos:definition>curvature left parabola</skos:definition>
        <skos:notation>R_minus</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/R_plus -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/R_plus">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>curvature right parabola</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-0.5</schema1:defaultValue>
        <rdfs:label>R_plus (KIonEx parameter)</rdfs:label>
        <skos:definition>curvature right parabola</skos:definition>
        <skos:notation>R_plus</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Vstar -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Vstar">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>x-coordinate meeting point of parabolas</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-31.0</schema1:defaultValue>
        <rdfs:label>Vstar (KIonEx parameter)</rdfs:label>
        <skos:definition>x-coordinate meeting point of parabolas</skos:definition>
        <skos:notation>Vstar</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/c_minus -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/c_minus">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>x-coordinate left parabola</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-40.0</schema1:defaultValue>
        <rdfs:label>c_minus (KIonEx parameter)</rdfs:label>
        <skos:definition>x-coordinate left parabola</skos:definition>
        <skos:notation>c_minus</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/c_plus -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/c_plus">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>x-coordinate right parabola</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-20.0</schema1:defaultValue>
        <rdfs:label>c_plus (KIonEx parameter)</rdfs:label>
        <skos:definition>x-coordinate right parabola</skos:definition>
        <skos:notation>c_plus</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/epsilon -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/epsilon">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>diffusion rate</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.001</schema1:defaultValue>
        <rdfs:label>epsilon (KIonEx parameter)</rdfs:label>
        <skos:definition>diffusion rate</skos:definition>
        <skos:notation>epsilon</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Mean heterogeneous noise</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>eta (KIonEx parameter)</rdfs:label>
        <skos:definition>Mean heterogeneous noise</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/g_Cl -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/g_Cl">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>chloride conductance</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">7.5</schema1:defaultValue>
        <rdfs:label>g_Cl (KIonEx parameter)</rdfs:label>
        <skos:definition>chloride conductance</skos:definition>
        <skos:notation>g_Cl</skos:notation>
        <tvbo:unit>nS</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/g_K -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/g_K">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>maximal potassium conductance</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">22.0</schema1:defaultValue>
        <rdfs:label>g_K (KIonEx parameter)</rdfs:label>
        <skos:definition>maximal potassium conductance</skos:definition>
        <skos:notation>g_K</skos:notation>
        <tvbo:unit>nS</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/g_Kl -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/g_Kl">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>potassium leak conductance</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.12</schema1:defaultValue>
        <rdfs:label>g_Kl (KIonEx parameter)</rdfs:label>
        <skos:definition>potassium leak conductance</skos:definition>
        <skos:notation>g_Kl</skos:notation>
        <tvbo:unit>nS</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/g_Na -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/g_Na">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>maximal sodiumconductance</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">40.0</schema1:defaultValue>
        <rdfs:label>g_Na (KIonEx parameter)</rdfs:label>
        <skos:definition>maximal sodiumconductance</skos:definition>
        <skos:notation>g_Na</skos:notation>
        <tvbo:unit>nS</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/g_Nal -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/g_Nal">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>sodium leak conductance</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.02</schema1:defaultValue>
        <rdfs:label>g_Nal (KIonEx parameter)</rdfs:label>
        <skos:definition>sodium leak conductance</skos:definition>
        <skos:notation>g_Nal</skos:notation>
        <tvbo:unit>nS</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>conversion factor</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.04</schema1:defaultValue>
        <rdfs:label>gamma (KIonEx parameter)</rdfs:label>
        <skos:definition>conversion factor</skos:definition>
        <skos:notation>gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/rho -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/rho">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>maximal Na/K pump current</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">250.0</schema1:defaultValue>
        <rdfs:label>rho (KIonEx parameter)</rdfs:label>
        <skos:definition>maximal Na/K pump current</skos:definition>
        <skos:notation>rho</skos:notation>
        <tvbo:unit>pA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/tau_n -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/tau_n">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>time constant of gating variable</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.0</schema1:defaultValue>
        <rdfs:label>tau_n (KIonEx parameter)</rdfs:label>
        <skos:definition>time constant of gating variable</skos:definition>
        <skos:notation>tau_n</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/w_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/w_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>intracellular volume</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2160.0</schema1:defaultValue>
        <rdfs:label>w_i (KIonEx parameter)</rdfs:label>
        <skos:definition>intracellular volume</skos:definition>
        <skos:notation>w_i</skos:notation>
        <tvbo:unit>um3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/w_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/w_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>extracellular volume</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">720.0</schema1:defaultValue>
        <rdfs:label>w_o (KIonEx parameter)</rdfs:label>
        <skos:definition>extracellular volume</skos:definition>
        <skos:notation>w_o</skos:notation>
        <tvbo:unit>um3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/state_variables/DKi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/state_variables/DKi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>DKi (KIonEx state variable)</rdfs:label>
        <skos:notation>DKi</skos:notation>
        <tvbo:lhs>Derivative(DKi, t)</tvbo:lhs>
        <tvbo:rhs>-gamma*(I_K - 2.0*I_pump)/w_i</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/state_variables/Kg -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/state_variables/Kg">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>Kg (KIonEx state variable)</rdfs:label>
        <skos:notation>Kg</skos:notation>
        <tvbo:lhs>Derivative(Kg, t)</tvbo:lhs>
        <tvbo:rhs>epsilon*(K_bath - K_o)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>V (KIonEx state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>Vcond</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/state_variables/n -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/state_variables/n">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>n (KIonEx state variable)</rdfs:label>
        <skos:notation>n</skos:notation>
        <tvbo:lhs>Derivative(n, t)</tvbo:lhs>
        <tvbo:rhs>(-n + ninf)/tau_n</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/state_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/state_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>x (KIonEx state variable)</rdfs:label>
        <skos:notation>x</skos:notation>
        <tvbo:lhs>Derivative(x, t)</tvbo:lhs>
        <tvbo:rhs>xcond</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Kuramoto/derived_variables/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Kuramoto/derived_variables/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Input via local and long range connectivity, passing first through the Kuramoto coupling function</dcterms:description>
        <rdfs:label>I (Kuramoto derived variable)</rdfs:label>
        <skos:notation>I</skos:notation>
        <tvbo:lhs>I</tvbo:lhs>
        <tvbo:rhs>c_pop0 + lc_0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Kuramoto/derived_variables/lc_0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Kuramoto/derived_variables/lc_0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>lc_0 (Kuramoto derived variable)</rdfs:label>
        <skos:notation>lc_0</skos:notation>
        <tvbo:lhs>lc_0</tvbo:lhs>
        <tvbo:rhs>sin(local_coupling*theta)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Kuramoto/parameters/omega -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Kuramoto/parameters/omega">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Sets the base line frequency for the Kuramoto oscillator</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>omega (Kuramoto parameter)</rdfs:label>
        <skos:definition>Sets the base line frequency for the Kuramoto oscillator.</skos:definition>
        <skos:notation>omega</skos:notation>
        <tvbo:unit>rad_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Kuramoto/state_variables/theta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Kuramoto/state_variables/theta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>The Kuramoto model has only one state variable representing oscillations in general</dcterms:description>
        <rdfs:label>theta (Kuramoto state variable)</rdfs:label>
        <skos:notation>theta</skos:notation>
        <tvbo:lhs>Derivative(theta, t)</tvbo:lhs>
        <tvbo:rhs>I + omega</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KuramotoModel2/derived_variables/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KuramotoModel2/derived_variables/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>`I` is the input via local and long range connectivity, passing first through the Kuramoto coupling function</dcterms:description>
        <rdfs:label>I (KuramotoModel2 derived variable)</rdfs:label>
        <skos:notation>I</skos:notation>
        <tvbo:lhs>I</tvbo:lhs>
        <tvbo:rhs>c_glob+lc_0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KuramotoModel2/derived_variables/lc_0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KuramotoModel2/derived_variables/lc_0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>lc_0 (KuramotoModel2 derived variable)</rdfs:label>
        <skos:notation>lc_0</skos:notation>
        <tvbo:lhs>lc_0</tvbo:lhs>
        <tvbo:rhs>sin(local_coupling*theta)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KuramotoModel2/derived_variables/phase -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KuramotoModel2/derived_variables/phase">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Normalized phase output</dcterms:description>
        <rdfs:label>phase (KuramotoModel2 derived variable)</rdfs:label>
        <skos:notation>phase</skos:notation>
        <tvbo:rhs>theta / (2*pi)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KuramotoModel2/derived_variables/signal -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KuramotoModel2/derived_variables/signal">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Sinusoidal signal output</dcterms:description>
        <rdfs:label>signal (KuramotoModel2 derived variable)</rdfs:label>
        <skos:notation>signal</skos:notation>
        <tvbo:rhs>sin(theta)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KuramotoModel2/parameters/omega -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KuramotoModel2/parameters/omega">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>omega (KuramotoModel2 parameter)</rdfs:label>
        <skos:definition>Sets the base line frequency for the Kuramoto oscillator in [rad/ms].</skos:definition>
        <skos:notation>omega</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KuramotoModel2/state_variables/theta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KuramotoModel2/state_variables/theta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>The Kuramoto model has only one state variable representing oscillations in general</dcterms:description>
        <rdfs:label>theta (KuramotoModel2 state variable)</rdfs:label>
        <skos:notation>theta</skos:notation>
        <tvbo:lhs>thetadot</tvbo:lhs>
        <tvbo:rhs>omega + I</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/derived_variables/Q_V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/derived_variables/Q_V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Average firing rate of the population of PCs, V.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>Q_V (LarterBreakspear derived variable)</rdfs:label>
        <skos:notation>Q_V</skos:notation>
        <tvbo:lhs>Q_V</tvbo:lhs>
        <tvbo:rhs>0.5*Q_Vmax*(tanh((V - V_T)/delta_V) + 1)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/derived_variables/Q_Z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/derived_variables/Q_Z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Average firing rate of the population of IINs, Z.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>Q_Z (LarterBreakspear derived variable)</rdfs:label>
        <skos:notation>Q_Z</skos:notation>
        <tvbo:lhs>Q_Z</tvbo:lhs>
        <tvbo:rhs>0.5*Q_Zmax*(tanh((Z - Z_T)/delta_Z) + 1)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/derived_variables/lc_0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/derived_variables/lc_0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>lc_0 (LarterBreakspear derived variable)</rdfs:label>
        <skos:notation>lc_0</skos:notation>
        <tvbo:lhs>lc_0</tvbo:lhs>
        <tvbo:rhs>Q_V*local_coupling</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/derived_variables/m_Ca -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/derived_variables/m_Ca">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Fraction of open calcium channels (Breakspear et al., 2003b). 

Describes relationship between membrane voltage and channel conductance.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0005262"/>
        <rdfs:label>m_Ca (LarterBreakspear derived variable)</rdfs:label>
        <skos:notation>m_Ca</skos:notation>
        <tvbo:lhs>m_Ca</tvbo:lhs>
        <tvbo:rhs>0.5*tanh((-T_Ca + V)/delta_Ca) + 0.5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/derived_variables/m_K -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/derived_variables/m_K">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Fraction of open potassium channels (Breakspear et al., 2003b). 

Describes relationship between membrane voltage and channel conductance.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0005267"/>
        <rdfs:label>m_K (LarterBreakspear derived variable)</rdfs:label>
        <skos:notation>m_K</skos:notation>
        <tvbo:lhs>m_K</tvbo:lhs>
        <tvbo:rhs>0.5*tanh((-T_K + V)/delta_K) + 0.5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/derived_variables/m_Na -->

