<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/tvbo/tvbo.owl#"
     xml:base="https://w3id.org/tvbo/tvbo.owl"
     xmlns:UO="http://purl.obolibrary.org/obo/UO_"
     xmlns:wd="http://www.wikidata.org/entity/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:pav="http://purl.org/pav/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:sio="http://semanticscience.org/resource/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:qudt="http://qudt.org/vocab/unit/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:tvbo="https://w3id.org/tvbo/"
     xmlns:linkml="https://w3id.org/linkml/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:schema1="http://schema.org/"
     xmlns:biotools="https://bio.tools/ontology/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="https://w3id.org/tvbo/tvbo.owl">
        <owl:versionIRI rdf:resource="https://w3id.org/tvbo/2026-04-30/tvbo.owl"/>
        <dcterms:contributor>The Virtual Brain Ontology contributors</dcterms:contributor>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-01</dcterms:created>
        <dcterms:description>Metadata schema for simulation studies using The Virtual Brain neuroinformatics platform or other dynamic network models of large-scale brain activity.</dcterms:description>
        <dcterms:license rdf:resource="https://spdx.org/licenses/EUPL-1.2"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-30</dcterms:modified>
        <dcterms:publisher rdf:resource="https://www.thevirtualbrain.org/"/>
        <dcterms:title>The Virtual Brain Data Model</dcterms:title>
        <pav:version>0.4.0</pav:version>
        <rdfs:label>tvb-datamodel</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/tvbo/axioms"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/tvbo/data"/>
        <owl:versionInfo>0.4.0</owl:versionInfo>
    </owl:Ontology>
    


