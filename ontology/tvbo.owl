                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/NumericalDiscretizationMethod#collocation"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/NumericalDiscretizationMethod#poincare"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/NumericalDiscretizationMethod#shooting"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/NumericalDiscretizationMethod#trapezoid"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>NumericalDiscretizationMethod</rdfs:label>
        <skos:definition>Numerical discretization method for boundary value problems (periodic orbits, connecting orbits, quasi-periodic tori).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/NumericalDiscretizationMethod#collocation"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/NumericalDiscretizationMethod#poincare"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/NumericalDiscretizationMethod#shooting"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/NumericalDiscretizationMethod#trapezoid"/>
    </owl:Class>
    


