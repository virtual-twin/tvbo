        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-60.0</schema:defaultValue>
        <rdfs:label>muV0 (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>Normalization factors page 48 after the equation 4 from [ZD_2018]</skos:definition>
        <skos:notation>muV0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/p_connect_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/p_connect_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>connectivity probability</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.05</schema:defaultValue>
        <rdfs:label>p_connect_e (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>connectivity probability</skos:definition>
        <skos:notation>p_connect_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/p_connect_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/p_connect_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>connectivity probability</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.05</schema:defaultValue>
        <rdfs:label>p_connect_i (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>connectivity probability</skos:definition>
        <skos:notation>p_connect_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/sV0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/sV0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Normalization factors page 48 after the equation 4 from [ZD_2018]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.0</schema:defaultValue>
        <rdfs:label>sV0 (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>Normalization factors page 48 after the equation 4 from [ZD_2018]</skos:definition>
        <skos:notation>sV0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/tau_OU -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/tau_OU">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>time constant noise</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>tau_OU (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>time constant noise</skos:definition>
        <skos:notation>tau_OU</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/tau_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/tau_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>excitatory decay [ms]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>tau_e (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>excitatory decay [ms]</skos:definition>
        <skos:notation>tau_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/tau_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/tau_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>inhibitory decay [ms]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>tau_i (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>inhibitory decay [ms]</skos:definition>
        <skos:notation>tau_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/tau_w_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/tau_w_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Adaptation time constant of excitatory neurons [ms]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">500.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>tau_w_e (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>Adaptation time constant of excitatory neurons [ms]</skos:definition>
        <skos:notation>tau_w_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/tau_w_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/tau_w_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Adaptation time constant of inhibitory neurons [ms]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>tau_w_i (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>Adaptation time constant of inhibitory neurons [ms]</skos:definition>
        <skos:notation>tau_w_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/weight_noise -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/weight_noise">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>weight noise</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.5</schema:defaultValue>
        <rdfs:label>weight_noise (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>weight noise</skos:definition>
        <skos:notation>weight_noise</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/E -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/E">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(E, t)</tvbo:lhs>
        <tvbo:rhs>(-E + f_out_e)/T</tvbo:rhs>
        <terms:description>Firing rate of excitatory population in KHz</terms:description>
        <rdfs:label>E (ZerlautAdaptationFirstOrder state variable)</rdfs:label>
        <skos:notation>E</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(I, t)</tvbo:lhs>
        <tvbo:rhs>(-I + f_out_i)/T</tvbo:rhs>
        <terms:description>Firing rate of inhibitory population in KHz</terms:description>
        <rdfs:label>I (ZerlautAdaptationFirstOrder state variable)</rdfs:label>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/W_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/W_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(W_e, t)</tvbo:lhs>
        <tvbo:rhs>E*b_e - W_e/tau_w_e + a_e*(-E_L_e + mu_V_e)/tau_w_e</tvbo:rhs>
        <terms:description>Level of adaptation of excitatory in pA</terms:description>
        <rdfs:label>W_e (ZerlautAdaptationFirstOrder state variable)</rdfs:label>
        <skos:notation>W_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/W_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/W_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(W_i, t)</tvbo:lhs>
        <tvbo:rhs>I*b_i - W_i/tau_w_i + a_i*(-E_L_i + mu_V_i)/tau_w_i</tvbo:rhs>
        <terms:description>Level of adaptation of inhibitory in pA</terms:description>
        <rdfs:label>W_i (ZerlautAdaptationFirstOrder state variable)</rdfs:label>
        <skos:notation>W_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/ou_drift -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/state_variables/ou_drift">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(ou_drift, t)</tvbo:lhs>
        <tvbo:rhs>-ou_drift/tau_OU</tvbo:rhs>
        <rdfs:label>ou_drift (ZerlautAdaptationFirstOrder state variable)</rdfs:label>
        <skos:notation>ou_drift</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/E_input_excitatory -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/E_input_excitatory">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E_input_excitatory</tvbo:lhs>
        <tvbo:rhs>Piecewise((0.0, c_glob + local_coupling*E + external_input_ex_ex + weight_noise*ou_drift &lt; 0), (c_glob + local_coupling*E + external_input_ex_ex + weight_noise*ou_drift, True))</tvbo:rhs>
        <terms:description>External excitatory input onto the excitatory population (clamped to be non-negative).</terms:description>
        <rdfs:label>E_input_excitatory (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>E_input_excitatory</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/E_input_inhibitory -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/E_input_inhibitory">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E_input_inhibitory</tvbo:lhs>
        <tvbo:rhs>Piecewise((0.0, S_i*c_glob + local_coupling*E + external_input_in_ex + weight_noise*ou_drift &lt; 0), (S_i*c_glob + local_coupling*E + external_input_in_ex + weight_noise*ou_drift, True))</tvbo:rhs>
        <terms:description>External excitatory input onto the inhibitory population (clamped to be non-negative).</terms:description>
        <rdfs:label>E_input_inhibitory (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>E_input_inhibitory</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/I_input_excitatory -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/I_input_excitatory">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>I_input_excitatory</tvbo:lhs>
        <tvbo:rhs>local_coupling*I + external_input_ex_in</tvbo:rhs>
        <terms:description>External inhibitory input onto the excitatory population.</terms:description>
        <rdfs:label>I_input_excitatory (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>I_input_excitatory</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/I_input_inhibitory -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/I_input_inhibitory">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>I_input_inhibitory</tvbo:lhs>
        <tvbo:rhs>local_coupling*I + external_input_in_in</tvbo:rhs>
        <terms:description>External inhibitory input onto the inhibitory population.</terms:description>
        <rdfs:label>I_input_inhibitory (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>I_input_inhibitory</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/TFe -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/TFe">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>TFe</tvbo:lhs>
        <tvbo:rhs>TF_e(E, I, E_input_excitatory, I_input_excitatory, W_e)</tvbo:rhs>
        <terms:description>Excitatory transfer-function output evaluated at the current state.</terms:description>
        <rdfs:label>TFe (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>TFe</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/TFi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/TFi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>TFi</tvbo:lhs>
        <tvbo:rhs>TF_i(E, I, E_input_inhibitory, I_input_inhibitory, W_i)</tvbo:rhs>
        <terms:description>Inhibitory transfer-function output evaluated at the current state.</terms:description>
        <rdfs:label>TFi (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>TFi</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fefe_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fefe_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>d2_fefe_e</tvbo:lhs>
        <tvbo:rhs>(TF_e(E + 1.0e-7, I, E_input_excitatory, I_input_excitatory, W_e) - 2*TFe + TF_e(E - 1.0e-7, I, E_input_excitatory, I_input_excitatory, W_e))/((1.0e-7*1000.0)**2)</tvbo:rhs>
        <terms:description>Second central difference of TF_e w.r.t. excitatory rate.</terms:description>
        <rdfs:label>d2_fefe_e (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>d2_fefe_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fefe_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fefe_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>d2_fefe_i</tvbo:lhs>
        <tvbo:rhs>(TF_i(E + 1.0e-7, I, E_input_inhibitory, I_input_inhibitory, W_i) - 2*TFi + TF_i(E - 1.0e-7, I, E_input_inhibitory, I_input_inhibitory, W_i))/((1.0e-7*1000.0)**2)</tvbo:rhs>
        <terms:description>Second central difference of TF_i w.r.t. excitatory rate.</terms:description>
        <rdfs:label>d2_fefe_i (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>d2_fefe_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fefi_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fefi_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>d2_fefi_e</tvbo:lhs>
        <tvbo:rhs>((TF_e(E + 1.0e-7, I + 1.0e-7, E_input_excitatory, I_input_excitatory, W_e) - TF_e(E - 1.0e-7, I + 1.0e-7, E_input_excitatory, I_input_excitatory, W_e))/(2*1.0e-7*1000.0) - (TF_e(E + 1.0e-7, I - 1.0e-7, E_input_excitatory, I_input_excitatory, W_e) - TF_e(E - 1.0e-7, I - 1.0e-7, E_input_excitatory, I_input_excitatory, W_e))/(2*1.0e-7*1000.0))/(2*1.0e-7*1000.0)</tvbo:rhs>
        <terms:description>Mixed second central difference of TF_e (d/dfi of d/dfe).</terms:description>
        <rdfs:label>d2_fefi_e (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>d2_fefi_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fefi_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fefi_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>d2_fefi_i</tvbo:lhs>
        <tvbo:rhs>((TF_i(E + 1.0e-7, I + 1.0e-7, E_input_inhibitory, I_input_inhibitory, W_i) - TF_i(E - 1.0e-7, I + 1.0e-7, E_input_inhibitory, I_input_inhibitory, W_i))/(2*1.0e-7*1000.0) - (TF_i(E + 1.0e-7, I - 1.0e-7, E_input_inhibitory, I_input_inhibitory, W_i) - TF_i(E - 1.0e-7, I - 1.0e-7, E_input_inhibitory, I_input_inhibitory, W_i))/(2*1.0e-7*1000.0))/(2*1.0e-7*1000.0)</tvbo:rhs>
        <terms:description>Mixed second central difference of TF_i (d/dfi of d/dfe).</terms:description>
        <rdfs:label>d2_fefi_i (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>d2_fefi_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fife_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fife_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>d2_fife_e</tvbo:lhs>
        <tvbo:rhs>((TF_e(E + 1.0e-7, I + 1.0e-7, E_input_excitatory, I_input_excitatory, W_e) - TF_e(E + 1.0e-7, I - 1.0e-7, E_input_excitatory, I_input_excitatory, W_e))/(2*1.0e-7*1000.0) - (TF_e(E - 1.0e-7, I + 1.0e-7, E_input_excitatory, I_input_excitatory, W_e) - TF_e(E - 1.0e-7, I - 1.0e-7, E_input_excitatory, I_input_excitatory, W_e))/(2*1.0e-7*1000.0))/(2*1.0e-7*1000.0)</tvbo:rhs>
        <terms:description>Mixed second central difference of TF_e (d/dfe of d/dfi).</terms:description>
        <rdfs:label>d2_fife_e (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>d2_fife_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fife_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fife_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>d2_fife_i</tvbo:lhs>
        <tvbo:rhs>((TF_i(E + 1.0e-7, I + 1.0e-7, E_input_inhibitory, I_input_inhibitory, W_i) - TF_i(E + 1.0e-7, I - 1.0e-7, E_input_inhibitory, I_input_inhibitory, W_i))/(2*1.0e-7*1000.0) - (TF_i(E - 1.0e-7, I + 1.0e-7, E_input_inhibitory, I_input_inhibitory, W_i) - TF_i(E - 1.0e-7, I - 1.0e-7, E_input_inhibitory, I_input_inhibitory, W_i))/(2*1.0e-7*1000.0))/(2*1.0e-7*1000.0)</tvbo:rhs>
        <terms:description>Mixed second central difference of TF_i (d/dfe of d/dfi).</terms:description>
        <rdfs:label>d2_fife_i (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>d2_fife_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fifi_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fifi_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>d2_fifi_e</tvbo:lhs>
        <tvbo:rhs>(TF_e(E, I + 1.0e-7, E_input_excitatory, I_input_excitatory, W_e) - 2*TFe + TF_e(E, I - 1.0e-7, E_input_excitatory, I_input_excitatory, W_e))/((1.0e-7*1000.0)**2)</tvbo:rhs>
        <terms:description>Second central difference of TF_e w.r.t. inhibitory rate.</terms:description>
        <rdfs:label>d2_fifi_e (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>d2_fifi_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fifi_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/d2_fifi_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>d2_fifi_i</tvbo:lhs>
        <tvbo:rhs>(TF_i(E, I + 1.0e-7, E_input_inhibitory, I_input_inhibitory, W_i) - 2*TFi + TF_i(E, I - 1.0e-7, E_input_inhibitory, I_input_inhibitory, W_i))/((1.0e-7*1000.0)**2)</tvbo:rhs>
        <terms:description>Second central difference of TF_i w.r.t. inhibitory rate.</terms:description>
        <rdfs:label>d2_fifi_i (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>d2_fifi_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/dfe_TFe -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationSecondOrder/derived_variables/dfe_TFe">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>dfe_TFe</tvbo:lhs>
        <tvbo:rhs>(TF_e(E + 1.0e-7, I, E_input_excitatory, I_input_excitatory, W_e) - TF_e(E - 1.0e-7, I, E_input_excitatory, I_input_excitatory, W_e))/(2*1.0e-7*1000.0)</tvbo:rhs>
        <terms:description>Central finite-difference derivative of TF_e w.r.t. excitatory rate (df=1e-7).</terms:description>
        <rdfs:label>dfe_TFe (ZerlautAdaptationSecondOrder derived variable)</rdfs:label>
        <skos:notation>dfe_TFe</skos:notation>
    </owl:NamedIndividual>
    


