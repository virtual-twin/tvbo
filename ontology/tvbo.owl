        <tvbo:hasStochasticityCharacter rdf:resource="https://w3id.org/tvbo/Deterministic"/>
        <tvbo:modelsAnatomicalRegion rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000956"/>
        <tvbo:modelsAnatomicalRegion rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002728"/>
        <tvbo:hasTimescaleSeparation rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</tvbo:hasTimescaleSeparation>
        <tvbo:phaseSpaceDimension rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</tvbo:phaseSpaceDimension>
        <dcterms:description>Epileptor Resting-State (ERS) is an extension of the phenomenological neural mass model of Epileptor5D, tuned to express regionally specific physiological oscillations in addition to the epileptiform discharges (Courtiol et al., 2020). This extension was made using the Generic 2-dimensional Oscillator model (parametrized close to a supercritical Hopf Bifurcation) (Sanz-Leon et al., 2013, 2015) to reproduce the spontaneous local field potential-like signal.
        
This model, its motivation and derivation can be found in the published article (Courtiol et al., 2020).</dcterms:description>
        <dcterms:references rdf:resource="https://w3id.org/tvbo/studies/Courtiol2020"/>
        <dcterms:references rdf:resource="https://w3id.org/tvbo/studies/Jirsa2014"/>
        <dcterms:subject rdf:resource="http://purl.bioontology.org/ontology/MESH/D004827"/>
        <rdfs:label>EpileptorRestingState</rdfs:label>
        <skos:prefLabel xml:lang="en">Epileptor (resting-state)</skos:prefLabel>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/lc_1"/>
