        <skos:notation>g_K</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/parameters/g_L -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/parameters/g_L">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Conductance of population of leak channels</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0022840"/>
        <rdfs:label>g_L (LarterBreakspear parameter)</rdfs:label>
        <skos:definition>Conductance of population of leak channels.</skos:definition>
        <skos:notation>g_L</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/parameters/g_Na -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/parameters/g_Na">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Conductance of population of Na channels</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.7</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0005272"/>
        <rdfs:label>g_Na (LarterBreakspear parameter)</rdfs:label>
        <skos:definition>Conductance of population of Na channels.</skos:definition>
        <skos:notation>g_Na</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/parameters/phi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/parameters/phi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Temperature scaling factor</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.7</schema1:defaultValue>
        <rdfs:label>phi (LarterBreakspear parameter)</rdfs:label>
        <skos:definition>Temperature scaling factor.</skos:definition>
        <skos:notation>phi</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/parameters/r_NMDA -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/parameters/r_NMDA">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Ratio of NMDA to AMPA receptors</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.25</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0004971"/>
        <rdfs:label>r_NMDA (LarterBreakspear parameter)</rdfs:label>
        <skos:definition>Ratio of NMDA to AMPA receptors.</skos:definition>
        <skos:notation>r_NMDA</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/parameters/t_scale -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/parameters/t_scale">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Time scale factor</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>t_scale (LarterBreakspear parameter)</rdfs:label>
        <skos:definition>Time scale factor</skos:definition>
        <skos:notation>t_scale</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/parameters/tau_K -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/parameters/tau_K">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Time constant for K relaxation time (ms)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0005267"/>
        <rdfs:label>tau_K (LarterBreakspear parameter)</rdfs:label>
        <skos:definition>Time constant for K relaxation time (ms)</skos:definition>
        <skos:notation>tau_K</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>First state-variable of the Larter-Breakspear (Breakspear et al</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>V (LarterBreakspear state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>t_scale*(I_ext*a_ne - Q_Z*Z*a_ie - W*g_K*(V - V_K) - g_L*(V - V_L) + m_Ca*(V - V_Ca)*(-C*a_ee*c_pop0*r_NMDA - a_ee*r_NMDA*(1.0 - C)*(Q_V + lc_0) - g_Ca) - (V - V_Na)*(C*a_ee*c_pop0 + a_ee*(1.0 - C)*(Q_V + lc_0) + g_Na*m_Na))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/state_variables/W -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/state_variables/W">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Second state-variable of the Larter-Breakspear (Breakspear et al</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0005267"/>
        <rdfs:label>W (LarterBreakspear state variable)</rdfs:label>
        <skos:notation>W</skos:notation>
        <tvbo:lhs>Derivative(W, t)</tvbo:lhs>
        <tvbo:rhs>phi*t_scale*(-W + m_K)/tau_K</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/state_variables/Z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/state_variables/Z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Third state-variable of the Larter-Breakspear (Breakspear et al</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>Z (LarterBreakspear state variable)</rdfs:label>
        <skos:notation>Z</skos:notation>
        <tvbo:lhs>Derivative(Z, t)</tvbo:lhs>
        <tvbo:rhs>b*t_scale*(I_ext*a_ni + Q_V*V*a_ei)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/derived_variables/v_pyr -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/derived_variables/v_pyr">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>EEG-like output: pyramidal potential difference</dcterms:description>
        <rdfs:label>v_pyr (ModelJansen1995 derived variable)</rdfs:label>
        <skos:notation>v_pyr</skos:notation>
        <tvbo:rhs>y1 - y2</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/parameters/A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/parameters/A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.25</schema1:defaultValue>
        <rdfs:label>A (ModelJansen1995 parameter)</rdfs:label>
        <skos:notation>A</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/parameters/B -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/parameters/B">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</schema1:defaultValue>
        <rdfs:label>B (ModelJansen1995 parameter)</rdfs:label>
        <skos:notation>B</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/parameters/C -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/parameters/C">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">135</schema1:defaultValue>
        <rdfs:label>C (ModelJansen1995 parameter)</rdfs:label>
        <skos:notation>C</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.1</schema1:defaultValue>
        <rdfs:label>a (ModelJansen1995 parameter)</rdfs:label>
        <skos:notation>a</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.05</schema1:defaultValue>
        <rdfs:label>b (ModelJansen1995 parameter)</rdfs:label>
        <skos:notation>b</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/parameters/e0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/parameters/e0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0025</schema1:defaultValue>
        <rdfs:label>e0 (ModelJansen1995 parameter)</rdfs:label>
        <skos:notation>e0</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/parameters/p -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/parameters/p">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.24</schema1:defaultValue>
        <rdfs:label>p (ModelJansen1995 parameter)</rdfs:label>
        <skos:notation>p</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.56</schema1:defaultValue>
        <rdfs:label>r (ModelJansen1995 parameter)</rdfs:label>
        <skos:notation>r</skos:notation>
        <tvbo:unit>per_mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/parameters/v0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/parameters/v0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</schema1:defaultValue>
        <rdfs:label>v0 (ModelJansen1995 parameter)</rdfs:label>
        <skos:notation>v0</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y0 (ModelJansen1995 state variable)</rdfs:label>
        <skos:notation>y0</skos:notation>
        <tvbo:rhs>y3</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y1 (ModelJansen1995 state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
        <tvbo:rhs>y4</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y2 (ModelJansen1995 state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
        <tvbo:rhs>y5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y3 (ModelJansen1995 state variable)</rdfs:label>
        <skos:notation>y3</skos:notation>
        <tvbo:rhs>A*a*Sigm(y1 - y2) - 2*a*y3 - a**2*y0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y4 (ModelJansen1995 state variable)</rdfs:label>
        <skos:notation>y4</skos:notation>
        <tvbo:rhs>A*a*(p + C2*Sigm(C1*y0) + c_glob) - 2*a*y4 - a**2*y1</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y5 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y5">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>y5 (ModelJansen1995 state variable)</rdfs:label>
        <skos:notation>y5</skos:notation>
        <tvbo:rhs>B*b*(C4*Sigm(C3*y0)) - 2*b*y5 - b**2*y2</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Mean heterogeneous noise</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0061669"/>
        <rdfs:label>Delta (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>Mean heterogeneous noise</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External Current</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>I (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>External Current</skos:definition>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/J -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/J">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Mean Synaptic weight</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">15.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>Mean Synaptic weight.</skos:definition>
        <skos:notation>J</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/cr -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/cr">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>It is the weight on Coupling through variable r</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>cr (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable r.</skos:definition>
        <skos:notation>cr</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/cv -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/cv">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>It is the weight on Coupling through variable V</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <rdfs:label>cv (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable V.</skos:definition>
        <skos:notation>cv</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Constant parameter to scale the rate of feedback from the firing rate variable to itself</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-5.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>eta (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the firing rate variable to itself</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Membrane time constant</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>tau (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>Membrane time constant</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>V (MontbrioPazoRoxin state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>(I + J*r*tau + V**2 + c_pop0*cr*tau + c_pop1*cv + eta - pi**2*r**2*tau**2)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>r (MontbrioPazoRoxin state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>(Delta/(pi*tau) + 2*V*r)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/derived_variables/H -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/derived_variables/H">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Sigmoid input-output function of the synaptic input current, x_RWW, that computes the averaged firing rate of the neurons population (Deco et al., 2013).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>H (ReducedWongWang derived variable)</rdfs:label>
        <skos:notation>H</skos:notation>
        <tvbo:lhs>H</tvbo:lhs>
        <tvbo:rhs>(a*x - b)/(1 - exp(-d*(a*x - b)))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/derived_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/derived_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>(NMDAR)-mediated synaptic input current to the neurons population (Deco et al., 2013).</dcterms:description>
        <rdfs:label>x (ReducedWongWang derived variable)</rdfs:label>
        <skos:notation>x</skos:notation>
        <tvbo:lhs>x</tvbo:lhs>
        <tvbo:rhs>I_o + J_N*S*local_coupling + J_N*S*w + J_N*c_pop0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/I_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/I_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External input current to the neurons population (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.33</schema1:defaultValue>
        <rdfs:label>I_o (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>External input current to the neurons population (Deco et al., 2013).

Note:
------
In TVB, the default value is set to 0.33 (instead of 0.30 as in Deco et al. (2013)) for setting the system is bistability (see Hansen et al., 2015).</skos:definition>
        <skos:notation>I_o</skos:notation>
        <tvbo:unit>nA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/J_N -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/J_N">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Excitatory recurrence</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2609</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>J_N (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Excitatory recurrence</skos:definition>
        <skos:notation>J_N</skos:notation>
        <tvbo:unit>nA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Slope (or gain) parameter of the sigmoid input-output function H_RWW (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.27</schema1:defaultValue>
        <rdfs:label>a (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Slope (or gain) parameter of the sigmoid input-output function H_RWW (Deco et al., 2013).

Note:
-----
In the original publication, the parameter &apos;a&apos; is set in (nC)^-1 (i.e., equivalent to  (nA.s)^-1).  In TVB, the parameter has been converted in (pC)^-1 for setting the system in millisecond.</skos:definition>
        <skos:notation>a</skos:notation>
        <tvbo:unit>per_pC</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Shift parameter of the sigmoid input-output function H_RWW (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.108</schema1:defaultValue>
        <rdfs:label>b (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Shift parameter of the sigmoid input-output function H_RWW (Deco et al., 2013). 

Note:
------
In the original publication, the parameter &apos;b&apos; is set in Hz. In TVB, the parameter has been converted in kHz for setting the system in millisecond.</skos:definition>
        <skos:notation>b</skos:notation>
        <tvbo:unit>kHz</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Scaling parameter of the sigmoid input-output function H_RWW (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">154.0</schema1:defaultValue>
        <rdfs:label>d (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Scaling parameter of the sigmoid input-output function H_RWW (Deco et al., 2013). 

Note:
------
In the original publication, the parameter &apos;d&apos; is set in second. In TVB, the parameter has been converted in millisecond for setting the system in millisecond.</skos:definition>
        <skos:notation>d</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Kinetic parameter</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.641</schema1:defaultValue>
        <rdfs:label>gamma (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Kinetic parameter</skos:definition>
        <skos:notation>gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/tau_s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/tau_s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Kinetic parameter</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">100.0</schema1:defaultValue>
        <rdfs:label>tau_s (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Kinetic parameter. Decay time constant for the NMDA synapses of the neurons population (Deco et al., 2013).</skos:definition>
        <skos:notation>tau_s</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/parameters/w -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/parameters/w">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Excitatory recurrence</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.6</schema1:defaultValue>
        <rdfs:label>w (ReducedWongWang parameter)</rdfs:label>
        <skos:definition>Excitatory recurrence</skos:definition>
        <skos:notation>w</skos:notation>
        <tvbo:unit>dimensionless</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWang/state_variables/S -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWang/state_variables/S">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>State-variable of the Reduced WongWang model, denoting the average, (NMDAR)-mediated synaptic gating, i</dcterms:description>
        <rdfs:label>S (ReducedWongWang state variable)</rdfs:label>
        <skos:notation>S</skos:notation>
        <tvbo:lhs>Derivative(S, t)</tvbo:lhs>
        <tvbo:rhs>H*gamma*(1 - S) - S/tau_s</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/H_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/H_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Sigmoid function that computes the averaged firing rate of the excitatory neuron population IE_RWW_EI (Deco et al., 2014; Abbott &amp; Chance, 2005).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>H_e (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>H_e</skos:notation>
        <tvbo:lhs>H_e</tvbo:lhs>
        <tvbo:rhs>x_e/(1 - exp(-d_e*x_e))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/H_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/H_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Sigmoid function that computes the averaged firing rate of the inhibitory neuron population II_RWW (Deco et al., 2014; Abbott &amp; Chance, 2005).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>H_i (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>H_i</skos:notation>
        <tvbo:lhs>H_i</tvbo:lhs>
        <tvbo:rhs>x_i/(1 - exp(-d_i*x_i))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/J_N_S_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/J_N_S_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>J_N_S_e (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>J_N_S_e</skos:notation>
        <tvbo:lhs>J_N_S_e</tvbo:lhs>
        <tvbo:rhs>J_N*S_e</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/coupling -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/coupling">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>coupling (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>coupling</skos:notation>
        <tvbo:lhs>coupling</tvbo:lhs>
        <tvbo:rhs>G*J_N*(S_e*local_coupling + c_glob)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/x_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/x_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Input current to the excitatory population (Deco et al., 2014).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>x_e (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>x_e</skos:notation>
        <tvbo:lhs>x_e</tvbo:lhs>
        <tvbo:rhs>a_e*(I_ext + I_o*W_e + J_N_S_e*w_p - J_i*S_i + coupling) - b_e</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/x_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/x_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Input current to the inhibitory population (Deco et al., 2014).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>x_i (ReducedWongWangExcInh derived variable)</rdfs:label>
        <skos:notation>x_i</skos:notation>
        <tvbo:lhs>x_i</tvbo:lhs>
        <tvbo:rhs>a_i*(I_o*W_i + J_N_S_e - S_i + coupling*lamda) - b_i</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/G -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/G">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Global coupling scaling</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema1:defaultValue>
        <rdfs:label>G (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Global coupling scaling</skos:definition>
        <skos:notation>G</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/I_ext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/I_ext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External stimulation parameter for evoked potential simulated activity applied to the excitatory population firing rate IE (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>I_ext (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>External stimulation parameter for evoked potential simulated activity applied to the excitatory population firing rate IE (Deco et al., 2014).</skos:definition>
        <skos:notation>I_ext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/I_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/I_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Effective external input parameter to the excitatory E and inhibitory I population (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.382</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>I_o (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Effective external input parameter to the excitatory E and inhibitory I population (Deco et al., 2014).</skos:definition>
        <skos:notation>I_o</skos:notation>
        <tvbo:unit>nA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/J_N -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/J_N">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Excitatory synaptic coupling parameter (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.15</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>J_N (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Excitatory synaptic coupling parameter (Deco et al., 2014).</skos:definition>
        <skos:notation>J_N</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/J_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/J_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Local feedback inhibitory synaptic coupling to the excitatory population firing rate IE (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>J_i (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Local feedback inhibitory synaptic coupling to the excitatory population firing rate IE (Deco et al., 2014).</skos:definition>
        <skos:notation>J_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/W_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/W_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Excitatory population external input scaling weight</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0090394"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_2000463"/>
        <rdfs:label>W_e (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Excitatory population external input scaling weight</skos:definition>
        <skos:notation>W_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/W_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/W_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Inhibitory population external input scaling weight</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.7</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>W_i (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Inhibitory population external input scaling weight</skos:definition>
        <skos:notation>W_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/a_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/a_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Slope (or gain) parameter of the sigmoid function HE_RWW_EI (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">310.0</schema1:defaultValue>
        <rdfs:label>a_e (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Slope (or gain) parameter of the sigmoid function HE_RWW_EI (Deco et al., 2014).</skos:definition>
        <skos:notation>a_e</skos:notation>
        <tvbo:unit>per_nC</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/a_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/a_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Slope (or gain) parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">615.0</schema1:defaultValue>
        <rdfs:label>a_i (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Slope (or gain) parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al., 2014).</skos:definition>
        <skos:notation>a_i</skos:notation>
        <tvbo:unit>per_nC</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/b_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/b_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Shift parameter of the sigmoid function HE_RWW_EI of the excitatory population (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">125.0</schema1:defaultValue>
        <rdfs:label>b_e (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Shift parameter of the sigmoid function HE_RWW_EI of the excitatory population (Deco et al., 2014).</skos:definition>
        <skos:notation>b_e</skos:notation>
        <tvbo:unit>Hz</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/b_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/b_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Shift parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">177.0</schema1:defaultValue>
        <rdfs:label>b_i (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Shift parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al., 2014).</skos:definition>
        <skos:notation>b_i</skos:notation>
        <tvbo:unit>Hz</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/d_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/d_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Scaling parameter of the sigmoid function HE_RWW_EI of the excitatory population (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.16</schema1:defaultValue>
        <rdfs:label>d_e (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Scaling parameter of the sigmoid function HE_RWW_EI of the excitatory population (Deco et al., 2014).</skos:definition>
        <skos:notation>d_e</skos:notation>
        <tvbo:unit>s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/d_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/d_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Scaling parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.087</schema1:defaultValue>
        <rdfs:label>d_i (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Scaling parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al., 2014).</skos:definition>
        <skos:notation>d_i</skos:notation>
        <tvbo:unit>s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/gamma_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/gamma_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Excitatory population kinetic parameter</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.41E-4</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>gamma_e (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Excitatory population kinetic parameter</skos:definition>
        <skos:notation>gamma_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/gamma_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/gamma_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Inhibitory population kinetic parameter</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.001</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>gamma_i (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Inhibitory population kinetic parameter</skos:definition>
        <skos:notation>gamma_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/lamda -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/lamda">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Inhibitory global coupling scaling</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>lamda (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Inhibitory global coupling scaling</skos:definition>
        <skos:notation>lamda</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/tau_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/tau_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Kinetic parameter  that represents the decay times for NMDA synapses (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">100.0</schema1:defaultValue>
        <rdfs:label>tau_e (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Kinetic parameter  that represents the decay times for NMDA synapses (Deco et al., 2014). Excitatory population NMDA decay time constant.</skos:definition>
        <skos:notation>tau_e</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/tau_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/tau_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Kinetic parameter that represents the decay times for inhibitory GABA synapses (Deco et al</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0016917"/>
        <rdfs:label>tau_i (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Kinetic parameter that represents the decay times for inhibitory GABA synapses (Deco et al., 2014).</skos:definition>
        <skos:notation>tau_i</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/w_p -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/w_p">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Excitatory population recurrence weight</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.4</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>w_p (ReducedWongWangExcInh parameter)</rdfs:label>
        <skos:definition>Excitatory population recurrence weight</skos:definition>
        <skos:notation>w_p</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/state_variables/S_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/state_variables/S_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>State-variable of the Reduced WongWang_EI model (Deco et al</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>S_e (ReducedWongWangExcInh state variable)</rdfs:label>
        <skos:notation>S_e</skos:notation>
        <tvbo:lhs>Derivative(S_e, t)</tvbo:lhs>
        <tvbo:rhs>H_e*gamma_e*(1 - S_e) - S_e/tau_e</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangExcInh/state_variables/S_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangExcInh/state_variables/S_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>State-variable of the Reduced WongWang_EI model (Deco et al</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>S_i (ReducedWongWangExcInh state variable)</rdfs:label>
        <skos:notation>S_i</skos:notation>
        <tvbo:lhs>Derivative(S_i, t)</tvbo:lhs>
        <tvbo:rhs>H_i*gamma_i - S_i/tau_i</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/H_x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/H_x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Average population firing rate H evaluated at the total synaptic input x.</dcterms:description>
        <rdfs:label>H_x (ReducedWongWangTvboptim derived variable)</rdfs:label>
        <skos:notation>H_x</skos:notation>
        <tvbo:lhs>H_x</tvbo:lhs>
        <tvbo:rhs>H(x)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/derived_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Total synaptic input current combining local recurrence, external input, and network coupling (instant and delayed) scaled by J_N.</dcterms:description>
        <rdfs:label>x (ReducedWongWangTvboptim derived variable)</rdfs:label>
        <skos:notation>x</skos:notation>
        <tvbo:lhs>x</tvbo:lhs>
        <tvbo:rhs>w*J_N*S + I_o + J_N*instant + J_N*delayed</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/I_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/I_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External input current</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.34</schema1:defaultValue>
        <rdfs:label>I_o (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Effective external input current to each cortical population. Default 0.34 nA sets the system in bistability (Hansen et al., 2015). Together with w, this is a key parameter for fitting functional connectivity.</skos:definition>
        <skos:notation>I_o</skos:notation>
        <tvbo:unit>nA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/J_N -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/J_N">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>NMDA synaptic coupling strength</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2609</schema1:defaultValue>
        <rdfs:label>J_N (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>NMDA synaptic coupling strength. Scales both local recurrence and long-range network coupling inputs.</skos:definition>
        <skos:notation>J_N</skos:notation>
        <tvbo:unit>nA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Input gain parameter</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.27</schema1:defaultValue>
        <rdfs:label>a (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Input gain parameter of the sigmoid transfer function H(x).</skos:definition>
        <skos:notation>a</skos:notation>
        <tvbo:unit>per_pC</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Input shift parameter</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.108</schema1:defaultValue>
        <rdfs:label>b (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Input shift parameter of the sigmoid transfer function H(x).</skos:definition>
        <skos:notation>b</skos:notation>
        <tvbo:unit>kHz</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Scaling parameter</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">154.0</schema1:defaultValue>
        <rdfs:label>d (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Scaling parameter of the sigmoid transfer function H(x).</skos:definition>
        <skos:notation>d</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Kinetic parameter</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.641</schema1:defaultValue>
        <rdfs:label>gamma (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Kinetic parameter governing the rate of NMDA channel dynamics.</skos:definition>
        <skos:notation>gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/tau_s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/tau_s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>NMDA decay time constant</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">100.0</schema1:defaultValue>
        <rdfs:label>tau_s (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>NMDA decay time constant for the synaptic gating variable S.</skos:definition>
        <skos:notation>tau_s</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/w -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/parameters/w">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Excitatory recurrence strength (local feedback)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema1:defaultValue>
        <rdfs:label>w (ReducedWongWangTvboptim parameter)</rdfs:label>
        <skos:definition>Local excitatory recurrence strength. Controls the positive feedback within each cortical population. Higher values increase local excitation and push the system toward higher firing rates.</skos:definition>
        <skos:notation>w</skos:notation>
        <tvbo:unit>dimensionless</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedWongWangTvboptim/state_variables/S -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedWongWangTvboptim/state_variables/S">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Average NMDA synaptic gating variable, representing the fraction of open NMDA channels at each network node.</dcterms:description>
        <rdfs:label>S (ReducedWongWangTvboptim state variable)</rdfs:label>
        <skos:notation>S</skos:notation>
        <tvbo:lhs>Derivative(S, t)</tvbo:lhs>
        <tvbo:rhs>-S/tau_s + (1 - S)*H(x)*gamma</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Aik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Aik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Excitatory-to-excitatory mode-coupling matrix derived from Gaussian quadrature over N(mu, sigma); computed offline at `update_derived_parameters`.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>Aik (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>Aik</skos:notation>
        <tvbo:lhs>Aik</tvbo:lhs>
        <tvbo:rhs>0.5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Bik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Bik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Inhibitory-to-excitatory mode-coupling matrix.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>Bik (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>Bik</skos:notation>
        <tvbo:lhs>Bik</tvbo:lhs>
        <tvbo:rhs>0.5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Cik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/Cik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Excitatory-to-inhibitory mode-coupling matrix.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>Cik (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>Cik</skos:notation>
        <tvbo:lhs>Cik</tvbo:lhs>
        <tvbo:rhs>0.5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/IE_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/IE_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode constant excitatory input from the heterogeneity distribution.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>IE_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>IE_i</skos:notation>
        <tvbo:lhs>IE_i</tvbo:lhs>
        <tvbo:rhs>0.0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/II_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/II_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode constant inhibitory input from the heterogeneity distribution.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>II_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>II_i</skos:notation>
        <tvbo:lhs>II_i</tvbo:lhs>
        <tvbo:rhs>0.0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/e_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/e_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode cubic-coefficient projection for the excitatory subnetwork.</dcterms:description>
        <rdfs:label>e_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>e_i</skos:notation>
        <tvbo:lhs>e_i</tvbo:lhs>
        <tvbo:rhs>1.0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/f_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/f_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode cubic-coefficient projection for the inhibitory subnetwork.</dcterms:description>
        <rdfs:label>f_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>f_i</skos:notation>
        <tvbo:lhs>f_i</tvbo:lhs>
        <tvbo:rhs>1.0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/m_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/m_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode offset entering the eta dynamics.</dcterms:description>
        <rdfs:label>m_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>m_i</skos:notation>
        <tvbo:lhs>m_i</tvbo:lhs>
        <tvbo:rhs>a</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/n_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/derived_variables/n_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode offset entering the beta dynamics.</dcterms:description>
        <rdfs:label>n_i (StefanescuJirsa2D derived variable)</rdfs:label>
        <skos:notation>n_i</skos:notation>
        <tvbo:lhs>n_i</tvbo:lhs>
        <tvbo:rhs>a</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K11 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K11">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>K11 (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Internal coupling, excitatory to excitatory.</skos:definition>
        <skos:notation>K11</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K12 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K12">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.15</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>K12 (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Internal coupling, inhibitory to excitatory.</skos:definition>
        <skos:notation>K12</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K21 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/K21">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.15</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>K21 (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Internal coupling, excitatory to inhibitory.</skos:definition>
        <skos:notation>K21</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.45</schema1:defaultValue>
        <rdfs:label>a (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Heterogeneity scale parameter entering the m_i, n_i offsets.</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.9</schema1:defaultValue>
        <rdfs:label>b (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>FitzHugh-Nagumo recovery decay rate.</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/mu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/mu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>mu (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Mean of the Gaussian heterogeneity distribution.</skos:definition>
        <skos:notation>mu</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/sigma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/sigma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.35</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>sigma (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Standard deviation of the Gaussian heterogeneity distribution.</skos:definition>
        <skos:notation>sigma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Timescale separation</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema1:defaultValue>
        <rdfs:label>tau (StefanescuJirsa2D parameter)</rdfs:label>
        <skos:definition>Timescale separation between fast (xi, alpha) and slow (eta, beta) variables.</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Inhibitory fast variable (per mode).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>alpha (StefanescuJirsa2D state variable)</rdfs:label>
        <skos:notation>alpha</skos:notation>
        <tvbo:lhs>Derivative(alpha, t)</tvbo:lhs>
        <tvbo:rhs>tau*(alpha - f_i*alpha**3/3 - beta) + K21*(Cik*xi - alpha) + tau*(II_i + c_pop0 + local_coupling*xi)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/beta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/beta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Inhibitory slow recovery variable (per mode).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>beta (StefanescuJirsa2D state variable)</rdfs:label>
        <skos:notation>beta</skos:notation>
        <tvbo:lhs>Derivative(beta, t)</tvbo:lhs>
        <tvbo:rhs>(alpha - b*beta + n_i)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Excitatory slow recovery variable (per mode).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>eta (StefanescuJirsa2D state variable)</rdfs:label>
        <skos:notation>eta</skos:notation>
        <tvbo:lhs>Derivative(eta, t)</tvbo:lhs>
        <tvbo:rhs>(xi - b*eta + m_i)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/xi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa2D/state_variables/xi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Excitatory fast variable (per mode).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>xi (StefanescuJirsa2D state variable)</rdfs:label>
        <skos:notation>xi</skos:notation>
        <tvbo:lhs>Derivative(xi, t)</tvbo:lhs>
        <tvbo:rhs>tau*(xi - e_i*xi**3/3 - eta) + K11*(Aik*xi - xi) - K12*(Bik*alpha - xi) + tau*(IE_i + c_pop0 + local_coupling*xi)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/A_ik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/A_ik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Excitatory-to-excitatory mode-coupling matrix from Gaussian quadrature.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>A_ik (StefanescuJirsa3D derived variable)</rdfs:label>
        <skos:notation>A_ik</skos:notation>
        <tvbo:lhs>A_ik</tvbo:lhs>
        <tvbo:rhs>0.5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/B_ik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/B_ik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Inhibitory-to-excitatory mode-coupling matrix.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>B_ik (StefanescuJirsa3D derived variable)</rdfs:label>
        <skos:notation>B_ik</skos:notation>
        <tvbo:lhs>B_ik</tvbo:lhs>
        <tvbo:rhs>0.5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/C_ik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/C_ik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Excitatory-to-inhibitory mode-coupling matrix.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>C_ik (StefanescuJirsa3D derived variable)</rdfs:label>
        <skos:notation>C_ik</skos:notation>
        <tvbo:lhs>C_ik</tvbo:lhs>
        <tvbo:rhs>0.5</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/IE_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/IE_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode constant excitatory input.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>IE_i (StefanescuJirsa3D derived variable)</rdfs:label>
        <skos:notation>IE_i</skos:notation>
        <tvbo:lhs>IE_i</tvbo:lhs>
        <tvbo:rhs>0.0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/II_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/II_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode constant inhibitory input.</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>II_i (StefanescuJirsa3D derived variable)</rdfs:label>
        <skos:notation>II_i</skos:notation>
        <tvbo:lhs>II_i</tvbo:lhs>
        <tvbo:rhs>0.0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/a_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/a_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Per-mode cubic coefficient for the excitatory xi dynamics (a * &lt;V|V^3&gt;).</dcterms:description>
        <rdfs:label>a_i (StefanescuJirsa3D derived variable)</rdfs:label>
        <skos:notation>a_i</skos:notation>
        <tvbo:lhs>a_i</tvbo:lhs>
