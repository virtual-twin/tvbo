        <rdfs:label>C (LarterBreakspear parameter)</rdfs:label>
        <skos:definition>Coupling scaling factor. Strength of excitatory coupling and balance between internal and local/global coupling strength.</skos:definition>
        <skos:notation>C</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/LarterBreakspear/parameters/I_ext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/LarterBreakspear/parameters/I_ext">
