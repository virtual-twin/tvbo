        <skos:notation>h_i</skos:notation>
        <tvbo:lhs>h_i</tvbo:lhs>
        <tvbo:rhs>c</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/m_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/m_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
