    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>y3</tvbo:rhs>
