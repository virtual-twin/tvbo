        <rdfs:label>gamma_5 (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Connectivity constant (interneurons to interneurons)</skos:definition>
        <skos:notation>gamma_5</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/ke -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/ke">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Reciprocal of the time constant of passive membrane and all         other spatially distributed delays in the dendritic network [ms^-1]</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.1</schema1:defaultValue>
        <rdfs:label>ke (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Reciprocal of the time constant of passive membrane and all
        other spatially distributed delays in the dendritic network [ms^-1].
        Also called average synaptic time constant.</skos:definition>
        <skos:notation>ke</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/ki -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/ki">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Reciprocal of the time constant of passive membrane and all         other spatially distributed delays in the dendritic network [ms^-1]</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.05</schema1:defaultValue>
        <rdfs:label>ki (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Reciprocal of the time constant of passive membrane and all
        other spatially distributed delays in the dendritic network [ms^-1].
        Also called average synaptic time constant.</skos:definition>
        <skos:notation>ki</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/rho_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/rho_1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Steepness of the sigmoidal transformation [mV^-1]</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.56</schema1:defaultValue>
        <rdfs:label>rho_1 (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Steepness of the sigmoidal transformation [mV^-1].</skos:definition>
        <skos:notation>rho_1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/rho_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/rho_2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Firing threshold (PSP) for which a 50% firing rate is achieved</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.0</schema1:defaultValue>
        <rdfs:label>rho_2 (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Firing threshold (PSP) for which a 50% firing rate is achieved.
        In other words, it is the value of the average membrane potential
        corresponding to the inflection point of the sigmoid [mV]. Population mean firing threshold.</skos:definition>
        <skos:notation>rho_2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/v1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/v1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <rdfs:label>v1 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>v1</skos:notation>
        <tvbo:lhs>Derivative(v1, t)</tvbo:lhs>
        <tvbo:rhs>y1</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/v2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/v2">
