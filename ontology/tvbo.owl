    <!-- https://w3id.org/tvbo/SupHopf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/SupHopf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Dynamics"/>
        <tvbo:exhibitsBifurcation rdf:nodeID="genid2872"/>
        <tvbo:exhibitsRegime rdf:resource="https://w3id.org/tvbo/Oscillatory"/>
        <tvbo:exhibitsRegime rdf:resource="https://w3id.org/tvbo/Quiescent"/>
        <tvbo:hasAttractor rdf:resource="https://w3id.org/tvbo/FixedPoint"/>
        <tvbo:hasAttractor rdf:resource="https://w3id.org/tvbo/LimitCycle"/>
        <tvbo:hasStochasticityCharacter rdf:resource="https://w3id.org/tvbo/Deterministic"/>
        <tvbo:phaseSpaceDimension rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</tvbo:phaseSpaceDimension>
        <terms:description>Supercritical Hopf (SUPH) is an oscillatory/excitable neural mass model that describe the normal form of a supercritical Hopf bifurcation in Cartesian coordinates (Kuznetsov, 2013; Deco et al., 2017). 

This normal form has a supercritical bifurcation at &apos;a=0&apos; with &apos;a&apos; the bifurcation parameter in the model. So for &apos;a &lt; 0&apos;, the local dynamics has a stable fixed point and the system corresponds to a damped oscillatory state, whereas for &apos;a &gt; 0&apos;, the local dynamics enters in a stable limit cycle and the system switches to an oscillatory state.</terms:description>
        <terms:references rdf:resource="https://w3id.org/tvbo/studies/Deco2017"/>
        <rdfs:label>SupHopf</rdfs:label>
        <skos:prefLabel xml:lang="en">Supercritical Hopf</skos:prefLabel>
        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/SupHopf/derived_variables/lc_0"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/SupHopf/parameters/a"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/SupHopf/parameters/omega"/>
        <tvbo:hasStateVariable rdf:resource="https://w3id.org/tvbo/SupHopf/state_variables/x"/>
