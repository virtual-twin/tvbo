    <!-- https://w3id.org/tvbo/CakanObermayer/derived_variables/r_E -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/derived_variables/r_E">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>r_E</tvbo:lhs>
        <tvbo:rhs>r_max/(1 + exp(-k_phi*(mu_se - mu_th)))</tvbo:rhs>
        <terms:description>Excitatory population firing rate. In full aLN this is ``Phi(mu_E_eff, s_EE)`` with ``Phi`` precomputed; here a sigmoid stand-in is used.</terms:description>
        <rdfs:label>r_E (CakanObermayer derived variable)</rdfs:label>
        <skos:notation>r_E</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/derived_variables/r_I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/derived_variables/r_I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>r_I</tvbo:lhs>
        <tvbo:rhs>r_max/(1 + exp(-k_phi*(mu_si - mu_th)))</tvbo:rhs>
        <terms:description>Inhibitory population firing rate (sigmoid stand-in for aLN Phi).</terms:description>
        <rdfs:label>r_I (CakanObermayer derived variable)</rdfs:label>
        <skos:notation>r_I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/C -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/C">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">200.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0030322"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098696"/>
        <rdfs:label>C (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Membrane capacitance of a single AdEx neuron.</skos:definition>
        <skos:notation>C</skos:notation>
        <tvbo:unit>pF</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/E_A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/E_A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-80.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>E_A (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Reversal potential of the adaptation current.</skos:definition>
        <skos:notation>E_A</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/E_L -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/E_L">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-65.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0022840"/>
        <rdfs:label>E_L (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Leak reversal potential of a single AdEx neuron.</skos:definition>
        <skos:notation>E_L</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/I_A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/I_A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>I_A (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Subthreshold adaptation conductance amplitude (a in AdEx).</skos:definition>
        <skos:notation>I_A</skos:notation>
        <tvbo:unit>nS</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/J_EE -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/J_EE">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.43</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060076"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098817"/>
        <rdfs:label>J_EE (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Maximum excitatory-to-excitatory PSC amplitude (Jee_max in neurolib).</skos:definition>
        <skos:notation>J_EE</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/J_EI -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/J_EI">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-3.3</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J_EI (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Maximum inhibitory-to-excitatory PSC amplitude (Jei_max in neurolib, signed negative).</skos:definition>
        <skos:notation>J_EI</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/J_IE -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/J_IE">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.6</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>J_IE (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Maximum excitatory-to-inhibitory PSC amplitude (Jie_max in neurolib).</skos:definition>
        <skos:notation>J_IE</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/J_II -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/J_II">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.64</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>J_II (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Maximum inhibitory-to-inhibitory PSC amplitude (Jii_max in neurolib, signed negative).</skos:definition>
        <skos:notation>J_II</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/k_phi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/k_phi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>k_phi (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Steepness of the sigmoid transfer-function surrogate.</skos:definition>
        <skos:notation>k_phi</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/mu_E -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/mu_E">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.4</schema:defaultValue>
        <rdfs:label>mu_E (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Mean external input current to the excitatory population (mue_ext_mean).</skos:definition>
        <skos:notation>mu_E</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/mu_I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/mu_I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>mu_I (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Mean external input current to the inhibitory population (mui_ext_mean).</skos:definition>
        <skos:notation>mu_I</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/mu_th -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/mu_th">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>mu_th (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Half-maximum input of the sigmoid transfer-function surrogate.</skos:definition>
        <skos:notation>mu_th</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/r_max -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/r_max">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2</schema:defaultValue>
        <rdfs:label>r_max (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Asymptotic firing rate used in the sigmoid surrogate for the aLN transfer function (sigmoid stand-in for the precomputed lookup table).</skos:definition>
        <skos:notation>r_max</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/s_EE -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/s_EE">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>s_EE (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the E-&gt;E channel (sigmae_ext component).</skos:definition>
        <skos:notation>s_EE</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/s_EI -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/s_EI">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>s_EI (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the I-&gt;E channel.</skos:definition>
        <skos:notation>s_EI</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/s_IE -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/s_IE">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>s_IE (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the E-&gt;I channel.</skos:definition>
        <skos:notation>s_IE</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/s_II -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/s_II">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>s_II (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Standard deviation of the random-coupling-driven membrane-potential fluctuations entering the I-&gt;I channel.</skos:definition>
        <skos:notation>s_II</skos:notation>
        <tvbo:unit>mV_per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/tau_A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/tau_A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">200.0</schema:defaultValue>
        <rdfs:label>tau_A (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Time constant of the adaptation current.</skos:definition>
        <skos:notation>tau_A</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/tau_se -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/tau_se">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>tau_se (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Synaptic time constant of excitatory PSCs (E-&gt;E and E-&gt;I).</skos:definition>
        <skos:notation>tau_se</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/parameters/tau_si -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/parameters/tau_si">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>tau_si (CakanObermayer parameter)</rdfs:label>
        <skos:definition>Synaptic time constant of inhibitory PSCs (I-&gt;E and I-&gt;I).</skos:definition>
        <skos:notation>tau_si</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/state_variables/I_A_var -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/state_variables/I_A_var">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(I_A_var, t)</tvbo:lhs>
        <tvbo:rhs>(I_A*(mu_se - E_A) - I_A_var)/tau_A</tvbo:rhs>
        <terms:description>Adaptation current.</terms:description>
        <rdfs:label>I_A_var (CakanObermayer state variable)</rdfs:label>
        <skos:notation>I_A_var</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/state_variables/mu_se -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/state_variables/mu_se">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(mu_se, t)</tvbo:lhs>
        <tvbo:rhs>(J_EE*r_E + J_EI*r_I + mu_E + c_glob - I_A_var/C - mu_se)/tau_se</tvbo:rhs>
        <terms:description>Filtered mean synaptic input current to the excitatory population.</terms:description>
        <rdfs:label>mu_se (CakanObermayer state variable)</rdfs:label>
        <skos:notation>mu_se</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CakanObermayer/state_variables/mu_si -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CakanObermayer/state_variables/mu_si">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(mu_si, t)</tvbo:lhs>
        <tvbo:rhs>(J_IE*r_E + J_II*r_I + mu_I - mu_si)/tau_si</tvbo:rhs>
        <terms:description>Filtered mean synaptic input current to the inhibitory population.</terms:description>
        <rdfs:label>mu_si (CakanObermayer state variable)</rdfs:label>
        <skos:notation>mu_si</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Half-width of heterogeneous noise distribution</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema:defaultValue>
        <rdfs:label>Delta (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Parameter of the alpha-function</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.95</schema:defaultValue>
        <rdfs:label>alpha (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Parameter of the alpha-function</skos:definition>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Constant parameter to scale the rate of feedback from the             firing rate variable to itself</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">20.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>eta (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the
            firing rate variable to itself</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/k -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/k">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Local coupling strength</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>k (CoombesByrne parameter)</rdfs:label>
        <skos:definition>Local coupling strength</skos:definition>
        <skos:notation>k</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/parameters/v_syn -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/parameters/v_syn">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>QIF membrane reversal potential</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>v_syn (CoombesByrne parameter)</rdfs:label>
        <skos:definition>QIF membrane reversal potential</skos:definition>
        <skos:notation>v_syn</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>V**2 + c_glob + eta + g*(-V + v_syn) - pi**2*r**2</tvbo:rhs>
        <rdfs:label>V (CoombesByrne state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(g, t)</tvbo:lhs>
        <tvbo:rhs>alpha*q</tvbo:rhs>
        <rdfs:label>g (CoombesByrne state variable)</rdfs:label>
        <skos:notation>g</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/q -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/q">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(q, t)</tvbo:lhs>
        <tvbo:rhs>alpha*(-g + pi*k*r - 2*q)</tvbo:rhs>
        <rdfs:label>q (CoombesByrne state variable)</rdfs:label>
        <skos:notation>q</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>Delta/pi + 2*V*r - g*r</tvbo:rhs>
        <rdfs:label>r (CoombesByrne state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Half-width of heterogeneous noise distribution</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>Delta (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Constant parameter to scale the rate of feedback from the             firing rate variable to itself</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>eta (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the
            firing rate variable to itself</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/k -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/k">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Local coupling strength</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>k (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>Local coupling strength</skos:definition>
        <skos:notation>k</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/parameters/v_syn -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/parameters/v_syn">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>QIF membrane reversal potential</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-4.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>v_syn (CoombesByrne2D parameter)</rdfs:label>
        <skos:definition>QIF membrane reversal potential</skos:definition>
        <skos:notation>v_syn</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>V**2 + c_glob + eta + pi*k*r*(-V + v_syn) - pi**2*r**2</tvbo:rhs>
        <rdfs:label>V (CoombesByrne2D state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/CoombesByrne2D/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/CoombesByrne2D/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>Delta/pi + 2*V*r - pi*k*r**2</tvbo:rhs>
        <rdfs:label>r (CoombesByrne2D state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/H_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/H_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>H_e</tvbo:lhs>
        <tvbo:rhs>x_e/(1 - exp(-d_e*x_e))</tvbo:rhs>
        <terms:description>Sigmoid function that computes the averaged firing rate of the excitatory neuron population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>H_e (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>H_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/H_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/H_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>H_i</tvbo:lhs>
        <tvbo:rhs>x_i/(1 - exp(-d_i*x_i))</tvbo:rhs>
        <terms:description>Sigmoid function that computes the averaged firing rate of the inhibitory neuron population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>H_i (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>H_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/I_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/I_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>I_e</tvbo:lhs>
        <tvbo:rhs>I_ext + I_o*W_e + J_N_S_e*w_p - J_i*S_i + coupling</tvbo:rhs>
        <terms:description>Input current to the excitatory population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>I_e (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>I_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/I_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/I_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>I_i</tvbo:lhs>
        <tvbo:rhs>I_o*W_i + J_N_S_e - S_i + coupling*lamda</tvbo:rhs>
        <terms:description>Input current to the inhibitory population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>I_i (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>I_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/J_N_S_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/J_N_S_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>J_N_S_e</tvbo:lhs>
        <tvbo:rhs>J_N*S_e</tvbo:rhs>
        <rdfs:label>J_N_S_e (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>J_N_S_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/coupling -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/coupling">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>coupling</tvbo:lhs>
        <tvbo:rhs>G*J_N*(S_e*local_coupling + c_glob)</tvbo:rhs>
        <rdfs:label>coupling (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>coupling</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/x_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/x_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>x_e</tvbo:lhs>
        <tvbo:rhs>M_i*(a_e*I_e - b_e)</tvbo:rhs>
        <terms:description>Gain-scaled input current to the excitatory population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>x_e (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>x_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/x_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/derived_variables/x_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>x_i</tvbo:lhs>
        <tvbo:rhs>M_i*(a_i*I_i - b_i)</tvbo:rhs>
        <terms:description>Gain-scaled input current to the inhibitory population (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>x_i (DecoBalancedExcInh derived variable)</rdfs:label>
        <skos:notation>x_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/G -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/G">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Global coupling scaling</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>G (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Global coupling scaling</skos:definition>
        <skos:notation>G</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/I_ext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/I_ext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External stimulation parameter for evoked potential simulated activity applied to the excitatory population firing rate IE (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>I_ext (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>External stimulation parameter for evoked potential simulated activity applied to the excitatory population firing rate IE (Deco et al., 2014).</skos:definition>
        <skos:notation>I_ext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/I_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/I_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Effective external input parameter to the excitatory E and inhibitory I population (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.382</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>I_o (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Effective external input parameter to the excitatory E and inhibitory I population (Deco et al., 2014).</skos:definition>
        <skos:notation>I_o</skos:notation>
        <tvbo:unit>nA</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/J_N -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/J_N">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Excitatory synaptic coupling parameter (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.15</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>J_N (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Excitatory synaptic coupling parameter (Deco et al., 2014).</skos:definition>
        <skos:notation>J_N</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/J_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/J_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Local feedback inhibitory synaptic coupling to the excitatory population firing rate IE (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>J_i (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Local feedback inhibitory synaptic coupling to the excitatory population firing rate IE (Deco et al., 2014).</skos:definition>
        <skos:notation>J_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/M_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/M_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Effective gain within a region. Scales the excitatory and inhibitory input currents derived from the regional transcriptional landscape (Deco et al., 2021).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>M_i (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Effective gain within a region (Deco et al., 2021).</skos:definition>
        <skos:notation>M_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/W_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/W_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Excitatory population external input scaling weight</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0090394"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_2000463"/>
        <rdfs:label>W_e (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Excitatory population external input scaling weight</skos:definition>
        <skos:notation>W_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/W_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/W_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Inhibitory population external input scaling weight</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.7</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>W_i (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Inhibitory population external input scaling weight</skos:definition>
        <skos:notation>W_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/a_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/a_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Slope (or gain) parameter of the sigmoid function HE_RWW_EI (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">310.0</schema:defaultValue>
        <rdfs:label>a_e (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Slope (or gain) parameter of the sigmoid function HE_RWW_EI (Deco et al., 2014).</skos:definition>
        <skos:notation>a_e</skos:notation>
        <tvbo:unit>per_nC</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/a_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/a_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Slope (or gain) parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">615.0</schema:defaultValue>
        <rdfs:label>a_i (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Slope (or gain) parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al., 2014).</skos:definition>
        <skos:notation>a_i</skos:notation>
        <tvbo:unit>per_nC</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/b_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/b_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Shift parameter of the sigmoid function HE_RWW_EI of the excitatory population (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">125.0</schema:defaultValue>
        <rdfs:label>b_e (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Shift parameter of the sigmoid function HE_RWW_EI of the excitatory population (Deco et al., 2014).</skos:definition>
        <skos:notation>b_e</skos:notation>
        <tvbo:unit>Hz</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/b_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/b_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Shift parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">177.0</schema:defaultValue>
        <rdfs:label>b_i (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Shift parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al., 2014).</skos:definition>
        <skos:notation>b_i</skos:notation>
        <tvbo:unit>Hz</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/d_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/d_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Scaling parameter of the sigmoid function HE_RWW_EI of the excitatory population (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.16</schema:defaultValue>
        <rdfs:label>d_e (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Scaling parameter of the sigmoid function HE_RWW_EI of the excitatory population (Deco et al., 2014).</skos:definition>
        <skos:notation>d_e</skos:notation>
        <tvbo:unit>s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/d_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/d_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Scaling parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.087</schema:defaultValue>
        <rdfs:label>d_i (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Scaling parameter of the sigmoid function HI_RWW_EI of the inhibitory population (Deco et al., 2014).</skos:definition>
        <skos:notation>d_i</skos:notation>
        <tvbo:unit>s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/gamma_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/gamma_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Excitatory population kinetic parameter</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.41E-4</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>gamma_e (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Excitatory population kinetic parameter</skos:definition>
        <skos:notation>gamma_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/gamma_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/gamma_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Inhibitory population kinetic parameter</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.001</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>gamma_i (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Inhibitory population kinetic parameter</skos:definition>
        <skos:notation>gamma_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/lamda -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/lamda">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Inhibitory global coupling scaling</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>lamda (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Inhibitory global coupling scaling</skos:definition>
        <skos:notation>lamda</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/tau_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/tau_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Kinetic parameter  that represents the decay times for NMDA synapses (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">100.0</schema:defaultValue>
        <rdfs:label>tau_e (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Kinetic parameter  that represents the decay times for NMDA synapses (Deco et al., 2014). Excitatory population NMDA decay time constant.</skos:definition>
        <skos:notation>tau_e</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/tau_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/tau_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Kinetic parameter that represents the decay times for inhibitory GABA synapses (Deco et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0016917"/>
        <rdfs:label>tau_i (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Kinetic parameter that represents the decay times for inhibitory GABA synapses (Deco et al., 2014).</skos:definition>
        <skos:notation>tau_i</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/parameters/w_p -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/parameters/w_p">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Excitatory population recurrence weight</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.4</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>w_p (DecoBalancedExcInh parameter)</rdfs:label>
        <skos:definition>Excitatory population recurrence weight</skos:definition>
        <skos:notation>w_p</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/state_variables/S_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/state_variables/S_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(S_e, t)</tvbo:lhs>
        <tvbo:rhs>H_e*gamma_e*(1 - S_e) - S_e/tau_e</tvbo:rhs>
        <terms:description>Excitatory population synaptic gating state-variable of the Deco Balanced Exc-Inh model (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>S_e (DecoBalancedExcInh state variable)</rdfs:label>
        <skos:notation>S_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DecoBalancedExcInh/state_variables/S_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DecoBalancedExcInh/state_variables/S_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(S_i, t)</tvbo:lhs>
        <tvbo:rhs>H_i*gamma_i - S_i/tau_i</tvbo:rhs>
        <terms:description>Inhibitory population synaptic gating state-variable of the Deco Balanced Exc-Inh model (Deco et al., 2021).</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>S_i (DecoBalancedExcInh state variable)</rdfs:label>
        <skos:notation>S_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/Delta_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/Delta_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Half-width of heterogeneous noise distribution over excitatory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>Delta_e (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution over excitatory population</skos:definition>
        <skos:notation>Delta_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/Delta_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/Delta_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Half-width of heterogeneous noise distribution over inhibitory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0032228"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>Delta_i (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution over inhibitory population</skos:definition>
        <skos:notation>Delta_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/Gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/Gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Ratio of excitatory VS inhibitory global couplings G_ie/G_ee </terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>Gamma (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Ratio of excitatory VS inhibitory global couplings G_ie/G_ee .</skos:definition>
        <skos:notation>Gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/I_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/I_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External homogeneous current on excitatory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>I_e (DumontGutkin parameter)</rdfs:label>
        <skos:definition>External homogeneous current on excitatory population</skos:definition>
        <skos:notation>I_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/I_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/I_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External current on inhibitory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098828"/>
        <rdfs:label>I_i (DumontGutkin parameter)</rdfs:label>
        <skos:definition>External current on inhibitory population</skos:definition>
        <skos:notation>I_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/J_ee -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/J_ee">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Synaptic weight e--&gt;e</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060076"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J_ee (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic weight e--&gt;e</skos:definition>
        <skos:notation>J_ee</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/J_ei -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/J_ei">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Synaptic weight i--&gt;e</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <rdfs:label>J_ei (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic weight i--&gt;e</skos:definition>
        <skos:notation>J_ei</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/J_ie -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/J_ie">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Synaptic weight e--&gt;i</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J_ie (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic weight e--&gt;i</skos:definition>
        <skos:notation>J_ie</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/J_ii -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/J_ii">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Synaptic weight i--&gt;i</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">15.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060077"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0097060"/>
        <rdfs:label>J_ii (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic weight i--&gt;i</skos:definition>
        <skos:notation>J_ii</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/eta_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/eta_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Mean heterogeneous current on excitatory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-5.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098815"/>
        <rdfs:label>eta_e (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Mean heterogeneous current on excitatory population</skos:definition>
        <skos:notation>eta_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/eta_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/eta_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Mean heterogeneous current on inhibitory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-5.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>eta_i (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Mean heterogeneous current on inhibitory population</skos:definition>
        <skos:notation>eta_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/tau_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/tau_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Characteristic time of excitatory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0043179"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>tau_e (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Characteristic time of excitatory population</skos:definition>
        <skos:notation>tau_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/tau_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/tau_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Characteristic time of inhibitory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0043180"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>tau_i (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Characteristic time of inhibitory population</skos:definition>
        <skos:notation>tau_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/parameters/tau_s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/parameters/tau_s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Synaptic time constant</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>tau_s (DumontGutkin parameter)</rdfs:label>
        <skos:definition>Synaptic time constant</skos:definition>
        <skos:notation>tau_s</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/V_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/V_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V_e, t)</tvbo:lhs>
        <tvbo:rhs>(I_e + V_e**2 + eta_e - pi**2*r_e**2*tau_e**2 + s_ee*tau_e - s_ei*tau_e)/tau_e</tvbo:rhs>
        <rdfs:label>V_e (DumontGutkin state variable)</rdfs:label>
        <skos:notation>V_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/V_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/V_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V_i, t)</tvbo:lhs>
        <tvbo:rhs>(I_i + V_i**2 + eta_i - pi**2*r_i**2*tau_i**2 + s_ie*tau_i - s_ii*tau_i)/tau_i</tvbo:rhs>
        <rdfs:label>V_i (DumontGutkin state variable)</rdfs:label>
        <skos:notation>V_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/r_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/r_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(r_e, t)</tvbo:lhs>
        <tvbo:rhs>(Delta_e/(pi*tau_e) + 2*V_e*r_e)/tau_e</tvbo:rhs>
        <rdfs:label>r_e (DumontGutkin state variable)</rdfs:label>
        <skos:notation>r_e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/r_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/r_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(r_i, t)</tvbo:lhs>
        <tvbo:rhs>(Delta_i/(pi*tau_i) + 2*V_i*r_i)/tau_i</tvbo:rhs>
        <rdfs:label>r_i (DumontGutkin state variable)</rdfs:label>
        <skos:notation>r_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ee -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ee">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(s_ee, t)</tvbo:lhs>
        <tvbo:rhs>(J_ee*r_e + c_glob - s_ee)/tau_s</tvbo:rhs>
        <rdfs:label>s_ee (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ee</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ei -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ei">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(s_ei, t)</tvbo:lhs>
        <tvbo:rhs>(J_ei*r_i - s_ei)/tau_s</tvbo:rhs>
        <rdfs:label>s_ei (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ei</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ie -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ie">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(s_ie, t)</tvbo:lhs>
        <tvbo:rhs>(Gamma*c_glob + J_ie*r_e - s_ie)/tau_s</tvbo:rhs>
        <rdfs:label>s_ie (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ie</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/DumontGutkin/state_variables/s_ii -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/DumontGutkin/state_variables/s_ii">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(s_ii, t)</tvbo:lhs>
        <tvbo:rhs>(J_ii*r_i - s_ii)/tau_s</tvbo:rhs>
        <rdfs:label>s_ii (DumontGutkin state variable)</rdfs:label>
        <skos:notation>s_ii</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/derived_variables/Iext_total -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/derived_variables/Iext_total">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Iext_total</tvbo:lhs>
        <tvbo:rhs>Iext + local_coupling*x1</tvbo:rhs>
        <terms:description>External input to the first population including local coupling input on x1.</terms:description>
        <rdfs:label>Iext_total (Epileptor derived variable)</rdfs:label>
        <skos:notation>Iext_total</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/derived_variables/f1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/derived_variables/f1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>f1</tvbo:lhs>
        <tvbo:rhs>Piecewise((-a*x1**2 + b*x1, x1 &lt; 0), (slope - x2 + 0.6*(z - 4.0)**2, True))</tvbo:rhs>
        <terms:description>Nonlinear function in the first state variable x1, piecewise on the sign of x1.</terms:description>
        <rdfs:label>f1 (Epileptor derived variable)</rdfs:label>
        <skos:notation>f1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/derived_variables/f2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/derived_variables/f2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>f2</tvbo:lhs>
        <tvbo:rhs>Piecewise((0, x2 &lt; -0.25), (aa*(x2 + 0.25), True))</tvbo:rhs>
        <terms:description>Nonlinear function in the fifth state variable y2, piecewise on the value of x2.</terms:description>
        <rdfs:label>f2 (Epileptor derived variable)</rdfs:label>
        <skos:notation>f2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/derived_variables/h -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/derived_variables/h">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>h</tvbo:lhs>
        <tvbo:rhs>Piecewise((x0 + 3/(1 + exp(-(x1 + 0.5)/0.1)), modification &gt; 0), (4*(x1 - x0) + Piecewise((-0.1*z**7, z &lt; 0), (0, True)), True))</tvbo:rhs>
        <terms:description>Permittivity drive for z: sigmoidal when modification&gt;0, else linear (Piecewise on modification).</terms:description>
        <rdfs:label>h (Epileptor derived variable)</rdfs:label>
        <skos:notation>h</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/derived_variables/lfp -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/derived_variables/lfp">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>lfp</tvbo:lhs>
        <tvbo:rhs>x2 - x1</tvbo:rhs>
        <terms:description>Local field potential proxy: TVB Epileptor observable x2 - x1.</terms:description>
        <rdfs:label>lfp (Epileptor derived variable)</rdfs:label>
        <skos:notation>lfp</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/Iext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/Iext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the first population.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.1</schema:defaultValue>
        <rdfs:label>Iext (Epileptor parameter)</rdfs:label>
        <skos:definition>External input current to the first population.</skos:definition>
        <skos:notation>Iext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/Iext2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/Iext2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the second population.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.45</schema:defaultValue>
        <rdfs:label>Iext2 (Epileptor parameter)</rdfs:label>
        <skos:definition>External input current to the second population.</skos:definition>
        <skos:notation>Iext2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/Kf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/Kf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling scaling on a fast time scale.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kf (Epileptor parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a fast time scale.</skos:definition>
        <skos:notation>Kf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Permittivity coupling, that is from the fast time scale toward the slow time scale.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Ks (Epileptor parameter)</rdfs:label>
        <skos:definition>Permittivity coupling, from the fast time scale toward the slow time scale.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/Kvf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/Kvf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling scaling on a very fast time scale.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kvf (Epileptor parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a very fast time scale.</skos:definition>
        <skos:notation>Kvf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the cubic term in the first state variable x1.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>a (Epileptor parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the first state variable.</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/aa -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/aa">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the fifth state variable y2.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.0</schema:defaultValue>
        <rdfs:label>aa (Epileptor parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the fifth state variable.</skos:definition>
        <skos:notation>aa</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the first state variable x1.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>b (Epileptor parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state variable.</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/bb -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/bb">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient of lowpass excitatory coupling in the fourth state variable x2.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>bb (Epileptor parameter)</rdfs:label>
        <skos:definition>Linear coefficient of lowpass excitatory coupling in the fourth state variable.</skos:definition>
        <skos:notation>bb</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Additive coefficient for the second state variable y1, called y0 in the Jirsa et al. (2014) paper.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>c (Epileptor parameter)</rdfs:label>
        <skos:definition>Additive coefficient for the second state variable.</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the second state variable y1.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>d (Epileptor parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the second state variable.</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Switch between linear (0/False) and sigmoidal (&gt;0/True) z-drive h.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>modification (Epileptor parameter)</rdfs:label>
        <skos:definition>Selects the permittivity-drive form: &gt;0 (True) uses the sigmoidal influence on z, default 0 (False) the linear influence.</skos:definition>
        <skos:notation>modification</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling in the third state variable z, called 1/tau0 in the Jirsa et al. (2014) paper.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.5E-4</schema:defaultValue>
        <rdfs:label>r (Epileptor parameter)</rdfs:label>
        <skos:definition>Temporal scaling in the third state variable.</skos:definition>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the third state variable z.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.0</schema:defaultValue>
        <rdfs:label>s (Epileptor parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the third state variable.</skos:definition>
        <skos:notation>s</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/slope -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/slope">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the first state variable x1.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>slope (Epileptor parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the first state variable.</skos:definition>
        <skos:notation>slope</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling coefficient in the fifth state variable y2.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <rdfs:label>tau (Epileptor parameter)</rdfs:label>
        <skos:definition>Temporal scaling coefficient in the fifth state variable.</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/tt -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/tt">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Time scaling of the whole system.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tt (Epileptor parameter)</rdfs:label>
        <skos:definition>Time scaling of the whole system.</skos:definition>
        <skos:notation>tt</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/parameters/x0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/parameters/x0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Epileptogenicity parameter.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema:defaultValue>
        <rdfs:label>x0 (Epileptor parameter)</rdfs:label>
        <skos:definition>Epileptogenicity parameter.</skos:definition>
        <skos:notation>x0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(g, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-0.01*(g - 0.1*x1))</tvbo:rhs>
        <terms:description>Lowpass-filtered excitatory coupling variable.</terms:description>
        <rdfs:label>g (Epileptor state variable)</rdfs:label>
        <skos:notation>g</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(y1 - z + Iext_total + Kvf*c_glob0 + f1*x1)</tvbo:rhs>
        <terms:description>First state variable of the first (fast) population.</terms:description>
        <rdfs:label>x1 (Epileptor state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/x2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/x2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-y2 + x2 - x2**3 + Iext2 + bb*g - 0.3*(z - 3.5) + Kf*c_glob1)</tvbo:rhs>
        <terms:description>First state variable of the second (slow) population.</terms:description>
        <rdfs:label>x2 (Epileptor state variable)</rdfs:label>
        <skos:notation>x2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(c - d*x1**2 - y1)</tvbo:rhs>
        <terms:description>Second state variable of the first (fast) population.</terms:description>
        <rdfs:label>y1 (Epileptor state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-y2 + f2)/tau</tvbo:rhs>
        <terms:description>Second state variable of the second (slow) population.</terms:description>
        <rdfs:label>y2 (Epileptor state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>tt*r*(h - z + Ks*c_glob0)</tvbo:rhs>
        <terms:description>Slow permittivity (energy) state variable.</terms:description>
        <rdfs:label>z (Epileptor state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/derived_variables/h -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/derived_variables/h">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>h</tvbo:lhs>
        <tvbo:rhs>Piecewise((x0 + 3.0/(exp((-x1 - 1*0.5)/0.1) + 1.0), modification &gt; 0), (zcond + 4*(-x0 + x1), True))</tvbo:rhs>
        <rdfs:label>h (Epileptor2D derived variable)</rdfs:label>
        <skos:notation>h</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/derived_variables/x1cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/derived_variables/x1cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>x1cond</tvbo:lhs>
        <tvbo:rhs>Piecewise((a*x1**2 + x1*(-b + d), x1 &lt; 0), (d*x1 - slope - 0.6*(z - 4.0)**2, True))</tvbo:rhs>
        <rdfs:label>x1cond (Epileptor2D derived variable)</rdfs:label>
        <skos:notation>x1cond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/derived_variables/zcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/derived_variables/zcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>zcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((-0.1*z**7, z &lt; 0), (0, True))</tvbo:rhs>
        <rdfs:label>zcond (Epileptor2D derived variable)</rdfs:label>
        <skos:notation>zcond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/Iext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/Iext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.1</schema:defaultValue>
        <rdfs:label>Iext (Epileptor2D parameter)</rdfs:label>
        <skos:definition>External input current to the first state-variable x_E2D, in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>Iext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Ks (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Permittivity coupling on the slow permittivity state-variable z_E2D in Epileptor2D (Proix et al., 2014).

The coupling quantifies the influence of neuronal fast discharges x_E2D on the local slow permittivity variable z_E2D.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/Kvf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/Kvf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling scaling on a very fast time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kvf (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a very fast time scale.</skos:definition>
        <skos:notation>Kvf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the cubic term in the first state-variable x_E2D via the function f(x)_E2D, in Epileptor2D Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>a (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the first state-variable x_E2D via the function f(x)_E2D, in Epileptor2D Proix et al.,2014).</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>b (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Additive coefficient for the second state-variable x_{2},         called :math:`y_{0}` in Jirsa paper</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>c (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Additive coefficient for the second state-variable x_{2},         called :math:`y_{0}` in Jirsa paper.</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the first state-variable x_E2D via the function f in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>d (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state-variable x_E2D via the function f in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>When modification is True, the function h_E2D uses a nonlinear influence on z_E2D</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>modification (Epileptor2D parameter)</rdfs:label>
        <skos:definition>When modification is True, the function h_E2D uses a nonlinear influence on z_E2D. The default value is False, i.e., linear influence on z_E2D.</skos:definition>
        <skos:notation>modification</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling in the slow state-variable, \         called :math:`1\tau_{0}` in Jirsa paper (see class Epileptor)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.5E-4</schema:defaultValue>
        <rdfs:label>r (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Temporal scaling in the slow state-variable, \
        called :math:`1\tau_{0}` in Jirsa paper (see class Epileptor).</skos:definition>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/slope -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/slope">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>slope (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the first state-variable x_E2D via the function f_E2D, in Epileptor2D (Proix et al.,2014).</skos:definition>
        <skos:notation>slope</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/tt -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/tt">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Characteristic time scale of the whole-system Epileptor2D</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tt (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Characteristic time scale of the whole-system Epileptor2D.</skos:definition>
        <skos:notation>tt</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/parameters/x0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/parameters/x0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Degree of excitability or epileptogenicity in Epileptor2D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0043179"/>
        <rdfs:label>x0 (Epileptor2D parameter)</rdfs:label>
        <skos:definition>Degree of excitability or epileptogenicity in Epileptor2D (Proix et al.,2014).

If x0 is greater than a critical value, x0,critic = −2.05 (i.e., in the supercritical regime), the system can trigger seizures autonomously; otherwise it is in its equilibrium state (i.e., in the subcritical regime).

Note:
- If modification_E2D:
if x0 is smaller than a critical value, x0,critic = 2.91, can trigger seizures autonomously; otherwise it is in its equilibrium state (Proix et al., 2014).</skos:definition>
        <skos:notation>x0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext + Kvf*c_glob + c + local_coupling*x1 - x1*x1cond - z)</tvbo:rhs>
        <terms:description>First state-variable in the Epileptor2D (Proix et al</terms:description>
        <rdfs:label>x1 (Epileptor2D state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor2D/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>r*tt*(Ks*c_glob + h - z)</tvbo:rhs>
        <terms:description>Slow permittivity state-variable of the Epileptor2D (Proix et al</terms:description>
        <rdfs:label>z (Epileptor2D state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/N -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/N">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>N (Epileptor3DStefanescuMcDonald parameter)</rdfs:label>
        <skos:definition>Effective population size / scaling of the resting-state regulation term.</skos:definition>
        <skos:notation>N</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/tau_z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/tau_z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2857.0</schema:defaultValue>
        <rdfs:label>tau_z (Epileptor3DStefanescuMcDonald parameter)</rdfs:label>
        <skos:definition>Slow timescale for the z permittivity variable.</skos:definition>
        <skos:notation>tau_z</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/x_0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/parameters/x_0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema:defaultValue>
        <rdfs:label>x_0 (Epileptor3DStefanescuMcDonald parameter)</rdfs:label>
        <skos:definition>Excitability parameter (Epileptor convention).</skos:definition>
        <skos:notation>x_0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>N*(x1 - x1**3/3 - z + c_glob)</tvbo:rhs>
        <terms:description>Fast excitable variable (placeholder Epileptor-like dynamics).</terms:description>
        <rdfs:label>x1 (Epileptor3DStefanescuMcDonald state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor3DStefanescuMcDonald/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>(4*(x1 - x_0) - z)/tau_z</tvbo:rhs>
        <terms:description>Slow permittivity / excitability variable.</terms:description>
        <rdfs:label>z (Epileptor3DStefanescuMcDonald state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/h -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/h">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>h</tvbo:lhs>
        <tvbo:rhs>Piecewise((x0 + 3/(exp((-x1 - 1*0.5)/0.1) + 1), modification &gt; 0), (zcond + 4*(-x0 + x1), True))</tvbo:rhs>
        <rdfs:label>h (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>h</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/x1cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/x1cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>x1cond</tvbo:lhs>
        <tvbo:rhs>Piecewise(((-a)*x1**2 + b*x1, x1 &lt; 0), (slope - x2 + 0.6*(z - 4.0)**2, True))</tvbo:rhs>
        <rdfs:label>x1cond (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>x1cond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/y2cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/y2cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>y2cond</tvbo:lhs>
        <tvbo:rhs>Piecewise((0.0, x2 &lt; -0.25), (aa*(x2 + 0.25), True))</tvbo:rhs>
        <rdfs:label>y2cond (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>y2cond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/derived_variables/zcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/derived_variables/zcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>zcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((-0.1*z**7, z &lt; 0), (0.0, True))</tvbo:rhs>
        <rdfs:label>zcond (Epileptor5D derived variable)</rdfs:label>
        <skos:notation>zcond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Iext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Iext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the first sub-population (x1_E5D, y1_E5D) via the state-variable x1_E5D, in Epileptor5D (Jirsa et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.1</schema:defaultValue>
        <rdfs:label>Iext (Epileptor5D parameter)</rdfs:label>
        <skos:definition>External input current to the first sub-population (x1_E5D, y1_E5D) via the state-variable x1_E5D, in Epileptor5D (Jirsa et al.,2014).</skos:definition>
        <skos:notation>Iext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Iext2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Iext2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the second population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.45</schema:defaultValue>
        <rdfs:label>Iext2 (Epileptor5D parameter)</rdfs:label>
        <skos:definition>External input current to the second population</skos:definition>
        <skos:notation>Iext2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Kf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Kf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Correspond to the coupling scaling on a fast time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kf (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Correspond to the coupling scaling on a fast time scale.</skos:definition>
        <skos:notation>Kf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Permittivity coupling on the slow permittivity state-variable z_E5D in Epileptor5D (Proix et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Ks (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Permittivity coupling on the slow permittivity state-variable z_E5D in Epileptor5D (Proix et al., 2014).

The coupling quantifies the influence of neuronal fast discharges x1_E5D on the local slow permittivity variable z_E5D.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/Kvf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/Kvf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling scaling on a very fast time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kvf (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a very fast time scale.</skos:definition>
        <skos:notation>Kvf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the cubic term in the first state variable</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>a (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the first state variable</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/aa -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/aa">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in fifth state variable</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.0</schema:defaultValue>
        <rdfs:label>aa (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in fifth state variable</skos:definition>
        <skos:notation>aa</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the first state variabel</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>b (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state variabel</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/bb -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/bb">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient of lowpass excitatory coupling in fourth state variable</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>bb (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient of lowpass excitatory coupling in fourth state variable</skos:definition>
        <skos:notation>bb</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Additive coefficient for the second state variable,         called :math:`y_{0}` in Jirsa paper</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>c (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Additive coefficient for the second state variable,         called :math:`y_{0}` in Jirsa paper</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the derivative of the second state-variable y1_E5D in Epileptor5D (Jirsa et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>d (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the derivative of the second state-variable y1_E5D in Epileptor5D (Jirsa et al.,2014).</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>When modification is True, the function h_E5D uses a nonlinear influence on z_E5D</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>modification (Epileptor5D parameter)</rdfs:label>
        <skos:definition>When modification is True, the function h_E5D uses a nonlinear influence on z_E5D. The default value is False, i.e., linear influence on z_E5D.</skos:definition>
        <skos:notation>modification</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling in the third state variable,         called :math:`1/\tau_{0}` in Jirsa paper</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.5E-4</schema:defaultValue>
        <rdfs:label>r (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Temporal scaling in the third state variable,         called :math:`1/\tau_{0}` in Jirsa paper</skos:definition>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the slow permittivity state-variable z_E5D in Epileptor5D (Jirsa et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.0</schema:defaultValue>
        <rdfs:label>s (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the slow permittivity state-variable z_E5D in Epileptor5D (Jirsa et al.,2014).</skos:definition>
        <skos:notation>s</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/slope -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/slope">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the first state variable</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>slope (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the first state variable</skos:definition>
        <skos:notation>slope</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling coefficient in fifth state variable</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <rdfs:label>tau (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Temporal scaling coefficient in fifth state variable</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/tt -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/tt">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Characteristic time scale of the whole-system Epileptor5D</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tt (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Characteristic time scale of the whole-system Epileptor5D.</skos:definition>
        <skos:notation>tt</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/parameters/x0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/parameters/x0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Epileptogenicity Parameter</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>x0 (Epileptor5D parameter)</rdfs:label>
        <skos:definition>Epileptogenicity Parameter. Degree of excitability or epileptogenicity in Epileptor5D (Jirsa et al.,2014).

If x0 is greater than a critical value, x0,critic = −2.05, the system can trigger seizures autonomously; otherwise it is in its equilibrium state.

Note:
- If modification_E5D:
if x0 is smaller than a critical value, x0,critic = 2.91, can trigger seizures autonomously; otherwise it is in its equilibrium state (Proix et al., 2014).</skos:definition>
        <skos:notation>x0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(g, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-0.01*g + 0.001*x1)</tvbo:rhs>
        <terms:description>g_E5D is a low-pass filtered excitatory coupling function from sub-population (x1_E5D, y1_E5D) to (x2_E5D, y2_E5D) in Epileptor5D (Jirsa et al</terms:description>
        <rdfs:label>g (Epileptor5D state variable)</rdfs:label>
        <skos:notation>g</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext + Kvf*c_glob0 + local_coupling*x1 + x1*x1cond + y1 - z)</tvbo:rhs>
        <terms:description>First state-variable of the first Epileptor5D population (Jirsa et al</terms:description>
        <rdfs:label>x1 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/x2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/x2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext2 + Kf*c_glob1 + bb*g - x2**3 + x2 - y2 - 0.3*z + 1.05)</tvbo:rhs>
        <terms:description>First state-variable of the second Epileptor5D sub-population (Jirsa et al</terms:description>
        <rdfs:label>x2 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>x2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(c - d*x1**2 - y1)</tvbo:rhs>
        <terms:description>Second state-variable of the first Epileptor5D sub-population (Jirsa et al</terms:description>
        <rdfs:label>y1 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-y2 + y2cond)/tau</tvbo:rhs>
        <terms:description>Second state-variable of the second Epileptor5D population (Jirsa et al</terms:description>
        <rdfs:label>y2 (Epileptor5D state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Epileptor5D/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor5D/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>r*tt*(Ks*c_glob0 + h - z)</tvbo:rhs>
        <terms:description>Slow permittivity state-variable of the Epileptor5D (Jirsa et al</terms:description>
        <rdfs:label>z (Epileptor5D state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E0</tvbo:lhs>
        <tvbo:rhs>mu2_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)</tvbo:rhs>
        <terms:description>First component of the unit vector E parametrising the great arc (A/||A|| with A = [mu2_start, -mu1_start, nu_start]).</terms:description>
        <rdfs:label>E0 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>E0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E1</tvbo:lhs>
        <tvbo:rhs>-mu1_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)</tvbo:rhs>
        <terms:description>Second component of the unit vector E parametrising the great arc.</terms:description>
        <rdfs:label>E1 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>E1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/E2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E2</tvbo:lhs>
        <tvbo:rhs>nu_start/sqrt(mu1_start**2 + mu2_start**2 + nu_start**2)</tvbo:rhs>
        <terms:description>Third component of the unit vector E parametrising the great arc.</terms:description>
        <rdfs:label>E2 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>E2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F0</tvbo:lhs>
        <tvbo:rhs>(mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)</tvbo:rhs>
        <terms:description>First component of the unit vector F parametrising the great arc (normalised ((A x B) x A) with B = [mu2_stop, -mu1_stop, nu_stop]).</terms:description>
        <rdfs:label>F0 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>F0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F1</tvbo:lhs>
        <tvbo:rhs>(mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)</tvbo:rhs>
        <terms:description>Second component of the unit vector F parametrising the great arc.</terms:description>
        <rdfs:label>F1 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>F1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/F2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F2</tvbo:lhs>
        <tvbo:rhs>(-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))/sqrt((mu1_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) + nu_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (-mu1_start*(-mu1_start*nu_stop + mu1_stop*nu_start) - mu2_start*(-mu2_start*nu_stop + mu2_stop*nu_start))**2 + (mu2_start*(mu1_start*mu2_stop - mu1_stop*mu2_start) - nu_start*(-mu1_start*nu_stop + mu1_stop*nu_start))**2)</tvbo:rhs>
        <terms:description>Third component of the unit vector F parametrising the great arc.</terms:description>
        <rdfs:label>F2 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>F2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>cardano_a</tvbo:lhs>
        <tvbo:rhs>mu1/2</tvbo:rhs>
        <terms:description>Half of mu1 (the Cardano coefficient mu1/2 for the depressed cubic xs**3 - mu2*xs - mu1 = 0).</terms:description>
        <rdfs:label>cardano_a (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>cardano_a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/cardano_d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>cardano_d</tvbo:lhs>
        <tvbo:rhs>mu1**2/4 - mu2**3/27</tvbo:rhs>
        <terms:description>Cardano discriminant mu1**2/4 - mu2**3/27 for the cubic xs**3 - mu2*xs - mu1 = 0.</terms:description>
        <rdfs:label>cardano_d (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>cardano_d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu1</tvbo:lhs>
        <tvbo:rhs>-R*(E1*cos(z) + F1*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter mu1 along the great arc as a function of the slow variable z.</terms:description>
        <rdfs:label>mu1 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>mu1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/mu2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu2</tvbo:lhs>
        <tvbo:rhs>R*(E0*cos(z) + F0*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter mu2 along the great arc as a function of the slow variable z.</terms:description>
        <rdfs:label>mu2 (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>mu2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/nu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/nu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>nu</tvbo:lhs>
        <tvbo:rhs>R*(E2*cos(z) + F2*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter nu along the great arc as a function of the slow variable z.</terms:description>
        <rdfs:label>nu (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>nu</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/derived_variables/xs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/derived_variables/xs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>xs</tvbo:lhs>
        <tvbo:rhs>Piecewise((2*(cardano_a**2 - cardano_d)**(1/6)*cos(atan2(sqrt(-cardano_d), cardano_a)/3), cardano_d &lt; 0), (Piecewise(((cardano_a + sqrt(cardano_d))**(1/3), (cardano_a + sqrt(cardano_d)) &gt;= 0), (Abs(cardano_a + sqrt(cardano_d))**(1/3)/2, True)) + Piecewise(((cardano_a - sqrt(cardano_d))**(1/3), (cardano_a - sqrt(cardano_d)) &gt;= 0), (Abs(cardano_a - sqrt(cardano_d))**(1/3)/2, True)), True))</tvbo:rhs>
        <terms:description>The x-coordinate of the resting state (branch N=1), the real part of the Cardano root of xs**3 - mu2*xs - mu1 = 0, reproducing TVB&apos;s principal-branch complex cube root. For negative discriminant (three real roots) the trigonometric form is used; for non-negative discriminant the principal-branch real cube root sum is used (a real cube root for non-negative argument, half the real cube root of the magnitude for negative argument).</terms:description>
        <rdfs:label>xs (EpileptorCodim3 derived variable)</rdfs:label>
        <skos:notation>xs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Slow permittivity coupling strength, the default of zero is no coupling.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Ks (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>Slow permittivity coupling strength.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/R -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/R">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Radius in the unfolding sphere on which the great arc connecting onset and offset points lies.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.4</schema:defaultValue>
        <rdfs:label>R (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>Radius in unfolding.</skos:definition>
        <skos:notation>R</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Unfolding type of the degenerate Takens-Bogdanov bifurcation, default is a focus type.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>b (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>Unfolding type of the degenerate Takens-Bogdanov bifurcation.</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Speed of the slow variable z.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.001</schema:defaultValue>
        <rdfs:label>c (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>Speed of the slow variable.</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/dstar -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/dstar">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Threshold for the inversion of the slow variable z.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3</schema:defaultValue>
        <rdfs:label>dstar (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>Threshold for the inversion of the slow variable.</skos:definition>
        <skos:notation>dstar</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Toggle the +0.1*(z-0.5)^7 stabilising term in z_dot: &gt;0 (True, default) includes it, 0 (False) omits it.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>modification (EpileptorCodim3 parameter)</rdfs:label>
        <skos:notation>modification</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/mu1_start -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/mu1_start">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu1 at the offset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-0.02285</schema:defaultValue>
        <rdfs:label>mu1_start (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter mu1 at the offset point for the given class.</skos:definition>
        <skos:notation>mu1_start</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/mu1_stop -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/mu1_stop">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu1 at the onset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-0.07465</schema:defaultValue>
        <rdfs:label>mu1_stop (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter mu1 at the onset point for the given class.</skos:definition>
        <skos:notation>mu1_stop</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/mu2_start -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/mu2_start">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu2 at the offset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3448</schema:defaultValue>
        <rdfs:label>mu2_start (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter mu2 at the offset point for the given class.</skos:definition>
        <skos:notation>mu2_start</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/mu2_stop -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/mu2_stop">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu2 at the onset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3351</schema:defaultValue>
        <rdfs:label>mu2_stop (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter mu2 at the onset point for the given class.</skos:definition>
        <skos:notation>mu2_stop</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/nu_start -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/nu_start">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter nu at the offset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2014</schema:defaultValue>
        <rdfs:label>nu_start (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter nu at the offset point for the given class.</skos:definition>
        <skos:notation>nu_start</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/parameters/nu_stop -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/parameters/nu_stop">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter nu at the onset point for the given class, default for class c2s (Saddle-Node at onset and Saddle-Homoclinic at offset).</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2053</schema:defaultValue>
        <rdfs:label>nu_stop (EpileptorCodim3 parameter)</rdfs:label>
        <skos:definition>The bifurcation parameter nu at the onset point for the given class.</skos:definition>
        <skos:notation>nu_stop</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/state_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/state_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x, t)</tvbo:lhs>
        <tvbo:rhs>-y</tvbo:rhs>
        <terms:description>Fast subsystem variable x.</terms:description>
        <rdfs:label>x (EpileptorCodim3 state variable)</rdfs:label>
        <skos:notation>x</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/state_variables/y -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/state_variables/y">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y, t)</tvbo:lhs>
        <tvbo:rhs>x**3 - mu2*x - mu1 - y*(nu + b*x + x**2)</tvbo:rhs>
        <terms:description>Fast subsystem variable y.</terms:description>
        <rdfs:label>y (EpileptorCodim3 state variable)</rdfs:label>
        <skos:notation>y</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>-c*(sqrt((x - xs)**2 + y**2) - dstar + Piecewise(((z - 1/2)**7/10, modification &gt; 0), (0, True)) + Ks*c_glob)</tvbo:rhs>
        <terms:description>Slow subsystem variable z steering the fast subsystem along the great arc.</terms:description>
        <rdfs:label>z (EpileptorCodim3 state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>A0</tvbo:lhs>
        <tvbo:rhs>R*(G0*cos(uA) + H0*sin(uA))</tvbo:rhs>
        <rdfs:label>A0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>A0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>A1</tvbo:lhs>
        <tvbo:rhs>R*(G1*cos(uA) + H1*sin(uA))</tvbo:rhs>
        <rdfs:label>A1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>A1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/A2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>A2</tvbo:lhs>
        <tvbo:rhs>R*(G2*cos(uA) + H2*sin(uA))</tvbo:rhs>
        <rdfs:label>A2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>A2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>B0</tvbo:lhs>
        <tvbo:rhs>R*(L0*cos(uB) + M0*sin(uB))</tvbo:rhs>
        <rdfs:label>B0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>B0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>B1</tvbo:lhs>
        <tvbo:rhs>R*(L1*cos(uB) + M1*sin(uB))</tvbo:rhs>
        <rdfs:label>B1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>B1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/B2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>B2</tvbo:lhs>
        <tvbo:rhs>R*(L2*cos(uB) + M2*sin(uB))</tvbo:rhs>
        <rdfs:label>B2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>B2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>C0</tvbo:lhs>
        <tvbo:rhs>A1*B2 - A2*B1</tvbo:rhs>
        <rdfs:label>C0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>C0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>C1</tvbo:lhs>
        <tvbo:rhs>A2*B0 - A0*B2</tvbo:rhs>
        <rdfs:label>C1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>C1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/C2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>C2</tvbo:lhs>
        <tvbo:rhs>A0*B1 - A1*B0</tvbo:rhs>
        <rdfs:label>C2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>C2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E0</tvbo:lhs>
        <tvbo:rhs>A0/normA</tvbo:rhs>
        <rdfs:label>E0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>E0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E1</tvbo:lhs>
        <tvbo:rhs>A1/normA</tvbo:rhs>
        <rdfs:label>E1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>E1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/E2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>E2</tvbo:lhs>
        <tvbo:rhs>A2/normA</tvbo:rhs>
        <rdfs:label>E2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>E2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F0</tvbo:lhs>
        <tvbo:rhs>Fx0/normF</tvbo:rhs>
        <rdfs:label>F0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>F0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F1</tvbo:lhs>
        <tvbo:rhs>Fx1/normF</tvbo:rhs>
        <rdfs:label>F1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>F1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/F2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>F2</tvbo:lhs>
        <tvbo:rhs>Fx2/normF</tvbo:rhs>
        <rdfs:label>F2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>F2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Fx0</tvbo:lhs>
        <tvbo:rhs>C1*A2 - C2*A1</tvbo:rhs>
        <rdfs:label>Fx0 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>Fx0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Fx1</tvbo:lhs>
        <tvbo:rhs>C2*A0 - C0*A2</tvbo:rhs>
        <rdfs:label>Fx1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>Fx1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/Fx2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Fx2</tvbo:lhs>
        <tvbo:rhs>C0*A1 - C1*A0</tvbo:rhs>
        <rdfs:label>Fx2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>Fx2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/disc -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/disc">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>disc</tvbo:lhs>
        <tvbo:rhs>mu1**2/4 - mu2**3/27</tvbo:rhs>
        <terms:description>Discriminant mu1^2/4 - mu2^3/27 of the depressed cubic for the resting-state x-coordinate.</terms:description>
        <rdfs:label>disc (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>disc</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/mu1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/mu1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu1</tvbo:lhs>
        <tvbo:rhs>-R*(E1*cos(z) + F1*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter mu1 along the great arc (E, F, R) at slow variable z.</terms:description>
        <rdfs:label>mu1 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>mu1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/mu2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/mu2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>mu2</tvbo:lhs>
        <tvbo:rhs>R*(E0*cos(z) + F0*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter mu2 along the great arc (E, F, R) at slow variable z.</terms:description>
        <rdfs:label>mu2 (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>mu2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normA -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normA">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>normA</tvbo:lhs>
        <tvbo:rhs>sqrt(A0**2 + A1**2 + A2**2)</tvbo:rhs>
        <rdfs:label>normA (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>normA</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normF -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/normF">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>normF</tvbo:lhs>
        <tvbo:rhs>sqrt(Fx0**2 + Fx1**2 + Fx2**2)</tvbo:rhs>
        <rdfs:label>normF (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>normF</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/nu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/nu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>nu</tvbo:lhs>
        <tvbo:rhs>R*(E2*cos(z) + F2*sin(z))</tvbo:rhs>
        <terms:description>Bifurcation parameter nu along the great arc (E, F, R) at slow variable z.</terms:description>
        <rdfs:label>nu (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>nu</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/sqdisc -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/sqdisc">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sqdisc</tvbo:lhs>
        <tvbo:rhs>sqrt(Abs(disc))</tvbo:rhs>
        <terms:description>Square root of the absolute discriminant.</terms:description>
        <rdfs:label>sqdisc (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>sqdisc</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/xs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/derived_variables/xs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>xs</tvbo:lhs>
        <tvbo:rhs>Piecewise((Abs(mu1/2 + sqdisc)**(1/3)*cos(atan2(0, mu1/2 + sqdisc)/3) + Abs(mu1/2 - sqdisc)**(1/3)*cos(atan2(0, mu1/2 - sqdisc)/3), disc &gt;= 0), (sqrt((mu1/2)**2 + sqdisc**2)**(1/3)*cos(atan2(sqdisc, mu1/2)/3) + sqrt((mu1/2)**2 + sqdisc**2)**(1/3)*cos(atan2(-sqdisc, mu1/2)/3), True))</tvbo:rhs>
        <terms:description>Real x-coordinate of the resting state, the branch (N = 1) real solution of x_s^3 - mu2 x_s - mu1 = 0 via Cardano&apos;s formula, taking the real part of the principal complex cube roots in both the one-real-root (disc &gt;= 0) and three-real-roots (disc &lt; 0) regimes.</terms:description>
        <rdfs:label>xs (EpileptorCodim3SlowMod derived variable)</rdfs:label>
        <skos:notation>xs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Slow permittivity coupling strength, the default is no coupling.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Ks (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/R -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/R">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Radius in unfolding.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.4</schema:defaultValue>
        <rdfs:label>R (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>R</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Unfolding type of the degenerate Takens-Bogdanov bifurcation, default is a focus type.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>b (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Speed of the slow variable.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.002</schema:defaultValue>
        <rdfs:label>c (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/cA -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/cA">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Speed of the ultra-slow transition of the initial point.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0E-4</schema:defaultValue>
        <rdfs:label>cA (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>cA</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/cB -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/cB">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Speed of the ultra-slow transition of the final point.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.2E-4</schema:defaultValue>
        <rdfs:label>cB (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>cB</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/dstar -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/dstar">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Threshold for the inversion of the slow variable.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3</schema:defaultValue>
        <rdfs:label>dstar (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>dstar</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/modification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/modification">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Toggle the +0.1*(z-0.5)^7 stabilising term in z_dot: &gt;0 (True, default) includes it, 0 (False) omits it.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>modification (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>modification</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu1_Aend -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu1_Aend">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu1 at the final point at bursting offset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.06485</schema:defaultValue>
        <rdfs:label>mu1_Aend (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>mu1_Aend</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu1_Ain -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu1_Ain">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu1 at the initial point at bursting offset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.05494</schema:defaultValue>
        <rdfs:label>mu1_Ain (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>mu1_Ain</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu1_Bend -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu1_Bend">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu1 at the final point at bursting onset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.03676</schema:defaultValue>
        <rdfs:label>mu1_Bend (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>mu1_Bend</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu1_Bin -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu1_Bin">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu1 at the initial point at bursting onset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-0.0461</schema:defaultValue>
        <rdfs:label>mu1_Bin (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>mu1_Bin</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu2_Aend -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu2_Aend">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu2 at the final point at bursting offset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.07337</schema:defaultValue>
        <rdfs:label>mu2_Aend (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>mu2_Aend</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu2_Ain -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu2_Ain">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu2 at the initial point at bursting offset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2731</schema:defaultValue>
        <rdfs:label>mu2_Ain (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>mu2_Ain</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu2_Bend -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu2_Bend">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu2 at the final point at bursting onset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-0.02792</schema:defaultValue>
        <rdfs:label>mu2_Bend (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>mu2_Bend</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu2_Bin -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/mu2_Bin">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter mu2 at the initial point at bursting onset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.243</schema:defaultValue>
        <rdfs:label>mu2_Bin (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>mu2_Bin</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/nu_Aend -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/nu_Aend">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter nu at the final point at bursting offset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-0.3878</schema:defaultValue>
        <rdfs:label>nu_Aend (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>nu_Aend</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/nu_Ain -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/nu_Ain">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter nu at the initial point at bursting offset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.287</schema:defaultValue>
        <rdfs:label>nu_Ain (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>nu_Ain</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/nu_Bend -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/nu_Bend">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter nu at the final point at bursting onset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-0.3973</schema:defaultValue>
        <rdfs:label>nu_Bend (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>nu_Bend</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/nu_Bin -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/parameters/nu_Bin">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The bifurcation parameter nu at the initial point at bursting onset.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3144</schema:defaultValue>
        <rdfs:label>nu_Bin (EpileptorCodim3SlowMod parameter)</rdfs:label>
        <skos:notation>nu_Bin</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/state_variables/uA -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/state_variables/uA">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(uA, t)</tvbo:lhs>
        <tvbo:rhs>cA + 0*uA</tvbo:rhs>
        <terms:description>Ultra-slow modulation of the offset point A along the offset great arc.</terms:description>
        <rdfs:label>uA (EpileptorCodim3SlowMod state variable)</rdfs:label>
        <skos:notation>uA</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/state_variables/uB -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/state_variables/uB">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(uB, t)</tvbo:lhs>
        <tvbo:rhs>cB + 0*uB</tvbo:rhs>
        <terms:description>Ultra-slow modulation of the onset point B along the onset great arc.</terms:description>
        <rdfs:label>uB (EpileptorCodim3SlowMod state variable)</rdfs:label>
        <skos:notation>uB</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/state_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/state_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x, t)</tvbo:lhs>
        <tvbo:rhs>-y</tvbo:rhs>
        <terms:description>Fast-subsystem state variable x (membrane-potential-like).</terms:description>
        <rdfs:label>x (EpileptorCodim3SlowMod state variable)</rdfs:label>
        <skos:notation>x</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/state_variables/y -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/state_variables/y">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y, t)</tvbo:lhs>
        <tvbo:rhs>x**3 - mu2*x - mu1 - y*(nu + b*x + x**2)</tvbo:rhs>
        <terms:description>Fast-subsystem state variable y.</terms:description>
        <rdfs:label>y (EpileptorCodim3SlowMod state variable)</rdfs:label>
        <skos:notation>y</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorCodim3SlowMod/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorCodim3SlowMod/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>-c*(sqrt((x - xs)**2 + y**2) - dstar + Piecewise(((z - 1/2)**7/10, modification &gt; 0), (0, True)) + Ks*c_glob)</tvbo:rhs>
        <terms:description>Slow-subsystem permittivity variable z.</terms:description>
        <rdfs:label>z (EpileptorCodim3SlowMod state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/derived_variables/lc_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/lc_1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>lc_1</tvbo:lhs>
        <tvbo:rhs>local_coupling*x_rs</tvbo:rhs>
        <rdfs:label>lc_1 (EpileptorRestingState derived variable)</rdfs:label>
        <skos:notation>lc_1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/derived_variables/output -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/output">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>output</tvbo:lhs>
        <tvbo:rhs>p*(-x1 + x2) + x_rs*(1 - p)</tvbo:rhs>
        <rdfs:label>output (EpileptorRestingState derived variable)</rdfs:label>
        <skos:notation>output</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/derived_variables/x1cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/x1cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>x1cond</tvbo:lhs>
        <tvbo:rhs>Piecewise(((-a)*x1**2 + b*x1, x1 &lt; 0), (slope - x2 + 0.6*(z - 4.0)**2, True))</tvbo:rhs>
        <rdfs:label>x1cond (EpileptorRestingState derived variable)</rdfs:label>
        <skos:notation>x1cond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/derived_variables/y2cond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/y2cond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>y2cond</tvbo:lhs>
        <tvbo:rhs>Piecewise((0.0, x2 &lt; -0.25), (aa*(x2 + 0.25), True))</tvbo:rhs>
        <rdfs:label>y2cond (EpileptorRestingState derived variable)</rdfs:label>
        <skos:notation>y2cond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/derived_variables/zcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/derived_variables/zcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>zcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((-0.1*z**7, z &lt; 0), (0.0, True))</tvbo:rhs>
        <rdfs:label>zcond (EpileptorRestingState derived variable)</rdfs:label>
        <skos:notation>zcond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/I_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/I_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the third population (x_rs, y_rs)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>I_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>External input current to the third population (x_rs, y_rs).</skos:definition>
        <skos:notation>I_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/Iext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/Iext">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the first population (x1, y1)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.1</schema:defaultValue>
        <rdfs:label>Iext (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>External input current to the first population (x1, y1).</skos:definition>
        <skos:notation>Iext</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/Iext2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/Iext2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External input current to the second population (x2, y2)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.45</schema:defaultValue>
        <rdfs:label>Iext2 (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>External input current to the second population (x2, y2).</skos:definition>
        <skos:notation>Iext2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/K_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/K_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling scaling on a fast time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>K_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a fast time scale.</skos:definition>
        <skos:notation>K_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/Kf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/Kf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling scaling on a fast time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kf (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a fast time scale.</skos:definition>
        <skos:notation>Kf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/Ks -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/Ks">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Permittivity coupling, that is from the very fast time scale         toward the slow time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Ks (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Permittivity coupling, that is from the very fast time scale         toward the slow time scale.</skos:definition>
        <skos:notation>Ks</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/Kvf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/Kvf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling scaling on a very fast time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>Kvf (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coupling scaling on a very fast time scale.</skos:definition>
        <skos:notation>Kvf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the cubic term in the first state-variable x1</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>a (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the first state-variable x1.</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/a_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/a_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Vertical shift of the configurable nullcline         in the state-variable y_rs</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-2.0</schema:defaultValue>
        <rdfs:label>a_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Vertical shift of the configurable nullcline         in the state-variable y_rs.</skos:definition>
        <skos:notation>a_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/aa -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/aa">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the fifth state-variable y2</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.0</schema:defaultValue>
        <rdfs:label>aa (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the fifth state-variable y2.</skos:definition>
        <skos:notation>aa</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/alpha_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/alpha_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Constant parameter to scale the rate of feedback from the         slow variable y_rs to the fast variable x_rs</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>alpha_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the         slow variable y_rs to the fast variable x_rs.</skos:definition>
        <skos:notation>alpha_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the first state-variable x1</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>b (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the first state-variable x1.</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/b_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/b_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient of the state-variable y_rs</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-10.0</schema:defaultValue>
        <rdfs:label>b_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Linear coefficient of the state-variable y_rs.</skos:definition>
        <skos:notation>b_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/bb -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/bb">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient of lowpass excitatory coupling in the fourth         state-variable x2</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>bb (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Linear coefficient of lowpass excitatory coupling in the fourth         state-variable x2.</skos:definition>
        <skos:notation>bb</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/beta_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/beta_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Constant parameter to scale the rate of feedback from the         slow variable y_rs to itself</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>beta_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the         slow variable y_rs to itself.</skos:definition>
        <skos:notation>beta_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Additive coefficient for the second state-variable y1,         called :math:&apos;y_{0}&apos; in Jirsa et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>c (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Additive coefficient for the second state-variable y1,         called :math:&apos;y_{0}&apos; in Jirsa et al. (2014).</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the second state-variable y1</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>d (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the second state-variable y1.</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/d_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/d_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling of the whole third system (x_rs, y_rs)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.02</schema:defaultValue>
        <rdfs:label>d_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Temporal scaling of the whole third system (x_rs, y_rs).</skos:definition>
        <skos:notation>d_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/e_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/e_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the squared term in the sixth state-variable x_rs</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>e_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coefficient of the squared term in the sixth state-variable x_rs.</skos:definition>
        <skos:notation>e_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/f_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/f_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the cubic term in the sixth state-variable x_rs</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>f_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term in the sixth state-variable x_rs.</skos:definition>
        <skos:notation>f_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/gamma_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/gamma_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Constant parameter to reproduce FHN dynamics where         excitatory input currents are negative</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>gamma_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Constant parameter to reproduce FHN dynamics where         excitatory input currents are negative.        Note: It scales both I_rs and the long-range coupling term.</skos:definition>
        <skos:notation>gamma_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/p -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/p">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>p (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Linear coefficient.</skos:definition>
        <skos:notation>p</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling in the third state-variable z,         called :math:&apos;1/	au_{0}&apos; in Jirsa et al</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.5E-4</schema:defaultValue>
        <rdfs:label>r (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Temporal scaling in the third state-variable z,         called :math:&apos;1/	au_{0}&apos; in Jirsa et al. (2014).</skos:definition>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/slope -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/slope">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear coefficient in the first state-variable x1</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>slope (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Linear coefficient in the first state-variable x1.</skos:definition>
        <skos:notation>slope</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling coefficient in the fifth state-variable y2</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <rdfs:label>tau (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Temporal scaling coefficient in the fifth state-variable y2.</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/tau_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/tau_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scaling coefficient in the third population (x_rs, y_rs)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tau_rs (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Temporal scaling coefficient in the third population (x_rs, y_rs).</skos:definition>
        <skos:notation>tau_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/tt -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/tt">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Time scaling of the Epileptor</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tt (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Time scaling of the Epileptor.</skos:definition>
        <skos:notation>tt</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/parameters/x0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/parameters/x0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Epileptogenicity parameter</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema:defaultValue>
        <rdfs:label>x0 (EpileptorRestingState parameter)</rdfs:label>
        <skos:definition>Epileptogenicity parameter.</skos:definition>
        <skos:notation>x0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(g, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-0.01*g + 0.001*x1)</tvbo:rhs>
        <rdfs:label>g (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>g</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/x1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/x1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext + Kvf*c_glob0 + local_coupling*x1 + x1*x1cond + y1 - z)</tvbo:rhs>
        <rdfs:label>x1 (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>x1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/x2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/x2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(Iext2 + Kf*c_glob1 + bb*g - x2**3 + x2 - y2 - 0.3*z + 1.05)</tvbo:rhs>
        <rdfs:label>x2 (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>x2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/x_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/x_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x_rs, t)</tvbo:lhs>
        <tvbo:rhs>d_rs*tau_rs*(I_rs*gamma_rs + K_rs*c_glob2*gamma_rs + alpha_rs*y_rs + e_rs*x_rs**2 - f_rs*x_rs**3 + lc_1)</tvbo:rhs>
        <rdfs:label>x_rs (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>x_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y1, t)</tvbo:lhs>
        <tvbo:rhs>tt*(c - d*x1**2 - y1)</tvbo:rhs>
        <rdfs:label>y1 (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y2, t)</tvbo:lhs>
        <tvbo:rhs>tt*(-y2 + y2cond)/tau</tvbo:rhs>
        <rdfs:label>y2 (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/y_rs -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/y_rs">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y_rs, t)</tvbo:lhs>
        <tvbo:rhs>d_rs*(a_rs + b_rs*x_rs - beta_rs*y_rs)/tau_rs</tvbo:rhs>
        <rdfs:label>y_rs (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>y_rs</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/EpileptorRestingState/state_variables/z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/EpileptorRestingState/state_variables/z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(z, t)</tvbo:lhs>
        <tvbo:rhs>r*tt*(Ks*c_glob0 - 4*x0 + 4*x1 - z + zcond)</tvbo:rhs>
        <rdfs:label>z (EpileptorRestingState state variable)</rdfs:label>
        <skos:notation>z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Half-width of heterogeneous noise distribution</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>Delta (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External homogeneous current</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>I (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>External homogeneous current</skos:definition>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/J -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/J">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Synaptic weight</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">21.2132</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>Synaptic weight</skos:definition>
        <skos:notation>J</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>adaptation rate</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema:defaultValue>
        <rdfs:label>alpha (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>adaptation rate</skos:definition>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/cr -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/cr">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>It is the weight on Coupling through variable r</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>cr (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable r.</skos:definition>
        <skos:notation>cr</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/cv -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/cv">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>It is the weight on Coupling through variable V</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>cv (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable V.</skos:definition>
        <skos:notation>cv</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Mean of heterogeneous noise distribution</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-6.0</schema:defaultValue>
        <rdfs:label>eta (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>Mean of heterogeneous noise distribution</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Characteristic time</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tau (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>Characteristic time</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/tau_A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/parameters/tau_A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Adaptation time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <rdfs:label>tau_A (GastSchmidtKnosche_SD parameter)</rdfs:label>
        <skos:definition>Adaptation time scale</skos:definition>
        <skos:notation>tau_A</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(A, t)</tvbo:lhs>
        <tvbo:rhs>B/tau_A</tvbo:rhs>
        <rdfs:label>A (GastSchmidtKnosche_SD state variable)</rdfs:label>
        <skos:notation>A</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/B -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/B">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(B, t)</tvbo:lhs>
        <tvbo:rhs>(-A - 2*B + alpha*r)/tau_A</tvbo:rhs>
        <rdfs:label>B (GastSchmidtKnosche_SD state variable)</rdfs:label>
        <skos:notation>B</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>(I + J*r*tau*(1 - A) + V**2 + c_glob0*cr + c_glob1*cv + eta - pi**2*r**2*tau**2)/tau</tvbo:rhs>
        <rdfs:label>V (GastSchmidtKnosche_SD state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SD/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>(Delta/(pi*tau) + 2*V*r)/tau</tvbo:rhs>
        <rdfs:label>r (GastSchmidtKnosche_SD state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Half-width of heterogeneous noise distribution</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.0</schema:defaultValue>
        <rdfs:label>Delta (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>Half-width of heterogeneous noise distribution</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External homogeneous current</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>I (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>External homogeneous current</skos:definition>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/J -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/J">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Synaptic weight</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">21.2132</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>Synaptic weight</skos:definition>
        <skos:notation>J</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>adaptation rate</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>alpha (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>adaptation rate</skos:definition>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/cr -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/cr">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>It is the weight on Coupling through variable r</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>cr (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable r.</skos:definition>
        <skos:notation>cr</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/cv -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/cv">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>It is the weight on Coupling through variable V</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>cv (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable V.</skos:definition>
        <skos:notation>cv</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Mean of heterogeneous noise distribution</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>eta (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>Mean of heterogeneous noise distribution</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Characteristic time</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tau (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>Characteristic time</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/tau_A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/parameters/tau_A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Adaptation time scale</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">10.0</schema:defaultValue>
        <rdfs:label>tau_A (GastSchmidtKnosche_SF parameter)</rdfs:label>
        <skos:definition>Adaptation time scale</skos:definition>
        <skos:notation>tau_A</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(A, t)</tvbo:lhs>
        <tvbo:rhs>B/tau_A</tvbo:rhs>
        <rdfs:label>A (GastSchmidtKnosche_SF state variable)</rdfs:label>
        <skos:notation>A</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/B -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/B">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(B, t)</tvbo:lhs>
        <tvbo:rhs>(-A - 2*B + alpha*r)/tau_A</tvbo:rhs>
        <rdfs:label>B (GastSchmidtKnosche_SF state variable)</rdfs:label>
        <skos:notation>B</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>(-A + I + J*r*tau + V**2 + c_glob0*cr + c_glob1*cv + eta - pi**2*r**2*tau**2)/tau</tvbo:rhs>
        <rdfs:label>V (GastSchmidtKnosche_SF state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GastSchmidtKnosche_SF/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>(Delta/(pi*tau) + 2*V*r)/tau</tvbo:rhs>
        <rdfs:label>r (GastSchmidtKnosche_SF state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Baseline shift of the cubic nullcline</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>I (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Baseline shift of the cubic nullcline</skos:definition>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Vertical shift of the configurable nullcline</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-2.0</schema:defaultValue>
        <rdfs:label>a (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Vertical shift of the configurable nullcline</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Constant parameter to scale the rate of feedback from the slow variable to the fast variable.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>alpha (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>alpha_G2D is the coefficient of the linear feedback coupling term of the state-variable W_G2D to the first state-equation Vdot_G2D. Constant parameter to scale the rate of feedback from the slow variable to the fast variable.</skos:definition>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Linear slope of the configurable nullcline</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-10.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0098873"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099178"/>
        <rdfs:label>b (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Linear slope of the configurable nullcline</skos:definition>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/beta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/beta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Constant parameter to scale the rate of feedback from the             slow variable to itself</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>beta (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the
            slow variable to itself</skos:definition>
        <skos:notation>beta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/c -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/c">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Parabolic term of the configurable nullcline</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>c (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Parabolic term of the configurable nullcline</skos:definition>
        <skos:notation>c</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/d -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/d">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Temporal scale factor</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.02</schema:defaultValue>
        <rdfs:label>d (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Temporal scale factor. Warning: do not use it unless
        you know what you are doing and know about time tides.</skos:definition>
        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the quadratic term of the cubic nullcline</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>e (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Coefficient of the quadratic term of the cubic nullcline.</skos:definition>
        <skos:notation>e</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/f -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/f">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the cubic term of the cubic nullcline</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>f (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Coefficient of the cubic term of the cubic nullcline.</skos:definition>
        <skos:notation>f</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/g -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/g">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coefficient of the linear term of the cubic nullcline</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>g (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Coefficient of the linear term of the cubic nullcline.</skos:definition>
        <skos:notation>g</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Constant parameter to reproduce FHN dynamics where                excitatory input currents are negative</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>gamma (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>Constant parameter to reproduce FHN dynamics where
               excitatory input currents are negative.
               It scales both I and the long range coupling term.</skos:definition>
        <skos:notation>gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>A time-scale hierarchy can be introduced for the state         variables :math:`V` and :math:`W`</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tau (Generic2dOscillator parameter)</rdfs:label>
        <skos:definition>A time-scale hierarchy can be introduced for the state
        variables :math:`V` and :math:`W`. Default parameter is 1, which means
        no time-scale hierarchy.</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>d*tau*(I*gamma - V**3*f + V**2*e + V*g + V*local_coupling + W*alpha + c_glob*gamma)</tvbo:rhs>
        <terms:description>V_G2D is the first state-variable of the Generic 2-Dimensional Oscillator model, that can be associated with membrane potentials and sodium activation (FitzHugh, 1961)</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0005272"/>
        <rdfs:label>V (Generic2dOscillator state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Generic2dOscillator/state_variables/W -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Generic2dOscillator/state_variables/W">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(W, t)</tvbo:lhs>
        <tvbo:rhs>d*(V**2*c + V*b - W*beta + a)/tau</tvbo:rhs>
        <terms:description>W_G2D is the second state-variable of the Generic 2-Dimensional Oscillator model, that can be associated with accommodation and refractoriness and considered to represent potassium activation, sodium inactivation, or both (FitzHugh, 1961)</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0005272"/>
        <rdfs:label>W (Generic2dOscillator state variable)</rdfs:label>
        <skos:notation>W</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GenericLinear/parameters/gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GenericLinear/parameters/gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Slope parameter of the state-variable &apos;x_GL&apos;, representing the inverse of the relaxation time</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-10.0</schema:defaultValue>
        <rdfs:label>gamma (GenericLinear parameter)</rdfs:label>
        <skos:definition>Slope parameter of the state-variable &apos;x_GL&apos;, representing the inverse of the relaxation time.

Note: The ‘minus’ sign for the self-connections, scaled by &apos;gamma_GL&apos;, guarantees that the nodes have a stable equilibrium point (ref).</skos:definition>
        <skos:notation>gamma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/GenericLinear/state_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/GenericLinear/state_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x, t)</tvbo:lhs>
        <tvbo:rhs>c_glob + gamma*x + local_coupling*x</tvbo:rhs>
        <terms:description>State-variable of the Generic Linear model</terms:description>
        <rdfs:label>x (GenericLinear state variable)</rdfs:label>
        <skos:notation>x</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Hopfield/parameters/dynamic -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Hopfield/parameters/dynamic">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Threshold dynamics: 0 (default) -&gt; theta tracks x (TVB display hack); &gt;0 -&gt; theta relaxes to its own coupling input.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>dynamic (Hopfield parameter)</rdfs:label>
        <skos:notation>dynamic</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Hopfield/parameters/tauT -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Hopfield/parameters/tauT">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The slow time-scale for threshold calculus :math:`\\theta`, state-variable of the model</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>tauT (Hopfield parameter)</rdfs:label>
        <skos:definition>The slow time-scale for threshold calculus :math:`\\theta`, state-variable of the model.</skos:definition>
        <skos:notation>tauT</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Hopfield/parameters/taux -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Hopfield/parameters/taux">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>The fast time-scale for potential calculus :math:`x`, state-variable of the model</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>taux (Hopfield parameter)</rdfs:label>
        <skos:definition>The fast time-scale for potential calculus :math:`x`, state-variable of the model.</skos:definition>
        <skos:notation>taux</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Hopfield/state_variables/theta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Hopfield/state_variables/theta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(theta, t)</tvbo:lhs>
        <tvbo:rhs>Piecewise(((c_glob1 - theta)/tauT, dynamic &gt; 0), ((c_glob0 - x)/taux, True))</tvbo:rhs>
        <terms:description>Slow state variable at node i</terms:description>
        <rdfs:label>theta (Hopfield state variable)</rdfs:label>
        <skos:notation>theta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/Hopfield/state_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Hopfield/state_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(x, t)</tvbo:lhs>
        <tvbo:rhs>(c_glob0 - x)/taux</tvbo:rhs>
        <rdfs:label>x (Hopfield state variable)</rdfs:label>
        <skos:notation>x</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sigma_y0_1</tvbo:lhs>
        <tvbo:rhs>2.0*nu_max/(exp(r*(-J*a_1*y0 + v0)) + 1.0)</tvbo:rhs>
        <terms:description>Sigmoid function that transforms the average membrane potential of the PCs populations (y0) into an average firing rate to the excitatory interneurons EINs.</terms:description>
        <rdfs:label>sigma_y0_1 (JansenRit derived variable)</rdfs:label>
        <skos:notation>sigma_y0_1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y0_3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sigma_y0_3</tvbo:lhs>
        <tvbo:rhs>2.0*nu_max/(exp(r*(-J*a_3*y0 + v0)) + 1.0)</tvbo:rhs>
        <terms:description>Sigmoid function that transforms the average membrane potential of the PCs populations (y0) into an average firing rate to the inhibitory interneurons IINs.</terms:description>
        <rdfs:label>sigma_y0_3 (JansenRit derived variable)</rdfs:label>
        <skos:notation>sigma_y0_3</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y1_y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/derived_variables/sigma_y1_y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>sigma_y1_y2</tvbo:lhs>
        <tvbo:rhs>2.0*nu_max/(exp(r*(v0 - y1 + y2)) + 1.0)</tvbo:rhs>
        <terms:description>Sigmoid function that transforms the average membrane potential of the interneurons populations (y1-y2)
into an average firing rate to the PCs.</terms:description>
        <rdfs:label>sigma_y1_y2 (JansenRit derived variable)</rdfs:label>
        <skos:notation>sigma_y1_y2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Maximum amplitude of EPSP [mV]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.25</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>A (JansenRit parameter)</rdfs:label>
        <skos:definition>Maximum amplitude of EPSP [mV]. Also called average synaptic gain.</skos:definition>
        <skos:notation>A</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/B -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/B">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Maximum amplitude of IPSP [mV]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">22.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>B (JansenRit parameter)</rdfs:label>
        <skos:definition>Maximum amplitude of IPSP [mV]. Also called average synaptic gain.</skos:definition>
        <skos:notation>B</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/J -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/J">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Average number of synapses between three neuronal populations of the model</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">135.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0051124"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0150092"/>
        <rdfs:label>J (JansenRit parameter)</rdfs:label>
        <skos:definition>Average number of synapses between three neuronal populations of the model. It accounts for synaptic phenomena such as neurotransmitter depletion.</skos:definition>
        <skos:notation>J</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Reciprocal of the time constant of passive membrane and all other spatially distributed delays in the dendritic network. Also called average synaptic time constant.</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.1</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>a (JansenRit parameter)</rdfs:label>
        <skos:definition>Rate constant of the excitatory post-synaptic potential (EPSP). It is interpreted as being the lumped representation of the sum of the reciprocal of the time constant of passive membrane and all other spatially distributed delays, including temporal dispersion in the afferent tract, synaptic diffusion, and resistive-capacitive delay in the dendritic network.</skos:definition>
        <skos:notation>a</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/a_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/a_1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Average probability constant of the number of synapses made by the pyramidal cells to the dendrites of the excitatory interneurons  (feedback excitatory loop)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>a_1 (JansenRit parameter)</rdfs:label>
        <skos:definition>Average probability constant of the number of synapses made by the pyramidal cells to the dendrites of the excitatory interneurons  (feedback excitatory loop). It characterizes the connectivity between the PCs and EINs.</skos:definition>
        <skos:notation>a_1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/a_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/a_2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Average probability constant of the number of synapses made by the EINs to the dendrites of the PCs</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.8</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>a_2 (JansenRit parameter)</rdfs:label>
        <skos:definition>Average probability constant of the number of synapses made by the EINs to the dendrites of the PCs. It characterizes the excitatory connectivity between the EINs and PCs.</skos:definition>
        <skos:notation>a_2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/a_3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/a_3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Average probability constant of the number of synapses made by the PCs to the dendrites of the IINs</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.25</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>a_3 (JansenRit parameter)</rdfs:label>
        <skos:definition>Average probability constant of the number of synapses made by the PCs to the dendrites of the IINs. It characterizes the connectivity between the PCs and inhibitory IINs.</skos:definition>
        <skos:notation>a_3</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/a_4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/a_4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Average probability constant of the number of synapses made by the IINs to the dendrites of the PCs</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.25</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060077"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>a_4 (JansenRit parameter)</rdfs:label>
        <skos:definition>Average probability constant of the number of synapses made by the IINs to the dendrites of the PCs. It characterizes the connectivity between the IINs and  PCs.</skos:definition>
        <skos:notation>a_4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Rate constant of the inhibitory post-synaptic potential (IPSP)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.05</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>b (JansenRit parameter)</rdfs:label>
        <skos:definition>Rate constant of the inhibitory post-synaptic potential (IPSP). It is interpreted as being the lumped representation of the sum of the reciprocal of the time constant of passive membrane and all other spatially distributed delays, including temporal dispersion in the afferent tract, synaptic diffusion, and resistive-capacitive delay in the dendritic network (Freeman 1975).</skos:definition>
        <skos:notation>b</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/mu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/mu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Mean excitatory external input to the derivative of the state-variable y4_JR (PCs) represented by a pulse density, that consists of activity originating from adjacent and more distant cortical columns, as well as from subcortical structures (e</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.22</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>mu (JansenRit parameter)</rdfs:label>
        <skos:definition>Mean excitatory external input to the derivative of the state-variable y4_JR (PCs) represented by a pulse density, that consists of activity originating from adjacent and more distant cortical columns, as well as from subcortical structures (e.g., thalamus).</skos:definition>
        <skos:notation>mu</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/nu_max -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/nu_max">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Asymptotic of the sigmoid function Sigm_JR corresponds to the maximum firing rate of the neural populations</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0025</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>nu_max (JansenRit parameter)</rdfs:label>
        <skos:definition>Asymptotic of the sigmoid function Sigm_JR corresponds to the maximum firing rate of the neural populations.</skos:definition>
        <skos:notation>nu_max</skos:notation>
        <tvbo:unit>per_ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Steepness (or gain) parameter of the sigmoid function Sigm_JR</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.56</schema:defaultValue>
        <rdfs:label>r (JansenRit parameter)</rdfs:label>
        <skos:definition>Steepness (or gain) parameter of the sigmoid function Sigm_JR.</skos:definition>
        <skos:notation>r</skos:notation>
        <tvbo:unit>per_mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/parameters/v0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/parameters/v0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Average firing threshold (PSP) for which half of the firing rate is achieved</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.52</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>v0 (JansenRit parameter)</rdfs:label>
        <skos:definition>Average firing threshold (PSP) for which half of the firing rate is achieved.

Note:
- The usual value for this parameter is 6.0 (Jansen et al., 1993; Jansen &amp; Rit, 1995).</skos:definition>
        <skos:notation>v0</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y0, t)</tvbo:lhs>
        <tvbo:rhs>y3</tvbo:rhs>
        <terms:description>First state-variable of the first Jansen-Rit population</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000598"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>y0 (JansenRit state variable)</rdfs:label>
        <skos:notation>y0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y1, t)</tvbo:lhs>
        <tvbo:rhs>y4</tvbo:rhs>
        <terms:description>First state-variable of the second Jansen-Rit population (EINs)</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060076"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>y1 (JansenRit state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y2, t)</tvbo:lhs>
        <tvbo:rhs>y5</tvbo:rhs>
        <terms:description>First state-variable of the third Jansen-Rit population (IINs)</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060077"/>
        <rdfs:label>y2 (JansenRit state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y3, t)</tvbo:lhs>
        <tvbo:rhs>A*a*sigma_y1_y2 - a**2*y0 - 2.0*a*y3</tvbo:rhs>
        <terms:description>Second state-variable of the first Jansen-Rit population (excitatory PCs)</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000598"/>
        <rdfs:label>y3 (JansenRit state variable)</rdfs:label>
        <skos:notation>y3</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y4, t)</tvbo:lhs>
        <tvbo:rhs>A*a*(J*a_2*sigma_y0_1 + c_glob + local_coupling*(y1 - y2) + mu) - a**2*y1 - 2.0*a*y4</tvbo:rhs>
        <terms:description>Second state-variable of the second excitatory Jansen-Rit population (excitatory EINs)</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <rdfs:label>y4 (JansenRit state variable)</rdfs:label>
        <skos:notation>y4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit/state_variables/y5 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit/state_variables/y5">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y5, t)</tvbo:lhs>
        <tvbo:rhs>B*J*a_4*b*sigma_y0_3 - b**2*y2 - 2.0*b*y5</tvbo:rhs>
        <terms:description>Second state-variable of the third (inhibitory) Jansen-Rit population (IINs)</terms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <rdfs:label>y5 (JansenRit state variable)</rdfs:label>
        <skos:notation>y5</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/derived_variables/v_pyr -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/derived_variables/v_pyr">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:rhs>y1 - y2</tvbo:rhs>
        <terms:description>Aggregate pyramidal PSP (EEG-like output)</terms:description>
        <rdfs:label>v_pyr (JansenRit1995 derived variable)</rdfs:label>
        <skos:notation>v_pyr</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/A -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/A">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Maximum amplitude of excitatory PSP (EPSP)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.25</schema:defaultValue>
        <rdfs:label>A (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>A</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/B -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/B">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Maximum amplitude of inhibitory PSP (IPSP)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</schema:defaultValue>
        <rdfs:label>B (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>B</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/C -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/C">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Lumped connectivity constant (C = C1)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">135</schema:defaultValue>
        <rdfs:label>C (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>C</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Reciprocal of EPSP time constant</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</schema:defaultValue>
        <rdfs:label>a (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>a</skos:notation>
        <tvbo:unit>per_s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Reciprocal of IPSP time constant</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</schema:defaultValue>
        <rdfs:label>b (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>b</skos:notation>
        <tvbo:unit>per_s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/e0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/e0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Half of maximum firing rate (2*e0 = max rate)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.5</schema:defaultValue>
        <rdfs:label>e0 (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>e0</skos:notation>
        <tvbo:unit>per_s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/p -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/p">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Mean external input (afferent pulse density)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">220</schema:defaultValue>
        <rdfs:label>p (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>p</skos:notation>
        <tvbo:unit>per_s</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Steepness of sigmoid transformation</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.56</schema:defaultValue>
        <rdfs:label>r (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>r</skos:notation>
        <tvbo:unit>per_mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/parameters/v0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/parameters/v0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>PSP for 50% firing rate (sigmoid midpoint)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</schema:defaultValue>
        <rdfs:label>v0 (JansenRit1995 parameter)</rdfs:label>
        <skos:notation>v0</skos:notation>
        <tvbo:unit>mV</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>y3</tvbo:rhs>
        <rdfs:label>y0 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>y4</tvbo:rhs>
        <rdfs:label>y1 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>y5</tvbo:rhs>
        <rdfs:label>y2 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>A*a*Sigm(y1 - y2) - 2*a*y3 - a**2*y0</tvbo:rhs>
        <rdfs:label>y3 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y3</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>A*a*(p + C2*Sigm(C1*y0) + c_intercolumn) - 2*a*y4 - a**2*y1</tvbo:rhs>
        <rdfs:label>y4 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/JansenRit1995/state_variables/y5 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/JansenRit1995/state_variables/y5">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>B*b*(C4*Sigm(C3*y0)) - 2*b*y5 - b**2*y2</tvbo:rhs>
        <rdfs:label>y5 (JansenRit1995 state variable)</rdfs:label>
        <skos:notation>y5</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/DK_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/DK_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>DK_o</tvbo:lhs>
        <tvbo:rhs>-DKi*beta</tvbo:rhs>
        <rdfs:label>DK_o (KIonEx derived variable)</rdfs:label>
        <skos:notation>DK_o</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/DNa_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/DNa_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>DNa_i</tvbo:lhs>
        <tvbo:rhs>-DKi</tvbo:rhs>
        <rdfs:label>DNa_i (KIonEx derived variable)</rdfs:label>
        <skos:notation>DNa_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/DNa_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/DNa_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>DNa_o</tvbo:lhs>
        <tvbo:rhs>-DNa_i*beta</tvbo:rhs>
        <rdfs:label>DNa_o (KIonEx derived variable)</rdfs:label>
        <skos:notation>DNa_o</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/I_Cl -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/I_Cl">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>I_Cl</tvbo:lhs>
        <tvbo:rhs>g_Cl*(V + 26.64*log(Cl_o0/Cl_i0))</tvbo:rhs>
        <rdfs:label>I_Cl (KIonEx derived variable)</rdfs:label>
        <skos:notation>I_Cl</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/I_K -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/I_K">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>I_K</tvbo:lhs>
        <tvbo:rhs>(V - 26.64*log(K_o/K_i))*(g_K*n + g_Kl)</tvbo:rhs>
        <rdfs:label>I_K (KIonEx derived variable)</rdfs:label>
        <skos:notation>I_K</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/I_Na -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/I_Na">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>I_Na</tvbo:lhs>
        <tvbo:rhs>(V - 26.64*log(Na_o/Na_i))*(g_Na*h*minf + g_Nal)</tvbo:rhs>
        <rdfs:label>I_Na (KIonEx derived variable)</rdfs:label>
        <skos:notation>I_Na</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/I_pump -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/I_pump">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>I_pump</tvbo:lhs>
        <tvbo:rhs>1.0*rho/((exp((Ckp - K_o)/DCkp) + 1.0)*(exp((Cnap - Na_i)/DCnap) + 1.0))</tvbo:rhs>
        <rdfs:label>I_pump (KIonEx derived variable)</rdfs:label>
        <skos:notation>I_pump</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/K_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/K_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>K_i</tvbo:lhs>
        <tvbo:rhs>DKi + K_i0</tvbo:rhs>
        <rdfs:label>K_i (KIonEx derived variable)</rdfs:label>
        <skos:notation>K_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/K_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/K_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>K_o</tvbo:lhs>
        <tvbo:rhs>DK_o + K_o0 + Kg</tvbo:rhs>
        <rdfs:label>K_o (KIonEx derived variable)</rdfs:label>
        <skos:notation>K_o</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/Na_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/Na_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Na_i</tvbo:lhs>
        <tvbo:rhs>DNa_i + Na_i0</tvbo:rhs>
        <rdfs:label>Na_i (KIonEx derived variable)</rdfs:label>
        <skos:notation>Na_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/Na_o -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/Na_o">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Na_o</tvbo:lhs>
        <tvbo:rhs>DNa_o + Na_o0</tvbo:rhs>
        <rdfs:label>Na_o (KIonEx derived variable)</rdfs:label>
        <skos:notation>Na_o</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/V_temp -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/V_temp">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>V_temp</tvbo:lhs>
        <tvbo:rhs>-1.0*(I_Cl + I_K + I_Na + I_pump)/Cm</tvbo:rhs>
        <rdfs:label>V_temp (KIonEx derived variable)</rdfs:label>
        <skos:notation>V_temp</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/Vcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/Vcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>Vcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((R_minus*c_glob*(-V + E)/pi - R_minus*x**2 + V_temp + eta, V &lt;= Vstar), (R_minus*c_glob*(-V + E)/pi - R_plus*x**2 + V_temp + eta, True))</tvbo:rhs>
        <rdfs:label>Vcond (KIonEx derived variable)</rdfs:label>
        <skos:notation>Vcond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/beta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/beta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>beta</tvbo:lhs>
        <tvbo:rhs>w_i/w_o</tvbo:rhs>
        <rdfs:label>beta (KIonEx derived variable)</rdfs:label>
        <skos:notation>beta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/h -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/h">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>h</tvbo:lhs>
        <tvbo:rhs>1.1 - 1.0/(1.0 + 24.5325301971094*exp(-8.0*n))</tvbo:rhs>
        <rdfs:label>h (KIonEx derived variable)</rdfs:label>
        <skos:notation>h</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/minf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/minf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>minf</tvbo:lhs>
        <tvbo:rhs>1.0/(exp((Cmna - V)/DCmna) + 1.0)</tvbo:rhs>
        <rdfs:label>minf (KIonEx derived variable)</rdfs:label>
        <skos:notation>minf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/ninf -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/ninf">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>ninf</tvbo:lhs>
        <tvbo:rhs>1.0/(exp((Cnk - V)/DCnk) + 1.0)</tvbo:rhs>
        <rdfs:label>ninf (KIonEx derived variable)</rdfs:label>
        <skos:notation>ninf</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>r</tvbo:lhs>
        <tvbo:rhs>R_minus*x/pi</tvbo:rhs>
        <rdfs:label>r (KIonEx derived variable)</rdfs:label>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/derived_variables/xcond -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/derived_variables/xcond">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <tvbo:lhs>xcond</tvbo:lhs>
        <tvbo:rhs>Piecewise((Delta - J*r*x + 2*R_minus*x*(V - c_minus), V &lt;= Vstar), (Delta - J*r*x + 2*R_plus*x*(V - c_plus), True))</tvbo:rhs>
        <rdfs:label>xcond (KIonEx derived variable)</rdfs:label>
        <skos:notation>xcond</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Chn -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Chn">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.4</schema:defaultValue>
        <rdfs:label>Chn (KIonEx parameter)</rdfs:label>
        <skos:notation>Chn</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Ckp -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Ckp">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.5</schema:defaultValue>
        <rdfs:label>Ckp (KIonEx parameter)</rdfs:label>
        <skos:notation>Ckp</skos:notation>
        <tvbo:unit>mol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Cl_i0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Cl_i0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>initial concentration of intracellular Cl</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</schema:defaultValue>
        <rdfs:label>Cl_i0 (KIonEx parameter)</rdfs:label>
        <skos:definition>initial concentration of intracellular Cl</skos:definition>
        <skos:notation>Cl_i0</skos:notation>
        <tvbo:unit>mmol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/KIonEx/parameters/Cl_o0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/KIonEx/parameters/Cl_o0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>initial concentration of extracellular Cl</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">112.0</schema:defaultValue>
        <rdfs:label>Cl_o0 (KIonEx parameter)</rdfs:label>
        <skos:definition>initial concentration of extracellular Cl</skos:definition>
        <skos:notation>Cl_o0</skos:notation>
        <tvbo:unit>mmol_per_m3</tvbo:unit>
    </owl:NamedIndividual>
    


