    <!-- https://w3id.org/tvbo/DomainEnforcement#clamp -->

    <owl:Class rdf:about="https://w3id.org/tvbo/DomainEnforcement#clamp">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/DomainEnforcement"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>clamp (DomainEnforcement)</rdfs:label>
        <skos:definition>Hard-clip every integration step to [lo, hi].</skos:definition>
        <skos:notation>clamp</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/DomainEnforcement#none -->

    <owl:Class rdf:about="https://w3id.org/tvbo/DomainEnforcement#none">
