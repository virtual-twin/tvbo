        <rdfs:label>PyRhO</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/SONATA -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/SONATA">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>Scalable Open Network Architecture ToolKit and Application — a data format specification for storing large-scale neural network models and simulation results. Joint Allen Institute / Blue Brain standard.</dcterms:description>
        <dcterms:license>BSD-3-Clause</dcterms:license>
        <schema1:codeRepository>https://github.com/AllenInstitute/sonata</schema1:codeRepository>
