        <rdfs:label>id (slot)</rdfs:label>
        <skos:definition>Unique node identifier</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>id</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/initial_value -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/initial_value"/>
    


    <!-- https://w3id.org/tvbo/input -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/input"/>
    


    <!-- https://w3id.org/tvbo/iri -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/iri">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>iri (slot)</rdfs:label>
        <skos:definition>Optional stable IRI (or compact URI) for this entity in an external ontology or knowledge base. Used to load metadata from an external source; not required when the entity is fully self-contained (equations, parameters, etc. defined in the file itself).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>iri</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/key -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/key"/>
    


    <!-- https://w3id.org/tvbo/keys -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/keys">
        <rdfs:label>keys (slot)</rdfs:label>
        <skos:definition>Named keys for multi-dimensional coupling. When dimension &gt; 1, provides symbolic names for each index (e.g., keys: [lre, ffi] for dimension: 2). Used in equations as variable names.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>keys</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/label -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/label">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/labels_dimensions -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/labels_dimensions">
        <rdfs:label>labels_dimensions (slot)</rdfs:label>
        <skos:definition>Mapping of dimension names to their labels (JSON-encoded dict).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>labels_dimensions</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/labels_ordering -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/labels_ordering">
        <rdfs:label>labels_ordering (slot)</rdfs:label>
        <skos:definition>Ordering of dimensions: Time, State Variable, Space, Mode.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>labels_ordering</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/latex -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/latex">
        <rdfs:label>latex (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>latex</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/learning_rate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/learning_rate"/>
    


    <!-- https://w3id.org/tvbo/learning_rate_schedule -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/learning_rate_schedule">
        <rdfs:label>learning_rate_schedule (slot)</rdfs:label>
        <skos:definition>Learning rate schedule: &apos;constant&apos;, &apos;linear&apos;, &apos;exponential&apos;</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>learning_rate_schedule</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/learning_rate_warmup -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/learning_rate_warmup">
        <rdfs:label>learning_rate_warmup (slot)</rdfs:label>
        <skos:definition>Linear warmup of learning rate from 0 to learning_rate over n_iterations. eta_effective = eta * (i+1) / n_iterations</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>learning_rate_warmup</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/lefthandside -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/lefthandside">
        <rdfs:label>lefthandside (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>lefthandside</skos:notation>
        <skos:prefLabel>lhs</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/license -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/license">
        <rdfs:label>license (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>license</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/log_scale -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/log_scale">
        <rdfs:label>log_scale (slot)</rdfs:label>
        <skos:definition>Whether to use logarithmic spacing.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>log_scale</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/max_bisection_steps -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/max_bisection_steps">
        <rdfs:label>max_bisection_steps (slot)</rdfs:label>
        <skos:definition>Maximum bisection steps for bifurcation point localization.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>max_bisection_steps</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/max_iterations -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/max_iterations">
        <rdfs:label>max_iterations (slot)</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>max_iterations</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/max_steps -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/max_steps">
        <rdfs:label>max_steps (slot)</rdfs:label>
        <skos:definition>Maximum continuation steps.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>max_steps</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/mesh_file -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/mesh_file">
        <rdfs:label>mesh_file (slot)</rdfs:label>
        <skos:definition>Path to external mesh file (GIFTI, VTK, MSH, FreeSurfer, etc.).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>mesh_file</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/mesh_format -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/mesh_format">
        <rdfs:label>mesh_format (slot)</rdfs:label>
        <skos:definition>Explicit format override (gifti, freesurfer, meshio, vtk, gmsh). Auto-detected from extension if null.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>mesh_format</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/mesh_intervals -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/mesh_intervals">
        <rdfs:label>mesh_intervals (slot)</rdfs:label>
        <skos:definition>Number of mesh intervals (time slices) for collocation or trapezoid methods. Collocation: N in PeriodicOrbitOCollProblem(N, m). Trapezoid: M in PeriodicOrbitTrapProblem(M=...).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>mesh_intervals</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/method -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/method"/>
    


    <!-- https://w3id.org/tvbo/mode -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/mode">
        <rdfs:label>mode (slot)</rdfs:label>
        <skos:definition>Combination mode: &apos;product&apos; (full grid), &apos;zip&apos; (paired)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>mode</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/model_equation_ref -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/model_equation_ref">
