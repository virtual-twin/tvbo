        <skos:notation>e0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Average number of synapses between populations (pyramidal to stellate)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">135.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000598"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>gamma_1 (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Average number of synapses between populations (pyramidal to stellate).</skos:definition>
        <skos:notation>gamma_1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_1T -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_1T">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling factor from the extrinisic input to the spiny stellate population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>gamma_1T (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Coupling factor from the extrinisic input to the spiny stellate population.</skos:definition>
        <skos:notation>gamma_1T</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Average number of synapses between populations (stellate to pyramidal)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">108.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>gamma_2 (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Average number of synapses between populations (stellate to pyramidal).</skos:definition>
        <skos:notation>gamma_2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_2T -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_2T">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling factor from the extrinisic input to the pyramidal population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000598"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>gamma_2T (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Coupling factor from the extrinisic input to the pyramidal population.</skos:definition>
        <skos:notation>gamma_2T</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Connectivity constant (pyramidal to interneurons)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">33.75</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000598"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>gamma_3 (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Connectivity constant (pyramidal to interneurons)</skos:definition>
        <skos:notation>gamma_3</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_3T -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_3T">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Coupling factor from the extrinisic input to the inhibitory population</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>gamma_3T (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Coupling factor from the extrinisic input to the inhibitory population.</skos:definition>
        <skos:notation>gamma_3T</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Connectivity constant (interneurons to pyramidal)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">33.75</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000598"/>
        <rdfs:label>gamma_4 (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Connectivity constant (interneurons to pyramidal)</skos:definition>
        <skos:notation>gamma_4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_5 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/gamma_5">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Connectivity constant (interneurons to interneurons)</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">15.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <rdfs:label>gamma_5 (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Connectivity constant (interneurons to interneurons)</skos:definition>
        <skos:notation>gamma_5</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/ke -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/ke">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Reciprocal of the time constant of passive membrane and all         other spatially distributed delays in the dendritic network [ms^-1]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.1</schema:defaultValue>
        <rdfs:label>ke (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Reciprocal of the time constant of passive membrane and all
        other spatially distributed delays in the dendritic network [ms^-1].
        Also called average synaptic time constant.</skos:definition>
        <skos:notation>ke</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/ki -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/ki">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Reciprocal of the time constant of passive membrane and all         other spatially distributed delays in the dendritic network [ms^-1]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.05</schema:defaultValue>
        <rdfs:label>ki (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Reciprocal of the time constant of passive membrane and all
        other spatially distributed delays in the dendritic network [ms^-1].
        Also called average synaptic time constant.</skos:definition>
        <skos:notation>ki</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/rho_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/rho_1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Steepness of the sigmoidal transformation [mV^-1]</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.56</schema:defaultValue>
        <rdfs:label>rho_1 (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Steepness of the sigmoidal transformation [mV^-1].</skos:definition>
        <skos:notation>rho_1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/parameters/rho_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/parameters/rho_2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Firing threshold (PSP) for which a 50% firing rate is achieved</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.0</schema:defaultValue>
        <rdfs:label>rho_2 (ZetterbergJansen parameter)</rdfs:label>
        <skos:definition>Firing threshold (PSP) for which a 50% firing rate is achieved.
        In other words, it is the value of the average membrane potential
        corresponding to the inflection point of the sigmoid [mV]. Population mean firing threshold.</skos:definition>
        <skos:notation>rho_2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/v1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/v1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(v1, t)</tvbo:lhs>
        <tvbo:rhs>y1</tvbo:rhs>
        <rdfs:label>v1 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>v1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/v2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/v2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(v2, t)</tvbo:lhs>
        <tvbo:rhs>y2</tvbo:rhs>
        <rdfs:label>v2 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>v2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/v3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/v3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(v3, t)</tvbo:lhs>
        <tvbo:rhs>y3</tvbo:rhs>
        <rdfs:label>v3 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>v3</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/v4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/v4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(v4, t)</tvbo:lhs>
        <tvbo:rhs>y4</tvbo:rhs>
        <rdfs:label>v4 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>v4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/v5 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/v5">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(v5, t)</tvbo:lhs>
        <tvbo:rhs>y5</tvbo:rhs>
        <rdfs:label>v5 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>v5</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/v6 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/v6">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(v6, t)</tvbo:lhs>
        <tvbo:rhs>y2 - y3</tvbo:rhs>
        <rdfs:label>v6 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>v6</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/v7 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/v7">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(v7, t)</tvbo:lhs>
        <tvbo:rhs>y4 - y5</tvbo:rhs>
        <rdfs:label>v7 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>v7</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y1, t)</tvbo:lhs>
        <tvbo:rhs>He*ke*(gamma_1*sigma_v23 + gamma_1T*(U + coupled_input)) - ke**2*v1 - 2*ke*y1</tvbo:rhs>
        <rdfs:label>y1 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y2, t)</tvbo:lhs>
        <tvbo:rhs>He*ke*(gamma_2*sigma_v1 + gamma_2T*(P + coupled_input)) - ke**2*v2 - 2*ke*y2</tvbo:rhs>
        <rdfs:label>y2 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/y3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/y3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y3, t)</tvbo:lhs>
        <tvbo:rhs>Hi*gamma_4*ki*sigma_v45 - ki**2*v3 - 2*ki*y3</tvbo:rhs>
        <rdfs:label>y3 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>y3</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/y4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZetterbergJansen/state_variables/y4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(y4, t)</tvbo:lhs>
        <tvbo:rhs>He*ke*(gamma_3*sigma_v23 + gamma_3T*(Q + coupled_input)) - ke**2*v4 - 2*ke*y4</tvbo:rhs>
        <rdfs:label>y4 (ZetterbergJansen state variable)</rdfs:label>
        <skos:notation>y4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZetterbergJansen/state_variables/y5 -->

