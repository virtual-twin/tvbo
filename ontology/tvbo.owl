                    <rdf:Description rdf:about="https://w3id.org/tvbo/OperatorType#gradient"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/OperatorType#laplacian"/>
                </owl:unionOf>
            </owl:Class>
