    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/K_ext_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/K_ext_e">
