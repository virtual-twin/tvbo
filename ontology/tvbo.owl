    <!-- https://w3id.org/tvbo/EventType#continuous -->

    <owl:Class rdf:about="https://w3id.org/tvbo/EventType#continuous">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>continuous (EventType)</rdfs:label>
        <skos:definition>Triggered when condition function crosses zero (root-finding). Maps to ContinuousCallback / ContinuousComponentCallback.</skos:definition>
        <skos:notation>continuous</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/EventType#discrete -->

    <owl:Class rdf:about="https://w3id.org/tvbo/EventType#discrete">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>discrete (EventType)</rdfs:label>
        <skos:definition>Triggered when condition function returns true (checked at each step). Maps to DiscreteCallback / DiscreteComponentCallback.</skos:definition>
        <skos:notation>discrete</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/EventType#preset_time -->

    <owl:Class rdf:about="https://w3id.org/tvbo/EventType#preset_time">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>preset_time (EventType)</rdfs:label>
        <skos:definition>Triggered at predetermined time points. Maps to PresetTimeCallback / PresetTimeComponentCallback.</skos:definition>
        <skos:notation>preset_time</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/EventType#stimulation -->

    <owl:Class rdf:about="https://w3id.org/tvbo/EventType#stimulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>stimulation (EventType)</rdfs:label>
        <skos:definition>Synonym of &apos;stimulus&apos; — a continuous time-dependent input signal injected into a target state variable across target regions. The codegen treats &apos;stimulation&apos; and &apos;stimulus&apos; identically.</skos:definition>
        <skos:notation>stimulation</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/EventType#stimulus -->

    <owl:Class rdf:about="https://w3id.org/tvbo/EventType#stimulus">
        <rdfs:subClassOf rdf:resource="https://w3id.org/tvbo/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>stimulus (EventType)</rdfs:label>
        <skos:definition>Continuous time-dependent input signal (e.g., external current). Legacy Stimulus behavior.</skos:definition>
        <skos:notation>stimulus</skos:notation>
    </owl:Class>
    


