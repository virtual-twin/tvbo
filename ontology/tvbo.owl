    <!-- https://w3id.org/tvbo/observation_models/FC -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/FC">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>Functional Connectivity (FC) observation model that computes pairwise Pearson correlation coefficients between regional time series. Commonly used to characterize the statistical dependencies between brain regions from fMRI or simulated neural activity.</dcterms:description>
        <rdfs:label>FunctionalConnectivity</rdfs:label>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/FC/parameters/TR"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/FC/parameters/fisher_z"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/afferent_coupling -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/afferent_coupling">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>Records the afferent (incoming) coupling term at each network node at every integration step. Records the coupling input that drives the dynamics rather than the model state itself.</dcterms:description>
        <rdfs:label>AfferentCoupling</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/afferent_coupling_temporal_average -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/afferent_coupling_temporal_average">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>Temporally averaged afferent coupling input at each node. Combines coupling input recording with temporal averaging.</dcterms:description>
        <rdfs:label>AfferentCouplingTemporalAverage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/bold_double_exponential -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/bold_double_exponential">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>BOLD fMRI observation model using a Double Exponential hemodynamic response function.</dcterms:description>
        <rdfs:label>BOLD_DoubleExponential</rdfs:label>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/bold_double_exponential/parameters/TR"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/bold_gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/bold_gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>BOLD fMRI observation model using a Gamma-shaped hemodynamic response function. Provides a simpler, unimodal HRF shape.</dcterms:description>
        <rdfs:label>BOLD_Gamma</rdfs:label>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/bold_gamma/parameters/TR"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/bold_mixture_of_gammas -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/bold_mixture_of_gammas">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>BOLD fMRI observation model using the canonical double-gamma hemodynamic response function (Glover 1999). Standard HRF used in most fMRI analysis packages (SPM, FSL, AFNI).</dcterms:description>
        <rdfs:label>BOLD_MixtureOfGammas</rdfs:label>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/bold_mixture_of_gammas/parameters/TR"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/bold_region_roi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/bold_region_roi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>BOLD fMRI observation model that computes the hemodynamic response at each source location and spatially averages within brain regions using a parcellation mapping. Produces per-region BOLD signals suitable for comparison with parcellated empirical data.</dcterms:description>
        <rdfs:label>BOLD_RegionROI</rdfs:label>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/bold_region_roi/parameters/hrf_length"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/bold_tvb -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/bold_tvb">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>BOLD fMRI observation model using the Balloon-Windkessel hemodynamic model. Transforms neural activity into simulated BOLD signal via convolution with a hemodynamic response function (First Order Volterra kernel), followed by a nonlinear Volterra transformation.</dcterms:description>
        <rdfs:label>BOLD_TVB</rdfs:label>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/bold_tvb/parameters/TR"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/eeg -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/eeg">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>Forward solution for scalp electroencephalography. Projects source neural activity through a lead field (gain) matrix to electrode locations on the scalp. If no precomputed gain is available, uses a single-sphere analytic approximation (Sarvas 1987, Eq. 12). Supports re-referencing: common average, single-electrode, or ideal reference-free recording.</dcterms:description>
        <rdfs:label>EEG</rdfs:label>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/eeg/parameters/conductivity"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/eeg/parameters/reference_electrode"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/global_average -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/global_average">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>Spatial mean across all network nodes at each sampling period. Reduces spatial dimension to a single global signal per state variable.</dcterms:description>
        <rdfs:label>GlobalAverage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/ieeg -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/ieeg">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>Forward solution for intracranial/stereoelectroencephalography (SEEG). Projects source activity through a lead field matrix to implanted depth electrode contacts. Uses the same single-sphere analytic formula as scalp EEG (Sarvas 1987, Eq. 12), but with electrode positions inside the brain volume.</dcterms:description>
        <rdfs:label>iEEG</rdfs:label>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/ieeg/parameters/conductivity"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/meg -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/meg">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>Forward solution for magnetoencephalography. Projects source neural activity through a lead field matrix to MEG sensor locations using oriented gradiometers. If no precomputed gain is available, uses the single-sphere analytic formula (Sarvas 1987, Eq. 25) for the magnetic field produced by current dipoles in a conducting sphere.</dcterms:description>
        <rdfs:label>MEG</rdfs:label>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/meg/parameters/permeability"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/raw -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/raw">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>Records all state variables at every integration step without any transformation. Identity passthrough of the full simulation state.</dcterms:description>
        <rdfs:label>Raw</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/spatial_average -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/spatial_average">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>Computes spatially averaged signals within regions defined by a spatial mask (node-to-region assignment). The mask assigns each node to a region index, and the output is the mean signal per region.</dcterms:description>
        <rdfs:label>SpatialAverage</rdfs:label>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/observation_models/spatial_average/parameters/spatial_mask"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/subsample -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/subsample">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>Temporal decimation of selected state variables. Records every N-th integration step without any averaging or smoothing.</dcterms:description>
        <rdfs:label>SubSample</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/temporal_average -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/temporal_average">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Observation"/>
        <dcterms:description>Running temporal mean over a sliding window of configurable length. Returns one averaged sample per period.</dcterms:description>
        <rdfs:label>TemporalAverage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/FC/parameters/TR -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/FC/parameters/TR">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Repetition time</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">720.0</schema1:defaultValue>
        <rdfs:label>TR (FC parameter)</rdfs:label>
        <skos:notation>TR</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/FC/parameters/fisher_z -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/FC/parameters/fisher_z">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Apply Fisher z-transformation to correlations</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</schema1:defaultValue>
        <rdfs:label>fisher_z (FC parameter)</rdfs:label>
        <skos:notation>fisher_z</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/bold_double_exponential/parameters/TR -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/bold_double_exponential/parameters/TR">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2000.0</schema1:defaultValue>
        <rdfs:label>TR (bold_double_exponential parameter)</rdfs:label>
        <skos:notation>TR</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/bold_gamma/parameters/TR -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/bold_gamma/parameters/TR">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2000.0</schema1:defaultValue>
        <rdfs:label>TR (bold_gamma parameter)</rdfs:label>
        <skos:notation>TR</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/bold_mixture_of_gammas/parameters/TR -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/bold_mixture_of_gammas/parameters/TR">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2000.0</schema1:defaultValue>
        <rdfs:label>TR (bold_mixture_of_gammas parameter)</rdfs:label>
        <skos:notation>TR</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/bold_region_roi/parameters/hrf_length -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/bold_region_roi/parameters/hrf_length">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">20000.0</schema1:defaultValue>
        <rdfs:label>hrf_length (bold_region_roi parameter)</rdfs:label>
        <skos:notation>hrf_length</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/bold_tvb/parameters/TR -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/bold_tvb/parameters/TR">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Repetition time (sampling period)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">720.0</schema1:defaultValue>
        <rdfs:label>TR (bold_tvb parameter)</rdfs:label>
        <skos:notation>TR</skos:notation>
        <tvbo:unit>ms</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/eeg/parameters/conductivity -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/eeg/parameters/conductivity">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Volume conductor conductivity for the single-sphere analytic approximation. Only used when no precomputed gain is available.</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>conductivity (eeg parameter)</rdfs:label>
        <skos:notation>conductivity</skos:notation>
        <tvbo:unit>S_per_m</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/eeg/parameters/reference_electrode -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/eeg/parameters/reference_electrode">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Re-referencing scheme. Options: - Electrode label (e.g. &quot;Cz&quot;): subtract that electrode signal - &quot;average&quot;: subtract mean across all channels - null: ideal reference-free recording</dcterms:description>
        <rdfs:label>reference_electrode (eeg parameter)</rdfs:label>
        <skos:notation>reference_electrode</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/ieeg/parameters/conductivity -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/ieeg/parameters/conductivity">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Tissue conductivity for the analytic point-dipole approximation. Only used when no precomputed gain is available.</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>conductivity (ieeg parameter)</rdfs:label>
        <skos:notation>conductivity</skos:notation>
        <tvbo:unit>S_per_m</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/meg/parameters/permeability -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/meg/parameters/permeability">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Magnetic constant (permeability of free space)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.256637E-6</schema1:defaultValue>
        <rdfs:label>permeability (meg parameter)</rdfs:label>
        <skos:notation>permeability</skos:notation>
        <tvbo:unit>H_per_m</tvbo:unit>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/observation_models/spatial_average/parameters/spatial_mask -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/observation_models/spatial_average/parameters/spatial_mask">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Vector of length N_nodes mapping each node to a region index (0-indexed). Inferred from network topology if not provided.</dcterms:description>
        <rdfs:label>spatial_mask (spatial_average parameter)</rdfs:label>
        <skos:notation>spatial_mask</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/AUTO-07p -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/AUTO-07p">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>A software package for continuation and bifurcation problems in ordinary differential equations. The standard tool for numerical continuation in dynamical systems since 1980.</dcterms:description>
        <dcterms:license>BSD-2-Clause</dcterms:license>
        <schema1:codeRepository>https://github.com/auto-07p/auto-07p</schema1:codeRepository>
        <schema1:identifier>10.1007/978-1-4614-6141-2_3</schema1:identifier>
        <schema1:url>https://github.com/auto-07p/auto-07p</schema1:url>
        <rdfs:label>AUTO-07p</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/Arbor -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/Arbor">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>A high-performance library for computational neuroscience simulation with native support for morphologically detailed neuron models on modern hardware including GPUs and many-core CPUs.</dcterms:description>
        <dcterms:license>BSD-2-Clause</dcterms:license>
        <schema1:codeRepository>https://github.com/arbor-sim/arbor</schema1:codeRepository>
        <schema1:identifier>10.5281/zenodo.1459679</schema1:identifier>
        <schema1:url>https://arbor-sim.org</schema1:url>
        <rdfs:label>Arbor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/BSB -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/BSB">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>Brain Scaffold Builder — a framework for reconstructing and simulating data-driven brain tissue models using morphological and connectivity scaffolds.</dcterms:description>
        <dcterms:license>Apache-2.0</dcterms:license>
        <schema1:codeRepository>https://github.com/dbbs-lab/bsb-core</schema1:codeRepository>
        <schema1:url>https://bsb.readthedocs.io</schema1:url>
        <rdfs:label>BSB</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/BifurcationKit.jl -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/BifurcationKit.jl">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>A Julia package for bifurcation analysis of large-dimensional equations. Supports continuation of equilibria, periodic orbits, and detection of bifurcation points for ODE and PDE systems.</dcterms:description>
        <dcterms:license>MIT</dcterms:license>
        <schema1:codeRepository>https://github.com/bifurcationkit/BifurcationKit.jl</schema1:codeRepository>
        <schema1:identifier>10.21105/joss.06316</schema1:identifier>
        <schema1:url>https://bifurcationkit.github.io/BifurcationKitDocs.jl/stable/</schema1:url>
        <rdfs:label>BifurcationKit.jl</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/BluePyOpt -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/BluePyOpt">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>Blue Brain Python Optimisation Library — a framework for data-driven model parameter optimisation using multi-objective evolutionary algorithms on NEURON models.</dcterms:description>
        <dcterms:license>LGPL-3.0-only</dcterms:license>
        <schema1:codeRepository>https://github.com/BlueBrain/BluePyOpt</schema1:codeRepository>
        <schema1:identifier>10.3389/fninf.2016.00017</schema1:identifier>
        <schema1:url>https://bluepyopt.readthedocs.io</schema1:url>
        <rdfs:label>BluePyOpt</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/BrainBrowser -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/BrainBrowser">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>A set of JavaScript visualization tools for rendering brain surfaces, volumes, and connectivity data in the browser using WebGL.</dcterms:description>
        <dcterms:license>MIT</dcterms:license>
        <schema1:codeRepository>https://github.com/aces/brainbrowser</schema1:codeRepository>
        <schema1:url>https://brainbrowser.cbrain.mcgill.ca</schema1:url>
        <rdfs:label>BrainBrowser</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/BrainPy -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/BrainPy">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>A flexible, efficient, and extensible framework for computational neuroscience and brain-inspired computation built on JAX. Supports spiking, rate-based, and mean-field models at all scales.</dcterms:description>
        <dcterms:license>Apache-2.0</dcterms:license>
        <schema1:codeRepository>https://github.com/brainpy/BrainPy</schema1:codeRepository>
        <schema1:identifier>10.7554/eLife.86365</schema1:identifier>
        <schema1:url>https://brainpy.readthedocs.io</schema1:url>
        <rdfs:label>BrainPy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/BrainSimII -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/BrainSimII">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>A neural simulator exploring AGI-inspired approaches to brain simulation, with a focus on large-scale spiking neuron models and real-time interaction.</dcterms:description>
        <dcterms:license>MIT</dcterms:license>
        <schema1:codeRepository>https://github.com/FutureAIGuru/BrainSimII</schema1:codeRepository>
        <rdfs:label>BrainSimII</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/Brainstorm -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/Brainstorm">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>A collaborative, open-source application for MEG/EEG/sEEG/ECoG/fNIRS data analysis, visualization, and source localization.</dcterms:description>
