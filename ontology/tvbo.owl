        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>S_i (ZerlautAdaptationFirstOrder parameter)</rdfs:label>
        <skos:definition>Scaling of the remote input for the inhibitory population with
        respect to the excitatory population.</skos:definition>
        <skos:notation>S_i</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/T -->

