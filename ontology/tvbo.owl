    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/SPM">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>Statistical Parametric Mapping — software for the analysis of brain imaging data sequences (fMRI, PET, SPECT, EEG, MEG). Standard tool for voxel-based and DCM analyses.</dcterms:description>
        <dcterms:license>GPL-2.0-or-later</dcterms:license>
        <schema1:codeRepository>https://github.com/spm/spm</schema1:codeRepository>
