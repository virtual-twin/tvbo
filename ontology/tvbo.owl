        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>none (DomainEnforcement)</rdfs:label>
        <skos:definition>Metadata only; the trajectory is never constrained (default).</skos:definition>
        <skos:notation>none</skos:notation>
    </owl:Class>
    


    <!-- https://w3id.org/tvbo/DomainEnforcement#wrap -->

    <owl:Class rdf:about="https://w3id.org/tvbo/DomainEnforcement#wrap">
