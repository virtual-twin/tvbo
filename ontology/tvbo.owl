    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/software/STEPS -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/software/STEPS">
        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>STochastic Engine for Pathway Simulation — a stochastic reaction-diffusion simulator for modeling biochemical signaling pathways in realistic 3D cellular morphologies.</dcterms:description>
        <dcterms:license>GPL-3.0-only</dcterms:license>
        <schema1:codeRepository>https://github.com/CNS-OIST/STEPS</schema1:codeRepository>
