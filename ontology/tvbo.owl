    <owl:Class rdf:about="https://w3id.org/tvbo/SpecimenEnum">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/SpecimenEnum#Subject"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/SpecimenEnum#SubjectGroup"/>
