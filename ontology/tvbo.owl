        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>A unified framework for spike sorting, providing a common interface to many spike sorting algorithms, preprocessing tools, and quality metrics.</dcterms:description>
        <dcterms:license>MIT</dcterms:license>
        <schema1:codeRepository>https://github.com/SpikeInterface/spikeinterface</schema1:codeRepository>
