    <!-- http://uri.interlex.org/tgbugs/uris/readable/BrainAtlas -->

    <owl:Class rdf:about="http://uri.interlex.org/tgbugs/uris/readable/BrainAtlas">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uri.interlex.org/tgbugs/uris/readable/abbreviation"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uri.interlex.org/tgbugs/uris/readable/author"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uri.interlex.org/tgbugs/uris/readable/coordinateSpace"/>
                <owl:allValuesFrom rdf:resource="http://uri.interlex.org/tgbugs/uris/readable/CommonCoordinateSpace"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uri.interlex.org/tgbugs/uris/readable/isVersionOf"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uri.interlex.org/tgbugs/uris/readable/terminology"/>
                <owl:allValuesFrom rdf:resource="http://uri.interlex.org/tgbugs/uris/readable/ParcellationTerminology"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
