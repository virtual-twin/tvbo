        <rdfs:label>K_21 (StefanescuJirsa3D parameter)</rdfs:label>
        <skos:definition>Internal coupling, excitatory to inhibitory.</skos:definition>
        <skos:notation>K_21</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>a (StefanescuJirsa3D parameter)</rdfs:label>
