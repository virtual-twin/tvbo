        <rdf:type rdf:resource="https://w3id.org/tvbo/Continuation"/>
        <dcterms:description>Comprehensive bifurcation analysis of the Generic2dOscillator. Continues the equilibrium branch as parameter a is varied, detects fold and Hopf bifurcations, then branches to periodic orbits from both Hopf points with fine-tuned solver settings.</dcterms:description>
        <rdfs:label>eq_in_a_full</rdfs:label>
    </owl:NamedIndividual>
    


