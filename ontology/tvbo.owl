        <skos:notation>d</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/parameters/mu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/parameters/mu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.3</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>mu (StefanescuJirsa3D parameter)</rdfs:label>
        <skos:definition>Mean of the Gaussian heterogeneity distribution.</skos:definition>
        <skos:notation>mu</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/parameters/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/parameters/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.006</schema1:defaultValue>
        <rdfs:label>r (StefanescuJirsa3D parameter)</rdfs:label>
        <skos:definition>Adaptation parameter (Hindmarsh-Rose r).</skos:definition>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/parameters/s -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/parameters/s">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.0</schema1:defaultValue>
        <rdfs:label>s (StefanescuJirsa3D parameter)</rdfs:label>
        <skos:definition>Adaptation feedback parameter.</skos:definition>
        <skos:notation>s</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/parameters/sigma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/parameters/sigma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>sigma (StefanescuJirsa3D parameter)</rdfs:label>
        <skos:definition>Standard deviation of the Gaussian heterogeneity distribution.</skos:definition>
        <skos:notation>sigma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/parameters/x_0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/parameters/x_0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.6</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>x_0 (StefanescuJirsa3D parameter)</rdfs:label>
        <skos:definition>Leftmost equilibrium point of x in the Hindmarsh-Rose oscillator.</skos:definition>
        <skos:notation>x_0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Inhibitory fast variable (per mode).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>alpha (StefanescuJirsa3D state variable)</rdfs:label>
        <skos:notation>alpha</skos:notation>
        <tvbo:lhs>Derivative(alpha, t)</tvbo:lhs>
        <tvbo:rhs>beta - e_i*alpha**3 + f_i*alpha**2 - gamma + K_21*(C_ik*xi - alpha) + II_i + c_pop0 + local_coupling*xi</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/beta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/beta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Inhibitory recovery variable (per mode).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>beta (StefanescuJirsa3D state variable)</rdfs:label>
        <skos:notation>beta</skos:notation>
        <tvbo:lhs>Derivative(beta, t)</tvbo:lhs>
        <tvbo:rhs>h_i - p_i*alpha**2 - beta</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Excitatory recovery variable (per mode).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>eta (StefanescuJirsa3D state variable)</rdfs:label>
        <skos:notation>eta</skos:notation>
        <tvbo:lhs>Derivative(eta, t)</tvbo:lhs>
        <tvbo:rhs>c_i - d_i*xi**2 - eta</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/gamma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/gamma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Inhibitory slow adaptation variable (per mode).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060080"/>
        <rdfs:label>gamma (StefanescuJirsa3D state variable)</rdfs:label>
        <skos:notation>gamma</skos:notation>
        <tvbo:lhs>Derivative(gamma, t)</tvbo:lhs>
        <tvbo:rhs>r*s*alpha - r*gamma - n_i</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Excitatory slow adaptation variable (per mode).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>tau (StefanescuJirsa3D state variable)</rdfs:label>
        <skos:notation>tau</skos:notation>
        <tvbo:lhs>Derivative(tau, t)</tvbo:lhs>
        <tvbo:rhs>r*s*xi - r*tau - m_i</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/xi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/state_variables/xi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Excitatory fast variable (per mode).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>xi (StefanescuJirsa3D state variable)</rdfs:label>
        <skos:notation>xi</skos:notation>
        <tvbo:lhs>Derivative(xi, t)</tvbo:lhs>
        <tvbo:rhs>eta - a_i*xi**3 + b_i*xi**2 - tau + K_11*(A_ik*xi - xi) - K_12*(B_ik*alpha - xi) + IE_i + c_pop0 + local_coupling*xi</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/SupHopf/derived_variables/lc_0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/SupHopf/derived_variables/lc_0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>lc_0 (SupHopf derived variable)</rdfs:label>
        <skos:notation>lc_0</skos:notation>
        <tvbo:lhs>lc_0</tvbo:lhs>
        <tvbo:rhs>local_coupling*x</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/SupHopf/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/SupHopf/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Local bifurcation parameter</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-0.5</schema1:defaultValue>
        <rdfs:label>a (SupHopf parameter)</rdfs:label>
        <skos:definition>Local bifurcation parameter.</skos:definition>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/SupHopf/parameters/omega -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/SupHopf/parameters/omega">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Angular frequency</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema1:defaultValue>
        <rdfs:label>omega (SupHopf parameter)</rdfs:label>
        <skos:definition>Angular frequency.</skos:definition>
        <skos:notation>omega</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/SupHopf/state_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/SupHopf/state_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>First state-variable of the Supercritical Hopf model</dcterms:description>
        <rdfs:label>x (SupHopf state variable)</rdfs:label>
        <skos:notation>x</skos:notation>
        <tvbo:lhs>Derivative(x, t)</tvbo:lhs>
        <tvbo:rhs>c_pop0 + lc_0 - omega*y + x*(a - x**2 - y**2)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/SupHopf/state_variables/y -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/SupHopf/state_variables/y">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Second state-variable of the Supercritical Hopf model</dcterms:description>
        <rdfs:label>y (SupHopf state variable)</rdfs:label>
        <skos:notation>y</skos:notation>
        <tvbo:lhs>Derivative(y, t)</tvbo:lhs>
        <tvbo:rhs>c_pop1 + omega*x + y*(a - x**2 - y**2)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/derived_variables/SS0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/derived_variables/SS0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Total synaptic input (recurrent + external)</dcterms:description>
        <rdfs:label>SS0 (TsodyksMarkram derived variable)</rdfs:label>
        <skos:notation>SS0</skos:notation>
        <tvbo:lhs>SS0</tvbo:lhs>
        <tvbo:rhs>J*u*x*E + E0</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/derived_variables/SS1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/derived_variables/SS1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Softplus transfer function output</dcterms:description>
        <rdfs:label>SS1 (TsodyksMarkram derived variable)</rdfs:label>
        <skos:notation>SS1</skos:notation>
        <tvbo:lhs>SS1</tvbo:lhs>
        <tvbo:rhs>alpha*log(1 + exp(SS0/alpha))</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/parameters/E0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/parameters/E0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External input (baseline excitability)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-2.0</schema1:defaultValue>
        <rdfs:label>E0 (TsodyksMarkram parameter)</rdfs:label>
        <skos:notation>E0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/parameters/J -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/parameters/J">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Synaptic coupling strength</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.07</schema1:defaultValue>
        <rdfs:label>J (TsodyksMarkram parameter)</rdfs:label>
        <skos:notation>J</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/parameters/U0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/parameters/U0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Baseline release probability</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3</schema1:defaultValue>
        <rdfs:label>U0 (TsodyksMarkram parameter)</rdfs:label>
        <skos:notation>U0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/parameters/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/parameters/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Softplus nonlinearity steepness (smoothed threshold gain)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema1:defaultValue>
        <rdfs:label>alpha (TsodyksMarkram parameter)</rdfs:label>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Membrane time constant (firing rate relaxation)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.013</schema1:defaultValue>
        <rdfs:label>tau (TsodyksMarkram parameter)</rdfs:label>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/parameters/tauD -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/parameters/tauD">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Synaptic depression recovery time constant</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.2</schema1:defaultValue>
        <rdfs:label>tauD (TsodyksMarkram parameter)</rdfs:label>
        <skos:notation>tauD</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/parameters/tauF -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/parameters/tauF">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>Synaptic facilitation decay time constant</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.5</schema1:defaultValue>
        <rdfs:label>tauF (TsodyksMarkram parameter)</rdfs:label>
        <skos:notation>tauF</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/state_variables/E -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/state_variables/E">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Mean firing rate of the excitatory population</dcterms:description>
        <rdfs:label>E (TsodyksMarkram state variable)</rdfs:label>
        <skos:notation>E</skos:notation>
        <tvbo:lhs>Derivative(E, t)</tvbo:lhs>
        <tvbo:rhs>(-E + SS1)/tau</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/state_variables/u -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/state_variables/u">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Synaptic facilitation variable (release probability). Decays to U0 with time constant tauF and is enhanced proportionally to firing.</dcterms:description>
        <rdfs:label>u (TsodyksMarkram state variable)</rdfs:label>
        <skos:notation>u</skos:notation>
        <tvbo:lhs>Derivative(u, t)</tvbo:lhs>
        <tvbo:rhs>(U0 - u)/tauF + U0*(1 - u)*E</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/TsodyksMarkram/state_variables/x -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/TsodyksMarkram/state_variables/x">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <dcterms:description>Synaptic depression variable (fraction of available neurotransmitter). Recovers to 1 with time constant tauD and is depleted proportionally to firing.</dcterms:description>
        <rdfs:label>x (TsodyksMarkram state variable)</rdfs:label>
        <skos:notation>x</skos:notation>
        <tvbo:lhs>Derivative(x, t)</tvbo:lhs>
        <tvbo:rhs>(1 - x)/tauD - u*x*E</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/derived_variables/lc_0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/derived_variables/lc_0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>lc_0 (WilsonCowan derived variable)</rdfs:label>
        <skos:notation>lc_0</skos:notation>
        <tvbo:lhs>lc_0</tvbo:lhs>
        <tvbo:rhs>local_coupling*E</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/derived_variables/lc_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/derived_variables/lc_1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>lc_1 (WilsonCowan derived variable)</rdfs:label>
        <skos:notation>lc_1</skos:notation>
        <tvbo:lhs>lc_1</tvbo:lhs>
        <tvbo:rhs>I*local_coupling</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/derived_variables/s_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/derived_variables/s_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>s_e (WilsonCowan derived variable)</rdfs:label>
        <skos:notation>s_e</skos:notation>
        <tvbo:lhs>s_e</tvbo:lhs>
        <tvbo:rhs>c_e/(1.0 + exp(-a_e*(-b_e + x_e))) - 1.0*shift_sigmoid/(exp(a_e*b_e) + 1.0)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/derived_variables/s_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/derived_variables/s_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <rdfs:label>s_i (WilsonCowan derived variable)</rdfs:label>
        <skos:notation>s_i</skos:notation>
        <tvbo:lhs>s_i</tvbo:lhs>
        <tvbo:rhs>c_i/(1.0 + exp(-a_i*(-b_i + x_i))) - 1.0*shift_sigmoid/(exp(a_i*b_i) + 1.0)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/derived_variables/x_e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/derived_variables/x_e">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Average level of excitation in excitatory neuron at time t. Can be interpreted as membrane potential (Sanz-Leon et al., 2015).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>x_e (WilsonCowan derived variable)</rdfs:label>
        <skos:notation>x_e</skos:notation>
        <tvbo:lhs>x_e</tvbo:lhs>
        <tvbo:rhs>alpha_e*(-I*c_ei + P + c_ee*E + c_pop0 + lc_0 + lc_1 - theta_e)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/derived_variables/x_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/derived_variables/x_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/DerivedVariable"/>
        <dcterms:description>Average level of excitation in inhibitory neuron at time t. Can be interpreted as membrane potential. (Sanz-Leon et al., 2015).</dcterms:description>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:label>x_i (WilsonCowan derived variable)</rdfs:label>
        <skos:notation>x_i</skos:notation>
        <tvbo:lhs>x_i</tvbo:lhs>
        <tvbo:rhs>alpha_i*(-I*c_ii + Q + c_ie*E + lc_0 + lc_1 - theta_i)</tvbo:rhs>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/P -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/WilsonCowan/parameters/P">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <dcterms:description>External stimulus to the excitatory population (Wilson and Cowan, 1972)</dcterms:description>
        <schema1:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema1:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0060079"/>
        <rdfs:label>P (WilsonCowan parameter)</rdfs:label>
        <skos:definition>External stimulus to the excitatory population (Wilson and Cowan, 1972).</skos:definition>
        <skos:notation>P</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/WilsonCowan/parameters/Q -->

