    <!-- https://w3id.org/tvbo/atlases/tpl-FSLMNI152_atlas-Schaefer2018_seg-17Networks_scale-1000_dseg -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/atlases/tpl-FSLMNI152_atlas-Schaefer2018_seg-17Networks_scale-1000_dseg">
        <rdf:type rdf:resource="http://uri.interlex.org/tgbugs/uris/readable/BrainAtlas"/>
