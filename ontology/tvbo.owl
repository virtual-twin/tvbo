    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/p_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/StefanescuJirsa3D/derived_variables/p_i">
