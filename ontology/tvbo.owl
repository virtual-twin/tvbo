        <tvbo:hasDerivedVariable rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/derived_variables/x_i"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/ReducedWongWangExcInh/parameters/G"/>
