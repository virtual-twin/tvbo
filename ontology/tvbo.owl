        <rdf:type rdf:resource="https://w3id.org/tvbo/SoftwarePackage"/>
        <dcterms:description>Differentiable whole-brain simulation and optimization framework using JAX. Supports gradient-based fitting of neural mass models to empirical neuroimaging data.</dcterms:description>
