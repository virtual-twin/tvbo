    <!-- https://w3id.org/tvbo/ParallelMode -->

    <owl:Class rdf:about="https://w3id.org/tvbo/ParallelMode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ParallelMode#auto"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ParallelMode#lax_map"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ParallelMode#pmap"/>
                    <rdf:Description rdf:about="https://w3id.org/tvbo/ParallelMode#vmap"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/tvbo/struct"/>
        <rdfs:label>ParallelMode</rdfs:label>
        <skos:definition>How a trial / grid-point axis is realised at JAX codegen time. The choice trades peak memory against throughput: vmap batches in parallel (fast, n_trials × working-set memory), lax_map runs sequentially via ``jax.lax.map`` (memory bounded by one trial), pmap shards across devices, auto picks vmap when the estimated batched memory fits and lax_map otherwise.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ParallelMode#auto"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ParallelMode#lax_map"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ParallelMode#pmap"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/tvbo/ParallelMode#vmap"/>
    </owl:Class>
    


