    <!-- https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/P2_i -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ZerlautAdaptationFirstOrder/parameters/P2_i">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
