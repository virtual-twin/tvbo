        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/Epileptor5D/parameters/b"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/Epileptor5D/parameters/bb"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/Epileptor5D/parameters/c"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/Epileptor5D/parameters/d"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/Epileptor5D/parameters/modification"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/Epileptor5D/parameters/r"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/Epileptor5D/parameters/s"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/Epileptor5D/parameters/slope"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/Epileptor5D/parameters/tau"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/Epileptor5D/parameters/tt"/>
        <tvbo:hasParameter rdf:resource="https://w3id.org/tvbo/Epileptor5D/parameters/x0"/>
