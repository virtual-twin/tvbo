        <rdfs:label>n_threads (slot)</rdfs:label>
        <skos:definition>Number of CPU threads per worker (-1 = auto-detect)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/tvbo"/>
        <skos:notation>n_threads</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/tvbo/n_trials -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/tvbo/n_trials">
        <rdfs:label>n_trials (slot)</rdfs:label>
