        <dcterms:description>A Python module for fitting, simulating, and analyzing optogenetic rhodopsin photocurrent models. Integrates with NEURON and Brian2.</dcterms:description>
        <dcterms:license>BSD-3-Clause</dcterms:license>
        <schema1:codeRepository>https://github.com/ProjectPyRhO/PyRhO</schema1:codeRepository>
