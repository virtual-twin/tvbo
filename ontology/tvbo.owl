    <!-- https://w3id.org/tvbo/Epileptor2D -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/Epileptor2D">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Dynamics"/>
