        <skos:notation>y0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y1">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>y4</tvbo:rhs>
        <rdfs:label>y1 (ModelJansen1995 state variable)</rdfs:label>
        <skos:notation>y1</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y2">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>y5</tvbo:rhs>
        <rdfs:label>y2 (ModelJansen1995 state variable)</rdfs:label>
        <skos:notation>y2</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y3">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>A*a*Sigm(y1 - y2) - 2*a*y3 - a**2*y0</tvbo:rhs>
        <rdfs:label>y3 (ModelJansen1995 state variable)</rdfs:label>
        <skos:notation>y3</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>A*a*(p + C2*Sigm(C1*y0) + c_glob) - 2*a*y4 - a**2*y1</tvbo:rhs>
        <rdfs:label>y4 (ModelJansen1995 state variable)</rdfs:label>
        <skos:notation>y4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ModelJansen1995/state_variables/y5 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ModelJansen1995/state_variables/y5">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:rhs>B*b*(C4*Sigm(C3*y0)) - 2*b*y5 - b**2*y2</tvbo:rhs>
        <rdfs:label>y5 (ModelJansen1995 state variable)</rdfs:label>
        <skos:notation>y5</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/Delta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/Delta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Mean heterogeneous noise</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0061669"/>
        <rdfs:label>Delta (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>Mean heterogeneous noise</skos:definition>
        <skos:notation>Delta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/I -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/I">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>External Current</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>I (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>External Current</skos:definition>
        <skos:notation>I</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/J -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/J">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Mean Synaptic weight</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">15.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099536"/>
        <rdfs:label>J (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>Mean Synaptic weight.</skos:definition>
        <skos:notation>J</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/cr -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/cr">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>It is the weight on Coupling through variable r</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>cr (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable r.</skos:definition>
        <skos:notation>cr</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/cv -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/cv">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>It is the weight on Coupling through variable V</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>cv (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>It is the weight on Coupling through variable V.</skos:definition>
        <skos:notation>cv</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Constant parameter to scale the rate of feedback from the firing rate variable to itself</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-5.0</schema:defaultValue>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GO_0099605"/>
        <rdfs:label>eta (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>Constant parameter to scale the rate of feedback from the firing rate variable to itself</skos:definition>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Membrane time constant</terms:description>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</schema:defaultValue>
        <rdfs:label>tau (MontbrioPazoRoxin parameter)</rdfs:label>
        <skos:definition>Membrane time constant</skos:definition>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/state_variables/V -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/state_variables/V">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(V, t)</tvbo:lhs>
        <tvbo:rhs>(I + J*r*tau + V**2 + c_glob0*cr*tau + c_glob1*cv + eta - pi**2*r**2*tau**2)/tau</tvbo:rhs>
        <rdfs:label>V (MontbrioPazoRoxin state variable)</rdfs:label>
        <skos:notation>V</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/MontbrioPazoRoxin/state_variables/r -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/MontbrioPazoRoxin/state_variables/r">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(r, t)</tvbo:lhs>
        <tvbo:rhs>(Delta/(pi*tau) + 2*V*r)/tau</tvbo:rhs>
        <rdfs:label>r (MontbrioPazoRoxin state variable)</rdfs:label>
        <skos:notation>r</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/Aik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/Aik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (Aik).</terms:description>
        <schema:defaultValue>[[0.3328165811190223, 0.18525241779532714, 0.3328165811190241], [0.5984537933538554, 0.3331114447027479, 0.5984537933538587], [0.33281658111902046, 0.18525241779532614, 0.33281658111902235]]</schema:defaultValue>
        <rdfs:label>Aik (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>Aik</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/Bik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/Bik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (Bik).</terms:description>
        <schema:defaultValue>[[0.3328165811190223, 0.5984537933538554, 0.33281658111902046], [0.18525241779532714, 0.3331114447027479, 0.18525241779532614], [0.3328165811190241, 0.5984537933538587, 0.33281658111902235]]</schema:defaultValue>
        <rdfs:label>Bik (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>Bik</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/Cik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/Cik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (Cik).</terms:description>
        <schema:defaultValue>[[0.3328165811190223, 0.18525241779532714, 0.3328165811190241], [0.5984537933538554, 0.3331114447027479, 0.5984537933538587], [0.33281658111902046, 0.18525241779532614, 0.33281658111902235]]</schema:defaultValue>
        <rdfs:label>Cik (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>Cik</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/K11 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/K11">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5</schema:defaultValue>
        <rdfs:label>K11 (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>K11</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/K12 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/K12">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.15</schema:defaultValue>
        <rdfs:label>K12 (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>K12</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/K21 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/K21">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.15</schema:defaultValue>
        <rdfs:label>K21 (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>K21</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/a -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/a">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.45</schema:defaultValue>
        <rdfs:label>a (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>a</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/b">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.9</schema:defaultValue>
        <rdfs:label>b (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>b</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iU0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iU0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iU0).</terms:description>
        <schema:defaultValue>[1.6668762461300366, 0.9278169186250886, 1.666876246130046]</schema:defaultValue>
        <rdfs:label>iU0 (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>iU0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iU4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iU4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iU4).</terms:description>
        <schema:defaultValue>[0.35990947874643836, 1.1616503426964113, 0.3599094787464342]</schema:defaultValue>
        <rdfs:label>iU4 (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>iU4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iV0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iV0">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iV0).</terms:description>
        <schema:defaultValue>[1.6668762461300366, 0.9278169186250886, 1.666876246130046]</schema:defaultValue>
        <rdfs:label>iV0 (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>iV0</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iV4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iV4">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iV4).</terms:description>
        <schema:defaultValue>[0.35990947874643836, 1.1616503426964113, 0.3599094787464342]</schema:defaultValue>
        <rdfs:label>iV4 (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>iV4</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iZU -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iZU">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iZU).</terms:description>
        <schema:defaultValue>[-3.033148827134955, 1.3877787807814457e-17, 3.033148827134998]</schema:defaultValue>
        <rdfs:label>iZU (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>iZU</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iZV -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/iZV">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (iZV).</terms:description>
        <schema:defaultValue>[-3.033148827134955, 1.3877787807814457e-17, 3.033148827134998]</schema:defaultValue>
        <rdfs:label>iZV (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>iZV</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/mu -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/mu">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</schema:defaultValue>
        <rdfs:label>mu (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>mu</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/sigma -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/sigma">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.35</schema:defaultValue>
        <rdfs:label>sigma (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>sigma</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/tau -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/parameters/tau">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <schema:defaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</schema:defaultValue>
        <rdfs:label>tau (ReducedSetFitzHughNagumo parameter)</rdfs:label>
        <skos:notation>tau</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/alpha -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/alpha">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(alpha, t)</tvbo:lhs>
        <tvbo:rhs>tau*(alpha - f_i*alpha**3/3 - beta) + K21*(mode_dot(xi, Cik) - alpha) + tau*(II_i + mode_sum(c_glob0) + local_coupling*xi)</tvbo:rhs>
        <rdfs:label>alpha (ReducedSetFitzHughNagumo state variable)</rdfs:label>
        <skos:notation>alpha</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/beta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/beta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(beta, t)</tvbo:lhs>
        <tvbo:rhs>(alpha - b*beta + n_i)/tau</tvbo:rhs>
        <rdfs:label>beta (ReducedSetFitzHughNagumo state variable)</rdfs:label>
        <skos:notation>beta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/eta -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/eta">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(eta, t)</tvbo:lhs>
        <tvbo:rhs>(xi - b*eta + m_i)/tau</tvbo:rhs>
        <rdfs:label>eta (ReducedSetFitzHughNagumo state variable)</rdfs:label>
        <skos:notation>eta</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/xi -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetFitzHughNagumo/state_variables/xi">
        <rdf:type rdf:resource="https://w3id.org/tvbo/StateVariable"/>
        <tvbo:lhs>Derivative(xi, t)</tvbo:lhs>
        <tvbo:rhs>tau*(xi - e_i*xi**3/3 - eta) + K11*(mode_dot(xi, Aik) - xi) - K12*(mode_dot(alpha, Bik) - xi) + tau*(IE_i + mode_sum(c_glob0) + local_coupling*xi)</tvbo:rhs>
        <rdfs:label>xi (ReducedSetFitzHughNagumo state variable)</rdfs:label>
        <skos:notation>xi</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/A_ik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/A_ik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (A_ik).</terms:description>
        <schema:defaultValue>[[0.3328165811190223, 0.18525241779532714, 0.3328165811190241], [0.5984537933538554, 0.3331114447027479, 0.5984537933538587], [0.33281658111902046, 0.18525241779532614, 0.33281658111902235]]</schema:defaultValue>
        <rdfs:label>A_ik (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>A_ik</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/B_ik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/B_ik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (B_ik).</terms:description>
        <schema:defaultValue>[[0.3328165811190223, 0.5984537933538554, 0.33281658111902046], [0.18525241779532714, 0.3331114447027479, 0.18525241779532614], [0.3328165811190241, 0.5984537933538587, 0.33281658111902235]]</schema:defaultValue>
        <rdfs:label>B_ik (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>B_ik</skos:notation>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/C_ik -->

    <owl:NamedIndividual rdf:about="https://w3id.org/tvbo/ReducedSetHindmarshRose/parameters/C_ik">
        <rdf:type rdf:resource="https://w3id.org/tvbo/Parameter"/>
        <terms:description>Fixed SJ_2008 quadrature constant (C_ik).</terms:description>
        <schema:defaultValue>[[0.3328165811190223, 0.18525241779532714, 0.3328165811190241], [0.5984537933538554, 0.3331114447027479, 0.5984537933538587], [0.33281658111902046, 0.18525241779532614, 0.33281658111902235]]</schema:defaultValue>
        <rdfs:label>C_ik (ReducedSetHindmarshRose parameter)</rdfs:label>
        <skos:notation>C_ik</skos:notation>
    </owl:NamedIndividual>
    


