@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix tvbounit: <https://w3id.org/tvbo/units/> .

<https://w3id.org/tvbo/units/> a owl:Ontology ;
    rdfs:comment "Unit facts vendored from QUDT. Generated by scripts/ontology/gen_units.py — do not hand-edit." .

tvbounit:A a qudt:Unit ;
    rdfs:label "A" ;
    rdfs:comment "Ampere" ;
    owl:sameAs unit:A ;
    qudt:conversionMultiplier 1 ;
    qudt:hasDimensionVector qkdv:A0E1L0I0M0H0T0D0 ;
    qudt:hasQuantityKind quantitykind:CurrentLinkage ;
    qudt:hasQuantityKind quantitykind:ElectricCurrent ;
    qudt:hasQuantityKind quantitykind:ElectricCurrentPhasor ;
    qudt:hasQuantityKind quantitykind:MagneticTension ;
    qudt:symbol "A" ;
    qudt:ucumCode "A" .

tvbounit:H_per_m a qudt:Unit ;
    rdfs:label "H_per_m" ;
    rdfs:comment "Henry per metre (permeability)" ;
    owl:sameAs unit:H-PER-M ;
    qudt:conversionMultiplier 1 ;
    qudt:hasDimensionVector qkdv:A0E-2L1I0M1H0T-2D0 ;
    qudt:hasQuantityKind quantitykind:ElectromagneticPermeability ;
    qudt:hasQuantityKind quantitykind:Permeability ;
    qudt:symbol "H/m" ;
    qudt:ucumCode "H.m-1" .

tvbounit:Hz a qudt:Unit ;
    rdfs:label "Hz" ;
    rdfs:comment "Hertz (s⁻¹)" ;
    owl:sameAs unit:HZ ;
    qudt:conversionMultiplier 1 ;
    qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T-1D0 ;
    qudt:hasQuantityKind quantitykind:Frequency ;
    qudt:symbol "Hz" ;
    qudt:ucumCode "Hz" .

tvbounit:Hz_per_nA a qudt:Unit ;
    rdfs:label "Hz_per_nA" ;
    rdfs:comment "Hertz per nanoampere (neural gain)" ;
    qudt:hasFactorUnit [ qudt:hasUnit unit:HZ ; qudt:exponent 1 ] ;
    qudt:hasFactorUnit [ qudt:hasUnit unit:NanoA ; qudt:exponent -1 ] ;
    qudt:conversionMultiplier 1000000000 ;
    qudt:hasDimensionVector qkdv:A0E-1L0I0M0H0T-1D0 .

tvbounit:MW a qudt:Unit ;
    rdfs:label "MW" ;
    rdfs:comment "Megawatt (10⁶ W); grid real/net power" ;
    owl:sameAs unit:MegaW ;
    qudt:conversionMultiplier 1000000 ;
    qudt:hasDimensionVector qkdv:A0E0L2I0M1H0T-3D0 ;
    qudt:hasQuantityKind quantitykind:ElectricPower ;
    qudt:hasQuantityKind quantitykind:Power ;
    qudt:symbol "MW" ;
    qudt:ucumCode "MW" .

tvbounit:Mohm a qudt:Unit ;
    rdfs:label "Mohm" ;
    rdfs:comment "Megaohm (MΩ)" ;
    qudt:hasFactorUnit [ qudt:hasUnit unit:MegaOHM ; qudt:exponent 1 ] ;
    qudt:conversionMultiplier 1000000 ;
    qudt:hasDimensionVector qkdv:A0E-2L2I0M1H0T-3D0 .

tvbounit:N_per_m a qudt:Unit ;
    rdfs:label "N_per_m" ;
    rdfs:comment "Newton per metre (spring constant)" ;
    owl:sameAs unit:N-PER-M ;
    qudt:conversionMultiplier 1 ;
    qudt:hasDimensionVector qkdv:A0E0L0I0M1H0T-2D0 ;
    qudt:hasQuantityKind quantitykind:ForcePerLength ;
    qudt:symbol "N/m" ;
    qudt:ucumCode "N.m-1" .

tvbounit:S_per_cm2 a qudt:Unit ;
    rdfs:label "S_per_cm2" ;
