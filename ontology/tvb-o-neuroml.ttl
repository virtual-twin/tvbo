    dcterms:description "https://docs.biosimulations.org/concepts/conventions/simulation-project-metadata/"@en ;
    rdfs:isDefinedBy tvbo:neuroml ;
    skos:exactMatch neuroml2:foaf_mbox .

nml:foaf_name a owl:Class ;
