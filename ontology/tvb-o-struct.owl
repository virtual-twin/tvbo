    skos:definition "Add all anatomical parent structures for this entity as defined within the corresponding brain atlas." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://www.thevirtualbrain.org/tvb-o/AggregationType#first> a owl:Class ;
