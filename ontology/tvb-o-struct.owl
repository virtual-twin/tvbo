tvbo:PhysicalDimension a owl:Class ;
    rdfs:label "PhysicalDimension" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/PhysicalDimension#none> <https://w3id.org/tvbo/PhysicalDimension#time> <https://w3id.org/tvbo/PhysicalDimension#per_time> <https://w3id.org/tvbo/PhysicalDimension#voltage> <https://w3id.org/tvbo/PhysicalDimension#current> <https://w3id.org/tvbo/PhysicalDimension#capacitance> <https://w3id.org/tvbo/PhysicalDimension#conductance> <https://w3id.org/tvbo/PhysicalDimension#resistance> <https://w3id.org/tvbo/PhysicalDimension#charge> <https://w3id.org/tvbo/PhysicalDimension#concentration> <https://w3id.org/tvbo/PhysicalDimension#substance> <https://w3id.org/tvbo/PhysicalDimension#length> <https://w3id.org/tvbo/PhysicalDimension#volume> <https://w3id.org/tvbo/PhysicalDimension#temperature> ) ;
    skos:definition "Physical dimension categories for LEMS and dimensional analysis. Each dimension decomposes into SI base dimensions (M, L, T, I, K, N)." ;
    skos:inScheme tvbo:units ;
