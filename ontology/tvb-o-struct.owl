tvbo:NumericalDiscretizationMethod a owl:Class ;
    rdfs:label "NumericalDiscretizationMethod" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/NumericalDiscretizationMethod#collocation> <https://w3id.org/tvbo/NumericalDiscretizationMethod#trapezoid> <https://w3id.org/tvbo/NumericalDiscretizationMethod#shooting> <https://w3id.org/tvbo/NumericalDiscretizationMethod#poincare> ) ;
    skos:definition "Numerical discretization method for boundary value problems (periodic orbits, connecting orbits, quasi-periodic tori)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/NumericalDiscretizationMethod#collocation>,
        <https://w3id.org/tvbo/NumericalDiscretizationMethod#poincare>,
        <https://w3id.org/tvbo/NumericalDiscretizationMethod#shooting>,
        <https://w3id.org/tvbo/NumericalDiscretizationMethod#trapezoid> .

tvbo:OperatorType a owl:Class ;
    rdfs:label "OperatorType" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/OperatorType#gradient> <https://w3id.org/tvbo/OperatorType#divergence> <https://w3id.org/tvbo/OperatorType#laplacian> <https://w3id.org/tvbo/OperatorType#curl> ) ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/OperatorType#curl>,
        <https://w3id.org/tvbo/OperatorType#divergence>,
        <https://w3id.org/tvbo/OperatorType#gradient>,
        <https://w3id.org/tvbo/OperatorType#laplacian> .

tvbo:ParallelMode a owl:Class ;
    rdfs:label "ParallelMode" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/ParallelMode#auto> <https://w3id.org/tvbo/ParallelMode#vmap> <https://w3id.org/tvbo/ParallelMode#lax_map> <https://w3id.org/tvbo/ParallelMode#pmap> ) ;
    skos:definition "How a trial / grid-point axis is realised at JAX codegen time. The choice trades peak memory against throughput: vmap batches in parallel (fast, n_trials × working-set memory), lax_map runs sequentially via ``jax.lax.map`` (memory bounded by one trial), pmap shards across devices, auto picks vmap when the estimated batched memory fits and lax_map otherwise." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/ParallelMode#auto>,
        <https://w3id.org/tvbo/ParallelMode#lax_map>,
        <https://w3id.org/tvbo/ParallelMode#pmap>,
        <https://w3id.org/tvbo/ParallelMode#vmap> .

