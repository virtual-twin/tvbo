        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:max_iterations ],
        [ a owl:Restriction ;
