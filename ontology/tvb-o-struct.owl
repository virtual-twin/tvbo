<http://uri.interlex.org/tgbugs/uris/readable/author> a owl:DatatypeProperty ;
    rdfs:label "author" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/defaultImage> a owl:DatatypeProperty ;
    rdfs:label "defaultImage" ;
    skos:definition "Add all image files used as visual representation of this common coordinate space version." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/entities> a owl:ObjectProperty ;
    rdfs:label "entities" ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/hasParent> a owl:ObjectProperty ;
    rdfs:label "hasParent" ;
