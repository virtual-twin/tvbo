tvbo:record a owl:DatatypeProperty ;
    rdfs:label "record (slot)" ;
    rdfs:range xsd:boolean ;
    skos:definition "Names of observations to compute and record at EACH grid point, stacked over the sweep into one array per name. Entries may be derived observations (e.g. `loss`) or `analysis` diagnostics (e.g. `ad_gradient`, `fd_gradient`, `lyapunov`) — this is how a sweep of the diagnostics themselves is declared, replacing any per-point Python driver. Complementary to `observable` (a single scalar reduction); when both are absent the full observation Bunch is recorded.",
        "Whether to include this element in simulation output files. Applicable to state variables (default true), derived variables (default false), and network nodes (default true). On an observation it forces (true) or suppresses (false) persistence in the result; left unset, a terminal observation (one not consumed by another observation or a loss) is recorded and an intermediate one is not. Set false to suppress recording." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "record" .

tvbo:ProgrammingLanguageEnum a owl:Class ;
