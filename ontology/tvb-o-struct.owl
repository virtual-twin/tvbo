<https://w3id.org/tvbo/dbs/score> a owl:ObjectProperty ;
    rdfs:label "score (dbs)" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "score" .

<https://w3id.org/tvbo/dbs/tail> a owl:ObjectProperty ;
    rdfs:label "tail (dbs)" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "tail" .

<https://w3id.org/tvbo/dbs/target_structure> a owl:ObjectProperty ;
    rdfs:label "target_structure (dbs)" ;
    skos:definition "Anatomical target structure from a brain atlas" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "target_structure" .

<https://w3id.org/tvbo/dbs/threshold_applied> a owl:DatatypeProperty ;
    rdfs:label "threshold_applied (dbs)" ;
    skos:definition "Threshold value applied to the E-field simulation" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "threshold_applied" .

<https://w3id.org/tvbo/dbs/time_post_surgery> a owl:DatatypeProperty ;
    rdfs:label "time_post_surgery (dbs)" ;
    skos:definition "Timepoint of assessment in days or months after implantation" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "time_post_surgery" .

<https://w3id.org/tvbo/dbs/timepoint> a owl:DatatypeProperty ;
    rdfs:label "timepoint (dbs)" ;
    skos:definition "Timepoint of assessment (e.g., \"1 month post-op\", \"6 months post-op\")" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "timepoint" .

<https://w3id.org/tvbo/dbs/timing_info> a owl:DatatypeProperty ;
    rdfs:label "timing_info (dbs)" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "timing_info" .

<https://w3id.org/tvbo/dbs/version> a owl:DatatypeProperty ;
    rdfs:label "version (dbs)" ;
    skos:definition "Version of the instrument (e.g., 3.0)" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "version" .

<https://w3id.org/tvbo/dbs/volume_data> a owl:DatatypeProperty ;
    rdfs:label "volume_data (dbs)" ;
    skos:definition "Reference to raw or thresholded volume" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "volume_data" .

tvbo:default a owl:DatatypeProperty ;
    rdfs:label "default (slot)" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "default" .

tvbo:degree a owl:DatatypeProperty ;
    rdfs:label "degree (slot)" ;
    skos:definition "Polynomial degree per mesh interval for collocation. The m in PeriodicOrbitOCollProblem(N, m)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "degree" .

tvbo:delay a owl:DatatypeProperty ;
    rdfs:label "delay (slot)" ;
    skos:definition "Conduction delay (explicit edges, ms)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "delay" .

tvbo:delta_p a owl:DatatypeProperty ;
    rdfs:label "delta_p (slot)" ;
    skos:definition "Initial parameter offset from the bifurcation point." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "delta_p" .

tvbo:derivative_initial_value a owl:DatatypeProperty ;
    rdfs:label "derivative_initial_value (slot)" ;
    skos:definition "Initial value for the first time derivative, used when equation_order > 1. For a second-order ODE d²x/dt² = f, this sets dx/dt(0). Required by ModelingToolkit.jl to fully specify higher-order initial value problems." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "derivative_initial_value" .

tvbo:derived_from_model a owl:ObjectProperty ;
    rdfs:label "derived_from_model (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "derived_from_model" .

tvbo:desc a owl:DatatypeProperty ;
    rdfs:label "desc (slot)" ;
    skos:definition "BIDS desc- entity (e.g., FCavg, SC), for disambiguating derived data variants" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "desc" .

tvbo:descriptor a owl:DatatypeProperty ;
    rdfs:label "descriptor (slot)" ;
    skos:definition "Short alphanumeric identifier for the BIDS desc- filename entity (e.g., SC, FC, EC, SCFC). Classifies the connectivity modality of the network's edge measures." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "descriptor" .

tvbo:detail a owl:DatatypeProperty ;
    rdfs:label "detail (slot)" ;
    skos:definition "Non-visual grouping dim (e.g. the hue/iterate dim)." ;
    skos:inScheme tvbo:figure ;
    skos:notation "detail" .

tvbo:detect_bifurcation a owl:DatatypeProperty ;
    rdfs:label "detect_bifurcation (slot)" ;
    skos:definition "Bifurcation detection level. 0 = off, 1 = eigenvalues only, 2 = detect, 3 = locate precisely." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "detect_bifurcation" .

tvbo:detect_fold a owl:DatatypeProperty ;
    rdfs:label "detect_fold (slot)" ;
    skos:definition "Enable fold (limit point) detection." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "detect_fold" .

tvbo:diagonal a owl:ObjectProperty ;
    rdfs:label "diagonal (slot)" ;
    skos:definition "Value written onto the diagonal of a `pairwise_distance` result, e.g. infinity to suppress self-connections. Omitted leaves the true zero self-distance in place." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "diagonal" .

tvbo:differentiation a owl:ObjectProperty ;
    rdfs:label "differentiation (slot)" ;
    skos:definition "Backend-neutral strategy for propagating gradients through the temporal integration (e.g. truncated backprop-through-time)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "differentiation" .

tvbo:dimension a owl:DatatypeProperty ;
    rdfs:label "dimension (slot)" ;
    skos:definition "Dimensionality of the coupling input (number of coupled values)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "dimension" .

tvbo:direction a owl:DatatypeProperty ;
    rdfs:label "direction (slot)" ;
    skos:definition "Exceedance direction: ``greater_equal`` (fraction of permutations whose statistic ≥ the observed) or ``less_equal`` (one-sided negative test)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "direction" .

tvbo:distance a owl:DatatypeProperty ;
    rdfs:label "distance (slot)" ;
    skos:definition "Edge length / tract distance (explicit edges, mm)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "distance" .

tvbo:distance_unit a owl:ObjectProperty ;
    rdfs:label "distance_unit (slot)" ;
    skos:definition "Unit for distances/lengths in the network" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "distance_unit" .

tvbo:distribute a owl:ObjectProperty ;
    rdfs:label "distribute (slot)" ;
    skos:definition "How exploration axes map onto the vectorized vs fanned-out tiers." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "distribute" .

tvbo:doi a owl:DatatypeProperty ;
    rdfs:label "doi (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "doi" .

tvbo:downsample_period a owl:DatatypeProperty ;
    rdfs:label "downsample_period (slot)" ;
    skos:definition "Intermediate downsampling period (ms). For BOLD: typically matches dt." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "downsample_period" .

tvbo:dpi a owl:DatatypeProperty ;
    rdfs:label "dpi (slot)" ;
    skos:definition "Raster resolution (dots per inch); scales pixel output only, not the physical size or the font size." ;
    skos:inScheme tvbo:figure ;
    skos:notation "dpi" .

tvbo:ds a owl:DatatypeProperty ;
    rdfs:label "ds (slot)" ;
    skos:definition "Initial arc-length step size." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "ds" .

tvbo:ds_max a owl:DatatypeProperty ;
    rdfs:label "ds_max (slot)" ;
    skos:definition "Maximum adaptive step size." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "ds_max" .

tvbo:ds_min a owl:DatatypeProperty ;
    rdfs:label "ds_min (slot)" ;
    skos:definition "Minimum adaptive step size." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "ds_min" .

tvbo:edge_template a owl:ObjectProperty ;
    rdfs:label "edge_template (slot)" ;
    skos:definition "Default Edge attributes applied to every Edge in this Network. Explicit entries in `edges:` override the template field-by-field. Reserved per-Edge slots (source, target, weight, delay, distance) come from the data backbone (loaded matrix or procedural generator) and are ignored if set on the template." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "edge_template" .

tvbo:element a owl:DatatypeProperty ;
    rdfs:label "element (slot)" ;
    skos:definition "Element/node index this range applies to. Used in element_domains to explicitly link a domain to a specific element of a heterogeneous parameter (e.g., element: 0 for node 0). Required when used in element_domains to avoid ambiguous positional indexing." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "element" .

tvbo:element_type a owl:ObjectProperty ;
    rdfs:label "element_type (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "element_type" .

tvbo:elements a owl:DatatypeProperty ;
    rdfs:label "elements (slot)" ;
    skos:definition "Topology indices: either a file reference, or (when inlined on a Network) a dotted path inside the parent Network's h5 companion to the (M, 3) int triangle face array. Default convention: ``mesh/faces``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "elements" .

tvbo:emit_provenance a owl:DatatypeProperty ;
    rdfs:label "emit_provenance (slot)" ;
    skos:definition "Whether to emit provenance sidecars alongside results. Unset means enabled. Named apart from the ``provenance`` slot carrying PROV-O metadata (Network, Figure, ...): LinkML maps every slot of a given name onto one property, so a boolean here and a ``Provenance`` object there would make ``tvbo:provenance`` both an owl:DatatypeProperty and an owl:ObjectProperty — not OWL-DL." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "emit_provenance" .

tvbo:encoding a owl:ObjectProperty ;
    rdfs:label "encoding (slot)" ;
    skos:inScheme tvbo:figure ;
    skos:notation "encoding" .

tvbo:enforce a owl:ObjectProperty ;
    rdfs:label "enforce (slot)" ;
    skos:definition "For a state-variable ``domain``: whether/how to enforce the range during integration (none/clamp/wrap). Ignored for parameter, distribution and grid ranges. See DomainEnforcement." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "enforce" .

tvbo:engine a owl:ObjectProperty ;
    rdfs:label "engine (slot)" ;
    skos:definition "Primary engine (must appear in environment.requirements; migration target replacing deprecated 'software')." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "engine" .

tvbo:equation_order a owl:DatatypeProperty ;
    rdfs:label "equation_order (slot)" ;
    skos:definition "Order of the time derivative on the LHS. Default 1 means dx/dt = rhs (first-order ODE). Order 2 means d²x/dt² = rhs (second-order ODE), etc. Higher-order ODEs are automatically lowered to coupled first-order systems by backends like ModelingToolkit.jl via mtkcompile." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "equation_order" .

tvbo:equation_type a owl:DatatypeProperty ;
    rdfs:label "equation_type (slot)" ;
    skos:definition "How to interpret ``equation.rhs`` when advancing this state: 'differential' (default) integrates it as ``dx/dt = rhs``; 'algebraic' is a constraint ``0 = rhs`` / ``x ~ rhs`` (DAE); 'recurrence' is a discrete per-step update ``x_next = rhs`` (no integrator applied), used by an observation's auxiliary ``dynamics`` for online reductions/accumulators (e.g. a running sum ``x_next = x + f``) — the symbolic, backend-independent sibling of the continuous 'differential' form. Algebraic equations are used by ModelingToolkit.jl backend." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "equation_type" .

tvbo:event_type a owl:ObjectProperty ;
    rdfs:label "event_type (slot)" ;
    skos:definition "Type of event trigger mechanism." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "event_type" .

tvbo:evict_equation a owl:ObjectProperty ;
    rdfs:label "evict_equation (slot)" ;
    skos:definition "Optional reverse recurrence for a **sliding-window** reduction: the per-step downdate that removes the sample leaving the window, the inverse of ``equation`` (which folds an arriving sample in). Only meaningful when ``equation_type: recurrence`` on an observation's auxiliary ``dynamics``. When present, the observer is a windowed reduction — its state is maintained by ``equation`` (add) and ``evict_equation`` (evict) and rebuilt exactly from the window on resync — rather than a cumulative accumulator over the whole trajectory (``equation`` alone). Absent for ordinary state variables and cumulative reductions." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "evict_equation" .

tvbo:executor a owl:DatatypeProperty ;
    rdfs:label "executor (slot)" ;
    skos:definition "Executor to run the pipeline through (Nextflow process.executor)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "executor" .

tvbo:experiment a owl:DatatypeProperty ;
    rdfs:label "experiment (slot)" ;
    skos:definition "WHERE (short form): an in-study experiment id whose saved result holds the array, resolved within the enclosing study like ``initial_state.source_experiment``. Mutually exclusive with ``iri`` (the full cross-study / curated / external form). When both are absent the reference is local — ``output`` names this experiment's own output — otherwise falling back to ``initial_state.source_experiment`` when present." ;
    skos:inScheme tvbo:common ;
    skos:notation "experiment" .

tvbo:experiment_yaml_hash a owl:DatatypeProperty ;
    rdfs:label "experiment_yaml_hash (slot)" ;
    skos:definition "SHA-256 hex digest of the normalised experiment YAML that produced this artifact. Used by the cross-experiment cache (see :class:`SimulationStudy.from_file`) to detect when a cached upstream result has gone stale because the experiment's spec was edited. Computed as ``hashlib.sha256(yaml.safe_dump(normalized_yaml).encode()).hexdigest()`` over the fully resolved (post-``!include``) experiment block." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "experiment_yaml_hash" .

tvbo:extension a owl:DatatypeProperty ;
    rdfs:label "extension (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "extension" .

tvbo:field_dynamics a owl:ObjectProperty ;
    rdfs:label "field_dynamics (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "field_dynamics" .

tvbo:find_fixpoint a owl:DatatypeProperty ;
    rdfs:label "find_fixpoint (slot)" ;
    skos:definition "Whether to find a fixed point (steady state) before time integration. Used as initial condition for ODEProblem. Maps to NLsolve.fixpoint! in ND.jl or similar in other backends." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "find_fixpoint" .

tvbo:font_size a owl:DatatypeProperty ;
    rdfs:label "font_size (slot)" ;
    skos:definition "Base font size in points (physical: 1 pt = 1/72 inch). The real text size, unchanged by figure size or dpi; set it (or the width) so labels are legible at print size." ;
    skos:inScheme tvbo:figure ;
    skos:notation "font_size" .

tvbo:free a owl:DatatypeProperty ;
    rdfs:label "free (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "free" .

tvbo:gaussian a owl:DatatypeProperty ;
    rdfs:label "gaussian (slot)" ;
    skos:definition "Indicates whether the noise is Gaussian" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "gaussian" .

tvbo:generated_at a owl:DatatypeProperty ;
    rdfs:label "generated_at (slot)" ;
    skos:definition "Timestamp when this TimeSeries was generated." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "generated_at" .

tvbo:generated_by a owl:DatatypeProperty ;
    rdfs:label "generated_by (slot)" ;
    skos:closeMatch prov:wasAttributedTo ;
    skos:definition "Software/agent identifier: the prov:Agent this artifact is attributed to." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "generated_by" .

tvbo:geometry a owl:DatatypeProperty ;
    rdfs:label "geometry (slot)" ;
    skos:definition "Optional file for geometry/ROI mask (e.g., NIfTI, GIfTI)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "geometry" .

tvbo:git a owl:DatatypeProperty ;
    rdfs:label "git (slot)" ;
    skos:definition "Git repository URL to fetch the code from (shallow-cloned and cached under ``~/.cache/tvbo/code_sources``). Mutually exclusive with ``path``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "git" .

tvbo:graph_generator a owl:ObjectProperty ;
    rdfs:label "graph_generator (slot)" ;
    skos:definition """Graph generator specification.  When set, overrides explicit edges/nodes for graph construction.  The type field is a free string; StandardGraphType lists well-known types that get automatic code generation across backends.
""" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "graph_generator" .

tvbo:graph_representation a owl:ObjectProperty ;
    rdfs:label "graph_representation (slot)" ;
    skos:definition "Representation used to evaluate coupling over this network's connectivity (``auto`` | ``dense`` | ``sparse``). ``auto`` lets the backend choose by connection density. This names whether to exploit edge sparsity, not a concrete data structure, so it is backend-independent; the delayed-vs-instantaneous graph kind is decided separately from the couplings' conduction delays." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "graph_representation" .

tvbo:gres a owl:DatatypeProperty ;
    rdfs:label "gres (slot)" ;
    skos:definition "Generic scheduler resources, e.g. 'gpu:1' (Slurm --gres)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "gres" .

tvbo:has_reference a owl:DatatypeProperty ;
    rdfs:label "has_reference (slot)" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "has_reference" .

tvbo:hash a owl:DatatypeProperty ;
    rdfs:label "hash (slot)" ;
    skos:definition "SHA-256 hex digest of the file at fingerprinting (recomputed lazily when mtime/size differ)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "hash" .

tvbo:height a owl:DatatypeProperty ;
    rdfs:label "height (slot)" ;
    skos:definition "Figure height in mm (physical print size)." ;
    skos:inScheme tvbo:figure ;
    skos:notation "height" .

tvbo:hemi a owl:DatatypeProperty ;
    rdfs:label "hemi (slot)" ;
    skos:definition "BIDS hemi- entity (L or R) for hemisphere-specific surface/volume data" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "hemi" .

tvbo:hi a owl:ObjectProperty ;
    rdfs:label "hi (slot)" ;
    skos:definition "Upper bound or stopping value. Can be a number or argument name." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "hi" .

tvbo:histogram a owl:ObjectProperty ;
    rdfs:label "histogram (slot)" ;
    skos:definition "Bin spec (`lo`, `hi`, `n`) for a streaming order-statistic aggregation (`aggregation: median`). Should span the expected value range of the reduced per-step quantity; the quantile is linearly interpolated within the crossing bin. Only used by the streaming-median reduction path." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "histogram" .

tvbo:history a owl:ObjectProperty ;
    rdfs:label "history (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "history" .

tvbo:imaging_modality a owl:ObjectProperty ;
    rdfs:label "imaging_modality (slot)" ;
    skos:definition "Type of imaging modality (BOLD, EEG, MEG, etc.)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "imaging_modality" .

tvbo:initial_expression a owl:ObjectProperty ;
    rdfs:label "initial_expression (slot)" ;
    skos:definition "Analytic initial condition for the field." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "initial_expression" .

tvbo:inner_coupling a owl:ObjectProperty ;
    rdfs:label "inner_coupling (slot)" ;
    skos:definition "For hierarchical coupling: inner coupling applied at regional level" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "inner_coupling" .

tvbo:inner_iterations a owl:DatatypeProperty ;
    rdfs:label "inner_iterations (slot)" ;
    skos:definition "For mode=nested only: number of inner-loop iterations to run per outer iteration. Defaults to the included algorithm's own n_iterations. A small value (e.g. 5-10) is usually enough to correct the drift introduced by one outer step." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "inner_iterations" .

tvbo:intensity a owl:ObjectProperty ;
    rdfs:label "intensity (slot)" ;
    skos:definition "Noise amplitude as a standard deviation (sigma), scalar or per state variable. Give a dispersion (TVB's nsig, D = sigma^2/2) as the `nsig` entry of `parameters` instead; `sigma` there is equivalent to this slot. Stating one meaning matters: reading the same number as sigma or as D differs by sqrt(2 D)/D." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "intensity" .

tvbo:interpolate_delays a owl:DatatypeProperty ;
    rdfs:label "interpolate_delays (slot)" ;
    skos:definition "For delayed coupling: read delayed states by linear interpolation between the two bracketing history time-steps instead of snapping each delay to the nearest integer step. Removes sub-step quantisation error and makes the coupling differentiable w.r.t. the continuous delay — hence w.r.t. conduction speed v (delay = tract_length / v) — so v can be gradient-optimised. Default false preserves exact nearest-step behaviour (tvboptim roll strategy)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "interpolate_delays" .

tvbo:interpolation a owl:DatatypeProperty ;
    rdfs:label "interpolation (slot)" ;
    skos:definition "Interpolation for a data-driven stimulus: 'linear' or 'cubic'." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "interpolation" .

tvbo:kind a owl:ObjectProperty ;
    rdfs:label "kind (slot)" ;
    skos:inScheme tvbo:figure ;
    skos:notation "kind" .

tvbo:labels_dimensions a owl:DatatypeProperty ;
    rdfs:label "labels_dimensions (slot)" ;
    skos:definition "Mapping of dimension names to their labels (JSON-encoded dict)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "labels_dimensions" .

tvbo:latex a owl:DatatypeProperty ;
    rdfs:label "latex (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "latex" .

tvbo:layout a owl:DatatypeProperty ;
    rdfs:label "layout (slot)" ;
    skos:definition "bsplot mosaic string; letters = panel keys, slash (or newline) = new row, repeated letters span cells, dot = empty. e.g. aab/ccb." ;
    skos:inScheme tvbo:figure ;
    skos:notation "layout" .

tvbo:learning_rate_schedule a owl:DatatypeProperty ;
    rdfs:label "learning_rate_schedule (slot)" ;
    skos:definition "Learning rate schedule: 'constant', 'linear', 'exponential'" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "learning_rate_schedule" .

tvbo:learning_rate_warmup a owl:DatatypeProperty ;
    rdfs:label "learning_rate_warmup (slot)" ;
    skos:definition "Linear warmup of learning rate from 0 to learning_rate over n_iterations. eta_effective = eta * (i+1) / n_iterations" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "learning_rate_warmup" .

tvbo:legend a owl:DatatypeProperty ;
    rdfs:label "legend (slot)" ;
    skos:definition "Show a legend for this panel." ;
    skos:inScheme tvbo:figure ;
    skos:notation "legend" .

tvbo:lhs a owl:DatatypeProperty ;
    rdfs:label "lhs (slot)" ;
    skos:altLabel "lefthandside" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "lhs" .

tvbo:library a owl:DatatypeProperty ;
    rdfs:label "library (slot)" ;
    skos:definition "Native library/module providing the callable." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "library" .

tvbo:license a owl:DatatypeProperty ;
    rdfs:label "license (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "license" .

tvbo:likelihood a owl:ObjectProperty ;
    rdfs:label "likelihood (slot)" ;
    skos:definition "Observation model p(data | sim(theta))." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "likelihood" .

tvbo:linear_solver a owl:ObjectProperty ;
    rdfs:label "linear_solver (slot)" ;
    skos:definition "Linear solver for the Newton bordered system. E.g. COPBLS (collocation), MatrixBLS (shooting/poincaré)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "linear_solver" .

tvbo:lo a owl:ObjectProperty ;
    rdfs:label "lo (slot)" ;
    skos:definition "Lower bound or starting value. Can be a number or argument name." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "lo" .

tvbo:loader a owl:ObjectProperty ;
    rdfs:label "loader (slot)" ;
    skos:definition "Callable that loads the data (e.g., load_functional_connectivity)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "loader" .

tvbo:loc a owl:DatatypeProperty ;
    rdfs:label "loc (slot)" ;
    skos:definition "Named corner ('upper right', 'upper left', 'center', ...) as an alternative to x/y." ;
    skos:inScheme tvbo:figure ;
    skos:notation "loc" .

tvbo:local a owl:DatatypeProperty ;
    rdfs:label "local (slot)" ;
    skos:definition "Marks this as a LOCAL (surface/local-connectivity) coupling term rather than a global long-range coupling. Local terms are never wired to the connectome; they evaluate to 0 unless a local/surface connectivity is supplied (TVB's ``local_coupling``). Global coupling inputs (the default) are driven by ``Network.coupling``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "local" .

tvbo:local_coupling_term a owl:ObjectProperty ;
    rdfs:label "local_coupling_term (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "local_coupling_term" .

tvbo:log_scale a owl:DatatypeProperty ;
    rdfs:label "log_scale (slot)" ;
    skos:definition "Whether to use logarithmic spacing." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "log_scale" .

tvbo:loss a owl:ObjectProperty ;
    rdfs:label "loss (slot)" ;
    skos:definition "Loss function call. Uses FunctionCall to either: 1. Reference existing function: function: rmse 2. Inline callable: callable: {module: ..., name: ...} Arguments specify inputs (simulated_fc, empirical_fc, etc.)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "loss" .

tvbo:mail_type a owl:DatatypeProperty ;
    rdfs:label "mail_type (slot)" ;
    skos:definition "Scheduler notification trigger (e.g. 'END,FAIL')." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "mail_type" .

tvbo:mail_user a owl:DatatypeProperty ;
    rdfs:label "mail_user (slot)" ;
    skos:definition "Notification email address." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "mail_user" .

tvbo:mark a owl:ObjectProperty ;
    rdfs:label "mark (slot)" ;
    skos:definition "Cartesian mark; omitted for heatmap panels (implied by the panel kind)." ;
    skos:inScheme tvbo:figure ;
    skos:notation "mark" .

tvbo:max_bisection_steps a owl:DatatypeProperty ;
    rdfs:label "max_bisection_steps (slot)" ;
    skos:definition "Maximum bisection steps for bifurcation point localization." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "max_bisection_steps" .

tvbo:max_iterations a owl:DatatypeProperty ;
    rdfs:label "max_iterations (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "max_iterations" .

tvbo:max_steps a owl:DatatypeProperty ;
    rdfs:label "max_steps (slot)" ;
    skos:definition "Maximum continuation steps." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "max_steps" .

tvbo:measure a owl:DatatypeProperty ;
    rdfs:label "measure (slot)" ;
    skos:definition "WHICH array to select out of `source`. The address space is the source's own: a per-node measure name for a Network (aligning with Network.structural_measures / observational_measures), a dataset key for an HDF5/Zarr store, a recorded measure for an experiment result. Omit when the source resolves to a single array." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "measure" .

tvbo:measure_type a owl:DatatypeProperty ;
    rdfs:label "measure_type (slot)" ;
    skos:definition "Sub-type within the phenotype (e.g. 'raw', 'unadjusted', 'age-corrected', 'derived', 'RT', 'accuracy')." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "measure_type" .

tvbo:mem a owl:DatatypeProperty ;
    rdfs:label "mem (slot)" ;
    skos:definition "Memory per task in scheduler syntax (e.g. '16G')." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "mem" .

tvbo:mesh_file a owl:DatatypeProperty ;
    rdfs:label "mesh_file (slot)" ;
    skos:definition "Path to external mesh file (GIFTI, VTK, MSH, FreeSurfer, etc.)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "mesh_file" .

tvbo:mesh_format a owl:DatatypeProperty ;
    rdfs:label "mesh_format (slot)" ;
    skos:definition "Explicit format override (gifti, freesurfer, meshio, vtk, gmsh). Auto-detected from extension if null." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "mesh_format" .

tvbo:mesh_intervals a owl:DatatypeProperty ;
    rdfs:label "mesh_intervals (slot)" ;
    skos:definition "Number of mesh intervals (time slices) for collocation or trapezoid methods. Collocation: N in PeriodicOrbitOCollProblem(N, m). Trapezoid: M in PeriodicOrbitTrapProblem(M=...)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "mesh_intervals" .

tvbo:metric a owl:ObjectProperty ;
    rdfs:label "metric (slot)" ;
    skos:definition "Metric equation for matching (e.g., correlation, rmse)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "metric" .

tvbo:min_coverage a owl:DatatypeProperty ;
    rdfs:label "min_coverage (slot)" ;
    skos:definition "Minimum fraction of the model network's nodes that a ``by_label`` reconciliation must cover, else resolution raises. The realised coverage is always logged. Absent (``null``) means require full coverage (``1.0``) for a dataset-sourced target — silently fitting on a partial node subset must be an explicit opt-in (e.g. ``0.95`` to tolerate a few genuinely-missing empirical parcels), never the default." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "min_coverage" .

tvbo:modality a owl:ObjectProperty ;
    rdfs:label "modality (slot)" ;
    skos:definition "Imaging modality or simulation output type." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "modality" .

tvbo:model_equation_ref a owl:DatatypeProperty ;
    rdfs:label "model_equation_ref (slot)" ;
    skos:definition "BIDS ModelEq reference: path to _eq.xml LEMS file." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "model_equation_ref" .

tvbo:model_param_ref a owl:DatatypeProperty ;
    rdfs:label "model_param_ref (slot)" ;
    skos:definition "BIDS ModelParam reference: path to _param.xml LEMS file." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "model_param_ref" .

tvbo:model_type a owl:ObjectProperty ;
    rdfs:label "model_type (slot)" ;
    skos:definition "Coarse classification of this model (mean_field, neural_mass, phase_oscillator, phenomenological, spiking, generic, field). Used for filtering in Dynamics.list_db(model_type=...)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "model_type" .

tvbo:modified a owl:DatatypeProperty ;
    rdfs:label "modified (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "modified" .

tvbo:module a owl:DatatypeProperty ;
    rdfs:label "module (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "module" .

tvbo:mtime a owl:DatatypeProperty ;
    rdfs:label "mtime (slot)" ;
    skos:definition "File modification time at fingerprinting (POSIX timestamp)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "mtime" .

tvbo:n a owl:DatatypeProperty ;
    rdfs:label "n (slot)" ;
    skos:definition "Number of points (alternative to step for grid exploration)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "n" .

tvbo:n_inversion a owl:DatatypeProperty ;
    rdfs:label "n_inversion (slot)" ;
    skos:definition "Number of eigenvalue sign inversions to flag a bifurcation. Must be even. Higher = fewer false positives." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "n_inversion" .

tvbo:n_parallel a owl:DatatypeProperty ;
    rdfs:label "n_parallel (slot)" ;
    skos:definition "Grid batch size for parameter exploration — how many sweep cells the backend evaluates as one vectorised chunk. ``auto`` (the default) vectorises the grid, bounded by a cell-count cap (``min(grid_size, 64)``, env ``TVBO_NVMAP_AUTO_CAP``) and a working-memory budget (env ``TVBO_NVMAP_MEM_BUDGET_GB``, default 2 GB) estimated from the per-cell output and live state: fast on every backend, and the memory budget keeps a large-per-cell grid (e.g. a whole-brain delay network) from inflating peak memory. Vectorising still holds ``n_vmap`` cells at once, so auto uses more working memory than a sequential run — the budget bounds it. An integer fixes the chunk size and bypasses both bounds (``1`` = fully sequential, minimal memory; a larger value trades memory for fewer, wider batches). Backends translate this into their own execution primitive (e.g. tvboptim's vmap chunk width) without exposing any backend-specific names in the schema." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "n_parallel" .

tvbo:n_regions a owl:DatatypeProperty ;
    rdfs:label "n_regions (slot)" ;
    skos:definition "Total number of regions" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "n_regions" .

tvbo:n_sections a owl:DatatypeProperty ;
    rdfs:label "n_sections (slot)" ;
    skos:definition "Number of shooting sections for shooting or Poincaré methods." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "n_sections" .

tvbo:n_threads a owl:DatatypeProperty ;
    rdfs:label "n_threads (slot)" ;
    skos:definition "Number of CPU threads per worker (-1 = auto-detect)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "n_threads" .

tvbo:n_trials a owl:DatatypeProperty ;
    rdfs:label "n_trials (slot)" ;
    skos:definition "Number of independent trials per grid point. Each trial uses a different noise seed. Used for averaging stochastic simulations (e.g., VEP = average of 20 trials)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "n_trials" .

tvbo:n_vertices a owl:DatatypeProperty ;
    rdfs:label "n_vertices (slot)" ;
    skos:definition "Total number of vertices" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "n_vertices" .

tvbo:n_workers a owl:DatatypeProperty ;
    rdfs:label "n_workers (slot)" ;
    skos:definition "Number of parallel workers (maps to pmap devices in JAX, processes in multiprocessing)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "n_workers" .

tvbo:network a owl:ObjectProperty ;
    rdfs:label "network (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "network" .

tvbo:nev a owl:DatatypeProperty ;
    rdfs:label "nev (slot)" ;
    skos:definition "Number of eigenvalues to compute. Must be >= number of state variables for reliable Hopf detection." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "nev" .

tvbo:newton_max_iterations a owl:DatatypeProperty ;
    rdfs:label "newton_max_iterations (slot)" ;
    skos:definition "Maximum Newton corrector iterations per step." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "newton_max_iterations" .

tvbo:newton_tol a owl:DatatypeProperty ;
    rdfs:label "newton_tol (slot)" ;
    skos:definition "Absolute tolerance for Newton corrector convergence." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "newton_tol" .

tvbo:nextflow a owl:ObjectProperty ;
    rdfs:label "nextflow (slot)" ;
    skos:definition "Nextflow execution directives." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "nextflow" .

tvbo:node_mapping a owl:DatatypeProperty ;
    rdfs:label "node_mapping (slot)" ;
    skos:definition "HDF5 dataset path for node-to-parent mapping. Int32 array of shape (N,) where entry i is the parent node ID. Required when parent_network is set." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "node_mapping" .

tvbo:node_template a owl:ObjectProperty ;
    rdfs:label "node_template (slot)" ;
    skos:definition "Default Node attributes applied to every Node in this Network. Explicit entries in `nodes:` override the template field-by-field (shallow replace, same semantics as `dict.update`). Reserved per-Node slots (id, label, position, region) come from the data backbone (Network.iri-loaded parcellation or procedural generator) and are ignored if set on the template. Lets a homogeneous Network declare its per-Node configuration once without enumerating regions." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "node_template" .

tvbo:noise_type a owl:DatatypeProperty ;
    rdfs:label "noise_type (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "noise_type" .

tvbo:non_negative a owl:DatatypeProperty ;
    rdfs:label "non_negative (slot)" ;
    skos:definition "All values >= 0" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "non_negative" .

tvbo:normals a owl:DatatypeProperty ;
    rdfs:label "normals (slot)" ;
    skos:definition "Optional path inside the parent Network's h5 (or an external file) to per-vertex normals (N, 3) float. Default convention: ``mesh/normals``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "normals" .

tvbo:num_chains a owl:DatatypeProperty ;
    rdfs:label "num_chains (slot)" ;
    skos:definition "Independent MCMC chains." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "num_chains" .

tvbo:num_samples a owl:DatatypeProperty ;
    rdfs:label "num_samples (slot)" ;
    skos:definition "Posterior samples to draw." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "num_samples" .

tvbo:num_warmup a owl:DatatypeProperty ;
    rdfs:label "num_warmup (slot)" ;
    skos:definition "Warmup/adaptation steps before sampling." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "num_warmup" .

tvbo:number_loc a owl:ObjectProperty ;
    rdfs:label "number_loc (slot)" ;
    skos:definition "Per-panel override of the figure's panel_number_loc — e.g. wide top panels upper-right, grid panels upper-left." ;
    skos:inScheme tvbo:figure ;
    skos:notation "number_loc" .

tvbo:number_of_elements a owl:DatatypeProperty ;
    rdfs:label "number_of_elements (slot)" ;
    skos:definition "Number of elements (triangles, quads, tetrahedra, etc.)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "number_of_elements" .

tvbo:number_of_modes a owl:DatatypeProperty ;
    rdfs:label "number_of_modes (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "number_of_modes" .

tvbo:number_of_nodes a owl:DatatypeProperty ;
    rdfs:label "number_of_nodes (slot)" ;
    skos:altLabel "number_of_nodes",
        "number_of_regions" ;
    skos:definition "Number of nodes in the network (derived from nodes if not set)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "number_of_nodes" .

tvbo:number_of_stages a owl:DatatypeProperty ;
    rdfs:label "number_of_stages (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "number_of_stages" .

tvbo:number_of_subjects a owl:DatatypeProperty ;
    rdfs:label "number_of_subjects (slot)" ;
    skos:definition "Number of subjects in the tractography dataset" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "number_of_subjects" .

tvbo:number_of_vertices a owl:DatatypeProperty ;
    rdfs:label "number_of_vertices (slot)" ;
    skos:definition "Number of vertices in the mesh." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "number_of_vertices" .

tvbo:objective a owl:ObjectProperty ;
    rdfs:label "objective (slot)" ;
    skos:definition "What the algorithm optimizes for" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "objective" .

tvbo:observable a owl:ObjectProperty ;
    rdfs:label "observable (slot)" ;
    skos:definition "Observable to compute at each point. Use function: obs_name for simple observation, or function: func_name + arguments for FunctionCall." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "observable" .

tvbo:ode_solver a owl:ObjectProperty ;
    rdfs:label "ode_solver (slot)" ;
    skos:definition "ODE solver for flow-based methods (shooting, poincaré). Specifies algorithm (e.g. Vern9, Rodas5) and tolerances. Not needed for collocation or trapezoid." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "ode_solver" .

tvbo:of a owl:DatatypeProperty ;
    rdfs:label "of (slot)" ;
    skos:definition "Name of the input this step consumes — the positions for `pairwise_distance` / `distribution_pdf`, the matrix for `normalize`, the compared quantity for `stochastic_mask`, and for `sample` (which consumes no array) the Distribution-valued generator parameter to draw from. It names either a previously defined step or a generator parameter; steps are ordered, so a referenced step must already be defined." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "of" .

tvbo:on_region a owl:DatatypeProperty ;
    rdfs:label "on_region (slot)" ;
    skos:definition "Mesh/atlas subset where BC applies." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "on_region" .

tvbo:opacity a owl:DatatypeProperty ;
    rdfs:label "opacity (slot)" ;
    skos:inScheme tvbo:figure ;
    skos:notation "opacity" .

tvbo:operator_type a owl:ObjectProperty ;
    rdfs:label "operator_type (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "operator_type" .

tvbo:out_dir a owl:DatatypeProperty ;
    rdfs:label "out_dir (slot)" ;
    skos:definition "Output directory template. ``{study}`` and ``{experiment}`` are substituted with the study and experiment keys at emit time. Unset means ``out/{study}/{experiment}``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "out_dir" .

tvbo:output_equation a owl:ObjectProperty ;
    rdfs:label "output_equation (slot)" ;
    skos:definition "Output transformation equation (if equation-based)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "output_equation" .

tvbo:over a owl:ObjectProperty ;
    rdfs:label "over (slot)" ;
    skos:definition "Dimension to aggregate over (e.g., node, time, state)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "over" .

tvbo:panel_key a owl:DatatypeProperty ;
    rdfs:label "panel_key (slot)" ;
    skos:definition "Mosaic label this panel binds to (matches a letter in Figure.layout)." ;
    skos:inScheme tvbo:figure ;
    skos:notation "panel_key" ;
    tvbo:collection_key true .

tvbo:panel_number_format a owl:DatatypeProperty ;
    rdfs:label "panel_number_format (slot)" ;
    skos:definition "Python format string applied to each panel letter: '{}' -> 'a', '({})' -> '(a)', '{}.' -> 'a.'. Defaults to '{}'. Match the target journal's convention." ;
    skos:inScheme tvbo:figure ;
    skos:notation "panel_number_format" .

tvbo:panel_number_loc a owl:ObjectProperty ;
    rdfs:label "panel_number_loc (slot)" ;
    skos:definition "Which corner the panel letter sits in. Unset keeps bsplot's own default placement; many journals (and Taher Fig 5) use 'upper right'." ;
    skos:inScheme tvbo:figure ;
    skos:notation "panel_number_loc" .

tvbo:panel_numbers a owl:DatatypeProperty ;
    rdfs:label "panel_numbers (slot)" ;
    skos:definition "Draw automatic panel letters (a, b, ...). Independent of auto_format so a study can keep its own tick styling and still get numbered panels." ;
    skos:inScheme tvbo:figure ;
    skos:notation "panel_numbers" .

tvbo:parallel_batch_size a owl:DatatypeProperty ;
    rdfs:label "parallel_batch_size (slot)" ;
    skos:definition "Chunk size for ``lax_map`` and chunked-``vmap`` modes. ``1`` = strictly sequential (minimum memory). Larger values amortise compile overhead across trials at the cost of memory. Ignored when parallel_mode is ``vmap`` (which always uses the full n_trials axis)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "parallel_batch_size" .

tvbo:parallel_mode a owl:ObjectProperty ;
    rdfs:label "parallel_mode (slot)" ;
    skos:definition "How trial-axis parallelism is realised at codegen time. ``vmap`` batches all trials in parallel (fast, peak memory ~n_trials × per-trial working set). ``lax_map`` runs them sequentially via ``jax.lax.map`` (slower, peak memory bounded by one trial). ``pmap`` shards across devices for multi-GPU. ``auto`` (default) picks ``vmap`` when the estimated batched memory fits, ``lax_map`` otherwise." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "parallel_mode" .

tvbo:parcel_map_field a owl:DatatypeProperty ;
    rdfs:label "parcel_map_field (slot)" ;
    skos:definition "When the mesh is inlined on a Network with a parcellation, the dotted path inside the parent's h5 to the per-vertex parcel id array. Default: ``nodes/parent_index``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "parcel_map_field" .

tvbo:parent_network a owl:DatatypeProperty ;
    rdfs:label "parent_network (slot)" ;
    skos:definition "Path/URI to parent (coarser) Network. When set, this network is a refinement where each node maps to exactly one parent node via node_mapping." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "parent_network" .

tvbo:partition a owl:DatatypeProperty ;
    rdfs:label "partition (slot)" ;
    skos:definition "Scheduler partition to submit to (Slurm)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "partition" .

tvbo:period a owl:DatatypeProperty ;
    rdfs:label "period (slot)" ;
    skos:definition "Sampling period for monitors (ms). For BOLD: TR in ms." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "period" .

tvbo:permutations a owl:DatatypeProperty ;
    rdfs:label "permutations (slot)" ;
    skos:definition "Name of the observer parameter holding the fixed ``(n_perm, n)`` permutation- index array (a produced/sourced constant, reused across the window and grid)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "permutations" .

tvbo:permute a owl:DatatypeProperty ;
    rdfs:label "permute (slot)" ;
    skos:definition "The symbol whose entries are permuted (the observation source, or a parameter such as an in-strength vector)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "permute" .

tvbo:placeholder a owl:DatatypeProperty ;
    rdfs:label "placeholder (slot)" ;
    skos:definition "Honest-placeholder text drawn when this panel's data is missing or degenerate (never a source-replot). Setting it wraps the draw so a missing container falls back to this label instead of erroring." ;
    skos:inScheme tvbo:figure ;
    skos:notation "placeholder" .

tvbo:position a owl:ObjectProperty ;
    rdfs:label "position (slot)" ;
    skos:definition "Spatial coordinates (x, y, z) of the node" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "position" .

tvbo:post_expression a owl:ObjectProperty ;
    rdfs:label "post_expression (slot)" ;
    skos:definition "Post-processing expression applied after coupling" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "post_expression" .

tvbo:pre_expression a owl:ObjectProperty ;
    rdfs:label "pre_expression (slot)" ;
    skos:definition "Pre-processing expression applied before coupling" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "pre_expression" .

tvbo:precision a owl:DatatypeProperty ;
    rdfs:label "precision (slot)" ;
    skos:definition "Floating point precision: 'float32' or 'float64'" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "precision" .

tvbo:preconditioner a owl:DatatypeProperty ;
    rdfs:label "preconditioner (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "preconditioner" .

tvbo:preprocessing a owl:ObjectProperty ;
    rdfs:label "preprocessing (slot)" ;
    skos:definition "Optional preprocessing to apply after loading" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "preprocessing" .

tvbo:primary_weight a owl:DatatypeProperty ;
    rdfs:label "primary_weight (slot)" ;
    skos:definition "Name of the edge group that should serve as the canonical weights matrix when ``weights_matrix`` is queried. Lets a single Network sidecar bundle several connectivity variants (e.g. band-specific NMF reweightings, distance-modulated SC, shuffled controls) under different edge names while still presenting one of them as the active weight to consumers (simulators, observation pipelines). Defaults to ``weight`` / ``weights`` / ``sc`` lookup when not set." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "primary_weight" .

tvbo:procedure a owl:ObjectProperty ;
    rdfs:label "procedure (slot)" ;
    skos:definition """Optional symbolic procedure for derived generators (e.g. null-model shuffles): ordered steps and named outputs, each carrying an Equation.
""" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "procedure" .

tvbo:processing_pipeline a owl:DatatypeProperty ;
    rdfs:label "processing_pipeline (slot)" ;
    skos:definition "Processing pipeline used to generate the tractography" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "processing_pipeline" .

tvbo:producer a owl:ObjectProperty ;
    rdfs:label "producer (slot)" ;
    skos:closeMatch prov:wasGeneratedBy ;
    skos:definition "HOW to compute this parameter's value, when it is derived rather than obtained — the callable that produces it, its arguments, and (via `output:`) which entry to take from a callable returning several named arrays. The callable resolves against the recipe's `code_source`. Use instead of `source:` for a value that is a deterministic function of the spec's own inputs (a mesh operator, a template matrix): declaring the producer keeps the spec the single source of truth, where pointing at a pre-built file would let the two drift apart silently. The result is cached and invalidated by the artifact fingerprint, so it is computed once rather than per run. Mutually exclusive with `value:`/`source:`." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "producer" .

tvbo:quantity_kind a owl:DatatypeProperty ;
    rdfs:label "quantity_kind (slot)" ;
    skos:definition "Scalar, vector, or tensor." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "quantity_kind" .

tvbo:query a owl:ObjectProperty ;
    rdfs:label "query (slot)" ;
    skos:definition "BIDS entity filter that selects one per-subject file under the experiment's ``dataset.bids_root`` when ``source`` is dataset-sourced (``dataset.subject.<measure>``). The active subject fills the ``sub-`` entity at resolution time; the remaining entities (e.g. ``desc: FCavg, atlas: Schaefer1000, suffix: relmat``) disambiguate among the subject's several networks/measurements. The same filter enumerates the cohort for the per-subject workflow fan-out, so one declaration drives both discovery and resolution." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "query" .

tvbo:queue a owl:DatatypeProperty ;
    rdfs:label "queue (slot)" ;
    skos:definition "Scheduler queue for the executor (Nextflow process.queue)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "queue" .

tvbo:ramp a owl:ObjectProperty ;
    rdfs:label "ramp (slot)" ;
    skos:definition "For method=from_working_point: the parameter + domain to ramp quasi-statically (warm-start, from_previous) to reach the working point; the run then seeds from the ramp endpoint. Reuses ExplorationAxis (parameter + Range domain) — the same primitive an Exploration warm-start uses; the per-step settle comes from the experiment's integration (transient, else duration)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "ramp" .

tvbo:random_seed a owl:DatatypeProperty ;
    rdfs:label "random_seed (slot)" ;
    skos:definition "Experiment-global RNG seed (default 0). Governs every stochastic draw — additive noise, initial-condition and parameter distributions, and n_trials ensembles — unless a specific `Distribution.seed` overrides it for that distribution." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "random_seed" .

tvbo:random_state a owl:ObjectProperty ;
    rdfs:label "random_state (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "random_state" .

tvbo:reconstruction a owl:DatatypeProperty ;
    rdfs:label "reconstruction (slot)" ;
    skos:definition "BIDS rec- entity (e.g., dTOR)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "reconstruction" .

tvbo:ref a owl:DatatypeProperty ;
    rdfs:label "ref (slot)" ;
    skos:definition "Git branch, tag, or commit to check out (``git`` sources only). Defaults to the repository's default branch." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "ref" .

tvbo:reference a owl:DatatypeProperty ;
    rdfs:label "reference (slot)" ;
    skos:definition "Publication or DOI reference for this tractography dataset" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "reference" .

tvbo:region_mapping a owl:ObjectProperty ;
    rdfs:label "region_mapping (slot)" ;
    skos:definition "For hierarchical coupling: vertex-to-region mapping for aggregation" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "region_mapping" .

tvbo:regional_connectivity a owl:ObjectProperty ;
    rdfs:label "regional_connectivity (slot)" ;
    skos:definition "For hierarchical coupling: region-to-region connectivity with weights and delays" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "regional_connectivity" .

tvbo:render a owl:DatatypeProperty ;
    rdfs:label "render (slot)" ;
    skos:definition "Name of a registered custom-panel callable fn(container, ax, **opts) (custom kind)." ;
    skos:inScheme tvbo:figure ;
    skos:notation "render" .

tvbo:reported_optimum a owl:DatatypeProperty ;
    rdfs:label "reported_optimum (slot)" ;
    rdfs:range xsd:float ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "reported_optimum" .

tvbo:required a owl:DatatypeProperty ;
    rdfs:label "required (slot)" ;
    skos:definition "Whether a value for this parameter must be supplied. Optional parameters (e.g. a generator's ``seed``) set this to false. Declaration metadata; unset means unconstrained." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "required" .

tvbo:retries a owl:DatatypeProperty ;
    rdfs:label "retries (slot)" ;
    skos:definition "Automatic retries per failed task. Unset means none." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "retries" .

tvbo:rhs a owl:DatatypeProperty ;
    rdfs:label "rhs (slot)" ;
    skos:altLabel "righthandside" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "rhs" .

tvbo:rng a owl:DatatypeProperty ;
    rdfs:label "rng (slot)" ;
    skos:definition "Random-seed policy across shards. ``deterministic`` (the default when unset) derives each task's seed from its shard index so the fan-out is reproducible." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "rng" .

tvbo:run_id a owl:DatatypeProperty ;
    rdfs:label "run_id (slot)" ;
    skos:definition "BIDS run number." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "run_id" .

tvbo:sample a owl:ObjectProperty ;
    rdfs:label "sample (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "sample" .

tvbo:sampler a owl:DatatypeProperty ;
    rdfs:label "sampler (slot)" ;
    skos:definition "MCMC sampler ('nuts'). Each backend maps its own way." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "sampler" .

tvbo:sampling_period a owl:DatatypeProperty ;
    rdfs:label "sampling_period (slot)" ;
    skos:definition "Time between samples (inverse of sampling_rate)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "sampling_period" .

tvbo:sampling_period_unit a owl:DatatypeProperty ;
    rdfs:label "sampling_period_unit (slot)" ;
    skos:definition "Unit of the sampling period (e.g., 'ms', 's')." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "sampling_period_unit" .

tvbo:scale a owl:DatatypeProperty ;
    rdfs:label "scale (slot)" ;
    skos:definition "BIDS scale- entity (BEP017, e.g., 1000)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "scale" .

tvbo:scipy_ode_base a owl:DatatypeProperty ;
    rdfs:label "scipy_ode_base (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "scipy_ode_base" .

tvbo:seed_offset a owl:DatatypeProperty ;
    rdfs:label "seed_offset (slot)" ;
    skos:definition "Sub-stream this step draws from, offset from the generator's seed. Two seeded steps must use different offsets to be independent. Stated here rather than inferred from step order so it is a property of the generator that every backend derives identically (numpy re-seeds, jax folds the offset into the key) — and so inserting or reordering steps cannot silently change an existing generator's output." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "seed_offset" .

tvbo:segmentation a owl:DatatypeProperty ;
    rdfs:label "segmentation (slot)" ;
    skos:definition "BIDS seg- entity (e.g., ordered, ranked, 17Networks)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "segmentation" .

tvbo:session_id a owl:DatatypeProperty ;
    rdfs:label "session_id (slot)" ;
    skos:definition "BIDS session identifier." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "session_id" .

tvbo:sigma a owl:DatatypeProperty ;
    rdfs:label "sigma (slot)" ;
    skos:definition "Observation-noise scale of the likelihood. May deliberately differ from the data's generative noise — it sets how tightly the likelihood constrains the (possibly degenerate) parameter ridge." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "sigma" .

tvbo:simulation_period a owl:DatatypeProperty ;
    rdfs:label "simulation_period (slot)" ;
    skos:definition "Duration of each simulation step (e.g., one BOLD TR)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "simulation_period" .

tvbo:skip_t a owl:DatatypeProperty ;
    rdfs:label "skip_t (slot)" ;
    skos:definition "Number of samples to skip at the start (transient removal). For FC: typically 10-20 TRs." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "skip_t" .

tvbo:slurm a owl:ObjectProperty ;
    rdfs:label "slurm (slot)" ;
    skos:definition "Slurm sbatch directives for array-job execution." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "slurm" .

tvbo:snakemake a owl:ObjectProperty ;
    rdfs:label "snakemake (slot)" ;
    skos:definition "Snakemake execution directives." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "snakemake" .

<https://w3id.org/tvbo/software/application_category> a owl:DatatypeProperty ;
    rdfs:label "application_category (software)" ;
    skos:definition "High-level category (e.g., simulation, analysis, specification)." ;
    skos:inScheme tvbo:software ;
    skos:notation "application_category" .

<https://w3id.org/tvbo/software/build_hash> a owl:DatatypeProperty ;
    rdfs:label "build_hash (software)" ;
    skos:definition "Deterministic hash of the resolved dependency set." ;
    skos:inScheme tvbo:software ;
    skos:notation "build_hash" .

<https://w3id.org/tvbo/software/container_image> a owl:DatatypeProperty ;
    rdfs:label "container_image (software)" ;
    skos:definition "Container image reference (e.g., ghcr.io/org/img:tag@sha256:...)." ;
    skos:inScheme tvbo:software ;
    skos:notation "container_image" .

<https://w3id.org/tvbo/software/date_created> a owl:DatatypeProperty ;
    rdfs:label "date_created (software)" ;
    skos:definition "Date the software was first released (YYYY-MM-DD)." ;
    skos:inScheme tvbo:software ;
    skos:notation "date_created" .

<https://w3id.org/tvbo/software/date_modified> a owl:DatatypeProperty ;
    rdfs:label "date_modified (software)" ;
    skos:definition "Date of the most recent release or significant update." ;
    skos:inScheme tvbo:software ;
    skos:notation "date_modified" .

<https://w3id.org/tvbo/software/development_status> a owl:ObjectProperty ;
    rdfs:label "development_status (software)" ;
    skos:definition "Development status (repostatus.org aligned)." ;
    skos:inScheme tvbo:software ;
    skos:notation "development_status" .

<https://w3id.org/tvbo/software/doi> a owl:DatatypeProperty ;
    rdfs:label "doi (software)" ;
    skos:definition "Digital Object Identifier for the software or its reference publication." ;
    skos:inScheme tvbo:software ;
    skos:notation "doi" .

<https://w3id.org/tvbo/software/environment_type> a owl:ObjectProperty ;
    rdfs:label "environment_type (software)" ;
    skos:definition "Category: conda, venv, docker, etc." ;
    skos:inScheme tvbo:software ;
    skos:notation "environment_type" .

<https://w3id.org/tvbo/software/hash> a owl:DatatypeProperty ;
    rdfs:label "hash (software)" ;
    skos:definition "Build or artifact hash for exact reproducibility." ;
    skos:inScheme tvbo:software ;
    skos:notation "hash" .

<https://w3id.org/tvbo/software/homepage> a owl:DatatypeProperty ;
    rdfs:label "homepage (software)" ;
    skos:definition "Project homepage URL." ;
    skos:inScheme tvbo:software ;
    skos:notation "homepage" .

<https://w3id.org/tvbo/software/is_accessible_for_free> a owl:DatatypeProperty ;
    rdfs:label "is_accessible_for_free (software)" ;
    skos:definition "Whether the tool is free/open-source." ;
    skos:inScheme tvbo:software ;
    skos:notation "is_accessible_for_free" .

<https://w3id.org/tvbo/software/issue_tracker> a owl:DatatypeProperty ;
    rdfs:label "issue_tracker (software)" ;
    skos:definition "URL of the bug tracker or issue board." ;
    skos:inScheme tvbo:software ;
    skos:notation "issue_tracker" .

<https://w3id.org/tvbo/software/label> a owl:DatatypeProperty ;
    rdfs:label "label (software)" ;
    skos:inScheme tvbo:software ;
    skos:notation "label" .

<https://w3id.org/tvbo/software/optional> a owl:DatatypeProperty ;
    rdfs:label "optional (software)" ;
    skos:inScheme tvbo:software ;
    skos:notation "optional" .

<https://w3id.org/tvbo/software/package> a owl:ObjectProperty ;
    rdfs:label "package (software)" ;
    skos:definition "Reference to the software package identity." ;
    skos:inScheme tvbo:software ;
    skos:notation "package" .

<https://w3id.org/tvbo/software/platform> a owl:DatatypeProperty ;
    rdfs:label "platform (software)" ;
    skos:definition "OS / architecture (e.g., linux-64, macos-arm64)." ;
    skos:inScheme tvbo:software ;
    skos:notation "platform" .

<https://w3id.org/tvbo/software/reference_publication> a owl:DatatypeProperty ;
    rdfs:label "reference_publication (software)" ;
    skos:definition "DOI of the primary reference publication for this tool." ;
    skos:inScheme tvbo:software ;
    skos:notation "reference_publication" .

<https://w3id.org/tvbo/software/repository> a owl:DatatypeProperty ;
    rdfs:label "repository (software)" ;
    skos:definition "Source code repository URL." ;
    skos:inScheme tvbo:software ;
    skos:notation "repository" .

<https://w3id.org/tvbo/software/role> a owl:ObjectProperty ;
    rdfs:label "role (software)" ;
    skos:inScheme tvbo:software ;
    skos:notation "role" .

<https://w3id.org/tvbo/software/source_url> a owl:DatatypeProperty ;
    rdfs:label "source_url (software)" ;
    skos:definition "Canonical source or repository URL." ;
    skos:inScheme tvbo:software ;
    skos:notation "source_url" .

<https://w3id.org/tvbo/software/url> a owl:DatatypeProperty ;
    rdfs:label "url (software)" ;
    skos:definition "(Deprecated) Use source_url." ;
    skos:inScheme tvbo:software ;
    skos:notation "url" .

<https://w3id.org/tvbo/software/version_spec> a owl:DatatypeProperty ;
    rdfs:label "version_spec (software)" ;
    skos:definition "Version or constraint specifier (e.g., '==2.7.3', '>=1.2,<2')." ;
    skos:inScheme tvbo:software ;
    skos:notation "version_spec" .

tvbo:software_environment a owl:ObjectProperty ;
    rdfs:label "software_environment (slot)" ;
    skos:definition "Software environment used to generate this data." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "software_environment" .

tvbo:source_branch a owl:DatatypeProperty ;
    rdfs:label "source_branch (slot)" ;
    skos:definition "Name of a previously computed branch (for from_branch method)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "source_branch" .

tvbo:source_network a owl:DatatypeProperty ;
    rdfs:label "source_network (slot)" ;
    skos:definition "Path or name of the Network whose nodes define the source endpoints of this Edge. Symmetric counterpart to `target_network`. Together they let an Edge bridge any two Networks: both unset (within-Network edge), one set (this Network ↔ the named one), or both set (peer-to-peer projection between two other Networks). Accepts either an absolute IRI (peer Network) or the relative-path sentinel `parent` / `parent/parent` (cross-scale up/down via the Node.subnetwork hierarchy)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "source_network" .

tvbo:source_var a owl:DatatypeProperty ;
    rdfs:label "source_var (slot)" ;
    skos:altLabel "source_variable" ;
    skos:definition "Output variable from source node to use (e.g., 'x_out'). If not specified, uses first output variable from source dynamics. The alias `source_variable` is accepted (harmonized with the `*_variable` spelling used elsewhere, e.g. the stimulus event's `target_variable`)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "source_var" .

tvbo:sparse a owl:DatatypeProperty ;
    rdfs:label "sparse (slot)" ;
    skos:definition "Whether the coupling uses sparse representations" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "sparse" .

tvbo:spines a owl:DatatypeProperty ;
    rdfs:label "spines (slot)" ;
    skos:definition "Axes spine style: 'box' (all 4 spines, closed boxes — e.g. Taher) or 'open' (left+bottom only). Unset defers to the active style. Pair 'box' with auto_format: false — bsplot's format_fig otherwise detaches and trims spines (the open 'nature' look)." ;
    skos:inScheme tvbo:figure ;
    skos:notation "spines" .

tvbo:step a owl:ObjectProperty ;
    rdfs:label "step (slot)" ;
    skos:definition "Step size. Can be: number, argument name, or expression." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "step" .

tvbo:stimulation a owl:ObjectProperty ;
    rdfs:label "stimulation (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "stimulation" .

tvbo:stimulation_variable a owl:DatatypeProperty ;
    rdfs:label "stimulation_variable (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "stimulation_variable" .

tvbo:stimulus a owl:ObjectProperty ;
    rdfs:label "stimulus (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "stimulus" .

tvbo:strategy a owl:DatatypeProperty ;
    rdfs:label "strategy (slot)" ;
    skos:definition "Search strategy over the decision space (the `space` axes). 'grid' (default) exhaustively evaluates the Cartesian/zip grid of axis points — today's behaviour. 'nsga2' runs an adaptive multi-objective genetic search (pymoo NSGA-II) that returns the non-dominated Pareto front over `objectives`; axes then supply only decision-variable bounds (domain lo/hi), and per-strategy hyper-parameters (population_size, num_generations, seed, reference_point) live in `parameters`. Extensible later to 'random' / 'sobol' / 'cmaes'. Forward-compatible with the planned unified `Search.strategy` (see dev/unified_search.md)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "strategy" .

<https://w3id.org/tvbo/study/Subject> a owl:Class ;
    rdfs:label "Subject (study)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/study/group> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/metadata> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/age> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/age> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/study/metadata> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/sex> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/network> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/subject_id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/sex> ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:SexEnum ;
            owl:onProperty <https://w3id.org/tvbo/study/sex> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/label> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/study/network> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tvbo/study/Session> ;
            owl:onProperty <https://w3id.org/tvbo/study/sessions> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/study/subject_id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/group> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/network> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://w3id.org/tvbo/study/age> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/sessions> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/metadata> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/label> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/study/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/group> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/subject_id> ] ;
    skos:definition "A participant in a study. Each subject typically has their own brain network (connectome) and empirical recordings. Corresponds to a BIDS 'sub-' entity." ;
    skos:inScheme tvbo:study ;
    skos:notation "Subject" .

<https://w3id.org/tvbo/study/age> a owl:DatatypeProperty ;
    rdfs:label "age (study)" ;
    skos:definition "Age at time of study (years)." ;
    skos:inScheme tvbo:study ;
    skos:notation "age" .

<https://w3id.org/tvbo/study/bids_root> a owl:DatatypeProperty ;
    rdfs:label "bids_root (study)" ;
    skos:definition "Path to BIDS dataset root directory. When set, subject networks and empirical data paths are resolved relative to this root." ;
    skos:inScheme tvbo:study ;
    skos:notation "bids_root" .

<https://w3id.org/tvbo/study/bundle> a owl:DatatypeProperty ;
    rdfs:label "bundle (study)" ;
    skos:definition "When true, emitting a self-contained kit copies this dataset's per-subject files into the kit (``spec/<exp>/dataset/``) and rewrites ``bids_root`` to that bundled copy, so the kit needs no external mount or ``$TVBO_BIDS_ROOT`` at run time. The exact files are resolved from the dataset-sourced observation's BIDS query (atlas, desc, …) — the same query that scopes the fan-out — so no CLI selection is needed. Declares the packaging intent in metadata instead of a ``--bundle-dataset`` flag; a subset is scoped via ``subjects``." ;
    skos:inScheme tvbo:study ;
    skos:notation "bundle" .

<https://w3id.org/tvbo/study/condition> a owl:DatatypeProperty ;
    rdfs:label "condition (study)" ;
    skos:definition "Experimental condition label (e.g., 'rest', 'task-nback'). Maps to BIDS 'task-' entity." ;
    skos:inScheme tvbo:study ;
    skos:notation "condition" .

<https://w3id.org/tvbo/study/dataset_id> a owl:DatatypeProperty ;
    rdfs:label "dataset_id (study)" ;
    rdfs:range xsd:string ;
    skos:definition "Unique identifier for the dataset." ;
    skos:inScheme tvbo:study ;
    skos:notation "dataset_id" .

<https://w3id.org/tvbo/study/description> a owl:DatatypeProperty ;
    rdfs:label "description (study)" ;
    skos:inScheme tvbo:study ;
    skos:notation "description" .

<https://w3id.org/tvbo/study/group> a owl:DatatypeProperty ;
    rdfs:label "group (study)" ;
    skos:definition "Group assignment (e.g., 'control', 'patient', 'healthy'). Maps to participants.tsv 'group' column in BIDS." ;
    skos:inScheme tvbo:study ;
    skos:notation "group" .

<https://w3id.org/tvbo/study/metadata> a owl:DatatypeProperty ;
    rdfs:label "metadata (study)" ;
    skos:definition "Additional subject metadata as key-value pairs or path to a sidecar JSON file." ;
    skos:inScheme tvbo:study ;
    skos:notation "metadata" .

<https://w3id.org/tvbo/study/reference> a owl:DatatypeProperty ;
    rdfs:label "reference (study)" ;
    skos:definition "DOI or citation for this dataset." ;
    skos:inScheme tvbo:study ;
    skos:notation "reference" .

<https://w3id.org/tvbo/study/session_id> a owl:DatatypeProperty ;
    rdfs:label "session_id (study)" ;
    rdfs:range xsd:string ;
    skos:definition "BIDS session identifier (without 'ses-' prefix). Examples: 'baseline', '6month', 'pre', 'post'." ;
    skos:inScheme tvbo:study ;
    skos:notation "session_id" .

<https://w3id.org/tvbo/study/sex> a owl:ObjectProperty ;
    rdfs:label "sex (study)" ;
    skos:definition "Biological sex." ;
    skos:inScheme tvbo:study ;
    skos:notation "sex" .

<https://w3id.org/tvbo/study/subject_id> a owl:DatatypeProperty ;
    rdfs:label "subject_id (study)" ;
    rdfs:range xsd:string ;
    skos:definition "BIDS-compatible subject identifier (without 'sub-' prefix). Examples: '01', 'ctrl03', 'patient17'." ;
    skos:exactMatch schema1:identifier ;
    skos:inScheme tvbo:study ;
    skos:notation "subject_id" .

tvbo:subdir a owl:DatatypeProperty ;
    rdfs:label "subdir (slot)" ;
    skos:definition "Subdirectory within the source to place on the import path (defaults to the source root)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "subdir" .

tvbo:subject_id a owl:DatatypeProperty ;
    rdfs:label "subject_id (slot)" ;
    skos:definition "BIDS subject identifier." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "subject_id" .

tvbo:subnetwork a owl:ObjectProperty ;
    rdfs:label "subnetwork (slot)" ;
    skos:definition "Optional finer-scale Network that \"lives inside\" this Node (network-of-networks / multi-scale primitive). The subnetwork's nodes map (one-to-many) to this single parent Node. Cross-scale signal flow is declared as ordinary Edges in the subnetwork's `edges` list, using `source_network` / `target_network` with the `parent` sentinel to traverse up the hierarchy. The subnetwork may carry its own `graph_generator` (discrete sub-network — reservoir, spiking population, jaxley compartments) and/or `mesh` (continuous surface field) — one unified slot for reservoirs-per-region, spiking-populations-per-region, cells-per-region, and surface-mesh-patches-per-region. Recursive: a subnetwork's Nodes can themselves carry subnetworks." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "subnetwork" .

tvbo:suffix a owl:DatatypeProperty ;
    rdfs:label "suffix (slot)" ;
    skos:definition "BIDS suffix (e.g., relmat), the trailing name component before the extension" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "suffix" .

tvbo:surrogate a owl:ObjectProperty ;
    rdfs:label "surrogate (slot)" ;
    skos:definition "Optional permutation-significance test: this derived variable's value is the exceedance p-value of a named statistic under permutations of a field (a general surrogate null — any permutation test, not wave-specific — emitted as a vmap-fold over the captured permutations; the wrapped statistic stays symbolic). When set, the variable's own ``equation`` may be omitted." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "surrogate" .

tvbo:sweep_direction a owl:ObjectProperty ;
    rdfs:label "sweep_direction (slot)" ;
    skos:definition "Order in which a branch-following axis (sweep_seeding: from_previous) is traversed: 'up' increases the parameter once, 'down' decreases it once, 'bidirectional' increases then decreases over the same values and records both branches — a hysteresis loop where they differ. Ignored when sweep_seeding is 'independent'. Applies to a single swept axis." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "sweep_direction" .

tvbo:sweep_seeding a owl:ObjectProperty ;
    rdfs:label "sweep_seeding (slot)" ;
    skos:definition "How each sweep point's initial state is obtained. 'independent' (default) cold-starts every point from the model's initial values, so points are order-independent and may run in parallel (see parallel_mode). 'from_previous' seeds each point from the final state of the preceding point, so the trajectory follows the solution branch as the swept parameter changes quasi-statically; this forces sequential execution (a scan, not a vmap) and, with sweep_direction, exposes hysteresis / multistability. It is forward-integration branch following, not numerical continuation (cf. the Continuation class)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "sweep_seeding" .

tvbo:symmetry a owl:DatatypeProperty ;
    rdfs:label "symmetry (slot)" ;
    skos:definition "Edge symmetry type for NetworkDynamics.jl EdgeModel: 'directed' (default), 'antisymmetric', or 'symmetric'. AntiSymmetric edges flip sign for the reverse direction." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "symmetry" .

tvbo:system_type a owl:ObjectProperty ;
    rdfs:label "system_type (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "system_type" .

tvbo:tail_samples a owl:DatatypeProperty ;
    rdfs:label "tail_samples (slot)" ;
    skos:definition "Number of samples from the end to use. Takes the last N samples before aggregation. E.g., tail_samples: 500 means use data[-500:]." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "tail_samples" .

tvbo:target_component a owl:DatatypeProperty ;
    rdfs:label "target_component (slot)" ;
    skos:definition "Component to attach this event to. Can be a node label, edge label, or 'all_edges'/'all_vertices' for broadcast. If not specified, event is experiment-level." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "target_component" .

tvbo:target_data a owl:ObjectProperty ;
    rdfs:label "target_data (slot)" ;
    skos:definition "Reference to empirical data observation for matching objectives" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "target_data" .

tvbo:target_network a owl:DatatypeProperty ;
    rdfs:label "target_network (slot)" ;
    skos:definition "Path or name of the Network whose nodes define the target endpoints (e.g. the columns of a non-square projection matrix such as a gain matrix region → EEG sensors). Also accepts the relative-path sentinel `parent` / `parent/parent` for cross-scale signal flow up the Node.subnetwork hierarchy. One mechanism handles both projection matrices (absolute IRI) and multi-scale boundaries (sentinel)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "target_network" .

tvbo:target_parameter a owl:ObjectProperty ;
    rdfs:label "target_parameter (slot)" ;
    skos:definition "The parameter to update (e.g., J_i, wLRE)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "target_parameter" .

tvbo:target_range a owl:ObjectProperty ;
    rdfs:label "target_range (slot)" ;
    skos:definition "Target interval for a `minmax_rescale` step (e.g. lo -1, hi 1)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "target_range" .

tvbo:target_value a owl:DatatypeProperty ;
    rdfs:label "target_value (slot)" ;
    skos:definition "Target value for activity objectives" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "target_value" .

tvbo:target_var a owl:DatatypeProperty ;
    rdfs:label "target_var (slot)" ;
    skos:altLabel "target_variable" ;
    skos:definition "Input variable on target node to connect to (e.g., 'c_in'). If not specified, uses first coupling input from target dynamics. The alias `target_variable` is accepted." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "target_var" .

tvbo:task_iri a owl:DatatypeProperty ;
    rdfs:label "task_iri (slot)" ;
    skos:definition "Cognitive Atlas (``cogat:``) IRI of the assessment instrument / task that produced this measure (e.g. ``cogat:trm_4a3fd79d09cba`` for PMAT24)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "task_iri" .

tvbo:task_name a owl:DatatypeProperty ;
    rdfs:label "task_name (slot)" ;
    skos:definition "BIDS task name for the simulation (e.g., 'rest', 'simulation')." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "task_name" .

tvbo:template a owl:DatatypeProperty ;
    rdfs:label "template (slot)" ;
    skos:definition "BIDS tpl- entity (e.g., FSLMNI152, MNI152NLin2009cAsym)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "template" .

tvbo:tensor_coefficient a owl:ObjectProperty ;
    rdfs:label "tensor_coefficient (slot)" ;
    skos:definition "Optional anisotropic tensor (e.g., diffusion)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "tensor_coefficient" .

tvbo:text a owl:DatatypeProperty ;
    rdfs:label "text (slot)" ;
    skos:inScheme tvbo:figure ;
    skos:notation "text" .

tvbo:time_unit a owl:ObjectProperty ;
    rdfs:label "time_unit (slot)" ;
    skos:definition "Default time unit for the network" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "time_unit" .

tvbo:title a owl:DatatypeProperty ;
    rdfs:label "title (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "title" .

tvbo:tol_stability a owl:DatatypeProperty ;
    rdfs:label "tol_stability (slot)" ;
    skos:definition "Tolerance on real part of eigenvalue for stability boundary." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "tol_stability" .

tvbo:tractogram a owl:ObjectProperty ;
    rdfs:label "tractogram (slot)" ;
    skos:definition "Reference to tractography data" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "tractogram" .

tvbo:transient_time a owl:DatatypeProperty ;
    rdfs:label "transient_time (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "transient_time" .

tvbo:trim_margins a owl:DatatypeProperty ;
    rdfs:label "trim_margins (slot)" ;
    skos:definition "Trim surrounding whitespace from the saved figure (default true). Trimming re-crops to the drawn content, so the saved aspect can differ from width/height; set false to preserve the declared width×height proportions exactly, e.g. to match an original figure. Renders as bbox_inches='tight' on a matplotlib backend." ;
    skos:inScheme tvbo:figure ;
    skos:notation "trim_margins" .

tvbo:truncation_window a owl:DatatypeProperty ;
    rdfs:label "truncation_window (slot)" ;
    skos:definition "Truncated-BPTT window in milliseconds of simulated time: gradients flow back at most this far. Omit for full BPTT." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "truncation_window" .

tvbo:update_expression a owl:ObjectProperty ;
    rdfs:label "update_expression (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "update_expression" .

tvbo:valid_diagonal a owl:DatatypeProperty ;
    rdfs:label "valid_diagonal (slot)" ;
    skos:definition "Self-connections are meaningful" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "valid_diagonal" .

tvbo:variable_of_interest a owl:DatatypeProperty ;
    rdfs:label "variable_of_interest (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "variable_of_interest" .

tvbo:vectorized a owl:DatatypeProperty ;
    rdfs:label "vectorized (slot)" ;
    skos:definition "Opt in to the vectorized matmul fast path for a source-only coupling — one whose pre_expression depends only on source states (e.g. the angle-addition decomposition [sin(theta_j), cos(theta_j)]). The W-reduction then becomes a single ``pre @ weights`` matmul instead of materialising the dense per-edge tensor. ONLY valid for INSTANTANEOUS coupling on a SYMMETRIC connectome (W == Wᵀ): the matmul contracts W while the per-edge path contracts Wᵀ, so the two agree only when W is symmetric. Default false keeps the always-correct per-edge reduction (and delays are inherently per-edge, so this flag is ignored when delayed=true)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "vectorized" .

tvbo:venv a owl:DatatypeProperty ;
    rdfs:label "venv (slot)" ;
    skos:definition "Path to a virtual environment to activate before running." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "venv" .

tvbo:vertices_field a owl:DatatypeProperty ;
    rdfs:label "vertices_field (slot)" ;
    skos:definition "When the mesh is inlined on a Network, the dotted path inside the parent's h5 to vertex coordinates. Default: ``nodes/coordinates``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "vertices_field" .

tvbo:voi a owl:DatatypeProperty ;
    rdfs:label "voi (slot)" ;
    skos:definition "Variable of interest index (which state variable to monitor). Default: 0." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "voi" .

tvbo:warmup a owl:DatatypeProperty ;
    rdfs:label "warmup (slot)" ;
    skos:definition "Whether to apply learning rate warmup to this update rule. When true, the learning rate (eta) is scaled by (i+1)/n_iterations." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "warmup" .

tvbo:warmup_from a owl:ObjectProperty ;
    rdfs:label "warmup_from (slot)" ;
    skos:definition "Previous stage to initialize from. Final values from that stage become initial values for this stage." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "warmup_from" .

tvbo:weight a owl:DatatypeProperty ;
    rdfs:label "weight (slot)" ;
    skos:definition "Connection weight (explicit edges)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "weight" .

tvbo:weight_distribution a owl:ObjectProperty ;
    rdfs:label "weight_distribution (slot)" ;
    skos:definition "Distribution to sample per-region stimulus weights from, as an alternative to the explicit `weighting` array (e.g. Uniform(-1, 1) per node). When set, the codegen samples one weight per target region using the distribution's seed." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "weight_distribution" .

tvbo:weighted a owl:DatatypeProperty ;
    rdfs:label "weighted (slot)" ;
    skos:definition "Matrix entries carry weights (not just 0/1)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "weighted" .

tvbo:width a owl:DatatypeProperty ;
    rdfs:label "width (slot)" ;
    skos:definition "Figure width in mm (physical print size). Font size is in points and independent of this, so a smaller figure makes text relatively larger." ;
    skos:inScheme tvbo:figure ;
    skos:notation "width" .

tvbo:window_size a owl:DatatypeProperty ;
    rdfs:label "window_size (slot)" ;
    skos:definition "Number of samples for windowed aggregation" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "window_size" .

tvbo:workflow_overrides a owl:ObjectProperty ;
    rdfs:label "workflow_overrides (slot)" ;
    skos:definition "Per-figure HPC/workflow resource refinement (reuses WorkflowConfig, same pattern as SimulationExperiment.workflow_overrides); lets a heavy render request its own resources when figures are emitted as workflow jobs. The figure's Layer.used edges become the render rule's input dependencies." ;
    skos:inScheme tvbo:figure ;
    skos:notation "workflow_overrides" .

tvbo:year a owl:DatatypeProperty ;
    rdfs:label "year (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "year" .

tvbo:z a owl:DatatypeProperty ;
    rdfs:label "z (slot)" ;
    skos:definition "Depth channel for a line3d panel (the third phase-space axis); ignored by 2-D kinds." ;
    skos:inScheme tvbo:figure ;
    skos:notation "z" .

