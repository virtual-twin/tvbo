tvbo:Optimization a owl:Class ;
    rdfs:label "Optimization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:loss ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Algorithm ;
            owl:onProperty tvbo:depends_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:execution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:stages ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:FunctionCall ;
            owl:onProperty tvbo:loss ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:ExecutionConfig ;
            owl:onProperty tvbo:execution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:depends_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:OptimizationStage ;
            owl:onProperty tvbo:stages ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:depends_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Integrator ;
            owl:onProperty tvbo:integration ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:execution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:loss ],
        tvbo:OptimizationStage ;
    skos:definition "Configuration for parameter optimization. Inherits single-stage fields from OptimizationStage. For multi-stage workflows, use 'stages' (ignores inherited single-stage fields). Loss equation references observations directly by name." ;
    skos:exactMatch tvbo:Optimization ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:PDE a owl:Class ;
