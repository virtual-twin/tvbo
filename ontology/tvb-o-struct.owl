        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:callable ] ;
    skos:definition "Per-backend construction binding for a GraphGenerator: how to build the graph in a specific target library.  Keyed by backend id — the ``name`` is the backend (e.g. python, julia, networkx)." ;
