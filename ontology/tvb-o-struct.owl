    skos:inScheme <https://w3id.org/tvbo> .

tvbo:sample a owl:ObjectProperty ;
    rdfs:label "sample" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:sampling_period a owl:DatatypeProperty ;
    rdfs:label "sampling_period" ;
    skos:definition "Time between samples (inverse of sampling_rate)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:sampling_period_unit a owl:DatatypeProperty ;
    rdfs:label "sampling_period_unit" ;
    skos:definition "Unit of the sampling period (e.g., 'ms', 's')." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:sampling_rate a owl:DatatypeProperty ;
    rdfs:label "sampling_rate" ;
    skos:definition "Sampling rate in Hz." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:scale a owl:DatatypeProperty ;
    rdfs:label "scale" ;
    skos:definition "BIDS scale- entity (BEP017, e.g., 1000)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:scipy_ode_base a owl:DatatypeProperty ;
    rdfs:label "scipy_ode_base" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:segmentation a owl:DatatypeProperty ;
    rdfs:label "segmentation" ;
    skos:definition "BIDS seg- entity (e.g., ordered, ranked, 17Networks)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:session_id a owl:DatatypeProperty ;
    rdfs:label "session_id" ;
    skos:definition "BIDS session identifier." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:simulation_period a owl:DatatypeProperty ;
    rdfs:label "simulation_period" ;
    skos:definition "Duration of each simulation step (e.g., one BOLD TR)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:size a owl:DatatypeProperty ;
    rdfs:label "size" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:skip_t a owl:DatatypeProperty ;
    rdfs:label "skip_t" ;
    skos:definition "Number of samples to skip at the start (transient removal). For FC: typically 10-20 TRs." ;
    skos:inScheme <https://w3id.org/tvbo> .

<http://www.thevirtualbrain.org/tvb-o/software/application_category> a owl:DatatypeProperty ;
    rdfs:label "application_category" ;
    skos:definition "High-level category (e.g., simulation, analysis, specification)." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/build_hash> a owl:DatatypeProperty ;
    rdfs:label "build_hash" ;
    skos:definition "Deterministic hash of the resolved dependency set." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/container_image> a owl:DatatypeProperty ;
    rdfs:label "container_image" ;
    skos:definition "Container image reference (e.g., ghcr.io/org/img:tag@sha256:...)." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/date_created> a owl:DatatypeProperty ;
    rdfs:label "date_created" ;
    skos:definition "Date the software was first released (YYYY-MM-DD)." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/date_modified> a owl:DatatypeProperty ;
    rdfs:label "date_modified" ;
    skos:definition "Date of the most recent release or significant update." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/development_status> a owl:ObjectProperty ;
    rdfs:label "development_status" ;
    skos:definition "Development status (repostatus.org aligned)." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/doi> a owl:DatatypeProperty ;
    rdfs:label "doi" ;
    skos:definition "Digital Object Identifier for the software or its reference publication." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/environment_type> a owl:ObjectProperty ;
    rdfs:label "environment_type" ;
    skos:definition "Category: conda, venv, docker, etc." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/hash> a owl:DatatypeProperty ;
    rdfs:label "hash" ;
    skos:definition "Build or artifact hash for exact reproducibility." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/homepage> a owl:DatatypeProperty ;
    rdfs:label "homepage" ;
    skos:definition "Project homepage URL." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/is_accessible_for_free> a owl:DatatypeProperty ;
    rdfs:label "is_accessible_for_free" ;
    skos:definition "Whether the tool is free/open-source." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/issue_tracker> a owl:DatatypeProperty ;
    rdfs:label "issue_tracker" ;
    skos:definition "URL of the bug tracker or issue board." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/label> a owl:DatatypeProperty ;
    rdfs:label "label" ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/optional> a owl:DatatypeProperty ;
    rdfs:label "optional" ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/package> a owl:ObjectProperty ;
    rdfs:label "package" ;
    skos:definition "Reference to the software package identity." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/platform> a owl:DatatypeProperty ;
    rdfs:label "platform" ;
    skos:definition "OS / architecture (e.g., linux-64, macos-arm64)." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/reference_publication> a owl:DatatypeProperty ;
    rdfs:label "reference_publication" ;
    skos:definition "DOI of the primary reference publication for this tool." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/repository> a owl:DatatypeProperty ;
    rdfs:label "repository" ;
    skos:definition "Source code repository URL." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/role> a owl:ObjectProperty ;
    rdfs:label "role" ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/source_url> a owl:DatatypeProperty ;
    rdfs:label "source_url" ;
    skos:definition "Canonical source or repository URL." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/url> a owl:DatatypeProperty ;
    rdfs:label "url" ;
    skos:definition "(Deprecated) Use source_url." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/version_spec> a owl:DatatypeProperty ;
    rdfs:label "version_spec" ;
    skos:definition "Version or constraint specifier (e.g., '==2.7.3', '>=1.2,<2')." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

tvbo:software_environment a owl:ObjectProperty ;
    rdfs:label "software_environment" ;
    skos:definition "Software environment used to generate this data." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:source_branch a owl:DatatypeProperty ;
    rdfs:label "source_branch" ;
    skos:definition "Name of a previously computed branch (for from_branch method)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:source_experiment a owl:ObjectProperty ;
    rdfs:label "source_experiment" ;
    skos:definition "Reference to the SimulationExperiment that generated this TimeSeries." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:source_var a owl:DatatypeProperty ;
    rdfs:label "source_var" ;
    skos:definition "Output variable from source node to use (e.g., 'x_out'). If not specified, uses first output variable from source dynamics." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:sparse a owl:DatatypeProperty ;
    rdfs:label "sparse" ;
    skos:definition "Whether the coupling uses sparse representations" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:step a owl:ObjectProperty ;
    rdfs:label "step" ;
    skos:definition "Step size. Can be: number, argument name, or expression." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:step_size a owl:DatatypeProperty ;
    rdfs:label "step_size" ;
    skos:altLabel "dt" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:steps a owl:DatatypeProperty ;
    rdfs:label "steps" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:stimulation a owl:ObjectProperty ;
    rdfs:label "stimulation" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:stimulation_variable a owl:DatatypeProperty ;
    rdfs:label "stimulation_variable" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:stimulus a owl:ObjectProperty ;
    rdfs:label "stimulus" ;
    skos:inScheme <https://w3id.org/tvbo> .

<http://www.thevirtualbrain.org/tvb-o/study/Subject> a owl:Class ;
    rdfs:label "Subject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/network> ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:SexEnum ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/sex> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.thevirtualbrain.org/tvb-o/study/Session> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/sessions> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/metadata> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/group> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/metadata> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/sex> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/label> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/subject_id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/metadata> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/sex> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/age> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/label> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/network> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/sessions> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/group> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/subject_id> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/subject_id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/age> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/group> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/age> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/network> ] ;
    skos:definition "A participant in a study. Each subject typically has their own brain network (connectome) and empirical recordings. Corresponds to a BIDS 'sub-' entity." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/age> a owl:DatatypeProperty ;
    rdfs:label "age" ;
    skos:definition "Age at time of study (years)." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/bids_root> a owl:DatatypeProperty ;
    rdfs:label "bids_root" ;
    skos:definition "Path to BIDS dataset root directory. When set, subject networks and empirical data paths are resolved relative to this root." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/condition> a owl:DatatypeProperty ;
    rdfs:label "condition" ;
    skos:definition "Experimental condition label (e.g., 'rest', 'task-nback'). Maps to BIDS 'task-' entity." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/dataset_id> a owl:DatatypeProperty ;
    rdfs:label "dataset_id" ;
    rdfs:range xsd:string ;
    skos:definition "Unique identifier for the dataset." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/description> a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/group> a owl:DatatypeProperty ;
    rdfs:label "group" ;
    skos:definition "Group assignment (e.g., 'control', 'patient', 'healthy'). Maps to participants.tsv 'group' column in BIDS." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/metadata> a owl:DatatypeProperty ;
    rdfs:label "metadata" ;
    skos:definition "Additional subject metadata as key-value pairs or path to a sidecar JSON file." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/reference> a owl:DatatypeProperty ;
    rdfs:label "reference" ;
    skos:definition "DOI or citation for this dataset." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/session_id> a owl:DatatypeProperty ;
    rdfs:label "session_id" ;
    rdfs:range xsd:string ;
    skos:definition "BIDS session identifier (without 'ses-' prefix). Examples: 'baseline', '6month', 'pre', 'post'." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/sex> a owl:ObjectProperty ;
    rdfs:label "sex" ;
    skos:definition "Biological sex." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/subject_id> a owl:DatatypeProperty ;
    rdfs:label "subject_id" ;
    rdfs:range xsd:string ;
    skos:definition "BIDS-compatible subject identifier (without 'sub-' prefix). Examples: '01', 'ctrl03', 'patient17'." ;
    skos:exactMatch schema1:identifier ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

tvbo:subject_id a owl:DatatypeProperty ;
    rdfs:label "subject_id" ;
    skos:definition "BIDS subject identifier." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:symmetry a owl:DatatypeProperty ;
    rdfs:label "symmetry" ;
    skos:definition "Edge symmetry type for NetworkDynamics.jl EdgeModel: 'directed' (default), 'antisymmetric', or 'symmetric'. AntiSymmetric edges flip sign for the reverse direction." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:system_type a owl:ObjectProperty ;
    rdfs:label "system_type" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:tail_samples a owl:DatatypeProperty ;
    rdfs:label "tail_samples" ;
    skos:definition "Number of samples from the end to use. Takes the last N samples before aggregation. E.g., tail_samples: 500 means use data[-500:]." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:target a owl:DatatypeProperty ;
    rdfs:label "target" ;
    skos:definition "Target node ID (set for explicit edges, absent for template edges)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:target_component a owl:DatatypeProperty ;
    rdfs:label "target_component" ;
    skos:definition "Component to attach this event to. Can be a node label, edge label, or 'all_edges'/'all_vertices' for broadcast. If not specified, event is experiment-level." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:target_data a owl:ObjectProperty ;
    rdfs:label "target_data" ;
    skos:definition "Reference to empirical data observation for matching objectives" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:target_network a owl:DatatypeProperty ;
    rdfs:label "target_network" ;
    skos:definition "Path or name of the Network whose nodes define the columns of a non-square (projection) matrix. For example, a gain matrix with shape (n_sensors, n_regions) references the brain parcellation network here.  Row labels come from the parent Network's own nodes." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:target_parameter a owl:ObjectProperty ;
    rdfs:label "target_parameter" ;
    skos:definition "The parameter to update (e.g., J_i, wLRE)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:target_value a owl:DatatypeProperty ;
    rdfs:label "target_value" ;
    skos:definition "Target value for activity objectives" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:target_var a owl:DatatypeProperty ;
    rdfs:label "target_var" ;
    skos:definition "Input variable on target node to connect to (e.g., 'c_in'). If not specified, uses first coupling input from target dynamics." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:target_variable a owl:ObjectProperty ;
    rdfs:label "target_variable" ;
    skos:definition "State variable for activity targets (e.g., S_e)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:task_name a owl:DatatypeProperty ;
    rdfs:label "task_name" ;
    skos:definition "BIDS task name for the simulation (e.g., 'rest', 'simulation')." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:template a owl:DatatypeProperty ;
    rdfs:label "template" ;
    skos:definition "BIDS tpl- entity (e.g., FSLMNI152, MNI152NLin2009cAsym)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:tensor_coefficient a owl:ObjectProperty ;
    rdfs:label "tensor_coefficient" ;
    skos:definition "Optional anisotropic tensor (e.g., diffusion)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:time a owl:ObjectProperty ;
    rdfs:label "time" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:time_integrator a owl:DatatypeProperty ;
    rdfs:label "time_integrator" ;
    skos:definition "e.g., implicit Euler, Crank-Nicolson." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:time_unit a owl:ObjectProperty ;
    rdfs:label "time_unit" ;
    skos:definition "Default time unit for the network" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:tol_stability a owl:DatatypeProperty ;
    rdfs:label "tol_stability" ;
    skos:definition "Tolerance on real part of eigenvalue for stability boundary." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:tolerances a owl:DatatypeProperty ;
    rdfs:label "tolerances" ;
    skos:definition "Abs/rel tolerances." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:tractogram a owl:ObjectProperty ;
    rdfs:label "tractogram" ;
    skos:definition "Reference to tractography data" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:transient_time a owl:DatatypeProperty ;
    rdfs:label "transient_time" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:update_expression a owl:ObjectProperty ;
    rdfs:label "update_expression" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:valid_diagonal a owl:DatatypeProperty ;
    rdfs:label "valid_diagonal" ;
    skos:definition "Self-connections are meaningful" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:variable_of_interest a owl:DatatypeProperty ;
    rdfs:label "variable_of_interest" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:voi a owl:DatatypeProperty ;
    rdfs:label "voi" ;
    skos:definition "Variable of interest index (which state variable to monitor). Default: 0." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:warmup a owl:DatatypeProperty ;
    rdfs:label "warmup" ;
    skos:definition "Whether to apply learning rate warmup to this update rule. When true, the learning rate (eta) is scaled by (i+1)/n_iterations." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:warmup_from a owl:ObjectProperty ;
    rdfs:label "warmup_from" ;
    skos:definition "Previous stage to initialize from. Final values from that stage become initial values for this stage." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:weight a owl:DatatypeProperty ;
    rdfs:label "weight" ;
    skos:definition "Connection weight (explicit edges)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:weighted a owl:DatatypeProperty ;
    rdfs:label "weighted" ;
    skos:definition "Matrix entries carry weights (not just 0/1)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:window_size a owl:DatatypeProperty ;
    rdfs:label "window_size" ;
    skos:definition "Number of samples for windowed aggregation" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:x a owl:ObjectProperty ;
    rdfs:label "x" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:y a owl:ObjectProperty ;
    rdfs:label "y" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:year a owl:DatatypeProperty ;
    rdfs:label "year" ;
    skos:inScheme <https://w3id.org/tvbo> .

<http://uri.interlex.org/tgbugs/uris/readable/ParcellationEntity> a owl:Class ;
    rdfs:label "ParcellationEntity" ;
    dcterms:subject <anatomicalLocation>,
        <studyTarget> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/ParcellationEntity> ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/hasParent> ],
        [ a owl:Restriction ;
