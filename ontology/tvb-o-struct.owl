            owl:onProperty tvbo:source_point ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Solver ;
            owl:onProperty tvbo:solver ] ;
    skos:definition "How to obtain the starting equilibrium or periodic orbit for continuation. Most robust: time-integrate to steady state." ;
    skos:exactMatch tvbo:InitialState ;
