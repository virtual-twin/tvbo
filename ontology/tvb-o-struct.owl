    rdfs:range tvbo:UnitEnum ;
    skos:definition "Physical unit of measurement. Values are drawn from the QUDT ontology (http://qudt.org/vocab/unit/) with UO cross-references where available." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:Parameter a owl:Class ;
    rdfs:label "Parameter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:dataset_path ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:ScalarValue ;
            owl:onProperty tvbo:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Equation ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:default ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:symbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:symbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:dataset_path ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:comment ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Range ;
            owl:onProperty tvbo:domain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:reported_optimum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:distribution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:distribution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:heterogeneous ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:reported_optimum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:reported_optimum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:explored_values ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:default ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:free ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:UnitEnum ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:free ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty tvbo:free ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:shape ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:heterogeneous ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Distribution ;
            owl:onProperty tvbo:distribution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:explored_values ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:element_domains ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:shape ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:shape ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty tvbo:heterogeneous ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:default ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Range ;
            owl:onProperty tvbo:element_domains ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:dataset_path ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:symbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:comment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:comment ] ;
    skos:exactMatch tvbo:Parameter ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:equation a owl:ObjectProperty ;
    rdfs:label "equation" ;
    rdfs:range tvbo:Equation ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:UnitEnum a owl:Class ;
    rdfs:label "UnitEnum" ;
    owl:unionOf ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV qudt:PER-MilliV qudt:MilliV-PER-MilliSEC qudt:MilliV-PER-SEC qudt:A qudt:NanoA qudt:PicoA <http://www.thevirtualbrain.org/tvb-o/UnitEnum#uA_per_cm2> qudt:PicoFARAD qudt:NanoFARAD <http://www.thevirtualbrain.org/tvb-o/UnitEnum#uF_per_cm2> qudt:NanoS qudt:MicroS qudt:PicoS <http://www.thevirtualbrain.org/tvb-o/UnitEnum#S_per_cm2> <http://www.thevirtualbrain.org/tvb-o/UnitEnum#mS_per_cm2> <http://www.thevirtualbrain.org/tvb-o/UnitEnum#S_per_m2> <http://www.thevirtualbrain.org/tvb-o/UnitEnum#nS_per_mV> qudt:PER-NanoC qudt:PER-PicoC qudt:MOL-PER-M3 <http://www.thevirtualbrain.org/tvb-o/UnitEnum#mol_per_cm3> qudt:MilliMOL-PER-M3 <http://www.thevirtualbrain.org/tvb-o/UnitEnum#mol_per_m_per_A_per_s> qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:M-PER-SEC qudt:MilliM-PER-MilliSEC <http://www.thevirtualbrain.org/tvb-o/UnitEnum#Hz_per_nA> qudt:S-PER-M qudt:H-PER-M qudt:OHM <http://www.thevirtualbrain.org/tvb-o/UnitEnum#Mohm> <http://www.thevirtualbrain.org/tvb-o/UnitEnum#kohm_cm> qudt:DEG_C <http://www.thevirtualbrain.org/tvb-o/UnitEnum#rad_per_ms> qudt:UNITLESS qudt:PERCENT <http://www.thevirtualbrain.org/tvb-o/UnitEnum#arbitrary_unit> qudt:KiloGM <http://www.thevirtualbrain.org/tvb-o/UnitEnum#kg_per_s> qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 <http://www.thevirtualbrain.org/tvb-o/UnitEnum#per_unit> ) ;
    skos:definition "Physical units of measurement for model parameters, state variables, and integration settings. Uses conventional abbreviations as values, mapped to the QUDT ontology (http://qudt.org/vocab/unit/) with UO cross-references where available." ;
    skos:inScheme <https://w3id.org/tvbo/units> ;
    linkml:permissible_values qudt:A,
        qudt:CentiM,
        qudt:DEG_C,
        qudt:H-PER-M,
        qudt:HZ,
        qudt:KiloGM,
        qudt:KiloHZ,
        qudt:M,
        qudt:M-PER-SEC,
        qudt:M-PER-SEC2,
        qudt:MOL-PER-M3,
        qudt:MicroM3,
        qudt:MicroS,
        qudt:MicroSEC,
        qudt:MilliM,
        qudt:MilliM-PER-MilliSEC,
        qudt:MilliMOL-PER-M3,
        qudt:MilliSEC,
        qudt:MilliV,
        qudt:MilliV-PER-MilliSEC,
        qudt:MilliV-PER-SEC,
        qudt:N-PER-M,
        qudt:NanoA,
        qudt:NanoFARAD,
        qudt:NanoS,
        qudt:OHM,
        qudt:PER-MilliSEC,
        qudt:PER-MilliV,
        qudt:PER-NanoC,
        qudt:PER-PicoC,
        qudt:PER-SEC,
        qudt:PERCENT,
        qudt:PicoA,
        qudt:PicoFARAD,
        qudt:PicoS,
        qudt:RAD,
        qudt:RAD-PER-SEC,
        qudt:S-PER-M,
        qudt:SEC,
        qudt:SEC2,
        qudt:UNITLESS,
        qudt:V,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#Hz_per_nA>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#Mohm>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#S_per_cm2>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#S_per_m2>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#arbitrary_unit>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#kg_per_s>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#kohm_cm>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#mS_per_cm2>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#mol_per_cm3>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#mol_per_m_per_A_per_s>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#nS_per_mV>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#per_unit>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#rad_per_ms>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#uA_per_cm2>,
        <http://www.thevirtualbrain.org/tvb-o/UnitEnum#uF_per_cm2> .

tvbo:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "Globally unique identifier for the entity.",
        "Optional step label; used in pipelines to key step outputs." ;
    skos:inScheme <https://w3id.org/tvbo>,
        <https://w3id.org/tvbo/common> .

tvbo:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/tvbo> .


