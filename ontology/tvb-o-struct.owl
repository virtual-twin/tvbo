tvbo:SexEnum a owl:Class ;
    rdfs:label "SexEnum" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/SexEnum#male> <https://w3id.org/tvbo/SexEnum#female> <https://w3id.org/tvbo/SexEnum#other> ) ;
    skos:inScheme tvbo:study ;
    linkml:permissible_values <https://w3id.org/tvbo/SexEnum#female>,
        <https://w3id.org/tvbo/SexEnum#male>,
        <https://w3id.org/tvbo/SexEnum#other> .

tvbo:SpecimenEnum a owl:Class ;
    rdfs:label "SpecimenEnum" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/SpecimenEnum#Subject> <https://w3id.org/tvbo/SpecimenEnum#SubjectGroup> <https://w3id.org/tvbo/SpecimenEnum#TissueSample> <https://w3id.org/tvbo/SpecimenEnum#TissueSampleCollection> ) ;
    skos:definition "A set of permissible types for specimens used in brain atlas creation." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> ;
    linkml:permissible_values <https://w3id.org/tvbo/SpecimenEnum#Subject>,
        <https://w3id.org/tvbo/SpecimenEnum#SubjectGroup>,
        <https://w3id.org/tvbo/SpecimenEnum#TissueSample>,
        <https://w3id.org/tvbo/SpecimenEnum#TissueSampleCollection> .

tvbo:SweepDirection a owl:Class ;
    rdfs:label "SweepDirection" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/SweepDirection#up> <https://w3id.org/tvbo/SweepDirection#down> <https://w3id.org/tvbo/SweepDirection#bidirectional> ) ;
    skos:definition "Order in which a branch-following sweep (SweepSeeding.from_previous) traverses its axis. Ignored for independent seeding, where order is irrelevant." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/SweepDirection#bidirectional>,
        <https://w3id.org/tvbo/SweepDirection#down>,
        <https://w3id.org/tvbo/SweepDirection#up> .

tvbo:WorkflowConfig a owl:Class ;
    rdfs:label "WorkflowConfig" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:retries ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:slurm ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:container_binds ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:nextflow ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:rng ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:distribute ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:emit_provenance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:rng ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:out_dir ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:requirements ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty tvbo:chunk ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:container ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:WorkflowEngineConfig ;
            owl:onProperty tvbo:slurm ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:slurm ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:emit_provenance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:container_args ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:chunk ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:rng ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:container_args ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:out_dir ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:retries ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:distribute ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:WorkflowEngineConfig ;
            owl:onProperty tvbo:snakemake ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:out_dir ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:WorkflowEngineConfig ;
            owl:onProperty tvbo:nextflow ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:snakemake ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:container_args ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:container_binds ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tvbo/software/SoftwareRequirement> ;
            owl:onProperty tvbo:requirements ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:snakemake ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:nextflow ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:container ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty tvbo:retries ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:DistributionConfig ;
            owl:onProperty tvbo:distribute ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:container ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:chunk ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty tvbo:emit_provenance ] ;
    skos:definition "Declarative orchestration for rendering a parameter sweep into a distributed, reproducible workflow (Slurm array, Snakemake, Nextflow). Backend- and engine-independent: it names *what* to distribute, *where* results go, and the per-engine resources, while each engine emitter renders the concrete artefact. Declared on a study as ``workflow`` and refined per experiment via ``workflow_overrides``; unset fields fall back to the emitter's defaults so an override sets only what it names." ;
    skos:exactMatch tvbo:WorkflowConfig ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:WorkflowDistributeBy a owl:Class ;
    rdfs:label "WorkflowDistributeBy" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/WorkflowDistributeBy#auto> <https://w3id.org/tvbo/WorkflowDistributeBy#vectorize> <https://w3id.org/tvbo/WorkflowDistributeBy#workflow> ) ;
    skos:definition "Default tier a sweep axis is placed on when it is not named explicitly in a DistributionConfig. Vectorized axes are packed into one batched backend call; workflow axes are fanned out into independent scheduler tasks." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/WorkflowDistributeBy#auto>,
        <https://w3id.org/tvbo/WorkflowDistributeBy#vectorize>,
        <https://w3id.org/tvbo/WorkflowDistributeBy#workflow> .

tvbo:WorkflowEngineConfig a owl:Class ;
    rdfs:label "WorkflowEngineConfig" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
