    skos:inScheme <https://w3id.org/tvbo> .

tvbo:quantity_kind a owl:DatatypeProperty ;
    rdfs:label "quantity_kind" ;
    skos:definition "Scalar, vector, or tensor." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:random_seed a owl:DatatypeProperty ;
