        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:time_scale ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:UnitEnum ;
            owl:onProperty tvbo:time_scale ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:DerivedVariable ;
            owl:onProperty tvbo:update_expression ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:delayed ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:DerivedVariable ;
            owl:onProperty tvbo:intermediate_expressions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:duration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:step_size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:differentiation ],
        tvbo:Solver ;
    skos:definition "Fixed-step or adaptive ODE integrator with TVB-specific extensions (noise, transient time, etc.). Inherits abs_tol, rel_tol from Solver. Overrides method default to 'euler'." ;
    skos:exactMatch tvbo:Integrator ;
    skos:inScheme <https://w3id.org/tvbo> .

