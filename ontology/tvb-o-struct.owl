        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:date_created ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:references ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:derived_from ],
