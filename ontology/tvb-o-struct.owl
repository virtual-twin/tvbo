tvbo:SimulationScale a owl:Class ;
    rdfs:label "SimulationScale" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( wd:Q898786 wd:Q43054 wd:Q484761 wd:Q7003015 wd:Q1073340 wd:Q239456 ) ;
