tvbo:CouplingStageEvaluation a owl:Class ;
    rdfs:label "CouplingStageEvaluation" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/CouplingStageEvaluation#per_stage> <https://w3id.org/tvbo/CouplingStageEvaluation#per_step> ) ;
    skos:definition "How the network coupling term is evaluated within one step of a multi-stage integrator (Heun, RK4, ...). A backend-neutral numerical contract: whether the coupling is part of the vector field, re-evaluated at each solver stage, or computed once per step and held constant across the stages. Matters because the two choices integrate a different effective system — for stiff / chaotic / multistable dynamics they can converge to different trajectories or attractors." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/CouplingStageEvaluation#per_stage>,
        <https://w3id.org/tvbo/CouplingStageEvaluation#per_step> .

tvbo:DataRef a owl:Class ;
    rdfs:label "DataRef" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
