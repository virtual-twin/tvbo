    skos:definition "Invocation of a function in a pipeline. Can reference a defined Function by name, OR inline a callable directly for external library functions, OR inline an equation, OR use class_call for class instantiation. Mirrors Function attributes so pipeline steps can be self-contained. The `name` is an optional step label (used in pipelines for keyed access to step outputs); it is NOT a global identifier (singleton uses like `loss`, `observable` may omit it)." ;
    skos:exactMatch tvbo:FunctionCall ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:InitialStateMethod a owl:Class ;
    rdfs:label "InitialStateMethod" ;
    owl:unionOf ( <http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#time_integration> <http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#newton> <http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#given> <http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#from_branch> ) ;
    skos:definition "Strategy for obtaining the starting equilibrium or periodic orbit." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#from_branch>,
        <http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#given>,
        <http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#newton>,
        <http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#time_integration> .

tvbo:NumericalDiscretizationMethod a owl:Class ;
    rdfs:label "NumericalDiscretizationMethod" ;
    owl:unionOf ( <http://www.thevirtualbrain.org/tvb-o/NumericalDiscretizationMethod#collocation> <http://www.thevirtualbrain.org/tvb-o/NumericalDiscretizationMethod#trapezoid> <http://www.thevirtualbrain.org/tvb-o/NumericalDiscretizationMethod#shooting> <http://www.thevirtualbrain.org/tvb-o/NumericalDiscretizationMethod#poincare> ) ;
    skos:definition "Numerical discretization method for boundary value problems (periodic orbits, connecting orbits, quasi-periodic tori)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <http://www.thevirtualbrain.org/tvb-o/NumericalDiscretizationMethod#collocation>,
        <http://www.thevirtualbrain.org/tvb-o/NumericalDiscretizationMethod#poincare>,
        <http://www.thevirtualbrain.org/tvb-o/NumericalDiscretizationMethod#shooting>,
        <http://www.thevirtualbrain.org/tvb-o/NumericalDiscretizationMethod#trapezoid> .

tvbo:OperatorType a owl:Class ;
    rdfs:label "OperatorType" ;
    owl:unionOf ( <http://www.thevirtualbrain.org/tvb-o/OperatorType#gradient> <http://www.thevirtualbrain.org/tvb-o/OperatorType#divergence> <http://www.thevirtualbrain.org/tvb-o/OperatorType#laplacian> <http://www.thevirtualbrain.org/tvb-o/OperatorType#curl> ) ;
