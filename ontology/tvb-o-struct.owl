tvbo:ProcedureStepType a owl:Class ;
    rdfs:label "ProcedureStepType" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/ProcedureStepType#equation> <https://w3id.org/tvbo/ProcedureStepType#pairwise_distance> <https://w3id.org/tvbo/ProcedureStepType#distribution_pdf> <https://w3id.org/tvbo/ProcedureStepType#sample> <https://w3id.org/tvbo/ProcedureStepType#stochastic_mask> <https://w3id.org/tvbo/ProcedureStepType#normalize> <https://w3id.org/tvbo/ProcedureStepType#minmax_rescale> ) ;
    skos:definition "The operation a ProcedureStep performs. `equation` is the general case (author-written algebra over previously-named intermediates); the others are named graph-construction operations whose options are fields rather than call syntax, so each lowers to a backend-native primitive without an expression string having to survive a parser." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/ProcedureStepType#distribution_pdf>,
