            owl:onProperty tvbo:diagonal ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:seed_offset ] ;
    skos:definition """A single named step (or output) in a Procedure: one typed operation producing one named intermediate.
`type` selects the operation and therefore which of the fields below apply; it defaults to `equation`, the general case, so a Procedure written purely as equations needs no type annotations. The remaining fields carry each operation's options as *metadata* rather than as call syntax, which is what lets a step lower directly to a backend-native primitive: expression parsing cannot represent keyword arguments at all, so any option written as one would be unresolvable.""" ;
    skos:exactMatch tvbo:ProcedureStep ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:SamplingAxis a owl:Class ;
    rdfs:label "SamplingAxis" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/SamplingAxis#space> <https://w3id.org/tvbo/SamplingAxis#time> ) ;
    skos:definition "Dimension along which a distribution is sampled." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/SamplingAxis#space>,
        <https://w3id.org/tvbo/SamplingAxis#time> .

tvbo:SimulationExperiment a owl:Class ;
    rdfs:label "SimulationExperiment" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:inferences ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:software ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tvbo/software/SoftwareEnvironment> ;
            owl:onProperty tvbo:environment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:workflow ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:algorithms ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:references ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:explorations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:optimizations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:dynamics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:connectivity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:execution ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tvbo/study/Dataset> ;
            owl:onProperty tvbo:dataset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:dynamics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:stimulation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Integrator ;
            owl:onProperty tvbo:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tvbo/software/SoftwareRequirement> ;
            owl:onProperty tvbo:software ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Event ;
            owl:onProperty tvbo:events ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:coupling ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Exploration ;
            owl:onProperty tvbo:explorations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:dataset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:references ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Function ;
            owl:onProperty tvbo:functions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:connectivity ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:ExecutionConfig ;
            owl:onProperty tvbo:execution ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:InitialState ;
            owl:onProperty tvbo:initial_state ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:network ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:workflow ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:environment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:observations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:coupling ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:PDE ;
            owl:onProperty tvbo:field_dynamics ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Continuation ;
            owl:onProperty tvbo:continuations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:stimulation ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Inference ;
            owl:onProperty tvbo:inferences ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:execution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:model ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Network ;
            owl:onProperty tvbo:connectivity ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Observation ;
            owl:onProperty tvbo:observations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:environment ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:WorkflowConfig ;
            owl:onProperty tvbo:workflow ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:software ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Dynamics ;
            owl:onProperty tvbo:dynamics ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:dataset ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Network ;
            owl:onProperty tvbo:network ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:network ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:field_dynamics ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Stimulus ;
            owl:onProperty tvbo:stimulation ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Algorithm ;
            owl:onProperty tvbo:algorithms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:continuations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:additional_equations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Dynamics ;
            owl:onProperty tvbo:model ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Coupling ;
            owl:onProperty tvbo:coupling ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:initial_state ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Equation ;
            owl:onProperty tvbo:additional_equations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:events ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:initial_state ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Optimization ;
            owl:onProperty tvbo:optimizations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:field_dynamics ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ] ;
    skos:exactMatch tvbo:Simulation ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:Stimulus a owl:Class ;
    rdfs:label "Stimulus" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:parameters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:duration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:regions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Equation ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Noise ;
            owl:onProperty tvbo:noise ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:duration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:parameters ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:weighting ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:noise ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:noise ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:duration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:weighting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:regions ] ;
    skos:exactMatch tvbo:Stimulus ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:SweepSeeding a owl:Class ;
    rdfs:label "SweepSeeding" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/SweepSeeding#independent> <https://w3id.org/tvbo/SweepSeeding#from_previous> ) ;
    skos:definition "How each point of a parameter sweep (Exploration) obtains its initial state. Determines whether the sweep points are independent (and therefore parallelisable) or whether the trajectory follows a solution branch as the swept parameter is changed quasi-statically. The latter is forward-time-integration branch following — distinct from numerical continuation of equilibria (the Continuation class), which tracks branches with a Newton corrector rather than by simulation." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/SweepSeeding#from_previous>,
        <https://w3id.org/tvbo/SweepSeeding#independent> .

tvbo:SystemType a owl:Class ;
    rdfs:label "SystemType" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/SystemType#continuous> <https://w3id.org/tvbo/SystemType#discrete> ) ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/SystemType#continuous>,
        <https://w3id.org/tvbo/SystemType#discrete> .

tvbo:accelerator a owl:DatatypeProperty ;
    rdfs:label "accelerator (slot)" ;
    skos:definition "Hardware accelerator: 'cpu', 'gpu', 'tpu'" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "accelerator" .

tvbo:account a owl:DatatypeProperty ;
    rdfs:label "account (slot)" ;
    skos:definition "Accounting allocation to charge the tasks against (Slurm)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "account" .

tvbo:additive a owl:DatatypeProperty ;
    rdfs:label "additive (slot)" ;
    skos:definition "Indicates whether the noise is additive" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "additive" .

tvbo:affect a owl:ObjectProperty ;
    rdfs:label "affect (slot)" ;
    skos:definition "Affect function: what happens when the event triggers. Can modify state variables and/or parameters. For stimulus type, this is the stimulus equation." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "affect" .

tvbo:affect_negative a owl:ObjectProperty ;
    rdfs:label "affect_negative (slot)" ;
    skos:definition "Affect on downcrossing (continuous events only). If not specified, uses the same affect for both crossings." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "affect_negative" .

tvbo:allow_self_connections a owl:DatatypeProperty ;
    rdfs:label "allow_self_connections (slot)" ;
    skos:definition "For a self-projection (source and target are the same population) expanded under a connectivity rule, whether to include the diagonal i->i self connections. Ignored when the source and target populations differ." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "allow_self_connections" .

tvbo:analysis a owl:ObjectProperty ;
    rdfs:label "analysis (slot)" ;
    skos:definition "Marks this observation as an analysis observable that operates on the solve/loss rather than a result-data pipeline (autodiff gradient, finite-difference gradient, or Lyapunov spectrum)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "analysis" .

tvbo:apply_every a owl:DatatypeProperty ;
    rdfs:label "apply_every (slot)" ;
    skos:definition "Apply update every N iterations" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "apply_every" .

tvbo:array_chunk a owl:DatatypeProperty ;
    rdfs:label "array_chunk (slot)" ;
    skos:definition "Overrides ``distribute.chunk`` for this engine only: the number of array-task shards to split the vectorized sweep across." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "array_chunk" .

tvbo:auto_format a owl:DatatypeProperty ;
    rdfs:label "auto_format (slot)" ;
    skos:definition "Apply bsplot's format_fig (tick/label normalisation + panel numbers). Set false to keep full manual control, e.g. when a study's own .mplstyle already defines the look." ;
    skos:inScheme tvbo:figure ;
    skos:notation "auto_format" .

tvbo:autonomous a owl:DatatypeProperty ;
    rdfs:label "autonomous (slot)" ;
    skos:definition "Whether the system is autonomous (equations do not depend explicitly on time t). Non-autonomous systems have explicit time dependence, e.g. f*cos(omega*t)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "autonomous" .

tvbo:average a owl:DatatypeProperty ;
    rdfs:label "average (slot)" ;
    skos:definition "Averaging mode across trials. 'trials' = average over n_trials independent runs (evoked potential paradigm). None = return all trials." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "average" .

tvbo:backend a owl:DatatypeProperty ;
    rdfs:label "backend (slot)" ;
    skos:definition "Execution backend this experiment runs on when no backend is passed explicitly (e.g. 'tvboptim', 'tvb', 'jax', 'julia', 'brian2'). Declares the engine the experiment requires — a spiking point-neuron network sets 'brian2', a mean-field model leaves it unset. run(format=...) and ``tvbo run --backend`` override it; when unset the default backend (tvboptim) is used." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "backend" .

tvbo:batch_size a owl:DatatypeProperty ;
    rdfs:label "batch_size (slot)" ;
    skos:definition "Batch size for vectorized operations (None = auto)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "batch_size" .

tvbo:bc_type a owl:ObjectProperty ;
    rdfs:label "bc_type (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "bc_type" .

tvbo:bids a owl:ObjectProperty ;
    rdfs:label "bids (slot)" ;
    skos:definition "BIDS filename entities for this dataset" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "bids" .

tvbo:bids_dir a owl:DatatypeProperty ;
    rdfs:label "bids_dir (slot)" ;
    skos:definition "Path to BEP017-compliant BIDS directory for loading connectivity matrices" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "bids_dir" .

tvbo:bounds a owl:ObjectProperty ;
    rdfs:label "bounds (slot)" ;
    skos:definition "Constraints on parameter values after update" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "bounds" .

tvbo:by a owl:ObjectProperty ;
    rdfs:label "by (slot)" ;
    skos:definition "Default tier for axes not named in ``vectorize`` or ``workflow``. Unset means ``auto``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "by" .

tvbo:category a owl:DatatypeProperty ;
    rdfs:label "category (slot)" ;
    skos:definition "Coarse classification of the phenotype bundle, used for filtering in larger study libraries. Canonical values: ``cognitive`` (intelligence / memory / attention scores), ``clinical`` (UPDRS, MMSE, …), ``behavioral`` (raw task outputs), ``demographic``, ``physiological``, ``derived`` (composite scores like g-factor or brain-age). Free string — extend as needed." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "category" .

tvbo:checkpoint_interval a owl:DatatypeProperty ;
    rdfs:label "checkpoint_interval (slot)" ;
    skos:definition "Gradient-checkpointing interval in milliseconds (backward-pass memory/time trade-off). Omit for no checkpointing." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "checkpoint_interval" .

tvbo:citekey a owl:DatatypeProperty ;
    rdfs:label "citekey (slot)" ;
    skos:definition "BibTeX citation key; the join key into references.bib for full bibliographic detail. A study is identified by its key/citekey and described by its title — no ``name`` needed." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "citekey" .

tvbo:class_call a owl:ObjectProperty ;
    rdfs:label "class_call (slot)" ;
    skos:definition "Class instantiation and call (alternative to callable/function). Use for external library classes that need __init__ then __call__. Example: Bold monitor from tvboptim." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "class_call" .

tvbo:class_reference a owl:ObjectProperty ;
    rdfs:label "class_reference (slot)" ;
    skos:definition "Direct class reference (alternative to pipeline). Use for external library classes like tvboptim.Bold, custom monitors, or any callable class. The class is instantiated with constructor_args and called with call_args. Example: {name: Bold, module: tvboptim.observations.tvb_monitors.bold, constructor_args: [{name: period, value: 1000.0}]}" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "class_reference" .

tvbo:code_source a owl:ObjectProperty ;
    rdfs:label "code_source (slot)" ;
    skos:definition "Where this study's callable code lives — the builders and transform/observation callables it references by bare ``module:`` name. Decouples the specification from its code: a local directory (relative to the recipe YAML or absolute) or a git repository fetched and cached at load time. When absent, the conventional ``<recipe-dir>/code/`` is used." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "code_source" .

tvbo:coefficient a owl:ObjectProperty ;
    rdfs:label "coefficient (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "coefficient" .

tvbo:colormap a owl:DatatypeProperty ;
    rdfs:label "colormap (slot)" ;
    skos:definition "Named colormap (routed through the cmap resolver)." ;
    skos:inScheme tvbo:figure ;
    skos:notation "colormap" .

tvbo:comparison a owl:ObjectProperty ;
    rdfs:label "comparison (slot)" ;
    skos:definition "Comparison a `stochastic_mask` applies between `of` and the draw." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "comparison" .

tvbo:compile a owl:DatatypeProperty ;
    rdfs:label "compile (slot)" ;
    skos:definition "Code-generation hint (opt-in, backend-independent): request that the generated dynamics be compiled to machine code rather than interpreted, where the target backend supports it. Purely a performance hint with no effect on results; a backend that is inherently compiled (or cannot compile) honours it as a no-op. Off by default. Independent of, and composable with, ``cse``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "compile" .

tvbo:concept_iri a owl:DatatypeProperty ;
    rdfs:label "concept_iri (slot)" ;
    skos:definition "Cognitive Atlas IRI of the cognitive construct measured (e.g. ``cogat:trm_521ef89ce5e84`` for fluid intelligence)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "concept_iri" .

tvbo:conditional a owl:DatatypeProperty ;
    rdfs:label "conditional (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "conditional" .

tvbo:connectivity_ref a owl:DatatypeProperty ;
    rdfs:label "connectivity_ref (slot)" ;
    skos:definition "Reference to connectivity data (_conndata-network_connectivity.tsv)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "connectivity_ref" .

tvbo:container a owl:DatatypeProperty ;
    rdfs:label "container (slot)" ;
    skos:definition "Container image wrapping each task; tasks run as ``<runtime> exec <image> …``. A concrete image passes through as given — either a registry reference the engine resolves and materialises itself (``docker://…:tag``) or a path to an image file already built on the target, which pins the exact image and needs no pull. A reference that leaves the version open is resolved to the tvbo image matching the running CLI: the symbolic value ``tvbo``, or a tvbo registry reference with no ``:tag``. Left unset while ``requirements`` are declared, the base still defaults to that tvbo image (the deps layer onto it); unset with no requirements, tasks run bare." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "container" .

tvbo:container_args a owl:DatatypeProperty ;
    rdfs:label "container_args (slot)" ;
    skos:definition "Additional arguments passed verbatim to the container runtime when it executes a task. The extension point for runtime flags the typed fields do not cover, mirroring ``WorkflowEngineConfig.options`` for scheduler directives." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "container_args" .

tvbo:continuation a owl:ObjectProperty ;
    rdfs:label "continuation (slot)" ;
    skos:definition "Override solver settings for this branch. Uses the same Continuation type — only explicitly set attributes override the parent's values." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "continuation" .

tvbo:cores a owl:DatatypeProperty ;
    rdfs:label "cores (slot)" ;
    skos:definition "Total cores for local engines (Snakemake --cores)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "cores" .

tvbo:correlated a owl:DatatypeProperty ;
    rdfs:label "correlated (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "correlated" .

tvbo:correlation a owl:ObjectProperty ;
    rdfs:label "correlation (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "correlation" .

tvbo:coupling_evaluation a owl:ObjectProperty ;
    rdfs:label "coupling_evaluation (slot)" ;
    skos:definition "Backend-neutral numerical treatment of the network coupling term across the stages of a multi-stage integrator (Heun, RK4, ...): re-evaluated at every stage (per_stage — standard ODE accuracy) or computed once per step and held constant across stages (per_step — a TVB-style efficiency shortcut). Single- stage methods (Euler) and always-recompute solvers (diffrax) ignore it. per_stage is required to match reference integrators for stiff / chaotic / multistable systems, where the frozen- coupling error can select a different trajectory or attractor. See CouplingStageEvaluation." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "coupling_evaluation" .

tvbo:coupling_function a owl:ObjectProperty ;
    rdfs:label "coupling_function (slot)" ;
    skos:definition "Mathematical function defining the coupling" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "coupling_function" .

tvbo:coupling_variable a owl:DatatypeProperty ;
    rdfs:label "coupling_variable (slot)" ;
    skos:definition "Whether this state variable is transmitted to connected nodes through the coupling function. In TVB terms, this determines the cvar indices (state variables extracted from history and fed into the coupling function). The coupling function may override this via its incoming_states attribute." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "coupling_variable" .

tvbo:cpus_per_task a owl:DatatypeProperty ;
    rdfs:label "cpus_per_task (slot)" ;
    skos:definition "CPU cores requested per task (Slurm --cpus-per-task)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "cpus_per_task" .

tvbo:cse a owl:DatatypeProperty ;
    rdfs:label "cse (slot)" ;
    skos:definition "Code-generation hint (opt-in, backend-independent): eliminate common subexpressions. When true, the generator evaluates each repeated subexpression — including repeated calls to model-defined functions — once and reuses the result instead of re-emitting it at every occurrence. Purely a performance hint: results are numerically identical. A backend whose compiler already performs this elimination may honour it as a no-op. Off by default (expressions are emitted in flat form)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "cse" .

tvbo:curvature a owl:DatatypeProperty ;
    rdfs:label "curvature (slot)" ;
    skos:definition "Optional path to per-vertex curvature (N,) float. Default convention: ``mesh/curvature``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "curvature" .

tvbo:dataset a owl:ObjectProperty ;
    rdfs:label "dataset (slot)" ;
    skos:definition "Multi-subject dataset for workflow rendering. When set, render_workflow() uses dataset.subjects/sessions to generate per-subject parallel jobs." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "dataset" .

tvbo:dataset_id a owl:DatatypeProperty ;
    rdfs:label "dataset_id (slot)" ;
    skos:definition "Unique identifier for this phenotype bundle." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "dataset_id" .

tvbo:datatype a owl:DatatypeProperty ;
    rdfs:label "datatype (slot)" ;
    skos:definition "Declared value type of this parameter, given as a schema range name — a primitive (``integer``, ``float``, ``string``, ``uriorcurie``) or a class (e.g. ``Distribution``). Documents the expected type when the parameter is a *declaration* carrying no concrete ``value`` (e.g. a GraphGenerator's typed argument interface). Distinct from ``domain`` (numeric bounds) and ``unit``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "datatype" .

tvbo:date_created a owl:DatatypeProperty ;
    rdfs:label "date_created (slot)" ;
    skos:definition "ISO 8601 (prov:generatedAtTime)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "date_created" .

<https://w3id.org/tvbo/dbs/ClinicalScore> a owl:Class ;
    rdfs:label "ClinicalScore (dbs)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/acronym> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tvbo/dbs/ClinicalScore> ;
            owl:onProperty <https://w3id.org/tvbo/dbs/parent_score> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/dbs/acronym> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/reference> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/dbs/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/dbs/name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/scale> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/domain> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tvbo/dbs/ClinicalScale> ;
            owl:onProperty <https://w3id.org/tvbo/dbs/scale> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/scale> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/dbs/reference> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/acronym> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/domain> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/parent_score> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/reference> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/dbs/domain> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/parent_score> ] ;
    skos:definition "Metadata about a clinical score or scale." ;
    skos:inScheme tvbo:dbs ;
    skos:notation "ClinicalScore" .

<https://w3id.org/tvbo/dbs/absolute_value> a owl:DatatypeProperty ;
    rdfs:label "absolute_value (dbs)" ;
