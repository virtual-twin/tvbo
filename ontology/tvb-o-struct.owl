tvbo:DevelopmentStatus a owl:Class ;
    rdfs:label "DevelopmentStatus" ;
    owl:unionOf ( <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#active> <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#inactive> <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#concept> <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#wip> <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#suspended> <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#unsupported> <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#moved> ) ;
    skos:definition "Development status of the software. Based on repostatus.org categories." ;
    skos:inScheme <https://w3id.org/tvbo/software> ;
    linkml:permissible_values <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#active>,
        <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#concept>,
        <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#inactive>,
        <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#moved>,
        <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#suspended>,
        <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#unsupported>,
        <http://www.thevirtualbrain.org/tvb-o/DevelopmentStatus#wip> .

tvbo:ModelType a owl:Class ;
    rdfs:label "ModelType" ;
    owl:unionOf ( <http://www.thevirtualbrain.org/tvb-o/ModelType#mean_field> <http://www.thevirtualbrain.org/tvb-o/ModelType#neural_mass> <http://www.thevirtualbrain.org/tvb-o/ModelType#phase_oscillator> <http://www.thevirtualbrain.org/tvb-o/ModelType#phenomenological> <http://www.thevirtualbrain.org/tvb-o/ModelType#spiking> <http://www.thevirtualbrain.org/tvb-o/ModelType#generic> <http://www.thevirtualbrain.org/tvb-o/ModelType#field> ) ;
    skos:definition "Coarse classification of a Dynamics model by its mathematical/biological origin. Used for filtering and display in list_db()." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <http://www.thevirtualbrain.org/tvb-o/ModelType#field>,
        <http://www.thevirtualbrain.org/tvb-o/ModelType#generic>,
        <http://www.thevirtualbrain.org/tvb-o/ModelType#mean_field>,
        <http://www.thevirtualbrain.org/tvb-o/ModelType#neural_mass>,
        <http://www.thevirtualbrain.org/tvb-o/ModelType#phase_oscillator>,
        <http://www.thevirtualbrain.org/tvb-o/ModelType#phenomenological>,
        <http://www.thevirtualbrain.org/tvb-o/ModelType#spiking> .

tvbo:ScalarValue a owl:Class ;
    rdfs:label "ScalarValue" ;
    skos:definition "A scalar value: float, integer, string, or boolean. Used for slots that accept literals of any primitive type, such as argument values which may be numbers, strings, references, or booleans." ;
    skos:exactMatch linkml:Any ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:StandardGraphType a owl:Class ;
    rdfs:label "StandardGraphType" ;
    owl:unionOf ( <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#BarabasiAlbert> <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#WattsStrogatz> <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#ErdosRenyi> <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#Complete> <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#Cycle> <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#Star> <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#RandomRegular> <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#Grid> ) ;
    skos:definition """Well-known graph generator families with automatic backend mapping. The type field on GraphGenerator is a free string; this enum lists common types that get automatic code generation for Julia (Graphs.jl) and Python (NetworkX).
""" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#BarabasiAlbert>,
        <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#Complete>,
        <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#Cycle>,
        <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#ErdosRenyi>,
        <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#Grid>,
        <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#RandomRegular>,
        <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#Star>,
        <http://www.thevirtualbrain.org/tvb-o/StandardGraphType#WattsStrogatz> .

tvbo:StateVariable a owl:Class ;
    rdfs:label "StateVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:stimulation_variable ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
