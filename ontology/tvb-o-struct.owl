            owl:onProperty tvbo:definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:used ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:used ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty tvbo:grounding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:shape ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty tvbo:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty tvbo:free ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:symbol ] ;
    skos:exactMatch tvbo:Parameter ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:parameters a owl:ObjectProperty ;
    rdfs:label "parameters (slot)" ;
    rdfs:range tvbo:Parameter ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "parameters" .

tvbo:equation a owl:ObjectProperty ;
    rdfs:label "equation (slot)" ;
    rdfs:range tvbo:Equation ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "equation" .

tvbo:unit a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "unit (slot)" ;
    rdfs:range tvbo:UnitEnum ;
    skos:definition "Physical unit of measurement. Values are drawn from the QUDT ontology (http://qudt.org/vocab/unit/) with UO cross-references where available." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "unit" .

tvbo:software a owl:ObjectProperty .

tvbo:UnitEnum a owl:Class ;
    rdfs:label "UnitEnum" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( qudt:SEC qudt:MilliSEC qudt:MicroSEC qudt:PER-SEC qudt:PER-MilliSEC qudt:HZ qudt:KiloHZ qudt:V qudt:MilliV qudt:PER-MilliV qudt:MilliV-PER-MilliSEC qudt:MilliV-PER-SEC qudt:A qudt:NanoA qudt:PicoA <https://w3id.org/tvbo/UnitEnum#uA_per_cm2> qudt:PicoFARAD qudt:NanoFARAD <https://w3id.org/tvbo/UnitEnum#uF_per_cm2> qudt:NanoS qudt:MicroS qudt:PicoS <https://w3id.org/tvbo/UnitEnum#S_per_cm2> <https://w3id.org/tvbo/UnitEnum#mS_per_cm2> <https://w3id.org/tvbo/UnitEnum#S_per_m2> <https://w3id.org/tvbo/UnitEnum#nS_per_mV> qudt:PER-NanoC qudt:PER-PicoC qudt:MOL-PER-M3 <https://w3id.org/tvbo/UnitEnum#mol_per_cm3> qudt:MilliMOL-PER-M3 <https://w3id.org/tvbo/UnitEnum#mol_per_m_per_A_per_s> qudt:MicroM3 qudt:M qudt:MilliM qudt:CentiM qudt:M-PER-SEC qudt:MilliM-PER-MilliSEC <https://w3id.org/tvbo/UnitEnum#Hz_per_nA> qudt:S-PER-M qudt:H-PER-M qudt:OHM <https://w3id.org/tvbo/UnitEnum#Mohm> <https://w3id.org/tvbo/UnitEnum#kohm_cm> qudt:DEG_C <https://w3id.org/tvbo/UnitEnum#rad_per_ms> qudt:UNITLESS qudt:PERCENT <https://w3id.org/tvbo/UnitEnum#arbitrary_unit> qudt:KiloGM <https://w3id.org/tvbo/UnitEnum#kg_per_s> qudt:KiloGM-M2 qudt:M-PER-SEC2 qudt:N-PER-M qudt:RAD qudt:RAD-PER-SEC qudt:SEC2 qudt:W qudt:MegaW <https://w3id.org/tvbo/UnitEnum#per_unit> ) ;
    skos:definition "Physical units of measurement for model parameters, state variables, and integration settings. Uses conventional abbreviations as values, mapped to the QUDT ontology (http://qudt.org/vocab/unit/) with UO cross-references where available." ;
    skos:inScheme tvbo:units ;
    linkml:permissible_values qudt:A,
        qudt:CentiM,
        qudt:DEG_C,
        qudt:H-PER-M,
        qudt:HZ,
        qudt:KiloGM,
        qudt:KiloGM-M2,
        qudt:KiloHZ,
        qudt:M,
        qudt:M-PER-SEC,
        qudt:M-PER-SEC2,
        qudt:MOL-PER-M3,
        qudt:MegaW,
        qudt:MicroM3,
        qudt:MicroS,
        qudt:MicroSEC,
        qudt:MilliM,
        qudt:MilliM-PER-MilliSEC,
        qudt:MilliMOL-PER-M3,
        qudt:MilliSEC,
        qudt:MilliV,
        qudt:MilliV-PER-MilliSEC,
        qudt:MilliV-PER-SEC,
        qudt:N-PER-M,
        qudt:NanoA,
        qudt:NanoFARAD,
        qudt:NanoS,
        qudt:OHM,
        qudt:PER-MilliSEC,
        qudt:PER-MilliV,
        qudt:PER-NanoC,
        qudt:PER-PicoC,
        qudt:PER-SEC,
        qudt:PERCENT,
        qudt:PicoA,
        qudt:PicoFARAD,
        qudt:PicoS,
        qudt:RAD,
        qudt:RAD-PER-SEC,
        qudt:S-PER-M,
        qudt:SEC,
        qudt:SEC2,
        qudt:UNITLESS,
        qudt:V,
        qudt:W,
        <https://w3id.org/tvbo/UnitEnum#Hz_per_nA>,
        <https://w3id.org/tvbo/UnitEnum#Mohm>,
        <https://w3id.org/tvbo/UnitEnum#S_per_cm2>,
        <https://w3id.org/tvbo/UnitEnum#S_per_m2>,
        <https://w3id.org/tvbo/UnitEnum#arbitrary_unit>,
        <https://w3id.org/tvbo/UnitEnum#kg_per_s>,
        <https://w3id.org/tvbo/UnitEnum#kohm_cm>,
        <https://w3id.org/tvbo/UnitEnum#mS_per_cm2>,
        <https://w3id.org/tvbo/UnitEnum#mol_per_cm3>,
        <https://w3id.org/tvbo/UnitEnum#mol_per_m_per_A_per_s>,
        <https://w3id.org/tvbo/UnitEnum#nS_per_mV>,
        <https://w3id.org/tvbo/UnitEnum#per_unit>,
        <https://w3id.org/tvbo/UnitEnum#rad_per_ms>,
        <https://w3id.org/tvbo/UnitEnum#uA_per_cm2>,
        <https://w3id.org/tvbo/UnitEnum#uF_per_cm2> .

tvbo:label a owl:DatatypeProperty ;
    rdfs:label "label (slot)" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "label" .

tvbo:name a owl:DatatypeProperty ;
    rdfs:label "name (slot)" ;
    rdfs:range xsd:string ;
    skos:definition "Globally unique identifier for the entity." ;
    skos:inScheme tvbo:common ;
    skos:notation "name" .

tvbo:description a owl:DatatypeProperty ;
    rdfs:label "description (slot)" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "description" .

tvbo:struct a owl:Ontology ;
    rdfs:label "tvb-datamodel" ;
    dcterms:contributor "The Virtual Brain Ontology contributors" ;
    dcterms:created "2024-01-01"^^xsd:date ;
    dcterms:description "Metadata schema for simulation studies using The Virtual Brain neuroinformatics platform or other dynamic network models of large-scale brain activity." ;
    dcterms:license <https://spdx.org/licenses/EUPL-1.2> ;
    dcterms:modified "2026-07-28"^^xsd:date ;
    dcterms:publisher <https://www.thevirtualbrain.org/> ;
    dcterms:title "The Virtual Brain Data Model" ;
    pav:version "0.4.0" ;
    rdfs:seeAlso tvbo:axioms,
        tvbo:data ;
    owl:versionIRI <https://w3id.org/tvbo/struct/0.4.0> ;
    owl:versionInfo "0.4.0" .

xsd:string rdfs:label "string" .

