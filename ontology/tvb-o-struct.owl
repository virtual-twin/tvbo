tvbo:DerivedObservation a owl:Class ;
    rdfs:label "DerivedObservation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Observation ;
            owl:onProperty tvbo:source_observations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:source_observations ],
        tvbo:Observation ;
    skos:definition "Observation derived from one or more other observations. Examples: - fc (from bold) - single source transformation - fc_corr (from fc and fc_target) - multi-source comparison Unlike regular Observations, these don't generate monitor classes but are computed from existing observation values." ;
    skos:exactMatch tvbo:DerivedObservation ;
    skos:inScheme <https://w3id.org/tvbo> .

