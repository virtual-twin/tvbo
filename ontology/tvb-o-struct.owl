        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:arguments ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Argument ;
            owl:onProperty tvbo:arguments ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:apply_on_dimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Aggregation ;
            owl:onProperty tvbo:aggregate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:aggregate ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:DimensionType ;
            owl:onProperty tvbo:apply_on_dimension ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:callable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:apply_on_dimension ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ] ;
    skos:definition "Invocation of a function in a pipeline. Can reference a defined Function by name, OR inline a callable directly for external library functions, OR inline an equation, OR use class_call for class instantiation. Mirrors Function attributes so pipeline steps can be self-contained. The `name` is an optional step label (used in pipelines for keyed access to step outputs); it is NOT a global identifier (singleton uses like `loss`, `observable` may omit it)." ;
    skos:exactMatch prov:Plan,
        tvbo:FunctionCall ;
    skos:inScheme <https://w3id.org/tvbo> .

