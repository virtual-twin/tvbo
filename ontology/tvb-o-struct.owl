            owl:minCardinality 0 ;
            owl:onProperty tvbo:heterogeneous ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Range ;
            owl:onProperty tvbo:domain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:heterogeneous ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:shape ],
        [ a owl:Restriction ;
