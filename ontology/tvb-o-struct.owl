    skos:definition "Work in progress; not yet feature-complete." .

tvbo:DifferentialOperator a owl:Class ;
    rdfs:label "DifferentialOperator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:operator_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:expression ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:coefficient ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:coefficient ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
