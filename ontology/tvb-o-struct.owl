tvbo:Argument a owl:Class ;
    rdfs:label "Argument" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:DataRef ;
            owl:onProperty tvbo:used ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( tvbo:ScalarValue tvbo:ScalarValue ) ] ;
            owl:onProperty tvbo:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:used ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:used ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ] ;
    skos:definition "A function argument with explicit value specification. A value is either ``value`` (a literal / array / local reference) or ``used`` (a labelled array sourced from another experiment or dataset); the two are mutually exclusive. Value can be: literal (number/string), reference to input (input.key), or cross-observation reference (observation_name.output_key)." ;
    skos:exactMatch tvbo:Argument ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:DevelopmentStatus a owl:Class ;
    rdfs:label "DevelopmentStatus" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/DevelopmentStatus#active> <https://w3id.org/tvbo/DevelopmentStatus#inactive> <https://w3id.org/tvbo/DevelopmentStatus#concept> <https://w3id.org/tvbo/DevelopmentStatus#wip> <https://w3id.org/tvbo/DevelopmentStatus#suspended> <https://w3id.org/tvbo/DevelopmentStatus#unsupported> <https://w3id.org/tvbo/DevelopmentStatus#moved> ) ;
