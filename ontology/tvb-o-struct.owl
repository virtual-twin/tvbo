    skos:definition "A discrete or continuous event that modifies the system during simulation. Generalizes Stimulus: can represent external inputs (stimulus type), threshold-triggered state changes (continuous/discrete type), or time-scheduled interventions (preset_time type). Attaches to components (nodes/edges) or to the experiment level." ;
    skos:exactMatch tvbo:Event ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:EventType a owl:Class ;
    rdfs:label "EventType" ;
    owl:unionOf ( <http://www.thevirtualbrain.org/tvb-o/EventType#continuous> <http://www.thevirtualbrain.org/tvb-o/EventType#discrete> <http://www.thevirtualbrain.org/tvb-o/EventType#preset_time> <http://www.thevirtualbrain.org/tvb-o/EventType#stimulus> ) ;
    skos:definition "Type of event triggering mechanism." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <http://www.thevirtualbrain.org/tvb-o/EventType#continuous>,
        <http://www.thevirtualbrain.org/tvb-o/EventType#discrete>,
        <http://www.thevirtualbrain.org/tvb-o/EventType#preset_time>,
        <http://www.thevirtualbrain.org/tvb-o/EventType#stimulus> .

