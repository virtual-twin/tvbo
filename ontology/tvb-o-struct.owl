tvbo:Inference a owl:Class ;
    rdfs:label "Inference" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:priors ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:num_samples ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:depends_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:num_warmup ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:num_warmup ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:seed ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:integration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:num_warmup ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Prior ;
            owl:onProperty tvbo:priors ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:likelihood ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:execution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:num_chains ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:seed ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:num_samples ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:execution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:num_samples ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:sampler ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:num_chains ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:ExecutionConfig ;
            owl:onProperty tvbo:execution ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Integrator ;
            owl:onProperty tvbo:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:sampler ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:likelihood ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:num_chains ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:seed ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:sampler ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:depends_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Likelihood ;
            owl:onProperty tvbo:likelihood ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Algorithm ;
            owl:onProperty tvbo:depends_on ] ;
    skos:definition "Bayesian inference of model parameters from an observation, via MCMC. A standalone, first-class concept (NOT an Optimization): it produces a POSTERIOR, not a point estimate, using priors + a likelihood + a sampler instead of a loss + optimizer. It runs the SAME differentiable forward model, wrapped in a probabilistic model (sample priors -> forward -> likelihood)." ;
    skos:exactMatch tvbo:Inference ;
    skos:inScheme <https://w3id.org/tvbo> .

<https://w3id.org/tvbo/InitialStateMethod#from_branch> a owl:Class ;
    rdfs:label "from_branch (InitialStateMethod)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:InitialStateMethod ;
    skos:definition "Start from a point on a previously computed branch." ;
    skos:notation "from_branch" .

<https://w3id.org/tvbo/InitialStateMethod#from_experiment> a owl:Class ;
    rdfs:label "from_experiment (InitialStateMethod)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:InitialStateMethod ;
    skos:definition "Seed from the settled endpoint state of another already-run experiment in the study (referenced by InitialState.source_experiment). Reuses a working point that experiment already reached instead of recomputing it — the cross-experiment counterpart of from_working_point (which recomputes the ramp inline). source_point selects which settled point of the source run (default 'endpoint')." ;
    skos:notation "from_experiment" .

<https://w3id.org/tvbo/InitialStateMethod#from_working_point> a owl:Class ;
    rdfs:label "from_working_point (InitialStateMethod)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:InitialStateMethod ;
    skos:definition "Ramp a parameter quasi-statically (warm-start / from_previous) to a target value (see InitialState.ramp) and start from the endpoint state — reach a working point on the solution branch before the run." ;
    skos:notation "from_working_point" .

<https://w3id.org/tvbo/InitialStateMethod#given> a owl:Class ;
    rdfs:label "given (InitialStateMethod)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:InitialStateMethod ;
    skos:definition "Use the model's default initial values directly." ;
    skos:notation "given" .

<https://w3id.org/tvbo/InitialStateMethod#newton> a owl:Class ;
    rdfs:label "newton (InitialStateMethod)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:InitialStateMethod ;
    skos:definition "Use Newton's method to find the nearest fixed point." ;
    skos:notation "newton" .

<https://w3id.org/tvbo/InitialStateMethod#time_integration> a owl:Class ;
    rdfs:label "time_integration (InitialStateMethod)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:InitialStateMethod ;
    skos:definition "Integrate the ODE forward until convergence (robust, default)." ;
    skos:notation "time_integration" .

tvbo:Likelihood a owl:Class ;
    rdfs:label "Likelihood" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:sigma ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:sigma ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:sigma ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ] ;
    skos:definition "Observation model for Bayesian inference: p(data | sim(theta)). Points at the observation holding the data and specifies the noise family + scale. `name` is the noise family (default Normal); `source` uses the same referencing as `Observation.source`, so the observed data can come from this experiment's integration, an empirical network measure, or a runtime-bound array — one flexible hook, no data-loading path of its own." ;
    skos:exactMatch tvbo:Likelihood ;
    skos:inScheme <https://w3id.org/tvbo> .

<https://w3id.org/tvbo/MarkType#band> a owl:Class ;
    rdfs:label "band (MarkType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:MarkType ;
    skos:definition "Filled band between two series (error/CI)." ;
    skos:notation "band" .

<https://w3id.org/tvbo/MarkType#line> a owl:Class ;
    rdfs:label "line (MarkType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:MarkType ;
    skos:definition "Connected line (timeseries, bifurcation branch, trajectory)." ;
    skos:notation "line" .

<https://w3id.org/tvbo/MarkType#rule> a owl:Class ;
    rdfs:label "rule (MarkType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:MarkType ;
    skos:definition "Reference line / span (threshold, stimulus window, vline)." ;
    skos:notation "rule" .

<https://w3id.org/tvbo/MarkType#scatter> a owl:Class ;
    rdfs:label "scatter (MarkType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:MarkType ;
    skos:definition "Points (fixed points, special points, per-node profiles)." ;
    skos:notation "scatter" .

tvbo:MeasureSpec a owl:Class ;
    rdfs:label "MeasureSpec" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:concept_iri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:concept_iri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:measure_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:measure_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:measure_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:concept_iri ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:task_iri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:task_iri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:task_iri ] ;
    skos:definition "Metadata for one phenotype measure. Optional per-measure entry on ``Phenotype.measure_specs``." ;
    skos:exactMatch tvbo:MeasureSpec ;
    skos:inScheme <https://w3id.org/tvbo> .

<https://w3id.org/tvbo/ModelParadigm#dynamic_mean_field> a owl:Class ;
    rdfs:label "dynamic_mean_field (ModelParadigm)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ModelParadigm ;
    skos:definition "Dynamic mean-field approximation (e.g., Deco et al.)." ;
    skos:notation "dynamic_mean_field" .

<https://w3id.org/tvbo/ModelParadigm#generic> a owl:Class ;
    rdfs:label "generic (ModelParadigm)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ModelParadigm ;
    skos:definition "General-purpose, not specific to neuroscience." ;
    skos:notation "generic" .

<https://w3id.org/tvbo/ModelParadigm#model_description> a owl:Class ;
    rdfs:label "model_description (ModelParadigm)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ModelParadigm ;
    skos:definition "Declarative model specification language." ;
    skos:notation "model_description" .

<https://w3id.org/tvbo/ModelType#field> a owl:Class ;
    rdfs:label "field (ModelType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Spatially distributed neural-field models described by integro- differential or PDE formulations." ;
    skos:notation "field" .

<https://w3id.org/tvbo/ModelType#generic> a owl:Class ;
    rdfs:label "generic (ModelType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Generic / normal-form dynamical systems not specific to neural modelling (e.g. Generic2dOscillator, GenericLinear)." ;
    skos:notation "generic" .

<https://w3id.org/tvbo/ModelType#mean_field> a owl:Class ;
    rdfs:label "mean_field (ModelType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Mathematically derived mean-field models obtained by exact reduction of spiking networks (Ott-Antonsen ansatz, Lorentzian heterogeneity, etc.). Examples: MontbrioPazoRoxin, CoombesByrne, ReducedWongWang, ZerlautAdaptationFirstOrder." ;
    skos:notation "mean_field" .

<https://w3id.org/tvbo/ModelType#neural_mass> a owl:Class ;
    rdfs:label "neural_mass (ModelType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Phenomenological population-rate / neural-mass models that describe synaptic and firing-rate dynamics without an explicit derivation from single-neuron statistics. Examples: JansenRit, WilsonCowan, LarterBreakspear, TsodyksMarkram." ;
    skos:notation "neural_mass" .

<https://w3id.org/tvbo/ModelType#phase_oscillator> a owl:Class ;
    rdfs:label "phase_oscillator (ModelType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Phase-reduced or Kuramoto-type oscillator models. Examples: Kuramoto, SupHopf." ;
    skos:notation "phase_oscillator" .

<https://w3id.org/tvbo/ModelType#phenomenological> a owl:Class ;
    rdfs:label "phenomenological (ModelType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Empirical / phenomenological models that capture macroscopic dynamics without direct biophysical derivation. Examples: Epileptor2D, Epileptor5D." ;
    skos:notation "phenomenological" .

<https://w3id.org/tvbo/ModelType#spiking> a owl:Class ;
    rdfs:label "spiking (ModelType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Single-neuron or conductance-based spiking models (HH, AdEx, LIF, Izhikevich, etc.). These can be used as nodes in a network alongside mean-field models." ;
    skos:notation "spiking" .

tvbo:NDArray a owl:Class ;
    rdfs:label "NDArray" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:dataLocation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:dtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:shape ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:dtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:dataLocation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:dataLocation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:dtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:shape ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ] ;
    skos:exactMatch tvbo:NDArray ;
    skos:inScheme <https://w3id.org/tvbo> .

<https://w3id.org/tvbo/NodeReconciliation#by_label> a owl:Class ;
    rdfs:label "by_label (NodeReconciliation)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:NodeReconciliation ;
    skos:definition "Restrict to the shared node labels by name (keyed ``.sel``), preserving the consuming network's order, on every node axis (a vector on its node axis, a matrix on both). Never positional." ;
    skos:notation "by_label" .

<https://w3id.org/tvbo/NodeReconciliation#none> a owl:Class ;
    rdfs:label "none (NodeReconciliation)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:NodeReconciliation ;
