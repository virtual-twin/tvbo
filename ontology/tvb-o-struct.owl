<http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#from_branch> a owl:Class ;
    rdfs:label "from_branch" ;
    rdfs:subClassOf tvbo:InitialStateMethod ;
    skos:definition "Start from a point on a previously computed branch." .

<http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#given> a owl:Class ;
    rdfs:label "given" ;
    rdfs:subClassOf tvbo:InitialStateMethod ;
    skos:definition "Use the model's default initial values directly." .

<http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#newton> a owl:Class ;
    rdfs:label "newton" ;
    rdfs:subClassOf tvbo:InitialStateMethod ;
    skos:definition "Use Newton's method to find the nearest fixed point." .

<http://www.thevirtualbrain.org/tvb-o/InitialStateMethod#time_integration> a owl:Class ;
    rdfs:label "time_integration" ;
    rdfs:subClassOf tvbo:InitialStateMethod ;
    skos:definition "Integrate the ODE forward until convergence (robust, default)." .

<http://www.thevirtualbrain.org/tvb-o/ModelParadigm#dynamic_mean_field> a owl:Class ;
    rdfs:label "dynamic_mean_field" ;
    rdfs:subClassOf tvbo:ModelParadigm ;
    skos:definition "Dynamic mean-field approximation (e.g., Deco et al.)." .

<http://www.thevirtualbrain.org/tvb-o/ModelParadigm#generic> a owl:Class ;
    rdfs:label "generic" ;
    rdfs:subClassOf tvbo:ModelParadigm ;
    skos:definition "General-purpose, not specific to neuroscience." .

<http://www.thevirtualbrain.org/tvb-o/ModelParadigm#model_description> a owl:Class ;
    rdfs:label "model_description" ;
    rdfs:subClassOf tvbo:ModelParadigm ;
    skos:definition "Declarative model specification language." .

<http://www.thevirtualbrain.org/tvb-o/ModelType#field> a owl:Class ;
    rdfs:label "field" ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Spatially distributed neural-field models described by integro- differential or PDE formulations." .

<http://www.thevirtualbrain.org/tvb-o/ModelType#generic> a owl:Class ;
    rdfs:label "generic" ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Generic / normal-form dynamical systems not specific to neural modelling (e.g. Generic2dOscillator, GenericLinear)." .

<http://www.thevirtualbrain.org/tvb-o/ModelType#mean_field> a owl:Class ;
    rdfs:label "mean_field" ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Mathematically derived mean-field models obtained by exact reduction of spiking networks (Ott-Antonsen ansatz, Lorentzian heterogeneity, etc.). Examples: MontbrioPazoRoxin, CoombesByrne, ReducedWongWang, ZerlautAdaptationFirstOrder." .

<http://www.thevirtualbrain.org/tvb-o/ModelType#neural_mass> a owl:Class ;
    rdfs:label "neural_mass" ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Phenomenological population-rate / neural-mass models that describe synaptic and firing-rate dynamics without an explicit derivation from single-neuron statistics. Examples: JansenRit, WilsonCowan, LarterBreakspear, TsodyksMarkram." .

<http://www.thevirtualbrain.org/tvb-o/ModelType#phase_oscillator> a owl:Class ;
    rdfs:label "phase_oscillator" ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Phase-reduced or Kuramoto-type oscillator models. Examples: Kuramoto, SupHopf." .

<http://www.thevirtualbrain.org/tvb-o/ModelType#phenomenological> a owl:Class ;
    rdfs:label "phenomenological" ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Empirical / phenomenological models that capture macroscopic dynamics without direct biophysical derivation. Examples: Epileptor2D, Epileptor5D." .

<http://www.thevirtualbrain.org/tvb-o/ModelType#spiking> a owl:Class ;
    rdfs:label "spiking" ;
    rdfs:subClassOf tvbo:ModelType ;
    skos:definition "Single-neuron or conductance-based spiking models (HH, AdEx, LIF, Izhikevich, etc.). These can be used as nodes in a network alongside mean-field models." .

