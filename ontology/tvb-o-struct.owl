@prefix UO: <http://purl.obolibrary.org/obo/UO_> .
@prefix biotools: <https://bio.tools/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sio: <http://semanticscience.org/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tvbo: <https://w3id.org/tvbo/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

schema1:Book rdfs:label "Book" .

schema1:Chapter rdfs:label "Chapter" .

schema1:CreativeWork rdfs:label "Creative work" .

schema1:Report rdfs:label "Report" .

schema1:ScholarlyArticle rdfs:label "Scholarly article" .

schema1:Thesis rdfs:label "Thesis" .

<http://uri.interlex.org/tgbugs/uris/readable/digitalIdentifier> a owl:DatatypeProperty ;
    rdfs:label "digitalIdentifier" ;
    rdfs:range xsd:string ;
    skos:definition "Add the digital identifier of this brain atlas or coordinate space version." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

skos:Concept rdfs:label "SKOS Concept" .

tvbo:SoftwarePackage rdfs:label "Software package" .

<https://w3id.org/tvbo/dbs/DBSDataset> a owl:Class ;
    rdfs:label "DBSDataset (dbs)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/coordinate_space> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tvbo/dbs/ClinicalScore> ;
            owl:onProperty <https://w3id.org/tvbo/dbs/clinical_scores> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/CommonCoordinateSpace> ;
            owl:onProperty <https://w3id.org/tvbo/dbs/coordinate_space> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:subjects ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/coordinate_space> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/clinical_scores> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tvbo/dbs/DBSSubject> ;
            owl:onProperty tvbo:subjects ],
        <https://w3id.org/tvbo/study/Dataset> ;
    skos:definition "Collection of data related to a specific DBS study." ;
    skos:inScheme tvbo:dbs ;
    skos:notation "DBSDataset" .

<https://w3id.org/tvbo/dbs/id> a owl:DatatypeProperty ;
    rdfs:label "id (dbs)" ;
    rdfs:range xsd:integer ;
    skos:definition "Surrogate integer key." ;
    skos:inScheme tvbo:dbs ;
    skos:notation "id" .

tvbo:file a owl:DatatypeProperty ;
    rdfs:label "file (slot)" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "file" .

<http://uri.interlex.org/tgbugs/uris/readable/BrainAtlas> a owl:Class ;
    rdfs:label "BrainAtlas" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/ParcellationTerminology> ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/terminology> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/abbreviation> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/abbreviation> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/isVersionOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/isVersionOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/coordinateSpace> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/isVersionOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/terminology> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/terminology> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/coordinateSpace> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/author> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/abbreviation> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/CommonCoordinateSpace> ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/coordinateSpace> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/author> ] ;
    skos:definition "A schema for representing a version of a brain atlas." ;
    skos:exactMatch <http://uri.interlex.org/tgbugs/uris/readable/atlas/Atlas> ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/ParcellationTerminology> a owl:Class ;
    rdfs:label "ParcellationTerminology" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/ParcellationEntity> ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/entities> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/entities> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/ontologyIdentifier> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/ontologyIdentifier> ] ;
    skos:definition "A schema for representing a parcellation terminology, which consists of parcellation entities." ;
    skos:exactMatch <http://uri.interlex.org/tgbugs/uris/readable/parcellationTerminology> ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

tvbo:Annotation a owl:Class ;
    rdfs:label "Annotation" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:x ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:loc ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:loc ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:loc ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:y ] ;
    skos:definition "A positioned text label on a panel, in axes-fraction coordinates." ;
    skos:inScheme tvbo:figure .

tvbo:Encoding a owl:Class ;
    rdfs:label "Encoding" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:detail ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:color ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:color ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:z ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:color ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:detail ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:detail ] ;
    skos:definition "Map visual channels to container dims/coords/vars, by NAME (keyed, never positional). Common case: {x: time, y: rate}. A channel may later accept a scale object without breaking this string form." ;
    skos:inScheme tvbo:figure .

tvbo:Figure a owl:Class ;
    rdfs:label "Figure" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:height_ratios ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Panel ;
            owl:onProperty tvbo:panels ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:trim_margins ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:auto_format ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:width_ratios ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:height_ratios ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty tvbo:auto_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:dpi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:panel_number_loc ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Provenance ;
            owl:onProperty tvbo:provenance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:spines ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:dpi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:font_size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:font_size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:spines ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty tvbo:panel_numbers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:format ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:height ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:code_modules ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:panel_number_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:width ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:panel_number_format ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:width_ratios ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:layout ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:panel_number_loc ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:height ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:panel_numbers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:panels ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:width ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:style ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:spines ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:style ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:panel_number_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:provenance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:trim_margins ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:provenance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:workflow_overrides ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:workflow_overrides ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:layout ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:dpi ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:panel_numbers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:font_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Corner ;
            owl:onProperty tvbo:panel_number_loc ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:code_modules ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:WorkflowConfig ;
            owl:onProperty tvbo:workflow_overrides ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty tvbo:trim_margins ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:width ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:height ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:auto_format ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:layout ] ;
    skos:definition "A publication figure, a mosaic of panels rendered from result containers. Reuses name (identifier) and description (caption)." ;
    skos:exactMatch schema1:ImageObject ;
    skos:inScheme tvbo:figure .

tvbo:Layer a owl:Class ;
    rdfs:label "Layer" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:style ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:encoding ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Encoding ;
            owl:onProperty tvbo:encoding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:used ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:used ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:transform ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:mark ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:transform ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:encoding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:style ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Style ;
            owl:onProperty tvbo:style ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:mark ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:MarkType ;
            owl:onProperty tvbo:mark ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:transform ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:DataRef ;
            owl:onProperty tvbo:used ] ;
    skos:definition "One mark bound to one data reference, with its encoding." ;
    skos:inScheme tvbo:figure .

tvbo:LossFunction a owl:Class ;
    rdfs:label "LossFunction" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Aggregation ;
            owl:onProperty tvbo:aggregate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:aggregate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:aggregate ],
        tvbo:Function ;
    skos:definition "A loss function for optimization with optional aggregation. Extends Function with aggregation specification for per-element losses." ;
    skos:exactMatch tvbo:LossFunction ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:NamedArray a owl:Class ;
    rdfs:label "NamedArray" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:shape ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:dtype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:shape ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:dtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:dtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:unit ] ;
    skos:definition "A named numeric array. Used as a sidecar slot value where a schema-typed object (e.g. ``ExperimentResult.parameters``) holds multiple arrays addressable by name (``w_LRE``, ``w_FFI``, ``J_i``, ...). The actual numeric data lives in the companion ``.h5`` at ``parameters/<name>``; the YAML carries only the descriptor." ;
    skos:exactMatch tvbo:NamedArray ;
    skos:inScheme <https://w3id.org/tvbo> .

<https://w3id.org/tvbo/ObservationReductionMode#streaming> a owl:Class ;
    rdfs:label "streaming (ObservationReductionMode)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ObservationReductionMode ;
    skos:definition "Fold this observation into the integrator carry as an (init, update, finalize) reducer; never materialise the trajectory. Supported for the HRF-Volterra BOLD pipeline (hemodynamic convolution), whose kernel / downsample stride / TR stride / Volterra scaling the resolver lifts from the declared pipeline." ;
    skos:notation "streaming" .

