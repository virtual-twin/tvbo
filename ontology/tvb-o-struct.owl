tvbo:Prior a owl:Class ;
    rdfs:label "Prior" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:distribution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Distribution ;
            owl:onProperty tvbo:distribution ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:distribution ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ] ;
    skos:definition "Prior belief over one inferred parameter. In `Inference.priors` the collection KEY is the parameter's dotted name; the value wraps a `Distribution` as the belief (reusing the standard distribution vocabulary rather than inventing a new one). Distinct from `Parameter.distribution`, which specifies per-node SAMPLING, not a prior." ;
    skos:exactMatch tvbo:Prior ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:Procedure a owl:Class ;
    rdfs:label "Procedure" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:output ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:steps ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:ProcedureStep ;
            owl:onProperty tvbo:output ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:ProcedureStep ;
            owl:onProperty tvbo:steps ] ;
    skos:definition "Symbolic procedure: an ordered list of steps producing named outputs.  Documents a derived generator's algorithm independently of any backend binding." ;
    skos:exactMatch tvbo:Procedure ;
    skos:inScheme <https://w3id.org/tvbo> .

<https://w3id.org/tvbo/ProcedureStepType#distribution_pdf> a owl:Class ;
    rdfs:label "distribution_pdf (ProcedureStepType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ProcedureStepType ;
    skos:definition "Evaluate `distribution`'s density at the positions named by `of` — a spatial field (e.g. a Gaussian sink/source whose difference forms an in-strength gradient)." ;
    skos:notation "distribution_pdf" .

<https://w3id.org/tvbo/ProcedureStepType#equation> a owl:Class ;
    rdfs:label "equation (ProcedureStepType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ProcedureStepType ;
    skos:definition "Evaluate `equation.rhs` over previously-named intermediates and the generator's parameters. The default." ;
    skos:notation "equation" .

<https://w3id.org/tvbo/ProcedureStepType#minmax_rescale> a owl:Class ;
    rdfs:label "minmax_rescale (ProcedureStepType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ProcedureStepType ;
    skos:definition "Affinely rescale the intermediate named by `of` from its own min/max onto `target_range`." ;
    skos:notation "minmax_rescale" .

<https://w3id.org/tvbo/ProcedureStepType#normalize> a owl:Class ;
    rdfs:label "normalize (ProcedureStepType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ProcedureStepType ;
    skos:definition "Divide the intermediate named by `of` by its sum along `axis` (axis 0 gives uniform in-strength)." ;
    skos:notation "normalize" .

<https://w3id.org/tvbo/ProcedureStepType#pairwise_distance> a owl:Class ;
    rdfs:label "pairwise_distance (ProcedureStepType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ProcedureStepType ;
    skos:definition "Distance matrix between the rows of the positions named by `of` (euclidean). `diagonal` optionally overwrites the self-distance, e.g. to infinity so a decaying distance kernel evaluates to zero there and no node connects to itself." ;
    skos:notation "pairwise_distance" .

<https://w3id.org/tvbo/ProcedureStepType#sample> a owl:Class ;
    rdfs:label "sample (ProcedureStepType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ProcedureStepType ;
    skos:definition "A random matrix drawn from `distribution` — the draw itself, e.g. the substrate of a random reservoir. Distinct from `stochastic_mask`, which compares a draw and yields a boolean." ;
    skos:notation "sample" .

<https://w3id.org/tvbo/ProcedureStepType#stochastic_mask> a owl:Class ;
    rdfs:label "stochastic_mask (ProcedureStepType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ProcedureStepType ;
    skos:definition "Boolean connection mask: compare the quantity named by `of` against a draw from `distribution` using `comparison`. The declarative form of a distance-dependent connection probability." ;
    skos:notation "stochastic_mask" .

tvbo:RandomStream a owl:Class ;
    rdfs:label "RandomStream" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
