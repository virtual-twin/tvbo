qudt:A a owl:Class ;
    rdfs:label "A" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Ampere" ;
    skos:exactMatch UO:0000011 .

qudt:CentiM a owl:Class ;
    rdfs:label "cm" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Centimetre" ;
    skos:exactMatch UO:0000015 .

qudt:DEG_C a owl:Class ;
    rdfs:label "degC" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Degree Celsius" .

qudt:H-PER-M a owl:Class ;
    rdfs:label "H_per_m" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Henry per metre (permeability)" .

qudt:HZ a owl:Class ;
    rdfs:label "Hz" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Hertz (s⁻¹)" ;
    skos:exactMatch UO:0000106 .

qudt:KiloGM a owl:Class ;
    rdfs:label "kg" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Kilogram" ;
    skos:exactMatch UO:0000009 .

qudt:KiloHZ a owl:Class ;
    rdfs:label "kHz" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Kilohertz" .

qudt:M a owl:Class ;
    rdfs:label "m" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Metre" ;
    skos:exactMatch UO:0000008 .

qudt:M-PER-SEC a owl:Class ;
    rdfs:label "m_per_s" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Metre per second" .

qudt:M-PER-SEC2 a owl:Class ;
    rdfs:label "m_per_s2" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Metre per second squared (acceleration)" .

qudt:MOL-PER-M3 a owl:Class ;
    rdfs:label "mol_per_m3" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Mole per cubic metre (mol/m³)" .

qudt:MicroM3 a owl:Class ;
    rdfs:label "um3" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Cubic micrometre (µm³)" .

qudt:MicroS a owl:Class ;
    rdfs:label "uS" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Microsiemens" .

qudt:MicroSEC a owl:Class ;
    rdfs:label "us" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Microsecond" ;
    skos:exactMatch UO:0000029 .

qudt:MilliM a owl:Class ;
    rdfs:label "mm" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Millimetre" ;
    skos:exactMatch UO:0000016 .

qudt:MilliM-PER-MilliSEC a owl:Class ;
    rdfs:label "mm_per_ms" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Millimetre per millisecond (= m/s)" .

qudt:MilliMOL-PER-M3 a owl:Class ;
    rdfs:label "mmol_per_m3" ;
