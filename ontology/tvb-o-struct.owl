            owl:onProperty tvbo:state_variables ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:solver ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:domain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:SpatialDomain ;
            owl:onProperty tvbo:domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:parameters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:parameters ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:DifferentialOperator ;
            owl:onProperty tvbo:operators ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:solver ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Equation ;
            owl:onProperty tvbo:sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:mesh ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:PDESolver ;
            owl:onProperty tvbo:solver ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:operators ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:derived_variables ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:mesh ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:DerivedVariable ;
            owl:onProperty tvbo:derived_variables ] ;
    skos:definition "Partial differential equation problem definition." ;
    skos:exactMatch tvbo:PDE ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:PDESolver a owl:Class ;
    rdfs:label "PDESolver" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:method ],
        [ a owl:Restriction ;
