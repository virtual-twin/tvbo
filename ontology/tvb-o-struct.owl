<http://uri.interlex.org/tgbugs/uris/readable/ontologyIdentifier> a owl:DatatypeProperty ;
    rdfs:label "ontologyIdentifier" ;
    rdfs:range xsd:string ;
    skos:definition "Enter the internationalized resource identifier (IRI) to the related ontological terms." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

wd:Q858926 a owl:Class ;
    rdfs:label "bifurcation_analysis" ;
    rdfs:subClassOf tvbo:ModelParadigm,
        tvbo:ToolRole ;
    skos:altLabel "continuation_tool" ;
    skos:definition "Dynamical systems bifurcation / continuation analysis.",
        "Numerical continuation / bifurcation analysis." .

tvbo:Aggregation a owl:Class ;
    rdfs:label "Aggregation" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:ReductionType ;
            owl:onProperty tvbo:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:over ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:DimensionType ;
            owl:onProperty tvbo:over ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:over ] ;
    skos:definition "Specifies how to aggregate values across a dimension. Used for loss functions to define per-element loss with reduction." ;
    skos:exactMatch tvbo:Aggregation ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:ConnectivityRule a owl:Class ;
    rdfs:label "ConnectivityRule" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/ConnectivityRule#all_to_all> <https://w3id.org/tvbo/ConnectivityRule#one_to_one> <https://w3id.org/tvbo/ConnectivityRule#random> ) ;
    skos:definition "Rule for expanding a population-level Edge into individual cell-to-cell connections. Names a connectivity pattern between the source and target populations so a network of populations declares its projections once, without enumerating every connection; each backend expands the rule into its native connection set (e.g. the NeuroML exporter emits one <projection> with size_src x size_tgt <connection> elements). Backend-independent: it states the connectivity pattern, not how any simulator stores it." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/ConnectivityRule#all_to_all>,
        <https://w3id.org/tvbo/ConnectivityRule#one_to_one>,
        <https://w3id.org/tvbo/ConnectivityRule#random> .

tvbo:ContinuationAlgorithm a owl:Class ;
    rdfs:label "ContinuationAlgorithm" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/ContinuationAlgorithm#PALC> <https://w3id.org/tvbo/ContinuationAlgorithm#MoorePenrose> <https://w3id.org/tvbo/ContinuationAlgorithm#Natural> ) ;
    skos:definition "Predictor-corrector algorithm for numerical continuation." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/ContinuationAlgorithm#MoorePenrose>,
        <https://w3id.org/tvbo/ContinuationAlgorithm#Natural>,
        <https://w3id.org/tvbo/ContinuationAlgorithm#PALC> .

tvbo:DomainEnforcement a owl:Class ;
    rdfs:label "DomainEnforcement" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/DomainEnforcement#none> <https://w3id.org/tvbo/DomainEnforcement#clamp> <https://w3id.org/tvbo/DomainEnforcement#wrap> ) ;
    skos:definition "Whether and how a state variable's ``domain`` constrains the trajectory during integration. Default ``none`` means the domain is descriptive metadata only (expected range, plot limits, initial- condition sampling support) and never alters the dynamics — so declaring a domain is side-effect free. ``clamp`` and ``wrap`` opt in to active enforcement using the domain's ``lo``/``hi``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/DomainEnforcement#clamp>,
        <https://w3id.org/tvbo/DomainEnforcement#none>,
        <https://w3id.org/tvbo/DomainEnforcement#wrap> .

tvbo:GraphRepresentation a owl:Class ;
    rdfs:label "GraphRepresentation" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/GraphRepresentation#auto> <https://w3id.org/tvbo/GraphRepresentation#dense> <https://w3id.org/tvbo/GraphRepresentation#sparse> ) ;
    skos:definition "How a Network's connectivity is represented when evaluating coupling. This is a backend-independent performance contract, not a numerical one: both representations compute the same coupling, but a sparse representation sums over the existing edges (cost scales with the number of edges) while a dense representation operates on the full adjacency (cost scales with nodes-squared). A backend maps the choice onto its own primitives (edge gather / segment-sum vs matrix product). Orthogonal to whether the coupling reads *delayed* states — that is decided per coupling by its conduction delay — so the two dimensions together yield the four backend graph kinds: dense/sparse × instantaneous/delayed." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/GraphRepresentation#auto>,
        <https://w3id.org/tvbo/GraphRepresentation#dense>,
        <https://w3id.org/tvbo/GraphRepresentation#sparse> .

tvbo:Hemisphere a owl:Class ;
    rdfs:label "Hemisphere" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/Hemisphere#left> <https://w3id.org/tvbo/Hemisphere#right> <https://w3id.org/tvbo/Hemisphere#both> ) ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> ;
    linkml:permissible_values <https://w3id.org/tvbo/Hemisphere#both>,
        <https://w3id.org/tvbo/Hemisphere#left>,
        <https://w3id.org/tvbo/Hemisphere#right> .

