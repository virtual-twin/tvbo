tvbo:BranchSwitch a owl:Class ;
    rdfs:label "BranchSwitch" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:delta_p ],
        [ a owl:Restriction ;
