            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:parameter ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:domain ] ;
    skos:definition "One degree of freedom in an OptimizationStage. References an existing Parameter by dotted scope (e.g. \"ReducedWongWang.w\" or \"FastLinearCoupling.G\") and supplies optimization-specific metadata (heterogeneous, shape, bounds, initial value). No new Parameter is created here." ;
    skos:exactMatch tvbo:FreeParameter ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:GraphGenerator a owl:Class ;
