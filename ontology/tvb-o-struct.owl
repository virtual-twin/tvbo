            owl:allValuesFrom tvbo:Function ;
            owl:onProperty tvbo:preprocessing ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:key ],
        [ a owl:Restriction ;
