            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:target_value ] ;
    skos:definition "Defines what the tuning algorithm optimizes for. Can be an activity target (FIC) or a connectivity target (EIB)." ;
    skos:exactMatch tvbo:TuningObjective ;
    skos:inScheme <https://w3id.org/tvbo> .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#Hz_per_nA> a owl:Class ;
    rdfs:label "Hz_per_nA" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Hertz per nanoampere (neural gain)" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#Mohm> a owl:Class ;
    rdfs:label "Mohm" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Megaohm (MΩ)" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#S_per_cm2> a owl:Class ;
    rdfs:label "S_per_cm2" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Siemens per square centimetre (conductance density)" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#S_per_m2> a owl:Class ;
    rdfs:label "S_per_m2" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Siemens per square metre (conductance density, SI)" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#arbitrary_unit> a owl:Class ;
    rdfs:label "arbitrary_unit" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Arbitrary units (a.u.)" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#kg_per_s> a owl:Class ;
    rdfs:label "kg_per_s" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Kilogram per second" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#kohm_cm> a owl:Class ;
    rdfs:label "kohm_cm" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Kilo-ohm centimetre (axial resistivity)" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#mS_per_cm2> a owl:Class ;
    rdfs:label "mS_per_cm2" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Millisiemens per square centimetre (conductance density)" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#mol_per_cm3> a owl:Class ;
    rdfs:label "mol_per_cm3" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Mole per cubic centimetre (mol/cm³)" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#mol_per_m_per_A_per_s> a owl:Class ;
    rdfs:label "mol_per_m_per_A_per_s" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Mole per metre per ampere per second (concentration-current coupling)" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#nS_per_mV> a owl:Class ;
    rdfs:label "nS_per_mV" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Nanosiemens per millivolt" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#per_unit> a owl:Class ;
    rdfs:label "per_unit" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Per-unit (dimensionless power-systems convention)" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#rad_per_ms> a owl:Class ;
    rdfs:label "rad_per_ms" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Radian per millisecond" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#uA_per_cm2> a owl:Class ;
    rdfs:label "uA_per_cm2" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Microampere per square centimetre (current density)" .

<http://www.thevirtualbrain.org/tvb-o/UnitEnum#uF_per_cm2> a owl:Class ;
    rdfs:label "uF_per_cm2" ;
    rdfs:subClassOf tvbo:UnitEnum ;
    skos:definition "Microfarad per square centimetre (specific capacitance)" .

tvbo:UpdateRule a owl:Class ;
    rdfs:label "UpdateRule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty tvbo:warmup ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:target_parameter ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:target_parameter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:target_parameter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:warmup ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Range ;
            owl:onProperty tvbo:bounds ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:bounds ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:warmup ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:bounds ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Equation ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Observation ;
            owl:onProperty tvbo:requires ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:requires ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ] ;
    skos:definition "Defines how a parameter is updated based on observables. Represents iterative learning rules like FIC or EIB updates. Functions from experiment.functions are available in the equation." ;
    skos:exactMatch tvbo:UpdateRule ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:additional_equations a owl:ObjectProperty ;
    rdfs:label "additional_equations" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:affect_parameters a owl:DatatypeProperty ;
    rdfs:label "affect_parameters" ;
    skos:definition "Parameter symbols modifiable in the affect function." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:affect_states a owl:DatatypeProperty ;
    rdfs:label "affect_states" ;
    skos:definition "State variable symbols modifiable in the affect function." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:algorithms a owl:ObjectProperty ;
    rdfs:label "algorithms" ;
    skos:definition "Iterative parameter tuning algorithms (FIC, EIB, etc.)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:branches a owl:ObjectProperty ;
    rdfs:label "branches" ;
    skos:definition "Child branches to continue from detected bifurcation points (PO from Hopf, fold continuation, etc.)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:call_args a owl:ObjectProperty ;
    rdfs:label "call_args" ;
    skos:definition "Arguments passed when calling the instance (__call__). Usually the input data from simulation result. Example: result (simulation output array)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:cases a owl:ObjectProperty ;
    rdfs:label "cases" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:condition_parameters a owl:DatatypeProperty ;
    rdfs:label "condition_parameters" ;
    skos:definition "Parameter symbols accessible in the condition function." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:condition_states a owl:DatatypeProperty ;
    rdfs:label "condition_states" ;
    skos:definition "State variable symbols accessible in the condition function. For edges, can include source/destination vertex outputs." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:conditionals a owl:ObjectProperty ;
    rdfs:label "conditionals" ;
    skos:definition "Conditional logic for piecewise equations." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:constructor_args a owl:ObjectProperty ;
    rdfs:label "constructor_args" ;
    skos:definition "Arguments passed to __init__ when instantiating the class. Example: period=1000.0, downsample_period=4.0 for Bold monitor." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:continuations a owl:ObjectProperty ;
    rdfs:label "continuations" ;
    skos:definition "Numerical continuation and bifurcation analysis specifications. Each entry defines a continuation experiment (equilibrium branch, codim-2 curve, periodic orbit family, etc.).            # Either reference a full reusable environment (preferred) or, for" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:coordinates a owl:ObjectProperty ;
    rdfs:label "coordinates" ;
    skos:definition "Node coordinates (x,y,z) in the given coordinate space." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:coupling_inputs a owl:ObjectProperty ;
    rdfs:label "coupling_inputs" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:coupling_terms a owl:ObjectProperty ;
    rdfs:label "coupling_terms" ;
    skos:inScheme <https://w3id.org/tvbo> .

<http://www.thevirtualbrain.org/tvb-o/dbs/Electrode> a owl:Class ;
    rdfs:label "Electrode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/manufacturer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/manufacturer> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/head> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/target_structure> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/recon_path> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/target_structure> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/electrode_id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/tail> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/coordinate_space> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/model> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/model> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/model> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/hemisphere> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/manufacturer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/trajectory> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/head> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/contacts> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/head> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/coordinate_space> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.thevirtualbrain.org/tvb-o/dbs/Contact> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/contacts> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/hemisphere> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/trajectory> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/electrode_id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/ParcellationEntity> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/target_structure> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/CommonCoordinateSpace> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/coordinate_space> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/recon_path> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/recon_path> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/hemisphere> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/electrode_id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/tail> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/tail> ] ;
    skos:definition "Implanted DBS electrode and contact geometry." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/active_contacts> a owl:DatatypeProperty ;
    rdfs:label "active_contacts" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/clinical_improvement> a owl:ObjectProperty ;
    rdfs:label "clinical_improvement" ;
    skos:definition "Observed improvement relative to baseline based on a defined score." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/clinical_scores> a owl:ObjectProperty ;
    rdfs:label "clinical_scores" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/contacts> a owl:ObjectProperty ;
    rdfs:label "contacts" ;
    skos:definition "List of physical contacts along the electrode" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/electrodes> a owl:ObjectProperty ;
    rdfs:label "electrodes" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/protocols> a owl:ObjectProperty ;
    rdfs:label "protocols" ;
    skos:definition "All DBS protocols assigned to this subject." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/settings> a owl:ObjectProperty ;
    rdfs:label "settings" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/trajectory> a owl:ObjectProperty ;
    rdfs:label "trajectory" ;
    skos:definition "The planned trajectory for electrode implantation" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

tvbo:derived_observations a owl:ObjectProperty ;
    rdfs:label "derived_observations" ;
    skos:definition "Observations derived from combining other observations. Computed after all regular observations are available. Examples: fc_corr (from fc, fc_target), rmse, etc." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:dimension_labels a owl:DatatypeProperty ;
    rdfs:label "dimension_labels" ;
    skos:definition "Ordered labels for the matrix columns (dim-1) when the matrix is non-square.  Row labels (dim-0) are the parent Network's node labels.  Stored as HDF5 dimension scales in the companion file." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:edge_matrix_files a owl:ObjectProperty ;
    rdfs:label "edge_matrix_files" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:edges a owl:ObjectProperty ;
    rdfs:label "edges" ;
    skos:definition "List of directed edges with coupling references (optional, for explicit edge definition)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:explorations a owl:ObjectProperty ;
    rdfs:label "explorations" ;
    skos:definition "Parameter exploration/grid search specifications" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:freeze_parameters a owl:ObjectProperty ;
    rdfs:label "freeze_parameters" ;
    skos:definition "Parameters from previous stages to freeze (keep at optimized value but not update)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:groups a owl:DatatypeProperty ;
    rdfs:label "groups" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:includes a owl:ObjectProperty ;
    rdfs:label "includes" ;
    skos:definition "Include update rules from other algorithms with optional argument overrides. Unlike depends_on (sequential), includes means combined execution. Example: includes: [{algorithm: fic, arguments: [{name: eta, value: 0.1}]}]" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:incoming_states a owl:ObjectProperty ;
    rdfs:label "incoming_states" ;
    skos:definition "References to state variables from connected (source) nodes. Auto-populated from state_variables with coupling_variable=true when omitted. Used by name in pre_expression." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:intermediate_expressions a owl:ObjectProperty ;
    rdfs:label "intermediate_expressions" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:keys a owl:DatatypeProperty ;
    rdfs:label "keys" ;
    skos:definition "Named keys for multi-dimensional coupling. When dimension > 1, provides symbolic names for each index (e.g., keys: [lre, ffi] for dimension: 2). Used in equations as variable names." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:labels_ordering a owl:DatatypeProperty ;
    rdfs:label "labels_ordering" ;
    skos:definition "Ordering of dimensions: Time, State Variable, Space, Mode." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:local_states a owl:ObjectProperty ;
    rdfs:label "local_states" ;
    skos:definition "References to state variables from the local (target) node. Used by name in pre_expression." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:modes a owl:ObjectProperty ;
    rdfs:label "modes" ;
    skos:altLabel "components" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:nodes a owl:ObjectProperty ;
    rdfs:label "nodes" ;
    skos:definition "List of nodes with individual dynamics (optional, for heterogeneous networks)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:observational_measures a owl:DatatypeProperty ;
    rdfs:label "observational_measures" ;
    skos:definition "BEP017 measure names for observational targets (e.g., BoldCorrelation)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:operators a owl:ObjectProperty ;
    rdfs:label "operators" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:optimizations a owl:ObjectProperty ;
    rdfs:label "optimizations" ;
    skos:definition "Parameter optimization configurations" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:outsym a owl:DatatypeProperty ;
    rdfs:label "outsym" ;
    skos:definition "Output symbol names for the edge model. E.g. ['P'] for a scalar power flow, ['Fx', 'Fy'] for 2D forces. Maps directly to outsym in ND.jl EdgeModel. If not specified, derived from coupling variables of the connected vertex dynamics." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:pipeline a owl:ObjectProperty ;
    rdfs:label "pipeline" ;
    skos:definition "Ordered sequence of Functions. Each step has a unique `name` (used to key step outputs) and transforms input -> output. List form preserves execution order." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:requires a owl:ObjectProperty ;
    rdfs:label "requires" ;
    skos:definition "Observables required by this update rule" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:simulation_experiments a owl:ObjectProperty ;
    rdfs:label "simulation_experiments" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:prefLabel "experiments" .

<http://www.thevirtualbrain.org/tvb-o/software/SoftwarePackage> a owl:Class ;
    rdfs:label "SoftwarePackage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/repository> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/license> ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:EcosystemEnum ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/ecosystem> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/doi> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/license> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/homepage> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/doi> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/repository> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/license> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/repository> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/homepage> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/doi> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/ecosystem> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/software/homepage> ] ;
    skos:definition "Identity and metadata for a software package, aligned with schema.org/SoftwareApplication and CodeMeta v3." ;
    skos:exactMatch schema1:SoftwareApplication ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/author> a owl:DatatypeProperty ;
    rdfs:label "author" ;
    skos:definition "Original author(s) or creating organization(s)." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/citation> a owl:DatatypeProperty ;
    rdfs:label "citation" ;
    skos:definition "Additional citation strings or DOIs." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/ecosystem> a owl:ObjectProperty ;
    rdfs:label "ecosystem" ;
    skos:definition "Package ecosystem(s) through which the software is distributed." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/funder> a owl:DatatypeProperty ;
    rdfs:label "funder" ;
    skos:definition "Funding bodies or grants (e.g., 'EU H2020 945539', 'NIH R01...')." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/interoperates_with> a owl:ObjectProperty ;
    rdfs:label "interoperates_with" ;
    skos:definition "Tools this tool can exchange data with or delegate to." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/keywords> a owl:DatatypeProperty ;
    rdfs:label "keywords" ;
    skos:definition "Tags for topic-based discovery and clustering." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/maintainer> a owl:DatatypeProperty ;
    rdfs:label "maintainer" ;
    skos:definition "Current maintainer(s) or responsible organization(s)." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/model_paradigm> a owl:ObjectProperty ;
    rdfs:label "model_paradigm" ;
    skos:definition "Computational paradigms supported." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/modules> a owl:DatatypeProperty ;
    rdfs:label "modules" ;
    skos:definition "(Deprecated) Use environment.requirements list instead." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/operating_system> a owl:DatatypeProperty ;
    rdfs:label "operating_system" ;
    skos:definition "Supported operating systems (e.g., Linux, macOS, Windows)." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/programming_language> a owl:ObjectProperty ;
    rdfs:label "programming_language" ;
    skos:definition "Implementation languages." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/requirements> a owl:ObjectProperty ;
    rdfs:label "requirements" ;
    skos:definition "Constituent software requirements." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/runtime_platform> a owl:DatatypeProperty ;
    rdfs:label "runtime_platform" ;
    skos:definition "Execution backends or platforms (e.g., MPI, OpenMP, CUDA, JAX)." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/same_as> a owl:DatatypeProperty ;
    rdfs:label "same_as" ;
    skos:definition "URIs that unambiguously identify this tool (Wikidata, bio.tools, RRID, SciCrunch)." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/scale> a owl:ObjectProperty ;
    rdfs:label "scale" ;
    skos:definition "Spatial/organizational scales the tool operates at." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

<http://www.thevirtualbrain.org/tvb-o/software/tool_role> a owl:ObjectProperty ;
    rdfs:label "tool_role" ;
    skos:definition "Primary function(s) in a simulation workflow." ;
    skos:inScheme <https://w3id.org/tvbo/software> .

tvbo:source_observations a owl:ObjectProperty ;
    rdfs:label "source_observations" ;
    skos:definition "One or more observations to derive from. For transformations (e.g., fc from bold), use single source. For comparisons (e.g., fc_corr from fc and fc_target), use multiple sources. Order may matter for asymmetric operations." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:sources a owl:ObjectProperty ;
    rdfs:label "sources" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:space a owl:ObjectProperty ;
    rdfs:label "space" ;
    skos:definition "Ordered list of exploration axes spanning the search space. Each axis references an existing Parameter (by dotted name, e.g. \"ReducedWongWang.w\" or \"FastLinearCoupling.G\") and supplies the Range to sweep. No new Parameter is created here." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:stages a owl:ObjectProperty ;
    rdfs:label "stages" ;
    skos:definition "Ordered list of optimization stages. Stages run sequentially. Stage n+1 starts from optimized values of stage n. When defined, inherited single-stage fields are ignored." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:state a owl:ObjectProperty ;
    rdfs:label "state" ;
    skos:definition "Per-node initial state variable values, keyed by state variable name." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:state_wise_sigma a owl:DatatypeProperty ;
    rdfs:label "state_wise_sigma" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:structural_measures a owl:DatatypeProperty ;
    rdfs:label "structural_measures" ;
    skos:definition "BEP017 measure names for structural connectivity (e.g., streamlineCount, tractLength)" ;
    skos:inScheme <https://w3id.org/tvbo> .

<http://www.thevirtualbrain.org/tvb-o/study/Dataset> a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/bids_root> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/reference> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/bids_root> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/label> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/dataset_id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/subjects> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/conditions> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/reference> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/dataset_id> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/dataset_id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/reference> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/conditions> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/bids_root> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.thevirtualbrain.org/tvb-o/study/Subject> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/subjects> ] ;
    skos:definition "A collection of subjects for a multi-subject study. Provides the subject/session structure needed for workflow rendering. Optionally backed by a BIDS directory layout." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/conditions> a owl:DatatypeProperty ;
    rdfs:label "conditions" ;
    skos:definition "Global condition labels applied across all subjects (e.g., ['rest', 'task-nback', 'task-motor'])." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/empirical_data> a owl:DatatypeProperty ;
    rdfs:label "empirical_data" ;
    skos:definition "Paths to empirical recordings for this session (e.g., BOLD time series, MEG/EEG). Relative to dataset root." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

<http://www.thevirtualbrain.org/tvb-o/study/sessions> a owl:ObjectProperty ;
    rdfs:label "sessions" ;
    skos:definition "Data collection sessions for this subject. Each session can have its own network, empirical data, and conditions." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/study> .

tvbo:targets a owl:ObjectProperty ;
    rdfs:label "targets" ;
    skos:definition "State variables this noise applies to; if omitted, applies globally." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:transforms a owl:ObjectProperty ;
    rdfs:label "transforms" ;
    skos:definition "Ordered list of transforms applied to edge property matrices. Each Function's name identifies the target edge property (e.g. 'weight', 'length'). Supports equation-based (symbolic) or callable-based (software) transforms. Multiple transforms on the same target are applied sequentially." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:trigger_times a owl:DatatypeProperty ;
    rdfs:label "trigger_times" ;
    skos:definition "Predetermined trigger times for preset_time events. The solver will step exactly to these times." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:update_rules a owl:ObjectProperty ;
    rdfs:label "update_rules" ;
    skos:definition "How parameters are updated each iteration. When using 'includes', update_rules are inherited from included algorithms." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:vertex_to_region a owl:DatatypeProperty ;
    rdfs:label "vertex_to_region" ;
    skos:definition "Array mapping each vertex index to its parent region index. Can use dataLocation instead for large arrays." ;
    skos:inScheme <https://w3id.org/tvbo> .

