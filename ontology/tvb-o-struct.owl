            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty tvbo:iri ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Binding ;
            owl:onProperty tvbo:bindings ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:iri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Callable ;
            owl:onProperty tvbo:builder ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:parameters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:procedure ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty tvbo:directed ] ;
    skos:definition """Backend-agnostic graph generator specification.  Captures the mathematical family and its parameter declarations so that each backend can emit the correct constructor call (Graphs.jl, NetworkX, etc.) via per-backend ``bindings``; derived generators may also carry a symbolic ``procedure``.  The number of nodes is always taken from Network.number_of_nodes.
""" ;
    skos:exactMatch tvbo:GraphGenerator ;
    skos:inScheme <https://w3id.org/tvbo> .

<https://w3id.org/tvbo/GraphRepresentation#auto> a owl:Class ;
    rdfs:label "auto (GraphRepresentation)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:GraphRepresentation ;
    skos:definition "Select by connection density: use the sparse representation when the adjacency is sparse enough that edge-wise evaluation is cheaper than the dense product, dense otherwise. Default. Lets the backend apply its own crossover without the recipe hard-coding a data structure." ;
    skos:notation "auto" .

<https://w3id.org/tvbo/GraphRepresentation#dense> a owl:Class ;
    rdfs:label "dense (GraphRepresentation)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:GraphRepresentation ;
    skos:definition "Force the dense-adjacency representation. Preferred for densely connected or small networks, where dense linear algebra's constant-factor efficiency outweighs its nodes-squared scaling." ;
    skos:notation "dense" .

<https://w3id.org/tvbo/GraphRepresentation#sparse> a owl:Class ;
    rdfs:label "sparse (GraphRepresentation)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:GraphRepresentation ;
    skos:definition "Force the edge-list (sparse) representation. Preferred for large, sparsely connected networks (structural connectomes, power grids) where coupling cost then scales with the number of edges rather than nodes-squared." ;
    skos:notation "sparse" .

<https://w3id.org/tvbo/Hemisphere#both> a owl:Class ;
    rdfs:label "both (Hemisphere)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:Hemisphere ;
    skos:altLabel "B",
        "LR",
        "bilateral" ;
    skos:notation "both" .

<https://w3id.org/tvbo/Hemisphere#left> a owl:Class ;
    rdfs:label "left (Hemisphere)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:Hemisphere ;
    skos:altLabel "L",
        "lh" ;
    skos:notation "left" .

<https://w3id.org/tvbo/Hemisphere#right> a owl:Class ;
    rdfs:label "right (Hemisphere)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:Hemisphere ;
    skos:altLabel "R",
        "rh" ;
    skos:notation "right" .

<https://w3id.org/tvbo/ImagingModality#BOLD> a owl:Class ;
    rdfs:label "BOLD (ImagingModality)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ImagingModality ;
    skos:definition "Blood Oxygen Level Dependent signal." ;
    skos:notation "BOLD" .

<https://w3id.org/tvbo/ImagingModality#EEG> a owl:Class ;
    rdfs:label "EEG (ImagingModality)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:ImagingModality ;
    skos:definition "Electroencephalography." ;
