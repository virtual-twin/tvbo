tvbo:AlgorithmInclude a owl:Class ;
    rdfs:label "AlgorithmInclude" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:algorithm ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:arguments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:arguments ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:algorithm ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Algorithm ;
            owl:onProperty tvbo:algorithm ] ;
    skos:definition "Reference to an included algorithm with optional argument overrides. Allows combining algorithms with different hyperparameter values." ;
    skos:exactMatch tvbo:AlgorithmInclude ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:BidsEntities a owl:Class ;
    rdfs:label "BidsEntities" ;
