        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:target_parameter ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:target_parameter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:target_parameter ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:warmup ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Observation ;
            owl:onProperty tvbo:requires ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:bounds ] ;
    skos:definition "Defines how a parameter is updated based on observables. Represents iterative learning rules like FIC or EIB updates. Functions from experiment.functions are available in the equation." ;
    skos:exactMatch tvbo:UpdateRule ;
    skos:inScheme <https://w3id.org/tvbo> .

<https://w3id.org/tvbo/WorkflowDistributeBy#auto> a owl:Class ;
    rdfs:label "auto (WorkflowDistributeBy)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:WorkflowDistributeBy ;
    skos:definition "Vectorize every axis the backend can batch; fan out the rest." ;
    skos:notation "auto" .

<https://w3id.org/tvbo/WorkflowDistributeBy#vectorize> a owl:Class ;
    rdfs:label "vectorize (WorkflowDistributeBy)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:WorkflowDistributeBy ;
    skos:definition "Place all otherwise-unassigned axes on the vectorized tier." ;
    skos:notation "vectorize" .

<https://w3id.org/tvbo/WorkflowDistributeBy#workflow> a owl:Class ;
    rdfs:label "workflow (WorkflowDistributeBy)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:WorkflowDistributeBy ;
    skos:definition "Fan out all otherwise-unassigned axes as scheduler tasks." ;
    skos:notation "workflow" .

tvbo:additional_equations a owl:ObjectProperty ;
    rdfs:label "additional_equations (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "additional_equations" .

tvbo:affect_parameters a owl:DatatypeProperty ;
    rdfs:label "affect_parameters (slot)" ;
    skos:definition "Parameter symbols modifiable in the affect function." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "affect_parameters" .

tvbo:affect_states a owl:DatatypeProperty ;
    rdfs:label "affect_states (slot)" ;
    skos:definition "State variable symbols modifiable in the affect function." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "affect_states" .

tvbo:annotations a owl:ObjectProperty ;
    rdfs:label "annotations (slot)" ;
    skos:definition "Positioned text labels drawn on the panel (e.g. 'K≈272') — a declarative alternative to a custom callable." ;
    skos:inScheme tvbo:figure ;
    skos:notation "annotations" .

tvbo:args a owl:DatatypeProperty ;
    rdfs:label "args (slot)" ;
    skos:definition "Ordered parameter names passed to the callable." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "args" .

tvbo:authors a owl:DatatypeProperty ;
    rdfs:label "authors (slot)" ;
    skos:definition "Author display strings (full detail in references.bib)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "authors" .

tvbo:aux_data a owl:ObjectProperty ;
    rdfs:label "aux_data (slot)" ;
    skos:definition "Ordered list of auxiliary inputs the observation pipeline consumes. Examples: a Surface mesh's faces array, an empirical FC matrix on a reference Network, or another Observation's output. Resolved load-time eagerly; rendered code is self-contained." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "aux_data" .

tvbo:bindings a owl:ObjectProperty ;
    rdfs:label "bindings (slot)" ;
    skos:definition """Per-backend construction bindings, keyed by backend id (e.g. python, julia, networkx).  Each names the native library, callable and the ordered parameter names to pass.
""" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "bindings" .

tvbo:branches a owl:ObjectProperty ;
    rdfs:label "branches (slot)" ;
    skos:definition "Child branches to continue from detected bifurcation points (PO from Hopf, fold continuation, etc.)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "branches" .

tvbo:call_args a owl:ObjectProperty ;
    rdfs:label "call_args (slot)" ;
    skos:definition "Arguments passed when calling the instance (__call__). Usually the input data from simulation result. Example: result (simulation output array)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "call_args" .

tvbo:cases a owl:ObjectProperty ;
    rdfs:label "cases (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "cases" .

tvbo:code_modules a owl:DatatypeProperty ;
    rdfs:label "code_modules (slot)" ;
    skos:definition "Importable module names whose import registers this figure's custom panels / transforms (via bsplot.register_panel / register_transform). The emitted plot.py imports them, so a study ships its bespoke figure code in its code_source instead of in core tvbo. The modules must be importable when the figure renders (loading the study puts its code/ dir on the path)." ;
    skos:inScheme tvbo:figure ;
    skos:notation "code_modules" .

tvbo:condition_parameters a owl:DatatypeProperty ;
    rdfs:label "condition_parameters (slot)" ;
    skos:definition "Parameter symbols accessible in the condition function." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "condition_parameters" .

tvbo:condition_states a owl:DatatypeProperty ;
    rdfs:label "condition_states (slot)" ;
    skos:definition "State variable symbols accessible in the condition function. For edges, can include source/destination vertex outputs." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "condition_states" .

tvbo:conditionals a owl:ObjectProperty ;
    rdfs:label "conditionals (slot)" ;
    skos:definition "Conditional logic for piecewise equations." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "conditionals" .

tvbo:constructor_args a owl:ObjectProperty ;
    rdfs:label "constructor_args (slot)" ;
    skos:definition "Arguments passed to __init__ when instantiating the class. Example: period=1000.0, downsample_period=4.0 for Bold monitor." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "constructor_args" .

tvbo:container_binds a owl:DatatypeProperty ;
    rdfs:label "container_binds (slot)" ;
    skos:definition "Host paths that must be visible inside the container beyond the ones its runtime binds by default (typically ``$HOME`` and the working directory). Required whenever a task reads or writes a site filesystem outside those defaults — a shared cache, a data tree, or a scratch area a symlink resolves into. Rendered into each runtime's own flag (``--bind`` for Apptainer/Singularity)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "container_binds" .

tvbo:continuations a owl:ObjectProperty ;
    rdfs:label "continuations (slot)" ;
    skos:definition "Numerical continuation and bifurcation analysis specifications. Each entry defines a continuation experiment (equilibrium branch, codim-2 curve, periodic orbit family, etc.).            # Either reference a full reusable environment (preferred) or, for" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "continuations" .

tvbo:coordinates a owl:ObjectProperty ;
    rdfs:label "coordinates (slot)" ;
    skos:definition "Node coordinates (x,y,z) in the given coordinate space." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "coordinates" .

tvbo:coupling_inputs a owl:ObjectProperty ;
    rdfs:label "coupling_inputs (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "coupling_inputs" .

tvbo:coupling_terms a owl:ObjectProperty ;
    rdfs:label "coupling_terms (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "coupling_terms" .

<https://w3id.org/tvbo/dbs/Electrode> a owl:Class ;
    rdfs:label "Electrode (dbs)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/CommonCoordinateSpace> ;
            owl:onProperty <https://w3id.org/tvbo/dbs/coordinate_space> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/hemisphere> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/dbs/model> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/manufacturer> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/tail> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/trajectory> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            owl:onProperty <https://w3id.org/tvbo/dbs/tail> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/tail> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/recon_path> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/model> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/ParcellationEntity> ;
            owl:onProperty <https://w3id.org/tvbo/dbs/target_structure> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/contacts> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/hemisphere> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/target_structure> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/target_structure> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/dbs/manufacturer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            owl:onProperty <https://w3id.org/tvbo/dbs/head> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/coordinate_space> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            owl:onProperty <https://w3id.org/tvbo/dbs/trajectory> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/model> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/electrode_id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tvbo/dbs/Contact> ;
            owl:onProperty <https://w3id.org/tvbo/dbs/contacts> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/coordinate_space> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/head> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/dbs/recon_path> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/dbs/hemisphere> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/manufacturer> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/electrode_id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/head> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/dbs/recon_path> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/dbs/electrode_id> ] ;
    skos:definition "Implanted DBS electrode and contact geometry." ;
    skos:inScheme tvbo:dbs ;
    skos:notation "Electrode" .

<https://w3id.org/tvbo/dbs/active_contacts> a owl:DatatypeProperty ;
    rdfs:label "active_contacts (dbs)" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "active_contacts" .

<https://w3id.org/tvbo/dbs/clinical_improvement> a owl:ObjectProperty ;
    rdfs:label "clinical_improvement (dbs)" ;
    skos:definition "Observed improvement relative to baseline based on a defined score." ;
    skos:inScheme tvbo:dbs ;
    skos:notation "clinical_improvement" .

<https://w3id.org/tvbo/dbs/clinical_scores> a owl:ObjectProperty ;
    rdfs:label "clinical_scores (dbs)" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "clinical_scores" .

<https://w3id.org/tvbo/dbs/contacts> a owl:ObjectProperty ;
    rdfs:label "contacts (dbs)" ;
    skos:definition "List of physical contacts along the electrode" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "contacts" .

<https://w3id.org/tvbo/dbs/electrodes> a owl:ObjectProperty ;
    rdfs:label "electrodes (dbs)" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "electrodes" .

<https://w3id.org/tvbo/dbs/protocols> a owl:ObjectProperty ;
    rdfs:label "protocols (dbs)" ;
    skos:definition "All DBS protocols assigned to this subject." ;
    skos:inScheme tvbo:dbs ;
    skos:notation "protocols" .

<https://w3id.org/tvbo/dbs/settings> a owl:ObjectProperty ;
    rdfs:label "settings (dbs)" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "settings" .

<https://w3id.org/tvbo/dbs/trajectory> a owl:ObjectProperty ;
    rdfs:label "trajectory (dbs)" ;
    skos:definition "The planned trajectory for electrode implantation" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "trajectory" .

tvbo:dimension_labels a owl:DatatypeProperty ;
    rdfs:label "dimension_labels (slot)" ;
    skos:definition "Ordered labels for the matrix columns (dim-1) when the matrix is non-square.  Row labels (dim-0) are the parent Network's node labels.  Stored as HDF5 dimension scales in the companion file." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "dimension_labels" .

tvbo:edge_matrix_files a owl:ObjectProperty ;
    rdfs:label "edge_matrix_files (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "edge_matrix_files" .

tvbo:edges a owl:ObjectProperty ;
    rdfs:label "edges (slot)" ;
    skos:definition "List of directed edges with coupling references (optional, for explicit edge definition)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "edges" .

tvbo:env a owl:ObjectProperty ;
    rdfs:label "env (slot)" ;
    skos:definition "Environment variables exported before the task command on every engine (e.g. XLA_PYTHON_CLIENT_PREALLOCATE=false). An ordered list of {name, value}; values are shell-quoted at emit time." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "env" .

tvbo:explorations a owl:ObjectProperty ;
    rdfs:label "explorations (slot)" ;
    skos:definition "Parameter exploration/grid search specifications" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "explorations" .

tvbo:figures a owl:ObjectProperty ;
    rdfs:label "figures (slot)" ;
    skos:definition "Declarative Figure specs rendered from this study's experiment results — closes the replication loop (a study is its experiments plus the figures that read them)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "figures" .

tvbo:freeze_parameters a owl:ObjectProperty ;
    rdfs:label "freeze_parameters (slot)" ;
    skos:definition "Parameters from previous stages to freeze (keep at optimized value but not update)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "freeze_parameters" .

tvbo:groups a owl:DatatypeProperty ;
    rdfs:label "groups (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "groups" .

tvbo:height_ratios a owl:DatatypeProperty ;
    rdfs:label "height_ratios (slot)" ;
    skos:definition "Relative heights of the mosaic rows, e.g. [1.15, 1, 1, 1] to make the top panel taller. Length = number of rows." ;
    skos:inScheme tvbo:figure ;
    skos:notation "height_ratios" .

tvbo:includes a owl:ObjectProperty ;
    rdfs:label "includes (slot)" ;
    skos:definition "Include update rules from other algorithms with optional argument overrides. Unlike depends_on (sequential), includes means combined execution. Example: includes: [{algorithm: fic, arguments: [{name: eta, value: 0.1}]}]" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "includes" .

tvbo:incoming_states a owl:ObjectProperty ;
    rdfs:label "incoming_states (slot)" ;
    skos:definition "References to state variables from connected (source) nodes. Auto-populated from state_variables with coupling_variable=true when omitted. Used by name in pre_expression." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "incoming_states" .

tvbo:inferences a owl:ObjectProperty ;
    rdfs:label "inferences (slot)" ;
    skos:altLabel "inference" ;
    skos:definition "Bayesian inference configurations (posterior over parameters given an observation, via MCMC). Keyed by name, like optimizations." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "inferences" .

tvbo:inputs a owl:ObjectProperty ;
    rdfs:label "inputs (slot)" ;
    skos:definition "Per-input fingerprints for cache invalidation. Each entry records the IRI + dotted-field path of an ``aux_data`` reference plus the (mtime, size, sha256) of the underlying file at the time the artifact was produced. A downstream cache hit requires every fingerprint to match the current file state." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "inputs" .

tvbo:intermediate_expressions a owl:ObjectProperty ;
    rdfs:label "intermediate_expressions (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "intermediate_expressions" .

tvbo:keys a owl:DatatypeProperty ;
    rdfs:label "keys (slot)" ;
    skos:definition "Named keys for multi-dimensional coupling. When dimension > 1, provides symbolic names for each index (e.g., keys: [lre, ffi] for dimension: 2). Used in equations as variable names." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "keys" .

tvbo:labels_ordering a owl:DatatypeProperty ;
    rdfs:label "labels_ordering (slot)" ;
    skos:definition "Ordering of dimensions: Time, State Variable, Space, Mode." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "labels_ordering" .

tvbo:layers a owl:ObjectProperty ;
    rdfs:label "layers (slot)" ;
    skos:definition "Marks sharing this panel's axes (overlay). Grammar kinds only." ;
    skos:inScheme tvbo:figure ;
    skos:notation "layers" .

tvbo:local_states a owl:ObjectProperty ;
    rdfs:label "local_states (slot)" ;
    skos:definition "References to state variables from the local (target) node. Used by name in pre_expression." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "local_states" .

tvbo:measure_specs a owl:ObjectProperty ;
    rdfs:label "measure_specs (slot)" ;
    skos:definition "Optional per-measure metadata (Cognitive Atlas IRIs, units, description). When present, each entry's ``name`` must match an entry in ``measures``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "measure_specs" .

tvbo:measures a owl:DatatypeProperty ;
    rdfs:label "measures (slot)" ;
    skos:definition "Names of the measures present in the h5 companion (one ``measures/<name>`` dataset per name). Example: ``[g_factor, PMAT24_A_CR, PMAT24_A_RTCR, CardSort_Unadj, ProcSpeed_Unadj]``." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "measures" .

tvbo:modes a owl:ObjectProperty ;
    rdfs:label "modes (slot)" ;
    skos:altLabel "components" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "modes" .

tvbo:modules a owl:DatatypeProperty ;
    rdfs:label "modules (slot)" ;
    skos:definition "Environment modules to load before running (module load …)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "modules" .

tvbo:objectives a owl:DatatypeProperty ;
    rdfs:label "objectives (slot)" ;
    skos:definition "Names of observations minimised by an adaptive `strategy` (e.g. 'nsga2'). Each entry references an existing observation already framed lower-is-better (e.g. `one_minus_fc`, `psd_mae`). Count sets the semantics: 0 → pure sweep (use `record`), 1 → single-objective, ≥2 → multi-objective / Pareto. Ignored when strategy is 'grid'. Forward-compatible with `Search.objectives`." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "objectives" .

tvbo:observational_measures a owl:DatatypeProperty ;
    rdfs:label "observational_measures (slot)" ;
    skos:definition "BEP017 measure names for observational targets (e.g., BoldCorrelation)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "observational_measures" .

tvbo:operators a owl:ObjectProperty ;
    rdfs:label "operators (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "operators" .

tvbo:optimizations a owl:ObjectProperty ;
    rdfs:label "optimizations (slot)" ;
    skos:altLabel "optimization" ;
    skos:definition "Parameter optimization configurations" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "optimizations" .

tvbo:outsym a owl:DatatypeProperty ;
    rdfs:label "outsym (slot)" ;
    skos:definition "Output symbol names for the edge model. E.g. ['P'] for a scalar power flow, ['Fx', 'Fy'] for 2D forces. Maps directly to outsym in ND.jl EdgeModel. If not specified, derived from coupling variables of the connected vertex dynamics." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "outsym" .

tvbo:panels a owl:ObjectProperty ;
    rdfs:label "panels (slot)" ;
    skos:definition "Panels keyed by their mosaic label." ;
    skos:inScheme tvbo:figure ;
    skos:notation "panels" .

tvbo:pipeline a owl:ObjectProperty ;
    rdfs:label "pipeline (slot)" ;
    skos:definition "Ordered sequence of Functions. Each step has a unique `name` (used to key step outputs) and transforms input -> output. List form preserves execution order." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "pipeline" .

tvbo:priors a owl:ObjectProperty ;
    rdfs:label "priors (slot)" ;
    skos:definition "Priors over the inferred parameters, keyed by each parameter's dotted name (e.g. \"Generic2dOscillator.eta\" or \"PulseInput.amplitude\"). The KEYS are the inferred parameters — there is no separate free-parameter list." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "priors" .

tvbo:regions a owl:DatatypeProperty ;
    rdfs:label "regions (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "regions" .

tvbo:requires a owl:ObjectProperty ;
    rdfs:label "requires (slot)" ;
    skos:definition "Observables required by this update rule" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "requires" .

tvbo:sel a owl:ObjectProperty ;
    rdfs:label "sel (slot)" ;
    skos:definition "SLICE: label-based selector (xarray ``.sel``), keyed by dimension (reuses ``Argument``; name = dim, value = coordinate label), taking the nearest coordinate for a numeric selection. Never positional — picks e.g. one operating point out of a swept branch by its parameter value." ;
    skos:inScheme tvbo:common ;
    skos:notation "sel" .

tvbo:setup a owl:DatatypeProperty ;
    rdfs:label "setup (slot)" ;
    skos:definition "Shell lines run verbatim before the task command, after ``set -euo pipefail`` and any module/venv activation. The general hook for environment setup the typed fields do not cover, e.g. activating a conda env (``conda activate <name>``), sourcing a profile, or exporting a computed path. Ordered; each line is emitted as-is." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "setup" .

tvbo:simulation_experiments a owl:ObjectProperty ;
    rdfs:label "simulation_experiments (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "simulation_experiments" ;
    skos:prefLabel "experiments" .

<https://w3id.org/tvbo/software/SoftwarePackage> a owl:Class ;
    rdfs:label "SoftwarePackage (software)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/software/repository> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://w3id.org/tvbo/software/homepage> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/software/homepage> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/software/license> ],
