    skos:definition "A reproducible software environment aggregating one or more SoftwareRequirement entries. Used by SimulationExperiment to specify the execution context." ;
    skos:inScheme tvbo:software ;
    skos:notation "SoftwareEnvironment" ;
    skos:note "An environment aggregates one or more SoftwareRequirement entries.",
        "Use SimulationExperiment.environment to reference a reusable environment." .

