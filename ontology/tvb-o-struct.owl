@prefix UO: <http://purl.obolibrary.org/obo/UO_> .
@prefix biotools: <https://bio.tools/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sio: <http://semanticscience.org/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tvbo: <http://www.thevirtualbrain.org/tvb-o/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://uri.interlex.org/tgbugs/uris/readable/digitalIdentifier> a owl:DatatypeProperty ;
    rdfs:label "digitalIdentifier" ;
    rdfs:range xsd:string ;
    skos:definition "Add the digital identifier of this brain atlas or coordinate space version." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://www.thevirtualbrain.org/tvb-o/dbs/DBSDataset> a owl:Class ;
    rdfs:label "DBSDataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/coordinate_space> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/subjects> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.thevirtualbrain.org/tvb-o/dbs/ClinicalScore> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/clinical_scores> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/clinical_scores> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/CommonCoordinateSpace> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/coordinate_space> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.thevirtualbrain.org/tvb-o/dbs/DBSSubject> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/study/subjects> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/coordinate_space> ],
        <http://www.thevirtualbrain.org/tvb-o/study/Dataset> ;
    skos:definition "Collection of data related to a specific DBS study." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/id> a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:integer ;
    skos:definition "Surrogate integer key." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

tvbo:file a owl:DatatypeProperty ;
    rdfs:label "file" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/tvbo> .

<https://w3id.org/tvbo.owl.ttl> a owl:Ontology ;
    rdfs:label "tvb-datamodel" ;
    dcterms:license "https://spdx.org/licenses/EUPL-1.2" ;
    dcterms:title "The Virtual Brain Data Model" ;
    pav:version "0.4.0" ;
    skos:definition "Metadata schema for simulation studies using The Virtual Brain neuroinformatics platform or other dynamic network models of large-scale brain activity." .

<http://uri.interlex.org/tgbugs/uris/readable/BrainAtlas> a owl:Class ;
    rdfs:label "BrainAtlas" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/ParcellationTerminology> ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/terminology> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/CommonCoordinateSpace> ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/coordinateSpace> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/isVersionOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/abbreviation> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/author> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/terminology> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/isVersionOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/terminology> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/coordinateSpace> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/author> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/abbreviation> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/coordinateSpace> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/abbreviation> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/isVersionOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ] ;
    skos:definition "A schema for representing a version of a brain atlas." ;
    skos:exactMatch <http://uri.interlex.org/tgbugs/uris/readable/atlas/Atlas> ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/ParcellationTerminology> a owl:Class ;
    rdfs:label "ParcellationTerminology" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/entities> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/ontologyIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/ParcellationEntity> ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/entities> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/ontologyIdentifier> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/versionIdentifier> ] ;
    skos:definition "A schema for representing a parcellation terminology, which consists of parcellation entities." ;
    skos:exactMatch <http://uri.interlex.org/tgbugs/uris/readable/parcellationTerminology> ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

tvbo:LossFunction a owl:Class ;
    rdfs:label "LossFunction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:aggregate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:aggregate ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Aggregation ;
            owl:onProperty tvbo:aggregate ],
        tvbo:Function ;
    skos:definition "A loss function for optimization with optional aggregation. Extends Function with aggregation specification for per-element losses." ;
    skos:exactMatch tvbo:LossFunction ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:Provenance a owl:Class ;
    rdfs:label "Provenance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:date_created ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:references ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:derived_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:derived_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:references ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:generated_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:generated_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:license ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:date_created ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:derived_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:generated_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:date_created ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:license ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:license ] ;
    skos:definition "W3C PROV-O aligned provenance. Reusable on any entity (Network, TimeSeries, Dynamics, etc.)." ;
    skos:exactMatch prov:Entity ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:SimulationStudy a owl:Class ;
    rdfs:label "SimulationStudy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom tvbo:SimulationExperiment ;
            owl:onProperty tvbo:simulation_experiments ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:derived_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:derived_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:derived_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:year ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:sample ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:year ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Sample ;
            owl:onProperty tvbo:sample ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:simulation_experiments ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Dynamics ;
            owl:onProperty tvbo:model ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:sample ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:year ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:title ] ;
    skos:exactMatch tvbo:SimulationStudy ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:TemporalApplicableEquation a owl:Class ;
    rdfs:label "TemporalApplicableEquation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:time_dependent ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:parameters ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty tvbo:time_dependent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:parameters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:time_dependent ],
        tvbo:Equation ;
    skos:exactMatch tvbo:TemporalApplicableEquation ;
    skos:inScheme <https://w3id.org/tvbo> .

<http://www.thevirtualbrain.org/tvb-o/dbs/ClinicalImprovement> a owl:Class ;
    rdfs:label "ClinicalImprovement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/timepoint> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/evaluator> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/time_post_surgery> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/evaluator> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/percent_change> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/time_post_surgery> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/timepoint> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/baseline_value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/percent_change> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/timepoint> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/baseline_value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.thevirtualbrain.org/tvb-o/dbs/ClinicalScore> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/score> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/time_post_surgery> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/score> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/absolute_value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/baseline_value> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/percent_change> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/absolute_value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/score> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/absolute_value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/evaluator> ] ;
    skos:definition "Relative improvement on a defined clinical score." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/ClinicalScale> a owl:Class ;
    rdfs:label "ClinicalScale" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/domain> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/version> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/domain> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/domain> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/acronym> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/acronym> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/reference> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/reference> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/acronym> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/version> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/reference> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/name> ] ;
    skos:definition "A clinical assessment inventory or structured scale composed of multiple scores or items." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/Contact> a owl:Class ;
    rdfs:label "Contact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://uri.interlex.org/tgbugs/uris/readable/Coordinate> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/coordinate> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/contact_id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/label> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/contact_id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/coordinate> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/contact_id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/coordinate> ] ;
    skos:definition "Individual contact on a DBS electrode." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/DBSProtocol> a owl:Class ;
    rdfs:label "DBSProtocol" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/notes> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/timing_info> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.thevirtualbrain.org/tvb-o/dbs/Electrode> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/electrodes> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/notes> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/electrodes> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/clinical_improvement> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/settings> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.thevirtualbrain.org/tvb-o/dbs/ClinicalImprovement> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/clinical_improvement> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/timing_info> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/notes> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.thevirtualbrain.org/tvb-o/dbs/StimulationSetting> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/settings> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/timing_info> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ] ;
    skos:definition "A protocol describing DBS therapy, potentially bilateral or multi-lead." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/DBSSubject> a owl:Class ;
