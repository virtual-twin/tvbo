            owl:onProperty <https://w3id.org/tvbo/software/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/software/ecosystem> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/software/license> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/software/repository> ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:EcosystemEnum ;
            owl:onProperty <https://w3id.org/tvbo/software/ecosystem> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/software/homepage> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/software/license> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://w3id.org/tvbo/software/repository> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/software/doi> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/software/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/software/doi> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/software/doi> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/software/description> ] ;
    skos:definition "Identity and metadata for a software package, aligned with schema.org/SoftwareApplication and CodeMeta v3." ;
    skos:exactMatch schema1:SoftwareApplication ;
    skos:inScheme tvbo:software ;
    skos:notation "SoftwarePackage" .

<https://w3id.org/tvbo/software/author> a owl:DatatypeProperty ;
    rdfs:label "author (software)" ;
    skos:definition "Original author(s) or creating organization(s)." ;
    skos:inScheme tvbo:software ;
    skos:notation "author" .

<https://w3id.org/tvbo/software/citation> a owl:DatatypeProperty ;
    rdfs:label "citation (software)" ;
    skos:definition "Additional citation strings or DOIs." ;
    skos:inScheme tvbo:software ;
    skos:notation "citation" .

<https://w3id.org/tvbo/software/ecosystem> a owl:ObjectProperty ;
    rdfs:label "ecosystem (software)" ;
    skos:definition "Package ecosystem(s) through which the software is distributed." ;
    skos:inScheme tvbo:software ;
    skos:notation "ecosystem" .

<https://w3id.org/tvbo/software/funder> a owl:DatatypeProperty ;
    rdfs:label "funder (software)" ;
    skos:definition "Funding bodies or grants (e.g., 'EU H2020 945539', 'NIH R01...')." ;
    skos:inScheme tvbo:software ;
    skos:notation "funder" .

<https://w3id.org/tvbo/software/interoperates_with> a owl:ObjectProperty ;
    rdfs:label "interoperates_with (software)" ;
    skos:definition "Tools this tool can exchange data with or delegate to." ;
    skos:inScheme tvbo:software ;
    skos:notation "interoperates_with" .

<https://w3id.org/tvbo/software/keywords> a owl:DatatypeProperty ;
    rdfs:label "keywords (software)" ;
    skos:definition "Tags for topic-based discovery and clustering." ;
    skos:inScheme tvbo:software ;
    skos:notation "keywords" .

<https://w3id.org/tvbo/software/maintainer> a owl:DatatypeProperty ;
    rdfs:label "maintainer (software)" ;
    skos:definition "Current maintainer(s) or responsible organization(s)." ;
    skos:inScheme tvbo:software ;
    skos:notation "maintainer" .

<https://w3id.org/tvbo/software/model_paradigm> a owl:ObjectProperty ;
    rdfs:label "model_paradigm (software)" ;
    skos:definition "Computational paradigms supported." ;
    skos:inScheme tvbo:software ;
    skos:notation "model_paradigm" .

<https://w3id.org/tvbo/software/modules> a owl:DatatypeProperty ;
    rdfs:label "modules (software)" ;
    skos:definition "(Deprecated) Use environment.requirements list instead." ;
    skos:inScheme tvbo:software ;
    skos:notation "modules" .

<https://w3id.org/tvbo/software/operating_system> a owl:DatatypeProperty ;
    rdfs:label "operating_system (software)" ;
    skos:definition "Supported operating systems (e.g., Linux, macOS, Windows)." ;
    skos:inScheme tvbo:software ;
    skos:notation "operating_system" .

<https://w3id.org/tvbo/software/programming_language> a owl:ObjectProperty ;
    rdfs:label "programming_language (software)" ;
    skos:definition "Implementation languages." ;
    skos:inScheme tvbo:software ;
    skos:notation "programming_language" .

<https://w3id.org/tvbo/software/requirements> a owl:ObjectProperty ;
    rdfs:label "requirements (software)" ;
    skos:definition "Constituent software requirements." ;
    skos:inScheme tvbo:software ;
    skos:notation "requirements" .

<https://w3id.org/tvbo/software/runtime_platform> a owl:DatatypeProperty ;
    rdfs:label "runtime_platform (software)" ;
    skos:definition "Execution backends or platforms (e.g., MPI, OpenMP, CUDA, JAX)." ;
    skos:inScheme tvbo:software ;
    skos:notation "runtime_platform" .

<https://w3id.org/tvbo/software/same_as> a owl:DatatypeProperty ;
    rdfs:label "same_as (software)" ;
    skos:definition "URIs that unambiguously identify this tool (Wikidata, bio.tools, RRID, SciCrunch)." ;
    skos:inScheme tvbo:software ;
    skos:notation "same_as" .

<https://w3id.org/tvbo/software/scale> a owl:ObjectProperty ;
    rdfs:label "scale (software)" ;
    skos:definition "Spatial/organizational scales the tool operates at." ;
    skos:inScheme tvbo:software ;
    skos:notation "scale" .

<https://w3id.org/tvbo/software/tool_role> a owl:ObjectProperty ;
    rdfs:label "tool_role (software)" ;
    skos:definition "Primary function(s) in a simulation workflow." ;
    skos:inScheme tvbo:software ;
    skos:notation "tool_role" .

tvbo:sources a owl:ObjectProperty ;
    rdfs:label "sources (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "sources" .

tvbo:space a owl:ObjectProperty ;
    rdfs:label "space (slot)" ;
    skos:definition "Exploration axes spanning the search space, keyed by the dotted parameter reference each axis sweeps (e.g. \"ReducedWongWang.w\" or \"FastLinearCoupling.G\"). Insertion order is preserved and defines the grid axis order. Each axis references an existing Parameter and supplies the Range to sweep; no new Parameter is created here." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "space" .

tvbo:state a owl:ObjectProperty ;
    rdfs:label "state (slot)" ;
    skos:definition "Per-node initial state variable values, keyed by state variable name." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "state" .

tvbo:state_wise_sigma a owl:DatatypeProperty ;
    rdfs:label "state_wise_sigma (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "state_wise_sigma" .

tvbo:structural_measures a owl:DatatypeProperty ;
    rdfs:label "structural_measures (slot)" ;
    skos:definition "BEP017 measure names for structural connectivity (e.g., streamlineCount, tractLength)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "structural_measures" .

<https://w3id.org/tvbo/study/Dataset> a owl:Class ;
    rdfs:label "Dataset (study)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/reference> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/study/reference> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tvbo/study/Subject> ;
            owl:onProperty <https://w3id.org/tvbo/study/subjects> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/subjects> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/bundle> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/study/conditions> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/study/label> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/bundle> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/label> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/study/dataset_id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/study/bids_root> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty <https://w3id.org/tvbo/study/bundle> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/bids_root> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/dataset_id> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/dataset_id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tvbo/study/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/label> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/bids_root> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/tvbo/study/reference> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/tvbo/study/conditions> ] ;
    skos:definition "A collection of subjects for a multi-subject study. Provides the subject/session structure needed for workflow rendering. Optionally backed by a BIDS directory layout." ;
    skos:inScheme tvbo:study ;
    skos:notation "Dataset" .

<https://w3id.org/tvbo/study/conditions> a owl:DatatypeProperty ;
    rdfs:label "conditions (study)" ;
    skos:definition "Global condition labels applied across all subjects (e.g., ['rest', 'task-nback', 'task-motor'])." ;
    skos:inScheme tvbo:study ;
    skos:notation "conditions" .

<https://w3id.org/tvbo/study/empirical_data> a owl:DatatypeProperty ;
    rdfs:label "empirical_data (study)" ;
    skos:definition "Paths to empirical recordings for this session (e.g., BOLD time series, MEG/EEG). Relative to dataset root." ;
    skos:inScheme tvbo:study ;
    skos:notation "empirical_data" .

<https://w3id.org/tvbo/study/sessions> a owl:ObjectProperty ;
    rdfs:label "sessions (study)" ;
    skos:definition "Data collection sessions for this subject. Each session can have its own network, empirical data, and conditions." ;
    skos:inScheme tvbo:study ;
    skos:notation "sessions" .

<https://w3id.org/tvbo/study/subjects> a owl:ObjectProperty ;
    rdfs:label "subjects (study)" ;
    rdfs:range <https://w3id.org/tvbo/study/Subject> ;
    skos:definition "Subjects in a dataset." ;
    skos:inScheme tvbo:study ;
    skos:notation "subjects" .

tvbo:target_regions a owl:DatatypeProperty ;
    rdfs:label "target_regions (slot)" ;
    skos:definition "Regions a stimulus-type event targets: 'all' (broadcast to every node) or explicit region labels / indices. More expressive than the integer-only `regions` slot; when both are absent the event applies to all regions." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "target_regions" .

tvbo:targets a owl:ObjectProperty ;
    rdfs:label "targets (slot)" ;
    skos:definition "State variables this noise applies to; if omitted, applies globally." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "targets" .

tvbo:transforms a owl:ObjectProperty ;
    rdfs:label "transforms (slot)" ;
    skos:definition "Ordered list of transforms applied to edge property matrices. Each Function's name identifies the target edge property (e.g. 'weight', 'length'). Supports equation-based (symbolic) or callable-based (software) transforms. Multiple transforms on the same target are applied sequentially." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "transforms" .

tvbo:trigger_times a owl:DatatypeProperty ;
    rdfs:label "trigger_times (slot)" ;
    skos:definition "Predetermined trigger times for preset_time events. The solver will step exactly to these times." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "trigger_times" .

tvbo:update_rules a owl:ObjectProperty ;
    rdfs:label "update_rules (slot)" ;
    skos:definition "How parameters are updated each iteration. When using 'includes', update_rules are inherited from included algorithms." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "update_rules" .

tvbo:vectorize a owl:DatatypeProperty ;
    rdfs:label "vectorize (slot)" ;
    skos:definition "Axis names or parameters to pack into a single vectorized backend call. It is an error to name an axis the backend cannot batch." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "vectorize" .

tvbo:vertex_to_region a owl:DatatypeProperty ;
    rdfs:label "vertex_to_region (slot)" ;
    skos:definition "Array mapping each vertex index to its parent region index. Can use dataLocation instead for large arrays." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "vertex_to_region" .

tvbo:weighting a owl:DatatypeProperty ;
    rdfs:label "weighting (slot)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "weighting" .

tvbo:weights a owl:DatatypeProperty ;
    rdfs:label "weights (slot)" ;
    skos:altLabel "weighting" ;
    skos:definition "Per-node stimulus weighting, aligned with `nodes`. (Formerly `weighting`.)" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "weights" .

tvbo:width_ratios a owl:DatatypeProperty ;
    rdfs:label "width_ratios (slot)" ;
    skos:definition "Relative widths of the mosaic columns." ;
    skos:inScheme tvbo:figure ;
    skos:notation "width_ratios" .

tvbo:wrt a owl:DatatypeProperty ;
    rdfs:label "wrt (slot)" ;
    skos:definition "Quantity/quantities the analysis is taken with respect to, e.g. a parameter 'c_sigmJR.G' for a gradient/sensitivity. Omitted for analyses that need no explicit differentiation target." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:notation "wrt" .

<http://uri.interlex.org/tgbugs/uris/readable/anatomicalAxesOrientation> a owl:DatatypeProperty ;
    rdfs:label "anatomicalAxesOrientation" ;
    skos:definition "Add the axes orientation in standard anatomical terms (XYZ)." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/axesOrigin> a owl:DatatypeProperty ;
    rdfs:label "axesOrigin" ;
    skos:definition "Enter the origin (central point where all axes intersect)." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/center> a owl:ObjectProperty ;
    rdfs:label "center" ;
    skos:definition "Add the center coordinate of this entity." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/color> a owl:DatatypeProperty ;
    rdfs:label "color" ;
    skos:definition "Add the color code used for visual representation of this entity." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/hemisphere> a owl:ObjectProperty ;
    rdfs:label "hemisphere" ;
    skos:definition "Add the hemisphere of this entity." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/isVersionOf> a owl:DatatypeProperty ;
    rdfs:label "isVersionOf" ;
    skos:definition "Linked type for the version of a brain atlas or coordinate space." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/license> a owl:DatatypeProperty ;
    rdfs:label "license" ;
    skos:definition "Linked type for the license of the brain atlas or coordinate space version." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/lookupLabel> a owl:DatatypeProperty ;
    rdfs:label "lookupLabel" ;
    rdfs:range xsd:integer ;
    skos:definition "Enter the label used for looking up this entity in the parcellation terminology." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/nativeUnit> a owl:DatatypeProperty ;
    rdfs:label "nativeUnit" ;
    skos:definition "Add the native unit that is used for this common coordinate space version." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/originalLookupLabel> a owl:DatatypeProperty ;
    rdfs:label "originalLookupLabel" ;
    skos:definition "Add the original label of this entity as defined in the parcellation terminology." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/relatedUBERONTerm> a owl:DatatypeProperty ;
    rdfs:label "relatedUBERONTerm" ;
    skos:definition "Add the related anatomical entity as defined by the UBERON ontology." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/terminology> a owl:ObjectProperty ;
    rdfs:label "terminology" ;
    skos:definition "Add the parcellation terminology version used for this brain atlas version." ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/x> a owl:DatatypeProperty ;
    rdfs:label "x" ;
    skos:definition "X coordinate" ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/y> a owl:DatatypeProperty ;
    rdfs:label "y" ;
    skos:definition "Y coordinate" ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

<http://uri.interlex.org/tgbugs/uris/readable/z> a owl:DatatypeProperty ;
    rdfs:label "z" ;
    skos:definition "Z coordinate" ;
    skos:inScheme <https://openminds.ebrains.eu/sands/BrainAtlas> .

tvbo:AlgorithmCompositionMode a owl:Class ;
    rdfs:label "AlgorithmCompositionMode" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/AlgorithmCompositionMode#combined> <https://w3id.org/tvbo/AlgorithmCompositionMode#nested> ) ;
    skos:definition "How an included algorithm is composed with the outer algorithm. Determines whether the inner algorithm's update rules are merged into the same loop (combined) or run as a converging inner loop on each outer iteration (nested)." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/AlgorithmCompositionMode#combined>,
        <https://w3id.org/tvbo/AlgorithmCompositionMode#nested> .

tvbo:BidsEntities a owl:Class ;
    rdfs:label "BidsEntities" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:acquisition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:scale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:desc ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:reconstruction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:template ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:segmentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:template ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:desc ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:atlas ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:cohort ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:segmentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:desc ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:suffix ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:reconstruction ],
        [ a owl:Restriction ;
