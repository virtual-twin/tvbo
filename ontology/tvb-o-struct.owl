tvbo:FreeParameter a owl:Class ;
    rdfs:label "FreeParameter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:ScalarValue ;
            owl:onProperty tvbo:initial_value ],
