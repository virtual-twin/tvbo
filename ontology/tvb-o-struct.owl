<https://w3id.org/tvbo/AggregationType#first> a owl:Class ;
    rdfs:label "first (AggregationType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AggregationType ;
    skos:definition "First value in window" ;
    skos:notation "first" .

<https://w3id.org/tvbo/AggregationType#first_passage> a owl:Class ;
    rdfs:label "first_passage (AggregationType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AggregationType ;
    skos:definition "First-passage time index (per node): the first sample at which the source crosses the observation's `threshold` parameter (>=), or the sample count if it never crosses. Backend-independent (argmax of the threshold-crossing). Multiply by the sampling step for a time." ;
    skos:notation "first_passage" .

<https://w3id.org/tvbo/AggregationType#last> a owl:Class ;
    rdfs:label "last (AggregationType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AggregationType ;
    skos:definition "Last value in window" ;
    skos:notation "last" .

<https://w3id.org/tvbo/AggregationType#mean> a owl:Class ;
    rdfs:label "mean (AggregationType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AggregationType ;
    skos:definition "Average over time" ;
    skos:notation "mean" .

<https://w3id.org/tvbo/AggregationType#median> a owl:Class ;
    rdfs:label "median (AggregationType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AggregationType ;
    skos:definition "Median over time (per node). Robust to phase-slip / outlier samples that bias the mean. For an Observation.dynamics observer this is computed streaming: a per-node histogram (bins from the observation's `histogram` slot) is folded into the integrator carry and the 0.5 quantile is read at finalize, so no trajectory is held." ;
    skos:notation "median" .

<https://w3id.org/tvbo/AggregationType#none> a owl:Class ;
    rdfs:label "none (AggregationType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AggregationType ;
    skos:definition "No aggregation" ;
    skos:notation "none" .

<https://w3id.org/tvbo/AggregationType#std> a owl:Class ;
    rdfs:label "std (AggregationType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AggregationType ;
    skos:definition "Standard deviation over time (per node)" ;
    skos:notation "std" .

<https://w3id.org/tvbo/AggregationType#variance> a owl:Class ;
    rdfs:label "variance (AggregationType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AggregationType ;
    skos:definition "Variance over time (per node)" ;
    skos:notation "variance" .

<https://w3id.org/tvbo/AggregationType#window> a owl:Class ;
    rdfs:label "window (AggregationType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AggregationType ;
    skos:definition "Sliding window aggregation" ;
    skos:notation "window" .

<https://w3id.org/tvbo/AlgorithmCompositionMode#combined> a owl:Class ;
    rdfs:label "combined (AlgorithmCompositionMode)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AlgorithmCompositionMode ;
    skos:definition "The included algorithm's update rules are merged into the outer loop and applied ONCE per outer iteration (1:1). Use when both algorithms update at the same cadence on the same observations. This is the default." ;
    skos:notation "combined" .

<https://w3id.org/tvbo/AlgorithmCompositionMode#nested> a owl:Class ;
    rdfs:label "nested (AlgorithmCompositionMode)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AlgorithmCompositionMode ;
    skos:definition "The included algorithm runs as a full inner loop on EACH outer iteration, re-converging before the outer update rules are applied. Use when the inner algorithm maintains an invariant the outer one would otherwise perturb — e.g. FIC holding the E-I working point (mean S_e = 0.25) while EIB retunes per-edge coupling. The outer update's validity depends on that invariant, so the inner loop must re-settle it between every outer step." ;
    skos:notation "nested" .

tvbo:AlgorithmInclude a owl:Class ;
    rdfs:label "AlgorithmInclude" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:algorithm ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:inner_iterations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:algorithm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:mode ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:arguments ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:AlgorithmCompositionMode ;
            owl:onProperty tvbo:mode ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Algorithm ;
            owl:onProperty tvbo:algorithm ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:inner_iterations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:arguments ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:inner_iterations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:mode ] ;
    skos:definition "Reference to an included algorithm with optional argument overrides. Allows combining algorithms with different hyperparameter values." ;
    skos:exactMatch tvbo:AlgorithmInclude ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:AlgorithmStage a owl:Class ;
    rdfs:label "AlgorithmStage" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:arguments ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:n_iterations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:n_iterations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:n_iterations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:arguments ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:label ] ;
    skos:definition "One stage of a multi-stage tuning schedule. The algorithm body is run once per stage, in order, carrying the trajectory state, FC window buffer, and monitors forward — so the stages form one continuous online tuning run. Each stage overrides n_iterations and selected hyperparameters (e.g. Schirner 2023's 6 stages: eta halves and the FC window doubles per stage, sharpening the per-edge gradient over time)." ;
    skos:exactMatch tvbo:AlgorithmStage ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:Analysis a owl:Class ;
    rdfs:label "Analysis" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:wrt ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:target ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:wrt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:target ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:parameters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:target ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:parameters ] ;
    skos:definition "A general analysis observable: a quantity obtained by ANALYZING the model, its solve, or a derived loss, rather than by transforming the recorded trajectory. It is deliberately broad — the same concept covers parameter sensitivities/gradients (autodiff or finite-difference), stability spectra (Lyapunov), bifurcation quantities, identifiability/Fisher-information metrics, and future analyses. `type` names the analysis (extensible); `target` and `wrt` bind it to what is analyzed and with respect to what; `parameters` carries the analysis-specific configuration. Backend-neutral: each backend maps `type` to its own machinery, or emits a comment and skips when it has no equivalent (it does not raise)." ;
    skos:exactMatch tvbo:Analysis ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:AxisReduction a owl:Class ;
    rdfs:label "AxisReduction" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:statistic ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:AxisReductionStatistic ;
            owl:onProperty tvbo:statistic ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:statistic ] ;
    skos:definition "Marks an exploration/sweep axis to be collapsed by a statistic in the result container. When set on an ExplorationAxis, that axis's named grid dimension is reduced across every observation that carries it (e.g. an `execution.random_seed` trial ensemble becomes a first-class reduced observation). Backend-independent: states the reduction intent; the result layer applies it by dimension name." ;
    skos:exactMatch tvbo:AxisReduction ;
    skos:inScheme <https://w3id.org/tvbo> .

<https://w3id.org/tvbo/AxisReductionStatistic#mean> a owl:Class ;
    rdfs:label "mean (AxisReductionStatistic)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AxisReductionStatistic ;
    skos:definition "Arithmetic mean across the axis." ;
    skos:notation "mean" .

<https://w3id.org/tvbo/AxisReductionStatistic#median> a owl:Class ;
    rdfs:label "median (AxisReductionStatistic)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AxisReductionStatistic ;
    skos:definition "Median across the axis." ;
    skos:notation "median" .

<https://w3id.org/tvbo/AxisReductionStatistic#sem> a owl:Class ;
    rdfs:label "sem (AxisReductionStatistic)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AxisReductionStatistic ;
    skos:definition "Standard error of the mean: std across the axis divided by sqrt(n)." ;
    skos:notation "sem" .

<https://w3id.org/tvbo/AxisReductionStatistic#std> a owl:Class ;
    rdfs:label "std (AxisReductionStatistic)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AxisReductionStatistic ;
    skos:definition "Standard deviation across the axis." ;
    skos:notation "std" .

<https://w3id.org/tvbo/AxisReductionStatistic#sum> a owl:Class ;
    rdfs:label "sum (AxisReductionStatistic)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:AxisReductionStatistic ;
    skos:definition "Sum across the axis." ;
    skos:notation "sum" .

tvbo:Binding a owl:Class ;
    rdfs:label "Binding" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:library ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:args ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:library ],
        [ a owl:Restriction ;
