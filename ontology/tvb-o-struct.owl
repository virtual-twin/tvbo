    rdfs:label "SamplingAxis" ;
    owl:unionOf ( <http://www.thevirtualbrain.org/tvb-o/SamplingAxis#space> <http://www.thevirtualbrain.org/tvb-o/SamplingAxis#time> ) ;
    skos:definition "Dimension along which a distribution is sampled." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <http://www.thevirtualbrain.org/tvb-o/SamplingAxis#space>,
        <http://www.thevirtualbrain.org/tvb-o/SamplingAxis#time> .

tvbo:Stimulus a owl:Class ;
    rdfs:label "Stimulus" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty tvbo:regions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:regions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:weighting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Equation ;
            owl:onProperty tvbo:equation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty tvbo:duration ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:parameters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:duration ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:weighting ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://uri.interlex.org/tgbugs/uris/readable/dataLocation> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:duration ],
        [ a owl:Restriction ;
            owl:allValuesFrom tvbo:Parameter ;
            owl:onProperty tvbo:parameters ] ;
    skos:exactMatch tvbo:Stimulus ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:SystemType a owl:Class ;
    rdfs:label "SystemType" ;
    owl:unionOf ( <http://www.thevirtualbrain.org/tvb-o/SystemType#continuous> <http://www.thevirtualbrain.org/tvb-o/SystemType#discrete> ) ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <http://www.thevirtualbrain.org/tvb-o/SystemType#continuous>,
        <http://www.thevirtualbrain.org/tvb-o/SystemType#discrete> .

tvbo:accelerator a owl:DatatypeProperty ;
    rdfs:label "accelerator" ;
    skos:definition "Hardware accelerator: 'cpu', 'gpu', 'tpu'" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:additive a owl:DatatypeProperty ;
    rdfs:label "additive" ;
    skos:definition "Indicates whether the noise is additive" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:affect a owl:ObjectProperty ;
    rdfs:label "affect" ;
    skos:definition "Affect function: what happens when the event triggers. Can modify state variables and/or parameters. For stimulus type, this is the stimulus equation." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:affect_negative a owl:ObjectProperty ;
    rdfs:label "affect_negative" ;
    skos:definition "Affect on downcrossing (continuous events only). If not specified, uses the same affect for both crossings." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:apply_every a owl:DatatypeProperty ;
    rdfs:label "apply_every" ;
    skos:definition "Apply update every N iterations" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:autonomous a owl:DatatypeProperty ;
    rdfs:label "autonomous" ;
    skos:definition "Whether the system is autonomous (equations do not depend explicitly on time t). Non-autonomous systems have explicit time dependence, e.g. f*cos(omega*t)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:average a owl:DatatypeProperty ;
    rdfs:label "average" ;
    skos:definition "Averaging mode across trials. 'trials' = average over n_trials independent runs (evoked potential paradigm). None = return all trials." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:axis a owl:ObjectProperty ;
    rdfs:label "axis" ;
    skos:definition "Dimension along which the distribution is sampled. 'space' = per-node (default), 'time' = per-timestep (stochastic input)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:batch_size a owl:DatatypeProperty ;
    rdfs:label "batch_size" ;
    skos:definition "Batch size for vectorized operations (None = auto)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:bc_type a owl:ObjectProperty ;
    rdfs:label "bc_type" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:bids a owl:ObjectProperty ;
    rdfs:label "bids" ;
    skos:definition "BIDS filename entities for this dataset" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:bids_dir a owl:DatatypeProperty ;
    rdfs:label "bids_dir" ;
    skos:definition "Path to BEP017-compliant BIDS directory for loading connectivity matrices" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:boundaries a owl:ObjectProperty ;
    rdfs:label "boundaries" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:bounds a owl:ObjectProperty ;
    rdfs:label "bounds" ;
    skos:definition "Constraints on parameter values after update" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:class_call a owl:ObjectProperty ;
    rdfs:label "class_call" ;
    skos:definition "Class instantiation and call (alternative to callable/function). Use for external library classes that need __init__ then __call__. Example: Bold monitor from tvboptim." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:class_reference a owl:ObjectProperty ;
    rdfs:label "class_reference" ;
    skos:definition "Direct class reference (alternative to pipeline). Use for external library classes like tvboptim.Bold, custom monitors, or any callable class. The class is instantiated with constructor_args and called with call_args. Example: {name: Bold, module: tvboptim.observations.tvb_monitors.bold, constructor_args: [{name: period, value: 1000.0}]}" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:coefficient a owl:ObjectProperty ;
    rdfs:label "coefficient" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:cohort a owl:DatatypeProperty ;
    rdfs:label "cohort" ;
    skos:definition "BIDS cohort- entity (e.g., HCPYA, PPMI85)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:comment a owl:DatatypeProperty ;
    rdfs:label "comment" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:conditional a owl:DatatypeProperty ;
    rdfs:label "conditional" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:connectivity a owl:ObjectProperty ;
    rdfs:label "connectivity" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:connectivity_ref a owl:DatatypeProperty ;
    rdfs:label "connectivity_ref" ;
    skos:definition "Reference to connectivity data (_conndata-network_connectivity.tsv)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:continuation a owl:ObjectProperty ;
    rdfs:label "continuation" ;
    skos:definition "Override solver settings for this branch. Uses the same Continuation type — only explicitly set attributes override the parent's values." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:correlated a owl:DatatypeProperty ;
    rdfs:label "correlated" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:correlation a owl:ObjectProperty ;
    rdfs:label "correlation" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:coupling_function a owl:ObjectProperty ;
    rdfs:label "coupling_function" ;
    skos:definition "Mathematical function defining the coupling" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:coupling_variable a owl:DatatypeProperty ;
    rdfs:label "coupling_variable" ;
    skos:definition "Whether this state variable is transmitted to connected nodes through the coupling function. In TVB terms, this determines the cvar indices (state variables extracted from history and fed into the coupling function). The coupling function may override this via its incoming_states attribute." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:data a owl:ObjectProperty ;
    rdfs:label "data" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:dataLocation a owl:DatatypeProperty ;
    rdfs:label "dataLocation" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:data_file a owl:DatatypeProperty ;
    rdfs:label "data_file" ;
    skos:definition "Path to companion data file. Supported extensions: .h5 (HDF5), .zarr/ (Zarr), .csv (legacy single-matrix). Null if no companion data needed." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:dataset a owl:ObjectProperty ;
    rdfs:label "dataset" ;
    skos:definition "Multi-subject dataset for workflow rendering. When set, render_workflow() uses dataset.subjects/sessions to generate per-subject parallel jobs." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:dataset_path a owl:DatatypeProperty ;
    rdfs:label "dataset_path" ;
    rdfs:range xsd:string ;
    skos:definition "Dataset path for array-valued parameters. When set, the parameter value is stored in the binary companion file (HDF5 or Zarr) at this path. The value slot is omitted." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:date_created a owl:DatatypeProperty ;
    rdfs:label "date_created" ;
    skos:definition "ISO 8601 (prov:generatedAtTime)" ;
    skos:inScheme <https://w3id.org/tvbo> .

<http://www.thevirtualbrain.org/tvb-o/dbs/ClinicalScore> a owl:Class ;
    rdfs:label "ClinicalScore" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/domain> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/acronym> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/parent_score> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/parent_score> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/scale> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/acronym> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/reference> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.thevirtualbrain.org/tvb-o/dbs/ClinicalScore> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/parent_score> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/acronym> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.thevirtualbrain.org/tvb-o/dbs/ClinicalScale> ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/scale> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/reference> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/domain> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/domain> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/scale> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/reference> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://www.thevirtualbrain.org/tvb-o/dbs/name> ] ;
    skos:definition "Metadata about a clinical score or scale." ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/absolute_value> a owl:DatatypeProperty ;
    rdfs:label "absolute_value" ;
    skos:definition "Absolute value of the score at the time of assessment" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/amplitude> a owl:ObjectProperty ;
    rdfs:label "amplitude" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/baseline_value> a owl:DatatypeProperty ;
    rdfs:label "baseline_value" ;
    skos:definition "Preoperative baseline value of the score" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/contact_id> a owl:DatatypeProperty ;
    rdfs:label "contact_id" ;
    skos:definition "Identifier (e.g., 0, 1, 2)" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/coordinate> a owl:ObjectProperty ;
    rdfs:label "coordinate" ;
    skos:definition "3D coordinate of the contact center in the defined coordinate space" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/description> a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/diagnosis> a owl:DatatypeProperty ;
    rdfs:label "diagnosis" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/efield> a owl:ObjectProperty ;
    rdfs:label "efield" ;
    skos:definition "Metadata about the E-field result for this setting" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/electrode_id> a owl:DatatypeProperty ;
    rdfs:label "electrode_id" ;
    skos:definition "Unique identifier for this electrode" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/electrode_reference> a owl:ObjectProperty ;
    rdfs:label "electrode_reference" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/evaluator> a owl:DatatypeProperty ;
    rdfs:label "evaluator" ;
    skos:definition "Who performed the rating (e.g., rater initials, clinician ID, or system)" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/frequency> a owl:ObjectProperty ;
    rdfs:label "frequency" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/handedness> a owl:DatatypeProperty ;
    rdfs:label "handedness" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/head> a owl:ObjectProperty ;
    rdfs:label "head" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/hemisphere> a owl:DatatypeProperty ;
    rdfs:label "hemisphere" ;
    skos:definition "Hemisphere of electrode (left/right)" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/label> a owl:DatatypeProperty ;
    rdfs:label "label" ;
    skos:definition "Optional human-readable label (e.g., \"1a\")" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/manufacturer> a owl:DatatypeProperty ;
    rdfs:label "manufacturer" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/mode> a owl:DatatypeProperty ;
    rdfs:label "mode" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/model> a owl:DatatypeProperty ;
    rdfs:label "model" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/notes> a owl:DatatypeProperty ;
    rdfs:label "notes" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/parent_score> a owl:ObjectProperty ;
    rdfs:label "parent_score" ;
    skos:definition "If this score is a subscore of a broader composite" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/percent_change> a owl:DatatypeProperty ;
    rdfs:label "percent_change" ;
    skos:definition "Percent change compared to preoperative baseline (positive = improvement)" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/pulse_width> a owl:ObjectProperty ;
    rdfs:label "pulse_width" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/recon_path> a owl:DatatypeProperty ;
    rdfs:label "recon_path" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/scale> a owl:ObjectProperty ;
    rdfs:label "scale" ;
    skos:definition "The scale this score belongs to, if applicable" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/score> a owl:ObjectProperty ;
    rdfs:label "score" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/tail> a owl:ObjectProperty ;
    rdfs:label "tail" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/target_structure> a owl:ObjectProperty ;
    rdfs:label "target_structure" ;
    skos:definition "Anatomical target structure from a brain atlas" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/threshold_applied> a owl:DatatypeProperty ;
    rdfs:label "threshold_applied" ;
    skos:definition "Threshold value applied to the E-field simulation" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/time_post_surgery> a owl:DatatypeProperty ;
    rdfs:label "time_post_surgery" ;
    skos:definition "Timepoint of assessment in days or months after implantation" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/timepoint> a owl:DatatypeProperty ;
    rdfs:label "timepoint" ;
    skos:definition "Timepoint of assessment (e.g., \"1 month post-op\", \"6 months post-op\")" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/timing_info> a owl:DatatypeProperty ;
    rdfs:label "timing_info" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/version> a owl:DatatypeProperty ;
    rdfs:label "version" ;
    skos:definition "Version of the instrument (e.g., 3.0)" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

<http://www.thevirtualbrain.org/tvb-o/dbs/volume_data> a owl:DatatypeProperty ;
    rdfs:label "volume_data" ;
    skos:definition "Reference to raw or thresholded volume" ;
    skos:inScheme <http://www.thevirtualbrain.org/tvbo/dbs> .

tvbo:default a owl:DatatypeProperty ;
    rdfs:label "default" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:degree a owl:DatatypeProperty ;
    rdfs:label "degree" ;
    skos:definition "Polynomial degree per mesh interval for collocation. The m in PeriodicOrbitOCollProblem(N, m)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:delay a owl:DatatypeProperty ;
    rdfs:label "delay" ;
    skos:definition "Conduction delay (explicit edges, ms)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:delta_p a owl:DatatypeProperty ;
    rdfs:label "delta_p" ;
    skos:definition "Initial parameter offset from the bifurcation point." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:derivative_initial_value a owl:DatatypeProperty ;
    rdfs:label "derivative_initial_value" ;
    skos:definition "Initial value for the first time derivative, used when equation_order > 1. For a second-order ODE d²x/dt² = f, this sets dx/dt(0). Required by ModelingToolkit.jl to fully specify higher-order initial value problems." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:derived_from_model a owl:ObjectProperty ;
    rdfs:label "derived_from_model" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:descriptor a owl:DatatypeProperty ;
    rdfs:label "descriptor" ;
    skos:definition "Short alphanumeric identifier for the BIDS desc- filename entity (e.g., SC, FC, EC, SCFC). Classifies the connectivity modality of the network's edge measures." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:detect_bifurcation a owl:DatatypeProperty ;
    rdfs:label "detect_bifurcation" ;
    skos:definition "Bifurcation detection level. 0 = off, 1 = eigenvalues only, 2 = detect, 3 = locate precisely." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:detect_fold a owl:DatatypeProperty ;
    rdfs:label "detect_fold" ;
    skos:definition "Enable fold (limit point) detection." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:dimension a owl:DatatypeProperty ;
    rdfs:label "dimension" ;
    skos:definition "Dimensionality of the coupling input (number of coupled values)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:distance a owl:DatatypeProperty ;
    rdfs:label "distance" ;
    skos:definition "Edge length / tract distance (explicit edges, mm)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:distance_unit a owl:ObjectProperty ;
    rdfs:label "distance_unit" ;
    skos:definition "Unit for distances/lengths in the network" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:doi a owl:DatatypeProperty ;
    rdfs:label "doi" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:downsample_period a owl:DatatypeProperty ;
    rdfs:label "downsample_period" ;
    skos:definition "Intermediate downsampling period (ms). For BOLD: typically matches dt." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:ds a owl:DatatypeProperty ;
    rdfs:label "ds" ;
    skos:definition "Initial arc-length step size." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:ds_max a owl:DatatypeProperty ;
    rdfs:label "ds_max" ;
    skos:definition "Maximum adaptive step size." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:ds_min a owl:DatatypeProperty ;
    rdfs:label "ds_min" ;
    skos:definition "Minimum adaptive step size." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:dt a owl:DatatypeProperty ;
    rdfs:label "dt" ;
    skos:definition "Time step (s)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:element a owl:DatatypeProperty ;
    rdfs:label "element" ;
    skos:definition "Element/node index this range applies to. Used in element_domains to explicitly link a domain to a specific element of a heterogeneous parameter (e.g., element: 0 for node 0). Required when used in element_domains to avoid ambiguous positional indexing." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:element_type a owl:ObjectProperty ;
    rdfs:label "element_type" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:elements a owl:DatatypeProperty ;
    rdfs:label "elements" ;
    skos:definition "Connectivity (indices) or file reference to topology." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:engine a owl:ObjectProperty ;
    rdfs:label "engine" ;
    skos:definition "Primary engine (must appear in environment.requirements; migration target replacing deprecated 'software')." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:equation_order a owl:DatatypeProperty ;
    rdfs:label "equation_order" ;
    skos:definition "Order of the time derivative on the LHS. Default 1 means dx/dt = rhs (first-order ODE). Order 2 means d²x/dt² = rhs (second-order ODE), etc. Higher-order ODEs are automatically lowered to coupled first-order systems by backends like ModelingToolkit.jl via mtkcompile." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:equation_type a owl:DatatypeProperty ;
    rdfs:label "equation_type" ;
    skos:definition "Type of equation: 'differential' (default) means dx/dt = rhs, 'algebraic' means 0 = rhs or x ~ rhs (DAE constraint). Algebraic equations are used by ModelingToolkit.jl backend." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:event_type a owl:ObjectProperty ;
    rdfs:label "event_type" ;
    skos:definition "Type of event trigger mechanism." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:extension a owl:DatatypeProperty ;
    rdfs:label "extension" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:field a owl:ObjectProperty ;
    rdfs:label "field" ;
    skos:definition "Primary field being solved for (deprecated; use state_variables)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:field_dynamics a owl:ObjectProperty ;
    rdfs:label "field_dynamics" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:find_fixpoint a owl:DatatypeProperty ;
    rdfs:label "find_fixpoint" ;
    skos:definition "Whether to find a fixed point (steady state) before time integration. Used as initial condition for ODEProblem. Maps to NLsolve.fixpoint! in ND.jl or similar in other backends." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:free a owl:DatatypeProperty ;
    rdfs:label "free" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:gaussian a owl:DatatypeProperty ;
    rdfs:label "gaussian" ;
    skos:definition "Indicates whether the noise is Gaussian" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:generated_at a owl:DatatypeProperty ;
    rdfs:label "generated_at" ;
    skos:definition "Timestamp when this TimeSeries was generated." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:generated_by a owl:DatatypeProperty ;
    rdfs:label "generated_by" ;
    skos:definition "Software/agent identifier (prov:wasGeneratedBy)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:geometry a owl:DatatypeProperty ;
    rdfs:label "geometry" ;
    skos:definition "Optional file for geometry/ROI mask (e.g., NIfTI, GIfTI)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:graph_generator a owl:ObjectProperty ;
    rdfs:label "graph_generator" ;
    skos:definition """Graph generator specification.  When set, overrides explicit edges/nodes for graph construction.  The type field is a free string; StandardGraphType lists well-known types that get automatic code generation across backends.
""" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:has_reference a owl:DatatypeProperty ;
    rdfs:label "has_reference" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:hemi a owl:DatatypeProperty ;
    rdfs:label "hemi" ;
    skos:definition "BIDS hemi- entity (L or R) for hemisphere-specific surface/volume data" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:hi a owl:ObjectProperty ;
    rdfs:label "hi" ;
    skos:definition "Upper bound or stopping value. Can be a number or argument name." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:history a owl:ObjectProperty ;
    rdfs:label "history" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:imaging_modality a owl:ObjectProperty ;
    rdfs:label "imaging_modality" ;
    skos:definition "Type of imaging modality (BOLD, EEG, MEG, etc.)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:initial_expression a owl:ObjectProperty ;
    rdfs:label "initial_expression" ;
    skos:definition "Analytic initial condition for the field." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:initial_state a owl:ObjectProperty ;
    rdfs:label "initial_state" ;
    skos:definition "How to obtain the initial equilibrium. Default: time integration to steady state." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:inner_coupling a owl:ObjectProperty ;
    rdfs:label "inner_coupling" ;
    skos:definition "For hierarchical coupling: inner coupling applied at regional level" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:intensity a owl:ObjectProperty ;
    rdfs:label "intensity" ;
    skos:definition "Optional scalar or vector intensity parameter for noise." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:labels_dimensions a owl:DatatypeProperty ;
    rdfs:label "labels_dimensions" ;
    skos:definition "Mapping of dimension names to their labels (JSON-encoded dict)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:latex a owl:DatatypeProperty ;
    rdfs:label "latex" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:learning_rate_schedule a owl:DatatypeProperty ;
    rdfs:label "learning_rate_schedule" ;
    skos:definition "Learning rate schedule: 'constant', 'linear', 'exponential'" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:learning_rate_warmup a owl:DatatypeProperty ;
    rdfs:label "learning_rate_warmup" ;
    skos:definition "Linear warmup of learning rate from 0 to learning_rate over n_iterations. eta_effective = eta * (i+1) / n_iterations" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:lefthandside a owl:DatatypeProperty ;
    rdfs:label "lefthandside" ;
    skos:inScheme <https://w3id.org/tvbo> ;
    skos:prefLabel "lhs" .

tvbo:license a owl:DatatypeProperty ;
    rdfs:label "license" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:linear_solver a owl:ObjectProperty ;
    rdfs:label "linear_solver" ;
    skos:definition "Linear solver for the Newton bordered system. E.g. COPBLS (collocation), MatrixBLS (shooting/poincaré)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:lo a owl:ObjectProperty ;
    rdfs:label "lo" ;
    skos:definition "Lower bound or starting value. Can be a number or argument name." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:loader a owl:ObjectProperty ;
    rdfs:label "loader" ;
    skos:definition "Callable that loads the data (e.g., load_functional_connectivity)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:local_coupling_term a owl:ObjectProperty ;
    rdfs:label "local_coupling_term" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:log_scale a owl:DatatypeProperty ;
    rdfs:label "log_scale" ;
    skos:definition "Whether to use logarithmic spacing." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:loss a owl:ObjectProperty ;
    rdfs:label "loss" ;
    skos:definition "Loss function call. Uses FunctionCall to either: 1. Reference existing function: function: rmse 2. Inline callable: callable: {module: ..., name: ...} Arguments specify inputs (simulated_fc, empirical_fc, etc.)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:max_bisection_steps a owl:DatatypeProperty ;
    rdfs:label "max_bisection_steps" ;
    skos:definition "Maximum bisection steps for bifurcation point localization." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:max_iterations a owl:DatatypeProperty ;
    rdfs:label "max_iterations" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:max_steps a owl:DatatypeProperty ;
    rdfs:label "max_steps" ;
    skos:definition "Maximum continuation steps." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:mesh_file a owl:DatatypeProperty ;
    rdfs:label "mesh_file" ;
    skos:definition "Path to external mesh file (GIFTI, VTK, MSH, FreeSurfer, etc.)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:mesh_format a owl:DatatypeProperty ;
    rdfs:label "mesh_format" ;
    skos:definition "Explicit format override (gifti, freesurfer, meshio, vtk, gmsh). Auto-detected from extension if null." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:mesh_intervals a owl:DatatypeProperty ;
    rdfs:label "mesh_intervals" ;
    skos:definition "Number of mesh intervals (time slices) for collocation or trapezoid methods. Collocation: N in PeriodicOrbitOCollProblem(N, m). Trapezoid: M in PeriodicOrbitTrapProblem(M=...)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:metric a owl:ObjectProperty ;
    rdfs:label "metric" ;
    skos:definition "Metric equation for matching (e.g., correlation, rmse)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:modality a owl:ObjectProperty ;
    rdfs:label "modality" ;
    skos:definition "Imaging modality or simulation output type." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:mode a owl:DatatypeProperty ;
    rdfs:label "mode" ;
    skos:definition "Combination mode: 'product' (full grid), 'zip' (paired)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:model_equation_ref a owl:DatatypeProperty ;
    rdfs:label "model_equation_ref" ;
    skos:definition "BIDS ModelEq reference: path to _eq.xml LEMS file." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:model_param_ref a owl:DatatypeProperty ;
    rdfs:label "model_param_ref" ;
    skos:definition "BIDS ModelParam reference: path to _param.xml LEMS file." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:model_type a owl:ObjectProperty ;
    rdfs:label "model_type" ;
    skos:definition "Coarse classification of this model (mean_field, neural_mass, phase_oscillator, phenomenological, spiking, generic, field). Used for filtering in Dynamics.list_db(model_type=...)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:modified a owl:DatatypeProperty ;
    rdfs:label "modified" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:module a owl:DatatypeProperty ;
    rdfs:label "module" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:n a owl:DatatypeProperty ;
    rdfs:label "n" ;
    skos:definition "Number of points (alternative to step for grid exploration)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:n_inversion a owl:DatatypeProperty ;
    rdfs:label "n_inversion" ;
    skos:definition "Number of eigenvalue sign inversions to flag a bifurcation. Must be even. Higher = fewer false positives." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:n_iterations a owl:DatatypeProperty ;
    rdfs:label "n_iterations" ;
    skos:definition "Number of iterations to run" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:n_parallel a owl:DatatypeProperty ;
    rdfs:label "n_parallel" ;
    skos:definition "Parallel evaluations" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:n_regions a owl:DatatypeProperty ;
    rdfs:label "n_regions" ;
    skos:definition "Total number of regions" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:n_sections a owl:DatatypeProperty ;
    rdfs:label "n_sections" ;
    skos:definition "Number of shooting sections for shooting or Poincaré methods." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:n_threads a owl:DatatypeProperty ;
    rdfs:label "n_threads" ;
    skos:definition "Number of CPU threads per worker (-1 = auto-detect)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:n_trials a owl:DatatypeProperty ;
    rdfs:label "n_trials" ;
    skos:definition "Number of independent trials per grid point. Each trial uses a different noise seed. Used for averaging stochastic simulations (e.g., VEP = average of 20 trials)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:n_vertices a owl:DatatypeProperty ;
    rdfs:label "n_vertices" ;
    skos:definition "Total number of vertices" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:n_workers a owl:DatatypeProperty ;
    rdfs:label "n_workers" ;
    skos:definition "Number of parallel workers (maps to pmap devices in JAX, processes in multiprocessing)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:network a owl:ObjectProperty ;
    rdfs:label "network" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:nev a owl:DatatypeProperty ;
    rdfs:label "nev" ;
    skos:definition "Number of eigenvalues to compute. Must be >= number of state variables for reliable Hopf detection." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:newton_max_iterations a owl:DatatypeProperty ;
    rdfs:label "newton_max_iterations" ;
    skos:definition "Maximum Newton corrector iterations per step." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:newton_tol a owl:DatatypeProperty ;
    rdfs:label "newton_tol" ;
    skos:definition "Absolute tolerance for Newton corrector convergence." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:node_mapping a owl:DatatypeProperty ;
    rdfs:label "node_mapping" ;
    skos:definition "HDF5 dataset path for node-to-parent mapping. Int32 array of shape (N,) where entry i is the parent node ID. Required when parent_network is set." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:noise_type a owl:DatatypeProperty ;
    rdfs:label "noise_type" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:non_negative a owl:DatatypeProperty ;
    rdfs:label "non_negative" ;
    skos:definition "All values >= 0" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:number_of_elements a owl:DatatypeProperty ;
    rdfs:label "number_of_elements" ;
    skos:definition "Number of elements (triangles, quads, tetrahedra, etc.)." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:number_of_modes a owl:DatatypeProperty ;
    rdfs:label "number_of_modes" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:number_of_nodes a owl:DatatypeProperty ;
    rdfs:label "number_of_nodes" ;
    skos:altLabel "number_of_nodes",
        "number_of_regions" ;
    skos:definition "Number of nodes in the network (derived from nodes if not set)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:number_of_stages a owl:DatatypeProperty ;
    rdfs:label "number_of_stages" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:number_of_subjects a owl:DatatypeProperty ;
    rdfs:label "number_of_subjects" ;
    skos:definition "Number of subjects in the tractography dataset" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:number_of_vertices a owl:DatatypeProperty ;
    rdfs:label "number_of_vertices" ;
    skos:definition "Number of vertices in the mesh." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:objective a owl:ObjectProperty ;
    rdfs:label "objective" ;
    skos:definition "What the algorithm optimizes for" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:observable a owl:ObjectProperty ;
    rdfs:label "observable" ;
    skos:definition "Observable to compute at each point. Use function: obs_name for simple observation, or function: func_name + arguments for FunctionCall." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:ode_solver a owl:ObjectProperty ;
    rdfs:label "ode_solver" ;
    skos:definition "ODE solver for flow-based methods (shooting, poincaré). Specifies algorithm (e.g. Vern9, Rodas5) and tolerances. Not needed for collocation or trapezoid." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:on_region a owl:DatatypeProperty ;
    rdfs:label "on_region" ;
    skos:definition "Mesh/atlas subset where BC applies." ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:operator_type a owl:ObjectProperty ;
    rdfs:label "operator_type" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:output_equation a owl:ObjectProperty ;
    rdfs:label "output_equation" ;
    skos:definition "Output transformation equation (if equation-based)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:over a owl:ObjectProperty ;
    rdfs:label "over" ;
    skos:definition "Dimension to aggregate over (e.g., node, time, state)" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:parcellation a owl:ObjectProperty ;
    rdfs:label "parcellation" ;
    skos:definition "Brain parcellation/atlas reference" ;
    skos:inScheme <https://w3id.org/tvbo> .

tvbo:parent_network a owl:DatatypeProperty ;
