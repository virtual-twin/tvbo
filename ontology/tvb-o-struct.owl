<https://w3id.org/tvbo/NoiseType#pink> a owl:Class ;
    rdfs:label "pink (NoiseType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:NoiseType ;
    skos:notation "pink" .

<https://w3id.org/tvbo/NoiseType#white> a owl:Class ;
    rdfs:label "white (NoiseType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:NoiseType ;
    skos:notation "white" .

