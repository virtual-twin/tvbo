<https://w3id.org/tvbo/dbs/manufacturer> a owl:DatatypeProperty ;
    rdfs:label "manufacturer (dbs)" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "manufacturer" .

<https://w3id.org/tvbo/dbs/mode> a owl:DatatypeProperty ;
