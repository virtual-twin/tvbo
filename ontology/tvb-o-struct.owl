            owl:minCardinality 1 ;
            owl:onProperty tvbo:permute ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty tvbo:statistic ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tvbo:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:permutations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty tvbo:permutations ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty tvbo:direction ] ;
    skos:definition "A permutation-significance test: re-evaluate a named statistic under n_perm fixed permutations of a field and report the per-element exceedance p-value. General (any permutation null — spatial nulls, FC significance, wave detection, …). Codegen emits ``(vmap(lambda p: stat(field[p]))(perms) <cmp> stat(field)).mean(axis over perms)``; the wrapped statistic is an ordinary symbolic derived variable, so only the permutation fold is structural." ;
    skos:exactMatch tvbo:Surrogate ;
    skos:inScheme <https://w3id.org/tvbo> .

<https://w3id.org/tvbo/SweepDirection#bidirectional> a owl:Class ;
    rdfs:label "bidirectional (SweepDirection)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:SweepDirection ;
    skos:definition "Increase then decrease over the same values, recording both branches. Where the two branches differ, the sweep traces a hysteresis loop that exposes coexisting stable states (bistability / multistability). The multivalued generalisation of Continuation.bothside." ;
    skos:notation "bidirectional" .

<https://w3id.org/tvbo/SweepDirection#down> a owl:Class ;
    rdfs:label "down (SweepDirection)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:SweepDirection ;
    skos:definition "Decrease the parameter monotonically (high to low), once." ;
    skos:notation "down" .

<https://w3id.org/tvbo/SweepDirection#up> a owl:Class ;
    rdfs:label "up (SweepDirection)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:SweepDirection ;
    skos:definition "Increase the parameter monotonically (low to high), once." ;
    skos:notation "up" .

<https://w3id.org/tvbo/SweepSeeding#from_previous> a owl:Class ;
    rdfs:label "from_previous (SweepSeeding)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:SweepSeeding ;
    skos:definition "Each point is seeded from the final state of the preceding point, so the trajectory follows the solution branch as the swept parameter changes quasi-statically. Forces sequential, order-dependent execution (emitted as a scan, not a vmap). Used to reach a working point by slowly ramping a parameter (e.g. global coupling) and, with sweep_direction, to expose hysteresis / multistability. Sweep-granularity analogue of InitialStateMethod.from_branch." ;
    skos:notation "from_previous" .

<https://w3id.org/tvbo/SweepSeeding#independent> a owl:Class ;
    rdfs:label "independent (SweepSeeding)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:SweepSeeding ;
    skos:definition "Each point is initialised independently from the model's initial values (a cold start), so points are order-independent and may be evaluated in parallel (see parallel_mode). Default; today's behaviour." ;
    skos:notation "independent" .

<https://w3id.org/tvbo/SystemType#continuous> a owl:Class ;
    rdfs:label "continuous (SystemType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:SystemType ;
    skos:definition "Continuous-time dynamics (e.g., ODE/SDE)." ;
    skos:notation "continuous" .

<https://w3id.org/tvbo/SystemType#discrete> a owl:Class ;
    rdfs:label "discrete (SystemType)" ;
    rdfs:isDefinedBy tvbo:struct ;
    rdfs:subClassOf tvbo:SystemType ;
    skos:definition "Discrete-time dynamics (e.g., maps, iterated updates)." ;
    skos:notation "discrete" .

