tvbo:AxisReductionStatistic a owl:Class ;
    rdfs:label "AxisReductionStatistic" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/AxisReductionStatistic#mean> <https://w3id.org/tvbo/AxisReductionStatistic#sum> <https://w3id.org/tvbo/AxisReductionStatistic#std> <https://w3id.org/tvbo/AxisReductionStatistic#sem> <https://w3id.org/tvbo/AxisReductionStatistic#median> ) ;
    skos:definition "Statistic used to collapse an exploration/sweep axis into a single reduced value in the result container (see ExplorationAxis.reduce). Applied across the named grid dimension of every observation that carries it." ;
    skos:inScheme <https://w3id.org/tvbo> ;
    linkml:permissible_values <https://w3id.org/tvbo/AxisReductionStatistic#mean>,
        <https://w3id.org/tvbo/AxisReductionStatistic#median>,
        <https://w3id.org/tvbo/AxisReductionStatistic#sem>,
        <https://w3id.org/tvbo/AxisReductionStatistic#std>,
        <https://w3id.org/tvbo/AxisReductionStatistic#sum> .

