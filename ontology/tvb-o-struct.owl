<https://w3id.org/tvbo/dbs/pulse_width> a owl:ObjectProperty ;
    rdfs:label "pulse_width (dbs)" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "pulse_width" .

<https://w3id.org/tvbo/dbs/recon_path> a owl:DatatypeProperty ;
    rdfs:label "recon_path (dbs)" ;
    skos:inScheme tvbo:dbs ;
    skos:notation "recon_path" .

<https://w3id.org/tvbo/dbs/scale> a owl:ObjectProperty ;
