    skos:inScheme <https://w3id.org/tvbo> .

tvbo:PanelKind a owl:Class ;
    rdfs:label "PanelKind" ;
    rdfs:isDefinedBy tvbo:struct ;
    owl:unionOf ( <https://w3id.org/tvbo/PanelKind#cartesian> <https://w3id.org/tvbo/PanelKind#heatmap> <https://w3id.org/tvbo/PanelKind#line3d> <https://w3id.org/tvbo/PanelKind#image> <https://w3id.org/tvbo/PanelKind#custom> ) ;
    skos:definition "What a panel draws. cartesian/heatmap are grammar-driven (mark + encoding); image (external file) and custom (registered callable) are peer escape-hatch kinds. New kinds (surface, network) are added when their bsplot leaf exists." ;
    skos:inScheme tvbo:figure ;
    linkml:permissible_values <https://w3id.org/tvbo/PanelKind#cartesian>,
